import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Poker {

    private final List<String> hands;

    Poker(List<String> hand) {
        this.hands = hand;
    }

    List<String> getBestHands() {
        List<String> bestHands = new ArrayList<>();
        int bestScore = Integer.MIN_VALUE;

        for (String hand : hands) {
            int score = evaluateHand(hand);
            if (score > bestScore) {
                bestScore = score;
                bestHands.clear();
                bestHands.add(hand);
            } else if (score == bestScore) {
                bestHands.add(hand);
            }
        }

        return bestHands;
    }

    private int evaluateHand(String hand) {
        String[] cards = hand.split(" ");
        int[] ranks = new int[5];
        char[] rankChars = new char[5];
        char[] suitChars = new char[5];

        for (int i = 0; i < 5; i++) {
            rankChars[i] = cards[i].charAt(0);
            suitChars[i] = cards[i].charAt(1);
        }

        for (int i = 0; i < 5; i++) {
            ranks[i] = rankToValue(rankChars[i]);
        }

        boolean isFlush = true;
        for (int i = 1; i < 5; i++) {
            if (suitChars[i] != suitChars[0]) {
                isFlush = false;
                break;
            }
        }

        // Count rank occurrences
        int[] counts = new int[14];
        for (int rank : ranks) {
            counts[rank]++;
        }

        // Check for straight
        boolean isStraight = false;
        int straightHigh = 0;
        boolean hasAce = counts[14] == 1;

        int[] sortedRanks = ranks.clone();
        Arrays.sort(sortedRanks);

        // Normal straight (A-2-3-4-5 ... 10-Ace)
        if (sortedRanks[4] - sortedRanks[0] == 4) {
            boolean distinct = true;
            for (int i = 1; i < 5; i++) {
                if (sortedRanks[i] == sortedRanks[i - 1]) {
                    distinct = false;
                    break;
                }
            }
            if (distinct) {
                isStraight = true;
                straightHigh = sortedRanks[4];
            }
        }

        // Wheel straight (A-2-3-4-5)
        if (!isStraight && hasAce) {
            // Check A-2-3-4-5
            int[] wheelRanks = {14, 2, 3, 4, 5};
            boolean isWheel = true;
            for (int r : wheelRanks) {
                if (counts[r] != 1) {
                    isWheel = false;
                    break;
                }
            }
            if (isWheel) {
                isStraight = true;
                straightHigh = 5; // Ace is low
            }
        }

        // Build score
        // Category priority * 1000000 + tiebreakers

        // Count groups by frequency
        int[] freqCount = new int[14];
        for (int i = 1; i <= 13; i++) {
            if (counts[i] > 0) {
                freqCount[counts[i]]++;
            }
        }

        // Determine hand type
        if (isStraight && isFlush) {
            return 8_000_000 + straightHigh;
        }
        if (freqCount[4] == 1) {
            // Four of a kind
            int quadRank = 0;
            for (int r = 1; r <= 13; r++) {
                if (counts[r] == 4) {
                    quadRank = r;
                    break;
                }
            }
            int kicker = 0;
            for (int i = 0; i < 5; i++) {
                if (ranks[i] != quadRank) {
                    kicker = ranks[i];
                    break;
                }
            }
            return 7_000_000 + quadRank * 100 + kicker;
        }
        if (freqCount[3] == 1 && freqCount[2] == 1) {
            // Full house
            int tripRank = 0;
            int pairRank = 0;
            for (int r = 1; r <= 13; r++) {
                if (counts[r] == 3) tripRank = r;
                if (counts[r] == 2) pairRank = r;
            }
            return 6_000_000 + tripRank * 100 + pairRank;
        }
        if (isFlush) {
            return 5_000_000 + flushRankScore(ranks);
        }
        if (isStraight) {
            return 4_000_000 + straightHigh;
        }
        if (freqCount[3] == 1) {
            // Three of a kind
            int tripRank = 0;
            for (int r = 1; r <= 13; r++) {
                if (counts[r] == 3) {
                    tripRank = r;
                    break;
                }
            }
            int[] kickers = new int[2];
            int idx = 0;
            for (int i = 0; i < 5; i++) {
                if (ranks[i] != tripRank) {
                    kickers[idx++] = ranks[i];
                }
            }
            Arrays.sort(kickers);
            return 3_000_000 + tripRank * 100 + kickers[1] * 10 + kickers[0];
        }
        if (freqCount[2] == 2) {
            // Two pair
            int highPair = 0;
            int lowPair = 0;
            for (int r = 1; r <= 13; r++) {
                if (counts[r] == 2) {
                    if (highPair == 0) {
                        highPair = r;
                    } else {
                        lowPair = r;
                    }
                }
            }
            int kicker = 0;
            for (int i = 0; i < 5; i++) {
                if (ranks[i] != highPair && ranks[i] != lowPair) {
                    kicker = ranks[i];
                    break;
                }
            }
            return 2_000_000 + highPair * 10000 + lowPair * 100 + kicker;
        }
        if (freqCount[2] == 1) {
            // One pair
            int pairRank = 0;
            for (int r = 1; r <= 13; r++) {
                if (counts[r] == 2) {
                    pairRank = r;
                    break;
                }
            }
            int[] kickers = new int[3];
            int idx = 0;
            for (int i = 0; i < 5; i++) {
                if (ranks[i] != pairRank) {
                    kickers[idx++] = ranks[i];
                }
            }
            Arrays.sort(kickers);
            return 1_000_000 + pairRank * 100000 + kickers[2] * 1000 + kickers[1] * 100 + kickers[0] * 1;
        }

        // High card
        return flushRankScore(ranks);
    }

    private int flushRankScore(int[] ranks) {
        int[] sorted = ranks.clone();
        Arrays.sort(sorted);
        return sorted[4] * 1000000000
                + sorted[3] * 100000000
                + sorted[2] * 10000000
                + sorted[1] * 100000
                + sorted[0] * 1000;
    }

    private int rankToValue(char rankChar) {
        switch (rankChar) {
            case '2': return 2;
            case '3': return 3;
            case '4': return 4;
            case '5': return 5;
            case '6': return 6;
            case '7': return 7;
            case '8': return 8;
            case '9': return 9;
            case 'T': return 10;
            case 'J': return 11;
            case 'Q': return 12;
            case 'K': return 13;
            case 'A': return 14;
            default: throw new IllegalArgumentException("Invalid rank: " + rankChar);
        }
    }
}
