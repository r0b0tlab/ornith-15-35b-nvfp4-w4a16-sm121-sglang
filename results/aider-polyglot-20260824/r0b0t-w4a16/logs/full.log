I'll implement a poker hand evaluator. Let me analyze the requirements: I need to rank all standard poker hands (high card through straight flush), handle the Ace-low "wheel" straight, and return all hands tied for the best using the original references.

The key design challenge is creating a comparable score where category ordering is correct (straight flush > four of a kind > full house > flush > straight > ...), with tiebreakers appended as lexicographically-comparable values.

Here's my implementation:

lib.rs
```
/// Given a list of poker hands, return a list of those hands which win.
///
/// Note the type signature: this function should return _the same_ reference to
/// the winning hand(s) as were passed in, not reconstructed strings which happen to be equal.
pub fn winning_hands<'a>(hands: &[&'a str]) -> Vec<&'a str> {
    if hands.is_empty() {
        return Vec::new();
    }

    // Score each hand as a comparable tuple of byte values.
    let scored: Vec<(Vec<u8>, &'a str)> =
        hands.iter().map(|h| (evaluate_hand(h), h)).collect();

    // Find the maximum score.
    let best = scored
        .iter()
        .map(|(score, _)| score)
        .max()
        .expect("input is non-empty");

    // Collect every hand whose score equals the best.
    scored
        .into_iter()
        .filter(|(score, _)| score == best)
        .map(|(_, h)| h)
        .collect()
}

/// Evaluate a poker hand into a comparable score.
///
/// The first element is the hand category (higher is better); subsequent
/// elements are tiebreakers ordered from most to least significant. Because
/// Vec<u8> compares lexicographically, this single representation correctly
/// orders all hand types and their tiebreakers.
fn evaluate_hand(hand: &str) -> Vec<u8> {
    let mut ranks: Vec<u8> = hand.split_whitespace().map(parse_rank).collect();
    let suits: Vec<char> = hand
        .split_whitespace()
        .map(|card| card.chars().nth(1).unwrap())
        .collect();

    let is_flush = !suits.is_empty() && suits.iter().all(|&s| s == suits[0]);

    ranks.sort();
    ranks.reverse();

    let is_wheel = ranks[0] == 14
        && ranks[1] == 5
        && ranks[2] == 4
        && ranks[3] == 3
        && ranks[4] == 2;
    let straight_high = if is_wheel { 1 } else { ranks[0] };
    let is_straight = check_straight(&ranks, is_wheel);

    // Count occurrences of each rank, keeping descending rank order.
    let mut counts: Vec<(u8, u8)> = Vec::new();
    for &r in &ranks {
        let mut found = false;
        for entry in counts.iter_mut() {
            if entry.0 == r {
                entry.1 += 1;
                found = true;
                break;
            }
        }
        if !found {
            counts.push((r, 1));
        }
    }

    match counts.len() {
        // All five ranks distinct: high card, straight, or flush.
        5 => {
            if is_straight {
                return vec![4, straight_high];
            }
            if is_flush {
                return vec![5, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4]];
            }
            return vec![0, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4]];
        }
        // Exactly two distinct ranks: four of a kind or full house.
        2 => {
            if counts.iter().any(|&(_, c)| c == 4) {
                let quad = counts.iter().find(|&(_, c)| c == 4).unwrap().0;
                let kicker = ranks.iter().find(|&&r| r != quad).copied().unwrap();
                return vec![7, quad, kicker];
            }
            return vec![6, counts[0].0, counts[1].0];
        }
        // Three distinct ranks: three of a kind or two pair.
        3 => {
            if counts.iter().any(|&(_, c)| c == 3) {
                let trips = counts.iter().find(|&(_, c)| c == 3).unwrap().0;
                let kickers: Vec<u8> = ranks
                    .iter()
                    .filter(|&&r| r != trips)
                    .copied()
                    .collect();
                return vec![3, trips, kickers[0], kickers[1]];
            }
            return vec![2, counts[0].0, counts[1].0, counts[2].0];
        }
        // Four distinct ranks: one pair.
        4 => {
            let pair = counts.iter().find(|&(_, c)| c == 2).unwrap().0;
            let kickers: Vec<u8> = ranks
                .iter()
                .filter(|&&r| r != pair)
                .copied()
                .collect();
            return vec![1, pair, kickers[0], kickers[1], kickers[2]];
        }
        // Five distinct ranks (should be unreachable; handled above).
        _ => return vec![7, counts[0].0, counts[0].1, ranks[1]],
    }
}

fn parse_rank(card: &str) -> u8 {
    match card.chars().next() {
        Some('2'..='9') => card.chars().next().unwrap() as u8 - b'0',
        Some('T') => 10,
        Some('J') => 11,
        Some('Q') => 12,
        Some('K') => 13,
        Some('A') => 14,
        _ => panic!("invalid rank character"),
    }
}

fn check_straight(ranks: &[u8], is_wheel: bool) -> bool {
    if ranks.len() != 5 {
        return false;
    }
    // Reject any duplicates.
    if ranks[0] == ranks[1]
        || ranks[1] == ranks[2]
        || ranks[2] == ranks[3]
        || ranks[3] == ranks[4]
    {
        return false;
    }
    // Consecutive run.
    if ranks[0] - ranks[4] == 4 {
        return true;
    }
    // Ace-low "wheel": A-2-3-4-5.
    is_wheel
}
```
