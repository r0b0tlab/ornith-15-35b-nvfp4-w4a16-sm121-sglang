```go
package forth

import (
	"errors"
	"strconv"
	"strings"
	"unicode"
)

// Forth evaluates a Forth program given as a slice of input lines.
func Forth(input []string) ([]int, error) {
	var stack []int
	builtins := map[string]func([]int) ([]int, error){}
	words := map[string][]string{}

	for _, line := range input {
		tokens := tokenize(line)
		for i := 0; i < len(tokens); {
			token := tokens[i]
			if token == ":" {
				// Defining a new word
				if i+1 >= len(tokens) || tokens[i+1] == ";" {
					return nil, errors.New("invalid definition")
				}
				name := strings.ToUpper(tokens[i+1])
				i += 2
				def := []string{}
				for i < len(tokens) && tokens[i] != ";" {
					def = append(def, tokens[i])
					i++
				}
				if i >= len(tokens) {
					return nil, errors.New("unterminated definition")
				}
				// i points to ";"
				i++
				// Resolve the definition: expand any previously defined words
				resolved := expand(def, words)
				builtins[name] = makeFunc(resolved, builtins)
				i++
				continue
			}
			// Check if token is a user-defined word
			if fn, ok := builtins[strings.ToUpper(token)]; ok {
				var err error
				stack, err = fn(stack)
				if err != nil {
					return nil, err
				}
				i++
				continue
			}
			// Check if token is a number
			if num, err := strconv.Atoi(token); err == nil {
				stack = append(stack, num)
				i++
				continue
			}
			// Check if token is a builtin
			if fn, ok := builtins[strings.ToUpper(token)]; ok {
				var err error
				stack, err = fn(stack)
				if err != nil {
					return nil, err
				}
				i++
				continue
			}
			// Unknown token
			return nil, errors.New("unknown word: " + token)
		}
	}
	return stack, nil
}

// tokenize splits a line into tokens by whitespace.
func tokenize(line string) []string {
	return strings.Fields(line)
}

// expand resolves user-defined words in a definition, leaving numbers and operators as-is.
func expand(def []string, words map[string][]string) []string {
	result := []string{}
	for _, tok := range def {
		result = append(result, tok)
	}
	return result
}

// makeFunc creates a function that executes a resolved definition.
func makeFunc(def []string, builtins map[string]func([]int) ([]int, error)) func([]int) ([]int, error) {
	return func(stack []int) ([]int, error) {
		for _, tok := range def {
			switch tok {
			case "+":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				b, a := stack[len(stack)-2], stack[len(stack)-1]
				stack = stack[:len(stack)-2]
				stack = append(stack, a+b)
			case "-":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				b, a := stack[len(stack)-2], stack[len(stack)-1]
				stack = stack[:len(stack)-2]
				stack = append(stack, a-b)
			case "*":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				b, a := stack[len(stack)-2], stack[len(stack)-1]
				stack = stack[:len(stack)-2]
				stack = append(stack, a*b)
			case "/":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				b, a := stack[len(stack)-2], stack[len(stack)-1]
				if b == 0 {
					return nil, errors.New("divide by zero")
				}
				stack = stack[:len(stack)-2]
				stack = append(stack, a/b)
			case "dup":
				if len(stack) < 1 {
					return nil, errors.New("stack underflow")
				}
				stack = append(stack, stack[len(stack)-1])
			case "drop":
				if len(stack) < 1 {
					return nil, errors.New("stack underflow")
				}
				stack = stack[:len(stack)-1]
			case "swap":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				stack[len(stack)-1], stack[len(stack)-2] = stack[len(stack)-2], stack[len(stack)-1]
			case "over":
				if len(stack) < 2 {
					return nil, errors.New("stack underflow")
				}
				a := stack[len(stack)-2]
				stack = append(stack, a)
			default:
				// User-defined word
				if fn, ok := builtins[strings.ToUpper(tok)]; ok {
					var err error
					stack, err = fn(stack)
					if err != nil {
						return nil, err
					}
				} else if num, err := strconv.Atoi(tok); err == nil {
					stack = append(stack, num)
				} else {
					return nil, errors.New("unknown word: " + tok)
				}
			}
		}
		return stack, nil
	}
}

// isNumber checks if a string is a valid integer.
func isNumber(s string) bool {
	if _, err := strconv.Atoi(s); err == nil {
		return true
	}
	return false
}

// isWord checks if a string is a Forth word.
func isWord(s string) bool {
	if isNumber(s) {
		return false
	}
	for _, r := range s {
		if unicode.IsLetter(r) || unicode.IsDigit(r) {
			return true
		}
	}
	return false
}
