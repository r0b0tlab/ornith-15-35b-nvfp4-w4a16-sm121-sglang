I'll implement the protein translation functions in Go. Let me analyze the requirements:

1. `FromCodon` - translates a single codon to a protein or returns an error
2. `FromRNA` - translates an RNA sequence into a list of proteins, stopping at STOP codons

Here's my implementation:

protein_translation.go
```go
package protein

import "errors"

func FromCodon(codon string) (string, error) {
	switch codon {
	case "AUG":
		return "Methionine", nil
	case "UUU", "UUC":
		return "Phenylalanine", nil
	case "UUA", "UUG":
		return "Leucine", nil
	case "UCU", "UCC", "UCA", "UCG":
		return "Serine", nil
	case "UAU", "UAC":
		return "Tyrosine", nil
	case "UGU", "UGC":
		return "Cysteine", nil
	case "UGG":
		return "Tryptophan", nil
	case "UAA", "UAG", "UGA":
		return "STOP", nil
	default:
		return "", errors.New("invalid codon")
	}
}

func FromRNA(rna string) ([]string, error) {
	proteins := []string{}
	for i := 0; i+3 <= len(rna); i += 3 {
		codon := rna[i : i+3]
		protein, err := FromCodon(codon)
		if err != nil {
			return nil, err
		}
		if protein == "STOP" {
			break
		}
		proteins = append(proteins, protein)
	}
	return proteins, nil
}
```
