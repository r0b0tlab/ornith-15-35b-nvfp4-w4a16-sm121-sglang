```go
package bookstore

const basePrice = 800 // cents

// Cost calculates the minimum price for a basket of books.
func Cost(books []int) int {
	// Count how many copies of each book there are.
	counts := make([]int, 6) // index 1..5 represent the 5 books
	for _, b := range books {
		counts[b]++
	}

	// Discount percentages for sets of 1..5 different books.
	// discount[i] is the discount for a set of size i.
	discounts := []int{0, 0, 5, 10, 20, 25}

	// Helper to compute cost of a single set of size n.
	setCost := func(n int) int {
		discount := discounts[n]
		return n * basePrice * (100 - discount) / 100
	}

	// Greedily form the largest possible sets.
