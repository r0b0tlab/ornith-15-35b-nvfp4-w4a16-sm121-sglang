palindrome-products.js
```
//
// This is only a SKELETON file for the 'Palindrome Products' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Palindromes {
  static generate(min, max) {
    if (min > max) {
      throw new Error('must be such that min <= max');
    }

    const products = new Map();

    for (let i = min; i <= max; i++) {
      for (let j = i; j <= max; j++) {
        const product = i * j;
        if (isPalindrome(product)) {
          if (!products.has(product)) {
            products.set(product, []);
          }
          products.get(product).push([i, j]);
        }
      }
    }

    if (products.size === 0) {
      throw new Error('no palindrome with factors in the range');
    }

    let smallest = null;
    let largest = null;

    for (const [product, factors] of products.entries()) {
      if (smallest === null || product < smallest) {
        smallest = product;
      }
      if (largest === null || product > largest) {
        largest = product;
      }
    }

    return {
      smallest: {
        value: smallest,
        factors: products.get(smallest),
      },
      largest: {
        value: largest,
        factors: products.get(largest),
      },
    };
  }
}

function isPalindrome(num) {
  const str = num.toString();
  const len = str.length;
  for (let i = 0; i < Math.floor(len / 2); i++) {
    if (str[i] !== str[len - 1 - i]) {
      return false;
    }
  }
  return true;
}
