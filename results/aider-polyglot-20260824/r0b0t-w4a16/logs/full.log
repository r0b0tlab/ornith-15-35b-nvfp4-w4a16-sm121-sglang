response:
I'll refactor the tree building algorithm to be cleaner, faster, and more maintainable while preserving the same behavior and error handling.

Key improvements:
1. Replace O(n²) nested loops with O(n) dictionary lookups
2. Use a single clear validation pass
3. Separate concerns (validation, tree building)
4. Clear error messages

tree_building.py
```python
class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id


class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []


def BuildTree(records):
    if not records:
        return None

    # Index records by their ID for O(1) lookup
    by_id = {record.record_id: record for record in records}

    # Validate that we have exactly the IDs 0..n-1
    expected_ids = set(range(len(records)))
    actual_ids = set(by_id.keys())
    if actual_ids != expected_ids:
        raise ValueError('invalid tree input: record IDs must be 0..n-1')

    # Validate the parent/child relationships
    for record_id, record in by_id.items():
        if record_id == record.parent_id:
            # Only the root (ID 0) may be its own parent
            if record_id != 0:
                raise ValueError('invalid tree input: a node cannot be its own parent')
        else:
            if record.parent_id > record_id:
                raise ValueError('invalid tree input: parent ID must be lower than child ID')
            if record.parent_id not in by_id:
                raise ValueError('invalid tree input: parent ID not found')

    # Build the tree
    nodes = {record_id: Node(record_id) for record_id in by_id}

    # The root is the node whose ID equals its parent ID
    for record_id, record in by_id.items():
        if record_id == record.parent_id:
            if record_id != 0:
                raise ValueError('invalid tree input: a node cannot be its own parent')
        else:
            nodes[record.parent_id].children.append(nodes[record_id])

    # Ensure children are ordered by ID
    for node in nodes.values():
        node.children.sort(key=lambda child: child.node_id)

    return nodes[0]
```
