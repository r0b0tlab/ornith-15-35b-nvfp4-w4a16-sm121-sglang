+func parseHand(hand string) ([]Card, error) {
+       parts := splitString(hand)
+       if len(parts) != 5 {
+               return nil, fmt.Errorf("hand must have exactly 5 cards: %s", 
hand)
+       }
+
+       cards := make([]Card, 5)
+       for i, part := range parts {
+               card, err := parseCard(part)
+               if err != nil {
+                       return nil, err
+               }
+               cards[i] = card
+       }
+
+       return cards, nil
+}
+
+func splitString(s string) []string {
+       var result []string
