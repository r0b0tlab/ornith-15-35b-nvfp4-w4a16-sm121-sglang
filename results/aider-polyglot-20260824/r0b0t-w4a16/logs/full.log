#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
    current_roll: usize,
}

impl BowlingGame {
    pub fn new() -> Self {
        BowlingGame {
            rolls: Vec::new(),
            current_roll: 0,
        }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.current_roll == self.rolls.len() {
            self.rolls.push(pins);
        } else {
            self.rolls[self.current_roll] = self.rolls[self.current_roll].saturating_add(pins);
        }
        self.current_roll += 1;
        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        let mut score = 0u16;
        let mut roll_index = 0;

        for frame in 0..10 {
            if roll_index >= self.rolls.len() {
                return None;
            }

            if frame < 9 {
                // Normal frame
                if self.rolls[roll_index] == 10 {
                    // Strike
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let strike_value =
                        self.rolls[roll_index] + self.rolls[roll_index + 1] + self.rolls[roll_index + 2];
                    score += strike_value;
                    roll_index += 1;
                } else {
                    // Open frame or spare
                    if roll_index + 1 >= self.rolls.len() {
                        return None;
                    }
                    let first = self.rolls[roll_index];
                    let second = self.rolls[roll_index + 1];
                    if first + second > 10 {
                        return Some(score);
                    }
                    if first + second == 10 {
                        // Spare
                        if roll_index + 2 >= self.rolls.len() {
                            return None;
                        }
                        let spare_value = first + second + self.rolls[roll_index + 2];
                        score += spare_value;
                    } else {
                        score += first + second;
                    }
                    roll_index += 2;
                }
            } else {
                // Tenth frame
                if roll_index + 1 >= self.rolls.len() {
                    return None;
                }
                let first = self.rolls[roll_index];
                let second = self.rolls[roll_index + 1];
                if first + second > 10 {
                    return Some(score);
                }
                if first == 10 {
                    // Strike, need one more roll
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let third = self.rolls[roll_index + 2];
                    if first + second + third > 10 {
                        return Some(score);
                    }
                    score += first + second + third;
                    roll_index += 1;
                } else if first + second == 10 {
                    // Spare, need one more roll
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let third = self.rolls[roll_index + 2];
                    if first + second + third > 10 {
                        return Some(score);
                    }
                    score += first + second + third;
                    roll_index += 2;
                } else {
                    // Open frame
                    score += first + second;
                    roll_index += 2;
                }
            }
        }

        Some(score)
    }
}
