import java.util.HashMap;
import java.util.Map;

class TwoBucket {
    private int totalMoves;
    private String finalBucket;
    private int otherBucket;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        // Try both strategies and pick the better one
        // Strategy 1: Start with bucket one
        Result result1 = simulate(bucketOneCap, bucketTwoCap, desiredLiters, "one");
        // Strategy 2: Start with bucket two
        Result result2 = simulate(bucketOneCap, bucketTwoCap, desiredLiters, "two");

        // Pick the strategy with fewer moves
        if (result1.moves < result2.moves) {
            totalMoves = result1.moves;
            finalBucket = result1.finalBucket;
            otherBucket = result1.otherBucket;
        } else {
            totalMoves = result2.moves;
            finalBucket = result2.finalBucket;
            otherBucket = result2.otherBucket;
        }
    }

    private Result simulate(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        // Result class to hold simulation results
        // Returns moves, final bucket, and other bucket liters
        // Simulates the process of pouring between buckets
        
        // Track states to avoid infinite loops
        Map<String, Boolean> visited = new HashMap<>();
        
        int bucketOne = 0;
        int bucketTwo = 0;
        int moves = 0;
        
        // Fill the starting bucket
        if (startBucket.equals("one")) {
            bucketOne = bucketOneCap;
        } else {
            bucketTwo = bucketTwoCap;
        }
        moves++;
        
        String startKey = startBucket + "Start";
        String endKey = startBucket + "End";
        
        // Check if we've already reached the goal
        if (bucketOne == desiredLiters) {
            return new Result(moves, "one", bucketTwo);
        }
        if (bucketTwo == desiredLiters) {
            return new Result(moves, "two", bucketOne);
        }
        
        // Continue until we reach the goal or hit a cycle
        while (bucketOne != desiredLiters && bucketTwo != desiredLiters) {
            String state = bucketOne + "," + bucketTwo;
            if (visited.containsKey(state)) {
                // We've hit a cycle, no solution
                return new Result(Integer.MAX_VALUE, "none", 0);
            }
            visited.put(state, true);
            
            // Determine next move based on start bucket
            if (startBucket.equals("one")) {
                // Rule: don't end with bucket one empty and bucket two full
                if (bucketOne == 0) {
                    bucketOne = bucketOneCap;
                } else if (bucketTwo == bucketTwoCap) {
                    bucketTwo = 0;
                } else {
                    // Pour from one to two
                    int pour = Math.min(bucketOne, bucketTwoCap - bucketTwo);
                    bucketOne -= pour;
                    bucketTwo += pour;
                }
            } else {
                // Rule: don't end with bucket two empty and bucket one full
                if (bucketTwo == 0) {
                    bucketTwo = bucketTwoCap;
                } else if (bucketOne == bucketOneCap) {
                    bucketOne = 0;
                } else {
                    // Pour from two to one
                    int pour = Math.min(bucketTwo, bucketOneCap - bucketOne);
                    bucketTwo -= pour;
                    bucketOne += pour;
                }
            }
            moves++;
            
            // Check if we've reached the goal
            if (bucketOne == desiredLiters) {
                return new Result(moves, "one", bucketTwo);
            }
            if (bucketTwo == desiredLiters) {
                return new Result(moves, "two", bucketOne);
            }
        }
        
        if (bucketOne == desiredLiters) {
            return new Result(moves, "one", bucketTwo);
        }
        return new Result(moves, "two", bucketOne);
    }

    static class Result {
        int moves;
        String finalBucket;
        int otherBucket;
        
        Result(int moves, String finalBucket, int otherBucket) {
            this.moves = moves;
            this.finalBucket = finalBucket;
            this.otherBucket = otherBucket;
        }
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucket;
    }
}
