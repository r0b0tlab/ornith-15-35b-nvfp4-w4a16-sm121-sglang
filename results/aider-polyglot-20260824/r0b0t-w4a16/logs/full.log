            "multiplied" => {
                // Check if next token is "by"
                if i + 1 >= tokens.len() || tokens[i + 1].as_str() != "by" {
                    return None;
                }
                // Check if there's a number after "by"
                if i + 2 >= tokens.len() {
                    return None;
                }
                result = result * tokens[i + 2].parse::<i32>().ok()?;
