import json

class User:
    def __init__(self, name):
        self.name = name
        self.owes = {}
        self.owed_by = {}
        self.balance = 0.0

    def to_dict(self):
        return {
            "name": self.name,
            "owes": self.owes,
            "owed_by": self.owed_by,
            "balance": self.balance
        }

class RestAPI:
    def __init__(self, database=None):
        self.database = {}
        if database:
            for user in database["users"]:
                name = user["name"]
                self.database[name] = User(name)
                self.database[name].owes = dict(user["owes"])
                self.database[name].owed_by = dict(user["owed_by"])
                self.balance_user(self.database[name])

    def balance_user(self, user):
        user.balance = sum(user.owed_by.values()) - sum(user.owes.values())

    def get(self, url, payload=None):
        if url == "/users":
            if payload is None:
                users = list(self.database.values())
            else:
                names = set(payload["users"])
                users = [self.database[name] for name in names if name in self.database]
            users.sort(key=lambda u: u.name)
            return json.dumps({"users": [u.to_dict() for u in users]})
        return None

    def post(self, url, payload=None):
        if url == "/add":
            name = payload["user"]
            if name not in self.database:
                self.database[name] = User(name)
            return json.dumps(self.database[name].to_dict())
        elif url == "/iou":
            self.handle_iou(payload)
            return None
        return None

    def handle_iou(self, payload):
        lender = payload["lender"]
        borrower = payload["borrower"]
        amount = payload["amount"]

        if lender not in self.database:
            self.database[lender] = User(lender)
        if borrower not in self.database:
            self.database[borrower] = User(borrower)

        lender_obj = self.database[lender]
        borrower_obj = self.database[borrower]

        if amount > 0:
            borrower_obj.owes[lender] = borrower_obj.owes.get(lender, 0) + amount
            lender_obj.owed_by[borrower] = lender_obj.owed_by.get(borrower, 0) + amount

        self.balance_user(lender_obj)
        self.balance_user(borrower_obj)

        return [lender_obj, borrower_obj]
