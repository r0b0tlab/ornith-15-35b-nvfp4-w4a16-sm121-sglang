MazeGenerator.java
```java
import java.util.Random;

public class MazeGenerator {

    private static final char WALL = '█';
    private static final char PASSAGE = ' ';
    private static final char ENTRANCE = '⇨';
    private static final char EXIT = '⇨';

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, new Random().nextInt());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        if (rows < 5 || rows > 100 || columns < 5 || columns > 100) {
            throw new IllegalArgumentException("Rows and columns must be between 5 and 100");
        }

        int height = 2 * rows + 1;
        int width = 2 * columns + 1;

        char[][] maze = new char[height][width];

        // Initialize all cells as walls
        for (int i = 0; i < height; i++) {
            for (int j = 0; j < width; j++) {
                maze[i][j] = WALL;
            }
        }

        // Initialize the grid: cells at odd coordinates are passable
        for (int i = 1; i < height; i += 2) {
            for (int j = 1; j < width; j += 2) {
                maze[i][j] = PASSAGE;
            }
        }

        // Generate the maze using recursive backtracking
        boolean[][] visited = new boolean[rows][columns];
        Random random = new Random(seed);
        generateMazeRecursive(maze, visited, 0, 0, rows, columns, random);

        // Set entrance and exit
        maze[1][0] = ENTRANCE;
        maze[height - 2][width - 1] = EXIT;

        return maze;
    }

    private void generateMazeRecursive(char[][] maze, boolean[][] visited, int row, int col, int rows, int columns, Random random) {
        visited[row][col] = true;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        // Shuffle directions
        int[] order = {0, 1, 2, 3};
        for (int i = order.length - 1; i > 0; i--) {
            int j = random.nextInt(i + 1);
            int temp = order[i];
            order[i] = order[j];
            order[j] = temp;
        }

        for (int dir : order) {
            int newRow = row + dr[dir];
            int newCol = col + dc[dir];

            if (newRow >= 0 && newRow < rows && newCol >= 0 && newCol < columns && !visited[newRow][newCol]) {
                // Remove wall between current cell and neighbor
                maze[row + dr[dir]][col + dc[dir]] = PASSAGE;
                generateMazeRecursive(maze, visited, newRow, newCol, rows, columns, random);
            }
        }
    }
}
