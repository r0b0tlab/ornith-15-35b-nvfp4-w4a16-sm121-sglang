VariableLengthQuantity.java
```java
import java.util.ArrayList;
import java.util.List;

class VariableLengthQuantity {

    List<String> encode(List<Long> numbers) {
        List<String> result = new ArrayList<>();
        for (Long number : numbers) {
            List<Long> encoded = encodeNumber(number);
            for (Long b : encoded) {
                result.add(String.format("0x%02x", b));
            }
        }
        return result;
    }

    private List<Long> encodeNumber(Long number) {
        List<Long> chunks = new ArrayList<>();
        long value = number & 0xFFFFFFFFL;
        if (value == 0) {
            chunks.add(0L);
            return chunks;
        }
        chunks.add(value & 0x7FL);
        value >>= 7;
        while (value > 0) {
            chunks.add((value & 0x7FL) | 0x80L);
            value >>= 7;
        }
        java.util.Collections.reverse(chunks);
        return chunks;
    }

    List<String> decode(List<Long> bytes) {
        List<String> result = new ArrayList<>();
        long accumulator = 0;
        boolean inSequence = false;
        for (Long b : bytes) {
            boolean last = (b & 0x80L) == 0;
            if (last) {
                if (!inSequence) {
                    throw new IllegalArgumentException("Invalid variable-length quantity encoding");
                }
                accumulator = ((accumulator << 7) | (b & 0x7FL)) & 0xFFFFFFFFL;
                result.add(String.format("0x%x", accumulator));
                accumulator = 0;
                inSequence = false;
            } else {
                if (inSequence) {
                    accumulator = ((accumulator << 7) | (b & 0x7FL)) & 0xFFFFFFFFL;
                } else {
                    accumulator = (b & 0x7FL);
                    inSequence = true;
                }
            }
        }
        if (inSequence) {
            throw new IllegalArgumentException("Invalid variable-length quantity encoding");
        }
        return result;
    }
}
```
