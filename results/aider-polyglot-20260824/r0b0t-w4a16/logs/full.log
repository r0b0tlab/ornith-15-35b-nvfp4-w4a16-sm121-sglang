/// Type implementing arbitrary-precision decimal arithmetic
pub struct Decimal {
    sign: i8,
    digits: Vec<u8>,
    scale: usize,
}

impl Decimal {
    pub fn try_from(input: &str) -> Option<Decimal> {
        let input = input.trim();
        let bytes: Vec<u8> = input.bytes().collect();
        
        // Handle empty
        if bytes.is_empty() {
            return None;
        }
        
        let mut idx = 0;
        let mut negative = false;
        
        // Handle sign
        if idx < bytes.len() && (bytes[idx] == b'+' || bytes[idx] == b'-') {
            if bytes[idx] == b'-' {
                negative = true;
            }
            idx += 1;
        }
        
        if idx >= bytes.len() {
            return None;
        }
        
        // Find decimal point
        let dot_pos = bytes.iter().position(|&b| b == b'.');
        let dot_pos = dot_pos.map(|p| p as usize);
        
        // Count fractional digits
        let scale = match dot_pos {
            Some(pos) => {
                if pos + 1 >= bytes.len() {
                    return None;
                }
                bytes.len() - pos - 1
            }
            None => 0,
        };
        
        // Build digit vector (removing dot)
        let mut digits: Vec<u8> = Vec::new();
        let mut seen_digit = false;
        for i in idx..bytes.len() {
            let b = bytes[i];
            if b == b'.' {
                continue;
            }
            if b < b'0' || b > b'9' {
                return None;
            }
            digits.push(b - b'0');
            seen_digit = true;
        }
        
        if !seen_digit {
            return None;
        }
        
        // Trim leading zeros
        while digits.len() > 1 && digits[0] == 0 {
            digits.remove(0);
        }
        
        // Determine sign
        let all_zero = digits.iter().all(|&d| d == 0);
        let sign = if all_zero {
            1
        } else if negative {
            -1
        } else {
            1
        };
        
        Some(Decimal { sign, digits, scale })
    }
}

impl PartialEq for Decimal {
    fn eq(&self, other: &Self) -> bool {
        self.cmp(other) == std::cmp::Ordering::Equal
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for Decimal {
    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
        // Compare by magnitude first
        let self_int = &self.digits[..(self.digits.len() - self.scale).min(self.digits.len()).max(0)..];
        // Simpler: compare sign, then magnitude
        match self.sign.cmp(&other.sign) {
            std::cmp::Ordering::Equal => {
                // Same sign, compare magnitude
                self.compare_magnitude(other)
            }
            other_order => other_order,
        }
    }
    
    fn compare_magnitude(&self, other: &Decimal) -> std::cmp::Ordering {
        // Compare two non-negative decimals
        // Align scales
        let max_scale = self.scale.max(other.scale);
        let mut self_aligned = self.digits.clone();
        let mut other_aligned = other.digits.clone();
        
        // Pad to same scale
        while self_aligned.len() < max_scale {
            self_aligned.insert(0, 0);
        }
        while other_aligned.len() < max_scale {
            other_aligned.insert(0, 0);
        }
        
        // Now the fractional part is the last max_scale digits
        let int_part_self_len = self_aligned.len() - self.scale;
        let int_part_other_len = other_aligned.len() - other.scale;
        
        // Compare integer parts
        let self_int = &self_aligned[..int_part_self_len];
        let other_int = &other_aligned[..int_part_other_len];
        
        // Compare by length first (longer = bigger for non-negative)
        let self_int_len = self_int.len();
        let other_int_len = other_int.len();
        
        if self_int_len != other_int_len {
            return self_int_len.cmp(&other_int_len);
        }
        
        // Compare digit by digit
        for i in 0..self_int_len {
            match self_int[i].cmp(&other_int[i]) {
                std::cmp::Ordering::Less => return std::cmp::Ordering::Less,
                std::cmp::Ordering::Greater => return std::cmp::Ordering::Greater,
                std::cmp::Ordering::Equal => continue,
            }
        }
        
        // Integer parts equal, compare fractional parts
        let self_frac = &self_aligned[int_part_self_len..];
        let other_frac = &other_aligned[int_part_other_len..];
        
        for i in 0..self_frac.len().max(other_frac.len()) {
            let s = *self_frac.get(i).unwrap_or(&0);
            let o = *other_frac.get(i).unwrap_or(&0);
            match s.cmp(&o) {
                std::cmp::Ordering::Less => return std::cmp::Ordering::Less,
                std::cmp::Ordering::Greater => return std::cmp::Ordering::Greater,
                std::cmp::Ordering::Equal => continue,
            }
        }
        
        std::cmp::Ordering::Equal
    }
}

impl std::ops::Add for Decimal {
    type Output = Decimal;
    fn add(self, rhs: Decimal) -> Decimal {
        // Handle signs
        if self.sign == rhs.sign {
            // Same sign, add magnitudes
            let mag = add_magnitude(&self.digits, self.scale, &rhs.digits, rhs.scale);
            Decimal { sign: self.sign, digits: mag.0, scale: mag.1 }
        } else {
            // Different signs, subtract smaller magnitude from larger
            let cmp = self.compare_magnitude(&rhs);
            match cmp {
                std::cmp::Ordering::Greater => {
                    let mag = sub_magnitude(&self.digits, self.scale, &rhs.digits, rhs.scale);
                    Decimal { sign: self.sign, digits: mag.0, scale: mag.1 }
                }
                std::cmp::Ordering::Less => {
                    let mag = sub_magnitude(&rhs.digits, rhs.scale, &self.digits, self.scale);
                    Decimal { sign: rhs.sign, digits: mag.0, scale: mag.1 }
                }
                std::cmp::Ordering::Equal => {
                    // Zero
                    Decimal { sign: 1, digits: vec![0], scale: 0 }
                }
            }
        }
    }
}

impl std::ops::Sub for Decimal {
    type Output = Decimal;
    fn sub(self, rhs: Decimal) -> Decimal {
        let neg_rhs = Decimal { sign: -rhs.sign, digits: rhs.digits, scale: rhs.scale };
        self + neg_rhs
    }
}

impl std::ops::Mul for Decimal {
    type Output = Decimal;
    fn mul(self, rhs: Decimal) -> Decimal {
        let mag = mul_magnitude(&self.digits, &rhs.digits);
        let scale = self.scale + rhs.scale;
        let sign = if self.sign == rhs.sign { 1 } else { -1 };
        Decimal { sign, digits: mag, scale }
    }
}

fn add_magnitude(a: &[u8], a_scale: usize, b: &[u8], b_scale: usize) -> (Vec<u8>, usize) {
    // Both non-negative
    let max_scale = a_scale.max(b_scale);
    let mut a_aligned = a.to_vec();
    let mut b_aligned = b.to_vec();
    
    while a_aligned.len() < max_scale {
        a_aligned.insert(0, 0);
    }
    while b_aligned.len() < max_scale {
        b_aligned.insert(0, 0);
    }
    
    // Add
    let len = a_aligned.len().max(b_aligned.len());
    let mut result: Vec<u8> = Vec::with_capacity(len + 1);
    let mut carry = 0;
    
    for i in 0..len {
        let av = *a_aligned.get(len - 1 - i).unwrap_or(&0);
        let bv = *b_aligned.get(len - 1 - i).unwrap_or(&0);
        let sum = av + bv + carry;
        result.push(sum % 10);
        carry = sum / 10;
    }
    if carry > 0 {
        result.push(carry);
    }
    result.reverse();
    
    // Trim leading zeros
    while result.len() > 1 && result[0] == 0 {
        result.remove(0);
    }
    
    (result, max_scale)
}

fn sub_magnitude(a: &[u8], a_scale: usize, b: &[u8], b_scale: usize) -> (Vec<u8>, usize) {
    // Assumes a >= b, both non-negative
    let max_scale = a_scale.max(b_scale);
    let mut a_aligned = a.to_vec();
    let mut b_aligned = b.to_vec();
    
    while a_aligned.len() < max_scale {
        a_aligned.insert(0, 0);
    }
    while b_aligned.len() < max_scale {
        b_aligned.insert(0, 0);
    }
    
    let len = a_aligned.len();
    let mut result: Vec<u8> = Vec::with_capacity(len);
    let mut borrow = 0;
    
    for i in 0..len {
        let av = *a_aligned.get(len - 1 - i).unwrap_or(&0);
        let bv = *b_aligned.get(len - 1 - i).unwrap_or(&0);
        let mut diff = av - bv - borrow;
        if diff < 0 {
            diff += 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        result.push(diff);
    }
    result.reverse();
    
    // Trim leading zeros
    while result.len() > 1 && result[0] == 0 {
        result.remove(0);
    }
    
    (result, max_scale)
}

fn mul_magnitude(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut result = vec![0u8; a.len() + b.len()];
    for i in (0..a.len()).rev() {
        let mut carry = 0;
        for j in (0..b.len()).rev() {
            let idx = i + j + 1;
            let prod = a[i] as u32 * b[j] as u32 + result[idx] as u32 + carry as u32;
            result[idx] = (prod % 10) as u8;
