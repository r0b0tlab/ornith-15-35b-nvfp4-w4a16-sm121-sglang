package bookstore

const basePrice = 800 // cents

// discount[i] is the discount percentage for a set of i different books.
var discounts = []int{0, 0, 5, 10, 20, 25}

// Cost calculates the minimum price for a basket of books.
func Cost(books []int) int {
	// Count copies of each book (indices 1..5).
	counts := make([]int, 6)
	for _, b := range books {
		counts[b]++
	}

	// Memoized recursive solver.
	memo := make(map[[6]int]int)

	var solve func(c [6]int) int
	solve = func(c [6]int) int {
		if v, ok := memo[c]; ok {
			return v
		}

		// Collect distinct book indices with count > 0.
		var distinct []int
		for i := 1; i <= 5; i++ {
			if c[i] > 0 {
				distinct = append(distinct, i)
			}
		}

		if len(distinct) == 0 {
			memo[c] = 0
			return 0
		}

		best := -1

		// Try forming a set of each size k from 1 to len(distinct).
		// For each k, choose which k distinct books (all combinations),
		// recursively solve the remainder, and take the minimum total.
		// To avoid enumerating all combinations, note that for a given k,
		// we should pick the k books with the largest counts. But to be
		// fully correct, we enumerate combinations.

		// Enumerate all non-empty subsets? That's 2^5 = 32 max. Feasible.
		// For each subset, form a set (cost) + recurse.
		n := len(distinct)
		for mask := 1; mask < (1 << n); mask++ {
			// Form a set from the books in this subset.
			// Each book in subset must have count > 0.
			newC := c
			valid := true
			for j := 0; j < n; j++ {
				if mask&(1<<j) != 0 {
					if newC[distinct[j]] <= 0 {
						valid = false
						break
					}
					newC[distinct[j]]--
				}
			}
			if !valid {
				continue
			}
			// Set size = number of set bits.
			size := 0
			for j := 0; j < n; j++ {
				if mask&(1<<j) != 0 {
					size++
				}
			}
			setCost := size * basePrice * (100 - discounts[size]) / 100
			total := setCost + solve(newC)
			if best == -1 || total < best {
				best = total
			}
		}

		memo[c] = best
		return best
	}

	return solve(counts)
}
