pub fn translate(input: &str) -> String {
    let words: Vec<&str> = input.split_whitespace().collect();
    let mut translated: Vec<String> = Vec::new();
    
    for word in words {
        translated.push(translate_word(word));
    }
    
    translated.join(" ")
}

fn translate_word(word: &str) -> String {
    let bytes: Vec<char> = word.chars().collect();
    
    // Rule 1: word begins with a vowel, or starts with "xr" or "yt"
    if starts_with_vowel(word) || word.starts_with("xr") || word.starts_with("yt") {
        return format!("{}ay", word);
    }
    
    // Check for consonant clusters
    let mut i = 0;
    
    // Rule 4: word starts with consonants followed by "y"
    while i < bytes.len() {
        let c = bytes[i];
        if c == 'y' {
            // Found the 'y' - split before it
            let (prefix, suffix) = word.split_at(i);
            return format!("{}{}ay", suffix, prefix);
        }
        
        // Check for 'qu'
        if c == 'q' && i + 1 < bytes.len() && bytes[i + 1] == 'u' {
            // Rule 3: move consonants + "qu" to end
            let (prefix, suffix) = word.split_at(i + 2);
            return format!("{}{}ay", suffix, prefix);
        }
        
        // Check if character is a consonant
        if is_consonant(c) {
            i += 1;
        } else {
            // Found first vowel - split here
            let (prefix, suffix) = word.split_at(i);
            return format!("{}{}ay", suffix, prefix);
        }
    }
    
    word.to_string()
}

fn starts_with_vowel(word: &str) -> bool {
    let first_char = word.chars().next().unwrap();
    matches!(first_char, 'a' | 'e' | 'i' | 'o' | 'u')
}

fn is_consonant(c: char) -> bool {
    !matches!(c, 'a' | 'e' | 'i' | 'o' | 'u')
}
```
