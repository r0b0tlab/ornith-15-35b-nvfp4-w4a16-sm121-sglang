```go
package variablelengthquantity

import "errors"

// EncodeVarint encodes a slice of uint32 values into variable length quantity bytes.
func EncodeVarint(input []uint32) []byte {
	var output []byte
	for _, value := range input {
		output = append(output, encodeValue(value)...)
	}
	return output
}

// encodeValue encodes a single uint32 value into VLQ bytes.
func encodeValue(value uint32) []byte {
	if value == 0 {
		return []byte{0x00}
	}

	// Collect 7-bit groups from least significant to most significant.
	var groups []byte
	for value > 0 {
		groups = append(groups, byte(value&0x7f))
		value >>= 7
	}

	// Reverse to get most significant group first, and set continuation bit on all but last.
	for i := len(groups) - 1; i > 0; i-- {
		groups[i] |= 0x80
	}

	// Reverse in place.
	for i, j := 0, len(groups)-1; i < j; i, j = i+1, j-1 {
		groups[i], groups[j] = groups[j], groups[i]
	}

	return groups
}

// DecodeVarint decodes a slice of VLQ bytes back into a slice of uint32 values.
func DecodeVarint(input []byte) ([]uint32, error) {
	var output []uint32
	var current uint32
	var haveBits bool

	for _, b := range input {
		if haveBits {
			// Check for overflow before shifting.
			if current&0xfe000000 != 0 {
				return nil, errors.New("overflow")
			}
			current = (current << 7) | uint32(b&0x7f)
		} else {
			current = uint32(b & 0x7f)
			haveBits = true
		}

		if b&0x80 == 0 {
			// Last byte of this value.
			output = append(output, current)
			current = 0
			haveBits = false
		}
	}

	if haveBits {
		// Input ended on an incomplete VLQ sequence.
		return nil, errors.New("incomplete sequence")
	}

	return output, nil
}
