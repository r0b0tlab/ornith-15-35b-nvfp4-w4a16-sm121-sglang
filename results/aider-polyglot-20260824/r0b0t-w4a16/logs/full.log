+func parseCard(card string) (Card, error) {
+       if len(card) < 2 {
+               return Card{}, fmt.Errorf("invalid card: %s", card)
+       }
+
+       suit := card[len(card)-1]
+       valueStr := card[:len(card)-1]
+
+       val, ok := valueMap[valueStr]
+       if !ok {
+               return Card{}, fmt.Errorf("invalid card value: %s", valueStr)
+       }
+
+       return Card{Value: val, Suit: suit}, nil
+}
