gigasecond.h
```cpp
#if !defined(GIGASECOND_H)
#define GIGASECOND_H

#include <ctime>

namespace gigasecond {

std::tm gigasecond_after(std::tm timestamp) {
    std::time_t epoch = std::timegm(&timestamp);
    epoch += 1000000000L;
    return *std::gmtime(&epoch);
}

}  // namespace gigasecond

#endif // GIGASECOND_H
