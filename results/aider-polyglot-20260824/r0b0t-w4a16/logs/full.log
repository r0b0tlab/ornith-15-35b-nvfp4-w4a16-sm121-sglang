package transpose

import "strings"

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length of input rows
	maxLen := 0
	for _, row := range input {
		if len(row) > maxLen {
			maxLen = len(row)
		}
	}

	// For each column, find the last row that has a character at that column
	// This determines how many rows the output should have
	lastRow := make([]int, maxLen)
	for col := 0; col < maxLen; col++ {
		for row := 0; row < len(input); row++ {
			if col < len(input[row]) {
				lastRow[col] = row
			}
		}
	}

	// Build the output
	output := make([]string, maxLen)
	for col := 0; col < maxLen; col++ {
		var sb strings.Builder
		for row := 0; row <= lastRow[col]; row++ {
			if col < len(input[row]) {
				sb.WriteByte(input[row][col])
			} else {
				sb.WriteByte(' ')
			}
		}
		output[col] = sb.String()
	}

	return output
}
