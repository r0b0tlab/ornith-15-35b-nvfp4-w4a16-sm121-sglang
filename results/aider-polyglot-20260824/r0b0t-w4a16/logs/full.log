Ok, let me implement this reactive system.

Let me first understand the requirements:
1. Input cells have settable values
2. Compute cells compute values in terms of other cells
3. When input changes, values propagate to reach a stable state
4. Compute cells register change callbacks that fire when value changes between stable states

I'll implement this using a dependency tracking system where compute cells subscribe to their input cells' changes.

react.js
```
//
// This is only a SKELETON file for the 'React' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class InputCell {
  constructor(value) {
    this.value = value;
    this.computeCells = [];
    this.callbacks = new Set();
  }

  setValue(newValue) {
    this.value = newValue;
    // Collect all compute cells that depend on this input cell
    const toUpdate = [...this.computeCells];
    
    // Process the queue until all cells are updated
    while (toUpdate.length > 0) {
      const computeCell = toUpdate.shift();
      const newValue = computeCell.computeValue();
      if (newValue !== computeCell.previousValue) {
        computeCell.value = newValue;
        computeCell.previousValue = newValue;
        // Add all compute cells that depend on this one
        toUpdate.push(...computeCell.computeCells);
        // Call callbacks for this compute cell
        for (const cb of computeCell.callbacks) {
          cb(newValue);
        }
      }
    }
  }

  addCallback(cb) {
    this.callbacks.add(cb);
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = fn(inputCells.map(cell => cell.value));
    this.previousValue = this.value;
    this.callbacks = new Set();
    this.computeCells = [];
    
    // Register this compute cell with each input cell
    for (const inputCell of inputCells) {
      inputCell.computeCells.push(this);
    }
  }

  computeValue() {
    return this.fn(this.inputCells.map(cell => cell.value));
  }

  addCallback(cb) {
    this.callbacks.add(cb);
  }

  removeCallback(cb) {
    this.callbacks.delete(cb);
  }
}

export class CallbackCell {
  constructor(fn) {
    this.value = fn();
    this.callbacks = new Set();
    this.computeCells = [];
    
    // Register with any compute cells that might use this
    // For CallbackCell, we just store the value
  }

  addCallback(cb) {
    this.callbacks.add(cb);
  }

  removeCallback(cb) {
    this.callbacks.delete(cb);
  }
