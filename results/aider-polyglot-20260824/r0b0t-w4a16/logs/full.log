```rust
pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

pub struct Forth;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

type Definition = Vec<Word>;

#[derive(Debug, Clone, PartialEq, Eq)]
enum Word {
    Number(Value),
    Add,
    Subtract,
    Multiply,
    Divide,
    Dup,
    Drop,
    Swap,
    Over,
    Custom(String),
}

pub struct ForthImpl {
    stack: Vec<Value>,
    definitions: std::collections::HashMap<String, Definition>,
}

impl Forth {
    pub fn new() -> Forth {
        ForthImpl {
            stack: Vec::new(),
            definitions: std::collections::HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        let tokens = tokenize(input);
        let mut i = 0;
        while i < tokens.len() {
            let token = tokens[i].to_lowercase();
            if token == ":" {
                self.eval_definition(&tokens, &mut i)?;
            } else {
                self.eval_word(&token)?;
            }
            i += 1;
        }
        Ok(())
    }
}

impl ForthImpl {
    fn eval_word(&mut self, word: &str) -> Result {
        if let Ok(n) = word.parse::<Value>() {
            self.stack.push(n);
            return Ok(());
        }

        if let Some(def) = self.definitions.get(word) {
            for w in def {
                match w {
                    Word::Number(n) => self.stack.push(*n),
                    Word::Add => self.arith(|a, b| a + b)?,
                    Word::Subtract => self.arith(|a, b| a - b)?,
                    Word::Multiply => self.arith(|a, b| a * b)?,
                    Word::Divide => self.arith(|a, b| a / b)?,
                    Word::Dup => {
                        if self.stack.is_empty() {
                            return Err(Error::StackUnderflow);
                        }
                        let n = *self.stack.last().unwrap();
                        self.stack.push(n);
                    }
                    Word::Drop => {
                        if self.stack.is_empty() {
                            return Err(Error::StackUnderflow);
                        }
                        self.stack.pop();
                    }
                    Word::Swap => {
                        let len = self.stack.len();
                        if len < 2 {
                            return Err(Error::StackUnderflow);
                        }
                        self.stack.swap(len - 1, len - 2);
                    }
                    Word::Over => {
                        let len = self.stack.len();
                        if len < 2 {
                            return Err(Error::StackUnderflow);
                        }
                        let n = self.stack[len - 2];
                        self.stack.push(n);
                    }
                    Word::Custom(name) => {
                        if let Some(new_def) = self.definitions.get(&name) {
                            for w in new_def {
                                self.eval_word(&word_of(w))?;
                            }
                        }
                    }
                }
            }
            return Ok(());
        }

        match word {
            "+" => self.arith(|a, b| a + b)?,
            "-" => self.arith(|a, b| a - b)?,
            "*" => self.arith(|a, b| a * b)?,
            "/" => self.arith(|a, b| a / b)?,
            "dup" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                let n = *self.stack.last().unwrap();
                self.stack.push(n);
            }
            "drop" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                self.stack.pop();
            }
            "swap" => {
                let len = self.stack.len();
                if len < 2 {
                    return Err(Error::StackUnderflow);
                }
                self.stack.swap(len - 1, len - 2);
            }
            "over" => {
                let len = self.stack.len();
                if len < 2 {
                    return Err(Error::StackUnderflow);
                }
                let n = self.stack[len - 2];
                self.stack.push(n);
            }
            _ => return Err(Error::UnknownWord),
        }
        Ok(())
    }

    fn arith(&mut self, op: impl Fn(i32, i32) -> i32) -> Result {
        if self.stack.len() < 2 {
            return Err(Error::StackUnderflow);
        }
        let b = self.stack.pop().unwrap();
        let a = self.stack.pop().unwrap();
        if b == 0 {
            return Err(Error::DivisionByZero);
        }
        let result = op(a, b);
        self.stack.push(result);
        Ok(())
    }

    fn eval_definition(&mut self, tokens: &[String], i: &mut usize) -> Result {
        // tokens[*i] == ":"
        *i += 1;
        if *i >= tokens.len() {
            return Err(Error::InvalidWord);
        }
        let name = tokens[*i].to_lowercase();
        if name.parse::<Value>().is_ok() {
            return Err(Error::InvalidWord);
        }
        *i += 1;
        if *i >= tokens.len() || tokens[*i] == ";" {
            return Err(Error::InvalidWord);
        }

        let mut def = Vec::new();
        while *i < tokens.len() && tokens[*i] != ";" {
            let token = tokens[*i].to_lowercase();
            if token.parse::<Value>().is_ok() {
                let n = token.parse::<Value>().unwrap();
                def.push(Word::Number(n));
            } else if let Some(d) = self.definitions.get(&token) {
                for w in d {
                    def.push(w.clone());
                }
            } else {
                def.push(self.builtin_word(&token));
            }
            *i += 1;
        }
        if *i >= tokens.len() {
            return Err(Error::InvalidWord);
        }
        *i += 1; // skip ";"

        self.definitions.insert(name, def);
        Ok(())
    }

    fn builtin_word(&self, word: &str) -> Word {
        match word {
            "+" => Word::Add,
            "-" => Word::Subtract,
            "*" => Word::Multiply,
            "/" => Word::Divide,
            "dup" => Word::Dup,
            "drop" => Word::Drop,
            "swap" => Word::Swap,
            "over" => Word::Over,
            _ => Word::Number(0),
        }
    }
}

fn word_of(w: &Word) -> String {
    match w {
        Word::Number(n) => n.to_string(),
        _ => String::new(),
    }
}

fn tokenize(input: &str) -> Vec<String> {
    input
        .split_whitespace()
        .map(|s| {
            s.chars()
                .map(|c| {
                    if c.is_ascii_alphanumeric() {
                        c
                    } else {
                        ' '
                    }
                })
                .collect::<String>()
        })
        .filter(|s: &String| !s.is_empty())
        .collect()
}
