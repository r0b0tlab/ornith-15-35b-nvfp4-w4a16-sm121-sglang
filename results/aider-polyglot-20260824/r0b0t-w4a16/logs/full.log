pig_latin.py
```python
def translate(text):
    vowels = set("aeiou")

    def translate_word(word):
        # Rule 1: If a word begins with a vowel, or starts with "xr" or "yt"
        if word[0] in vowels or word.startswith("xr") or word.startswith("yt"):
            return word + "ay"

        # Rule 3: If a word starts with zero or more consonants followed by "qu"
        for i in range(len(word)):
            if word[i] == "q" and i + 1 < len(word) and word[i + 1] == "u":
                return word[i + 2:] + word[:i + 2] + "ay"

        # Rule 2: If a word begins with one or more consonants
        for i in range(1, len(word)):
            if word[i] in vowels:
                return word[i:] + word[:i] + "ay"

        # Rule 4: If a word starts with one or more consonants followed by "y"
        for i in range(1, len(word)):
            if word[i] == "y":
                return word[i:] + word[:i] + "ay"

        return word + "ay"

    words = text.split()
    return " ".join(translate_word(word) for word in words)
```
