```go
package counter

import "testing"

// The system under test is supposed to be a system to count the
// number of lines, letters and total characters in supplied strings.
//
// The idea is that you perform the "add string" operation a number
// of times, passing in strings, and afterwards call the "lines",
// "letters" and "characters" functions to get the totals.
//
// Since this is a special exercise where we get to define the test
// suite, we define a System interface that any implementation must
// satisfy. The test suite below verifies correct behavior and
// detects problems with various implementations.

// System is the interface the counter tool must implement.
type System interface {
    // AddString performs the "add string" operation.
    AddString(s string)

    // Lines returns the number of lines.
    Lines() int

    // Letters returns the number of letters.
    Letters() int

    // Characters returns the total number of characters.
    Characters() int
}

// newTestSystems returns a set of sample implementations to test against.
// These represent common variations/implementations that may contain bugs.
func newTestSystems() map[string]System {
    systems := make(map[string]System)

    // Correct implementation
    systems["correct"] = &correctSystem{}

    // Implementation that ignores AddString (never accumulates)
    systems["ignoring"] = &ignoringSystem{}

    // Implementation that counts characters but not letters correctly
    systems["wrongLetters"] = &wrongLettersSystem{}

    // Implementation that has an off-by-one error in lines
    systems["offByOne"] = &offByOneSystem{}

    return systems
}

// correctSystem correctly counts lines, letters, and characters.
type correctSystem struct {
    lines    int
    letters  int
    characters int
}

func (s *correctSystem) AddString(str string) {
    s.characters += len(str)
    for _, r := range str {
        if r == '\n' {
            s.lines++
        }
        if isLetter(r) {
            s.letters++
        }
    }
}

func (s *correctSystem) Lines() int { return s.lines }
func (s *correctSystem) Letters() int { return s.letters }
func (s *correctSystem) Characters() int { return s.characters }

// ignoringSystem never accumulates anything.
type ignoringSystem struct{}

func (s *ignoringSystem) AddString(str string) {}
func (s *ignoringSystem) Lines() int { return 0 }
func (s *ignoringSystem) Letters() int { return 0 }
func (s *ignoringSystem) Characters() int { return 0 }

// wrongLettersSystem counts characters but doesn't count letters properly.
type wrongLettersSystem struct {
    lines    int
    letters  int
    characters int
}

func (s *wrongLettersSystem) AddString(str string) {
    s.lines = 0
    s.letters = 0
    s.characters = len(str)
}

func (s *wrongLettersSystem) Lines() int { return s.lines }
func (s *wrongLettersSystem) Letters() int { return s.letters }
func (s *wrongLettersSystem) Characters() int { return s.characters }

// offByOneSystem has an off-by-one error in lines.
type offByOneSystem struct {
    lines    int
    letters  int
    characters int
}

func (s *offByOneSystem) AddString(str string) {
    s.characters += len(str)
    for _, r := range str {
        if r == '\n' {
            s.lines++
        }
        if isLetter(r) {
            s.letters++
        }
    }
    s.lines++ // off-by-one bug
}

func (s *offByOneSystem) Lines() int { return s.lines }
func (s *offByOneSystem) Letters() int { return s.letters }
func (s *offByOneSystem) Characters() int { return s.characters }

// isLetter reports whether a rune is an alphabetical letter.
func isLetter(r rune) bool {
    return (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z')
}

func TestAddStringMultipleTimes(t *testing.T) {
    systems := newTestSystems()

    for name, sys := range systems {
        t.Run(name, func(t *testing.T) {
            // Add several strings
            sys.AddString("hello")
            sys.AddString("world\n")
            sys.AddString("Go 1.23")
            sys.AddString("\n\n")
            sys.AddString("letters: abcXYZ")

            // Expected values
            // Lines: "world\n", "\n\n" => 3 lines
            // Letters: hello, world, abc, XYZ => 5+5+3+3 = 16
            // Characters: 5+6+7+2+13 = 33
            expectedLines := 3
            expectedLetters := 16
            expectedCharacters := 33

            if got := sys.Lines(); got != expectedLines {
                t.Errorf("Lines() = %d, want %d", got, expectedLines)
            }
            if got := sys.Letters(); got != expectedLetters {
                t.Errorf("Letters() = %d, want %d", got, expectedLetters)
            }
            if got := sys.Characters(); got != expectedCharacters {
                t.Errorf("Characters() = %d, want %d", got, expectedCharacters)
            }
        })
    }
}

func TestAddStringSingleLine(t *testing.T) {
    systems := newTestSystems()

    for name, sys := range systems {
        t.Run(name, func(t *testing.T) {
            sys.AddString("single line no newline")

            expectedLines := 0
            expectedLetters := 21
            expectedCharacters := 23

            if got := sys.Lines(); got != expectedLines {
                t.Errorf("Lines() = %d, want %d", got, expectedLines)
            }
            if got := sys.Letters(); got != expectedLetters {
                t.Errorf("Letters() = %d, want %d", got, expectedLetters)
            }
            if got := sys.Characters(); got != expectedCharacters {
                t.Errorf("Characters() = %d, want %d", got, expectedCharacters)
            }
        })
    }
}

func TestAddStringEmpty(t *testing.T) {
    systems := newTestSystems()

    for name, sys := range systems {
        t.Run(name, func(t *testing.T) {
            sys.AddString("")

            expectedLines := 0
            expectedLetters := 0
            expectedCharacters := 0

            if got := sys.Lines(); got != expectedLines {
                t.Errorf("Lines() = %d, want %d", got, expectedLines)
            }
            if got := sys.Letters(); got != expectedLetters {
                t.Errorf("Letters() = %d, want %d", got, expectedLetters)
            }
            if got := sys.Characters(); got != expectedCharacters {
                t.Errorf("Characters() = %d, want %d", got, expectedCharacters)
            }
        })
    }
}

func TestAddStringOnlyLetters(t *testing.T) {
    systems := newTestSystems()

    for name, sys := range systems {
        t.Run(name, func(t *testing.T) {
            sys.AddString("abcDEF")

            expectedLines := 0
            expectedLetters := 6
            expectedCharacters := 6

            if got := sys.Lines(); got != expectedLines {
                t.Errorf("Lines() = %d, want %d", got, expectedLines)
            }
            if got := sys.Letters(); got != expectedLetters {
                t.Errorf("Letters() = %d, want %d", got, expectedLetters)
            }
            if got := sys.Characters(); got != expectedCharacters {
                t.Errorf("Characters() = %d, want %d", got, expectedCharacters)
            }
        })
    }
}
