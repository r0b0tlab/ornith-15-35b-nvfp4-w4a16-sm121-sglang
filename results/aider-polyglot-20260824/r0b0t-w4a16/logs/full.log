package sublist

// Relation type is defined in relations.go file.

func Sublist(l1, l2 []int) Relation {
	switch {
	case len(l1) == len(l2) && equalLen(l1, l2):
		return RelEqual
	case contains(l1, l2):
		return RelSublist
	case contains(l2, l1):
		return RelSuperlist
	default:
		return RelUnequal
	}
}

// equalLen reports whether two slices of equal length are element-wise equal.
func equalLen(a, b []int) bool {
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// contains reports whether l1 contains l2 as a contiguous sub-sequence.
func contains(l1, l2 []int) bool {
	if len(l2) == 0 {
		return true
	}
	if len(l2) > len(l1) {
		return false
	}
	for i := 0; i+len(l2) <= len(l1); i++ {
		if l1[i] == l2[0] && equalLen(l1[i:i+len(l2)], l2) {
			return true
		}
	}
	return false
}
```
