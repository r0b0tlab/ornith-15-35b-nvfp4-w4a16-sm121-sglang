I'll implement the Wordy problem solver. Let me analyze the requirements:

1. Parse questions starting with "What is"
2. Handle operations: plus, minus, multiplied by, divided by
3. Evaluate left-to-right
4. Handle errors for unsupported operations, non-math questions, and invalid syntax

wordy.js
```js
//
// This is only a SKELETON file for the 'Wordy' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const answer = (question) => {
  // Check that the question starts with "What is"
  if (!question.startsWith('What is')) {
    throw new Error('Unsupported operation');
  }

  // Remove "What is" prefix and trailing "?"
  let expression = question.slice('What is'.length, -1).trim();

  // If empty, it's a syntax error
  if (expression === '') {
    throw new Error('Syntax error');
  }

  // Parse the expression into tokens
  const tokens = expression.split(' ');
  
  // First token must be a number
  if (!/^-?\d+$/.test(tokens[0])) {
    throw new Error('Syntax error');
  }

  let result = parseInt(tokens[0], 10);
  let i = 1;

  while (i < tokens.length) {
    const op = tokens[i];
    const num = tokens[i + 1];

    // Check if the next token is a number
    if (!/^-?\d+$/.test(num)) {
      throw new Error('Syntax error');
    }

    // Process the operation
    switch (op) {
      case 'plus':
        result += parseInt(num, 10);
        break;
      case 'minus':
        result -= parseInt(num, 10);
        break;
      case 'multiplied':
        result *= parseInt(num, 10);
        break;
      case 'divided':
        result /= parseInt(num, 10);
        break;
      default:
        throw new Error('Unsupported operation');
    }

    // Advance by 2 (operation and number)
    i += 2;
  }

  // Return integer result
  return Math.trunc(result);
};
```
