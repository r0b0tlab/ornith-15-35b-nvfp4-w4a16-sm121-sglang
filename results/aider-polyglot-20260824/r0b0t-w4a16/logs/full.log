```rust
fn evaluate_hand(hand: &str) -> Vec<u8> {
    let mut ranks: Vec<u8> = hand.split_whitespace().map(parse_rank).collect();
    let suits: Vec<char> = hand.split_whitespace().map(|c| c.chars().nth(1).unwrap()).collect();

    let is_flush = suits.iter().all(|&s| s == suits[0]);
    ranks.sort();
    ranks.reverse();

    let is_wheel = ranks[0] == 14
        && ranks[1] == 5
        && ranks[2] == 4
        && ranks[3] == 3
        && ranks[4] == 2;
    let straight_high = if is_wheel { 1 } else { ranks[0] };
    let is_straight = check_straight(&ranks, is_wheel);

    let mut counts: Vec<(u8, u8)> = Vec::new();
    for &r in &ranks {
