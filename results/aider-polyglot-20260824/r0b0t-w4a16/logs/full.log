I'll fix the compilation errors. The issue is with `random_u8() % 1000` since `1000` exceeds `u8`'s max value of 255. I'll generate the three digits as a proper integer.

lib.rs
```rust
use std::collections::HashSet;
use std::sync::Mutex;

struct RobotState {
    names: HashSet<String>,
}

static ROBOT_STATE: Mutex<Option<RobotState>> = Mutex::new(None);

fn generate_name() -> String {
    // Two uppercase letters followed by three digits
    let letter1 = (b'A' + (random_u8() % 26) as u8) as char;
    let letter2 = (b'A' + (random_u8() % 26) as u8) as char;
    let digit1 = random_u8() % 10;
    let digit2 = random_u8() % 10;
    let digit3 = random_u8() % 10;

    format!("{}{}{}{}{}", letter1, letter2, digit1, digit2, digit3)
}

fn random_u8() -> u8 {
    // Simple pseudo-random using a counter combined with time-ish entropy
    static mut COUNTER: u64 = 0;
    unsafe {
        COUNTER = COUNTER.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        // Extract high bits as u8
        (COUNTER >> 56) as u8
    }
}

pub struct Robot {
    name: String,
}

impl Robot {
    pub fn new() -> Self {
        let name = {
            let mut state = ROBOT_STATE.lock().unwrap();
            if state.is_none() {
                *state = Some(RobotState {
                    names: HashSet::new(),
                });
            }
            let state = state.as_mut().unwrap();

            // Generate a unique name
            let name = loop {
                let candidate = generate_name();
                if !state.names.contains(&candidate) {
                    break candidate;
                }
            };

            state.names.insert(name.clone());
            name
        };

        Robot { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        // Remove old name from the set so it can be reused
        {
            let mut state = ROBOT_STATE.lock().unwrap();
            let state = state.as_mut().unwrap();
            state.names.remove(&self.name);
        }

        // Generate a new unique name
        let new_name = {
            let mut state = ROBOT_STATE.lock().unwrap();
            let state = state.as_mut().unwrap();

            loop {
                let candidate = generate_name();
                if !state.names.contains(&candidate) {
                    break candidate;
                }
            }
        };

        self.name = new_name;
    }
}
