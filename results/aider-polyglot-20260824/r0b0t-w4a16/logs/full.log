Here is the implementation of the `count` function.

The function counts rectangles by finding all pairs of corners that could form a valid rectangle, then verifies the edges connect them properly. Horizontal edges (`+` or `-`) must be continuous, and vertical edges (`+` or `|`) must be continuous.

rectangles.js
```js
export function count(grid) {
  if (!grid || grid.length === 0) return 0;

  const rows = grid.length;
  const cols = grid[0].length;
  let count = 0;

  // Iterate over all possible top-left and bottom-right corner pairs.
  for (let tl_r = 0; tl_r < rows; tl_r++) {
    for (let tl_c = 0; tl_c < cols; tl_c++) {
      if (grid[tl_r][tl_c] !== '+') continue;

      for (let br_r = tl_r + 1; br_r < rows; br_r++) {
        for (let br_c = tl_c + 1; br_c < cols; br_c++) {
          // The other two corners must also be '+'.
          if (grid[tl_r][br_c] !== '+' || grid[br_r][tl_c] !== '+') continue;
          if (grid[br_r][br_c] !== '+') continue;

          // Check the horizontal edges.
          if (!isHorizontalEdge(grid, tl_r, tl_c, br_c)) continue;
          if (!isHorizontalEdge(grid, br_r, tl_c, br_c)) continue;

          // Check the vertical edges.
          if (!isVerticalEdge(grid, tl_r, tl_c, br_r)) continue;
          if (!isVerticalEdge(grid, tl_r, br_c, br_r)) continue;

          count++;
        }
      }
    }
  }

  return count;

  // Verify that a horizontal segment (between two '+') consists only of '+' or '-'.
  function isHorizontalEdge(grid, r, c1, c2) {
    for (let c = c1; c <= c2; c++) {
      const ch = grid[r][c];
      if (ch !== '+' && ch !== '-') return false;
    }
    return true;
  }

  // Verify that a vertical segment (between two '+') consists only of '+' or '|'.
  function isVerticalEdge(grid, c, r1, r2) {
    for (let r = r1; r <= r2; r++) {
      const ch = grid[r][c];
      if (ch !== '+' && ch !== '|') return false;
    }
    return true;
  }
}
