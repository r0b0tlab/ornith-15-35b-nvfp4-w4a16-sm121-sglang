ZebraPuzzle.java
```java
import java.util.ArrayList;
import java.util.List;

class ZebraPuzzle {
    private static final String[] COLORS = {"red", "green", "ivory", "yellow", "blue"};
    private static final String[] NATIONALITIES = {"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"};
    private static final String[] BEVERAGES = {"coffee", "tea", "milk", "orangeJuice", "water"};
    private static final String[] HOBBIES = {"dancing", "painter", "reading", "football", "chess"};
    private static final String[] PETS = {"dog", "snail", "fox", "horse", "zebra"};

    private int[] colorAssignment;
    private int[] nationalityAssignment;
    private int[] beverageAssignment;
    private int[] hobbyAssignment;
    private int[] petAssignment;

    String getWaterDrinker() {
        solve();
        for (int i = 0; i < 5; i++) {
            if (beverageAssignment[i] == indexOf("water", BEVERAGES)) {
                return NATIONALITIES[nationalityAssignment[i]];
            }
        }
        return "";
    }

    String getZebraOwner() {
        solve();
        for (int i = 0; i < 5; i++) {
            if (petAssignment[i] == indexOf("zebra", PETS)) {
                return NATIONALITIES[nationalityAssignment[i]];
            }
        }
        return "";
    }

    private int indexOf(String value, String[] array) {
        for (int i = 0; i < array.length; i++) {
            if (array[i].equals(value)) {
                return i;
            }
        }
        return -1;
    }

    private void solve() {
        if (nationalityAssignment != null) {
            return;
        }

        int[] nationalities = new int[5];
        int[] colors = new int[5];
        int[] beverages = new int[5];
        int[] hobbies = new int[5];
        int[] pets = new int[5];

        // Constraint 10: Norwegian lives in first house
        nationalities[0] = indexOf("Norwegian", NATIONALITIES);

        // Constraint 15: Norwegian lives next to blue house
        colors[1] = indexOf("blue", COLORS);

        // Constraint 2: Englishman lives in red house
        // Constraint 6: green house immediately right of ivory house
        // Constraint 4: green house drinks coffee
        // Constraint 9: middle house drinks milk
        beverages[2] = indexOf("milk", BEVERAGES);

        // Try all permutations of the remaining nationalities (indices 1-4)
        String[] remainingNationalities = {"Englishman", "Spaniard", "Ukrainian", "Japanese"};
        for (int[] perm : allPermutations(remainingNationalities)) {
            for (int i = 0; i < 4; i++) {
                nationalities[i + 1] = indexOf(remainingNationalities[i] == null ? "" : remainingNationalities[i], NATIONALITIES);
            }
        }
    }

    private List<int[]> allPermutations(String[] items) {
        List<int[]> result = new ArrayList<>();
        int[] current = new int[items.length];
        for (int i = 0; i < items.length; i++) {
            current[i] = i;
        }
        return generatePermutations(current);
    }

    private List<int[]> generatePermutations(int[] current) {
        List<int[]> result = new ArrayList<>();
        permute(result, current, 0);
        return result;
    }

    private void permute(List<int[]> result, int[] current, int index) {
        if (index == current.length - 1) {
            result.add(current.clone());
            return;
        }
        for (int i = index; i < current.length; i++) {
            swap(current, index, i);
            permute(result, current, index + 1);
            swap(current, index, i);
        }
    }

    private void swap(int[] array, int i, int j) {
        int temp = array[i];
        array[i] = array[j];
        array[j] = temp;
    }
}
