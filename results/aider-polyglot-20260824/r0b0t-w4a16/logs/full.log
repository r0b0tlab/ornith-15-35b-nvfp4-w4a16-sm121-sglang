I'll analyze the graph exercise and implement it using the builder pattern.

Let me explain the changes needed:

1. Create a `Graph` struct with nodes and edges
2. Implement builder pattern methods for adding nodes and edges
3. Add methods to check if nodes exist and to get all nodes/edges

Here's the implementation:

lib.rs
```rust
pub mod graph {
    use std::collections::HashMap;

    #[derive(Debug, Clone, PartialEq, Eq, Hash)]
    pub struct Node {
        pub name: String,
        pub color: Option<String>,
    }

    #[derive(Debug, Clone, PartialEq, Eq, Hash)]
    pub struct Edge {
        pub from: String,
        pub to: String,
    }

    #[derive(Debug, Clone, Default)]
    pub struct Graph {
        nodes: HashMap<String, Option<String>>,
        edges: Vec<Edge>,
    }

    impl Graph {
        pub fn new() -> Self {
            Graph {
                nodes: HashMap::new(),
                edges: Vec::new(),
            }
        }

        pub fn with_nodes(&mut self, items: &[&str]) -> &mut Self {
            for item in items {
                self.nodes.insert(item.to_string(), None);
            }
            self
        }

        pub fn with_edges(&mut self, items: &[(&str, &str)]) -> &mut Self {
            for (from, to) in items {
                self.edges.push(Edge {
                    from: from.to_string(),
                    to: to.to_string(),
                });
            }
            self
        }

        pub fn has_node(&self, node: &str) -> bool {
            self.nodes.contains_key(node)
        }

        pub fn nodes(&self) -> Vec<Node> {
            self.nodes
                .keys()
                .map(|name| Node {
                    name: name.clone(),
                    color: None,
                })
                .collect()
        }

        pub fn edges(&self) -> Vec<Edge> {
            self.edges.clone()
        }
    }
}
