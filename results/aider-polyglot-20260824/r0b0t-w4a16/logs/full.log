    }
    
    let rightNum = 0;
    for (const ch of resultWord) {
      rightNum = rightNum * 10 + assignment[ch];
    }
    
    return leftSum === rightNum;
  }
  
  // Backtracking function
  function backtrack(index) {
    if (index === letterArray.length) {
      return isValidAssignment();
    }
    
    const letter = letterArray[index];
    for (const digit of digits) {
      if (!used.has(digit)) {
        used.add(digit);
        assignment[letter] = digit;
        
        if (backtrack(index + 1)) {
          return true;
        }
        
        used.delete(digit);
        delete assignment[letter];
      }
    }
    
    return false;
  }
  
  if (backtrack(0)) {
    return assignment;
  }
  
  return null;
};
