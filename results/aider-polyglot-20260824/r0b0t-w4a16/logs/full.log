        }
    }

    let initial = State { one, two };
    visited.insert(initial.clone());
    queue.push_back((initial, 0u8));

    while let Some((state, moves)) = queue.pop_front() {
        if state.one == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::One,
                other_bucket: state.two,
            });
        }
        if state.two == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::Two,
                other_bucket: state.one,
            });
        }

        let mut next_moves = moves + 1;

        // Try all 6 actions
        let mut next_states: Vec<State> = Vec::new();

        // Pour one into two
        {
            let mut s = state.clone();
            pour(&mut s.one, &mut s.two, capacity_2);
            next_states.push(s);
        }
        // Pour two into one
        {
            let mut s = state.clone();
            pour(&mut s.two, &mut s.one, capacity_1);
            next_states.push(s);
        }
        // Empty one
        {
            let mut s = state.clone();
            s.one = 0;
            next_states.push(s);
        }
        // Empty two
        {
            let mut s = state.clone();
            s.two = 0;
            next_states.push(s);
        }
        // Fill one
        {
            let mut s = state.clone();
            s.one = capacity_1;
            next_states.push(s);
        }
        // Fill two
        {
            let mut s = state.clone();
            s.two = capacity_2;
            next_states.push(s);
        }

        for s in next_states {
            // Check forbidden state
            if s.one == 0 && s.two == forbidden_other {
                continue;
            }
            if visited.contains(&s) {
                continue;
            }
            visited.insert(s.clone());
            queue.push_back((s, next_moves));
        }
    }

    None
}
```
