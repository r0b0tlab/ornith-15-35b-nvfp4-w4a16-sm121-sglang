response:
Looking at the test failures, I need to fix two main issues:

1. The `roll` method should return errors when appropriate (too many pins, game already complete, etc.)
2. The `score` method has a bug in the tenth frame handling — it's using `roll_index += 1` instead of `roll_index += 2` for the tenth-frame strike case, causing it to re-read the same roll.

The core problem is that the current implementation uses a "accumulate into rolls" approach that makes it hard to track game state properly. Let me rewrite with a cleaner approach that tracks rolls as a vector of individual rolls and validates them at roll time.

Here's the corrected `lib.rs`:

lib.rs
```rust
#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
}

impl BowlingGame {
    pub fn new() -> Self {
        BowlingGame { rolls: Vec::new() }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.is_game_complete() {
            return Err(Error::GameComplete);
        }
        if pins > 10 {
            return Err(Error::NotEnoughPinsLeft);
        }

        // In a normal frame, a first roll cannot exceed 10 pins.
        if self.rolls.len() < 20 {
            let frame_index = self.rolls.len() / 2;
            let within_frame = self.rolls.len() % 2;
            if within_frame == 0 {
                // This is the first roll of a normal frame.
                if pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
            } else {
                // This is the second roll of a normal frame.
                let first = self.rolls[self.rolls.len() - 1];
                if first + pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
            }
        }

        // Special handling for the 10th frame.
        if self.rolls.len() == 9 {
            // First roll of 10th frame.
            let first = self.rolls[0];
            if first == 10 {
                // Strike: need two more rolls.
                if pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
            } else {
                // Open or spare setup.
                if first + pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
            }
        } else if self.rolls.len() == 10 {
            // Second roll of 10th frame.
            let first = self.rolls[0];
            if first == 10 {
                // Strike followed by a bonus roll.
                if pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
            } else {
                // Spare setup: need one more roll.
                let second = self.rolls[1];
                if first + second == 10 {
                    if pins > 10 {
                        return Err(Error::NotEnoughPinsLeft);
                    }
                } else {
                    // Game is over after this roll.
                }
            }
        } else if self.rolls.len() == 11 {
            // Third roll of 10th frame.
            let first = self.rolls[0];
            let second = self.rolls[1];
            if first == 10 {
                // First roll was a strike.
                if second == 10 {
                    // Second roll was also a strike: bonus roll.
                    if pins > 10 {
                        return Err(Error::NotEnoughPinsLeft);
                    }
                } else {
                    // Game is over after this roll.
                }
            } else {
                // Second roll completed a spare: bonus roll.
                if first + second == 10 {
                    if pins > 10 {
                        return Err(Error::NotEnoughPinsLeft);
                    }
                }
            }
        }

        self.rolls.push(pins);
        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        let mut score = 0u16;
        let mut roll_index = 0;

        for _frame in 0..10 {
            if roll_index >= self.rolls.len() {
                return None;
            }

            if roll_index < 9 {
                // Normal frame
                if self.rolls[roll_index] == 10 {
                    // Strike
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let strike_value =
                        self.rolls[roll_index] + self.rolls[roll_index + 1] + self.rolls[roll_index + 2];
                    score += strike_value;
                    roll_index += 1;
                } else {
                    // Open frame or spare
                    if roll_index + 1 >= self.rolls.len() {
                        return None;
                    }
                    let first = self.rolls[roll_index];
                    let second = self.rolls[roll_index + 1];
                    if first + second > 10 {
                        return None;
                    }
                    if first + second == 10 {
                        // Spare
                        if roll_index + 2 >= self.rolls.len() {
                            return None;
                        }
                        let spare_value = first + second + self.rolls[roll_index + 2];
                        score += spare_value;
                    } else {
                        score += first + second;
                    }
                    roll_index += 2;
                }
            } else {
                // Tenth frame
                if roll_index + 1 >= self.rolls.len() {
                    return None;
                }
                let first = self.rolls[roll_index];
                let second = self.rolls[roll_index + 1];
                if first + second > 10 {
                    return None;
                }
                if first == 10 {
                    // Strike, need one more roll
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let third = self.rolls[roll_index + 2];
                    score += first + second + third;
                    roll_index += 2;
                } else if first + second == 10 {
                    // Spare, need one more roll
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    let third = self.rolls[roll_index + 2];
                    score += first + second + third;
                    roll_index += 2;
                } else {
                    // Open frame
                    score += first + second;
                    roll_index += 2;
                }
            }
        }

        Some(score)
    }

    fn is_game_complete(&self) -> bool {
        if self.rolls.len() < 9 {
            return false;
        }

        // Normal frames (rolls 0..18) must be complete.
        if self.rolls.len() < 18 {
            return false;
        }

        // The first 9 frames are complete if we have at least 18 rolls.
        if self.rolls.len() == 18 {
            // Determine the state of the 10th frame.
            let first = self.rolls[9];
            let second = self.rolls[10];
            if first == 10 {
                // Strike: need 2 rolls in 10th frame.
                return self.rolls.len() == 20;
            } else if first + second == 10 {
                // Spare: need 2 rolls in 10th frame.
                return self.rolls.len() == 20;
            } else {
                // Open frame: 2 rolls complete the 10th frame.
                return self.rolls.len() == 20;
            }
        }

        if self.rolls.len() == 20 {
            let first = self.rolls[9];
            let second = self.rolls[10];
            if first == 10 {
                // Strike in 10th frame: need a third roll.
                return false;
            } else if first + second == 10 {
                // Spare in 10th frame: need a third roll.
                return false;
            } else {
                // Open frame: game is complete.
                return true;
            }
        }

        if self.rolls.len() == 21 {
            return true;
        }

        false
    }
}
```
