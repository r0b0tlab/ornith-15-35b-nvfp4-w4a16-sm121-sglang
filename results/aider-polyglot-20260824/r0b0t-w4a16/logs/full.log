I'll implement the bottle song recitation function. The song counts down from the initial bottle count, with each verse following the pattern shown.

bottle-song.js
```javascript
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const numberWords = {
  0: 'no',
  1: 'one',
  2: 'two',
  3: 'three',
  4: 'four',
  5: 'five',
  6: 'six',
  7: 'seven',
  8: 'eight',
  9: 'nine',
  10: 'ten'
};

const pluralize = count => count === 1 ? 'bottle' : 'bottles';

const buildVerse = (bottles) => {
  const currentWord = numberWords[bottles];
  const nextWord = numberWords[bottles - 1];
  const nextWordFirstLetter = nextWord.charAt(0).toUpperCase();
  
  return `${currentWord.charAt(0).toUpperCase()} green ${pluralize(bottles)} hanging on the wall,
${currentWord.charAt(0).toUpperCase()} green ${pluralize(bottles)} hanging on the wall,
And if one green bottle should accidentally fall,
There'll be ${nextWord} green ${pluralize(bottles - 1)} hanging on the wall.`;
};

export const recite = (initialBottlesCount, takeDownCount) => {
  const verses = [];
  
  for (let i = 0; i < takeDownCount; i++) {
    const currentBottles = initialBottlesCount - i;
    verses.push(buildVerse(currentBottles));
  }
  
  return verses.join('\n\n');
};
```
