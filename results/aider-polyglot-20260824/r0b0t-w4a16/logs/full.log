import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;
import java.util.function.Supplier;

class ForthEvaluator {
    private final Map<String, Supplier<IntStack>> definitions = new HashMap<>();
    private final IntStack stack = new IntStack();

    List<Integer> evaluateProgram(List<String> input) {
        definitions.clear();
        stack.clear();

        for (String line : input) {
            evaluateLine(line);
        }

        return stack.toList();
    }

    private void evaluateLine(String line) {
        String trimmed = line.trim();
        if (trimmed.isEmpty()) {
            return;
        }

        if (trimmed.startsWith(":")) {
            evaluateDefinition(trimmed);
            return;
        }

        evaluateCommands(trimmed);
    }

    private void evaluateDefinition(String line) {
        int endIndex = line.indexOf(';');
        if (endIndex == -1) {
            throw new IllegalArgumentException("Invalid definition");
        }

        String definition = line.substring(1, endIndex).trim();
        String[] parts = definition.split("\\s+");
        if (parts.length < 2) {
            throw new IllegalArgumentException("Invalid definition");
        }

        String wordName = parts[0].toLowerCase();
        if (isNumber(wordName)) {
            throw new IllegalArgumentException("Invalid word name");
        }

        List<String> commands = new ArrayList<>();
        for (int i = 1; i < parts.length; i++) {
            commands.add(parts[i].toLowerCase());
        }

        definitions.put(wordName, () -> {
            IntStack newStack = new IntStack();
            newStack.addAll(stack);
            for (String command : commands) {
                executeCommand(command, newStack);
            }
            return newStack;
        });
    }

    private void evaluateCommands(String line) {
        String[] tokens = line.split("\\s+");
        for (String token : tokens) {
            executeCommand(token.toLowerCase());
        }
    }

    private void executeCommand(String command) {
        if (definitions.containsKey(command)) {
            IntStack newStack = definitions.get(command).get();
            stack.clear();
            stack.addAll(newStack);
            return;
        }
        executeCommand(command, stack);
    }

    private void executeCommand(String command, IntStack currentStack) {
        switch (command) {
            case "+":
                currentStack.popBinaryOp((a, b) -> a + b);
                break;
            case "-":
                currentStack.popBinaryOp((a, b) -> a - b);
                break;
            case "*":
                currentStack.popBinaryOp((a, b) -> a * b);
                break;
            case "/":
                currentStack.popBinaryOp((a, b) -> {
                    if (b == 0) {
                        throw new IllegalArgumentException("Division by zero");
                    }
                    return a / b;
                });
                break;
            case "dup":
                currentStack.dup();
                break;
            case "drop":
                currentStack.drop();
                break;
            case "swap":
                currentStack.swap();
                break;
            case "over":
                currentStack.over();
                break;
            default:
                if (isNumber(command)) {
                    currentStack.push(Integer.parseInt(command));
                } else {
                    throw new IllegalArgumentException("Invalid command: " + command);
                }
        }
    }

    private boolean isNumber(String s) {
        if (s.isEmpty()) {
            return false;
        }
        try {
            Integer.parseInt(s);
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    private static class IntStack {
        private final java.util.Deque<Integer> data = new java.util.ArrayDeque<>();

        void push(int value) {
            data.push(value);
        }

        void pushAll(List<Integer> values) {
            for (int value : values) {
                push(value);
            }
        }

        void addAll(IntStack other) {
            for (int i = other.data.size() - 1; i >= 0; i--) {
                data.push(other.data.toArray(new Integer[0])[i]);
            }
        }

        void clear() {
            data.clear();
        }

        List<Integer> toList() {
            List<Integer> result = new ArrayList<>();
            for (int value : data) {
                result.add(value);
            }
            return result;
        }

        int pop() {
            if (data.isEmpty()) {
                throw new IllegalArgumentException("Empty stack");
            }
            return data.pop();
        }

        void popBinaryOp(java.util.function.IntBinaryOperator op) {
            int b = pop();
            int a = pop();
            push(op.apply(a, b));
        }

        void dup() {
            if (data.isEmpty()) {
                throw new IllegalArgumentException("Empty stack");
            }
            push(data.peek());
        }

        void drop() {
            pop();
        }

        void swap() {
            if (data.size() < 2) {
                throw new IllegalArgumentException("Stack too small for swap");
            }
            int a = pop();
            int b = pop();
            push(a);
            push(b);
        }

        void over() {
            if (data.size() < 2) {
                throw new IllegalArgumentException("Stack too small for over");
            }
            int b = pop();
            int a = pop();
            push(a);
            push(b);
            push(a);
        }
    }
}
