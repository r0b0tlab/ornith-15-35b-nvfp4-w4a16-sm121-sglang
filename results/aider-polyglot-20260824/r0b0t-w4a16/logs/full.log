bowling.py
```python
class BowlingGame:
    def __init__(self):
        self.rolls = []  # List of pins knocked down in each roll

    def roll(self, pins):
        if len(self.rolls) == 0:
            self.rolls.append(pins)
            return
        
        # Determine how many rolls are in the current frame
        if len(self.rolls) < 19:
            # Still in frames 1-9
            if len(self.rolls) % 2 == 0:
                # First roll of a frame
                if pins > 10:
                    raise ValueError("invalid number of pins")
                self.rolls.append(pins)
            else:
                # Second roll of a frame
                firstRoll = self.rolls[-1]
                if firstRoll + pins > 10:
                    raise ValueError("invalid number of pins")
                self.rolls.append(pins)
        elif len(self.rolls) == 19:
            # 10th frame, first roll
            if self.rolls[18] == 10:
                # Strike in 10th frame, need bonus rolls
                if pins > 10:
                    raise ValueError("invalid number of pins")
                self.rolls.append(pins)
            else:
                # Not a strike, second roll of 10th frame
                if self.rolls[18] + pins > 10:
                    raise ValueError("invalid number of pins")
                self.rolls.append(pins)
        elif len(self.rolls) == 20:
            # 10th frame, after first bonus roll
            if self.rolls[18] == 10:
                # Strike in 10th frame, need two bonus rolls
                if self.rolls[19] == 10:
                    # Second bonus roll only if first was a strike
                    if pins > 10:
                        raise ValueError("invalid number of pins")
                    self.rolls.append(pins)
                else:
                    # First bonus roll was not a strike
                    if self.rolls[19] + pins > 10:
                        raise ValueError("invalid number of pins")
                    self.rolls.append(pins)
            else:
                # Not a strike in 10th frame, this is the bonus roll
                if pins > 10:
                    raise ValueError("invalid number of pins")
                self.rolls.append(pins)
        else:
            # Game is complete
            raise ValueError("cannot roll after game is complete")

    def score(self):
        score = 0
        rollIndex = 0
        
        for frame in range(10):
            if self.rolls[rollIndex] == 10:  # Strike
                # Check that we have enough rolls for the bonus
                if rollIndex + 2 >= len(self.rolls):
                    raise ValueError("cannot score a strike without enough rolls")
                # Bonus is the next two rolls
                score += 10 + self.rolls[rollIndex + 1] + self.rolls[rollIndex + 2]
                rollIndex += 1
            else:
                # Check for spare
                if rollIndex + 1 >= len(self.rolls):
                    raise ValueError("need two rolls to score a frame")
                firstRoll = self.rolls[rollIndex]
                secondRoll = self.rolls[rollIndex + 1]
                
                # Check for valid first roll (can't knock down more than remaining pins)
                if firstRoll > 10:
                    raise ValueError("invalid number of pins")
                
                if firstRoll + secondRoll == 10:  # Spare
                    # Check that we have enough rolls for the bonus
                    if rollIndex + 2 >= len(self.rolls):
                        raise ValueError("cannot score a spare without enough rolls")
                    score += 10 + self.rolls[rollIndex + 2]
                    rollIndex += 2
                else:  # Open frame
                    score += firstRoll + secondRoll
                    rollIndex += 2
                    # Check for open frame (less than 10)
                    if firstRoll + secondRoll < 10:
                        continue
                    else:
                        raise ValueError("invalid frame")
        
        return score
