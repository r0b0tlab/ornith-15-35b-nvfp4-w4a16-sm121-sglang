        if (value >= 1_000_000_000L && value % 1_000_000_000L == 0) {
            return (value / 1_000_000_000L) + " gigaohms";
        } else if (value >= 1_000_000L && value % 1_000_000L == 0) {
            return (value / 1_000_000L) + " megaohms";
        } else if (value >= 1_000L && value % 1_000L == 0) {
            return (value / 1_000L) + " kiloohms";
        } else {
