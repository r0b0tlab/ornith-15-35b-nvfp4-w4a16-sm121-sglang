// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

use std::marker::PhantomData;
use std::ptr;

/// A doubly linked list implementation using unsafe Rust.
///
/// Invariant: The list maintains a circular doubly-linked structure where:
/// - `head` points to the first element (or `None` if empty)
/// - `tail` points to the last element (or `None` if empty)
/// - Each node's `next` and `prev` pointers correctly link to adjacent nodes
/// - `len` correctly tracks the number of elements
pub struct LinkedList<T> {
    head: Option<Box<Node<T>>>,
    tail: Option<Box<Node<T>>>,
    len: usize,
    _marker: PhantomData<T>,
}

/// A node in the doubly linked list.
struct Node<T> {
    data: T,
    next: Option<Box<Node<T>>>,
    prev: Option<Box<Node<T>>>,
}

/// A cursor that points to a specific position in the list.
///
/// The cursor acts as if it's at the position of an element and can
/// insert/remove elements at that position.
pub struct Cursor<'a, T> {
    list: *mut LinkedList<T>,
    current: Option<&'a mut Node<T>>,
}

/// An iterator that moves from front to back through the list.
pub struct Iter<'a, T> {
    current: Option<&'a Node<T>>,
    _marker: PhantomData<&'a T>,
}

impl<T> Node<T> {
    fn new(data: T) -> Self {
        Node {
            data,
            next: None,
            prev: None,
        }
    }
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
            head: None,
            tail: None,
            len: 0,
            _marker: PhantomData,
        }
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.head.as_mut().map(|n| n.as_mut()),
        }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.tail.as_mut().map(|n| n.as_mut()),
        }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            current: self.head.as_ref().map(|n| n.as_ref()),
            _marker: PhantomData,
        }
    }
}

impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        match &mut self.current {
            Some(node) => Some(node.as_mut().data.as_mut()),
            None => None,
        }
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        match &mut self.current {
            Some(node) => {
                let next = node.as_mut().next.take();
                self.current = next.as_ref().map(|n| n.as_mut());
                next.map(|n| n.as_mut()).map(|n| &mut n.data)
            }
            None => None,
        }
    }

    /// Move one position backward (towards the front) and
    /// return a reference to the new position
    pub fn prev(&mut self) -> Option<&mut T> {
        match &mut self.current {
            Some(node) => {
                let prev = node.as_mut().prev.take();
                self.current = prev.as_ref().map(|n| n.as_mut());
                prev.map(|n| n.as_mut()).map(|n| &mut n.data)
            }
            None => None,
        }
    }

    /// Remove and return the element at the current position and move the cursor
    /// to the neighboring element that's closest to the back.
    pub fn take(&mut self) -> Option<T> {
        unsafe {
            let list = &mut *self.list;
            
            match self.current.take() {
                None => None,
                Some(node) => {
                    let node = Box::from_raw(node as *mut Node<T>);
                    let data = node.data;
                    
                    // Get the next and prev nodes
                    let next = node.next;
                    let prev = node.prev;
                    
                    // Update the links
                    match next {
                        Some(mut next_node) => {
                            next_node.prev = prev;
                        }
                        None => {
                            // We were at the tail
                            list.tail = prev;
                        }
                    }
                    
                    match prev {
                        Some(mut prev_node) => {
                            prev_node.next = next;
                        }
                        None => {
                            // We were at the head
                            list.head = next;
                        }
                        _ => {}
                    }
                    
                    list.len -= 1;
                    Some(data)
                }
            }
        }
    }

    pub fn insert_after(&mut self, element: T) {
        unsafe {
            let list = &mut *self.list;
            let mut new_node = Box::new(Node::new(element));
            
            match self.current.take() {
                None => {
                    // Insert at front
                    new_node.next = list.head.take();
                    new_node.prev = None;
                    if let Some(mut old_head) = list.head.take() {
                        old_head.prev = Some(new_node.clone());
                    } else {
                        list.tail = Some(new_node.clone());
                    }
                    list.head = Some(new_node);
                }
                Some(node) => {
                    let node = node as *mut Node<T>;
                    let node = &mut *node;
                    
                    // Insert after current node
                    new_node.prev = node.prev.clone();
                    new_node.next = Some(Box::new(std::mem::replace(node, Node::new(std::mem::take(&mut node.data)))));
                    
                    if let Some(mut next_node) = node.next.take() {
                        next_node.prev = Some(new_node.clone());
                    } else {
                        list.tail = Some(new_node.clone());
                    }
                    
                    match new_node.prev {
                        Some(_) => {}
                        None => list.head = Some(new_node.clone()),
                    }
                    
                    list.len += 1;
                }
            }
        }
    }

    pub fn insert_before(&mut self, element: T) {
        unsafe {
            let list = &mut *self.list;
            let mut new_node = Box::new(Node::new(element));
            
            match self.current.take() {
                None => {
                    // Insert at front
                    new_node.next = list.head.take();
                    new_node.prev = None;
                    if let Some(mut old_head) = list.head.take() {
                        old_head.prev = Some(new_node.clone());
                    } else {
                        list.tail = Some(new_node.clone());
                    }
                    list.head = Some(new_node);
                }
                Some(node) => {
                    let node = node as *mut Node<T>;
                    let node = &mut *node;
                    
                    // Insert before current node
                    new_node.next = Some(Box::new(std::mem::replace(node, Node::new(std::mem::take(&mut node.data)))));
                    new_node.prev = node.prev.clone();
                    
                    if let Some(mut prev_node) = node.prev.take() {
                        prev_node.next = Some(new_node.clone());
                    } else {
                        list.head = Some(new_node.clone());
                    }
                    
                    match new_node.next {
                        Some(_) => {}
                        None => list.tail = Some(new_node.clone()),
                    }
                    
                    list.len += 1;
                }
            }
        }
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        match self.current.take() {
            None => None,
            Some(node) => {
                let data = &node.data;
                self.current = node.next.as_ref().map(|n| n.as_ref());
                Some(data)
            }
        }
    }
}

impl<T> Drop for LinkedList<T> {
    fn drop(&mut self) {
        while let Some(_) = self.pop_back() {}
