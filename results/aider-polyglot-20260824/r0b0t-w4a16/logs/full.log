```
package zebra

type Solution struct {
	DrinksWater string
	OwnsZebra   string
}

// Nationalities indexed 0-4
const (
	Englishman  = "Englishman"
	Spaniard    = "Spaniard"
	Ukrainian   = "Ukrainian"
	Norwegian   = "Norwegian"
	Japanese    = "Japanese"
)

// Colors indexed 0-4
const (
	Red    = "red"
	Ivory  = "ivory"
	Green  = "green"
	Yellow = "yellow"
	Blue   = "blue"
)

// Beverages indexed 0-4
const (
	Coffee      = "coffee"
	Tea         = "tea"
	Milk        = "milk"
	OrangeJuice = "orangejuice"
	Water       = "water"
)

// Smokes indexed 0-4
const (
	OldGold     = "oldgold"
	Kools       = "kools"
	Chesterfields = "Chesterfields"
	LuckyStrike = "luckystrike"
	Parliaments = "parliaments"
)

// Pets indexed 0-4
const (
	Dog     = "dog"
	Snails  = "snails"
	Fox     = "fox"
	Horse   = "horse"
	Zebra   = "zebra"
)

// SolvePuzzle solves the zebra puzzle using constraint propagation and backtracking.
func SolvePuzzle() Solution {
	// Generate all permutations of nationalities
	nationalities := []string{Englishman, Spaniard, Ukrainian, Norwegian, Japanese}
	colors := []string{Red, Ivory, Green, Yellow, Blue}
	beverages := []string{Coffee, Tea, Milk, OrangeJuice, Water}
	smokes := []string{OldGold, Kools, Chesterfields, LuckyStrike, Parliaments}
	pets := []string{Dog, Snails, Fox, Horse, Zebra}

	// Try all permutations of nationalities
	for _, natPerm := range permutations(nationalities) {
		// Constraint 2: Englishman lives in red house
		// Constraint 10: Norwegian lives in first house
		if natPerm[0] != Norwegian {
			continue
		}

		// Try all permutations of colors
		for _, colorPerm := range permutations(colors) {
			// Constraint 6: Green house is immediately right of ivory house
			if colorPerm[3] != Green || colorPerm[2] != Ivory {
				continue
			}

			// Try all permutations of beverages
			for _, bevPerm := range permutations(beverages) {
				// Constraint 9: Milk is drunk in middle house
				if bevPerm[2] != Milk {
					continue
				}

				// Constraint 4: Coffee in green house
				if bevPerm[3] != Coffee {
					continue
				}

				// Constraint 5: Ukrainian drinks tea
				// Find Ukrainian position
				ukrainianPos := -1
				for i := 0; i < 5; i++ {
					if natPerm[i] == Ukrainian {
						ukrainianPos = i
						break
					}
				}
				if bevPerm[ukrainianPos] != Tea {
					continue
				}

				// Try all permutations of smokes
				for _, smokePerm := range permutations(smokes) {
					// Constraint 14: Japanese smokes Parliaments
					japanesePos := -1
					for i := 0; i < 5; i++ {
						if natPerm[i] == Japanese {
							japanesePos = i
							break
						}
					}
					if smokePerm[japanesePos] != Parliaments {
						continue
					}

					// Constraint 8: Kools in yellow house
					yellowPos := -1
					for i := 0; i < 5; i++ {
						if colorPerm[i] == Yellow {
							yellowPos = i
							break
						}
					}
					if smokePerm[yellowPos] != Kools {
						continue
					}

					// Constraint 13: Lucky Strike drinks orange juice
					for i := 0; i < 5; i++ {
						if smokePerm[i] == LuckyStrike && bevPerm[i] != OrangeJuice {
							goto nextSmokePerm
						}
					}

					// Constraint 2: Englishman in red house
					englishPos := -1
					for i := 0; i < 5; i++ {
						if natPerm[i] == Englishman {
							englishPos = i
							break
						}
					}
					if colorPerm[englishPos] != Red {
						continue
					}

					// Try all permutations of pets
					for _, petPerm := range permutations(pets) {
						// Constraint 3: Spaniard owns dog
						spaniardPos := -1
						for i := 0; i < 5; i++ {
							if natPerm[i] == Spaniard {
								spaniardPos = i
								break
							}
						}
						if petPerm[spaniardPos] != Dog {
							continue
						}

						// Constraint 7: Old Gold owns snails
						oldgoldPos := -1
						for i := 0; i < 5; i++ {
							if smokePerm[i] == OldGold {
								oldgoldPos = i
								break
							}
						}
						if petPerm[oldgoldPos] != Snails {
							continue
						}

						// Constraint 11: Chesterfields next to fox
						chesterPos := -1
						foxPos := -1
						for i := 0; i < 5; i++ {
							if smokePerm[i] == Chesterfields {
								chesterPos = i
							}
							if petPerm[i] == Fox {
								foxPos = i
							}
						}
						if abs(chesterPos-foxPos) != 1 {
							continue
						}

						// Constraint 12: Kools next to horse
						koolsPos := -1
						horsePos := -1
						for i := 0; i < 5; i++ {
							if smokePerm[i] == Kools {
								koolsPos = i
							}
							if petPerm[i] == Horse {
								horsePos = i
							}
						}
						if abs(koolsPos-horsePos) != 1 {
							continue
						}

						// Found solution!
						// Find who drinks water and owns zebra

						// Water drinker
						waterPos := -1
						for i := 0; i < 5; i++ {
							if bevPerm[i] == Water {
								waterPos = i
								break
							}
						}

						// Zebra owner
						zebraPos := -1
						for i := 0; i < 5; i++ {
							if petPerm[i] == Zebra {
								zebraPos = i
								break
							}
						}

						return Solution{
							DrinksWater: natPerm[waterPos],
							OwnsZebra:   natPerm[zebraPos],
						}

					nextSmokePerm:
				}
			}
		}
	}

	return Solution{}
}

// permutations returns all permutations of the given slice.
func permutations(input []string) [][]string {
	if len(input) <= 1 {
		return [][]string{input}
	}

	var result [][]string
	for i := 0; i < len(input); i++ {
		rest := make([]string, 0)
		rest = append(rest, input[:i]...)
		rest = append(rest, input[i+1:]...)

		further := permutations(rest)
		for _, perm := range further {
			result = append(result, append([]string{input[i]}, perm...))
		}
	}

	return result
}

// abs returns the absolute value of an int.
func abs(x int) int {
	if x < 0 {
		return -x
	}
	return x
}
