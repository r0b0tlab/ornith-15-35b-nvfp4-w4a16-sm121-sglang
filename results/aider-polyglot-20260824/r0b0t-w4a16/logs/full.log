// Drinks: 0=Milk, 1=Coffee, 2=Tea, 3=OrangeJuice, 4=Water
// Hobbies: 0=Dancing, 1=Painter, 2=Reader, 3=Football, 4=Chess

bool check(const std::array<int, 5>& nationality,
           const std::array<int, 5>& color,
           const std::array<int, 5>& pet,
           const std::array<int, 5>& drink,
           const std::array<int, 5>& hobby) {
    // 2. The Englishman lives in the red house.
    for (int i = 0; i < 5; ++i) {
        if (nationality[i] == 3 && color[i] != 0) return false;  // Englishman=Red
        if (nationality[i] != 3 && color[i] == 0) return false;
    }
    // 3. The Spaniard owns the dog.
    for (int i = 0; i < 5; ++i) {
        if (nationality[i] == 1 && pet[i] != 0) return false;
        if (nationality[i] != 1 && pet[i] == 0) return false;
    }
    // 4. The person in the green house drinks coffee.
    for (int i = 0; i < 5; ++i) {
        if (color[i] == 2 && drink[i] != 1) return false;  // Green=Coffee
        if (color[i] != 2 && drink[i] == 1) return false;
    }
    // 5. The Ukrainian drinks tea.
    for (int i = 0; i < 5; ++i) {
        if (nationality[i] == 2 && drink[i] != 2) return false;  // Ukrainian=Tea
        if (nationality[i] != 2 && drink[i] == 2) return false;
    }
