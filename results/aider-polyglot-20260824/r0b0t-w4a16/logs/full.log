I'll implement the singly linked list for the music player application.

simple_linked_list.py
```python
class EmptyListException(Exception):
    pass


class Node:
    def __init__(self, value):
        self._value = value
        self._next = None

    def value(self):
        return self._value

    def next(self):
        return self._next


class LinkedList:
    def __init__(self, values=None):
        self._head = None
        if values is not None:
            for value in values:
                self.push(value)

    def __iter__(self):
        current = self._head
        while current is not None:
            yield current.value()
            current = current.next()

    def __len__(self):
        count = 0
        current = self._head
        while current is not None:
            count += 1
            current = current.next()
        return count

    def head(self):
        if self._head is None:
            raise EmptyListException("The list is empty.")
        return self._head

    def push(self, value):
        node = Node(value)
        if self._head is None:
            self._head = node
        else:
            node._next = self._head
            self._head = node

    def pop(self):
        if self._head is None:
            raise EmptyListException("The list is empty.")
        node = self._head
        self._head = self._head.next()
        return node.value()

    def reversed(self):
        result = []
        current = self._head
        while current is not None:
            result.append(current.value())
            current = current.next()
        result.reverse()
        return result
```
