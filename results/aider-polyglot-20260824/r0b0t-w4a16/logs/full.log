//
// This is only a SKELETON file for the 'Binary' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Binary {
  constructor(binary) {
    this.binary = binary;
  }

  toDecimal() {
    let decimal = 0;
    for (let i = 0; i < this.binary.length; i++) {
      const digit = this.binary[this.binary.length - 1 - i];
      if (digit !== '0' && digit !== '1') {
        return 0;
      }
      decimal += Number(digit) * Math.pow(2, i);
    }
    return decimal;
  }
}
```
