#[derive(PartialEq, Eq, Debug)]
pub enum Bucket {
    One,
    Two,
}

/// A struct to hold your results in.
#[derive(PartialEq, Eq, Debug)]
pub struct BucketStats {
    /// The total number of "moves" it should take to reach the desired number of liters, including
    /// the first fill.
    pub moves: u8,
    /// Which bucket should end up with the desired number of liters? (Either "one" or "two")
    pub goal_bucket: Bucket,
    /// How many liters are left in the other bucket?
    pub other_bucket: u8,
}

#[derive(Debug, PartialEq, Eq, Hash)]
struct State {
    one: u8,
    two: u8,
}

#[derive(PartialEq, Eq, Debug)]
enum Outcome {
    GoalReached {
        moves: u8,
        goal_bucket: Bucket,
        other_bucket: u8,
    },
    Invalid,
}

fn pour(from: &mut u8, to: &mut u8, capacity: u8) {
    let amount = std::cmp::min(*from, capacity - *to);
    *from -= amount;
    *to += amount;
}

fn try_fill_one(one: &mut u8, cap: u8) -> bool {
    if *one != cap {
        *one = cap;
        true
    } else {
        false
    }
}

fn try_fill_two(two: &mut u8, cap: u8) -> bool {
    if *two != cap {
        *two = cap;
        true
    } else {
        false
    }
}

fn try_empty_one(one: &mut u8) -> bool {
    if *one != 0 {
        *one = 0;
        true
    } else {
        false
    }
}

fn try_empty_two(two: &mut u8) -> bool {
    if *two != 0 {
        *two = 0;
        true
    } else {
        false
    }
}

pub fn solve(
    capacity_1: u8,
    capacity_2: u8,
    goal: u8,
    start_bucket: &Bucket,
) -> Option<BucketStats> {
    // The forbidden state: starting bucket empty, other full
    let (forbidden_other, forbidden_start) = match start_bucket {
        Bucket::One => (capacity_2, capacity_1),
        Bucket::Two => (capacity_1, capacity_2),
    };

    let mut visited = std::collections::HashSet::new();
    let mut queue = std::collections::VecDeque::new();

    // Initial state: fill the start bucket
    let (mut one, mut two) = (0u8, 0u8);
    match start_bucket {
        Bucket::One => {
            one = capacity_1;
        }
        Bucket::Two => {
            two = capacity_2;
        }
    }

    let initial = State { one, two };
    visited.insert(initial.clone());
    queue.push_back((initial, 0u8));

    while let Some((state, moves)) = queue.pop_front() {
        if state.one == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::One,
                other_bucket: state.two,
            });
        }
        if state.two == goal {
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::Two,
                other_bucket: state.one,
            });
        }

        let mut next_moves = moves + 1;

        // Try all 6 actions
        let mut next_states: Vec<State> = Vec::new();

        // Pour one into two
        {
            let mut s = state.clone();
            pour(&mut s.one, &mut s.two, capacity_2);
            next_states.push(s);
        }
        // Pour two into one
        {
            let mut s = state.clone();
            pour(&mut s.two, &mut s.one, capacity_1);
            next_states.push(s);
        }
        // Empty one
        {
            let mut s = state.clone();
            s.one = 0;
            next_states.push(s);
        }
        // Empty two
        {
            let mut s = state.clone();
            s.two = 0;
            next_states.push(s);
        }
        // Fill one
        {
            let mut s = state.clone();
            s.one = capacity_1;
            next_states.push(s);
        }
        // Fill two
        {
            let mut s = state.clone();
            s.two = capacity_2;
            next_states.push(s);
        }

        for s in next_states {
            // Check forbidden state
            if s.one == 0 && s.two == forbidden_other {
                continue;
            }
            if visited.contains(&s) {
                continue;
            }
            visited.insert(s.clone());
            queue.push_back((s, next_moves));
        }
    }

    None
}
