    pub fn set_value(&mut self, id: InputCellId, new_value: T) -> bool {
        if let Some(input_cell) = self.input_cells.iter_mut().find(|c| c.id == Some(id)) {
            input_cell.value = new_value;
            self.propagate();
            true
        } else {
