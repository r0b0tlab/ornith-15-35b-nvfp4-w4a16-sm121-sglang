+int score(std::array<int, 5> dice, Category category) {
+    std::array<int, 6> counts{};
+    for (int die : dice) {
+        counts[die - 1]++;
+    }
+
+    int sum = 0;
+    for (int die : dice) {
+        sum += die;
+    }
+
+    switch (category) {
+        case Category::Ones:
+            return counts[0] * 1;
+        case Category::Twos:
+            return counts[1] * 2;
+        case Category::Threes:
+            return counts[2] * 3;
+        case Category::Fours:
+            return counts[3] * 4;
+        case Category::Fives:
+            return counts[4] * 5;
+        case Category::Sixes:
+            return counts[5] * 6;
+        case Category::FullHouse: {
+            bool hasThree = false;
+            bool hasTwo = false;
+            for (int count : counts) {
+                if (count == 3) hasThree = true;
+                if (count == 2) hasTwo = true;
+            }
+            return (hasThree && hasTwo) ? sum : 0;
+        }
+        case Category::FourOfAKind: {
+            for (int i = 0; i < 6; i++) {
+                if (counts[i] >= 4) {
