I need to fix two issues: the `encode` function for large 32-bit values, and the error message for incomplete sequences.

The problem with `encode` is that JavaScript's bitwise operators work on 32-bit signed integers, so values like `0xffffffff` get mishandled. I'll use arithmetic instead of bitwise operations.

variable-length-quantity.js
```javascript
//
// This is only a SKELETON file for the 'Variable Length Quantity' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const encode = (numbers) => {
  const result = [];
  for (const number of numbers) {
    if (number < 0) {
      throw new Error('Negative numbers are not allowed');
    }
    const bytes = [];
    let value = number;
    bytes.push(value % 128);
    value = Math.floor(value / 128);
    while (value > 0) {
      bytes.push((value % 128) | 0x80);
      value = Math.floor(value / 128);
    }
    bytes.reverse();
    for (const byte of bytes) {
      result.push(byte);
    }
  }
  return result;
};

export const decode = (bytes) => {
  const result = [];
  let value = 0;
  let inProgress = false;
  for (const byte of bytes) {
    if (inProgress) {
      value = ((value << 7) | (byte & 0x7f)) >>> 0;
    } else {
      value = byte & 0x7f;
    }
    if (byte & 0x80) {
      inProgress = true;
    } else {
      result.push(value);
      value = 0;
      inProgress = false;
    }
  }
  if (inProgress) {
    throw new Error('Incomplete sequence');
  }
  return result;
};
```
