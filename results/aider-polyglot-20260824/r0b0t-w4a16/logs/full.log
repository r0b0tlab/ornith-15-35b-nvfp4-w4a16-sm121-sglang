The current approach of only trying the first remaining domino doesn't allow for proper backtracking. I need to try all remaining dominoes at each step, checking that they match the last domino in the current chain.

dominoes.py
```
def can_chain(dominoes):
    if not dominoes:
        return []

    def build_chain(current_chain, remaining):
        if not remaining:
            # Check if it's a valid chain: first and last match
            if current_chain and current_chain[0][0] == current_chain[-1][1]:
                return current_chain
            return None

        # Try each remaining domino that matches the last domino in the chain
        for i, domino in enumerate(remaining):
            if domino[0] == current_chain[-1][1]:
                new_remaining = remaining[:i] + remaining[i+1:]
                result = build_chain(current_chain + [domino], new_remaining)
                if result:
                    return result

            # Try the domino flipped
            flipped = (domino[1], domino[0])
            if flipped[0] == current_chain[-1][1] and flipped != domino:
                new_remaining = remaining[:i] + remaining[i+1:]
                result = build_chain(current_chain + [flipped], new_remaining)
                if result:
                    return result

        return None

    # Try each domino as the starting point
    for i in range(len(dominoes)):
        start = dominoes[i]
        remaining = dominoes[:i] + dominoes[i+1:]

        result = build_chain([start], remaining)
        if result:
            return result

    return None
