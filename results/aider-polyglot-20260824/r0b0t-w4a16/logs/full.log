                    return new Result(curMoves + 1, "two", nextOne4);
                }
                queue.add(new int[]{nextOne4, nextTwo4, curMoves + 1});
            }
            
            // Action 5: Fill bucket one
            int nextOne5 = bucketOneCap;
            int nextTwo5 = curTwo;
            String key5 = nextOne5 + "," + nextTwo5;
            if (!visited.containsKey(key5)) {
                visited.put(key5, curMoves + 1);
                if (nextOne5 == desiredLiters) {
                    return new Result(curMoves + 1, "one", nextTwo5);
                }
                if (nextTwo5 == desiredLiters) {
                    return new Result(curMoves + 1, "two", nextOne5);
                }
                queue.add(new int[]{nextOne5, nextTwo5, curMoves + 1});
            }
            
            // Action 6: Fill bucket two
            int nextOne6 = curOne;
            int nextTwo6 = bucketTwoCap;
            String key6 = nextOne6 + "," + nextTwo6;
            if (!visited.containsKey(key6)) {
                visited.put(key6, curMoves + 1);
                if (nextOne6 == desiredLiters) {
                    return new Result(curMoves + 1, "one", nextTwo6);
                }
                if (nextTwo6 == desiredLiters) {
                    return new Result(curMoves + 1, "two", nextOne6);
                }
                queue.add(new int[]{nextOne6, nextTwo6, curMoves + 1});
            }
        }
        
        // No solution found
        return new Result(Integer.MAX_VALUE, "none", 0);
    }

    static class Result {
        int moves;
        String finalBucket;
        int otherBucket;
        
        Result(int moves, String finalBucket, int otherBucket) {
            this.moves = moves;
            this.finalBucket = finalBucket;
            this.otherBucket = otherBucket;
        }
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucket;
    }
}
