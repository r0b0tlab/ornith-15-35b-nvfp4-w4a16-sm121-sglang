import java.util.ArrayList;
import java.util.List;

public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) {
            throw new SgfParsingException("input is empty");
        }

        if (input.charAt(0) != '(') {
            throw new SgfParsingException("tree missing");
        }

        return parseTree(input, new int[]{0});
    }

    private SgfNode parseTree(String input, int[] pos) throws SgfParsingException {
        // Skip whitespace
        while (pos[0] < input.length() && Character.isWhitespace(input.charAt(pos[0]))) {
            pos[0]++;
        }

        if (pos[0] >= input.length() || input.charAt(pos[0]) != '(') {
            throw new SgfParsingException("expected '('");
        }

        pos[0]++; // Skip '('

        // Skip whitespace
        while (pos[0] < input.length() && Character.isWhitespace(input.charAt(pos[0]))) {
            pos[0]++;
        }

        SgfNode root = new SgfNode();

        // Skip whitespace
        while (pos[0] < input.length() && Character.isWhitespace(input.charAt(pos[0]))) {
            pos[0]++;
        }

        // Check if there's a node
        if (pos[0] < input.length() && input.charAt(pos[0]) == ';') {
            pos[0]++; // Skip ';'
            parseNode(input, root, pos);
        }

        // Parse children
        while (pos[0] < input.length() && input.charAt(pos[0]) == '(') {
            SgfNode child = parseTree(input, pos);
            root.addChild(child);
        }

        // Skip whitespace
        while (pos[0] < input.length() && Character.isWhitespace(input.charAt(pos[0]))) {
            pos[0]++;
        }

        if (pos[0] >= input.length() || input.charAt(pos[0]) != ')') {
            throw new SgfParsingException("expected ')'");
        }

        pos[0]++; // Skip ')'

        return root;
    }

    private void parseNode(String input, SgfNode node, int[] pos) throws SgfParsingException {
        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);

            if (c == ';') {
                // Start of next node
                return;
            }

            if (c == ')') {
                // End of tree
                return;
            }

            if (c == '(') {
                // Start of child tree
                return;
            }

            if (!Character.isUpperCase(c)) {
                throw new SgfParsingException("invalid property key");
            }

            // Parse property key
            StringBuilder key = new StringBuilder();
            pos[0]++;
            while (pos[0] < input.length() && Character.isUpperCase(input.charAt(pos[0]))) {
                key.append(input.charAt(pos[0]));
                pos[0]++;
            }

            if (key.length() == 0) {
                throw new SgfParsingException("invalid property key");
            }

            // Skip whitespace
            while (pos[0] < input.length() && Character.isWhitespace(input.charAt(pos[0]))) {
                throw new SgfParsingException("invalid property");
            }

            // Parse value
            if (pos[0] >= input.length() || input.charAt(pos[0]) != '[') {
                throw new SgfParsingException("expected '['");
            }

            String value = parseValue(input, pos);
            node.addProperty(key.toString(), value);
        }
    }

    private String parseValue(String input, int[] pos) throws SgfParsingException {
        // Skip '['
        pos[0]++;

        StringBuilder value = new StringBuilder();

        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);

            if (c == ']') {
                pos[0]++; // Skip ']'
                break;
            }

            if (c == '\\') {
                pos[0]++; // Skip escape character
                if (pos[0] >= input.length()) {
                    throw new SgfParsingException("invalid escape sequence");
                }
                char escaped = input.charAt(pos[0]);
                if (Character.isWhitespace(escaped)) {
                    value.append(escaped);
                } else {
                    value.append(escaped);
                }
                pos[0]++;
            } else if (c == '\n') {
                value.append(c);
                pos[0]++;
            } else {
                value.append(c);
                pos[0]++;
            }
        }

        return value.toString();
    }
}
