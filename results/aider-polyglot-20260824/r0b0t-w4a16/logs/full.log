two-bucket.js
```javascript
//
// This is only a SKELETON file for the 'Two Bucket' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
  }

  solve() {
    const { bucketOne, bucketTwo, goal, startBucket } = this;

    // Validate that the goal is achievable
    if (goal > Math.max(bucketOne, bucketTwo)) {
      throw new Error('Goal cannot be reached');
    }

    // Determine the forbidden state (start empty, other full)
    let forbidden;
    if (startBucket === 'one') {
      forbidden = { a: 0, b: bucketTwo };
    } else {
      forbidden = { a: bucketOne, b: 0 };
    }

    // BFS
    // Each state: [a, b] where a = bucket one level, b = bucket two level
    const visited = new Set();
    const startState = [0, 0];
    const queue = [{ state: startState, moves: 0 }];
    visited.add('0,0');

    while (queue.length > 0) {
      const { state, moves } = queue.shift();
      let [a, b] = state;

      // Check if goal reached
      if (a === goal) {
        return {
          moves: moves + 1,
          goalBucket: 'one',
          otherBucket: b,
        };
      }
      if (b === goal) {
        return {
          moves: moves + 1,
          goalBucket: 'two',
          otherBucket: a,
        };
      }

      // Generate all possible next states
      const nextStates = [];

      // Action 1: Fill bucket one
      if (a < bucketOne) {
        nextStates.push([bucketOne, b]);
      }
      // Action 2: Fill bucket two
      if (b < bucketTwo) {
        nextStates.push([a, bucketTwo]);
      }
      // Action 3: Empty bucket one
      if (a > 0) {
        nextStates.push([0, b]);
      }
      // Action 4: Empty bucket two
      if (b > 0) {
        nextStates.push([a, 0]);
      }
      // Action 5: Pour bucket one into bucket two
      if (a > 0 && b < bucketTwo) {
        const pourAmount = Math.min(a, bucketTwo - b);
        nextStates.push([a - pourAmount, b + pourAmount]);
      }
      // Action 6: Pour bucket two into bucket one
      if (b > 0 && a < bucketOne) {
        const pourAmount = Math.min(b, bucketOne - a);
        nextStates.push([a + pourAmount, b - pourAmount]);
      }

      for (const nextState of nextStates) {
        // Skip forbidden state
        if (
          nextState[0] === forbidden.a &&
          nextState[1] === forbidden.b
        ) {
          continue;
        }

        const key = `${nextState[0]},${nextState[1]}`;
        if (!visited.has(key)) {
          visited.add(key);
          queue.push({ state: nextState, moves: moves + 1 });
        }
      }
    }

    throw new Error('Goal cannot be reached');
  }
}
```
