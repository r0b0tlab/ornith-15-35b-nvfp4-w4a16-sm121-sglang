def encode(numbers):

    result = []

    for number in numbers:

        if number < 0:

            raise ValueError("numbers must be non-negative")

        if number > 0xFFFFFFFF:

            raise ValueError("numbers must fit in 32 bits")

        

        # Extract 7-bit groups, most significant first

        groups = []

        while number > 0:

            groups.append(number & 0x7F)

            number >>= 7

        

        if not groups:

            groups = [0]

        

        # Reverse to get most significant group first

        groups.reverse()

        

        # Set bit 7 on all but the last group

        for i in range(len(groups) - 1):

            groups[i] |= 0x80

        

        result.extend(groups)

    

    return result





def decode(bytes_):

    result = []

    current = 0

    have_current = False

    

    for byte in bytes_:

        have_current = True

        current = (current << 7) | (byte & 0x7F)

        

        if (byte & 0x80) == 0:

            # This is the last byte of a quantity

            result.append(current)

            current = 0

            have_current = False

    

    if have_current:

        # Sequence is incomplete - last quantity was not terminated

        raise ValueError("incomplete sequence")

    

    return result

```

