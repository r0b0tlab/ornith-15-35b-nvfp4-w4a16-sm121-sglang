// The code below is a stub. Just enough to satisfy the compiler.
// In order to pass the tests you can add-to or change any of this code.

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidRowCount(usize),
    InvalidColumnCount(usize),
}

pub fn convert(input: &str) -> Result<String, Error> {
    let rows: Vec<&str> = input.lines().collect();

    if rows.is_empty() {
        return Ok(String::new());
    }

    if rows.len() % 4 != 0 {
        return Err(Error::InvalidRowCount(rows.len()));
    }

    // All rows must have the same length, and that length must be a multiple of 3
    let row_len = rows[0].len();
    if row_len % 3 != 0 {
        return Err(Error::InvalidColumnCount(row_len));
    }
    for row in &rows {
        if row.len() != row_len {
            return Err(Error::InvalidColumnCount(row.len()));
        }
    }

    let row_groups = rows.len() / 4;
    let digits_per_row = row_len / 3;

    let mut output_lines: Vec<String> = Vec::new();

    for group in 0..row_groups {
        let start_row = group * 4;
        let mut line = String::new();

        for digit in 0..digits_per_row {
            let start_col = digit * 3;

            // Build the 12-char pattern for this digit (3x4 grid flattened)
            let mut pattern = String::new();
            for r in 0..4 {
                let row_chars: Vec<char> = rows[start_row + r].chars().collect();
                for c in 0..3 {
                    let col = start_col + c;
                    if col < row_chars.len() {
                        pattern.push(row_chars[col]);
                    }
                }
            }

            let digit_char = match pattern.as_str() {
                " _ | ||_|   " => '0',
                "     |  |   " => '1',
                " _  _||_ |   " => '2',
                " _||_||_ |   " => '3',
                "   |_|     " => '4',
                " _ |_  _|   " => '5',
                " _ |_ |_|   " => '6',
                " _   |  |   " => '7',
                " _||_|_|    " => '8',
                " _||_|  _|   " => '9',
                _ => '?',
            };

            line.push(digit_char);
        }

        output_lines.push(line);
    }

    Ok(output_lines.join(","))
}
