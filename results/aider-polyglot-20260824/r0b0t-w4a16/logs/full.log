transpose.spec.js
```javascript
import { transpose } from './transpose.js';

describe('Transpose', () => {
    test('empty string', () => {
        const input = '';
        const expected = [];
        expect(transpose(input)).toEqual(expected);
    });

    test('two characters in a row', () => {
        const input = 'A1';
        const expected = ['A', '1'];
        expect(transpose(input)).toEqual(expected);
    });

    test('two characters in a column', () => {
        const input = 'A\n1';
        const expected = ['A1'];
        expect(transpose(input)).toEqual(expected);
    });

    test('simple', () => {
        const input = 'AB\nDEF';
        const expected = ['AD', 'BE', 'F'];
        expect(transpose(input)).toEqual(expected);
    });

    test('single line', () => {
        const input = 'single';
        const expected = ['s', 'i', 'n', 'g', 'l', 'e'];
        expect(transpose(input)).toEqual(expected);
    });

    test('first line longer than second line', () => {
        const input = 'ABC\nDE';
        const expected = ['AD', 'BE', 'C'];
        expect(transpose(input)).toEqual(expected);
    });

    test('second line longer than first line', () => {
        const input = 'AB\nDEF';
        const expected = ['AD', 'BE', ' F'];
        expect(transpose(input)).toEqual(expected);
    });

    test('mixed line length', () => {
        const input = 'LNS\nFHE\nOIE\nRCM\nGTD\nALU';
        const expected = ['LFRG', 'HEAI', 'SNOE', 'CMU', 'DE'];
        expect(transpose(input)).toEqual(expected);
    });

    test('square', () => {
        const input = 'ABC\nBCA\nCAB';
        const expected = ['ABC', 'BCA', 'CAB'];
        expect(transpose(input)).toEqual(expected);
    });

    test('rectangle', () => {
        const input = 'ABC\nDEF';
        const expected = ['AD', 'BE', 'CF'];
        expect(transpose(input)).toEqual(expected);
    });

    test('triangle', () => {
        const input = 'TIE\nED\nN';
        const expected = ['TEN', 'IED', 'E'];
        expect(transpose(input)).toEqual(expected);
    });

    test('jagged triangle', () => {
        const input = '11111111111\n1111111111\n111111111\n11111111\n1111111\n111111\n11111\n1111\n111\n11\n1';
        const expected = ['11111111111'];
        expect(transpose(input)).toEqual(expected);
    });

    test('many lines', () => {
        const input = 'LNSF\nFHEO\nCIEGU\nALU\nTIE\nED\nN';
        const expected = ['LFCTEA', 'HEIA', 'SNO', 'IGU', 'E', 'U'];
        expect(transpose(input)).toEqual(expected);
    });
});
```
