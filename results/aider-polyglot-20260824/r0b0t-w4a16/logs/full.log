// The code below is a stub. Just enough to satisfy the compiler.
// In order to pass the tests you can add-to or change any of this code.

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidRowCount(usize),
    InvalidColumnCount(usize),
}

const DIGITS: [&str; 10] = [
    " _ | ||_|   ",
    "     |  |   ",
    " _ _||_ |   ",
    " _  _ ||_ |   ",
    " _||_||_ |   ",
    " _| _||_ |   ",
    " _||_ ||_ |   ",
    " _   |  |   ",
    " _||_||_ |   ",
    " _| _||_ |   ",
];

pub fn convert(input: &str) -> Result<String, Error> {
    let rows: Vec<&str> = input.lines().collect();
    
    if rows.len() % 4 != 0 {
        return Err(Error::InvalidRowCount(rows.len()));
    }
    
    if rows.is_empty() {
        return Ok(String::new());
    }
    
    let row_count = rows.len() / 4;
    
    // Check all rows have the same length and it's a multiple of 3
    let col_count = rows[0].len();
    if col_count % 3 != 0 {
        return Err(Error::InvalidColumnCount(col_count));
    }
    
    for row in &rows {
        if row.len() != col_count {
            return Err(Error::InvalidColumnCount(row.len()));
        }
    }
    
    let mut result = Vec::new();
    
    for row_offset in 0..row_count {
        let start = row_offset * 4;
        let end = start + 4;
        let block = &rows[start..end];
        
        // Each digit is 3 columns wide
        let digits_per_row = col_count / 3;
        let mut line_result = String::new();
        
        for digit_index in 0..digits_per_row {
            let start_col = digit_index * 3;
            let end_col = start_col + 3;
            
            let mut pattern = String::new();
            for row in &block[0..4] {
                let cols: Vec<char> = row.chars().collect();
                for c in start_col..end_col {
                    if c < cols.len() {
                        pattern.push(cols[c]);
                    }
                }
            }
            
            match pattern.as_str() {
                " _ | ||_|   " => line_result.push('0'),
                "     |  |   " => line_result.push('1'),
                " _ _||_ |   " => line_result.push('2'),
                " _||_||_ |   " => line_result.push('3'),
                " _||_||_ |   " => line_result.push('4'),
                " _| _||_ |   " => line_result.push('5'),
                " _||_ ||_ |   " => line_result.push('6'),
                " _   |  |   " => line_result.push('7'),
                " _||_||_ |   " => line_result.push('8'),
                " _| _||_ |   " => line_result.push('9'),
                _ => line_result.push('?'),
            }
        }
        
        result.push(line_result);
    }
    
    Ok(result.join(","))
}
```

