+// permutations returns all permutations of the given slice.
+func permutations(input []string) [][]string {
+       if len(input) <= 1 {
+               return [][]string{input}
+       }
+
+       var result [][]string
+       for i := 0; i < len(input); i++ {
+               rest := make([]string, 0)
+               rest = append(rest, input[:i]...)
+               rest = append(rest, input[i+1:]...)
+
+               further := permutations(rest)
+               for _, perm := range further {
+                       result = append(result, append([]string{input[i]}, 
perm...))
+               }
+       }
+
+       return result
+}
+
+// abs returns the absolute value of an int.
+func abs(x int) int {
+       if x < 0 {
+               return -x
+       }
+       return x
+}
