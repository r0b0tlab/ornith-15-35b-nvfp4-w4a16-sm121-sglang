1. **Encode** should lowercase everything and only work with lowercase letters
2. **Decode** should strip the grouping spaces from the cipher text

Let me fix these issues:

affine_cipher.py
```python
import math

def encode(plain_text, a, b):
    if math.gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    m = 26
    result = ""
    for char in plain_text:
        if char.isalpha():
            i = ord(char.lower()) - ord('a')
            encrypted = (a * i + b) % m
            result += chr(encrypted + ord('a'))
        else:
            result += char
    
    # Group into chunks of 5 characters
    grouped = ''.join(c for c in result if c.isalpha() or c.isdigit())
    chunks = [grouped[i:i+5] for i in range(0, len(grouped), 5)]
    return ' '.join(chunks)


def decode(ciphered_text, a, b):
    if math.gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    m = 26
    # Find the modular multiplicative inverse of a
    a_inv = pow(a, -1, m)
    
    result = ""
    for char in ciphered_text:
        if char.isalpha():
            i = ord(char.lower()) - ord('a')
            decrypted = (a_inv * (i - b)) % m
            result += chr(decrypted + ord('a'))
        else:
            result += char
    
    return result
```
