```java
import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;
import java.util.function.Consumer;
import java.util.function.Function;

public class React {

    public static class Cell<T> {
        public T getValue() {
            throw new UnsupportedOperationException("Please implement the Cell.getValue() method");
        }
    }

    public static class InputCell<T> extends Cell<T> {
        private T value;
        Set<ComputeCell<T>> dependents;

        public InputCell(T initialValue) {
            this.value = initialValue;
            this.dependents = new HashSet<>();
        }

        @Override
        public T getValue() {
            return value;
        }

        public void setValue(T newValue) {
            this.value = newValue;
            propagate();
        }

        private void propagate() {
            Set<ComputeCell<T>> affected = new HashSet<>();
            for (ComputeCell<T> dependent : dependents) {
                collectDependencies(dependent, affected);
            }

            Map<ComputeCell<T>, T> oldValues = new HashMap<>();
            for (ComputeCell<T> cell : affected) {
                oldValues.put(cell, cell.getValue());
            }

            List<ComputeCell<T>> ordered = topologicalOrder(affected);
            for (ComputeCell<T> cell : ordered) {
                cell.recompute();
            }

            for (ComputeCell<T> cell : ordered) {
                if (!safeEquals(oldValues.get(cell), cell.getValue())) {
                    cell.fireCallbacks();
                }
            }
        }

        private void collectDependencies(ComputeCell<T> cell, Set<ComputeCell<T>> affected) {
            if (!affected.contains(cell)) {
                affected.add(cell);
                for (ComputeCell<T> dependent : cell.dependents) {
                    collectDependencies(dependent, affected);
                }
            }
        }

        private List<ComputeCell<T>> topologicalOrder(Set<ComputeCell<T>> affected) {
            List<ComputeCell<T>> result = new ArrayList<>();
            Set<ComputeCell<T>> visited = new HashSet<>();
            for (ComputeCell<T> cell : affected) {
                topoSort(cell, affected, visited, result);
            }
            return result;
        }

        private void topoSort(ComputeCell<T> cell, Set<ComputeCell<T>> affected, Set<ComputeCell<T>> visited, List<ComputeCell<T>> result) {
            if (visited.contains(cell)) return;
            visited.add(cell);
            for (Cell<T> dep : cell.inputs) {
                if (dep instanceof ComputeCell && affected.contains((ComputeCell<T>) dep)) {
                    topoSort((ComputeCell<T>) dep, affected, visited, result);
                }
            }
            result.add(cell);
        }

        private boolean safeEquals(T a, T b) {
            return a == null ? b == null : a.equals(b);
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private final Function<List<T>, T> function;
        List<Cell<T>> inputs;
        Set<ComputeCell<T>> dependents;
        private T value;
        private final List<Consumer<T>> callbacks;

        public ComputeCell(Function<List<T>, T> function, List<Cell<T>> inputs) {
            this.function = function;
            this.inputs = new ArrayList<>(inputs);
            this.dependents = new HashSet<>();
            this.callbacks = new ArrayList<>();
            this.value = compute();

            for (Cell<T> input : inputs) {
                if (input instanceof InputCell) {
                    ((InputCell<T>) input).dependents.add(this);
                } else if (input instanceof ComputeCell) {
                    ((ComputeCell<T>) input).dependents.add(this);
                }
            }
        }

        private T compute() {
            List<T> values = new ArrayList<>();
            for (Cell<T> input : inputs) {
                values.add(input.getValue());
            }
            return function.apply(values);
        }

        void recompute() {
            this.value = compute();
        }

        void fireCallbacks() {
            for (Consumer<T> callback : callbacks) {
                callback.accept(value);
            }
        }

        @Override
        public T getValue() {
            return value;
        }

        public void addCallback(Consumer<T> callback) {
            callbacks.add(callback);
        }

        public void removeCallback(Consumer<T> callback) {
            callbacks.remove(callback);
        }
    }

    public static <T> InputCell<T> inputCell(T initialValue) {
        return new InputCell<>(initialValue);
    }

    public static <T> ComputeCell<T> computeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
        return new ComputeCell<>(function, cells);
    }
}
```

