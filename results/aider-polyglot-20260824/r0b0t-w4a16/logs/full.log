class BowlingGame {
    private int[] rolls = new int[20];
    private int rollIndex = 0;

    void roll(int pins) {
        if (pins < 0 || pins > 10) {
            throw new IllegalStateException("Cannot roll more than 10 points");
        }
        if (rollIndex >= rolls.length) {
            throw new IllegalStateException("Cannot roll after game is over");
        }
        // Check if this is the second roll of a frame and the total exceeds 10
        if (rollIndex % 2 == 1 && rolls[rollIndex - 1] + pins > 10) {
            throw new IllegalStateException("Total pins in a frame cannot exceed 10");
        }
        rolls[rollIndex++] = pins;
    }

    int score() {
        if (rollIndex < 20) {
            throw new IllegalStateException("Game is not complete");
        }
        int score = 0;
        int index = 0;

        for (int frame = 0; frame < 10; frame++) {
            if (rolls[index] == 10) {
                // Strike
                score += 10 + rolls[index + 1] + rolls[index + 2];
                index++;
            } else if (rolls[index] + rolls[index + 1] == 10) {
                // Spare
                score += 10 + rolls[index + 2];
                index += 2;
            } else {
                // Open frame
                score += rolls[index] + rolls[index + 1];
                index += 2;
            }
        }

        return score;
    }
}
