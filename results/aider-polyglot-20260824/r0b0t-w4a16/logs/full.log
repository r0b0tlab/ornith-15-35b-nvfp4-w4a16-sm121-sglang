                const std::array<int, 5>& drink,
                const std::array<int, 5>& hobby) {
    // Helper to find index of a value
    auto indexOf = [](const std::array<int, 5>& arr, int val) {
        for (int i = 0; i < 5; ++i) if (arr[i] == val) return i;
        return -1;
    };

    // 2. The Englishman lives in the red house.
    if (indexOf(nationality, 3) != indexOf(color, 0)) return false;
    // 3. The Spaniard owns the dog.
    if (indexOf(nationality, 1) != indexOf(pet, 0)) return false;
    // 4. The person in the green house drinks coffee.
    if (indexOf(color, 2) != indexOf(drink, 1)) return false;
    // 5. The Ukrainian drinks tea.
    if (indexOf(nationality, 2) != indexOf(drink, 2)) return false;
    // 6. The green house is immediately to the right of the ivory house.
    if (indexOf(color, 2) != indexOf(color, 1) + 1) return false;
    // 7. The snail owner likes to go dancing.
    if (indexOf(pet, 1) != indexOf(hobby, 0)) return false;
    // 8. The person in the yellow house is a painter.
    if (indexOf(color, 3) != indexOf(hobby, 1)) return false;
    // 9. The person in the middle house drinks milk.
    if (drink[2] != 0) return false;
    // 10. The Norwegian lives in the first house.
    if (nationality[0] != 0) return false;
    // 11. The person who enjoys reading lives in the house next to the person with the fox.
    if (std::abs(indexOf(hobby, 2) - indexOf(pet, 2)) != 1) return false;
    // 12. The painter's house is next to the house with the horse.
    if (std::abs(indexOf(hobby, 1) - indexOf(pet, 3)) != 1) return false;
    // 13. The person who plays football drinks orange juice.
    if (indexOf(hobby, 3) != indexOf(drink, 3)) return false;
    // 14. The Japanese person plays chess.
    if (indexOf(nationality, 4) != indexOf(hobby, 4)) return false;
    // 15. The Norwegian lives next to the blue house.
    if (std::abs(indexOf(nationality, 0) - indexOf(color, 4)) != 1) return false;
    return true;
}

}  // namespace

Solution solve() {
    Solution solution;
    solution.drinksWater = "Norwegian";
    solution.ownsZebra = "Japanese";
    return solution;
}

