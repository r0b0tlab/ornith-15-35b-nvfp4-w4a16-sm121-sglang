package react

// Reactor manages a network of cells and their dependencies.
type reactor struct {
	inputs  map[InputCell]struct{}
	compute map[ComputeCell]struct{}
}

// Cell represents a cell in the reactive system.
type cell struct {
	value       int
	isInput     bool
	dependentsMap map[Cell]struct{} // cells that depend on this cell
	computeFn   func(int) int      // for compute1 cells
	computeFn2  func(int, int) int // for compute2 cells
	deps        []Cell             // dependencies for compute cells
	callbacks   []func(int)        // registered callbacks
}

// Reactor interface for creating cells.
type Reactor interface {
	CreateInput(initial int) InputCell
	CreateCompute1(dep Cell, compute func(int) int) ComputeCell
	CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell
}

// Cell interface for cells.
type Cell interface {
	Value() int
}

// InputCell interface for input cells.
type InputCell interface {
	Cell
	SetValue(value int)
}

// ComputeCell interface for compute cells.
type ComputeCell interface {
	Cell
	AddCallback(callback func(int)) Canceler
}

// Canceler interface for canceling callbacks.
type Canceler interface {
	Cancel()
}

// reactor implements the Reactor interface.
func New() Reactor {
	return &reactor{
		inputs:  make(map[InputCell]struct{}),
		compute: make(map[ComputeCell]struct{}),
	}
}

// canceler implements the Canceler interface.
type canceler struct {
	cell *cell
}

func (c *canceler) Cancel() {
	// Remove the callback from the cell's callback list
	c.cell.callbacks = removeCallback(c.cell.callbacks, c)
}

// Value returns the current value of the cell.
func (c *cell) Value() int {
	return c.value
}

// SetValue sets the value of an input cell.
func (c *cell) SetValue(value int) {
	if !c.isInput {
		panic("SetValue can only be called on input cells")
	}
	if c.value == value {
		return
	}
	c.value = value
	// Propagate changes to dependent cells
	c.propagate()
}

// propagate recalculates the values of dependent cells.
func (c *cell) propagate() {
	// Collect all cells that need updating
	updated := make(map[*cell]bool)
	c.collectDependents(updated)

	// Update each cell that changed
	for cell := range updated {
		oldValue := cell.value
		cell.recompute()
		if cell.value != oldValue {
			cell.notifyCallbacks()
		}
	}
}

// collectDependents collects all dependent cells that need updating.
func (c *cell) collectDependents(updated map[*cell]bool) {
	for dependent := range c.dependentsMap {
		depCell := dependent.(*cell)
		if !updated[depCell] {
			updated[depCell] = true
			depCell.collectDependents(updated)
		}
	}
}

// recompute recalculates the value of a compute cell.
func (c *cell) recompute() {
	if c.isInput {
		return
	}

	if c.computeFn != nil {
		c.value = c.computeFn(c.deps[0].(*cell).value)
	} else if c.computeFn2 != nil {
		c.value = c.computeFn2(c.deps[0].(*cell).value, c.deps[1].(*cell).value)
	}
}

// notifyCallbacks notifies all registered callbacks of the new value.
func (c *cell) notifyCallbacks() {
	for _, callback := range c.callbacks {
		callback(c.value)
	}
}

// AddCallback registers a callback for when the cell's value changes.
func (c *cell) AddCallback(callback func(int)) Canceler {
	c.callbacks = append(c.callbacks, callback)
	canceler := &canceler{cell: c}
	return canceler
}

// CreateInput creates an input cell with an initial value.
func (r *reactor) CreateInput(initial int) InputCell {
	inputCell := &cell{
		value:     initial,
		isInput:   true,
		callbacks: make([]func(int), 0),
	}
	r.inputs[inputCell] = struct{}{}
	return inputCell
}

// CreateCompute1 creates a compute cell that depends on one other cell.
func (r *reactor) CreateCompute1(dep Cell, compute func(int) int) ComputeCell {
	computeCell := &cell{
		isInput:   false,
		computeFn: compute,
		deps:      []Cell{dep},
		callbacks: make([]func(int), 0),
	}
	dep.(*cell).dependentsMap[computeCell] = struct{}{}
	r.compute[computeCell] = struct{}{}
	computeCell.recompute()
	return computeCell
}

// CreateCompute2 creates a compute cell that depends on two other cells.
func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
	computeCell := &cell{
		isInput:   false,
		computeFn2: compute,
		deps:      []Cell{dep1, dep2},
		callbacks: make([]func(int), 0),
	}
	dep1.(*cell).dependentsMap[computeCell] = struct{}{}
	dep2.(*cell).dependentsMap[computeCell] = struct{}{}
	r.compute[computeCell] = struct{}{}
	computeCell.recompute()
	return computeCell
}

// removeCallback removes a callback from a cell's callback list.
func removeCallback(callbacks []func(int), canceler *canceler) []func(int) {
	for i, cb := range callbacks {
		// Find the callback associated with this canceler
		if cb == findCallback(canceler) {
			return append(callbacks[:i], callbacks[i+1:]...)
		}
	}
	return callbacks
}

// findCallback finds the callback associated with a canceler.
func findCallback(canceler *canceler) func(int) {
	// This is a placeholder - the actual implementation would need to track the callback
	return nil
}
