```cpp
#include <vector>
#include <stdexcept>
#include <cstddef>

namespace circular_buffer {

class circular_buffer {
public:
    explicit circular_buffer(size_t size);
    
    void write(int value);
    int read();
    void overwrite(int value);
    void clear();
    
private:
    std::vector<int> buffer_;
    size_t capacity_;
    size_t head_;  // index of oldest element
    size_t count_;  // number of elements in buffer
    
    bool is_full() const;
    bool is_empty() const;
};

circular_buffer::circular_buffer(size_t size) 
    : buffer_(size), capacity_(size), head_(0), count_(0) {}

void circular_buffer::write(int value) {
    if (is_full()) {
        throw std::domain_error("Buffer is full");
    }
    size_t tail = (head_ + count_) % capacity_;
    buffer_[tail] = value;
    count_++;
}

int circular_buffer::read() {
    if (is_empty()) {
        throw std::domain_error("Buffer is empty");
    }
    int value = buffer_[head_];
    head_ = (head_ + 1) % capacity_;
    count_--;
    return value;
}

void circular_buffer::overwrite(int value) {
    if (is_empty()) {
        write(value);
        return;
    }
    if (is_full()) {
        buffer_[head_] = value;
        head_ = (head_ + 1) % capacity_;
    } else {
        write(value);
    }
}

void circular_buffer::clear() {
    head_ = 0;
    count_ = 0;
}

bool circular_buffer::is_full() const {
    return count_ == capacity_;
}

bool circular_buffer::is_empty() const {
    return count_ == 0;
}

}  // namespace circular_buffer

#endif // CIRCULAR_BUFFER_H
```

