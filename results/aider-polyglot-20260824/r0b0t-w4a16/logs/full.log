```go
package say

import (
	"strings"
)

var ones = []string{
	"zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
	"ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
	"seventeen", "eighteen", "nineteen",
}

var tens = []string{
	"", "ten", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety",
}

func Say(n int64) (string, bool) {
	if n < 0 || n > 999999999999 {
		return "", false
	}

	if n == 0 {
		return "zero", true
	}

	var parts []string

	// Handle billions
	if n >= 1000000000 {
		billions := n / 1000000000
		parts = append(parts, sayUnderMillion(int64(billions))+" billion")
		n %= 1000000000
	}

	// Handle millions
	if n >= 1000000 {
		millions := n / 1000000
		parts = append(parts, sayUnderMillion(int64(millions))+" million")
		n %= 1000000
	}

	// Handle thousands
	if n >= 1000 {
		thousands := n / 1000
		parts = append(parts, sayUnderMillion(int64(thousands))+" thousand")
		n %= 1000
	}

	// Handle remainder
	if n > 0 {
		parts = append(parts, sayUnderMillion(n))
	}

	return strings.Join(parts, " "), true
}

// sayUnderMillion converts a number from 0 to 999,999,999 to words
func sayUnderMillion(n int64) string {
	var parts []string

	// Handle hundreds
	if n >= 100 {
		hundreds := n / 100
		parts = append(parts, ones[int64(hundreds)]+" hundred")
		n %= 100
	}

	// Handle tens and ones
	if n >= 20 {
		tensDigit := n / 10
		onesDigit := n % 10
		if onesDigit == 0 {
			parts = append(parts, tens[int64(tensDigit)])
		} else {
			parts = append(parts, tens[int64(tensDigit)]+"-"+ones[onesDigit])
		}
	} else if n >= 1 {
		parts = append(parts, ones[n])
	}

	return strings.Join(parts, " ")
}
