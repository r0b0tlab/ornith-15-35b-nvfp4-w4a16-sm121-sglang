@@ -1,5 +1,55 @@
 #include "kindergarten_garden.h"
+#include <algorithm>
 
 namespace kindergarten_garden {
 
+static const std::map<std::string, Plant> plant_codes = {
+    {'G', Plant::Grass},
+    {'C', Plant::Clover},
+    {'R', Plant::Radish},
+    {'V', Plant::Violet}
+};
+
+std::vector<Plant> Garden::plants(std::string student) {
+    // Split the diagram into two rows
+    std::string row1 = garden.substr(0, garden.find('\n'));
+    std::string row2 = garden.substr(garden.find('\n') + 1);
+    
+    // Find the student's position in the alphabetical list
+    std::vector<std::string> students = {
+        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
+        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
+    };
+    
+    auto it = std::find(students.begin(), students.end(), student);
+    if (it == students.end()) {
+        return {};  // Student not found
+    }
+    
+    int index = std::distance(students.begin(), it);
+    
+    // Each student gets 2 cups per row
+    int start_col = index * 2;
+    
+    std::vector<Plant> result;
+    
+    // First row plants
+    if (start_col < row1.length()) {
+        result.push_back(plant_codes.at(row1[start_col]));
+    }
+    if (start_col + 1 < row1.length()) {
+        result.push_back(plant_codes.at(row1[start_col + 1]));
+    }
+    
+    // Second row plants
+    if (start_col < row2.length()) {
+        result.push_back(plant_codes.at(row2[start_col]));
+    }
+    if (start_col + 1 < row2.length()) {
+        result.push_back(plant_codes.at(row2[start_col + 1]));
+    }
+    
+    return result;
+}
+
 }  // namespace kindergarten_garden
