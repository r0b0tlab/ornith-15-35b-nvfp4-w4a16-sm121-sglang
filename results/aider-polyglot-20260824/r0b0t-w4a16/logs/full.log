Ok, I see the issue. The points column isn't being formatted correctly. Looking at the expected output, the points should be right-aligned within a 2-character width (e.g., ` 12` not `12`), and the header shows the `P` column is 2 characters wide.

The issue is that the points value needs to be padded to 2 characters with leading spaces, not just inserted directly.

Let me fix the formatting.

tournament.js
```javascript
//
// This is only a SKELETON file for the 'Tournament' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const tournamentTally = (input) => {
  if (input === null || input === undefined) {
    return '';
  }

  const lines = input.split('\n');
  const teams = {};

  const addTeam = (name) => {
    if (!teams[name]) {
      teams[name] = { name, mp: 0, w: 0, d: 0, l: 0, p: 0 };
    }
  };

  for (const line of lines) {
    if (line.trim() === '') continue;
    const [home, away, result] = line.split(';');
    if (!home || !away || !result) continue;

    if (!teams[home]) addTeam(home);
    if (!teams[away]) addTeam(away);

    teams[home].mp++;
    teams[away].mp++;

    if (result === 'win') {
      teams[home].w++;
      teams[home].p += 3;
      teams[away].l++;
    } else if (result === 'loss') {
      teams[away].w++;
      teams[away].p += 3;
      teams[home].l++;
    } else if (result === 'draw') {
      teams[home].d++;
      teams[home].p += 1;
      teams[away].d++;
      teams[away].p += 1;
    }
  }

  const table = Object.values(teams);

  table.sort((a, b) => {
    if (b.p !== a.p) return b.p - a.p;
    return a.name.localeCompare(b.name);
  });

  let output = 'Team                           | MP |  W |  D |  L |  P\n';
  for (const team of table) {
    output += `${team.name.padEnd(30)} | ${String(team.mp).padStart(2)} | ${String(team.w).padStart(2)} | ${String(team.d).padStart(2)} | ${String(team.l).padStart(2)} | ${String(team.p).padStart(2)}\n`;
  }

  return output.trimEnd();
};
```
