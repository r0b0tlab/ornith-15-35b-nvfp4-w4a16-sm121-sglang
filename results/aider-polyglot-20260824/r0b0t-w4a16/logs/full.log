scale_generator.py
```
class Scale:
    def __init__(self, tonic):
        self.tonic = tonic

    def chromatic(self):
        # Determine if flats or sharps should be used
        sharp_scale = ['A', 'A♯', 'B', 'C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯']
        flat_scale = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭']
        
        # Determine which scale to use based on tonic
        flat_tonics = ['F', 'B♭', 'E♭', 'A♭', 'D♭', 'G♭']
        if self.tonic in flat_tonics:
            scale = flat_scale
        else:
            scale = sharp_scale
        
        # Shift the scale to start with the tonic
        tonic_index = scale.index(self.tonic)
        chromatic = scale[tonic_index:] + scale[:tonic_index]
        return chromatic

    def interval(self, intervals):
        # Determine if flats or sharps should be used
        flat_tonics = ['F', 'B♭', 'E♭', 'A♭', 'D♭', 'G♭']
        if self.tonic in flat_tonics:
            scale = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭']
        else:
            scale = ['A', 'A♯', 'B', 'C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯']
        
        # Build the scale using the intervals
        result = [self.tonic]
        current_index = scale.index(self.tonic)
        
        for interval in intervals:
            if interval == 'm':
                current_index += 1
            elif interval == 'M':
                current_index += 2
            elif interval == 'A':
                current_index += 3
            # Handle other intervals if needed
            
            result.append(scale[current_index % len(scale)])
        
        return result
```
