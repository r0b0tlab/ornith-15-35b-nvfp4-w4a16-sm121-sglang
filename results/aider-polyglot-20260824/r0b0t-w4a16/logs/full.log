```javascript
//
// This is only a SKELETON file for the 'Simple Linked List' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }

  get value() {
    return this._value;
  }

  get next() {
    return this._next;
  }
}

export class List {
  constructor(array = []) {
    this._head = null;
    this._length = 0;

    if (Array.isArray(array)) {
      for (const value of array) {
        this.add(value);
      }
    }
  }

  add(value) {
    const element = new Element(value, this._head);
    this._head = element;
    this._length++;
  }

  get length() {
    return this._length;
  }

  get head() {
    return this._head;
  }

  toArray() {
    const result = [];
    let current = this._head;

    while (current) {
      result.push(current.value);
      current = current.next;
    }

    return result;
  }

  reverse() {
    const reversedList = new List();
    let current = this._head;

    while (current) {
      reversedList.add(current.value);
      current = current.next;
    }

    return reversedList;
  }
}
```

The implementation includes:

- **Element class**: A node that stores a value and a pointer to the next node.
- **List class**: 
  - Constructor accepts an optional array to initialize the list.
  - `add()` inserts a new element at the head of the list.
  - `length` getter returns the number of elements.
  - `head` getter returns the first element.
  - `toArray()` converts the linked list to a JavaScript array in order.
  - `reverse()` returns a new reversed list.
