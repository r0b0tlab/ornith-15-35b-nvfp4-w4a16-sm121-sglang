response:
I need to fix two issues:

1. **`toTree()` bug**: When moving up, it rebuilds breadcrumbs incorrectly, causing stale references to the mutated tree.
2. **`should return same zipper from different paths`**: The `Zipper` instances created via different paths have different `Node` vs plain-object structures, so `toEqual` fails. I need to make the internal representation consistent—using plain objects with `value`/`left`/`right` for both the tree and the zipper's focus.

The fix: use plain objects internally. `fromTree` deep-copies the tree into plain objects. `up()` reconstructs parent objects consistently. `toTree()` then works uniformly.

zipper.js
```
//
// This is only a SKELETON file for the 'Zipper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

function copyNode(node) {
  if (node === null) {
    return null;
  }
  return {
    value: node.value,
    left: copyNode(node.left),
    right: copyNode(node.right),
  };
}

class Zipper {
  constructor(tree, breadcrumbs = []) {
    this.tree = tree;
    this.breadcrumbs = breadcrumbs;
  }

  static fromTree(tree) {
    const newTree = copyNode(tree);
    return new Zipper(newTree);
  }

  toTree() {
    let current = this.tree;
    for (let i = this.breadcrumbs.length - 1; i >= 0; i--) {
      const { side, parent, sibling } = this.breadcrumbs[i];
      current = side === 'left'
        ? { value: parent.value, left: current, right: sibling }
        : { value: parent.value, left: sibling, right: current };
    }
    return current;
  }

  value() {
    return this.tree.value;
  }

  left() {
    if (this.tree.left === null) {
      return null;
    }
    const breadcrumb = {
      side: 'left',
      parent: this.tree,
      sibling: this.tree.right,
    };
    return new Zipper(this.tree.left, [...this.breadcrumbs, breadcrumb]);
  }

  right() {
    if (this.tree.right === null) {
      return null;
    }
    const breadcrumb = {
      side: 'right',
      parent: this.tree,
      sibling: this.tree.left,
    };
    return new Zipper(this.tree.right, [...this.breadcrumbs, breadcrumb]);
  }

  up() {
    if (this.breadcrumbs.length === 0) {
      return null;
    }
    const last = this.breadcrumbs[this.breadcrumbs.length - 1];
    const side = last.side;
    const parent = last.parent;
    const sibling = last.sibling;
    const remaining = this.breadcrumbs.slice(0, -1);
    if (side === 'left') {
      return new Zipper(parent, [...remaining, { side: 'left', parent: parent.left, sibling: parent.right }]);
    }
    return new Zipper(parent, [...remaining, { side: 'right', parent: parent.right, sibling: parent.left }]);
  }

  setValue(value) {
    const newTree = { value, left: this.tree.left, right: this.tree.right };
    return new Zipper(newTree, this.breadcrumbs);
  }

  setLeft(left) {
    const newTree = { value: this.tree.value, left, right: this.tree.right };
    return new Zipper(newTree, this.breadcrumbs);
  }

  setRight(right) {
    const newTree = { value: this.tree.value, left: this.tree.left, right };
    return new Zipper(newTree, this.breadcrumbs);
  }
}

export { Zipper };

```
