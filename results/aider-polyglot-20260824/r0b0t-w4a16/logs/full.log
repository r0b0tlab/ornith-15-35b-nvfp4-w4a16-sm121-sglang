satellite/src/main/java/Satellite.java
```java
import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;

public class Satellite {
    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {
        // Validate input sizes
        if (preorderInput.size() != inorderInput.size()) {
            throw new IllegalArgumentException("traversals must have the same length");
        }
        
        // Check for duplicates in preorder
        if (preorderInput.size() != preorderInput.stream().distinct().count()) {
            throw new IllegalArgumentException("traversals must contain unique items");
        }
        
        // Check that both traversals contain exactly the same elements
        if (new ArrayList<Character>(inorderInput).equals(new ArrayList<Character>(preorderInput)) == false) {
            throw new IllegalArgumentException("traversals must contain the same items");
        }
        
        // Build the tree
        int[] preorderIndex = {0};
        Map<Character, Integer> inorderPositions = new HashMap<>();
        for (int i = 0; i < inorderInput.size(); i++) {
            inorderPositions.put(inorderInput.get(i), i);
        }
        
        Tree root = buildTree(preorderInput, inorderPositions, 0, inorderInput.size() - 1, preorderIndex);
        return root;
    }
    
    private Tree buildTree(List<Character> preorder, Map<Character, Integer> inorderPositions, 
                          int start, int end, int[] preorderIndex) {
        if (start > end) {
            return null;
        }
        
        Character rootValue = preorder.get(preorderIndex[0]);
        preorderIndex[0]++;
        
        Tree.Node left = buildTree(preorder, inorderPositions, start, inorderIndex - 1, preorderIndex);
        Tree.Node right = buildTree(preorder, inorderPositions, inorderIndex + 1, end, preorderIndex);
        
        return new Tree(new Tree.Node(rootValue, left, right));
    }
}
