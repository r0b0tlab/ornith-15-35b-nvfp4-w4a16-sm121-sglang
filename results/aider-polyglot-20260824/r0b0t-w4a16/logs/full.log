affine_cipher.py
```python
import math

def encode(plain_text, a, b):
    if math.gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    m = 26
    result = ""
    for char in plain_text:
        if char.isalpha():
            if char.isupper():
                base = ord('A')
            else:
                base = ord('a')
            i = ord(char.lower()) - base
            encrypted = (a * i + b) % m
            result += chr(encrypted + base)
        else:
            result += char
    
    # Group into chunks of 5 characters
    grouped = ''.join(result.split())  # Remove spaces
    grouped = ''.join(c for c in grouped if c.isalpha() or c.isdigit())
    chunks = [grouped[i:i+5] for i in range(0, len(grouped), 5)]
    return ' '.join(chunks)


def decode(ciphered_text, a, b):
    if math.gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    m = 26
    # Find the modular multiplicative inverse of a
    a_inv = pow(a, -1, m)
    
    result = ""
    for char in ciphered_text:
        if char.isalpha():
            if char.isupper():
                base = ord('A')
            else:
                base = ord('a')
            i = ord(char.lower()) - base
            decrypted = (a_inv * (i - b)) % m
            result += chr(decrypted + base)
        else:
            result += char
    
    return result
```
