```python
import itertools

def drinks_water():
    """Returns the nationality of the person who drinks water."""
    return _solve()[0]

def owns_zebra():
    """Returns the nationality of the person who owns the zebra."""
    return _solve()[1]

def _solve():
    # Define the sets of values
    color_values = ['red', 'ivory', 'green', 'yellow', 'blue']
    nat_values = ['English', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese']
    bev_values = ['coffee', 'tea', 'milk', 'orange_juice', 'water']
    hobby_values = ['dancing', 'painter', 'reading', 'football', 'chess']
    pet_values = ['dog', 'fox', 'snail', 'horse', 'zebra']
    
    # Iterate over colors
    for colors_perm in itertools.permutations(color_values):
        # Constraint 6: green house is immediately right of ivory house
        if colors_perm.index('green') != colors_perm.index('ivory') + 1:
            continue
        
        # Iterate over nationalities
        for nat_perm in itertools.permutations(nat_values):
            # Constraint 10: Norwegian in first house
            if nat_perm[0] != 'Norwegian':
                continue
            
            # Constraint 2: Englishman lives in red house
            english_index = nat_perm.index('English')
            if colors_perm[english_index] != 'red':
                continue
            
            # Constraint 15: Norwegian lives next to blue house
            if abs(nat_perm.index('Norwegian') - colors_perm.index('blue')) != 1:
                continue
            
            # Iterate over beverages
            for bev_perm in itertools.permutations(bev_values):
                # Constraint 9: middle house drinks milk
                if bev_perm[2] != 'milk':
                    continue
                
                # Constraint 4: green house drinks coffee
                green_index = colors_perm.index('green')
                if bev_perm[green_index] != 'coffee':
                    continue
                
                # Constraint 5: Ukrainian drinks tea
                ukrainian_index = nat_perm.index('Ukrainian')
                if bev_perm[ukrainian_index] != 'tea':
                    continue
                
                # Iterate over hobbies
                for hobby_perm in itertools.permutations(hobby_values):
                    # Constraint 8: yellow house is painter
                    yellow_index = colors_perm.index('yellow')
                    if hobby_perm[yellow_index] != 'painter':
                        continue
                    
                    # Constraint 13: football player drinks orange juice
                    football_index = hobby_perm.index('football')
                    if bev_perm[football_index] != 'orange_juice':
                        continue
                    
                    # Constraint 14: Japanese plays chess
                    japanese_index = nat_perm.index('Japanese')
                    if hobby_perm[japanese_index] != 'chess':
                        continue
                    
                    # Iterate over pets
                    for pet_perm in itertools.permutations(pet_values):
                        # Constraint 3: Spaniard owns dog
                        spaniard_index = nat_perm.index('Spaniard')
                        if pet_perm[spaniard_index] != 'dog':
                            continue
                        
                        # Constraint 7: snail owner likes dancing
                        snail_index = pet_perm.index('snail')
                        if hobby_perm[snail_index] != 'dancing':
                            continue
                        
                        # Constraint 12: painter's house next to horse
                        painter_index = hobby_perm.index('painter')
                        horse_index = pet_perm.index('horse')
                        if abs(painter_index - horse_index) != 1:
                            continue
                        
                        # Constraint 11: reading next to fox
                        reading_index = hobby_perm.index('reading')
                        fox_index = pet_perm.index('fox')
                        if abs(reading_index - fox_index) != 1:
                            continue
                        
                        # All constraints satisfied - build the solution
                        solution = []
                        for i in range(5):
                            solution.append({
                                'color': colors_perm[i],
                                'nationality': nat_perm[i],
                                'beverage': bev_perm[i],
                                'hobby': hobby_perm[i],
                                'pet': pet_perm[i]
                            })
                        
                        # Find who drinks water and owns zebra
                        water_drinker = None
                        zebra_owner = None
                        for house in solution:
                            if house['beverage'] == 'water':
                                water_drinker = house['nationality']
                            if house['pet'] == 'zebra':
                                zebra_owner = house['nationality']
                        
                        return water_drinker, zebra_owner
    
    return None, None
