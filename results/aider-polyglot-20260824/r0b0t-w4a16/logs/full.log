go-counting.js
```javascript
//
// This is only a SKELETON file for the 'Go Counting' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class GoCounting {
  constructor(board) {
    this.board = board || [];
    this.height = this.board.length;
    this.width = this.height > 0 ? this.board[0].length : 0;
  }

  getTerritory(x, y) {
    // Validate coordinates
    if (x < 0 || x >= this.width || y < 0 || y >= this.height) {
      return { error: 'invalid coordinate' };
    }

    const cell = this.board[y][x];
    if (cell === 'B' || cell === 'W') {
      return { error: 'not empty' };
    }

    // Flood fill to find the territory and its border stones
    const territory = new Set();
    const neighbors = new Set();
    const visited = new Set();
    const queue = [[x, y]];
    visited.add(`${x},${y}`);

    const directions = [[0, 1], [0, -1], [1, 0], [-1, 0]];

    while (queue.length > 0) {
      const [cx, cy] = queue.shift();
      territory.add(`${cx},${cy}`);

      for (const [dx, dy] of directions) {
        const nx = cx + dx;
        const ny = cy + dy;

        if (nx < 0 || nx >= this.width || ny < 0 || ny >= this.height) {
          continue;
        }

        const neighborCell = this.board[ny][nx];
        if (neighborCell === ' ') {
          const key = `${nx},${ny}`;
          if (!visited.has(key)) {
            visited.add(key);
            queue.push([nx, ny]);
            territory.add(key);
          }
        } else {
          neighbors.add(`${neighborCell}`);
        }
      }
    }

    // Determine the owner based on border stones
    const hasBlack = neighbors.has('B');
    const hasWhite = neighbors.has('W');

    let owner = 'NONE';
    if (hasBlack && !hasWhite) {
      owner = 'BLACK';
    } else if (hasWhite && !hasBlack) {
      owner = 'WHITE';
    }

    // Convert territory set to array of coordinates
    const territoryArray = [...territory]
      .map(point => point.split(',').map(Number))
      .sort((a, b) => a[1] - b[1] || a[0] - b[0]);

    return {
      owner,
      territory: territoryArray,
    };
  }

  getTerritories() {
    const territoryBlack = [];
    const territoryWhite = [];
    const territoryNone = [];

    // Collect all empty cells
    const emptyCells = [];
    for (let y = 0; y < this.height; y++) {
      for (let x = 0; x < this.width; x++) {
        if (this.board[y][x] === ' ') {
          emptyCells.push([x, y]);
        }
      }
    }

    // Get territory for each empty cell
    const territories = new Map();
    for (const [x, y] of emptyCells) {
      const result = this.getTerritory(x, y);
      if (result.error) {
        continue;
      }

      // Use the territory key (sorted coordinates) to group
      const key = result.territory.map(coord => coord.join(',')).join('|');
      territories.set(key, result);
    }

    // Distribute territories by owner
    for (const territory of territories.values()) {
      if (territory.owner === 'BLACK') {
        territoryBlack.push(...territory.territory);
      } else if (territory.owner === 'WHITE') {
        territoryWhite.push(...territory.territory);
      } else {
        territoryNone.push(...territory.territory);
      }
    }

    return {
      territoryBlack,
      territoryWhite,
      territoryNone,
    };
  }
}
