Tree.java
```java
import java.util.*;

class Tree {
    private final String label;
    private final List<Tree> children;

    public Tree(String label) {
        this(label, new ArrayList<>());
    }

    public Tree(String label, List<Tree> children) {
        this.label = label;
        this.children = children;
    }

    public static Tree of(String label) {
        return new Tree(label);
    }

    public static Tree of(String label, List<Tree> children) {
        return new Tree(label, children);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Tree tree = (Tree) o;
        return label.equals(tree.label)
                && children.size() == tree.children.size()
                && children.containsAll(tree.children)
                && tree.children.containsAll(children);
    }

    @Override
    public int hashCode() {
        return Objects.hash(label, children);
    }

    @Override
    public String toString() {
        return "Tree{" + label +
                ", " + children +
                "}";
    }

    public Tree fromPov(String fromNode) {
        // Find the path from root to the target node
        List<Tree> pathToNode = findPathToNode(this, fromNode);
        
        if (pathToNode == null) {
            throw new UnsupportedOperationException("Tree could not be reoriented");
        }
        
        // Build the new tree by re-orienting along the path
        Tree newRoot = buildReorientedTree(pathToNode);
        return newRoot;
    }

    private List<Tree> findPathToNode(Tree tree, String target) {
        if (tree.label.equals(target)) {
            return new ArrayList<>();
        }
        
        for (Tree child : tree.children) {
            List<Tree> childPath = findPathToNode(child, target);
            if (childPath != null) {
                List<Tree> fullPath = new ArrayList<>();
                fullPath.add(tree);
                fullPath.addAll(childPath);
                return fullPath;
            }
        }
        
        return null;
    }

    private Tree buildReorientedTree(List<Tree> pathToNode) {
        // pathToNode is ordered from root to target, with target at the end
        // We need to reverse it so we build from target upward
        List<Tree> reversedPath = new ArrayList<>(pathToNode);
        Collections.reverse(reversedPath);
        
        Tree current = reversedPath.get(0);
        
        for (int i = 1; i < reversedPath.size(); i++) {
            Tree parent = reversedPath.get(i);
            
            // Create a new node for parent with current as its child
            List<Tree> newChildren = new ArrayList<>();
            newChildren.add(current);
            
            // Add all other children of parent except the one leading to current
            for (Tree child : parent.children) {
                if (!child.equals(current)) {
                    newChildren.add(child);
                }
            }
            
            current = new Tree(parent.label, newChildren);
        }
        
        return current;
    }

    public List<String> pathTo(String fromNode, String toNode) {
        List<Tree> pathToNode = findPathToNode(this, fromNode);
        
        if (pathToNode == null) {
            throw new UnsupportedOperationException("No path found");
        }
        
        // Build the path from root to fromNode
        List<Tree> fullPath = new ArrayList<>();
        fullPath.addAll(pathToNode);
        fullPath.add(this); // Add the root
        
        // Find the path from fromNode to toNode
        List<String> result = findPathToNodeLabels(fullPath, toNode);
        
        if (result == null) {
            throw new UnsupportedOperationException("No path found");
        }
        
        return result;
    }

    private List<String> findPathToNodeLabels(List<Tree> path, String target) {
        // path is ordered from root to fromNode
        // Find target in the path and return labels from target to fromNode
        
        int targetIndex = -1;
        for (int i = 0; i < path.size(); i++) {
            if (path.get(i).label.equals(target)) {
                targetIndex = i;
                break;
            }
        }
        
        if (targetIndex == -1) {
            return null;
        }
        
        List<String> result = new ArrayList<>();
        for (int i = targetIndex; i < path.size(); i++) {
            result.add(path.get(i).label);
        }
        
        return result;
    }
}
