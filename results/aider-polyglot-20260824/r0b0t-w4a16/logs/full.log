```java
import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;

class ChangeCalculator {

    private final List<Integer> currencyCoins;

    ChangeCalculator(List<Integer> currencyCoins) {
        this.currencyCoins = currencyCoins;
    }

    List<Integer> computeMostEfficientChange(int grandTotal) {
        if (grandTotal < 0) {
            throw new IllegalArgumentException("Negative totals are not allowed.");
        }
        if (grandTotal == 0) {
            return new ArrayList<Integer>();
        }

        // DP array to store minimum number of coins for each value
        int[] minCoins = new int[grandTotal + 1];
        // Array to track which coin was used for each value
        int[] coinUsed = new int[grandTotal + 1];

        // Initialize with maximum value
        Arrays.fill(minCoins, grandTotal + 1);
        minCoins[0] = 0;

        // Fill DP table
        for (int i = 1; i <= grandTotal; i++) {
            for (int coin : currencyCoins) {
                if (coin <= i) {
                    int remaining = i - coin;
                    if (minCoins[remaining] + 1 < minCoins[i]) {
                        minCoins[i] = minCoins[remaining] + 1;
                        coinUsed[i] = coin;
                    }
                }
            }
        }

        // If change cannot be made
        if (minCoins[grandTotal] > grandTotal) {
            throw new IllegalArgumentException(
                "The total " + grandTotal + " cannot be represented in the given currency.");
        }

        // Reconstruct the change
        List<Integer> result = new ArrayList<Integer>();
        int current = grandTotal;
        while (current > 0) {
            result.add(coinUsed[current]);
            current -= coinUsed[current];
        }

        return result;
    }

}
