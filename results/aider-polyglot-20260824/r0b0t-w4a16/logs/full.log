connect.js
```javascript
//
// This is only a SKELETON file for the 'Connect' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Board {
  constructor(board) {
    this.board = board.map((row) => row.trim().split(/\s+/).filter((c) => c !== ''));
    this.height = this.board.length;
    this.width = this.board[0].length;
  }

  winner() {
    // Player O connects top to bottom (vertical)
    // Player X connects left to right (horizontal)

    // Check if O wins (top to bottom)
    if (this._playerWins('O')) {
      return 'O';
    }

    // Check if X wins (left to right)
    if (this._playerWins('X')) {
      return 'X';
    }

    return '';
  }

  _playerWins(player) {
    if (player === 'O') {
      return this._oWins();
    }
    return this._xWins();
  }

  _oWins() {
    // O connects top row to bottom row
    const visited = new Set();
    const queue = [];

    // Start from all 'O' in the top row
    for (let col = 0; col < this.width; col++) {
      if (this.board[0][col] === 'O') {
        visited.add(`0,${col}`);
        queue.push([0, col]);
      }
    }

    while (queue.length > 0) {
      const [row, col] = queue.shift();

      // If we reached the bottom row, O wins
      if (row === this.height - 1) {
        return true;
      }

      for (const neighbor of this._neighbors(row, col)) {
        const [nRow, nCol] = neighbor;
        const key = `${nRow},${nCol}`;
        if (
          this.board[nRow][nCol] === 'O' &&
          !visited.has(key)
        ) {
          visited.add(key);
          queue.push([nRow, nCol]);
        }
      }
    }

    return false;
  }

  _xWins() {
    // X connects left column to right column
    const visited = new Set();
    const queue = [];

    // Start from all 'X' in the left column
    for (let row = 0; row < this.height; row++) {
      if (this.board[row][0] === 'X') {
        visited.add(`${row},0`);
        queue.push([row, 0]);
      }
    }

    while (queue.length > 0) {
      const [row, col] = queue.shift();

      // If we reached the rightmost column, X wins
      if (col === this.width - 1) {
        return true;
      }

      for (const neighbor of this._neighbors(row, col)) {
        const [nRow, nCol] = neighbor;
        const key = `${nRow},${nCol}`;
        if (
          this.board[nRow][nCol] === 'X' &&
          !visited.has(key)
        ) {
          visited.add(key);
          queue.push([nRow, nCol]);
        }
      }
    }

    return false;
  }

  // Get valid neighbors accounting for the parallelogram's diagonal offset
  _neighbors(row, col) {
    const result = [];
    const neighbors = [
      [row, col - 1],
      [row, col + 1],
      [row + 1, col],
      [row + 1, col - 1],
      [row - 1, col],
      [row - 1, col - 1],
    ];

    for (const [nRow, nCol] of neighbors) {
      if (
        nRow >= 0 &&
        nRow < this.height &&
        nCol >= 0 &&
        nCol < this.width
      ) {
        result.push([nRow, nCol]);
      }
    }

    return result;
  }
}
