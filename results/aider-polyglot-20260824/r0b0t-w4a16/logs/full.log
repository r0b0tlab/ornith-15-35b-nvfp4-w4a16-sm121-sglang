PalindromeCalculator.java
```java
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.SortedMap;
import java.util.TreeMap;

class PalindromeCalculator {

    SortedMap<Long, List<List<Integer>>> getPalindromeProductsWithFactors(int minFactor, int maxFactor) {
        SortedMap<Long, List<List<Integer>>> result = new TreeMap<>();
        
        if (minFactor > maxFactor) {
            return result;
        }
        
        Map<Long, List<List<Integer>>> products = new HashMap<>();
        
        // Find all palindrome products
        for (int i = minFactor; i <= maxFactor; i++) {
            for (int j = i; j <= maxFactor; j++) {
                long product = (long) i * j;
                if (isPalindrome(product)) {
                    products.computeIfAbsent(product, k -> new ArrayList<>())
                            .add(List.of(i, j));
                }
            }
        }
        
        // Find smallest and largest palindrome
        if (!products.isEmpty()) {
            long smallest = products.keySet().stream().min(Long::compareTo).orElse(null);
            long largest = products.keySet().stream().max(Long::compareTo).orElse(null);
            
            result.put(smallest, products.get(smallest));
            result.put(largest, products.get(largest));
        }
        
        return result;
    }
    
    private boolean isPalindrome(long number) {
        String str = Long.toString(number);
        int left = 0;
        int right = str.length() - 1;
        
        while (left < right) {
            if (str.charAt(left) != str.charAt(right)) {
                return false;
            }
            left++;
            right--;
        }
        
        return true;
    }
}
```
