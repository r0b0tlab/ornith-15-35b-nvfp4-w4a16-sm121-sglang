```go
package wordy

import (
	"strconv"
	"strings"
)

func Answer(question string) (int, bool) {
	if !strings.HasPrefix(question, "What is ") {
		return 0, false
	}

	// Remove the "What is " prefix and the trailing "?"
	expression := strings.TrimSuffix(strings.TrimPrefix(question, "What is "), "?")
	expression = strings.TrimSpace(expression)

	if expression == "" {
		return 0, false
	}

	tokens := strings.Fields(expression)

	// The first token must be a number (the initial value)
	value, err := strconv.Atoi(tokens[0])
	if err != nil {
		return 0, false
	}

	operations := map[string]func(int, int) int{
		"plus":        func(a, b int) int { return a + b },
		"minus":       func(a, b int) int { return a - b },
		"multiplied":  func(a, b int) int { return a * b },
		"divided":     func(a, b int) int { return a / b },
	}

	for i := 1; i < len(tokens); i += 2 {
		// Expect an operation next
		op, ok := operations[tokens[i]]
		if !ok {
			return 0, false
		}

		// Expect a number after the operation
		if i+1 >= len(tokens) {
