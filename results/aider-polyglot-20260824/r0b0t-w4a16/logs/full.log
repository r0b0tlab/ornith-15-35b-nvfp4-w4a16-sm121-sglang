```javascript
//
// This is only a SKELETON file for the 'Say' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const LESS_THAN_TWENTY = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine',
  'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen',
];

const TENS = [
  '', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety',
];

const SCALE_WORDS = ['', 'thousand', 'million', 'trillion'];

// Handles the basic case of 0 through 999.
const threeDigitsToWords = (num) => {
  let result = [];
  const hundreds = Math.floor(num / 100);
  const remainder = num % 100;

  if (hundreds > 0) {
    result.push(LESS_THAN_TWENTY[hundreds], 'hundred');
  }

  if (remainder > 0) {
    const tens = Math.floor(remainder / 10);
    const ones = remainder % 10;

    if (remainder < 20) {
      result.push(LESS_THAN_TWENTY[remainder]);
    } else {
      if (ones > 0) {
        result.push(TENS[tens], LESS_THAN_TWENTY[ones]);
      } else {
        result.push(TENS[tens]);
      }
    }
  }

  return result.join(' ');
};

// Splits a number into chunks of thousands.
const splitIntoChunks = (n) => {
  const chunks = [];
  if (n === 0) {
    chunks.push(0);
  }
  while (n > 0) {
    chunks.push(n % 1000);
    n = Math.floor(n / 1000);
  }
  return chunks;
};

export const say = (n) => {
  if (n < 0 || n > 999999999999 || !Number.isInteger(n)) {
    throw new Error('Out of range');
  }

  if (n === 0) {
    return 'zero';
  }

  const chunks = splitIntoChunks(n);
  const parts = [];

  for (let i = chunks.length - 1; i >= 0; i--) {
    const chunk = chunks[i];
    if (chunk !== 0) {
      const chunkWords = threeDigitsToWords(chunk);
      if (SCALE_WORDS[i]) {
        parts.push(`${chunkWords} ${SCALE_WORDS[i]}`);
      } else {
        parts.push(chunkWords);
      }
    }
  }

  return parts.join(' ');
};
