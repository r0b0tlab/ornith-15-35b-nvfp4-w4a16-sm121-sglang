            int idx = 0;
            for (int i = 0; i < 5; i++) {
                if (ranks[i] != pairRank) {
                    kickers[idx++] = ranks[i];
                }
            }
            Arrays.sort(kickers);
            return 1_000_000 + pairRank * 100000 + kickers[2] * 1000 + kickers[1] * 10 + kickers[0];
        }

        // High card
        return flushRankScore(ranks);
    }

    private int flushRankScore(int[] ranks) {
        int[] sorted = ranks.clone();
        Arrays.sort(sorted);
        return sorted[4] * 100000000
                + sorted[3] * 10000000
                + sorted[2] * 1000000
                + sorted[1] * 10000
                + sorted[0] * 100;
    }

    private int rankToValue(char rankChar) {
        switch (rankChar) {
            case '2': return 2;
            case '3': return 3;
            case '4': return 4;
            case '5': return 5;
            case '6': return 6;
            case '7': return 7;
            case '8': return 8;
            case '9': return 9;
            case 'T': return 10;
            case 'J': return 11;
            case 'Q': return 12;
            case 'K': return 13;
            case 'A': return 14;
            default: throw new IllegalArgumentException("Invalid rank: " + rankChar);
        }
    }
}
