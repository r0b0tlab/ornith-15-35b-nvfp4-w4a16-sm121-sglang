/// A munger which XORs a key with some data
#[derive(Clone)]
pub struct Xorcism<'a> {
    key: &'a [u8],
}

impl<'a> Xorcism<'a> {
    /// Create a new Xorcism munger from a key
    ///
    /// Should accept anything which has a cheap conversion to a byte slice.
    pub fn new<Key>(key: &'a Key) -> Xorcism<'a>
    where
        Key: 'a + AsRef<[u8]>,
    {
        Xorcism { key: key.as_ref() }
    }

    /// XOR each byte of the input buffer with a byte from the key.
    ///
    /// Note that this is stateful: repeated calls are likely to produce different results,
    /// even with identical inputs.
    pub fn munge_in_place(&mut self, data: &mut [u8]) {
        for (byte, key_byte) in data.iter_mut().zip(self.key.iter().cycle()) {
            *byte ^= *key_byte;
        }
    }

    /// XOR each byte of the data with a byte from the key.
    ///
    /// Note that this is stateful: repeated calls are likely to produce different results,
    /// even with identical inputs.
    ///
    /// Should accept anything which has a cheap conversion to a byte iterator.
    /// Shouldn't matter whether the byte iterator's values are owned or borrowed.
    pub fn munge<Data>(&mut self, data: Data) -> impl Iterator<Item = u8>
    where
        Data: IntoIterator<Item = u8>,
    {
        data.into_iter().zip(self.key.iter().cycle().cloned())
            .map(|(byte, key_byte)| byte ^ key_byte)
    }
}

/// The `io` feature flag enables the `reader` and `writer` methods, which adapt
/// streams of bytes for XOR encryption/decryption.
#[cfg(feature = "io")]
impl<'a> Xorcism<'a> {
    /// Convert the `Xorcism` into a `Read` adaptor which XORs a stream of bytes
    /// with the key.
    pub fn reader<R: std::io::Read>(self, reader: R) -> impl std::io::Read {
        let key = self.key;
        Reader {
            inner: reader,
            key,
            position: 0,
        }
    }

    /// Convert the `Xorcism` into a `Write` adaptor which XORs a stream of bytes
    /// with the key.
    pub fn writer<W: std::io::Write>(self, writer: W) -> impl std::io::Write {
        let key = self.key;
        Writer {
            inner: writer,
            key,
            position: 0,
        }
    }
}

/// A `Read` adaptor which XORs bytes read from the inner reader with the key.
#[cfg(feature = "io")]
pub struct Reader<R: std::io::Read> {
    inner: R,
    key: &[u8],
    position: usize,
}

#[cfg(feature = "io")]
impl<R: std::io::Read> std::io::Read for Reader<R> {
    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
        let n = self.inner.read(buf)?;
        for (byte, key_byte) in buf[..n].iter_mut().zip(self.key.iter().cycle()) {
            *byte ^= *key_byte;
        }
        self.position = self.position.wrapping_add(n);
        Ok(n)
    }
}

/// A `Write` adaptor which XORs bytes written to the inner writer with the key.
#[cfg(feature = "io")]
pub struct Writer<W: std::io::Write> {
    inner: W,
    key: &[u8],
    position: usize,
}

#[cfg(feature = "io")]
impl<W: std::io::Write> std::io::Write for Writer<W> {
    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
        let mut cloned = buf.to_vec();
        for (byte, key_byte) in cloned.iter_mut().zip(self.key.iter().cycle()) {
            *byte ^= *key_byte;
        }
        self.inner.write(&cloned)
    }

    fn flush(&mut self) -> std::io::Result<()> {
        self.inner.flush()
    }
}
