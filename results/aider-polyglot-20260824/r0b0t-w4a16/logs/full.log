pub mod graph {
    use std::collections::HashMap;

    pub mod graph_items {
        pub mod node {
            #[derive(Debug, Clone, PartialEq, Eq, Hash)]
            pub struct Node {
                pub name: String,
                pub color: Option<String>,
            }

            impl Node {
                pub fn new(name: &str) -> Self {
                    Node {
                        name: name.to_string(),
                        color: None,
                    }
                }

                pub fn with_color(mut self, color: &str) -> Self {
                    self.color = Some(color.to_string());
                    self
                }
            }

            pub use Node;
        }

        pub mod edge {
            use super::node::Node;

            #[derive(Debug, Clone, PartialEq, Eq, Hash)]
            pub struct Edge {
                pub from: String,
                pub to: String,
                pub color: Option<String>,
            }

            impl Edge {
                pub fn new(from: &str, to: &str) -> Self {
                    Edge {
                        from: from.to_string(),
                        to: to.to_string(),
                        color: None,
                    }
                }

                pub fn with_color(mut self, color: &str) -> Self {
                    self.color = Some(color.to_string());
                    self
                }
            }

            pub use Edge;
        }
    }

    use graph_items::edge::Edge;
    use graph_items::node::Node;

    #[derive(Debug, Clone, Default)]
    pub struct Graph {
        nodes: Vec<Node>,
        edges: Vec<Edge>,
        attrs: Vec<(String, String)>,
    }

    impl Graph {
        pub fn new() -> Self {
            Graph {
                nodes: Vec::new(),
                edges: Vec::new(),
                attrs: Vec::new(),
            }
        }

        pub fn with_nodes(&mut self, items: &[&str]) -> &mut Self {
            for item in items {
                self.nodes.push(Node::new(item));
            }
            self
        }

        pub fn with_edges(&mut self, items: &[(&str, &str)]) -> &mut Self {
            for (from, to) in items {
                self.edges.push(Edge::new(from, to));
            }
            self
        }

        pub fn with_attrs(&mut self, items: &[(&str, &str)]) -> &mut Self {
            for (key, value) in items {
                self.attrs.push((key.to_string(), value.to_string()));
            }
            self
        }

        pub fn has_node(&self, node: &str) -> bool {
            self.nodes.iter().any(|n| n.name == node)
        }

        pub fn node(&self, name: &str) -> Option<&Node> {
            self.nodes.iter().find(|n| n.name == name)
        }

        pub fn nodes(&self) -> Vec<Node> {
            self.nodes.clone()
        }

        pub fn edges(&self) -> Vec<Edge> {
            self.edges.clone()
        }
    }
}
