+#include <cctype>
 
 namespace crypto_square {
 
+std::string cipher::plaintext(std::string input) {
+    // Normalize the input: remove spaces and punctuation, down-case
+    std::string normalized;
+    for (char c : input) {
+        if (std::isalnum(static_cast<unsigned char>(c))) {
+            normalized.push_back(std::tolower(static_cast<unsigned char>(c)));
+        }
+    }
+
+    // Handle empty input
+    if (normalized.empty()) {
+        return "";
+    }
+
+    // Calculate the number of columns and rows
+    int length = normalized.length();
+    int c = 0;
+    int r = 0;
+    for (int i = 1; i <= length; ++i) {
+        if (i * i >= length) {
+            c = i;
+            break;
+        }
+    }
+    for (int i = 1; i <= length; ++i) {
+        if (i * c >= length) {
+            r = i;
+            break;
+        }
+    }
+
+    // Build the encoded message by reading down the columns
+    std::string encoded;
+    for (int col = 0; col < c; ++col) {
+        if (col > 0) {
+            encoded.push_back(' ');
+        }
+        for (int row = 0; row < r; ++row) {
+            int index = row * c + col;
+            if (index < length) {
+                encoded.push_back(normalized[index]);
+            } else {
+                encoded.push_back(' ');
+            }
+        }
+    }
+
+    return encoded;
+}
+
 }  // namespace crypto_square
