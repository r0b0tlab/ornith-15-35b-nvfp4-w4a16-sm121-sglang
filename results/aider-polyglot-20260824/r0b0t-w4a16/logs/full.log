circular_buffer.cpp
```cpp
#include "circular_buffer.h"

namespace circular_buffer {

Buffer::Buffer(size_t size) 
    : buffer_(size), capacity_(size), head_(0), count_(0) {}

void Buffer::write(int value) {
    if (is_full()) {
        throw std::runtime_error("Buffer is full");
    }
    size_t tail = (head_ + count_) % capacity_;
    buffer_[tail] = value;
    count_++;
}

int Buffer::read() {
    if (is_empty()) {
        throw std::runtime_error("Buffer is empty");
    }
    int value = buffer_[head_];
    head_ = (head_ + 1) % capacity_;
    count_--;
    return value;
}

void Buffer::overwrite(int value) {
    if (is_empty()) {
        write(value);
        return;
    }
    if (is_full()) {
        buffer_[head_] = value;
        head_ = (head_ + 1) % capacity_;
    } else {
        write(value);
    }
}

void Buffer::clear() {
    head_ = 0;
    count_ = 0;
}

bool Buffer::is_full() const {
    return count_ == capacity_;
}

bool Buffer::is_empty() const {
    return count_ == 0;
}

}  // namespace circular_buffer
```
