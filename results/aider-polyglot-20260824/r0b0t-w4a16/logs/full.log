    // This means that you may assume, without checking, that if the dependencies exist at creation
    // time they will continue to exist as long as the Reactor exists.
    pub fn create_compute<F: Fn(&[T]) -> T>(
        &mut self,
        dependencies: &[CellId],
        compute_func: F,
    ) -> Result<ComputeCellId, CellId> {
        for dep in dependencies {
            let exists = self.input_cells.iter().any(|c| c.id == Some(*dep))
                || self.compute_cells.iter().any(|c| c.id == Some(*dep));
            if !exists {
                return Err(*dep);
            }
        }

        let values: Vec<T> = dependencies
            .iter()
            .map(|dep| self.value(*dep).expect("dependencies exist"))
            .collect();
        let value = compute_func(&values);

        let id = ComputeCellId(self.next_compute_id);
        self.next_compute_id += 1;
        self.compute_cells.push(ComputeCell {
            id: Some(id),
            dependencies: dependencies.to_vec(),
            compute_func: Box::new(compute_func),
            value,
            callbacks: Vec::new(),
        });
        Ok(id)
    }

