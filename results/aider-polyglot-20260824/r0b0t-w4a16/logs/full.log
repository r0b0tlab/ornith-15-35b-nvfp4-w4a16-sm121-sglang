def total(basket):
    # Discount percentages for sets of different books
    discounts = {
        1: 0.0,
        2: 0.05,
        3: 0.10,
        4: 0.20,
        5: 0.25,
    }
    
    PRICE_PER_BOOK = 800  # in cents
    
    def set_price(count):
        """Price for a set of `count` different books with discount applied."""
        base_price = count * PRICE_PER_BOOK
        discounted = base_price * (1 - discounts[count])
        return discounted
    
    # Count occurrences of each book
    counts = {}
    for book in basket:
        counts[book] = counts.get(book, 0) + 1
    
    # We need to find the optimal grouping to maximize discount (minimize price)
    # Use dynamic programming / recursive approach with memoization
    
    from collections import Counter
    from functools import lru_cache
    
    @lru_cache(maxsize=None)
    def min_price(counts_tuple):
        counts = tuple(counts_tuple)
        if all(c == 0 for c in counts):
            return 0.0
        
        # Try all possible sets we can form
        best = float('inf')
        n = len(counts)
        
        # Generate all possible subsets of available book types (with count > 0)
        available = [i for i in range(n) if counts[i] > 0]
        
        # Try forming a set of each possible size (1 to len(available))
        # But we want to try all combinations
        from itertools import combinations
        
        for size in range(1, len(available) + 1):
            for combo in combinations(available, size):
                # Form a set from these books
                price = set_price(size)
                # Reduce counts
                new_counts = list(counts)
                for idx in combo:
                    new_counts[idx] -= 1
                price += min_price(tuple(new_counts))
                if price < best:
                    best = price
        
        return best
    
    return int(min_price(tuple(counts.values())))
