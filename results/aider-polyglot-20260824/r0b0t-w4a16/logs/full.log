react.py
```python
class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._compute_cells = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        self._update_compute_cells()

    def _update_compute_cells(self):
        for compute_cell in self._compute_cells:
            compute_cell._update_value()

    def register_compute_cell(self, compute_cell):
        self._compute_cells.append(compute_cell)


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = inputs
        self._compute_function = compute_function
        self._value = self._compute_value()
        self._callbacks = set()
        for input_cell in inputs:
            input_cell.register_compute_cell(self)

    @property
    def value(self):
        return self._value

    def _compute_value(self):
        inputs = [input_cell.value for input_cell in self._inputs]
        return self._compute_function(inputs)

    def _update_value(self):
        new_value = self._compute_value()
        if new_value != self._value:
            self._value = new_value
            self._notify_callbacks()

    def add_callback(self, callback):
        self._callbacks.add(callback)

    def remove_callback(self, callback):
        self._callbacks.discard(callback)

    def _notify_callbacks(self):
        for callback in self._callbacks:
            callback(self._value)
```
