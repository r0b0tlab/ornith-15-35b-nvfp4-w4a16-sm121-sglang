import java.util.List;
import java.util.ArrayList;

class KindergartenGarden {

    private static final List<String> DEFAULT_STUDENTS = List.of(
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    );

    private List<String> students;
    private String[] rows;

    KindergartenGarden(String garden) {
        this.students = DEFAULT_STUDENTS;
        this.rows = garden.split("\n");
    }

    KindergartenGarden(String garden, List<String> students) {
        this.students = students;
        this.rows = garden.split("\n");
    }

    List<Plant> getPlantsOfStudent(String student) {
        int studentIndex = students.indexOf(student);
        int startIndex = studentIndex * 2;

        List<Plant> plants = new ArrayList<>();
        plants.add(getPlant(rows[0].charAt(startIndex)));
        plants.add(getPlant(rows[0].charAt(startIndex + 1)));
        plants.add(getPlant(rows[1].charAt(startIndex)));
        plants.add(getPlant(rows[1].charAt(startIndex + 1)));
        return plants;
    }

    private Plant getPlant(char code) {
        switch (code) {
            case 'G': return Plant.GRASS;
            case 'C': return Plant.CLOVER;
            case 'R': return Plant.radishes;
            case 'V': return Plant.violets;
            default: throw new IllegalArgumentException("Invalid plant code: " + code);
        }
    }
}
