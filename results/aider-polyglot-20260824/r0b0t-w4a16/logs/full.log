PigLatinTranslator.java
```java
class PigLatinTranslator {
    public String translate(String word) {
        // Rule 1: begins with a vowel, or starts with "xr" or "yt"
        if (startsWithVowel(word) || word.startsWith("xr") || word.startsWith("yt")) {
            return word + "ay";
        }
        
        // Rule 3: starts with zero or more consonants followed by "qu"
        int quIndex = findConsonantClusterWithQu(word);
        if (quIndex > 0) {
            return word.substring(quIndex) + word.substring(0, quIndex) + "ay";
        }
        
        // Rule 4: starts with one or more consonants followed by "y"
        int yIndex = findYIndex(word);
        if (yIndex > 0) {
            return word.substring(yIndex) + word.substring(0, yIndex) + "ay";
        }
        
        // Rule 2: begins with one or more consonants
        int firstVowelIndex = findFirstVowelIndex(word);
        if (firstVowelIndex > 0) {
            return word.substring(firstVowelIndex) + word.substring(0, firstVowelIndex) + "ay";
        }
        
        // Default case - return word with "ay"
        return word + "ay";
    }
    
    private boolean startsWithVowel(String word) {
        return word.matches("^[aeiou].*");
    }
    
    private int findConsonantClusterWithQu(String word) {
        // Find the position of "qu" after any leading consonants
        for (int i = 0; i < word.length() - 1; i++) {
            if (word.charAt(i) == 'q' && i + 1 < word.length() && word.charAt(i + 1) == 'u') {
                return i;
            }
        }
        return 0;
    }
    
    private int findYIndex(String word) {
        // Find the position of the first 'y' after the first consonant
        for (int i = 1; i < word.length(); i++) {
            if (word.charAt(i) == 'y') {
                return i;
            }
        }
        return 0;
    }
    
    private int findFirstVowelIndex(String word) {
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if ("aeiou".indexOf(c) >= 0) {
                return i;
            }
        }
        return 0;
    }
}
