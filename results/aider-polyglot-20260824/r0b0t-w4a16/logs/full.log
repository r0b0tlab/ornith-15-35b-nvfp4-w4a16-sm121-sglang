export class RestAPI {
  constructor(db) {
    this.db = db || {};
  }

  get(url) {
    // Handle GET requests
    if (url.startsWith('/users')) {
      // Parse the query parameters
      const queryString = url.split('?')[1] || '';
      const params = new URLSearchParams(queryString);
      const users = params.get('users');
      
      if (users) {
        const userList = users.split(',');
        const result = [];
        for (const name of userList) {
          if (this.db[name]) {
            result.push(this.getUserInfo(name));
          }
        }
        return { users: result };
      }
      
      // If no users specified, return all users
      return { users: Object.values(this.db).map(user => this.getUserInfo(user.name)) };
    }
    
    throw new Error(`Not implemented: ${url}`);
  }

  post(url, payload) {
    // Handle POST requests
    if (url === '/add') {
      const { user } = payload;
      
      if (!this.db[user]) {
        // Create new user
        this.db[user] = {
          name: user,
          owes: {},
          owed_by: {},
          balance: 0
        };
      }
      
      return this.getUserInfo(user);
    }
    
    if (url === '/iou') {
      const { lender, borrower, amount } = payload;
      
      // Update the IOU records
      this.updateIOU(lender, borrower, amount);
      
      // Return updated user info
      return {
        users: [
          this.getUserInfo(lender),
          this.getUserInfo(borrower)
        ].sort((a, b) => a.name.localeCompare(b.name))
      };
    }
    
    throw new Error(`Not implemented: ${url}`);
  }

  // Helper method to get user info in the required format
  getUserInfo(name) {
    const user = this.db[name];
    if (!user) {
      return null;
    }
    
    // Calculate balance
    let balance = 0;
    for (const amount of Object.values(user.owed_by)) {
      balance += amount;
    }
    for (const amount of Object.values(user.owes)) {
      balance -= amount;
    }
    
    return {
      name: user.name,
      owes: user.owes,
      owed_by: user.owed_by,
      balance
    };
  }

  // Helper method to update IOU records
  updateIOU(lender, borrower, amount) {
    // If user doesn't exist, create them
    if (!this.db[lender]) {
      this.db[lender] = {
        name: lender,
        owes: {},
        owed_by: {},
        balance: 0
      };
    }
    if (!this.db[borrower]) {
      this.db[borrower] = {
        name: borrower,
        owes: {},
        owed_by: {},
        balance: 0
      };
    }
    
    // Update lender's record (they are owed money)
    this.db[lender].owed_by[borrower] = 
      (this.db[lender].owed_by[borrower] || 0) + amount;
    
    // Update borrower's record (they owe money)
    this.db[borrower].owes[lender] = 
      (this.db[borrower].owes[lender] || 0) + amount;
    
    // Now we need to net out any debts between these two users
    this.nettleDebt(lender, borrower);
  }

  // Helper method to net out debts between two users
  nettleDebt(user1, user2) {
    const u1 = this.db[user1];
    const u2 = this.db[user2];
    
    // Check if user1 owes user2
    const u1OwesToU2 = u1.owes[user2] || 0;
    // Check if user2 owes user1
    const u2OwesToU1 = u2.owed_by[user1] || 0;
    
    // If both have debts between them, net them out
    if (u1OwesToU2 > 0 && u2OwesToU1 > 0) {
      if (u1OwesToU2 > u2OwesToU1) {
        // u1 owes u2 more than u2 owes u1
        u1.owes[user2] = u1OwesToU2 - u2OwesToU1;
        delete u2.owed_by[user1];
      } else if (u1OwesToU2 < u2OwesToU1) {
        // u2 owes u1 more than u1 owes u2
        u2.owed_by[user1] = u2OwesToU1 - u1OwesToU2;
        delete u1.owes[user2];
      } else {
        // Debts are equal, both are cleared
        delete u1.owes[user2];
        delete u2.owed_by[user1];
      }
    }
  }
}
