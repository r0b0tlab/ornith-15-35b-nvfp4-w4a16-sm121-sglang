transpose.go
```go
package transpose

import "strings"

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length of input rows
	maxLen := 0
	for _, row := range input {
		if len(row) > maxLen {
			maxLen = len(row)
		}
	}

	// For each output row (which corresponds to a column in the input),
	// track the maximum index we need to include
	outputLen := make([]int, maxLen)
	for col := 0; col < maxLen; col++ {
		for row := 0; row < len(input); row++ {
			if col < len(input[row]) {
				if col > outputLen[col] {
					outputLen[col] = col
				}
			}
		}
	}

	// Build the output
	output := make([]string, maxLen)
	for col := 0; col < maxLen; col++ {
		var sb strings.Builder
		maxRow := outputLen[col]
		for row := 0; row <= maxRow; row++ {
			if col < len(input[row]) {
				sb.WriteByte(input[row][col])
			} else {
				sb.WriteByte(' ')
			}
		}
		output[col] = sb.String()
	}

	return output
}
