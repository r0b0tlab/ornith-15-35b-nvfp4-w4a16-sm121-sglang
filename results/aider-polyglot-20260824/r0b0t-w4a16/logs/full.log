The current approach of greedily forming groups and then swapping 5+3 → 4+4 doesn't handle all cases correctly. The issue is that the greedy grouping doesn't always produce the optimal result, and the swap optimization is incomplete.

A more robust approach is to recursively try all possible groupings and find the minimum cost. This guarantees the optimal solution.

book-store.js
```javascript
//
// This is only a SKELETON file for the 'BookStore' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const PRICE_PER_BOOK = 800;

const discounts = {
  1: 0.0,
  2: 0.05,
  3: 0.10,
  4: 0.20,
  5: 0.25,
};

function groupCost(size) {
  const discount = discounts[size];
  return size * PRICE_PER_BOOK * (1 - discount);
}

export const cost = (books) => {
  const counts = books.reduce((acc, book) => {
    acc[book] = (acc[book] || 0) + 1;
    return acc;
  }, {});

  const countsArr = Object.values(counts).filter((c) => c > 0).sort((a, b) => a - b);

  if (countsArr.length === 0) {
    return 0;
  }

  let minCost = Infinity;

  // Try each possible group size from 1 to 5
  for (let groupSize = 1; groupSize <= 5; groupSize++) {
    if (countsArr.length < groupSize) {
      continue;
    }

    // Form a group with the first `groupSize` books
    const newCounts = countsArr.slice();
    for (let i = 0; i < groupSize; i++) {
      newCounts[i]--;
    }
    const filtered = newCounts.filter((c) => c > 0);

    const currentCost = groupCost(groupSize) + cost(filtered.map((_, i) => i));
    // Actually, we need to recurse with the filtered counts
    // Let's use a helper that works on counts array directly
  }

  // Better approach: recursive with counts
  return costFromCounts(countsArr);
};

function costFromCounts(counts) {
  const filtered = counts.filter((c) => c > 0);

  if (filtered.length === 0) {
    return 0;
  }

  let minCost = Infinity;

  for (let groupSize = 1; groupSize <= 5 && groupSize <= filtered.length; groupSize++) {
    // Try all combinations of `groupSize` distinct books
    // But to keep it simple, try taking the largest groupSize books
    const newCounts = filtered.slice();
    for (let i = 0; i < groupSize; i++) {
      newCounts[i]--;
    }

    const remaining = newCounts.filter((c) => c > 0).sort((a, b) => a - b);
    const currentCost = groupCost(groupSize) + costFromCounts(remaining);
    minCost = Math.min(minCost, currentCost);
  }

  return minCost;
}
```

