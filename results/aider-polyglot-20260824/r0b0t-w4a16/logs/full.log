I'll implement a solution for the two-bucket measuring problem using BFS to find the minimum number of actions.

two_bucket.py
```python
from collections import deque

def measure(bucket_one, bucket_two, goal, start_bucket):
    # Validate inputs
    if bucket_one <= 0 or bucket_two <= 0:
        raise ValueError("Bucket sizes must be positive")
    if goal <= 0:
        raise ValueError("Goal must be positive")
    if goal > max(bucket_one, bucket_two):
        raise ValueError("Goal is larger than the largest bucket")
    if goal == bucket_one and goal == bucket_two:
        raise ValueError("Goal cannot equal both bucket sizes")
    
    # Check if the goal is achievable
    from math import gcd
    if goal % gcd(bucket_one, bucket_two) != 0:
        raise ValueError("Goal is not achievable")
    
    # The forbidden state is (empty start_bucket, full other bucket)
    if start_bucket == 1:
        forbidden = (0, bucket_two)
    else:
        forbidden = (bucket_one, 0)
    
    # BFS to find minimum actions
    start = (0, 0)
    queue = deque([(start, 0)])
    visited = {start}
    
    while queue:
        state, actions = queue.popleft()
        
        # Check if we've reached the goal
        if state[0] == goal or state[1] == goal:
            return actions, "bucket_one" if state[0] == goal else "bucket_two", state[1] if state[0] == goal else state[0]
        
        # Generate all possible next states
        next_states = []
        current = state
        
        # Empty a bucket
        if current[0] > 0:
            next_states.append((0, current[1]))
        if current[1] > 0:
            next_states.append((current[0], 0))
        
        # Fill a bucket
        if current[0] < bucket_one:
            next_states.append((bucket_one, current[1]))
        if current[1] < bucket_two:
            next_states.append((current[0], bucket_two))
        
        # Pour bucket_one into bucket_two
        if current[0] > 0 and current[1] < bucket_two:
            amount = min(current[0], bucket_two - current[1])
            next_states.append((current[0] - amount, current[1] + amount))
        
        # Pour bucket_two into bucket_one
        if current[1] > 0 and current[0] < bucket_one:
            amount = min(current[1], bucket_one - current[1])
            next_states.append((current[0] + amount, current[1] - amount))
        
        # Process next states
        for next_state in next_states:
            if next_state not in visited and next_state != forbidden:
                visited.add(next_state)
                queue.append((next_state, actions + 1))
    
    raise ValueError("It is not possible to reach the goal quantity")
```
