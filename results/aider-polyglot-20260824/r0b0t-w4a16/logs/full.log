+
+const mmi = (a, m) => {
+  for (let x = 1; x < m; x++) {
+    if ((a * x) % m === 1) {
+      return x;
+    }
+  }
+  throw new Error('Key is not coprime to the size of the alphabet.');
 };
 
-export const decode = (phrase, key) => {
-  throw new Error('Remove this statement and implement this function');
+const process = (phrase, key, decrypt) => {
+  const { a, b } = key;
+  if (a % M === 0 || a % M === 0) {
+    throw new Error('a and m must be coprime.');
+  }
+
+  const aInverse = decrypt ? mmi(a, M) : 1;
+
+  const result = [];
+  for (const char of phrase.toLowerCase()) {
+    if (char >= 'a' && char <= 'z') {
+      const i = char.charCodeAt(0) - 'a'.charCodeAt(0);
+      const value = decrypt
+        ? ((aInverse * (i - b)) % M + M) % M
+        : ((a * i + b) % M);
+      result.push(String.fromCharCode('a'.charCodeAt(0) + value));
