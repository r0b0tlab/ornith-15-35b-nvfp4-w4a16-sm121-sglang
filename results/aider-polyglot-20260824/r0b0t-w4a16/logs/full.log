fn lowest_price_helper(counts: &[u32]) -> u32 {
    // If all counts are zero, we're done
    if counts.iter().all(|&c| c == 0) {
        return 0;
    }

    // Try all possible group sizes (from 1 to 5)
    let mut min_price = u32::MAX;

    for group_size in 1..=5 {
        // Check if we can form a group of this size
        let available = counts.iter().filter(|&&c| c > 0).count();
        if available < group_size {
            continue;
        }

        // Calculate the price for this group
        let group_price = group_price(group_size as u32);

        // Remove one of each of the first group_size books
        let mut new_counts = counts.to_vec();
        for c in new_counts.iter_mut().take(group_size) {
            if *c > 0 {
                *c -= 1;
            }
        }

        // Recursively calculate the price for the remaining books
        let total_price = group_price + lowest_price_helper(&new_counts);
        if total_price < min_price {
            min_price = total_price;
        }
    }

    min_price
}

