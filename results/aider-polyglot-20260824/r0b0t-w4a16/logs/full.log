wordy.py
```python
def answer(question):
    if not question.startswith("What is"):
        raise ValueError("unknown operation")
    
    # Remove "What is" and the trailing "?"
    expression = question[len("What is"):].rstrip("?").strip()
    
    if expression == "":
        raise ValueError("syntax error")
    
    # Map word operations to actual operations
    op_map = {
        "plus": lambda a, b: a + b,
        "minus": lambda a, b: a - b,
        "multiplied by": lambda a, b: a * b,
        "divided by": lambda a, b: a / b,
    }
    
    # Tokenize, combining "multiplied by" and "divided by"
    tokens = []
    words = expression.split()
    i = 0
    while i < len(words):
        if i + 1 < len(words) and words[i] == "multiplied" and words[i+1] == "by":
            tokens.append("multiplied by")
            i += 2
        elif i + 1 < len(words) and words[i] == "divided" and words[i+1] == "by":
            tokens.append("divided by")
            i += 2
        else:
            tokens.append(words[i])
            i += 1
    
    # Parse tokens
    if len(tokens) == 0:
        raise ValueError("syntax error")
    
    # First token must be a number
    try:
        result = int(tokens[0])
    except ValueError:
        raise ValueError("syntax error")
    
    i = 1
    while i < len(tokens):
        # Must be an operation
        if tokens[i] not in op_map:
            if tokens[i].lstrip('-').isdigit():
                raise ValueError("unknown operation")
            raise ValueError("syntax error")
        op = op_map[tokens[i]]
        
        # Must be followed by a number
        if i + 1 >= len(tokens):
            raise ValueError("syntax error")
        try:
            next_num = int(tokens[i+1])
        except ValueError:
            raise ValueError("syntax error")
        
        result = op(result, next_num)
        i += 2
    
    return result
```
