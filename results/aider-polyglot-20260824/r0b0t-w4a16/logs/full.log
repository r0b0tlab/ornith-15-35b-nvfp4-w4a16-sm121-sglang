class ResistorColorTrio {
    private static final String[] COLOR_NAMES = {
        "black", "brown", "red", "orange", "yellow",
        "green", "blue", "violet", "grey", "white"
    };

    String label(String[] colors) {
        // Get the numeric value of each color
        int first = colorValue(colors[0]);
        int second = colorValue(colors[1]);
        int multiplier = colorValue(colors[2]);

        // Calculate the main value from the first two colors
        long value = (long) (first * 10 + second);

        // Apply the multiplier (number of zeros)
        value = value * (long) Math.pow(10, multiplier);

        // Determine the appropriate label
        if (value >= 1_000_000_000L && value % 1_000_000_000L == 0) {
            return (value / 1_000_000_000L) + " gigaohms";
        } else if (value >= 1_000_000L && value % 1_000_000L == 0) {
            return (value / 1_000_000L) + " megaohms";
        } else if (value >= 1_000L && value % 1_000L == 0) {
            return (value / 1_000L) + " kiloohms";
        } else {
            return value + " ohms";
        }
    }

    private int colorValue(String color) {
        for (int i = 0; i < COLOR_NAMES.length; i++) {
            if (COLOR_NAMES[i].equals(color)) {
                return i;
            }
        }
        throw new IllegalArgumentException("Unknown color: " + color);
    }
}
