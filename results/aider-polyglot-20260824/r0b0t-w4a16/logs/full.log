pub fn lowest_price(books: &[u32]) -> u32 {
    // Count the number of each book
    let mut counts = [0; 5];
    for &book in books {
        counts[(book - 1) as usize] += 1;
    }

    // Sort counts in descending order
    counts.sort_unstable_by(|a, b| b.cmp(a));

    // Calculate the price using a greedy approach with backtracking
    lowest_price_helper(&counts)
}

fn lowest_price_helper(counts: &[u32]) -> u32 {
    // If all counts are zero, we're done
    if counts.iter().all(|&c| c == 0) {
        return 0;
    }

    // Find the number of distinct books (non-zero counts)
    let distinct = counts.iter().filter(|&&c| c > 0).count() as u32;

    // Calculate the price for a group of 'distinct' books with the discount
    let group_price = group_price(distinct);

    // Remove one of each distinct book
    let mut new_counts = counts.to_vec();
    for c in new_counts.iter_mut() {
        if *c > 0 {
            *c -= 1;
        }
    }

    // Recursively calculate the price for the remaining books
    group_price + lowest_price_helper(&new_counts)
}

fn group_price(distinct: u32) -> u32 {
    const PRICE: u32 = 800; // Price per book in cents

    let discount = match distinct {
        2 => 0.05,
        3 => 0.10,
        4 => 0.20,
        5 => 0.25,
        _ => 0.0,
    };

    (distinct as u32 * PRICE * (1000 - (discount * 1000.0) as u32) / 1000)
}
