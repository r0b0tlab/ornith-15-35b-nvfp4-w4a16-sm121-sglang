```javascript
const M = 26;
const GROUP_SIZE = 5;

const gcd = (a, b) => (b === 0 ? a : gcd(b, a % b));

const mmi = (a, m) => {
  for (let x = 1; x < m; x++) {
    if ((a * x) % m === 1) {
      return x;
    }
  }
  throw new Error('a and m must be coprime.');
};

const process = (phrase, key, decrypt) => {
  const { a, b } = key;
  if (gcd(a, M) !== 1) {
    throw new Error('a and m must be coprime.');
  }

  const aInverse = decrypt ? mmi(a, M) : 1;

  const result = [];
  for (const char of phrase.toLowerCase()) {
    if (char >= 'a' && char <= 'z') {
      const i = char.charCodeAt(0) - 'a'.charCodeAt(0);
      const value = decrypt
        ? ((aInverse * (i - b)) % M + M) % M
        : ((a * i + b) % M);
      result.push(String.fromCharCode('a'.charCodeAt(0) + value));
    } else if (char >= '0' && char <= '9') {
      result.push(char);
    }
  }

  const flat = result.join('');
  if (!decrypt) {
    return flat
      .match(new RegExp(`.{1,${GROUP_SIZE}}`, 'g'))
      .join(' ');
  }
  return flat;
};

export const encode = (phrase, key) => process(phrase, key, false);

export const decode = (phrase, key) => process(phrase, key, true);
```
