hangman.py
```python
# Game status categories
# Change the values as you see fit
STATUS_WIN = 'win'
STATUS_LOSE = 'lose'
STATUS_ONGOING = 'ongoing'


class Hangman:
    def __init__(self, word):
        self.word = word
        self.masked = '_' * len(word)
        self.guessed = set()
        self.remaining_guesses = 6
        self.status = STATUS_ONGOING

    def guess(self, char):
        if self.status != STATUS_ONGOING:
            raise ValueError("The game has already ended.")

        if char in self.guessed:
            # Already guessed - counts as a loss
            self.status = STATUS_LOSE
            self.remaining_guesses = -1
            return

        self.guessed.add(char)

        if char in self.word:
            # Rebuild masked word with all correct guesses
            new_masked = ''
            for i, c in enumerate(self.word):
                if c in self.guessed or c == char:
                    new_masked += c
                else:
                    new_masked += self.masked[i]
            self.masked = new_masked

            # Check for win
            if all(c in self.guessed for c in self.word):
                self.status = STATUS_WIN
        else:
            # Wrong guess
            self.remaining_guesses -= 1
            if self.remaining_guesses < 0:
                self.status = STATUS_LOSE

    def get_masked_word(self):
        return self.masked

    def get_status(self):
        return self.status
```
