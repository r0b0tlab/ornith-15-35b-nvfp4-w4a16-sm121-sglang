```java
import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedList;
import java.util.Map;
import java.util.Queue;
import java.util.Set;

class TwoBucket {
    private int totalMoves;
    private String finalBucket;
    private int otherBucket;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        // Try both strategies and pick the better one
        Result result1 = simulate(bucketOneCap, bucketTwoCap, desiredLiters, "one");
        Result result2 = simulate(bucketOneCap, bucketTwoCap, desiredLiters, "two");

        // Pick the strategy with fewer moves
        if (result1.moves < result2.moves) {
            totalMoves = result1.moves;
            finalBucket = result1.finalBucket;
            otherBucket = result1.otherBucket;
        } else {
            totalMoves = result2.moves;
            finalBucket = result2.finalBucket;
            otherBucket = result2.otherBucket;
        }
    }

    private Result simulate(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        // BFS to find minimum moves for a given starting bucket strategy
        
        // State: [bucketOne, bucketTwo]
        // We track visited states to avoid cycles
        
        // Special case: if desired equals the other bucket's capacity, 
        // we can fill the other bucket directly
        
        // Track the "forbidden" state: start bucket empty, other full
        // This is determined by the rules
        
        // BFS queue holds: int[]{bucketOne, bucketTwo, moves}
        Queue<int[]> queue = new LinkedList<>();
        Map<String, Integer> visited = new HashMap<>();
        
        int bucketOne = 0;
        int bucketTwo = 0;
        
        // Fill the starting bucket (first action)
        if (startBucket.equals("one")) {
            bucketOne = bucketOneCap;
        } else {
            bucketTwo = bucketTwoCap;
        }
        int moves = 1;
        
        String startKey = bucketOne + "," + bucketTwo;
        visited.put(startKey, moves);
        queue.add(new int[]{bucketOne, bucketTwo, moves});
        
        // Check if we've already reached the goal
        if (bucketOne == desiredLiters) {
            return new Result(moves, "one", bucketTwo);
        }
        if (bucketTwo == desiredLiters) {
            return new Result(moves, "two", bucketOne);
        }
        
        // BFS exploration
        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int curOne = current[0];
            int curTwo = current[1];
            int curMoves = current[2];
            
            // Generate all possible next states
            
            // Action 1: Pour bucket one into bucket two
            int pourOne = Math.min(curOne, bucketTwoCap - curTwo);
            int nextOne = curOne - pourOne;
            int nextTwo = curTwo + pourOne;
            String key1 = nextOne + "," + nextTwo;
            if (!visited.containsKey(key1)) {
                visited.put(key1, curMoves + 1);
                if (nextOne == desiredLiters) {
                    return new Result(curMoves + 1, "one", nextTwo);
                }
                if (nextTwo == desiredLiters) {
                    return new Result(curMoves + 1, "two", nextOne);
                }
                queue.add(new int[]{nextOne, nextTwo, curMoves + 1});
            }
            
            // Action 2: Pour bucket two into bucket one
            int pourTwo = Math.min(curTwo, bucketOneCap - curOne);
            int nextOne2 = curOne + pourTwo;
            int nextTwo2 = curTwo - pourTwo;
            String key2 = nextOne2 + "," + nextTwo2;
            if (!visited.containsKey(key2)) {
                visited.put(key2, curMoves + 1);
                if (nextOne2 == desiredLiters) {
                    return new Result(curMoves + 1, "one", nextTwo2);
                }
                if (nextTwo2 == desiredLiters) {
                    return new Result(curMoves + 1, "two", nextOne2);
                }
                queue.add(new int[]{nextOne2, nextTwo2, curMoves + 1});
            }
            
            // Action 3: Empty bucket one
            int nextOne3 = 0;
            int nextTwo3 = curTwo;
            String key3 = nextOne3 + "," + nextTwo3;
            if (!visited.containsKey(key3)) {
                visited.put(key3, curMoves + 1);
                if (nextOne3 == desiredLiters) {
                    return new Result(curMoves + 1, "one", nextTwo3);
                }
                if (nextTwo3 == desiredLiters) {
                    return new Result(curMoves + 1, "two", nextOne3);
                }
                queue.add(new int[]{nextOne3, nextTwo3, curMoves + 1});
            }
            
            // Action 4: Empty bucket two
            int nextOne4 = curOne;
            int nextTwo4 = 0;
            String key4 = nextOne4 + "," + nextTwo4;
            if (!visited.containsKey(key4)) {
