I'll implement the Zebra Puzzle solver. This requires generating all possible arrangements of the puzzle's attributes and filtering by the 15 constraints.

Since the puzzle involves 5 houses with 4 attributes each (color, nationality, pet, drink, hobby), I'll use a constraint-satisfaction approach with backtracking.

zebra-puzzle.js
```
//
// This is only a SKELETON file for the 'Zebra Puzzle' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ZebraPuzzle {
  constructor() {
    this.solution = this.solve();
  }

  solve() {
    const colors = ['red', 'ivory', 'green', 'yellow', 'blue'];
    const nationalities = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese'];
    const pets = ['dog', 'snail', 'fox', 'horse', 'zebra'];
    const drinks = ['coffee', 'tea', 'milk', 'orangeJuice', 'water'];
    const hobbies = ['dancing', 'painter', 'reading', 'football', 'chess'];

    // Generate all permutations
    const permutations = this.getPermutations(colors);

    // Try each color arrangement
    for (const colorOrder of permutations) {
      // Constraint 6: green is immediately right of ivory
      const ivoryIndex = colorOrder.indexOf('ivory');
      const greenIndex = colorOrder.indexOf('green');
      if (greenIndex !== ivoryIndex + 1) continue;

      // Constraint 15: Norwegian lives next to blue
      // Constraint 10: Norwegian lives in first house
      // So blue must be house 2 (index 1)
      const blueIndex = colorOrder.indexOf('blue');
      if (blueIndex !== 1) continue;

      // Now try nationalities
      const nationalityPermutations = this.getPermutations(nationalities);
      for (const nationalityOrder of nationalityPermutations) {
        // Constraint 10: Norwegian in first house
        if (nationalityOrder[0] !== 'Norwegian') continue;

        // Constraint 2: Englishman lives in red house
        const redIndex = colorOrder.indexOf('red');
        if (nationalityOrder[redIndex] !== 'Englishman') continue;

        // Now try drinks
        const drinkPermutations = this.getPermutations(drinks);
        for (const drinkOrder of drinkPermutations) {
          // Constraint 9: middle house drinks milk
          if (drinkOrder[2] !== 'milk') continue;

          // Constraint 4: green house drinks coffee
          const greenIdx = colorOrder.indexOf('green');
          if (drinkOrder[greenIdx] !== 'coffee') continue;

          // Constraint 5: Ukrainian drinks tea
          const ukrainianIndex = nationalityOrder.indexOf('Ukrainian');
          if (drinkOrder[ukrainianIndex] !== 'tea') continue;

          // Constraint 13: football player drinks orange juice
          const orangeJuiceIndex = drinkOrder.indexOf('orangeJuice');
          if (hobbies) {
            // We'll check this later when we have hobbies
          }

          // Now try hobbies
          const hobbyPermutations = this.getPermutations(hobbies);
          for (const hobbyOrder of hobbyPermutations) {
            // Constraint 8: yellow house is painter
            const yellowIndex = colorOrder.indexOf('yellow');
            if (hobbyOrder[yellowIndex] !== 'painter') continue;

            // Constraint 7: snail owner likes dancing
            // Constraint 14: Japanese plays chess
            const japaneseIndex = nationalityOrder.indexOf('Japanese');
            if (hobbyOrder[japaneseIndex] !== 'chess') continue;

            // Constraint 13: football player drinks orange juice
            if (hobbyOrder[orangeJuiceIndex] !== 'football') continue;

            // Constraint 1: snail owner likes dancing
            // We need to check pets too
            const petPermutations = this.getPermutations(pets);
            for (const petOrder of petPermutations) {
              // Constraint 3: Spaniard owns dog
              const spaniardIndex = nationalityOrder.indexOf('Spaniard');
              if (petOrder[spaniardIndex] !== 'dog') continue;

              // Constraint 7: snail owner likes dancing
              const snailIndex = petOrder.indexOf('snail');
              if (hobbyOrder[snailIndex] !== 'dancing') continue;

              // Constraint 12: painter's house next to horse
              const painterIndex = hobbyOrder.indexOf('painter');
              const horseIndex = petOrder.indexOf('horse');
              if (Math.abs(painterIndex - horseIndex) !== 1) continue;

              // Constraint 11: reading lives next to fox
              const readingIndex = hobbyOrder.indexOf('reading');
              const foxIndex = petOrder.indexOf('fox');
              if (Math.abs(readingIndex - foxIndex) !== 1) continue;

              // All constraints satisfied - return solution
              return {
                colors: colorOrder,
                nationalities: nationalityOrder,
                pets: petOrder,
                drinks: drinkOrder,
                hobbies: hobbyOrder
              };
            }
          }
        }
      }
    }

    throw new Error('No solution found');
  }

  getPermutations(array) {
    if (array.length <= 1) {
      return [array.slice()];
    }

    const result = [];
    for (let i = 0; i < array.length; i++) {
      const rest = array.slice(0, i).concat(array.slice(i + 1));
      const restPermutations = this.getPermutations(rest);
      for (const perm of restPermutations) {
        result.push([array[i]].concat(perm));
      }
    }
    return result;
  }

  waterDrinker() {
    const waterIndex = this.solution.drinks.indexOf('water');
    return this.solution.nationalities[waterIndex];
  }

  zebraOwner() {
    const zebraIndex = this.solution.pets.indexOf('zebra');
    return this.solution.nationalities[zebraIndex];
  }
}
