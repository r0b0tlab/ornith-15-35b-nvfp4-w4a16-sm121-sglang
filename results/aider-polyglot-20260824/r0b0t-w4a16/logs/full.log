I'll implement the `ResistorColorTrio` class. Based on the test errors, the constructor takes an array of colors, and `label()` returns the resistance value with appropriate metric prefix.

resistor-color-trio.js
```
//
// This is only a SKELETON file for the 'Resistor Color Trio' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ResistorColorTrio {
  constructor(colors) {
    this.colors = colors;
  }

  label() {
    const colorValues = {
      black: 0,
      brown: 1,
      red: 2,
      orange: 3,
      yellow: 4,
      green: 5,
      blue: 6,
      violet: 7,
      grey: 8,
      white: 9,
    };

    const [first, second, third] = this.colors;

    if (colorValues[first] === undefined) {
      throw new Error('invalid color');
    }

    const mainValue = Number(`${first}${second}`);
    const zeros = colorValues[third];

    let value = mainValue * Math.pow(10, zeros);

    let unit = 'ohms';
    if (value >= 1e9) {
      value /= 1e9;
      unit = 'gigaohms';
    } else if (value >= 1e6) {
      value /= 1e6;
      unit = 'megaohms';
    } else if (value >= 1e3) {
      value /= 1e3;
      unit = 'kiloohms';
    }

    return `${value} ${unit}`;
  }
}
```
