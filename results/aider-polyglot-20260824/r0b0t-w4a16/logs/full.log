+//
+// This is only a SKELETON file for the 'Forth' exercise. It's been provided as
a
+// convenience to get you started writing code faster.
+//
+
+export class Forth {
+  constructor() {
+    this.stack = [];
+    this.definitions = new Map();
+  }
+
+  evaluate(input) {
+    const lines = String(input).split(/\r?\n/);
+    
+    for (const line of lines) {
+      this.processLine(line.trim());
+    }
+    
+    return this.stack;
+  }
+
+  processLine(line) {
+    if (line === '') {
+      return;
+    }
+    
+    const tokens = this.tokenize(line);
+    
+    if (tokens[0] === ':') {
+      this.defineWord(tokens);
+    } else {
+      this.execute(tokens);
+    }
+  }
+
+  tokenize(line) {
+    const tokens = [];
+    const regex = /(\d+)|(\S+)/g;
+    let match;
+    
+    while ((match = regex.exec(line)) !== null) {
+      tokens.push(match[1] ? match[1] : match[2]);
+    }
+    
+    return tokens;
+  }
+
+  defineWord(tokens) {
+    if (tokens.length < 4 || tokens[3] !== ';') {
+      throw new Error('Invalid definition');
+    }
+    
+    const name = tokens[1].toLowerCase();
+    const body = tokens.slice(2, -1);
+    
+    this.definitions.set(name, body);
+  }
+
+  execute(tokens) {
+    for (let i = 0; i < tokens.length; i++) {
+      const token = tokens[i].toLowerCase();
+      
+      if (this.definitions.has(token)) {
+        this.execute(this.definitions.get(token));
+      } else {
+        this.handleToken(token);
+      }
+    }
+  }
+
+  handleToken(token) {
+    switch (token) {
+      case '+':
+        this.arithmetic((a, b) => a + b);
+        break;
+      case '-':
+        this.arithmetic((a, b) => a - b);
+        break;
+      case '*':
+        this.arithmetic((a, b) => a * b);
+        break;
+      case '/':
+        this.arithmetic((a, b) => {
+          if (b === 0) {
+            throw new Error('divide by zero');
+          }
+          return Math.trunc(a / b);
+        });
+        break;
+      case 'dup':
+        this.dup();
+        break;
+      case 'drop':
+        this.drop();
+        break;
+      case 'swap':
+        this.swap();
+        break;
+      case 'over':
+        this.over();
+        break;
+      default:
+        if (/^-?\d+$/.test(token)) {
+          this.stack.push(parseInt(token, 10));
+        } else {
+          throw new Error(`Unknown word: ${token}`);
+        }
+    }
+  }
+
+  arithmetic(op) {
+    if (this.stack.length < 2) {
+      throw new Error('stack empty');
+    }
+    
+    const b = this.stack.pop();
+    const a = this.stack.pop();
+    
+    this.stack.push(op(a, b));
+  }
+
+  dup() {
+    if (this.stack.length < 1) {
+      throw new Error('stack empty');
+    }
+    
+    const a = this.stack[this.stack.length - 1];
+    this.stack.push(a);
+  }
+
+  drop() {
+    if (this.stack.length < 1) {
+      throw new Error('stack empty');
+    }
+    
+    this.stack.pop();
+  }
+
+  swap() {
+    if (this.stack.length < 2) {
+      throw new Error('stack empty');
+    }
+    
+    const a = this.stack.pop();
+    const b = this.stack.pop();
+    const c = this.stack.pop();
+    
+    this.stack.push(a);
+    this.stack.push(b);
+    this.stack.push(c);
+  }
+
+  over() {
+    if (this.stack.length < 2) {
+      throw new Error('stack empty');
+    }
+    
+    const b = this.stack.pop();
