```python
from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def from_pov(self, from_node):
        """Reorient the tree so that from_node becomes the root."""
        path = self._find_path(from_node)
        if path is None:
            raise ValueError("Tree could not be reoriented")
        
        # Create a map from label to node for easy lookup
        node_map = {}
        self._build_node_map(self, node_map)
        
        # Create a deep copy of the entire tree
        new_root = self._copy_tree(self)
        node_map = {}
        self._build_node_map(new_root, node_map)
        
        # For each node in the path (except the last), remove it from its parent
        # and make it a child of the next node down
        for i in range(len(path) - 1):
            current_label = path[i]
            next_label = path[i + 1]
            
            current_node = node_map[current_label]
            next_node = node_map[next_label]
            
            # Remove next_label from current_label's children
            current_node.children = [
                c for c in current_node.children 
                if c.label != next_label
            ]
            
            # Add current_label as a child of next_label
            next_node.children.append(current_node)
        
        return new_root

    def _find_path(self, from_node):
        """Find the path from root to the target node."""
        from collections import deque
        queue = deque([(self, [self.label])])
        
        while queue:
            node, path = queue.popleft()
            if node.label == from_node:
                return path
            for child in node.children:
                queue.append((child, path + [child.label]))
        return None

    def _build_node_map(self, node, node_map):
        """Build a map from label to node for the tree."""
        node_map[node.label] = node
        for child in node.children:
            self._build_node_map(child, node_map)

    def _copy_tree(self, node):
        """Create a deep copy of a tree."""
        new_node = Tree(node.label)
        for child in node.children:
            new_node.children.append(self._copy_tree(child))
        return new_node

    def path_to(self, from_node, to_node):
        """Find the path from from_node to to_node."""
        from_path = self._find_path(from_node)
        if from_path is None:
            raise ValueError("Tree could not be reoriented")
        
        to_path = self._find_path(to_node)
        if to_path is None:
            raise ValueError("Tree could not be reoriented")
        
        # Find the lowest common ancestor
        lca_index = 0
        for i in range(min(len(from_path), len(to_path))):
            if from_path[i] == to_path[i]:
                lca_index = i
            else:
                break
        
        # Path from from_node to lca
        path_from = from_path[:lca_index+1][::-1]
        # Path from lca to to_node
        path_to = to_path[lca_index+1:]
        
        # Combine
        return path_from + path_to
```
