kindergarten_garden.h
```cpp
#pragma once

#include <string>
#include <vector>
#include <map>

namespace kindergarten_garden {

enum class Plant {
    Grass,
    Clover,
    Radish,
    Violet
};

class Garden {
public:
    Garden(std::string diagram) : garden(diagram) {}
    Garden(std::string diagram, std::vector<std::string> students)
        : garden(diagram), students(students) {}
    
    std::vector<std::string> plants(std::string student);

private:
    std::string garden;
    std::vector<std::string> students;
};

}  // namespace kindergarten_garden
```

kindergarten_garden.cpp
```cpp
#include "kindergarten_garden.h"
#include <algorithm>

namespace kindergarten_garden {

static const std::map<char, std::string> plant_codes = {
    {'G', "Grass"},
    {'C', "Clover"},
    {'R', "Radish"},
    {'V', "Violet"}
};

std::vector<std::string> Garden::plants(std::string student) {
    // Split the diagram into two rows
    size_t newline_pos = garden.find('\n');
    std::string row1 = garden.substr(0, newline_pos);
    std::string row2 = garden.substr(newline_pos + 1);
    
    // Find the student's position in the alphabetical list
    auto it = std::find(students.begin(), students.end(), student);
    if (it == students.end()) {
        return {};  // Student not found
    }
    
    int index = std::distance(students.begin(), it);
    
    // Each student gets 2 cups per row
    int start_col = index * 2;
    
    std::vector<std::string> result;
    
    // First row plants
    if (start_col < static_cast<int>(row1.length())) {
        result.push_back(plant_codes.at(row1[start_col]));
    }
    if (start_col + 1 < static_cast<int>(row1.length())) {
        result.push_back(plant_codes.at(row1[start_col + 1]));
    }
    
    // Second row plants
    if (start_col < static_cast<int>(row2.length())) {
        result.push_back(plant_codes.at(row2[start_col]));
    }
    if (start_col + 1 < static_cast<int>(row2.length())) {
        result.push_back(plant_codes.at(row2[start_col + 1]));
    }
    
    return result;
}

}  // namespace kindergarten_garden
```
