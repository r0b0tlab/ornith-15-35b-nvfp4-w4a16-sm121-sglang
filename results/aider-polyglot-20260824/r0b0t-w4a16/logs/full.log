Ok, I'll implement the `Build` function to reconstruct the tree from the records.

tree_building.go
```go
package tree

import "errors"

type Record struct {
	ID     int
	Parent int
}

type Node struct {
	ID       int
	Children []*Node
}

func Build(records []Record) (*Node, error) {
	// Handle empty input
	if len(records) == 0 {
		return nil, nil
	}

	// Create a slice to hold nodes by ID
	nodes := make([]*Node, len(records))

	// Track the root
	var rootNode *Node

	for _, record := range records {
		// Validate ID range
		if record.ID < 0 || record.ID >= len(records) {
			return nil, errors.New("invalid ID")
		}

		// Check for duplicate IDs
		if nodes[record.ID] != nil {
			return nil, errors.New("duplicate ID")
		}

		// Create the node
		node := &Node{ID: record.ID}
		nodes[record.ID] = node

		// Detect the root (parent ID equals its own ID)
		if record.ID == record.Parent {
			rootNode = node
		} else {
			// Parent ID must be lower than the ID
			if record.Parent >= record.ID {
				return nil, errors.New("parent ID must be lower than the ID")
			}
		}
	}

	// Ensure we have a root
	if rootNode == nil {
		return nil, errors.New("no root found")
	}

	// Second pass to link children to parents
	for _, record := range records {
		if record.ID == record.Parent {
			continue
		}
		parent := nodes[record.Parent]
		if parent == nil {
			return nil, errors.New("parent not found")
		}
		parent.Children = append(parent.Children, nodes[record.ID])
	}

	return rootNode, nil
}
```
