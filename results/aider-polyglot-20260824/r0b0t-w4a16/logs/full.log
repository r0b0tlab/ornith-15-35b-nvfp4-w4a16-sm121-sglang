```
package twobucket

import "errors"

type state struct {
	bucket1 int
	bucket2 int
}

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {
	// Validate inputs
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 {
		return "", 0, 0, errors.New("bucket sizes must be positive")
	}
	if goalAmount < 0 || goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount cannot be achieved")
	}

	// Track visited states to avoid infinite loops
	visited := make(map[[2]bool]struct{})

	// Initialize based on start bucket
	var startState state
	switch startBucket {
	case "one":
		startState = state{0, 0}
	case "two":
		startState = state{0, 0}
	default:
		return "", 0, 0, errors.New("invalid start bucket")
	}

	// Start by filling the first bucket
	if startBucket == "one" {
		queue := []state{state{sizeBucketOne, 0}}
		steps := 1

		// BFS
		for len(queue) > 0 {
			steps++
			size := len(queue)
			for i := 0; i < size; i++ {
				current := queue[0]
				queue = queue[1:]

				// Check if we've reached the goal
				if current.bucket1 == goalAmount {
					return "one", steps, current.bucket2, nil
				}
				if current.bucket2 == goalAmount {
					return "two", steps, current.bucket1, nil
				}

				// Generate next states
				nextStates := generateNextStates(current, sizeBucketOne, sizeBucketTwo)

				for _, next := range nextStates {
					// Check the forbidden state rule
					if isForbiddenState(next, startBucket) {
						continue
					}

					// Check if visited
					stateKey := [2]bool{next.bucket1 == sizeBucketOne, next.bucket2 == sizeBucketTwo}
					if _, exists := visited[stateKey]; exists {
						continue
					}

					// Mark as visited
					visited[stateKey] = struct{}{}

					// Add to queue
					queue = append(queue, next)
				}
			}
			queue = queue[size:]
		}

		return "", 0, 0, errors.New("no solution found")
	} else {
		queue := []state{state{0, sizeBucketTwo}}
		steps := 1

		// BFS
		for len(queue) > 0 {
			steps++
			size := len(queue)
			for i := 0; i < size; i++ {
				current := queue[0]
				queue = queue[1:]

				// Check if we've reached the goal
				if current.bucket1 == goalAmount {
					return "one", steps, current.bucket2, nil
				}
				if current.bucket2 == goalAmount {
					return "two", steps, current.bucket1, nil
				}

				// Generate next states
				nextStates := generateNextStates(current, sizeBucketOne, sizeBucketTwo)

				for _, next := range nextStates {
					// Check the forbidden state rule
					if isForbiddenState(next, startBucket) {
						continue
					}

					// Check if visited
					stateKey := [2]bool{next.bucket1 == sizeBucketOne, next.bucket2 == sizeBucketTwo}
					if _, exists := visited[stateKey]; exists {
						continue
					}

					// Mark as visited
					visited[stateKey] = struct{}{}

					// Add to queue
					queue = append(queue, next)
				}
			}
			queue = queue[size:]
		}

		return "", 0, 0, errors.New("no solution found")
	}
}

func generateNextStates(current state, sizeOne, sizeTwo int) []state {
	var next []state

	// Possible next states
	next = append(next, state{sizeOne, current.bucket2}) // Fill bucket 1
	next = append(next, state{current.bucket1, sizeTwo}) // Fill bucket 2
	next = append(next, state{0, current.bucket2})      // Empty bucket 1
	next = append(next, state{current.bucket1, 0})      // Empty bucket 2

	// Pour bucket 1 into bucket 2
	pourAmount := min(current.bucket1, sizeTwo-current.bucket2)
	next = append(next, state{current.bucket1-pourAmount, current.bucket2+pourAmount})

	// Pour bucket 2 into bucket 1
	pourAmount = min(current.bucket2, sizeOne-current.bucket1)
	next = append(next, state{current.bucket1+pourAmount, current.bucket2-pourAmount})

	return next
}

func isForbiddenState(state state, startBucket string) bool {
	// Forbidden: start bucket empty and other full
	if startBucket == "one" {
		return state.bucket1 == 0 && state.bucket2 == sizeBucketTwo
	}
	return state.bucket2 == 0 && state.bucket1 == sizeBucketOne
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

```
