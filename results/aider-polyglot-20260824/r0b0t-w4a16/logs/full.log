 class StackUnderflowError(Exception):
-    pass
+    """Custom exception for stack operations when there aren't enough items."""
+
+    def __init__(self, message="Insufficient number of items in stack"):
+        super().__init__(message)
 
 
 def evaluate(input_data):
-    pass
+    """Evaluate a sequence of Forth commands and return the resulting stack."""
+    stack = []
+    custom_words = {}
+
+    for line in input_data:
+        tokens = line.split()
+        i = 0
+
+        while i < len(tokens):
+            token = tokens[i].lower()
+
+            # Handle word definition
+            if token == ":" and i + 1 < len(tokens) and tokens[i + 1] != ";":
+                word_name = tokens[i + 1].lower()
+
+                # Validate word name is not a number
+                if _is_number(word_name):
+                    raise ValueError("invalid definition")
+
+                # Parse definition until ';'
+                definition = []
+                i += 2
+
+                while i < len(tokens) and tokens[i].lower() != ";":
+                    definition.append(tokens[i])
+                    i += 1
+
+                if i >= len(tokens):
+                    raise ValueError("invalid definition")
+
+                # Expand custom words in definition
+                expanded_definition = []
+                for def_token in definition:
+                    expanded_definition.extend(
+                        _expand_word(def_token, custom_words))
+
+                custom_words[word_name] = expanded_definition
+                i += 1  # Skip past ';'
+                continue
+
+            # Process regular tokens
+            if _is_number(token):
+                stack.append(int(token))
+            elif token in ('+', '-', '*', '/'):
+                _handle_arithmetic(token, stack)
+            elif token == 'dup':
+                _handle_dup(stack)
+            elif token == 'drop':
+                _handle_drop(stack)
+            elif token == 'swap':
+                _handle_swap(stack)
+            elif token == 'over':
+                _handle_over(stack)
+            elif token in custom_words:
+                stack.extend(custom_words[token])
+            else:
+                raise ValueError("undefined operation")
+
+            i += 1
+
+    return stack
+
+
+def _is_number(token):
+    """Check if a token is a number."""
+    try:
+        int(token)
+        return True
+    except ValueError:
+        return False
+
+
+def _handle_arithmetic(token, stack):
+    """Handle arithmetic operations."""
+    if len(stack) < 2:
+        raise StackUnderflowError()
+
+    b = stack.pop()
+    a = stack.pop()
+
+    if token == '+':
+        stack.append(a + b)
+    elif token == '-':
+        stack.append(a - b)
+    elif token == '*':
+        stack.append(a * b)
+    elif token == '/':
+        if b == 0:
+            raise ZeroDivisionError("divide by zero")
+        # Integer division truncating toward zero
+        stack.append(int(a / b))
+
+
+def _handle_dup(stack):
+    """Handle DUP operation."""
+    if len(stack) < 1:
+        raise StackUnderflowError()
+    stack.append(stack[-1])
+
+
+def _handle_drop(stack):
+    """Handle DROP operation."""
+    if len(stack) < 1:
+        raise StackUnderflowError()
+    stack.pop()
+
+
+def _handle_swap(stack):
+    """Handle SWAP operation."""
+    if len(stack) < 2:
+        raise StackUnderflowError()
+    stack[-1], stack[-2] = stack[-2], stack[-1]
+
+
+def _handle_over(stack):
+    """Handle OVER operation."""
+    if len(stack) < 2:
+        raise StackUnderflowError()
+    stack.append(stack[-2])
+
+
+def _expand_word(token, custom_words):
+    """Expand a custom word into its definition."""
+    if token in custom_words:
+        return custom_words[token]
+    return [token]
```



The key fixes:

1. **`evaluate` now returns the stack** (previously it just did `pass`)

2. **Proper error handling** with `StackUnderflowError` and `ZeroDivisionError`

3. **Custom word expansion** happens at definition time, capturing the current 
state of all other words

4. **Case insensitivity** handled by lowercasing tokens

5. **Integer division** uses `int(a / b)` for truncation toward zero



The implementation should now pass all the tests.

