import java.util.*;

class Connect {

    private final String[] board;
    private final int rows;
    private final int[] cols;

    public Connect(String[] board) {
        this.board = board;
        this.rows = board.length;
        this.cols = new int[rows];
        for (int i = 0; i < rows; i++) {
            cols[i] = board[i].replaceFirst("^\\s*", "").length();
        }
    }

    public Winner computeWinner() {
        // Check for O winning (top to bottom)
        if (checkWin('O')) {
            return Winner.O;
        }
        // Check for X winning (left to right)
        if (checkWin('X')) {
            return Winner.X;
        }
        return Winner.NONE;
    }

    private boolean checkWin(char player) {
        // For O: connect top row to bottom row
        // For X: connect left column to right column
        if (player == 'O') {
            return winO();
        } else {
            return winX();
        }
    }

    // Player O connects top side to bottom side
    private boolean winO() {
        Queue<int[]> queue = new LinkedList<>();
        boolean[][] visited = new boolean[rows][];
        for (int i = 0; i < rows; i++) {
            visited[i] = new boolean[cols[i]];
        }
        // Start from all O in the top row
        for (int col = 0; col < cols[0]; col++) {
            if (get(0, col) == 'O') {
                queue.add(new int[]{0, col});
                visited[0][col] = true;
            }
        }
        while (!queue.isEmpty()) {
            int[] cur = queue.poll();
            int r = cur[0], c = cur[1];
            if (r == rows - 1) {
                return true;
            }
            for (int[] nb: neighbors(r, c)) {
                int nr = nb[0], nc = nb[1];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < cols[nr] && !visited[nr][nc] && get(nr, nc) == 'O') {
                    visited[nr][nc] = true;
                    queue.add(new int[]{nr, nc});
                }
            }
        }
        return false;
    }

    // Player X connects left column to right column
    private boolean winX() {
        Queue<int[]> queue = new LinkedList<>();
        boolean[][] visited = new boolean[rows][];
        for (int i = 0; i < rows; i++) {
            visited[i] = new boolean[cols[i]];
        }
        // Start from all X in the left column
        for (int row = 0; row < rows; row++) {
            if (cols[row] > 0 && get(row, 0) == 'X') {
                queue.add(new int[]{row, 0});
                visited[row][0] = true;
            }
        }
        while (!queue.isEmpty()) {
            int[] cur = queue.poll();
            int r = cur[0], c = cur[1];
            if (c == cols[r] - 1) {
                return true;
            }
            for (int[] nb: neighbors(r, c)) {
                int nr = nb[0], nc = nb[1];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < cols[nr] && !visited[nr][nc] && get(nr, nc) == 'X') {
                    visited[nr][nc] = true;
                    queue.add(new int[]{nr, nc});
                }
            }
        }
        return false;
    }

    private char get(int r, int c) {
        if (r < 0 || r >= rows || c < 0 || c >= cols[r]) {
            return ' ';
        }
        String line = board[r].replaceFirst("^\\s*", "");
        if (c < line.length()) {
            return line.charAt(c);
        }
        return ' ';
    }

    // Get hex neighbors. Board is offset so that row r is shifted right by r spaces.
    private int[][] neighbors(int r, int c) {
        // For a hex board where each row is indented, the neighbors of (r, c) are:
        // (r-1, c), (r-1, c+1), (r, c-1), (r, c+1), (r+1, c), (r+1, c+1)
        return new int[][]{
            {r - 1, c}, {r - 1, c + 1},
