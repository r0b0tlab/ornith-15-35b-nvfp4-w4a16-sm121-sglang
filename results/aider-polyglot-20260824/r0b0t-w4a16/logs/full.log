			for j := 0; j < len(puzzle[i]); j++ {
				// Check if the first letter matches
				if puzzle[i][j] != byte(word[0]) {
					continue
				}

				// Try each direction
				for _, dir := range directions {
					// Check if the word fits in this direction
					lastI := i + dir[0]*(len(word)-1)
					lastJ := j + dir[1]*(len(word)-1)

					// Check bounds
					if lastI < 0 || lastI >= len(puzzle) || lastJ < 0 || lastJ >= len(puzzle[lastI]) {
						continue
					}

					// Verify the word matches in this direction
					match := true
					for k := 0; k < len(word); k++ {
						curI := i + dir[0]*k
						curJ := j + dir[1]*k
						if puzzle[curI][curJ] != byte(word[k]) {
							match = false
							break
						}
					}

					if match {
						result[word] = [2][2]int{{i, j}, {lastI, lastJ}}
						found = true
						break
					}
				}

				if found {
					break
				}
			}
		}

		if !found {
			return result, fmt.Errorf("word %q not found in puzzle", word)
		}
	}

	return result, nil
}
