ledger.js
```js
class LedgerEntry {
  constructor() {
    this.date = undefined;
    this.description = undefined;
    this.change = undefined;
  }
}

function formatChange(change, currency, locale) {
  const absValue = Math.abs(change) / 100;

  if (locale === 'en-US') {
    const options = {
      style: 'currency',
      currency: currency,
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    };
    const formatted = absValue.toLocaleString('en-US', options);
    return change < 0 ? `(${formatted})` : `${formatted} `;
  } else if (locale === 'nl-NL') {
    const options = {
      style: 'currency',
      currency: currency,
      currencyDisplay: 'narrowSymbol',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    };
    const sign = change < 0 ? '-' : '';
    const formatted = absValue.toLocaleString('nl-NL', options);
    return `${sign}${formatted} `;
  }
  return '';
}

function formatDate(date, locale) {
  if (locale === 'en-US') {
    return `${(date.getMonth() + 1)
      .toString()
      .padStart(2, '0')}/${date.getDate().toString().padStart(2, '0')}/${date.getFullYear()}`;
  } else if (locale === 'nl-NL') {
    return `${date.getDate().toString().padStart(2, '0')}-${(date.getMonth() + 1)
      .toString()
      .padStart(2, '0')}-${date.getFullYear()}`;
  }
  return '';
}

function formatDescription(description) {
  return description.length > 25
    ? `${description.substring(0, 22)}...`
    : description.padEnd(25, ' ');
}

export function createEntry(date, description, change) {
  let entry = new LedgerEntry();
  entry.date = new Date(date);
  entry.description = description;
  entry.change = change;
  return entry;
}

export function formatEntries(currency, locale, entries) {
  // Sort entries by date, then change, then description
  const sortedEntries = [...entries].sort(
    (a, b) =>
      a.date - b.date ||
      a.change - b.change ||
      a.description.localeCompare(b.description),
  );

  let table = '';

  if (locale === 'en-US') {
    // Generate Header Row
    table +=
      'Date'.padEnd(10, ' ') +
      ' | ' +
      'Description'.padEnd(25, ' ') +
      ' | ' +
      'Change'.padEnd(13, ' ') +
      '\n';

    // Write each entry
    sortedEntries.forEach((entry) => {
      const dateStr = formatDate(entry.date, locale);
      const descStr = formatDescription(entry.description);
      const changeStr = formatChange(entry.change, currency, locale).padStart(13, ' ');
      table += `${dateStr} | ${descStr} | ${changeStr}\n`;
    });
  } else if (locale === 'nl-NL') {
    // Generate Header Row
    table +=
      'Datum'.padEnd(10, ' ') +
      ' | ' +
      'Omschrijving'.padEnd(25, ' ') +
      ' | ' +
      'Verandering'.padEnd(13, ' ') +
      '\n';

    // Write each entry
    sortedEntries.forEach((entry) => {
      const dateStr = formatDate(entry.date, locale);
      const descStr = formatDescription(entry.description);
      const changeStr = formatChange(entry.change, currency, locale).padStart(13, ' ');
      table += `${dateStr} | ${descStr} | ${changeStr}\n`;
    });
  }

  return table.replace(/\n$/, '');
}
```

