```java
class SimpleLinkedList<T> {
    private static class Node<T> {
        private T value;
        private Node<T> next;

        Node(T value) {
            this.value = value;
        }
    }

    private Node<T> head;
    private int size;

    SimpleLinkedList() {
        head = null;
        size = 0;
    }

    SimpleLinkedList(T[] values) {
        head = null;
        size = 0;
        for (T value : values) {
            push(value);
        }
    }

    void push(T value) {
        Node<T> node = new Node<T>(value);
        node.next = head;
        head = node;
        size++;
    }

    T pop() {
        if (head == null) {
            throw new IllegalStateException("List is empty");
        }
        T value = head.value;
        head = head.next;
        size--;
        return value;
    }

    void reverse() {
        Node<T> previous = null;
        Node<T> current = head;
        while (current != null) {
            Node<T> next = current.next;
            current.next = previous;
            previous = current;
            current = next;
        }
        head = previous;
    }

    T[] asArray(Class<T> clazz) {
        T[] array = clazz.cast(java.lang.reflect.Array.newInstance(clazz, size));
        Node<T>[] nodes = new Node[size];
        Node<T> current = head;
        for (int i = size - 1; i >= 0; i--) {
            nodes[i] = current;
            current = current.next;
        }
        for (int i = 0; i < size; i++) {
            array[i] = nodes[i].value;
        }
        return array;
    }

    int size() {
        return size;
    }
}
```

