    result.reverse();
    
    while result.len() > 1 && result[0] == 0 {
        result.remove(0);
    }
    
    (result, max_scale)
}

fn mul_magnitude(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut result = vec![0u8; a.len() + b.len()];
    for i in (0..a.len()).rev() {
        let mut carry = 0;
        for j in (0..b.len()).rev() {
            let idx = i + j + 1;
            let prod = a[i] as u32 * b[j] as u32 + result[idx] as u32 + carry as u32;
            result[idx] = (prod % 10) as u8;
            carry = prod / 10;
        }
        result[i] += carry as u8;
    }
    
    let mut start = 0;
    while start < result.len() - 1 && result[start] == 0 {
        start += 1;
    }
    result.drain(0..start).collect()
}
```

