fn number_below_100(n: u64) -> String {
    let below_20 = [
        "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
        "eleven", "twelve", "thirteen", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen",
        "nineteen",
    ];
    let tens = ["", "ten", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];

    if n < 20 {
        return below_20[n as usize].to_string();
    }

    let (t, o) = (n / 10, n % 10);
    if o == 0 {
        return tens[t as usize].to_string();
    }

    format!("{}-{}", tens[t as usize], below_20[o as usize])
}

fn number_below_1000(n: u64) -> Vec<String> {
    let mut result: Vec<String> = Vec::new();

    if n >= 100 {
        result.push(below_1000_single_digit(n / 100).to_string());
        result.push("hundred".to_string());
    }

    let remainder = n % 100;
    if remainder > 0 {
        if remainder < 20 {
            result.push(below_1000_single_digit(remainder).to_string());
        } else {
            let (t, o) = (remainder / 10, remainder % 10);
            if o == 0 {
                result.push(tens_word(t as usize).to_string());
            } else {
                result.push(format!(
                    "{}-{}",
                    tens_word(t as usize),
                    below_1000_single_digit(o as usize)
                ));
            }
        }
    }

    result
}

fn below_1000_single_digit(n: u64) -> &'static str {
    match n {
        1 => "one",
        2 => "two",
        3 => "three",
        4 => "four",
        5 => "five",
        6 => "six",
        7 => "seven",
        8 => "eight",
        9 => "nine",
        _ => "",
    }
}

fn tens_word(n: usize) -> &'static str {
    match n {
        1 => "ten",
        2 => "twenty",
        3 => "thirty",
        4 => "forty",
        5 => "fifty",
        6 => "sixty",
        7 => "seventy",
        8 => "eighty",
        9 => "ninety",
        _ => "",
    }
}

fn number_to_words_below_1000(n: u64) -> String {
    let chunks = number_below_1000(n);
    chunks.join(" ")
}

pub fn encode(n: u64) -> String {
    if n == 0 {
        return "zero".to_string();
    }

    let scale_words = [
        "",
        "thousand",
        "million",
        "billion",
        "trillion",
    ];

    let mut chunks: Vec<u64> = Vec::new();
    let mut temp = n;
    while temp > 0 {
        chunks.push(temp % 1000);
        temp /= 1000;
    }

    let mut parts: Vec<String> = Vec::new();
    for (i, chunk) in chunks.iter().enumerate().rev() {
        if *chunk == 0 {
            continue;
        }

        let chunk_words = number_to_words_below_1000(*chunk);
        let scale = scale_words.get(i).copied().unwrap_or("");

        if !scale.is_empty() {
            parts.push(format!("{} {}", chunk_words, scale));
        } else {
            parts.push(chunk_words);
        }
    }

    parts.join(" ")
}
```

