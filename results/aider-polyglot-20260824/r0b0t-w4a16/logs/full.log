response:
I'll refactor the `format` method to be cleaner and more maintainable while keeping the same behavior. I'll use `java.time.format.DateTimeFormatter`, `java.math.RoundingMode`, and `java.util.Comparator` for clarity.

The key changes:
1. Use `DateTimeFormatter.ofPattern()` stored in a variable
2. Use a `TreeMap` to sort entries by date (both negative and positive grouped correctly)
3. Extract the amount formatting into a helper method
4. Use `BigDecimal` for precise currency formatting
5. Handle currency, locale, and sign consistently

Ledger.java
```java
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.TreeMap;
import java.util.Comparator;

public class Ledger {
    private static final DateTimeFormatter US_FORMAT = DateTimeFormatter.ofPattern("MM/dd/yyyy");
    private static final DateTimeFormatter NL_FORMAT = DateTimeFormatter.ofPattern("dd/MM/yyyy");

    public LedgerEntry createLedgerEntry(String d, String desc, int c) {
        LedgerEntry le = new LedgerEntry();
        le.setChange(c);
        le.setDescription(desc);
        le.setLocalDate(LocalDate.parse(d));
        return le;
    }

    public String format(String cur, String loc, LedgerEntry[] entries) {
        if (!cur.equals("USD") && !cur.equals("EUR")) {
            throw new IllegalArgumentException("Invalid currency");
        }
        if (!loc.equals("en-US") && !loc.equals("nl-NL")) {
            throw new IllegalArgumentException("Invalid locale");
        }

        String header = buildHeader(loc);
        StringBuilder s = new StringBuilder();
        s.append(header);

        Comparator<LedgerEntry> byDate = Comparator.comparing(LedgerEntry::getLocalDate);
        TreeMap<LedgerEntry, Boolean> sorted = new TreeMap<>(byDate);
        for (LedgerEntry entry : entries) {
            sorted.put(entry, Boolean.FALSE);
        }

        char currencySymbol = cur.equals("USD") ? '$' : '€';
        boolean isNLLocale = loc.equals("nl-NL");
        String decimalSeparator = isNLLocale ? "," : ".";
        String thousandsSeparator = isNLLocale ? "." : ",";

        for (LedgerEntry entry : sorted.keySet()) {
            s.append("\n");
            s.append(formatRow(entry, US_FORMAT, NL_FORMAT, currencySymbol, isNLLocale, decimalSeparator, thousandsSeparator));
        }

        return s.toString();
    }

    private String buildHeader(String loc) {
        if (loc.equals("en-US")) {
            return "Date       | Description               | Change       ";
        }
        return "Datum      | Omschrijving              | Verandering  ";
    }

    private String formatRow(LedgerEntry entry, DateTimeFormatter usFormat, DateTimeFormatter nlFormat,
                             char currencySymbol, boolean isNLLocale, String decimalSeparator,
                             String thousandsSeparator) {
        String date = entry.getLocalDate().format(isNLLocale ? nlFormat : usFormat);
        String description = formatDescription(entry.getDescription());
        String change = formatChange(entry.getChange(), currencySymbol, isNLLocale, decimalSeparator, thousandsSeparator);
        return String.format("%s | %-25s | %13s", date, description, change);
    }

    private String formatDescription(String desc) {
        if (desc.length() > 25) {
            return desc.substring(0, 22) + "...";
        }
        return desc;
    }

    private String formatChange(int change, char currencySymbol, boolean isNLLocale,
                                String decimalSeparator, String thousandsSeparator) {
        BigDecimal amount = BigDecimal.valueOf(change).divide(BigDecimal.valueOf(100))
                .setScale(2, RoundingMode.HALF_UP);
        boolean negative = amount.signum() < 0;
        BigDecimal magnitude = negative ? amount.negate() : amount;

        String symbol = currencySymbol + " ";
        String formattedAmount = formatAmount(magnitude, thousandsSeparator);

        if (isNLLocale) {
            String prefix = negative ? "- " : "";
            return symbol + prefix + formattedAmount + decimalSeparator + fractionPart(magnitude);
        } else {
            if (negative) {
                return symbol + "(" + formattedAmount + decimalSeparator + fractionPart(magnitude) + ")";
            }
            return symbol + formattedAmount + decimalSeparator + fractionPart(magnitude);
        }
    }

    private String fractionPart(BigDecimal magnitude) {
        String[] parts = magnitude.stripTrailingZeros().toPlainString().split("\\.");
        if (parts.length < 2) {
            return "00";
        }
        return parts[1];
    }

    private String formatAmount(BigDecimal magnitude, String thousandsSeparator) {
        String intPart = magnitude.stripTrailingZeros().toPlainString().split("\\.")[0];
        StringBuilder result = new StringBuilder();
        int count = 0;
        for (int i = intPart.length() - 1; i >= 0; i--) {
            if (count > 0 && count % 3 == 0) {
                result.insert(0, thousandsSeparator);
            }
            result.insert(0, intPart.charAt(i));
            count++;
        }
        return result.toString();
    }

    public static class LedgerEntry {
        LocalDate localDate;
        String description;
        double change;

        public LocalDate getLocalDate() {
            return localDate;
        }

        public void setLocalDate(LocalDate localDate) {
            this.localDate = localDate;
        }

        public String getDescription() {
            return description;
        }

        public void setDescription(String description) {
            this.description = description;
        }

        public double getChange() {
            return change;
        }

        public void setChange(double change) {
            this.change = change;
        }
    }
}
```
