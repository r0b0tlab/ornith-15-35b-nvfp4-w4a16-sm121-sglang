```java
import java.awt.Point;
import java.util.Map;
import java.util.Set;
import java.util.HashMap;
import java.util.HashSet;
import java.util.EnumMap;
import java.util.Arrays;

class GoCounting {

    private final char[][] board;
    private final int height;
    private final int width;

    GoCounting(String board) {
        String[] rows = board.split("\n");
        this.height = rows.length;
        this.width = height > 0 ? rows[0].length() : 0;
        this.board = new char[height][];
        for (int i = 0; i < height; i++) {
            this.board[i] = rows[i].toCharArray();
        }
    }

    Player getTerritoryOwner(int x, int y) {
        validateCoordinate(x, y);
        if (board[y][x] != ' ') {
            return null;
        }
        Set<Point> territory = getTerritory(x, y);
        if (territory.isEmpty()) {
            return null;
        }
        return determineOwner(territory);
    }

    Set<Point> getTerritory(int x, int y) {
        validateCoordinate(x, y);
        if (board[y][x] != ' ') {
            return new HashSet<>();
        }
        return floodFill(x, y);
    }

    Map<Player, Set<Point>> getTerritories() {
        Map<Player, Set<Point>> territories = new EnumMap<>(Player.class);
        territories.put(Player.BLACK, new HashSet<>());
        territories.put(Player.WHITE, new HashSet<>());
        territories.put(Player.NONE, new HashSet<>());

        boolean[][] visited = new boolean[height][width];

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                if (board[y][x] == ' ' && !visited[y][x]) {
                    Set<Point> territory = floodFill(x, y);
                    for (Point p : territory) {
                        visited[p.y][p.x] = true;
                    }
                    Player owner = determineOwner(territory);
                    territories.get(owner).addAll(territory);
                }
            }
        }

        return territories;
    }

    private Player determineOwner(Set<Point> territory) {
        Player blackBorder = null;
        Player whiteBorder = null;

        for (Point p : territory) {
            int x = p.x;
            int y = p.y;

            int[][] directions = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};
            for (int[] dir : directions) {
                int nx = x + dir[0];
                int ny = y + dir[1];

                if (isValid(nx, ny)) {
                    char c = board[ny][nx];
                    if (c == 'B') {
                        blackBorder = Player.BLACK;
                    } else if (c == 'W') {
                        whiteBorder = Player.WHITE;
                    }
                }
            }
        }

        if (blackBorder != null && whiteBorder != null) {
            return Player.NONE;
        } else if (blackBorder != null) {
            return Player.BLACK;
        } else if (whiteBorder != null) {
            return Player.WHITE;
        }
        return Player.NONE;
    }

    private Set<Point> floodFill(int x, int y) {
        Set<Point> territory = new HashSet<>();
        java.util.Deque<Point> stack = new java.util.ArrayDeque<>();
        stack.add(new Point(x, y));

        while (!stack.isEmpty()) {
            Point p = stack.poll();
            int cx = p.x;
            int cy = p.y;

            if (!isValid(cx, cy)) {
                continue;
            }
            if (board[cy][cx] != ' ') {
                continue;
            }
            if (territory.contains(p)) {
                continue;
            }

            territory.add(p);

            int[][] directions = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};
            for (int[] dir : directions) {
                int nx = cx + dir[0];
                int ny = cy + dir[1];
                stack.add(new Point(nx, ny));
            }
        }

        return territory;
    }

    private boolean isValid(int x, int y) {
        return x >= 0 && x < width && y >= 0 && y < height;
    }

    private void validateCoordinate(int x, int y) {
        if (x < 0 || x >= width || y < 0 || y >= height) {
            throw new IllegalArgumentException("Invalid coordinate");
        }
    }
}
