    private static final String[] COLORS = {"red", "green", "ivory", "yellow", "blue"};
    private static final String[] NATIONALITIES = {"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"};
    private static final String[] BEVERAGES = {"coffee", "tea", "milk", "orangeJuice", "water"};
    private static final String[] SMOKES = {"dancing", "painter", "reading", "football", "chess"};
    private static final String[] PETS = {"dog", "snail", "fox", "horse", "zebra"};

    private int[] colorAssignment;
    private int[] nationalityAssignment;
    private int[] beverageAssignment;
    private int[] hobbyAssignment;
    private int[] petAssignment;

    String getWaterDrinker() {
        solve();
        for (int i = 0; i < 5; i++) {
            if (beverageAssignment[i] == indexOf("water", BEVERAGES)) {
                return nationalityForHouse(i);
            }
        }
        return "";
    }

    String getZebraOwner() {
        solve();
        for (int i = 0; i < 5; i++) {
            if (petAssignment[i] == indexOf("zebra", PETS)) {
                return nationalityForHouse(i);
            }
        }
        return "";
    }

    private String nationalityForHouse(int houseIndex) {
        return NATIONALITIES[nationalityAssignment[houseIndex]];
    }

    private int indexOf(String value, String[] array) {
        for (int i = 0; i < array.length; i++) {
            if (array[i].equals(value)) {
                return i;
            }
        }
        return -1;
    }

    private void solve() {
        // Try all permutations of nationalities
        for (int[] nationalities : permutations(NATIONALITIES.length)) {
            // Constraint 10: Norwegian lives in first house
            if (nationalities[0] != indexOf("Norwegian", NATIONALITIES)) {
                continue;
            }

            // Constraint 15: Norwegian lives next to blue house
            if (Math.abs(nationalities[0] - indexOf("blue", COLORS)) != 1) {
                continue;
            }

            // Constraint 2: Englishman lives in red house
            boolean englishmanInRed = false;
            for (int i = 0; i < 5; i++) {
                if (nationalities[i] == indexOf("Englishman", NATIONALITIES) &&
                    colorsForHouse(i) != indexOf("red", COLORS)) {
                    continue;
                }
            }

            // Try all permutations of colors
            for (int[] colors : permutations(COLORS.length)) {
                // Constraint 6: green house immediately right of ivory house
                boolean validColorPlacement = false;
                for (int i = 0; i < 5; i++) {
                    if (colors[i] == indexOf("green", COLORS) &&
                        colors[i - 1] == indexOf("ivory", COLORS)) {
                        validColorPlacement = true;
                        break;
                    }
                }
                if (!validColorPlacement) {
                    continue;
                }

                // Constraint 2: Englishman in red house
                boolean englishmanCorrect = true;
                for (int i = 0; i < 5; i++) {
                    if (nationalities[i] == indexOf("Englishman", NATIONALITIES) &&
                        colors[i] != indexOf("red", COLORS)) {
                        englishmanCorrect = false;
                        break;
                    }
                }
                if (!englishmanCorrect) {
                    continue;
                }

                // Constraint 4: green house drinks coffee
                boolean coffeePlacement = false;
                for (int i = 0; i < 5; i++) {
                    if (colors[i] == indexOf("green", COLORS)) {
                        coffeePlacement = true;
                        break;
                    }
                }
                if (!coffeePlacement) {
                    continue;
                }

                // Try all permutations of beverages
                for (int[] beverages : permutations(BEVERAGES.length)) {
                    // Constraint 9: middle house drinks milk
                    if (beverages[2] != indexOf("milk", BEVERAGES)) {
                        continue;
                    }

                    // Constraint 4: green house drinks coffee
                    boolean coffeeMatches = true;
                    for (int i = 0; i < 5; i++) {
                        if (colors[i] == indexOf("green", COLORS) &&
                            beverages[i] != indexOf("coffee", BEVERAGES)) {
                            coffeeMatches = false;
                            break;
                        }
                    }
                    if (!coffeeMatches) {
                        continue;
                    }

                    // Constraint 5: Ukrainian drinks tea
                    boolean teaPlacement = false;
                    for (int i = 0; i < 5; i++) {
                        if (nationalities[i] == indexOf("Ukrainian", NATIONALITIES) &&
                            beverages[i] == indexOf("tea", BEVERAGES)) {
                            teaPlacement = true;
                            break;
                        }
                    }
                    if (!teaPlacement) {
                        continue;
                    }

                    // Try all permutations of hobbies
                    for (int[] hobbies : permutations(HOBBIES.length)) {
                        // Constraint 7: snail owner likes dancing
                        boolean snailDancing = true;
                        for (int i = 0; i < 5; i++) {
                            if (hobbies[i] == indexOf("dancing", HOBBIES) &&
                                petsForHouse(i) != indexOf("snail", PETS)) {
                                snailDancing = false;
                                break;
                            }
                        }
                        if (!snailDancing) {
                            continue;
                        }

                        // Constraint 8: yellow house is painter
                        boolean painterPlacement = false;
                        for (int i = 0; i < 5; i++) {
                            if (colors[i] == indexOf("yellow", COLORS) &&
                                hobbies[i] == indexOf("painter", HOBBIES)) {
                                painterPlacement = true;
                                break;
                            }
                        }
                        if (!painterPlacement) {
                            continue;
                        }

                        // Constraint 13: football player drinks orange juice
                        boolean footballJuice = true;
                        for (int i = 0; i < 5; i++) {
                            if (hobbies[i] == indexOf("football", HOBBIES) &&
                                beverages[i] != indexOf("orangeJuice", BEVERAGES)) {
                                footballJuice = false;
                                break;
                            }
                        }
                        if (!footballJuice) {
                            continue;
                        }

                        // Constraint 14: Japanese plays chess
                        boolean chessPlacement = false;
                        for (int i = 0; i < 5; i++) {
                            if (nationalities[i] == indexOf("Japanese", NATIONALITIES) &&
                                hobbies[i] == indexOf("chess", HOBBIES)) {
                                chessPlacement = true;
                                break;
                            }
                        }
                        if (!chessPlacement) {
                            continue;
                        }

                        // Constraint 12: painter's house next to horse
                        boolean horseNextToPainter = false;
                        for (int i = 0; i < 5; i++) {
                            if (hobbies[i] == indexOf("painter", HOBBIES)) {
                                if (i > 0 && petsForHouse(i - 1) == indexOf("horse", PETS)) {
                                    horseNextToPainter = true;
                                    break;
                                }
                                if (i < 4 && petsForHouse(i + 1) == indexOf("horse", PETS)) {
                                    horseNextToPainter = true;
                                    break;
                                }
                            }
                        }
                        if (!horseNextToPainter) {
                            continue;
                        }

                        // Constraint 3: Spaniard owns dog
                        boolean dogPlacement = false;
                        for (int i = 0; i < 5; i++) {
                            if (nationalities[i] == indexOf("Spaniard", NATIONALITIES) &&
                                petsForHouse(i) == indexOf("dog", PETS)) {
                                dogPlacement = true;
                                break;
                            }
                        }
                        if (!dogPlacement) {
                            continue;
                        }

                        // Constraint 11: reader next to fox owner
                        boolean foxNextToReader = false;
                        for (int i = 0; i < 5; i++) {
                            if (hobbies[i] == indexOf("reading", HOBBIES)) {
                                if (i > 0 && petsForHouse(i - 1) == indexOf("fox", PETS)) {
                                    foxNextToReader = true;
                                    break;
                                }
                                if (i < 4 && petsForHouse(i + 1) == indexOf("fox", PETS)) {
                                    foxNextToReader = true;
                                    break;
                                }
                            }
                        }
                        if (!foxNextToReader) {
                            continue;
                        }

                        // If we get here, we have a valid solution
                        this.nationalityAssignment = nationalities;
                        this.colorAssignment = colors;
                        this.beverageAssignment = beverages;
                        this.hobbyAssignment = hobbies;
                        this.petAssignment = petsForHouseArray();
                        return;
                    }
                }
            }
        }
    }

    private int[] petsForHouseArray() {
        return new int[5]; // Placeholder - pets not fully constrained
    }

    private int colorsForHouse(int house) {
        return colorAssignment[house];
    }

    private int[] petsForHouse(int house) {
        return new int[]{0}; // Placeholder
    }

    private List<int[]> permutations(int n) {
        List<int[]> result = new ArrayList<>();
        int[] current = new int[n];
        for (int i = 0; i < n; i++) {
            current[i] = i;
        }
        generatePermutations(result, current, 0);
        return result;
    }

    private void generatePermutations(List<int[]> result, int[] current, int index) {
        if (index == current.length - 1) {
            result.add(current.clone());
            return;
        }
        for (int i = index; i < current.length; i++) {
            swap(current, index, i);
            generatePermutations(result, current, index + 1);
            swap(current, index, i);
        }
    }

    private void swap(int[] array, int i, int j) {
        int temp = array[i];
        array[i] = array[j];
        array[j] = temp;
    }
}
