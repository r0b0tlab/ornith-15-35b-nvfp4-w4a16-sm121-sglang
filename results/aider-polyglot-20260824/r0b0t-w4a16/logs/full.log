I'll implement the Grade School roster functionality.

grade-school.js
```javascript
//
// This is only a SKELETON file for the 'Grade School' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class GradeSchool {
  constructor() {
    this._roster = {};
  }

  roster() {
    const sortedRoster = {};
    const grades = Object.keys(this._roster).map(Number).sort((a, b) => a - b);
    
    for (const grade of grades) {
      sortedRoster[grade] = [...this._roster[grade]];
    }
    
    return sortedRoster;
  }

  add(name, grade) {
    // Check if student already exists in roster
    for (const key of Object.keys(this._roster)) {
      if (this._roster[key].includes(name)) {
        return false;
      }
    }
    
    // Add student to their grade
    if (!this._roster[grade]) {
      this._roster[grade] = [];
    }
    this._roster[grade].push(name);
    this._roster[grade].sort();
    
    return true;
  }

  grade(grade) {
    return [...this._roster[grade] || []];
  }
}
