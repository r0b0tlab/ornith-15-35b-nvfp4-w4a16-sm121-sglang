```
//
// This is only a SKELETON file for the 'Scale Generator' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Scale {
  constructor(tonic) {
    this.tonic = tonic.toUpperCase();
  }

  chromatic() {
    const sharpScale = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B'];
    const flatScale = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭'];
    
    const isSharpTonic = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B'].includes(this.tonic);
    const scale = isSharpTonic ? sharpScale : flatScale;
    
    const startIndex = scale.findIndex(note => note === this.tonic);
    return [...scale.slice(startIndex), ...scale.slice(0, startIndex)];
  }

  interval(intervals) {
    const chromaticScale = this.chromatic();
    const result = [chromaticScale[0]];
    let currentIndex = 0;
    
    for (const interval of intervals) {
      if (interval === 'm') {
        currentIndex += 1;
      } else if (interval === 'M') {
        currentIndex += 2;
      } else if (interval === 'A') {
        currentIndex += 3;
      }
      result.push(chromaticScale[currentIndex]);
    }
    
    return result;
  }
}
```
