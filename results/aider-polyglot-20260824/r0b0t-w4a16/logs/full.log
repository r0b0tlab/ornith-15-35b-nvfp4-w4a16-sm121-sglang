The issues are:
1. `white` and `black` should be arrays `[row, column]`, not objects
2. Need to validate positions are on the board, throwing "Queen must be placed on the board"
3. Board cells need `_` as the default character
4. The "same position" error should be "Queens cannot share the same space"

queen-attack.js
```javascript
export class QueenAttack {
  constructor({
    black: [blackRow, blackColumn] = [7, 3],
    white: [whiteRow, whiteColumn] = [0, 3],
  } = {}) {
    if (
      blackRow < 0 ||
      blackRow > 7 ||
      blackColumn < 0 ||
      blackColumn > 7
    ) {
      throw new Error('Queen must be placed on the board');
    }

    if (
      whiteRow < 0 ||
      whiteRow > 7 ||
      whiteColumn < 0 ||
      whiteColumn > 7
    ) {
      throw new Error('Queen must be placed on the board');
    }

    if (
      (blackRow === whiteRow && blackColumn === whiteColumn) ||
      (whiteRow === blackRow && whiteColumn === blackColumn)
    ) {
      throw new Error('Queens cannot share the same space');
    }

    this.white = [whiteRow, whiteColumn];
    this.black = [blackRow, blackColumn];
  }

  toString() {
    const board = Array.from({ length: 8 }, () => Array({ length: 8 }).fill('_'));

    board[this.white[0]][this.white[1]] = 'W';
    board[this.black[0]][this.black[1]] = 'B';

    return board.map((row) => row.join(' ')).join('\n');
  }

  get canAttack() {
    const [whiteRow, whiteColumn] = this.white;
    const [blackRow, blackColumn] = this.black;

    const sameRow = whiteRow === blackRow;
    const sameColumn = whiteColumn === blackColumn;
    const sameDiagonal =
      Math.abs(whiteRow - blackRow) === Math.abs(whiteColumn - blackColumn);

    return sameRow || sameColumn || sameDiagonal;
  }
}
```
