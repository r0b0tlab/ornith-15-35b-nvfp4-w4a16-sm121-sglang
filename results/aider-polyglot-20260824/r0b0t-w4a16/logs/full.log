class PhoneNumber:
    def __init__(self, number):
        # Check for letters
        if any(ch.isalpha() for ch in number):
            raise ValueError("letters not permitted")
        
        # Check for punctuation
        if any(not ch.isdigit() and ch not in '+-.() ' and not ch.isspace() for ch in number):
            raise ValueError("punctuations not permitted")
        
        # Extract only the digits from the input
        digits = ''.join(ch for ch in number if ch.isdigit())
        
        # Determine if it's a valid length and strip country code if present
        if len(digits) < 10:
            raise ValueError("must not be fewer than 10 digits")
        if len(digits) > 11:
            raise ValueError("must not be greater than 11 digits")
        
        if len(digits) == 11:
            if digits[0] != '1':
                raise ValueError("11 digits must start with 1")
            digits = digits[1:]
        
        # Now digits should be 10 digits (area code + local number)
        area_code = digits[:3]
        exchange_code = digits[3:6]
        subscriber = digits[6:]
        
        # Validate area code
        if area_code[0] == '0':
            raise ValueError("area code cannot start with zero")
        if area_code[0] == '1':
            raise ValueError("area code cannot start with one")
        
        # Validate exchange code
        if exchange_code[0] == '0':
            raise ValueError("exchange code cannot start with zero")
        if exchange_code[0] == '1':
            raise ValueError("exchange code cannot start with one")
        
        # Store the cleaned number
        self.number = digits

    @property
    def area_code(self):
        return self.number[:3]

    def pretty(self):
        return f"({self.number[:3]}) {self.number[3:6]}-{self.number[6:]}"
```
