pub fn answer(command: &str) -> Option<i32> {
    // Check if the command starts with "What is"
    let cleaned = command.trim_end_matches('?').trim();
    if !cleaned.starts_with("What is") {
        return None; // Non-math question
    }

    // Remove "What is" prefix
    let expression = cleaned["What is".len()..].trim();

    // Tokenize the expression
    let mut tokens = Vec::new();
    let mut current = String::new();

    for ch in expression.chars() {
        if ch.is_whitespace() {
            if !current.is_empty() {
                tokens.push(current.clone());
                current.clear();
            }
        } else {
            current.push(ch);
        }
    }

    if !current.is_empty() {
        tokens.push(current);
    }

    if tokens.is_empty() {
        return None;
    }

    // Parse the first number
    let mut result = match tokens[0].parse::<i32>() {
        Ok(n) => n,
        Err(_) => return None, // Invalid syntax
    };

    let mut i = 1;
    while i < tokens.len() {
        let op = &tokens[i];
        match op.as_str() {
            "plus" => {
                if i + 1 >= tokens.len() {
                    return None;
                }
                result = result + tokens[i + 1].parse::<i32>().ok()?;
                i += 2;
            }
            "minus" => {
                if i + 1 >= tokens.len() {
                    return None;
                }
                result = result - tokens[i + 1].parse::<i32>().ok()?;
                i += 2;
            }
            "multiplied by" => {
                if i + 2 >= tokens.len() {
                    return None;
                }
                result = result * tokens[i + 2].parse::<i32>().ok()?;
                i += 3;
            }
            "divided by" => {
                if i + 2 >= tokens.len() {
                    return None;
                }
                result = result / tokens[i + 2].parse::<i32>().ok()?;
                i += 3;
            }
            #[cfg(feature = "exponentials")]
            "raised to the power of" => {
                if i + 3 >= tokens.len() {
                    return None;
                }
                let base = result;
                let exp = tokens[i + 3].parse::<i32>().ok()?;
                result = base.pow(exp as u32);
                i += 4;
            }
            "cubed" => {
                if i + 1 >= tokens.len() {
                    return None;
                }
                result = result * result * result;
                i += 2;
            }
            _ => return None, // Unsupported operation
        }
    }

    Some(result)
}
