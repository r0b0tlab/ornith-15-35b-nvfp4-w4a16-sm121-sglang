```java
import io.reactivex.Observable;
import java.util.AbstractMap;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

class Hangman {

    Observable<Output> play(Observable<String> words, Observable<String> 
letters) {
        return words
            .combineLatest(letters, (word, letter) -> new 
AbstractMap.SimpleEntry<>(word, letter))
            .scan(
                Output.empty(),
                (state, entry) -> {
                    String word = entry.getKey();
                    String letter = entry.getValue();

                    // If the word changed, reset the accumulated guesses.
                    Set<String> guesses;
                    if (state.secret != null && state.secret.equals(word)) {
                        guesses = new HashSet<>(state.guess);
                    } else {
                        guesses = new HashSet<>();
                    }
                    guesses.add(letter);

                    // Build the discovered string and collect unique word 
characters.
                    StringBuilder discovered = new StringBuilder();
                    Set<String> uniqueWordChars = new HashSet<>();
                    boolean won = true;
                    for (char c : word.toCharArray()) {
                        String ch = String.valueOf(c);
                        uniqueWordChars.add(ch);
                        if (guesses.contains(ch)) {
                            discovered.append(c);
                        } else {
                            discovered.append('_');
                            won = false;
                        }
                    }

                    // Wrong guesses are those not present in the word.
                    Set<String> misses = new HashSet<>();
                    for (String g : guesses) {
                        if (!uniqueWordChars.contains(g)) {
                            misses.add(g);
                        }
                    }

                    Status status = won ? Status.WON : Status.PLAYING;

                    List<Part> parts = new ArrayList<>();
                    for (char c : word.toCharArray()) {
                        String ch = String.valueOf(c);
                        parts.add(new Part(ch, guesses.contains(ch)));
                    }

                    return new Output(
                        word,
                        discovered.toString(),
                        guesses,
                        misses,
                        parts,
                        status);
                }
            );
    }
}
```

