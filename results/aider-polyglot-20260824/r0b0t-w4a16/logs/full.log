lib.rs
```rust
use std::collections::HashMap;

pub fn solve(input: &str) -> Option<HashMap<char, u8>> {
    // Split the equation into the left side (sum of addends) and right side (result)
    let parts: Vec<&str> = input.split("==").collect();
    if parts.len() != 2 {
        return None;
    }
    
    let addends: Vec<&str> = parts[0].split('+').collect();
    let result = parts[1].trim();
    
    if addends.is_empty() || result.is_empty() {
        return None;
    }
    
    // Collect all unique letters
    let mut letters: Vec<char> = Vec::new();
    for end in addends.iter() {
        for c in end.chars() {
            if c.is_ascii_alphabetic() && !letters.contains(&c) {
                letters.push(c);
            }
        }
    }
    for c in result.chars() {
        if c.is_ascii_alphabetic() && !letters.contains(&c) {
            letters.push(c);
        }
    }
    
    // If we have more letters than digits (0-9), no solution
    if letters.len() > 10 {
        return None;
    }
    
    // Track which letters are leading (can't be zero)
    let mut is_leading: Vec<char> = Vec::new();
    for end in addends.iter() {
        if end.len() > 1 {
            let first = end.chars().next().unwrap();
            if !is_leading.contains(&first) {
                is_leading.push(first);
            }
        }
    }
    if result.len() > 1 {
        let first = result.chars().next().unwrap();
        if !is_leading.contains(&first) {
            is_leading.push(first);
        }
    }
    
    // Try all permutations of digit assignments
    let mut used: Vec<bool> = vec![false; 10];
    let mut assignment: HashMap<char, u8> = HashMap::new();
    
    if solve_recursive(&letters, 0, &mut used, &mut assignment, &addends, result) {
        Some(assignment)
    } else {
        None
    }
}

fn solve_recursive(
    letters: &[char],
    index: usize,
    used: &mut Vec<bool>,
    assignment: &mut HashMap<char, u8>,
    addends: &[&str],
    result: &str,
) -> bool {
    if index == letters.len() {
        // Check if the assignment is valid
        return is_valid(assignment, addends, result);
    }
    
    let letter = letters[index];
    for digit in 0..=9 {
        if used[digit as usize] {
            continue;
        }
        
        // Check leading zero constraint
        // (handled in is_valid, but we can prune early)
        
        used[digit as usize] = true;
        assignment.insert(letter, digit as u8);
        
        if solve_recursive(letters, index + 1, used, assignment, addends, result) {
            return true;
        }
        
        assignment.remove(&letter);
        used[digit as usize] = false;
    }
    
    false
}

fn is_valid(
    assignment: &HashMap<char, u8>,
    addends: &[&str],
    result: &str,
) -> bool {
    // Check no leading zeros for multi-digit numbers
    for end in addends.iter() {
        if end.len() > 1 && assignment.get(&end.chars().next().unwrap()) == Some(&0) {
            return false;
        }
    }
    if result.len() > 1 && assignment.get(&result.chars().next().unwrap()) == Some(&0) {
        return false;
    }
    
    // Calculate the sum of addends
    let mut sum: u64 = 0;
    for end in addends.iter() {
        let mut value: u64 = 0;
        for c in end.chars() {
            let digit = *assignment.get(&c).unwrap();
            value = value * 10 + digit as u64;
        }
        sum += value;
    }
    
    // Calculate the result value
    let mut result_value: u64 = 0;
    for c in result.chars() {
        let digit = *assignment.get(&c).unwrap();
        result_value = result_value * 10 + digit as u64;
    }
    
    sum == result_value
}
```

