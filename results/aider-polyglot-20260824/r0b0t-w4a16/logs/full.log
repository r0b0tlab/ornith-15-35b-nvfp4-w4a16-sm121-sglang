I'll implement the word search solution. The class needs to:
1. Take a puzzle grid in the constructor
2. Find words in all 8 directions (horizontal, vertical, diagonal)
3. Return the start and end positions of each found word

word-search.js
```javascript
//
// This is only a SKELETON file for the 'Word Search' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class WordSearch {
  constructor(grid) {
    this.grid = grid;
  }

  find(word) {
    if (!this.grid || this.grid.length === 0) {
      return undefined;
    }

    const rows = this.grid.length;
    const cols = this.grid[0].length;

    // All 8 possible directions: [rowDelta, colDelta]
    const directions = [
      [0, 1],    // right
      [0, -1],   // left
      [1, 0],    // down
      [-1, 0],   // up
      [1, 1],    // down-right
      [1, -1],   // down-left
      [-1, 1],   // up-right
      [-1, -1],  // up-left
    ];

    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        // Check if word starts at this position
        if (this.grid[row][col] !== word[0]) {
          continue;
        }

        for (const [rowDelta, colDelta] of directions) {
          const result = this.matchFrom(
            row, col, rowDelta, colDelta, word
          );
          if (result) {
            return result;
          }
        }
      }
    }

    return undefined;
  }

  matchFrom(startRow, startCol, rowDelta, colDelta, word) {
    const rows = this.grid.length;
    const cols = this.grid[0].length;

    const lastRow = startRow + rowDelta * (word.length - 1);
    const lastCol = startCol + colDelta * (word.length - 1);

    // Check bounds
    if (lastRow < 0 || lastRow >= rows || lastCol < 0 || lastCol >= cols) {
      return undefined;
    }

    // Check each character matches
    for (let i = 0; i < word.length; i++) {
      const r = startRow + rowDelta * i;
      const c = startCol + colDelta * i;
      if (this.grid[r][c] !== word[i]) {
        return undefined;
      }
    }

    // Return the positions of first and last letters
    return {
      start: [startRow + 1, startCol + 1],
      end: [lastRow + 1, lastCol + 1],
    };
  }
}

export default WordSearch;
