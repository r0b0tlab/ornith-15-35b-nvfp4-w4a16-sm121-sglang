AffineCipher.java
```java
public class AffineCipher {
    private static final int M = 26;
    
    public String encode(String text, int coefficient1, int coefficient2){
        if (!isCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("a and m must be coprime.");
        }
        
        StringBuilder result = new StringBuilder();
        int groupCount = 0;
        
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                if (groupCount == 5) {
                    result.append(' ');
                    groupCount = 0;
                }
                
                int x = Character.toLowerCase(c) - 'a';
                int encoded = (coefficient1 * x + coefficient2) % M;
                if (encoded < 0) {
                    encoded += M;
                }
                result.append((char) (encoded + 'a'));
                groupCount++;
            } else if (Character.isDigit(c)) {
                if (groupCount == 5) {
                    result.append(' ');
                    groupCount = 0;
                }
                result.append(c);
                groupCount++;
            }
        }
        
        return result.toString();
    }
    
    public String decode(String text, int coefficient1, int coefficient2){
        if (!isCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("a and m must be coprime.");
        }
        
        int mmi = findModularInverse(coefficient1, M);
        StringBuilder result = new StringBuilder();
        
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int y = Character.toLowerCase(c) - 'a';
                int decoded = (mmi * (y - coefficient2)) % M;
                if (decoded < 0) {
                    decoded += M;
                }
                result.append((char) (decoded + 'a'));
            } else if (Character.isDigit(c)) {
                result.append(c);
            }
        }
        
        return result.toString();
    }
    
    private boolean isCoprime(int a, int m) {
        return gcd(a, m) == 1;
    }
    
    private int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
    
    private int findModularInverse(int a, int m) {
        a = ((a % m) + m) % m;
        for (int x = 1; x < m; x++) {
            if ((a * x) % m == 1) {
                return x;
            }
        }
        throw new IllegalArgumentException("Modular inverse does not exist.");
    }
}
