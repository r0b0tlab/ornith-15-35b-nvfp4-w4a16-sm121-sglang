use anyhow::Error;

/// While using `&[&str]` to handle flags is convenient for exercise purposes,
/// and resembles the output of [`std::env::args`], in real-world projects it is
/// both more convenient and more idiomatic to contain runtime configuration in
/// a dedicated struct. Therefore, we suggest that you do so in this exercise.
///
/// [`std::env::args`]: https://doc.rust-lang.org/std/env/fn.args.html
#[derive(Debug, Clone)]
pub struct Flags {
    line_numbers: bool,
    files_with_matches: bool,
    case_insensitive: bool,
    invert_match: bool,
    match_whole_line: bool,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut result = Flags {
            line_numbers: false,
            files_with_matches: false,
            case_insensitive: false,
            invert_match: false,
            match_whole_line: false,
        };

        for flag in flags {
            match flag.as_str() {
                "-n" => result.line_numbers = true,
                "-l" => result.files_with_matches = true,
                "-i" => result.case_insensitive = true,
                "-v" => result.invert_match = true,
                "-x" => result.match_whole_line = true,
                _ => {}
            }
        }

        result
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();

    for file in files {
        let content = std::fs::read_to_string(file)
            .map_err(|e| anyhow::anyhow!("Error reading file '{}': {}", file, e))?;

        let mut file_matched = false;

        for (line_number, line) in content.lines().enumerate() {
            let line = line.trim_end_matches('\n');
            let matches = if flags.case_insensitive {
                line.eq_ignore_ascii_case(pattern)
            } else {
                line.contains(pattern)
            };

            let matched = if flags.match_whole_line {
                if flags.case_insensitive {
                    line.eq_ignore_ascii_case(pattern)
                } else {
                    line == pattern
                }
            } else {
                matches
            };

            let inverted_match = !matched;
            let final_match = if flags.invert_match {
                inverted_match
            } else {
                matched
            };

            if final_match {
                file_matched = true;

                if flags.files_with_matches {
                    break;
                }

                let mut line_result = String::new();

                if flags.line_numbers {
                    line_result.push_str(&format!("{}:", line_number + 1));
                }

                if files.len() > 1 {
                    line_result.push_str(&format!("{}:", file));
                }

                line_result.push_str(line);

                results.push(line_result);
            }
        }

        if flags.files_with_matches && file_matched {
            results.push(file.to_string());
        }
    }

    Ok(results)
}
