/// Given a list of poker hands, return a list of those hands which win.
///
/// Note the type signature: this function should return _the same_ reference to
/// the winning hand(s) as were passed in, not reconstructed strings which happen to be equal.
pub fn winning_hands<'a>(hands: &[&'a str]) -> Vec<&'a str> {
    if hands.is_empty() {
        return Vec::new();
    }

    // Score each hand as a comparable tuple.
    let scored: Vec<(Vec<u8>, &'a str)> = hands
        .iter()
        .map(|h| (evaluate_hand(h), h))
        .collect();

    // Find the maximum score.
    let best = scored
        .iter()
        .map(|(score, _)| score)
        .max()
        .expect("non-empty input");

    // Collect all hands whose score equals the best.
    scored
        .into_iter()
        .filter(|(score, _)| score == best)
        .map(|(_, h)| h)
        .collect()
}

/// Evaluate a poker hand into a comparable tuple.
///
/// The tuple is ordered so that lexicographic comparison yields the correct
/// ranking: first the category, then tiebreaker ranks from most to least significant.
fn evaluate_hand(hand: &str) -> Vec<u8> {
    let mut ranks: Vec<u8> = hand
        .split_whitespace()
        .map(|card| parse_rank(card))
        .collect();
    let suits: Vec<char> = hand
        .split_whitespace()
        .map(|card| card.chars().nth(1).unwrap())
        .collect();

    let is_flush = suits.len() > 1 && suits.iter().all(|&s| s == suits[0]);

    // Sort ranks descending for tiebreaking.
    ranks.sort();
    ranks.reverse();

    let is_straight = check_straight(&ranks);

    // Count occurrences of each rank.
    let mut counts: Vec<(u8, u8)> = Vec::new(); // (rank, count)
    for &r in &ranks {
        if counts.is_empty() || counts.last().unwrap().0 != r {
            counts.push((r, 1));
        } else {
            counts.last_mut().unwrap().1 += 1;
        }
    }
    // counts is sorted by rank descending already since ranks were sorted descending.

    // Determine category and tiebreakers.
    if is_straight && is_flush {
        // Straight flush.
        // ranks[0] is the high card; for a wheel, ranks[0] was set to 14.
        return vec![8, ranks[0]];
    }

    if counts.len() == 1 {
        // Four of a kind.
        return vec![7, counts[0].0, counts[0].1, ranks[1]];
    }

    if counts.len() == 2 {
        let (rank_a, count_a) = counts[0];
        let (rank_b, count_b) = counts[1];
        if count_a == 3 {
            // Full house.
            return vec![6, rank_a, rank_b];
        } else {
            // Two pair.
            return vec![5, rank_a, rank_b, ranks[2]];
        }
    }

    if counts.iter().any(|&(_, c)| c == 4) {
        // handled above for len==1
    }

    if counts.len() == 4 {
        // Pair.
        // Find the pair rank and the three kickers.
        let pair = counts.iter().find(|&(_, c)| c == 2).unwrap().0;
        let kickers: Vec<u8> = ranks.iter().take(3).copied().collect();
        return vec![4, pair, kickers[0], kickers[1], kickers[2]];
    }

    if counts.iter().any(|&(_, c)| c == 3) {
        // Three of a kind.
        let trips = counts.iter().find(|&(_, c)| c == 3).unwrap().0;
        let kickers: Vec<u8> = ranks.iter().take(2).copied().collect();
        return vec![3, trips, kickers[0], kickers[1]];
    }

    if counts.len() == 3 {
        // Two pair handled above. This branch: three singles? No, len 3 with no pairs
        // would be impossible with 5 cards unless... actually 3 distinct ranks in 5 cards
        // means at least one pair. So this is unreachable here.
    }

    if is_straight {
        return vec![2, ranks[0]];
    }

    if is_flush {
        return vec![1, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4]];
    }

    // High card.
    vec![0, ranks[0], ranks[1], ranks[2], ranks[3], ranks[4]]
}

fn parse_rank(card: &str) -> u8 {
    let rank_char = card.chars().next().unwrap();
    match rank_char {
        '2'..='9' => rank_char as u8 - b'0',
        'T' => 10,
        'J' => 11,
        'Q' => 12,
        'K' => 13,
        'A' => 14,
        _ => panic!("Invalid rank: {rank_char}"),
    }
}

fn check_straight(ranks: &[u8]) -> bool {
    if ranks.len() != 5 {
        return false;
    }
    // Normal straight: all distinct, consecutive.
    if ranks[0] == ranks[1]
        || ranks[1] == ranks[2]
        || ranks[2] == ranks[3]
        || ranks[3] == ranks[4]
    {
        return false;
    }
    if ranks[0] - ranks[4] == 4 {
        return true;
    }
    // Wheel: A-2-3-4-5. After sorting descending with Ace=14, we get 14,4,3,2,1.
    if ranks[0] == 14 && ranks[1] == 4 && ranks[2] == 3 && ranks[3] == 2 && ranks[4] == 1 {
        return true;
    }
    false
}
