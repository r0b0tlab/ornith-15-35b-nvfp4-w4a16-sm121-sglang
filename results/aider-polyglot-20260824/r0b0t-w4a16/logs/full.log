```java
import org.json.JSONObject;

import java.util.ArrayList;
import java.util.List;

class RestApi {
    private final List<User> users;

    RestApi(User... users) {
        this.users = new ArrayList<>(List.of(users));
    }

    String get(String url) {
        return "[]";
    }

    String get(String url, JSONObject payload) {
        if (url.equals("/users")) {
            if (payload == null || !payload.has("users")) {
                return "[]";
            }
            
            List<String> requestedNames = payload.getString("users");
            List<User> filteredUsers = new ArrayList<>();
            
            for (String name : requestedNames) {
                for (User user : users) {
                    if (user.name().equals(name)) {
                        filteredUsers.add(user);
                        break;
                    }
                }
            }
            
            filteredUsers.sort((u1, u2) -> u1.name().compareTo(u2.name()));
            
            JSONObject response = new JSONObject();
            response.put("users", filteredUsers);
            return response.toString();
        }
        
        return "[]";
    }

    String post(String url, JSONObject payload) {
        if (url.equals("/add")) {
            String name = payload.getString("user");
            
            User newUser = User.builder()
                .setName(name)
                .build();
            
            users.add(newUser);
            
            JSONObject response = new JSONObject();
            response.put("name", name);
            response.put("owes", new JSONObject());
            response.put("owed_by", new JSONObject());
            response.put("balance", 0.0);
            return response.toString();
        }
        
        if (url.equals("/iou")) {
            String lender = payload.getString("lender");
            String borrower = payload.getString("borrower");
            double amount = payload.getDouble("amount");
            
            User lenderUser = findUserByName(lender);
            User borrowerUser = findUserByName(borrower);
            
            if (lenderUser != null && borrowerUser != null) {
                // Update the IOU relationship
                updateIou(lenderUser, borrowerUser, amount);
                
                // Return updated users sorted by name
                List<User> updatedUsers = new ArrayList<>();
                updatedUsers.add(lenderUser);
                updatedUsers.add(borrowerUser);
                updatedUsers.sort((u1, u2) -> u1.name().compareTo(u2.name()));
                
                JSONObject response = new JSONObject();
                response.put("users", updatedUsers);
                return response.toString();
            }
        }
        
        return "[]";
    }
    
    private User findUserByName(String name) {
        for (User user : users) {
            if (user.name().equals(name)) {
                return user;
            }
        }
        return null;
    }
    
    private void updateIou(User lender, User borrower, double amount) {
        // Check if there's an existing IOU in the opposite direction
        List<Iou> existingOwes = borrower.owes();
        for (Iou iou : existingOwes) {
            if (iou.name().equals(lender.name())) {
                double existingAmount = iou.amount();
                double newAmount = existingAmount - amount;
                
                // Remove the existing IOU
                existingOwes.remove(iou);
                
                if (newAmount > 0) {
                    // Add new IOU
                    borrower.owes(lender.name(), newAmount);
                }
                return;
            }
        }
        
        // Check if there's an existing IOU in the same direction
        List<Iou> existingOwedBy = borrower.owedBy();
        for (Iou iou : existingOwedBy) {
            if (iou.name().equals(lender.name())) {
                double newAmount = iou.amount() + amount;
                
                // Remove the existing IOU
                existingOwedBy.remove(iou);
                
                // Add new IOU
                borrower.owedBy(lender.name(), newAmount);
                return;
            }
        }
        
        // No existing IOU, add new one
        borrower.owedBy(lender.name(), amount);
    }
}
