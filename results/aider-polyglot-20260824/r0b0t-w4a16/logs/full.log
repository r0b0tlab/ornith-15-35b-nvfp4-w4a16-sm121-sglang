transpose.py
```python
def transpose(text):
    if not text:
        return ""
    lines = text.split("\n")
    max_len = max(len(line) for line in lines)
    result = []
    for col in range(max_len):
        row_chars = []
        for row in lines:
            if col < len(row):
                row_chars.append(row[col])
            else:
                row_chars.append("")
        # find last non-empty char index
        last_idx = max(i for i, c in enumerate(row_chars) if c != "")
        result.append("".join(row_chars[: last_idx + 1]))
    return "\n".join(result)
```
