```javascript
//
// This is only a SKELETON file for the 'Bowling' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Bowling {
  constructor() {
    this.rolls = [];
    this.gameOver = false;
  }

  roll(pins) {
    if (this.gameOver) {
      throw new Error('Cannot roll after game is over');
    }

    if (pins < 0) {
      throw new Error('Negative roll is invalid');
    }

    if (pins > 10) {
      throw new Error('Pin count exceeds pins on the lane');
    }

    const currentFrame = this._currentFrameIndex();
    const previousRolls = this.rolls.slice(0, currentFrame);
    const pinsRemaining = this._pinsRemaining(currentFrame);

    if (pins > pinsRemaining) {
      throw new Error('Pin count exceeds pins on the lane');
    }

    this.rolls.push(pins);
  }

  score() {
    if (this.rolls.length === 0) {
      throw new Error('Score cannot be taken until the end of the game');
    }

    if (!this._gameComplete()) {
      throw new Error('Score cannot be taken until the end of the game');
    }

    let score = 0;
    let index = 0;

    for (let frame = 0; frame < 10; frame++) {
      if (this.rolls[index] === 10) {
        // Strike
        score += 10 + this.rolls[index + 1] + this.rolls[index + 2];
        index += 1;
      } else if (this.rolls[index] + this.rolls[index + 1] === 10) {
        // Spare
        score += 10 + this.rolls[index + 2];
        index += 2;
      } else {
        // Open frame
        score += this.rolls[index] + this.rolls[index + 1];
        index += 2;
      }
    }

    this.gameOver = true;
    return score;
  }

  _currentFrameIndex() {
    let index = 0;
    let frame = 0;

    while (frame < 9) {
      if (this.rolls[index] === 10) {
        // Strike
        index += 1;
      } else {
        index += 2;
      }
      frame += 1;
    }

    return index;
  }

  _pinsRemaining(currentFrameIndex) {
    if (currentFrameIndex >= this.rolls.length) {
      return 10;
    }

    if (currentFrameIndex === 0) {
      return 10;
    }

    const previousRoll = this.rolls[currentFrameIndex - 1];

    if (currentFrameIndex % 2 === 0) {
      // First roll of frame
      return 10;
    }

    return 10 - previousRoll;
  }

  _gameComplete() {
    let index = 0;

    for (let frame = 0; frame < 9; frame++) {
      if (this.rolls[index] === 10) {
        // Strike - need two more rolls
        if (this.rolls[index + 1] === undefined || this.rolls[index + 2] === undefined) {
          return false;
        }
        index += 1;
      } else if (this.rolls[index] + this.rolls[index + 1] === 10) {
        // Spare - need one more roll
        if (this.rolls[index + 2] === undefined) {
          return false;
        }
        index += 2;
      } else {
        // Open frame
        index += 2;
      }
    }

    // Tenth frame
    const tenthFrameStart = index;
    const tenthFrameRolls = this.rolls.slice(tenthFrameStart);

    if (tenthFrameRolls.length < 2) {
      return false;
    }

    const firstRoll = tenthFrameRolls[0];
    const secondRoll = tenthFrameRolls[1];

    if (firstRoll === 10) {
      // Strike - need third roll
      if (tenthFrameRolls.length < 3 || tenthFrameRolls[2] === undefined) {
        return false;
      }
      // Check that third roll doesn't exceed 10 (unless first was not strike)
      if (secondRoll === 10 || secondRoll + tenthFrameRolls[2] <= 10) {
        return tenthFrameRolls.length === 3;
      }
      return false;
    } else if (firstRoll + secondRoll === 10) {
      // Spare - need third roll
      if (tenthFrameRolls.length < 3 || tenthFrameRolls[2] === undefined) {
        return false;
      }
      return tenthFrameRolls.length === 3;
    } else {
      // Open frame - complete
      return tenthFrameRolls.length === 2;
    }
  }
}
