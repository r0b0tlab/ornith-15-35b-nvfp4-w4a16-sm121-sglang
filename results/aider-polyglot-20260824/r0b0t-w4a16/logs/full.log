class FoodChain {

    private static final String[] ANIMALS = {
        "fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"
    };

    private static final String[] FIRST_LINES = {
        "I know an old lady who swallowed a fly.",
        "I know an old lady who swallowed a spider.",
        "I know an old lady who swallowed a bird.",
        "I know an old lady who swallowed a cat.",
        "I know an old lady who swallowed a dog.",
        "I know an old lady who swallowed a goat.",
        "I know an old lady who swallowed a cow.",
        "I know an old lady who swallowed a horse."
    };

    private static final String[] SECOND_LINES = {
        "",
        "It wriggled and jiggled and tickled inside her.",
        "How absurd to swallow a bird!",
        "Imagine that, to swallow a cat!",
        "What a hog, to swallow a dog!",
        "Just opened her throat and swallowed a goat!",
        "I don't know how she swallowed a cow!",
        "She's dead, of course!"
    };

    String verse(int verse) {
        int index = verse - 1;
        StringBuilder sb = new StringBuilder();
        sb.append(FIRST_LINES[index]).append("\n");

        if (index == 0) {
            // Fly verse - just the first line
            sb.append("I don't know why she swallowed the fly. Perhaps she'll die.");
            return sb.toString();
        }

        if (index == 7) {
            // Horse verse - ends with the second line
            sb.append(SECOND_LINES[index]);
            return sb.toString();
        }

        sb.append(SECOND_LINES[index]).append("\n");

        // Add the cumulative "swallowed to catch" lines
        for (int i = index; i > 0; i--) {
            sb.append("She swallowed the ").append(ANIMALS[i])
              .append(" to catch the ").append(prevAnimal(i));
            if (i - 1 == 1) {
                // spider line has extra description
                sb.append(" that wriggled and jiggled and tickled inside her");
            }
            sb.append(".\n");
        }

        // End with the fly line
        sb.append("I don't know why she swallowed the fly. Perhaps she'll die.");
        return sb.toString();
    }

    private String prevAnimal(int index) {
        if (index == 2) {
            // bird catches spider with special description
            return "spider that wriggled and jiggled and tickled inside her";
        }
        return ANIMALS[index - 1];
    }

    String verses(int startVerse, int endVerse) {
        StringBuilder sb = new StringBuilder();
        for (int i = startVerse; i <= endVerse; i++) {
            sb.append(verse(i)).append("\n");
        }
        return sb.toString();
    }
}
