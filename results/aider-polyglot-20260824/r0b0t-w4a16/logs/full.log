complex-numbers.js
```
//
// This is only a SKELETON file for the 'Complex Numbers' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ComplexNumber {
  constructor(real, imag) {
    this._real = real;
    this._imag = imag;
  }

  get real() {
    return this._real;
  }

  get imag() {
    return this._imag;
  }

  add(other) {
    return new ComplexNumber(
      this._real + other._real,
      this._imag + other._imag
    );
  }

  sub(other) {
    return new ComplexNumber(
      this._real - other._real,
      this._imag - other._imag
    );
  }

  div(other) {
    const a = this._real;
    const b = this._imag;
    const c = other._real;
    const d = other._imag;
    const denom = c * c + d * d;
    return new ComplexNumber(
      (a * c + b * d) / denom,
      (b * c - a * d) / denom
    );
  }

  mul(other) {
    const a = this._real;
    const b = this._imag;
    const c = other._real;
    const d = other._imag;
    return new ComplexNumber(
      a * c - b * d,
      b * c + a * d
    );
  }

  get abs() {
    return Math.sqrt(this._real * this._real + this._imag * this._imag);
  }

  get conj() {
    return new ComplexNumber(this._real, this._imag === 0 ? 0 : -this._imag);
  }

  get exp() {
    const a = this._real;
    const b = this._imag;
    const e = Math.exp(a);
    return new ComplexNumber(
      e * Math.cos(b),
      e * Math.sin(b)
    );
  }
}
```
