I need to implement an Alphametics puzzle solver. Let me analyze the requirements:

1. Parse the puzzle input (format like "SEND + MORE = MONEY")
2. Find digit assignments for each letter
3. Ensure no leading zeros in multi-digit numbers
4. Verify the sum is correct

The approach:
- Parse the equation into operands and result
- Collect all unique letters
- Try all permutations of digit assignments
- Check constraints (no leading zeros, valid sum)
- Return the solution or throw exception if unsolvable

Here's the implementation:

Alphametics.java
```java
import java.util.Map;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.HashSet;
import java.util.Set;
import java.util.Arrays;

class Alphametics {

    private final String equation;
    private final String[] operands;
    private final String result;
    private final char[] letters;

    Alphametics(String userInput) {
        this.equation = userInput;
        String[] parts = userInput.split("\\s*=\\s*");
        this.result = parts[1].trim();
        this.operands = parts[0].split("\\s*\\+\\s*");
        
        // Collect all unique letters
        Set<Character> letterSet = new LinkedHashSet<>();
        for (String operand : operands) {
            for (char c : operand.toCharArray()) {
                if (Character.isLetter(c)) {
                    letterSet.add(c);
                }
            }
        }
        for (char c : result.toCharArray()) {
            if (Character.isLetter(c)) {
                letterSet.add(c);
            }
        }
        this.letters = new char[letterSet.size()];
        int i = 0;
        for (char c : letterSet) {
            this.letters[i++] = c;
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        if (letters.length > 10) {
            throw new UnsolvablePuzzleException();
        }
        
        // Try all permutations of digits
        solveHelper(0, new int[letters.length], new boolean[10]);
        
        throw new UnsolvablePuzzleException();
    }

    private boolean isValidAssignment(int[] digitAssignment) {
        Map<Character, Integer> letterValues = new HashMap<>();
        for (int i = 0; i < letters.length; i++) {
            letterValues.put(letters[i], digitAssignment[i]);
        }

        // Check leading digits are not zero
        for (String operand : operands) {
            if (operand.length() > 1 && letterValues.get(operand.charAt(0)) == 0) {
                return false;
            }
        }
        if (result.length() > 1 && letterValues.get(result.charAt(0)) == 0) {
            return false;
        }

        // Calculate operand values
        int sum = 0;
        for (String operand : operands) {
            sum += calculateNumber(operand, letterValues);
        }

        // Calculate result value
        int resultValue = calculateNumber(result, letterValues);

        return sum == resultValue;
    }

    private int calculateNumber(String word, Map<Character, Integer> letterValues) {
        int number = 0;
        for (char c : word.toCharArray()) {
            number = number * 10 + letterValues.get(c);
        }
        return number;
    }

    private void solveHelper(int index, int[] digitAssignment, boolean[] used) {
        if (index == letters.length) {
            if (isValidAssignment(digitAssignment)) {
                // Solution found - build result map
                Map<Character, Integer> solution = new HashMap<>();
                for (int i = 0; i < letters.length; i++) {
                    solution.put(letters[i], digitAssignment[i]);
                }
                // Store as instance variable to return
                this.solution = solution;
            }
            return;
        }

        for (int digit = 0; digit <= 9; digit++) {
            if (!used[digit]) {
                used[digit] = true;
                digitAssignment[index] = digit;
                solveHelper(index + 1, digitAssignment, used);
                used[digit] = false;
                if (this.solution != null) {
                    return;
                }
            }
        }
    }

    private Map<Character, Integer> solution = null;
}
