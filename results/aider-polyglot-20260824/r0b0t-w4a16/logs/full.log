word-search/src/main/java/WordSearcher.java
```java
import java.util.Map;
import java.util.Optional;
import java.util.Set;
import java.util.HashMap;

class WordSearcher {

    Map<String, Optional<WordLocation>> search(final Set<String> words, final char[][] grid) {
        Map<String, Optional<WordLocation>> result = new HashMap<>();

        int rows = grid.length;
        if (rows == 0) {
            for (String word : words) {
                result.put(word, Optional.empty());
            }
            return result;
        }
        int cols = grid[0].length;

        int[][] directions = {
            {0, 1},    // right
            {0, -1},   // left
            {1, 0},    // down
            {-1, 0},   // up
            {1, 1},    // down-right
            {1, -1},   // down-left
            {-1, 1},   // up-right
            {-1, -1}   // up-left
        };

        for (String word : words) {
            Optional<WordLocation> found = Optional.empty();

            for (int r = 0; r < rows && !found.isPresent(); r++) {
                for (int c = 0; c < cols && !found.isPresent(); c++) {
                    for (int[] dir : directions) {
                        Optional<WordLocation> result2 = searchFrom(grid, word, r, c, dir[0], dir[1]);
                        if (result2.isPresent()) {
                            found = result2;
                            break;
                        }
                    }
                }
            }

            result.put(word, found);
        }

        return result;
    }

    private Optional<WordLocation> searchFrom(char[][] grid, String word, int startRow, int startCol, int dRow, int dCol) {
        int rows = grid.length;
        int cols = grid[0].length;

        int length = word.length();
        if (length == 0) {
            return Optional.empty();
        }

        int lastRow = startRow + (length - 1) * dRow;
        int lastCol = startCol + (length - 1) * dCol;

        if (lastRow < 0 || lastRow >= rows || lastCol < 0 || lastCol >= cols) {
            return Optional.empty();
        }

        for (int i = 0; i < length; i++) {
            int r = startRow + i * dRow;
            int c = startCol + i * dCol;
            if (grid[r][c] != word.charAt(i)) {
                return Optional.empty();
            }
        }

        WordLocation first = new WordLocation(startRow + 1, startCol + 1);
        WordLocation last = new WordLocation(lastRow + 1, lastCol + 1);
        return Optional.of(new WordLocation[]{first, last});
    }
}
```

word-search/src/main/java/WordLocation.java
```java
class WordLocation {

    private final int row;
    private final int column;

    WordLocation(int row, int column) {
        this.row = row;
        this.column = column;
    }

    public int getRow() {
        return row;
    }

    public int getColumn() {
        return column;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        WordLocation that = (WordLocation) o;
        return row == that.row && column == that.column;
    }

    @Override
    public int hashCode() {
        return row * 31 + column;
    }
}
```
