1. Create a `Node` class to represent nodes in the binary tree.
2. Implement the `Zipper` class with the required methods.

zipper.py
```python
class Node:
    def __init__(self, value, left=None, right=None):
        self.value = value
        self.left = left
        self.right = right


class Zipper:
    @staticmethod
    def from_tree(tree):
        return Zipper(tree, [])

    def value(self):
        return self.focus.value

    def set_value(self, value):
        return Zipper(self._clone_focus_value(value), self.path)

    def left(self):
        if self.focus.left is None:
            return None
        return Zipper(self.focus.left, self.path + [('left', self.focus)])

    def set_left(self, subtree):
        new_focus = Node(self.focus.value, subtree, self.focus.right)
        return Zipper(new_focus, self.path)

    def right(self):
        if self.focus.right is None:
            return None
        return Zipper(self.focus.right, self.path + [('right', self.focus)])

    def set_right(self, subtree):
        new_focus = Node(self.focus.value, self.focus.left, subtree)
        return Zipper(new_focus, self.path)

    def up(self):
        if not self.path:
            return None
        new_path = self.path[:-1]
        direction, parent = self.path[-1]
        if direction == 'left':
            parent = Node(parent.value, self.focus, parent.right)
        else:
            parent = Node(parent.value, parent.left, self.focus)
        return Zipper(parent, new_path)

    def to_tree(self):
        current = self.focus
        for direction, parent in reversed(self.path):
            if direction == 'left':
                current = Node(parent.value, current, parent.right)
            else:
                current = Node(parent.value, parent.left, current)
        return current
```
