Applied edit to variable-length-quantity.js
response:
Looking at the failures, I need to fix both the encode and decode functions.

For **encode**: The issue is the bit-shifting. `groups[i] << 1` shifts by 1 bit instead of 7, and `& 0xff` truncates to only the low 8 bits (losing bit 7). I need `<< 7` and masking with `0x80`.

For **decode**: The overflow check is wrong. A cleaner approach is to track whether we've started a number, accumulate 7 bits at a time, and check for overflow after each step.

variable-length-quantity.js
```
//
// This is only a SKELETON file for the 'Variable Length Quantity' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const UNSIGNED_32BIT_MAX = 0xffffffff;

export const encode = (numbers) => {
  const result = [];
  for (const number of numbers) {
    if (number < 0 || number > UNSIGNED_32BIT_MAX) {
      throw new Error('Value out of range');
    }
    // Split the number into 7-bit groups, least significant first
    const groups = [];
    let value = number;
    do {
      groups.push(value & 0x7f);
      value >>= 7;
    } while (value > 0);

    // Emit groups most significant first, with continuation bit set on all
    // but the last (least significant) group
    for (let i = groups.length - 1; i > 0; i--) {
      result.push((groups[i] << 7) | 0x80);
    }
    result.push(groups[0]);
  }
  return result;
};

export const decode = (bytes) => {
  const result = [];
  let value = 0;
  let inNumber = false;

  for (let i = 0; i < bytes.length; i++) {
    const byte = bytes[i];
    inNumber = true;

    // Shift existing value left by 7 bits, then add the new 7 bits
    value = ((value << 7) | (byte & 0x7f)) & UNSIGNED_32BIT_MAX;

    // Check for overflow: if value exceeds 32-bit unsigned max, it overflowed
    if (value > UNSIGNED_32BIT_MAX) {
      throw new Error('Value overflow');
    }

    if ((byte & 0x80) === 0) {
      // Final byte of a sequence
      result.push(value);
      value = 0;
      inNumber = false;
    }
  }

  if (inNumber) {
    throw new Error('Incomplete sequence');
  }

  return result;
};
```
