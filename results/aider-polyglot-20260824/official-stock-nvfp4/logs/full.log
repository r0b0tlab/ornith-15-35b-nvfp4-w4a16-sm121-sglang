I'll implement the TwoBucket solution using BFS to find the shortest sequence of moves.

two-bucket.js
```javascript
//
// This is only a SKELETON file for the 'Two Bucket' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class TwoBucket {
  constructor(bucketOne, bucketTwo, goal, startBucket) {
    this.bucketOne = bucketOne;
    this.bucketTwo = bucketTwo;
    this.goal = goal;
    this.startBucket = startBucket;
  }

  solve() {
    const { bucketOne, bucketTwo, goal, startBucket } = this;

    // Check if goal is achievable
    if (goal > Math.max(bucketOne, bucketTwo)) {
      throw new Error('Goal is not reachable');
    }

    // State: [bucket1Amount, bucket2Amount]
    // Track visited states to avoid cycles
    const visited = new Set();

    // BFS queue
    const queue = [];

    // Initial state: fill the start bucket (counts as first move)
    let startState;
    if (startBucket === 'one') {
      startState = [0, 0];
      queue.push({ state: [bucketOne, 0], moves: 1 });
    } else {
      startState = [0, 0];
      queue.push({ state: [0, bucketTwo], moves: 1 });
    }

    // Helper to create a unique key for a state
    const stateKey = (state) => `${state[0]},${state[1]}`;

    // Generate all possible next states
    const getNextStates = (state) => {
      const [b1, b2] = state;
      const nextStates = [];

      // Fill bucket one
      nextStates.push([bucketOne, b2]);
      // Fill bucket two
      nextStates.push([b1, bucketTwo]);
      // Empty bucket one
      nextStates.push([0, b2]);
      // Empty bucket two
      nextStates.push([b1, 0]);
      // Pour bucket one into bucket two
      const pourOneToTwo = Math.min(b1, bucketTwo - b2);
      nextStates.push([b1 - pourOneToTwo, b2 + pourOneToTwo]);
      // Pour bucket two into bucket one
      const pourTwoToOne = Math.min(b2, bucketOne - b1);
      nextStates.push([b1 + pourTwoToOne, b2 - pourTwoToOne]);

      return nextStates;
    };

    while (queue.length > 0) {
      const { state, moves } = queue.shift();
      const [b1, b2] = state;

      // Check if we've reached the goal
      if (b1 === goal) {
        return {
          moves: moves,
          goalBucket: 'one',
          otherBucket: b2,
        };
      }
      if (b2 === goal) {
        return {
          moves: moves,
          goalBucket: 'two',
          otherBucket: b1,
        };
      }

      const key = stateKey(state);
      if (visited.has(key)) {
        continue;
      }
      visited.add(key);

      // Generate all possible next states
      const nextStates = getNextStates(state);

      for (const nextState of nextStates) {
        const nextKey = stateKey(nextState);

        // Skip if already visited
        if (visited.has(nextKey)) {
          continue;
        }

        // Skip the forbidden state: starting bucket empty and other bucket full
        if (startBucket === 'one') {
          if (nextState[0] === 0 && nextState[1] === bucketTwo) {
            continue;
          }
        } else {
          if (nextState[1] === 0 && nextState[0] === bucketOne) {
            continue;
          }
        }

        queue.push({ state: nextState, moves: moves + 1 });
      }
    }

    throw new Error('Goal is not reachable');
  }
}
```
