import java.util.ArrayList;
import java.util.List;

public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) {
            throw new SgfParsingException("Input cannot be empty");
        }

        int pos = 0;
        // Skip whitespace to find the first '('
        while (pos < input.length() && input.charAt(pos) != '(') {
            pos++;
        }

        if (pos >= input.length() || input.charAt(pos) != '(') {
            throw new SgfParsingException("Tree cannot be parsed without beginning parentheses");
        }

        SgfNode node = parseNode(input, pos);
        return node;
    }

    private SgfNode parseNode(String input, int pos) throws SgfParsingException {
        // pos points to '('
        if (input.charAt(pos) != '(') {
            throw new SgfParsingException("Expected '(' at position " + pos);
        }

        pos++; // Move past '('
        SgfNode node = new SgfNode();

        // Parse properties until we hit ';' or ')'
        boolean hasProperty = false;
        while (pos < input.length() && input.charAt(pos) != ')') {
            if (input.charAt(pos) == ';') {
                // Start of a child node
                pos++; // Move past ';'
                SgfNode child = parseNode(input, pos);
                node.addChild(child);
                pos = getEndPosition(input, pos);
            } else if (input.charAt(pos) == '(') {
                // Start of a variation
                SgfNode child = parseNode(input, pos);
                node.addChild(child);
                pos = getEndPosition(input, pos);
            } else {
                // Parse a property
                int newPos = parseProperty(input, pos, node);
                pos = newPos;
                hasProperty = true;
            }
        }

        if (!hasProperty) {
            throw new SgfParsingException("Node must either be empty or contain properties");
        }

        // Move past ')'
        if (pos < input.length() && input.charAt(pos) == ')') {
            pos++; // Move past ')'
        }

        return node;
    }

    private int getEndPosition(String input, int pos) throws SgfParsingException {
        // Find the matching closing parenthesis
        int depth = 1;
        while (pos < input.length() && depth > 0) {
            char c = input.charAt(pos);
            if (c == '(') {
                depth++;
            } else if (c == ')') {
                depth--;
            }
            if (depth == 0) {
                return pos + 1;
            }
            pos++;
        }
        throw new SgfParsingException("Unbalanced parentheses");
    }

    private int parseProperty(String input, int pos, SgfNode node) throws SgfParsingException {
        // Parse the key (must be uppercase letters)
        int keyStart = pos;
        while (pos < input.length() && Character.isLetter(input.charAt(pos))) {
            pos++;
        }

        if (pos == keyStart) {
            throw new SgfParsingException("Property must be present with a key");
        }

        String key = input.substring(keyStart, pos);

        // Key must be uppercase
        for (int i = 0; i < key.length(); i++) {
            if (!Character.isUpperCase(key.charAt(i))) {
                throw new SgfParsingException("Property must be in uppercase");
            }
        }

        if (key.isEmpty()) {
            throw new SgfParsingException("Property must be present with a key");
        }

        // Parse values
        while (pos < input.length() && input.charAt(pos) == '[') {
            pos++; // Move past '['
            StringBuilder value = new StringBuilder();

            while (pos < input.length() && input.charAt(pos) != ']') {
                char c = input.charAt(pos);
                if (c == '\\') {
                    // Escape character
                    if (pos + 1 < input.length()) {
                        char next = input.charAt(pos + 1);
                        if (next == '\n') {
                            // Newline after backslash is removed
                            pos += 2;
                            continue;
                        } else if (Character.isWhitespace(next)) {
                            // Whitespace after backslash becomes space
                            value.append(' ');
                            pos += 2;
                            continue;
                        } else {
                            // Other character after backslash is inserted as-is
                            value.append(next);
                            pos += 2;
                            continue;
                        }
                    } else {
                        throw new SgfParsingException("Dangling escape");
                    }
                } else if (c == '\n') {
                    // Newline not after backslash remains
                    value.append(c);
                    pos++;
                } else if (Character.isWhitespace(c)) {
                    // Other whitespace becomes space
                    value.append(' ');
                    pos++;
                } else {
                    value.append(c);
                    pos++;
                }
            }

            if (pos >= input.length()) {
                throw new SgfParsingException("Missing closing bracket");
            }

            pos++; // Move past ']'
            node.addProperty(key, value.toString());
        }

        return pos;
    }
}
