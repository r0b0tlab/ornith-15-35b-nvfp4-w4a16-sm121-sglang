Satellite.java
```
import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;

public class Satellite {
    // Node class representing a tree node
    private static class Node {
        char value;
        Node left;
        Node right;
        
        Node(char value) {
            this.value = value;
        }
    }
    
    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {
        // Check if both traversals have the same length
        if (preorderInput.size() != inorderInput.size()) {
            throw new IllegalArgumentException("Both traversals must have the same length");
        }
        
        // Check if both traversals contain the same elements
        if (preorderInput.size() == 0) {
            return new Tree(null);
        }
        
        // Create a map for quick lookup of in-order positions
        Map<Character, Integer> inorderPositions = new HashMap<>();
        for (int i = 0; i < inorderInput.size(); i++) {
            char c = inorderInput.get(i);
            if (inorderPositions.containsKey(c)) {
                throw new IllegalArgumentException("Duplicate elements not allowed");
            }
            inorderPositions.put(c, i);
        }
        
        // Verify both traversals contain the same elements
        for (char c : preorderInput) {
            if (!inorderPositions.containsKey(c)) {
                throw new IllegalArgumentException("Traversals contain different elements");
            }
        }
        
        // Build the tree
        int[] preorderIndex = {0};
        Node root = buildTree(preorderInput, inorderPositions, 0, inorderInput.size() - 1, preorderIndex);
        
        // Create the Tree object and attach the root
        return new Tree(root);
    }
    
    private Node buildTree(List<Character> preorder, Map<Character, Integer> inorderPositions, 
                          int inStart, int inEnd, int[] preorderIndex) {
        if (inStart > inEnd) {
            return null;
        }
        
        // Create root node from current pre-order element
        char rootValue = preorder.get(preorderIndex[0]);
        preorderIndex[0]++;
        
        Node node = new Node(rootValue);
        
        // If no subtree, return the node
        if (inStart == inEnd) {
            return node;
        }
        
        // Find the position of root in in-order traversal
        int inIndex = inorderPositions.get(rootValue);
        
        // Build left and right subtrees
        node.left = buildTree(preorder, inorderPositions, inStart, inIndex - 1, preorderIndex);
        node.right = buildTree(preorder, inorderPositions, inIndex + 1, inEnd, preorderIndex);
        
        return node;
    }
}
