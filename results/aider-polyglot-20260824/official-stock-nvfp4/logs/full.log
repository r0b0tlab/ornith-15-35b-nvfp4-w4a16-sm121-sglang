        // Handle zero: if all digits are zero, use positive sign
        let is_zero = int_digits.iter().all(|&d| d == 0) && frac_digits.iter().all(|&d| d == 0);
        let final_sign = if is_zero { 1 } else { sign };

        Some(Decimal {
            sign: final_sign,
