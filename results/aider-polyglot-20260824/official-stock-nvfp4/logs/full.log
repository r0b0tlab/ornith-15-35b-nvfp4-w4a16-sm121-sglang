import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class BookStore {

    private static final double BASE_PRICE = 8.0;

    double calculateBasketCost(List<Integer> books) {
        if (books == null || books.isEmpty()) {
            return 0.0;
        }

        // Count occurrences of each book
        int[] counts = new int[5];
        for (Integer book : books) {
            counts[book - 1]++;
        }

        return calculateMinimumCost(counts);
    }

    private double calculateMinimumCost(int[] counts) {
        double totalCost = 0.0;

        while (anyBookRemaining(counts)) {
            // Find all unique books available
            List<Integer> availableBooks = new ArrayList<>();
            for (int i = 0; i < counts.length; i++) {
                if (counts[i] > 0) {
                    availableBooks.add(i);
                }
            }

            // Create a group with unique books
            int groupSize = availableBooks.size();
            totalCost += calculateGroupCost(groupSize);

            // Reduce counts for books in this group
            for (int bookIndex : availableBooks) {
                counts[bookIndex]--;
            }
        }

        // Handle the special case: replacing a group of 5 and a group of 3
        // with two groups of 4 is sometimes cheaper
        totalCost = optimizeCost(totalCost, counts);

        return totalCost;
    }

    private boolean anyBookRemaining(int[] counts) {
        for (int count : counts) {
            if (count > 0) {
                return true;
            }
        }
        return false;
    }

    private double calculateGroupCost(int groupSize) {
        double discount = 0.0;
        switch (groupSize) {
            case 2:
                discount = 0.05;
                break;
            case 3:
                discount = 0.10;
                break;
            case 4:
                discount = 0.20;
                break;
            case 5:
                discount = 0.25;
                break;
            default:
                discount = 0.0;
        }
        return groupSize * BASE_PRICE * (1.0 - discount);
    }

    private double optimizeCost(double baseCost, int[] counts) {
        // Count how many groups of 5 and 3 we created
        int groupOfFive = 0;
        int groupOfThree = 0;

        // We need to track this during grouping, so let's recompute
        int[] tempCounts = counts.clone();
        while (anyBookRemaining(tempCounts)) {
            List<Integer> availableBooks = new ArrayList<>();
            for (int i = 0; i < tempCounts.length; i++) {
                if (tempCounts[i] > 0) {
                    availableBooks.add(i);
                }
            }
            
            int groupSize = availableBooks.size();
            if (groupSize == 5) {
                groupOfFive++;
            } else if (groupSize == 3) {
                groupOfThree++;
            }
            
            for (int bookIndex : availableBooks) {
                tempCounts[bookIndex]--;
            }
        }

        // Each time we have both a group of 5 and a group of 3,
        // we can potentially save by replacing them with two groups of 4
        int optimizations = Math.min(groupOfFive, groupOfThree);
        if (optimizations > 0) {
            // Cost of one group of 5 + one group of 3
            double currentCost = calculateGroupCost(5) + calculateGroupCost(3);
            // Cost of two groups of 4
            double newCost = 2 * calculateGroupCost(4);
            // Apply savings
            baseCost += optimizations * (newCost - currentCost);
        }

        return baseCost;
    }
}
