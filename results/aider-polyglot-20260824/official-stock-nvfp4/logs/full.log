		} else if score == bestScore {
			resultHands = append(resultHands, hand)
		}
	}

	return resultHands, nil
}

func evaluateHand(hand string) (int, error) {
	cards := splitHand(hand)
	if len(cards) != 5 {
		return 0, errors.New("invalid hand: must contain exactly 5 cards")
	}

	ranks := make([]int, 5)
	suits := make([]byte, 5)

	for i, card := range cards {
		if len(card) < 2 {
			return 0, errors.New("invalid card: " + card)
		}

		rank, err := parseRank(card[0])
		if err != nil {
			return 0, err
		}

		suit, err := parseSuit(card[len(card)-1])
		if err != nil {
			return 0, err
		}

		ranks[i] = rank
		suits[i] = suit
	}

	// Check for flush
	flush := true
	for i := 1; i < 5; i++ {
		if suits[i] != suits[0] {
			flush = false
			break
		}
	}

	// Sort ranks descending
	sortedRanks := make([]int, 5)
	copy(sortedRanks, ranks)
	sort.Slice(sortedRanks, func(i, j int) bool {
		return sortedRanks[i] > sortedRanks[j]
	})

	// Check for straight (including wheel A-2-3-4-5)
	straightHigh := checkStraight(sortedRanks)

	// Count rank occurrences
	rankCounts := make(map[int]int)
	for _, rank := range ranks {
		rankCounts[rank]++
	}

	// Build groups: (rank, count) pairs, sorted by count desc then rank desc
	type group struct {
		rank  int
		count int
	}
	groups := make([]group, 0)
	for rank, count := range rankCounts {
		groups = append(groups, group{rank, count})
	}
	sort.Slice(groups, func(i, j int) bool {
		if groups[i].count != groups[j].count {
			return groups[i].count > groups[j].count
		}
		return groups[i].rank > groups[j].rank
	})

	switch {
	case straightHigh != 0 && flush:
		return 8000 + straightHigh, nil
	case groups[0].count == 4:
		return 7000 + groups[0].rank*10 + groups[1].rank, nil
	case groups[0].count == 3 && groups[1].count == 2:
		return 6000 + groups[0].rank*10 + groups[1].rank, nil
	case flush:
		return 5000 + rankValue(sortedRanks), nil
	case straightHigh != 0:
		return 4000 + straightHigh, nil
	case groups[0].count == 3:
		// Three of a kind + 2 kickers
		kickers := []int{}
		for _, g := range groups[1:] {
			kickers = append(kickers, g.rank)
		}
		return 3000 + groups[0].rank*100 + kickers[0]*10 + kickers[1], nil
	case groups[0].count == 2 && groups[1].count == 2:
		// Two pair
		return 2000 + groups[0].rank*100 + groups[1].rank*10 + groups[2].rank, nil
	case groups[0].count == 2:
		// One pair + 3 kickers
		kickers := []int{}
		for _, g := range groups[1:] {
			kickers = append(kickers, g.rank)
		}
		return 1000 + groups[0].rank*10000 + kickers[0]*100 + kickers[1]*10 + kickers[2], nil
	default:
		// High card
		return rankValue(sortedRanks), nil
	}
}

// rankValue combines sorted (descending) ranks into a comparable score.
func rankValue(sortedRanks []int) int {
	score := 0
	for _, r := range sortedRanks {
		score = score*16 + r
	}
	return score
}

// checkStraight determines the high card of a straight, or 0 if not a straight.
func checkStraight(sortedRanks []int) int {
	// sortedRanks is in descending order
	// Normal straight check
	normal := true
	for i := 0; i < 4; i++ {
		if sortedRanks[i] != sortedRanks[i+1]+1 {
			normal = false
			break
		}
	}
	if normal {
		return sortedRanks[0]
	}

	// Wheel check: A, 5, 4, 3, 2 (descending)
	if sortedRanks[0] == 14 &&
		sortedRanks[1] == 5 &&
		sortedRanks[2] == 4 &&
		sortedRanks[3] == 3 &&
		sortedRanks[4] == 2 {
		return 5
	}

	return 0
}

func splitHand(hand string) []string {
	var cards []string
	current := ""

	for _, ch := range hand {
		if ch == ' ' {
			if current != "" {
				cards = append(cards, current)
				current = ""
			}
		} else {
			current += string(ch)
		}
	}
	if current != "" {
		cards = append(cards, current)
	}

	return cards
}

func parseRank(char byte) (int, error) {
	switch char {
	case '2':
		return 2, nil
	case '3':
		return 3, nil
	case '4':
		return 4, nil
	case '5':
		return 5, nil
	case '6':
		return 6, nil
	case '7':
		return 7, nil
	case '8':
		return 8, nil
	case '9':
		return 9, nil
	case 'T':
		return 10, nil
	case 'J':
		return 11, nil
	case 'Q':
		return 12, nil
	case 'K':
		return 13, nil
	case 'A':
		return 14, nil
	default:
		return 0, errors.New("invalid rank: " + string(char))
	}
}

func parseSuit(char byte) (int, error) {
	switch char {
	case 'C':
		return 1, nil
	case 'D':
		return 2, nil
	case 'H':
		return 3, nil
	case 'S':
		return 4, nil
	default:
		return 0, errors.New("invalid suit: " + string(char))
	}
}
