pig_latin.py
```python
def translate(text):
    vowels = set("aeiou")
    words = text.split()
    translated_words = []
    
    for word in words:
        # Rule 1: begins with a vowel, or starts with "xr" or "yt"
        if word[0] in vowels or word.startswith("xr") or word.startswith("yt"):
            translated_words.append(word + "ay")
        else:
            # Find the position where the initial consonants end
            i = 0
            while i < len(word) and word[i] not in vowels:
                # Rule 4: consonants followed by "y" - treat "y" as a vowel
                if word[i] == "y" and i > 0:
                    break
                i += 1
            
            # Rule 3: consonants followed by "qu"
            if i > 0 and word[i-1] == "q" and i < len(word) and word[i] == "u":
                i += 1
            
            # Rule 2: move consonants to the end and add "ay"
            translated_words.append(word[i:] + word[:i] + "ay")
    
    return " ".join(translated_words)
```
