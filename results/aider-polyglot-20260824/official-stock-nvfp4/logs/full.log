```javascript
//
// This is only a SKELETON file for the 'Palindrome Products' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Palindromes {
  static generate(min, max) {
    if (min > max) {
      throw new Error('min must be greater than max');
    }

    let smallestPalindrome = null;
    let smallestFactors = [];
    let largestPalindrome = null;
    let largestFactors = [];

    // Find smallest palindrome
    for (let i = min; i <= max; i++) {
      for (let j = i; j <= max; j++) {
        const product = i * j;
        if (isPalindrome(product)) {
          if (smallestPalindrome === null || product < smallestPalindrome) {
            smallestPalindrome = product;
            smallestFactors = [[i, j]];
          } else if (product === smallestPalindrome) {
            smallestFactors.push([i, j]);
          }
        }
      }
      // Optimization: once we find a palindrome starting with i, 
      // no smaller palindrome can start with a larger first factor
      if (smallestPalindrome !== null) {
        break;
      }
    }

    // Find largest palindrome
    for (let i = max; i >= min; i--) {
      for (let j = max; j >= i; j--) {
        const product = i * j;
        // Prune: if this product is smaller than what we've found, skip
        if (largestPalindrome !== null && product < largestPalindrome) {
          break;
        }
        if (isPalindrome(product)) {
          if (largestPalindrome === null || product > largestPalindrome) {
            largestPalindrome = product;
            largestFactors = [[i, j]];
          } else if (product === largestPalindrome) {
            largestFactors.push([i, j]);
          }
        }
      }
      // Optimization: once we find a palindrome ending with i,
      // no larger palindrome can end with a smaller second factor
      if (largestPalindrome !== null) {
        break;
      }
    }

    return {
      smallest: smallestPalindrome !== null 
        ? { value: smallestPalindrome, factors: smallestFactors } 
        : null,
      largest: largestPalindrome !== null 
        ? { value: largestPalindrome, factors: largestFactors } 
        : null,
    };
  }
}

function isPalindrome(number) {
  const str = String(number);
  const len = str.length;
  for (let i = 0; i < Math.floor(len / 2); i++) {
    if (str[i] !== str[len - 1 - i]) {
      return false;
    }
  }
  return true;
}
```
