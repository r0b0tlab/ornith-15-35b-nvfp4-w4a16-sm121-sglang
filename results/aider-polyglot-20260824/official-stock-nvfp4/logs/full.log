promises.js
```javascript
//
// This is only a SKELETON file for the 'Promises' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const promisify = (callbackFunction, options = {}) => {
  return function (...args) {
    return new Promise((resolve, reject) => {
      callbackFunction.call(
        this,
        (error, ...rest) => {
          if (error) {
            reject(error);
          } else {
            resolve(rest.length > 1 ? rest : rest[0]);
          }
        },
        ...args
      );
    });
  };
};

export const all = (promises) => {
  return new Promise((resolve, reject) => {
    const results = [];
    let completed = 0;
    let hasRejected = false;

    if (!Array.isArray(promises) || promises.length === 0) {
      resolve(results);
      return;
    }

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then((value) => {
          if (hasRejected) return;
          results[index] = value;
          completed++;
          if (completed === promises.length) {
            resolve(results);
          }
        })
        .catch((error) => {
          hasRejected = true;
          reject(error);
        });
    });
  });
};

export const allSettled = (promises) => {
  return new Promise((resolve) => {
    const results = [];
    let completed = 0;

    if (!Array.isArray(promises) || promises.length === 0) {
      resolve(results);
      return;
    }

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then(
          (value) => {
            results[index] = { status: 'fulfilled', value };
            completed++;
            if (completed === promises.length) {
              resolve(results);
            }
          },
          (error) => {
            results[index] = { status: 'rejected', reason: error };
            completed++;
            if (completed === promises.length) {
              resolve(results);
            }
          }
        );
    });
  });
};

export const race = (promises) => {
  return new Promise((resolve, reject) => {
    if (!Array.isArray(promises) || promises.length === 0) {
      return;
    }

    promises.forEach((promise) => {
      Promise.resolve(promise)
        .then(
          (value) => resolve(value),
          (error) => reject(error)
        );
    });
  });
};

export const any = (promises) => {
  return new Promise((resolve, reject) => {
    const errors = [];
    let completed = 0;
    let hasRejected = false;

    if (!Array.isArray(promises) || promises.length === 0) {
      const aggregationError = new Error(
        'All promises were rejected'
      );
      aggregationError.name = 'AggregationError';
      aggregationError.errors = errors;
      reject(aggregationError);
      return;
    }

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then(
          (value) => resolve(value),
          (error) => {
            errors[index] = error;
            completed++;
            if (completed === promises.length) {
              const aggregationError = new Error(
                'All promises were rejected'
              );
              aggregationError.name = 'AggregationError';
              aggregationError.errors = errors;
              reject(aggregationError);
            }
          }
        );
    });
  });
};
```
