Transpose.java
```java
public class Transpose {
    public String transpose(String toTranspose) {
        if (toTranspose == null || toTranspose.isEmpty()) {
            return toTranspose;
        }
        
        String[] rows = toTranspose.split("\n", -1);
        
        // Find the maximum length among all rows
        int maxLength = 0;
        for (String row : rows) {
            if (row.length() > maxLength) {
                maxLength = row.length();
            }
        }
        
        StringBuilder result = new StringBuilder();
        
        // For each column position
        for (int col = 0; col < maxLength; col++) {
            StringBuilder newRow = new StringBuilder();
            
            // For each row
            for (int row = 0; row < rows.length; row++) {
                if (col < rows[row].length()) {
                    // Add the character at this position
                    newRow.append(rows[row].charAt(col));
                } else {
                    // Check if there are any non-space characters after this position in the same column
                    boolean hasNonSpaceBelow = false;
                    for (int r = row + 1; r < rows.length; r++) {
                        if (col < rows[r].length() && rows[r].charAt(col) != ' ') {
                            hasNonSpaceBelow = true;
                            break;
                        }
                    }
                    
                    // Pad with space if there are non-space characters below
                    if (hasNonSpaceBelow) {
                        newRow.append(' ');
                    }
                }
            }
            
            // Add the new row to result
            if (col > 0) {
                result.append("\n");
            }
            result.append(newRow);
        }
        
        return result.toString();
    }
}
```
