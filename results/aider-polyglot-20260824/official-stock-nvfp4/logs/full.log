Hangman.java
```java
import io.reactivex.Observable;
import java.util.*;

class Hangman {

    Observable<Output> play(Observable<String> words, Observable<String> letters) {
        return words.flatMap(word ->
            letters
                .startWith("")
                .scan(
                    new GameState(word, new HashSet<>(), new HashSet<>(), false),
                    (gameState, letter) -> gameState.next(letter)
                )
                .map(gameState -> buildOutput(word, gameState))
        );
    }

    private Output buildOutput(String word, GameState state) {
        StringBuilder discovered = new StringBuilder();
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            discovered.append(state.guessed.contains(String.valueOf(c)) ? c : ' ');
        }

        Status status = determineStatus(word, state);
        List<Part> parts = buildParts(state.misses.size());

        return new Output(
            word,
            discovered.toString(),
            state.guessed,
            state.misses,
            parts,
            status
        );
    }

    private Status determineStatus(String word, GameState state) {
        if (state.lost) {
            return Status.LOSE;
        }
        String discovered = "";
        for (int i = 0; i < word.length(); i++) {
            discovered += state.guessed.contains(String.valueOf(word.charAt(i)))
                ? word.charAt(i)
                : " ";
        }
        return discovered.replaceAll(" ", "").isEmpty() ? Status.WIN : Status.PLAYING;
    }

    private List<Part> buildParts(int missCount) {
        List<Part> parts = new ArrayList<>();
        if (missCount >= 1) parts.add(Part.HEAD);
        if (missCount >= 2) parts.add(Part.BODY);
        if (missCount >= 3) parts.add(Part.LEFT_ARM);
        if (missCount >= 4) parts.add(Part.RIGHT_ARM);
        if (missCount >= 5) parts.add(Part.LEFT_LEG);
        if (missCount >= 6) parts.add(Part.RIGHT_LEG);
        return parts;
    }

    private static class GameState {
        final String word;
        final Set<String> guessed;
        final Set<String> misses;
        final boolean lost;

        GameState(String word, Set<String> guessed, Set<String> misses, boolean lost) {
            this.word = word;
            this.guessed = guessed;
            this.misses = misses;
            this.lost = lost;
        }

        GameState next(String letter) {
            if (letter == null || letter.isEmpty()) {
                return this;
            }
            
            if (lost) {
                return this;
            }
            
            Set<String> newGuessed = new HashSet<>(guessed);
            Set<String> newMisses = new HashSet<>(misses);
            boolean newLost = lost;
            
            if (word.contains(letter)) {
                newGuessed.add(letter);
            } else {
                newMisses.add(letter);
                if (newMisses.size() >= 7) {
                    newLost = true;
                }
            }
            
            return new GameState(word, newGuessed, newMisses, newLost);
        }
    }

}
```

