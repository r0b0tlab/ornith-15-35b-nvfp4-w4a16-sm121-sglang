import java.util.Random;

public class MazeGenerator {

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, new Random().nextLong());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        Random random = new Random(seed);
        
        // Create the maze grid with all walls initially
        char[][] maze = new char[2 * rows + 1][2 * columns + 1];
        
        // Initialize all cells as walls
        for (int i = 0; i < maze.length; i++) {
            for (int j = 0; j < maze[0].length; j++) {
                maze[i][j] = '█';
            }
        }
        
        // Recursive backtracking algorithm
        // Start from cell (0, 0)
        boolean[][] visited = new boolean[rows][columns];
        carveMaze(maze, visited, 0, 0, random, rows, columns);
        
        // Add entrance and exit
        maze[1][0] = '⇨';  // Entrance on the left
        maze[2 * rows][2 * columns - 1] = '☤';  // Exit on the right
        
        return maze;
    }
    
    private void carveMaze(char[][] maze, boolean[][] visited, int col, int row, 
                           Random random, int rows, int columns) {
        visited[row][col] = true;
        
        // Define possible directions: up, right, down, left
        int[][] directions = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
        
        // Shuffle directions
        for (int i = directions.length - 1; i > 0; i--) {
            int j = random.nextInt(i + 1);
            int[] temp = directions[i];
            directions[i] = directions[j];
            directions[j] = temp;
        }
        
        for (int[] dir : directions) {
            int nextCol = col + dir[0];
            int nextRow = row + dir[1];
            
            // Check bounds
            if (nextCol >= 0 && nextCol < columns && nextRow >= 0 && nextRow < rows 
                && !visited[nextRow][nextCol]) {
                
                // Remove wall between current cell and next cell
                if (dir[0] == 1) {
                    maze[row * 2 + 1][col * 2 + 2] = ' ';
                } else if (dir[0] == -1) {
                    maze[row * 2 + 1][col * 2] = ' ';
                } else if (dir[1] == 1) {
                    maze[row * 2 + 2][col * 2 + 1] = ' ';
                } else if (dir[1] == -1) {
                    maze[row * 2][col * 2 + 1] = ' ';
                }
                
                // Recurse into next cell
                carveMaze(maze, visited, nextCol, nextRow, random, rows, columns);
            }
        }
    }
}
