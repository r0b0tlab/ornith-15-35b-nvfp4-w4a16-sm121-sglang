            lyrics.add(currentNumber + " green " + currentBottleWord + " hanging on the wall,");
            lyrics.add("And if one green bottle should accidentally fall,");
            lyrics.add("There'll be " + nextNumber + " green " + nextBottleWord + " hanging on the wall.");

            if (i < takeDown - 1) {
                lyrics.add("");
            }
        }

