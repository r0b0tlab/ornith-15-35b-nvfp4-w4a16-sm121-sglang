export class Bowling {
  constructor() {
    this._rolls = [];
    this._gameOver = false;
  }

  roll(pins) {
    if (this._gameOver) {
      throw new Error('Game is already complete');
    }
    if (pins < 0) {
      throw new Error('Roll cannot be negative');
    }
    if (pins > 10) {
      throw new Error('Roll cannot exceed 10');
    }

    this._rolls.push(pins);

    this._checkGameComplete();
  }

  score() {
