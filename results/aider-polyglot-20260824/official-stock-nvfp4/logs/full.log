```
#include "crypto_square.h"
#include <string>
#include <vector>
#include <cmath>
#include <cctype>

namespace crypto_square {

std::string ciphertext(const std::string& plaintext) {
    // Normalize: remove spaces and punctuation, downcase
    std::string normalized;
    for (char c : plaintext) {
        if (std::isalnum(static_cast<unsigned char>(c))) {
            normalized += std::tolower(static_cast<unsigned char>(c));
        }
    }
    
    int length = normalized.length();
    if (length == 0) {
        return "";
    }
    
    // Determine rectangle dimensions
    int c = std::ceil(std::sqrt(length));
    int r = std::ceil(length / static_cast<double>(c));
    
    // Build the rectangle and read down columns
    std::string result;
    for (int col = 0; col < c; col++) {
        if (col > 0) {
            result += " ";
        }
        for (int row = 0; row < r; row++) {
            int index = row * c + col;
            if (index < length) {
                result += normalized[index];
            } else {
                // Pad with space for incomplete chunks
                result += " ";
            }
        }
    }
    
    return result;
}

}  // namespace crypto_square
```
