hexadecimal.go
```go
package hexadecimal

import "errors"

func ParseHex(in string, out *int64, errCase string) error {
	if len(in) == 0 {
		return errors.New("empty input")
	}

	var result int64 = 0

	for _, char := range in {
		var value int64

		switch {
		case char >= '0' && char <= '9':
			value = int64(char - '0')
		case char >= 'a' && char <= 'f':
			value = int64(char-'a') + 10
		case char >= 'A' && char <= 'F':
			value = int64(char-'A') + 10
		default:
			return fmt.Errorf("invalid hexadecimal character: %q", char)
		}

		result = result*16 + value
	}

	*out = result
	return nil
}
