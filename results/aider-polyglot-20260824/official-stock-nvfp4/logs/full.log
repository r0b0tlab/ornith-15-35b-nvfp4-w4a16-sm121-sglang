#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    InvalidRowCount(usize),
    InvalidColumnCount(usize),
}

pub fn convert(input: &str) -> Result<String, Error> {
    // Split input into lines
    let lines: Vec<&str> = input.lines().collect();
    
    // Validate row count must be multiple of 4
    if lines.len() % 4 != 0 {
        return Err(Error::InvalidRowCount(lines.len()));
    }
    
    // Process each group of 4 rows
    let mut results = Vec::new();
    
    for row_group in lines.chunks(4) {
        // Validate column count must be multiple of 3
        let row_width = row_group[0].len();
        if row_width % 3 != 0 {
            return Err(Error::InvalidColumnCount(row_width));
        }
        
        // Check all rows in group have same width
        for row in row_group {
            if row.len() != row_width {
                return Err(Error::InvalidColumnCount(row.len()));
            }
        }
        
        // Process each digit in this row group
        let mut line_result = String::new();
        for col in (0..row_width).step_by(3) {
            // Extract the 3x3 pattern (plus 4th blank row) for this digit
            let digit_rows: Vec<String> = row_group.iter()
                .map(|row| row[col..col+3].to_string())
                .collect();
            
            // Recognize the digit
            let digit = recognize_digit(&digit_rows);
            line_result.push(digit);
        }
        
        results.push(line_result);
    }
    
    // Join multiple lines with commas
    Ok(results.join(","))
}

// Recognize a single digit from its 4-row representation
fn recognize_digit(rows: &[String]) -> char {
    // Define the patterns for each digit (each is 12 chars: 3x4 grid flattened)
    let patterns = [
        // zero
        (" _ ", " | ", "|_ ", "   "),
        // one
        ("   ", " | ", " | ", "   "),
        // two
        (" _ ", " _| ", "|_ ", "   "),
        // three
        (" _ ", " _| ", " _| ", "   "),
        // four
        ("   ", "|_| ", " | ", "   "),
        // five
        (" _ ", "|_ ", " _| ", "   "),
        // six
        (" _ ", "|_ ", "|_| ", "   "),
        // seven
        (" _ ", " | ", " | ", "   "),
        // eight
        (" _ ", "|_| ", "|_| ", "   "),
        // nine
        (" _ ", "|_| ", " _| ", "   "),
    ];
    
    // Compare against each pattern
    for (idx, (row0, row1, row2, row3)) in patterns.iter().enumerate() {
        if rows[0] == *row0 && rows[1] == *row1 && rows[2] == *row2 && rows[3] == *row3 {
            return (b'0' + idx as u8) as char;
        }
    }
    
    // No match found - return '?'
    '?'
}
