    private static final int ALPHABET_LENGTH = 26;

    public String encode(String text, int coefficient1, int coefficient2){
        if (!isCoprime(coefficient1, ALPHABET_LENGTH)) {
            throw new IllegalArgumentException("Error: keyA and alphabet size must be coprime.");
        }
        
        StringBuilder result = new StringBuilder();
        int count = 0;
        
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int i = Character.toLowerCase(c) - 'a';
                int encrypted = (coefficient1 * i + coefficient2) % ALPHABET_LENGTH;
                result.append((char) (encrypted + 'a'));
                count++;
                if (count % 5 == 0) {
                    result.append(' ');
                }
            } else if (Character.isDigit(c)) {
                result.append(c);
                count++;
                if (count % 5 == 0) {
                    result.append(' ');
                }
            }
        }
        
        // Remove trailing space if present
        if (result.length() > 0 && result.charAt(result.length() - 1) == ' ') {
            result.deleteCharAt(result.length() - 1);
        }
        
        return result.toString();
    }

    public String decode(String text, int coefficient1, int coefficient2){
        if (!isCoprime(coefficient1, ALPHABET_LENGTH)) {
            throw new IllegalArgumentException("Error: keyA and alphabet size must be coprime.");
        }
        
        int inverse = modInverse(coefficient1, ALPHABET_LENGTH);
        StringBuilder result = new StringBuilder();
        
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int y = Character.toLowerCase(c) - 'a';
                int decrypted = (inverse * ((y - coefficient2) % ALPHABET_LENGTH + ALPHABET_LENGTH)) % ALPHABET_LENGTH;
                result.append((char) (decrypted + 'a'));
            } else if (Character.isDigit(c)) {
                result.append(c);
            }
        }
        
        return result.toString();
    }
    
    private boolean isCoprime(int a, int m) {
        return gcd(a, m) == 1;
    }
    
    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
    
    private int modInverse(int a, int m) {
        a = a % m;
        if (a < 0) {
            a += m;
        }
        for (int x = 1; x < m; x++) {
            if ((a * x) % m == 1) {
                return x;
            }
        }
        throw new IllegalArgumentException("Error: keyA and alphabet size must be coprime.");
    }
}
