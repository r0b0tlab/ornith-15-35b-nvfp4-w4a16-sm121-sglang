package hexadecimal

import (
	"testing"
)

func TestParseHexValid(t *testing.T) {
	tests := []struct {
		input    string
		expected int64
	}{
		{"0", 0},
		{"1", 1},
		{"c", 12},
		{"b", 11},
		{"f", 15},
		{"16", 22},
		{"216", 534},
		{"10af8c", 1093256},
		{"41e32f", 4318063},
	}

	for _, test := range tests {
		result, err := ParseHex(test.input)
		if err != nil {
			t.Errorf("ParseHex(%q) unexpected error: %v", test.input, err)
		}
		if result != test.expected {
			t.Errorf("ParseHex(%q) = %d, want %d", test.input, result, test.expected)
		}
	}
}

func TestParseHexInvalid(t *testing.T) {
	tests := []string{
		"carrot",
		"xyz",
		"123abc",
	}

	for _, input := range tests {
		_, err := ParseHex(input)
		if err == nil {
			t.Errorf("ParseHex(%q) expected error, got nil", input)
		}
	}
}

func TestHandleErrors(t *testing.T) {
	// Test that HandleErrors properly formats error messages
	result, err := HandleErrors("10af8c")
	if err != nil {
		t.Errorf("HandleErrors unexpected error: %v", err)
	}
	if result != 1093256 {
		t.Errorf("HandleErrors = %d, want 1093256", result)
	}
}
