        this.startBucket = startBucket;

        solve();
    }

    private void solve() {
        // Special case: if desired equals the start bucket capacity, 
        // it's just one move (fill the start bucket)
        if (startBucket.equals("one") && bucketOneCap == desiredLiters) {
            totalMoves = 1;
            finalBucket = "one";
            otherBucketLiters = 0;
            return;
        }
        if (startBucket.equals("two") && bucketTwoCap == desiredLiters) {
