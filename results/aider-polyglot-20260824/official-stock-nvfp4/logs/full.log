        if int_part.is_empty() && frac_part.is_empty() {
            return None;
        }

        // Parse integer part
        let mut int_digits = Vec::new();
        for c in int_part.chars() {
            match c.to_digit(10) {
                Some(d) => int_digits.push(d as u8),
                None => return None,
            }
        }

        // Parse fractional part
        let mut frac_digits = Vec::new();
        for c in frac_part.chars() {
            match c.to_digit(10) {
                Some(d) => frac_digits.push(d as u8),
                None => return None,
            }
        }

        // Handle case where both parts are empty
        if int_digits.is_empty() && frac_digits.is_empty() {
            return None;
        }

        // Normalize: ensure at least one integer digit
        if int_digits.is_empty() {
            int_digits.push(0);
        }

        // Remove trailing zeros from fractional part
        while frac_digits.len() > 1 && *frac_digits.last().unwrap() == 0 {
            frac_digits.pop();
        }
        // If all fractional digits are zero, clear them
        if frac_digits.iter().all(|&d| d == 0) {
            frac_digits.clear();
        }

        // Handle zero: if all digits are zero, use positive sign
        let is_zero = int_digits.iter().all(|&d| d == 0) && frac_digits.iter().all(|&d| d == 0);
        let final_sign = if is_zero { 1 } else { sign };

        Some(Decimal {
            sign: final_sign,
            int_digits,
            frac_digits,
        })
    }

    // Compare magnitudes (ignoring sign): returns Ordering
    fn compare_magnitude(&self, other: &Decimal) -> std::cmp::Ordering {
        // Compare integer parts first
        let int_cmp = compare_digit_vectors(&self.int_digits, &other.int_digits);
        if int_cmp != std::cmp::Ordering::Equal {
            return int_cmp;
        }

        // Then compare fractional parts
        compare_digit_vectors(&self.frac_digits, &other.frac_digits)
    }
