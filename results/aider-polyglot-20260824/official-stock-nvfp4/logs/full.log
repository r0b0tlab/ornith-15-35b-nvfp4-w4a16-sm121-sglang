 #include "circular_buffer.h"
 
 namespace circular_buffer {
 
+circular_buffer::circular_buffer(std::size_t capacity)
+    : buffer_(capacity), head_(0), count_(0), capacity_(capacity) {
+}
+
+void circular_buffer::write(int value) {
+    if (count_ == capacity_) {
+        throw std::out_of_range("Buffer is full");
+    }
+
+    std::size_t write_pos = (head_ + count_) % capacity_;
+    buffer_[write_pos] = value;
+    count_++;
+}
+
+int circular_buffer::read() {
+    if (count_ == 0) {
+        throw std::out_of_range("Buffer is empty");
+    }
+
+    int value = buffer_[head_];
+    head_ = (head_ + 1) % capacity_;
+    count_--;
+    return value;
+}
+
+void circular_buffer::clear() {
+    head_ = 0;
+    count_ = 0;
