import itertools


def drinks_water():
    return solve()[0]


def owns_zebra():
    return solve()[1]


def solve():
    houses = range(5)  # 0, 1, 2, 3, 4 (left to right)
    colors = ['red', 'ivory', 'yellow', 'green', 'blue']
    nationalities = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese']
    pets = ['dog', 'snail', 'fox', 'horse', 'zebra']
    beverages = ['coffee', 'tea', 'milk', 'orange_juice', 'water']
    hobbies = ['dancing', 'painter', 'reading', 'football', 'chess']

    # Constraint 9: The person in the middle house drinks milk
    # Constraint 10: The Norwegian lives in the first house
    
    # We'll iterate through permutations but with smart ordering to prune early
    
    # Since the Norwegian lives in house 0 (constraint 10),
    # and the Norwegian lives next to the blue house (constraint 15),
    # the blue house must be house 1.
    # The green house is immediately to the right of the ivory house (constraint 6).
    # The Englishman lives in the red house (constraint 2).
    
    # Let's try all permutations of colors, but with constraints applied
    for color_perm in itertools.permutations(colors):
        # Constraint 6: green is immediately right of ivory
        if color_perm.index('green') != color_perm.index('ivory') + 1:
            continue
        # Constraint 15: Norwegian (house 0) next to blue
        if abs(color_perm.index('blue') - 0) != 1:
            continue
        
        # Now assign nationalities
        for nat_perm in itertools.permutations(nationalities):
            # Constraint 10: Norwegian in house 0
            if nat_perm[0] != 'Norwegian':
                continue
            # Constraint 2: Englishman in red house
            if nat_perm[color_perm.index('red')] != 'Englishman':
                continue
            
            # Now assign beverages
            for bev_perm in itertools.permutations(beverages):
                # Constraint 9: milk in middle house (index 2)
                if bev_perm[2] != 'milk':
                    continue
                # Constraint 4: coffee in green house
                if bev_perm[color_perm.index('green')] != 'coffee':
                    continue
                # Constraint 5: Ukrainian drinks tea
                if bev_perm[nat_perm.index('Ukrainian')] != 'tea':
                    continue
                
                # Now assign hobbies
                for hobby_perm in itertools.permutations(hobbies):
                    # Constraint 13: football player drinks orange juice
                    if hobby_perm[bev_perm.index('orange_juice')] != 'football':
                        continue
                    # Constraint 7: snail owner dances
                    # Constraint 8: yellow house is painter
                    # Constraint 14: Japanese plays chess
                    if hobby_perm[color_perm.index('yellow')] != 'painter':
                        continue
                    if hobby_perm[nat_perm.index('Japanese')] != 'chess':
                        continue
                    
                    # Now assign pets
                    for pet_perm in itertools.permutations(pets):
                        # Constraint 3: Spaniard owns dog
                        if pet_perm[nat_perm.index('Spaniard')] != 'dog':
                            continue
                        # Constraint 7: snail owner dances
                        if pet_perm[hobby_perm.index('dancing')] != 'snail':
                            continue
                        
                        # Constraint 11: reader next to fox owner
                        reader_idx = hobby_perm.index('reading')
                        fox_idx = pet_perm.index('fox')
                        if abs(reader_idx - fox_idx) != 1:
                            continue
                        
                        # Constraint 12: painter next to horse owner
                        painter_idx = hobby_perm.index('painter')
                        horse_idx = pet_perm.index('horse')
                        if abs(painter_idx - horse_idx) != 1:
                            continue
                        
                        # All constraints satisfied!
                        # Find who drinks water and owns zebra
                        water_drinker = nat_perm[bev_perm.index('water')]
                        zebra_owner = nat_perm[pet_perm.index('zebra')]
                        
                        return water_drinker, zebra_owner
    
    return None, None
```

I've implemented a solution that:
1. Uses `itertools.permutations` to explore possible arrangements
2. Applies constraints early in the search to prune invalid branches
3. Returns the nationality of the water drinker and zebra owner

The solution uses backtracking by iterating through permutations in a specific order (colors, then nationalities, then beverages, then hobbies, then pets) and applying constraints at each level to eliminate invalid combinations as early as possible. This makes the search much more efficient than brute-forcing all 24 billion possibilities.
