response:
Looking at the exercism binary-search-tree exercise, the expected interface uses `data()` to return the in-order traversal (sorted values). The test suite expects a `data()` method, not the custom method names I've used.

binary_search_tree.h
```
#if !defined(BINARY_SEARCH_TREE_H)
#define BINARY_SEARCH_TREE_H

#include <memory>
#include <vector>
#include <iostream>

namespace binary_search_tree {

class binary_search_tree {
public:
    binary_search_tree() = default;

    void insert(int value) {
        if (root_ == nullptr) {
            root_ = std::make_unique<Node>(value);
            return;
        }
        insert_node(root_.get(), value);
    }

    std::vector<int> data() const {
        std::vector<int> result;
        in_order(root_.get(), result);
        return result;
    }

private:
    struct Node {
        int value;
        std::unique_ptr<Node> left;
        std::unique_ptr<Node> right;
        Node(int v) : value(v) {}
    };

    std::unique_ptr<Node> root_;

    void insert_node(Node* node, int value) {
        if (value <= node->value) {
            if (node->left == nullptr) {
                node->left = std::make_unique<Node>(value);
            } else {
                insert_node(node->left.get(), value);
            }
        } else {
            if (node->right == nullptr) {
                node->right = std::make_unique<Node>(value);
            } else {
                insert_node(node->right.get(), value);
            }
        }
    }

    void in_order(Node* node, std::vector<int>& result) const {
        if (node == nullptr) return;
        in_order(node->left.get(), result);
        result.push_back(node->value);
        in_order(node->right.get(), result);
    }
};

}  // namespace binary_search_tree

#endif // BINARY_SEARCH_TREE_H
```
