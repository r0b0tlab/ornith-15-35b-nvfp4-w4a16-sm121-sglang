```
//
// This is only a SKELETON file for the 'Killer Sudoku Helper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const combinations = (cage) => {
  const { sum, size, restricted = [] } = cage;
  const results = [];
  
  // Helper function to find all valid combinations
  const findCombinations = (start, target, current) => {
    if (current.length === size) {
      if (target === 0) {
        results.push([...current]);
      }
      return;
    }
    
    for (let i = start; i <= 9; i++) {
      // Skip if digit is restricted
      if (restricted.includes(i)) continue;
      
      // Skip if digit would exceed remaining sum
      if (i > target) break;
      
      current.push(i);
      findCombinations(i + 1, target - i, current);
      current.pop();
    }
  };
  
  findCombinations(1, sum, []);
  
  return results;
};
