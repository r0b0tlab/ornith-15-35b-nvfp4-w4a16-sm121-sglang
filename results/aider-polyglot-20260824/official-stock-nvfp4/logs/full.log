```java
import io.reactivex.Observable;
import java.util.*;

class Hangman {

    private static final int MAX_MISSES = 6;

    Observable<Output> play(Observable<String> words, Observable<String> letters) {
        return words.flatMap(word -> 
            Observable.combineLatest(
                Observable.just(word),
                letters.startWith("")
            ).scan(
                new State(word, new HashSet<>(), new HashSet<>(), false, false),
                (state, letter) -> state.update(letter)
            ).map(state -> toOutput(word, state))
        );
    }

    private Output toOutput(String word, State state) {
        StringBuilder discovered = new StringBuilder();
        for (char c : word.toCharArray()) {
            discovered.append(state.guessed.contains(String.valueOf(c)) ? c : ' ');
        }
        
        Status status = state.lost ? Status.LOSE 
            : discovered.toString().replace(" ", "").isEmpty() ? Status.WIN 
            : Status.PLAYING;
        
        List<Part> parts = new ArrayList<>();
        int misses = state.misses.size();
        if (misses > 0) parts.add(Part.FEET);
        if (misses > 1) parts.add(Part.LEGS);
        if (misses > 2) parts.add(Part.KNEES);
        if (misses > 3) parts.add(Part.WAIST);
        if (misses > 4) parts.add(Part.HEAD);
        if (misses > 5) parts.add(Part.HANDS);
        
        return new Output(
            word,
            discovered.toString(),
            state.guessed,
            state.misses,
            parts,
            status
        );
    }

    private static class State {
        final String word;
        final Set<String> guessed;
        final Set<String> misses;
        boolean lost;

        State(String word, Set<String> guessed, Set<String> misses, boolean lost) {
            this.word = word;
            this.guessed = guessed;
            this.misses = misses;
            this.lost = lost;
        }

        State update(String letter) {
            if (letter == null || letter.isEmpty()) {
                return this;
            }
            
            Set<String> newGuessed = new HashSet<>(guessed);
            Set<String> newMisses = new HashSet<>(misses);
            boolean newLost = lost;
            
            if (!word.contains(letter)) {
                newMisses.add(letter);
                if (newMisses.size() > 5) {
                    newLost = true;
                }
            } else {
                newGuessed.add(letter);
            }
            
            return new State(word, newGuessed, newMisses, newLost);
        }
    }

}
```

