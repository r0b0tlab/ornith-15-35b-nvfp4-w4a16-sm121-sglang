OpticalCharacterReader.java
```java
import java.util.List;
import java.util.ArrayList;

class OpticalCharacterReader {

    private static final String[] DIGITS = {
        " _ | ||_|   ", // 0
        "     |  |   ", // 1
        " _  _||_    ", // 2
        " _  _| _|   ", // 3
        "   |_|  |   ", // 4
        " |_  _||_|  ", // 5
        " |_  |_|   ", // 6
        " _   |  |   ", // 7
        " |_ ||_|_   ", // 8
        " |_ ||_||_  " // 9
    };

    String parse(List<String> input) {
        // Validate input size
        if (input.size() % 4 != 0) {
            throw new IllegalArgumentException("Number of input rows must be a positive multiple of 4");
        }

        // Validate all rows have the same length (must be multiple of 3)
        int width = 0;
        for (String row : input) {
            if (width == 0) {
                width = row.length();
            }
            if (row.length() != width) {
                throw new IllegalArgumentException("All rows must have the same length");
            }
        }

        if (width % 3 != 0) {
            throw new IllegalArgumentException("Number of input columns must be a positive multiple of 3");
        }

        StringBuilder result = new StringBuilder();

        // Process each group of 4 rows
        for (int startRow = 0; startRow < input.size(); startRow += 4) {
            if (startRow > 0) {
                result.append(",");
            }

            // Process each digit in this group of rows
            for (int digitIndex = 0; digitIndex < width / 3; digitIndex++) {
                int colStart = digitIndex * 3;

                // Extract the 3x4 pattern for this digit
                StringBuilder pattern = new StringBuilder();
                for (int rowOffset = 0; rowOffset < 4; rowOffset++) {
                    String row = input.get(startRow + rowOffset);
                    pattern.append(row, colStart, colStart + 3);
                }

                String patternStr = pattern.toString();

                // Find the matching digit
                int matchIndex = -1;
                for (int i = 0; i < DIGITS.length; i++) {
                    if (DIGITS[i].equals(patternStr)) {
                        matchIndex = i;
                        break;
                    }
                }

                // Append the recognized digit or '?' if not recognized
                if (matchIndex >= 0) {
                    result.append(matchIndex);
                } else {
                    result.append('?');
                }
            }
        }

        return result.toString();
    }
}
