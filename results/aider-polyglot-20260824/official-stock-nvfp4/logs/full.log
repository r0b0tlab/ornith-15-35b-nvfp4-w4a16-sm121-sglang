pub fn abbreviate(phrase: &str) -> String {
    // Replace hyphens with whitespace, remove all other punctuation
    let cleaned: String = phrase
        .chars()
        .map(|c| if c.is_whitespace() || c == '-' { c } else if c.is_alphabetic() { c } else { ' ' })
        .collect();

    // Split on whitespace and take the first character of each word
    cleaned
        .split_whitespace()
        .map(|word| word.chars().next().unwrap().to_uppercase())
        .collect()
}
