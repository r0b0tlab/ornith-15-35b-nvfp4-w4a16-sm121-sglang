KindergartenGarden.java
```java
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class KindergartenGarden {

    private static final List<String> STUDENTS = Arrays.asList(
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    );

    private final List<String> row1;
    private final List<String> row2;

    KindergartenGarden(String garden) {
        String[] rows = garden.split("\n");
        row1 = Arrays.asList(rows[0].split(""));
        row2 = Arrays.asList(rows[1].split(""));
    }

    List<Plant> getPlantsOfStudent(String student) {
        int studentIndex = STUDENTS.indexOf(student);
        if (studentIndex < 0) {
            throw new IllegalArgumentException("Unknown student: " + student);
        }

        int cupIndex1 = studentIndex * 2;
        int cupIndex2 = studentIndex * 2 + 1;

        List<Plant> plants = new ArrayList<>();
        plants.add(plantForCode(row1.get(cupIndex1)));
        plants.add(plantForCode(row1.get(cupIndex2)));
        plants.add(plantForCode(row2.get(cupIndex1)));
        plants.add(plantForCode(row2.get(cupIndex2)));

        return plants;
    }

    private Plant plantForCode(String code) {
        switch (code) {
            case "G":
                return Plant.GRASS;
            case "C":
                return Plant.CLOVER;
            case "R":
                return Plant.RADISHES;
            case "V":
                return Plant.VIOLETS;
            default:
                throw new IllegalArgumentException("Invalid plant code: " + code);
        }
    }

}
