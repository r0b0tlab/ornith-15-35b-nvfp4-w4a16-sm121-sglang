affine-cipher.js
```
export const encode = (phrase, key) => {
  const [a, b] = key;
  
  if (phrase === undefined || phrase === null) {
    throw new Error('Invalid input');
  }
  
  // Check if a and m (26) are coprime
  const m = 26;
  const gcd = (num1, num2) => {
    while (num2 !== 0) {
      const temp = num2;
      num2 = num1 % num2;
      num1 = temp;
    }
    return num1;
  };
  
  if (gcd(a, m) !== 1) {
    throw new Error('a and m must be coprime.');
  }
  
  // Clean input: remove spaces and punctuation, keep only letters and digits
  const cleaned = phrase.toLowerCase().replace(/[^a-z0-9]/g, '');
  
  // Encrypt each character
  let result = '';
  for (let char of cleaned) {
    if (/[a-z]/.test(char)) {
      const i = char.charCodeAt(0) - 97; // 'a' is 97 in ASCII
      const encrypted = (a * i + b) % m;
      result += String.fromCharCode(encrypted + 97);
    } else {
      // Digits are not encrypted
      result += char;
    }
  }
  
  // Group into chunks of 5 letters
  const chunks = result.match(/.{1,5}/g) || [];
  return chunks.join(' ');
};

export const decode = (phrase, key) => {
  const [a, b] = key;
  
  if (phrase === undefined || phrase === null) {
    throw new Error('Invalid input');
  }
  
  // Check if a and m (26) are coprime
  const m = 26;
  const gcd = (num1, num2) => {
    while (num2 !== 0) {
      const temp = num2;
      num2 = num1 % num2;
      num1 = temp;
    }
    return num1;
  };
  
  if (gcd(a, m) !== 1) {
    throw new Error('a and m must be coprime.');
  }
  
  // Find modular multiplicative inverse of a mod m
  let aInv = 1;
  for (let i = 1; i < m; i++) {
    if ((a * i) % m === 1) {
      aInv = i;
      break;
    }
  }
  
  // Clean input: remove spaces, keep only letters and digits
  const cleaned = phrase.replace(/[^a-z0-9]/g, '');
  
  // Decrypt each character
  let result = '';
  for (let char of cleaned) {
    if (/[a-z]/.test(char)) {
      const y = char.charCodeAt(0) - 97; // 'a' is 97 in ASCII
      const decrypted = (aInv * (y - b) % m + m) % m;
      result += String.fromCharCode(decrypted + 97);
    } else {
      // Digits are not encrypted
      result += char;
    }
  }
  
  return result;
};
