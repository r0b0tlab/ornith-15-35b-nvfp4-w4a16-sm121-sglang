class ConnectGame:
    def __init__(self, board):
        # Parse the board, removing spaces
        self.board = [row.replace(' ', '').split(',') for row in board]

    def get_winner(self):
        if not self.board:
            return ''
        
        # Check player O (top to bottom)
        if self._has_path('O'):
            return 'O'
        
        # Check player X (left to right)
        if self._has_path('X'):
            return 'X'
        
        return ''

    def _has_path(self, player):
        if not self.board:
            return False
        
        rows = len(self.board)
        cols = len(self.board[0]) if rows > 0 else 0
        
        # For player O: connect top row to bottom row
        # For player X: connect left column to right column
        
        start_positions = []
        for r in range(rows):
            for c in range(cols):
                if self.board[r][c] == player:
