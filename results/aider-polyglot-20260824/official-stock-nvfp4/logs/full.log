pub fn answer(command: &str) -> Option<i32> {
    let command = command.trim();
    
    // Must start with "What is"
    let rest = command
        .strip_prefix("What is")
        .and_then(|s| s.strip_suffix('?'))
        .unwrap_or("");
    let rest = rest.trim();
    
    if rest.is_empty() {
        return None;
    }
    
    // Tokenize the command
    let tokens = tokenize(rest)?;
    
    // First token must be a number
    let mut tokens = tokens.into_iter();
    let first = tokens.next()?;
    if !first.is_number {
        return None;
    }
    
    let mut result = first.value;
    
    while let Some(token) = tokens.next() {
        if token.is_number {
            return None; // Expected an operation
        }
        
        let next_value = tokens.next()?;
        if !next_value.is_number {
            return None; // Expected a number
        }
        
        match token.op {
            Op::Add => result += next_value.value,
            Op::Subtract => result -= next_value.value,
            Op::Multiply => result *= next_value.value,
            Op::Divide => {
                if next_value.value == 0 {
                    return None;
                }
                result /= next_value.value;
            }
            Op::Power => result = result.pow(next_value.value as u32),
        }
    }
    
    Some(result)
}

struct Token {
    is_number: bool,
    value: i32,
    op: Op,
}

enum Op {
    Add,
    Subtract,
    Multiply,
    Divide,
    Power,
}

fn tokenize(command: &str) -> Option<Vec<Token>> {
    let mut tokens = Vec::new();
    let mut chars = command.chars().peekable();
    
    loop {
        // Skip whitespace
        while let Some(&' ') = chars.peek() {
            chars.next();
        }
        
        if chars.peek().is_none() {
            break;
        }
        
        // Try to parse a number
        if let Some(num) = parse_number(&mut chars) {
            tokens.push(Token {
                is_number: true,
                value: num,
                op: Op::Add,
            });
            continue;
        }
        
        // Try to parse an operation
        let op_str: String = chars.by_ref().take_while(|c| c.is_alphabetic()).collect();
        let op_str = op_str.trim();
        
        let op = match op_str {
            "plus" => Op::Add,
            "minus" => Op::Subtract,
            "multiplied" => {
                // Next should be "by"
                let by: String = chars.by_ref().take_while(|c| c.is_alphabetic()).collect();
                if by == "by" {
                    Op::Multiply
                } else {
                    return None;
                }
            }
            "divided" => {
                let by: String = chars.by_ref().take_while(|c| c.is_alphabetic()).collect();
                if by == "by" {
                    Op::Divide
                } else {
                    return None;
                }
            }
            "explored" => Op::Power, // placeholder, will handle "raised to the"
            _ => return None,
        };
        
        tokens.push(Token {
            is_number: false,
            value: 0,
            op,
        });
    }
    
    Some(tokens)
}

fn parse_number(chars: &mut impl Iterator<Item = char>) -> Option<i32> {
    let mut num_str = String::new();
    
    // Handle negative numbers
    if let Some(&'-') = chars.peek() {
        num_str.push('-');
        chars.next();
    }
    
    // Parse digits
    let mut any_digits = false;
    while let Some(&c) = chars.peek() {
        if c.is_ascii_digit() {
            num_str.push(c);
            chars.next();
            any_digits = true;
        } else {
            break;
        }
    }
    
    if !any_digits {
        return None;
    }
    
    num_str.parse::<i32>().ok()
}
