+/// Score a single poker hand, returning a comparable u64.
+///
+/// Higher scores win. The score is built as a sequence of base-16 "digits"
+/// so that lexicographic comparison of the packed value matches the poker
+/// hand ranking rules.
+fn score_hand(hand: &str) -> u64 {
+    let cards: Vec<&str> = hand.split_whitespace().collect();
+
+    // Parse ranks into numeric values (2..=14, where 11 = J, 12 = Q,
+    // 13 = K, 14 = A).
+    let mut ranks: Vec<u64> = cards
+        .iter()
+        .map(|card| parse_rank(card))
+        .collect();
+
+    // Determine suits.
+    let suits: Vec<char> = cards
+        .iter()
+        .map(|card| card.chars().last().unwrap())
+        .collect();
+
+    // Count occurrences of each rank.
+    let mut rank_counts: Vec<(u64, usize)> = Vec::new();
+    for &rank in &ranks {
+        match rank_counts.iter_mut().find(|&(r, _)| *r == rank) {
+            Some((_r, count)) => *count += 1,
+            None => rank_counts.push((rank, 1)),
+        }
+    }
+
+    // A straight can use an Ace as low (value 1), so handle the special case.
+    let is_flush = suits.iter().all(|&s| s == suits[0]);
+
+    // Sort ranks descending for comparison.
+    let mut sorted_ranks = ranks.clone();
+    sorted_ranks.sort_by(|a, b| b.cmp(a));
+
+    // Check for a straight.
+    let is_straight = is_straight(&sorted_ranks);
+
+    // Handle the wheel (A-2-3-4-5) straight where Ace is low.
+    let is_wheel = sorted_ranks == [14, 5, 4, 3, 2];
+
+    if is_straight || is_wheel {
+        if is_flush {
+            // Straight flush.
+            // Use 8_0000 as the base, with the high card (5 for the wheel).
+            return 8_0000 + if is_wheel { 5 } else { sorted_ranks[0] };
+        }
+        // Straight.
+        return 5_0000 + if is_wheel { 5 } else { sorted_ranks[0] };
+    }
+
+    // Four of a kind.
+    if let Some((rank, count)) = rank_counts.iter().find(|&(_, c)| *c == 4) {
+        let kicker = ranks
+            .iter()
+            .copied()
+            .find(|&r| r != *rank)
+            .unwrap_or(0);
+        return 7_0000 + rank * 16 + kicker;
+    }
+
+    // Full house.
+    if rank_counts.len() == 2 {
+        if let Some((trip_rank, trip_count)) =
+            rank_counts.iter().find(|&(_, c)| *c == 3)
+        {
+            let pair_rank = rank_counts
+                .iter()
+                .find(|&(_, c)| *c == 2)
+                .map(|(r, _)| *r)
+                .unwrap_or(0);
+            return 6_0000 + trip_rank * 16 + pair_rank;
+        }
+    }
+
+    // Flush.
+    if is_flush {
+        return 4_0000
+            + sorted_ranks[0] * 16 * 16 * 16
+            + sorted_ranks[1] * 16 * 16
+            + sorted_ranks[2] * 16
+            + sorted_ranks[3];
+    }
+
+    // Three of a kind.
+    if let Some((rank, count)) = rank_counts.iter().find(|&(_, c)| *c == 3) {
+        let kickers: Vec<u64> = ranks
+            .iter()
+            .copied()
+            .filter(|&r| r != *rank)
+            .collect();
+        let kicker1 = kickers.first().copied().unwrap_or(0);
+        let kicker2 = kickers.get(1).copied().unwrap_or(0);
+        return 5_0000 + rank * 16 * 16 + kicker1 * 16 + kicker2;
+    }
+
+    // Two pair.
+    let mut pairs: Vec<u64> = rank_counts
+        .iter()
+        .filter(|&(_, c)| *c == 2)
+        .map(|(r, _)| *r)
+        .collect();
+    if pairs.len() == 2 {
+        pairs.sort_by(|a, b| b.cmp(a));
+        let kicker = ranks
+            .iter()
+            .copied()
+            .find(|&r| r != pairs[0] && r != pairs[1])
+            .unwrap_or(0);
+        return 3_0000 + pairs[0] * 16 * 16 + pairs[1] * 16 + kicker;
+    }
+
+    // One pair.
+    if let Some((rank, count)) = rank_counts.iter().find(|&(_, c)| *c == 2) {
+        let kickers: Vec<u64> = ranks
+            .iter()
+            .copied()
+            .filter(|&r| r != *rank)
+            .collect();
+        let kicker1 = kickers.first().copied().unwrap_or(0);
+        let kicker2 = kickers.get(1).copied().unwrap_or(0);
+        let kicker3 = kickers.get(2).copied().unwrap_or(0);
+        return 2_0000
+            + rank * 16 * 16 * 16
+            + kicker1 * 16 * 16
+            + kicker2 * 16
+            + kicker3;
+    }
+
+    // High card.
+    1_0000
+        + sorted_ranks[0] * 16 * 16 * 16 * 16
+        + sorted_ranks[1] * 16 * 16 * 16
+        + sorted_ranks[2] * 16 * 16
+        + sorted_ranks[3] * 16
+        + sorted_ranks[4]
+}
