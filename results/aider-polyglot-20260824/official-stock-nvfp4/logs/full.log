```
use std::fmt;

// Error type representing invalid inputs
#[derive(Debug)]
pub struct Error {
    message: String,
}

impl fmt::Display for Error {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        write!(f, "{}", self.message)
    }
}

impl std::error::Error for Error {}

pub struct Scale {
    tonic: String,
    intervals: String,
}

// Chromatic scale notes using sharps
const SHARP_SCALE: [&str; 12] = [
    "A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#",
];

// Chromatic scale notes using flats
const FLAT_SCALE: [&str; 12] = [
    "A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab",
];

// Tonics that use sharps (case-insensitive comparison)
const SHARP_TONICS: [&str; 11] = [
    "G", "D", "A", "E", "B", "F#", "C#", "G#", "D#", "E", "B",
];

// Tonics that use flats
const FLAT_TONICS: [&str; 12] = [
    "F", "Bb", "Eb", "Ab", "Db", "Gb", "D", "G", "C", "F", "Bb", "Eb",
];

fn uses_sharps(tonic: &str) -> bool {
    // Case-insensitive comparison
    let tonic_lower = tonic.to_lowercase();
    SHARP_TONICS.iter().any(|&t| t.eq_ignore_ascii_case(&tonic_lower))
}

fn tonic_in_scale(tonic: &str, scale: &[&str; 12]) -> bool {
    scale.iter().any(|&n| n.eq_ignore_ascii_case(tonic))
}

impl Scale {
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        // Validate intervals: must be non-empty and only contain valid characters
        if intervals.is_empty() {
            return Err(Error {
                message: "Intervals cannot be empty".to_string(),
            });
        }
        
        for c in intervals.chars() {
            if !matches!(c, 'A' | 'M' | 'm') {
                return Err(Error {
                    message: "Invalid interval character".to_string(),
                });
            }
        }
        
        // Determine whether to use sharps or flats based on tonic
        let use_sharps = uses_sharps(tonic);
        let notes = if use_sharps {
            &SHARP_SCALE
        } else {
            &FLAT_SCALE
        };
        
        // Validate that the tonic exists in the chosen scale
        if !tonic_in_scale(tonic, notes) {
            return Err(Error {
                message: format!("Tonic {tonic} not found in the chosen scale"),
            });
        }
        
        Ok(Scale {
            tonic: tonic.to_string(),
            intervals: intervals.to_string(),
        })
    }

    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        // Chromatic scale uses all 12 notes with the appropriate accidentals
        if !SHARP_SCALE.iter().any(|&n| n.eq_ignore_ascii_case(tonic))
            && !FLAT_SCALE.iter().any(|&n| n.eq_ignore_ascii_case(tonic))
        {
            return Err(Error {
                message: format!("Tonic {tonic} not found in the chromatic scale"),
            });
        }
        
        Ok(Scale {
            tonic: tonic.to_string(),
            intervals: String::new(),
        })
    }

    pub fn enumerate(&self) -> Vec<String> {
        // Determine whether to use sharps or flats
        let use_sharps = uses_sharps(&self.tonic);
        let notes = if use_sharps {
            &SHARP_SCALE
        } else {
            &FLAT_SCALE
        };
        
        // Find the starting index based on the tonic (case-insensitive)
        let start_index = notes
            .iter()
            .position(|&n| n.eq_ignore_ascii_case(&self.tonic))
            .expect("tonic must be in scale");
        
        // Map interval characters to semitone steps
        let step_map: Vec<usize> = self
            .intervals
            .chars()
            .map(|c| match c {
                'm' => 1,   // minor second / half step
                'M' => 2,   // major second / whole step
                'A' => 3,   // augmented second
                _ => 0,
            })
            .collect();
        
        // Build the scale by stepping through the chromatic scale
        let mut scale = vec![notes[start_index].to_string()];
        let mut index = start_index;
        
        for &step in &step_map {
            index = (index + step) % 12;
            scale.push(notes[index].to_string());
        }
        
        scale
    }
}
```
