VariableLengthQuantity.java
```java
import java.util.ArrayList;
import java.util.List;

class VariableLengthQuantity {

    List<String> encode(List<Long> numbers) {
        List<String> result = new ArrayList<>();
        for (Long number : numbers) {
            if (number == null || number < 0 || number > 4294967295L) {
                throw new IllegalArgumentException("Invalid variable-length quantity encoding");
            }
            
            // Split into 7-bit groups, least significant first
            List<Integer> groups = new ArrayList<>();
            long num = number;
            
            if (num == 0) {
                groups.add(0);
            } else {
                while (num > 0) {
                    groups.add((int) (num & 0x7F));
                    num >>= 7;
                }
            }
            
            // Reverse to get most significant group first
            java.util.Collections.reverse(groups);
            
            // Apply continuation bits and add each byte as separate entry
            for (int i = 0; i < groups.size(); i++) {
                int group = groups.get(i);
                if (i < groups.size() - 1) {
                    // Not the last group, set continuation bit
                    result.add(String.format("0x%02x", group | 0x80));
                } else {
                    // Last group, no continuation bit
                    result.add(String.format("0x%02x", group));
                }
            }
        }
        return result;
    }

    List<String> decode(List<Long> bytes) {
        List<String> result = new ArrayList<>();
        long accumulator = 0;
        boolean inSequence = false;
        
        for (Long byteValue : bytes) {
            if (byteValue == null || byteValue < 0 || byteValue > 255) {
                throw new IllegalArgumentException("Invalid variable-length quantity encoding");
            }
            
            int b = (int) (byteValue & 0xFF);
            
            // Check if this exceeds 32-bit range before adding
            if ((accumulator & 0xFE000000L) != 0) {
                throw new IllegalArgumentException("Invalid variable-length quantity encoding");
            }
            
            // Shift accumulator left by 7 bits and add new 7 bits
            accumulator = (accumulator << 7) | (b & 0x7F);
            
            inSequence = true;
            
            if ((b & 0x80) == 0) {
                // Last byte of sequence, bit 7 clear
                result.add(String.format("0x%x", accumulator));
                accumulator = 0;
                inSequence = false;
            }
        }
        
        if (inSequence) {
            throw new IllegalArgumentException("Invalid variable-length quantity encoding");
        }
        
        return result;
    }
}
```
