I can see the issues with the current implementation. The main problems are:

1. The parser is including `+` and `=` characters as letters
2. When no solution exists, it should return `null`, not `{}`
3. Performance needs improvement for larger puzzles

Let me rewrite the solution with proper parsing, pruning for performance, and correct return values.

alphametics.js
```javascript
//
// This is only a SKELETON file for the 'Alphametics' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const solve = (puzzle) => {
  // Parse the puzzle to extract only the words (letters only)
  const words = puzzle.match(/[A-Z]+/g);
  
  if (!words || words.length < 2) {
    return null;
  }
  
  const result = words[words.length - 1];
  const addends = words.slice(0, -1);
  
  // Collect all unique letters
  const letters = new Set();
  for (const word of words) {
    for (const char of word) {
      letters.add(char);
    }
  }
  
  const letterArray = Array.from(letters);
  
  // If we have more unique letters than digits, no solution possible
  if (letterArray.length > 10) {
    return null;
  }
  
  // Identify letters that cannot be zero (leading digits of multi-digit numbers)
  const nonZeroLetters = new Set();
  for (const word of words) {
    if (word.length > 1) {
      nonZeroLetters.add(word[0]);
    }
  }
  
  // Build coefficient for each letter based on its position in each word
  // Each letter's value is: sum of (digit * 10^position) across all words
  // For addends: positive coefficient
  // For result: negative coefficient
  const coefficients = {};
  
  for (const word of addends) {
    for (let i = 0; i < word.length; i++) {
      const char = word[i];
      const power = Math.pow(10, word.length - 1 - i);
      coefficients[char] = (coefficients[char] || 0) + power;
    }
  }
  
  for (let i = 0; i < result.length; i++) {
    const char = result[i];
    const power = Math.pow(10, result.length - 1 - i);
    coefficients[char] = (coefficients[char] || 0) - power;
  }
  
  const assignment = {};
  const usedDigits = new Array(10).fill(false);
  
  // Sort letters by absolute coefficient value (descending) for better pruning
  const sortedLetters = letterArray.slice().sort((a, b) => 
    Math.abs(coefficients[b]) - Math.abs(coefficients[a])
  );
  
  function backtrack(index, currentSum) {
    if (index === sortedLetters.length) {
      return currentSum === 0;
    }
    
    const letter = sortedLetters[index];
    const coeff = coefficients[letter];
    
    for (let digit = 0; digit <= 9; digit++) {
      if (usedDigits[digit]) {
        continue;
      }
      
      if (digit === 0 && nonZeroLetters.has(letter)) {
        continue;
      }
      
      // Assign digit to letter
      assignment[letter] = digit;
      usedDigits[digit] = true;
      
      // Recurse with updated sum
      if (backtrack(index + 1, currentSum + digit * coeff)) {
        return true;
      }
      
      // Undo assignment
      delete assignment[letter];
      usedDigits[digit] = false;
    }
    
    return false;
  }
  
  return backtrack(0, 0) ? assignment : null;
};
