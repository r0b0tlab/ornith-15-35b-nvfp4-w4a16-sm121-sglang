pub fn answer(command: &str) -> Option<i32> {
    let command = command.trim();
    
    // Must start with "What is" and end with "?"
    let body = command
        .strip_prefix("What is")
        .and_then(|s| s.strip_suffix('?'))
        .unwrap_or("");
    
    if body.trim().is_empty() {
        return None;
    }
    
    let tokens = tokenize(body)?;
    
    // Parse: number (op number)*
    let mut iter = tokens.into_iter();
    let current = iter.next()?;
    if !current.is_number {
        return None;
    }
    
    let mut result = current.value;
    
    while let Some(token) = iter.next() {
        if token.is_number {
            return None;
        }
        
        // Get the next number
        let next = iter.next()?;
        if !next.is_number {
            return None;
        }
        
        result = apply_op(result, token.op, next.value)?;
    }
    
    Some(result)
}

#[derive(Debug, Clone, Copy)]
struct Token {
    is_number: bool,
    value: i32,
    op: Operation,
}

#[derive(Debug, Clone, Copy)]
enum Operation {
    Add,
    Subtract,
    Multiply,
    Divide,
    Power,
}

fn apply_op(left: i32, op: Operation, right: i32) -> Option<i32> {
    match op {
        Operation::Add => Some(left + right),
        Operation::Subtract => Some(left - right),
        Operation::Multiply => Some(left * right),
        Operation::Divide => {
            if right == 0 {
                None
            } else {
                Some(left / right)
            }
        }
        Operation::Power => Some(left.pow(right as u32)),
    }
}

fn tokenize(command: &str) -> Option<Vec<Token>> {
    let mut tokens = Vec::new();
    let chars: Vec<char> = command.chars().collect();
    let mut i = 0;
    
    while i < chars.len() {
        // Skip whitespace
        if chars[i] == ' ' {
            i += 1;
            continue;
        }
        
        // Try to parse a number
        if chars[i].is_digit(10) || (chars[i] == '-' && i + 1 < chars.len() && chars[i + 1].is_digit(10)) {
            let start = i;
            i += 1;
            while i < chars.len() && chars[i].is_digit(10) {
                i += 1;
            }
            let num_str: String = chars[start..i].iter().collect();
            let value: i32 = num_str.parse().ok()?;
            tokens.push(Token {
                is_number: true,
                value,
                op: Operation::Add,
            });
            continue;
        }
        
        // Try to parse operation keywords
        let remaining: String = chars[i..].iter().collect();
        
        if remaining.starts_with("plus") {
