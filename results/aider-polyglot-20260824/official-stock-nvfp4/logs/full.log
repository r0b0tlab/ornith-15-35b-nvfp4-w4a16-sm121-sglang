```js
//
// This is only a SKELETON file for the 'Rectangles' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export function count(grid) {
  if (!grid || grid.length === 0) {
    return 0;
  }

  const rows = grid.length;
  const cols = grid[0].length;
  let count = 0;

  // Find all corner positions ('+')
  const corners = [];
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (grid[r][c] === '+') {
        corners.push([r, c]);
      }
    }
  }

  // Check all pairs of corners as diagonal opposite corners
  for (let i = 0; i < corners.length; i++) {
    for (let j = i + 1; j < corners.length; j++) {
      const [r1, c1] = corners[i];
      const [r2, c2] = corners[j];

      // Only consider pairs where one is top-left and other is bottom-right
      // (r1 < r2 and c1 < c2 means corners[i] is top-left)
      // (r1 > r2 and c1 > c2 means corners[j] is top-left)
      if ((r1 < r2 && c1 < c2) || (r1 > r2 && c1 > c2)) {
        // Determine the four corners
        let topLeft, topRight, bottomLeft, bottomRight;
        if (r1 < r2 && c1 < c2) {
          topLeft = [r1, c1];
          topRight = [r1, c2];
          bottomLeft = [r2, c1];
          bottomRight = [r2, c2];
        } else {
          topLeft = [r2, c2];
          topRight = [r2, c1];
          bottomLeft = [r1, c2];
          bottomRight = [r1, c1];
        }

        // Check if all four corners are '+'
        if (grid[topLeft[0]][topLeft[1]] === '+' &&
            grid[topRight[0]][topRight[1]] === '+' &&
            grid[bottomLeft[0]][bottomLeft[1]] === '+' &&
            grid[bottomRight[0]][bottomRight[1]] === '+') {

          // Check horizontal edges (top and bottom)
          const topEdgeValid = checkHorizontalEdge(
            grid, topLeft[0], topLeft[1], topRight[1]);
          const bottomEdgeValid = checkHorizontalEdge(
            grid, bottomLeft[0], bottomLeft[1], bottomRight[1]);

          // Check vertical edges (left and right)
          const leftEdgeValid = checkVerticalEdge(
            grid, topLeft[0], bottomLeft[0], topLeft[1]);
          const rightEdgeValid = checkVerticalEdge(
            grid, topRight[0], bottomRight[0], topRight[1]);

          if (topEdgeValid && bottomEdgeValid &&
              leftEdgeValid && rightEdgeValid) {
            count++;
          }
        }
      }
    }
  }

  return count;
}

// Check horizontal edge between two columns on the same row
function checkHorizontalEdge(grid, row, startCol, endCol) {
  for (let c = startCol; c <= endCol; c++) {
    const char = grid[row][c];
    if (char !== '+' && char !== '-') {
      return false;
    }
  }
  return true;
}

// Check vertical edge between two rows on the same column
function checkVerticalEdge(grid, startRow, endRow, col) {
  for (let r = startRow; r <= endRow; r++) {
    const char = grid[r][col];
    if (char !== '+' && char !== '|') {
      return false;
    }
  }
  return true;
}
