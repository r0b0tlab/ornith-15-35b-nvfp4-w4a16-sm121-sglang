class Scale:
    # Base chromatic scale with sharps
    SHARP_SCALE = ['A', 'A♯', 'B', 'C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯']
    
    # Base chromatic scale with flats
    FLAT_SCALE = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭']
    
    # Keys that use flats (major)
    FLAT_KEYS_MAJOR = {'F', 'B♭', 'E♭', 'A♭', 'D♭', 'G♭'}
    
    # Keys that use flats (minor)
    FLAT_KEYS_MINOR = {'d', 'g', 'c', 'f', 'b♭', 'e♭'}

    def __init__(self, tonic):
        self.tonic = tonic.upper() if tonic.lower() != 'b' else 'B♭' if tonic.lower() == 'b' else tonic
        
        # Determine if we should use flats based on the tonic
        normalized_tonic = self._normalize_tonic(tonic)
        if normalized_tonic in self.FLAT_KEYS_MAJOR or normalized_tonic in self.FLAT_KEYS_MINOR:
            self.use_flats = True
        else:
            self.use_flats = False

    def _normalize_tonic(self, tonic):
        """Normalize the tonic to handle case-insensitivity and flats."""
        tonic_lower = tonic.lower()
        
        # Handle special case for 'b' which could mean B-flat
        if tonic_lower == 'b':
            return 'B♭'
        
        # For all other cases, just uppercase the tonic
        return tonic.upper()

    def chromatic(self):
        """Return the 12-note chromatic scale starting with the tonic."""
        scale = self.FLAT_SCALE if self.use_flats else self.SHARP_SCALE
        tonic_lower = self.tonic.lower()
        
        # Find the index of the tonic in the scale
        start_index = scale.index(self.tonic)
        
        # Rotate the scale to start with the tonic
        return scale[start_index:] + scale[:start_index]

    def interval(self, intervals):
        """Return the scale based on the specified interval pattern."""
        chromatic_scale = self.chromatic()
        result = [chromatic_scale[0]]  # First note is always the tonic
        
        # Apply each interval to determine the next note
        for interval in intervals:
            if interval == 'm':  # Half step
                result.append(chromatic_scale[(len(result) - 1 + 1) % 12])
            elif interval == 'M':  # Whole step
                result.append(chromatic_scale[(len(result) - 1 + 2) % 12])
            elif interval == 'A':  # Augmented second
                result.append(chromatic_scale[(len(result) - 1 + 3) % 12])
        
        return result
```
