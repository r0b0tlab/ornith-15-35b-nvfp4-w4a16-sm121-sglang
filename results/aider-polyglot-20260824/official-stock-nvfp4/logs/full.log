lib.rs
```rust
#[derive(PartialEq, Eq, Debug)]
pub enum Bucket {
    One,
    Two,
}

/// A struct to hold your results in.
#[derive(PartialEq, Eq, Debug)]
pub struct BucketStats {
    /// The total number of "moves" it should take to reach the desired number of liters, including
    /// the first fill.
    pub moves: u8,
    /// Which bucket should end up with the desired number of liters? (Either "one" or "two")
    pub goal_bucket: Bucket,
    /// How many liters are left in the other bucket?
    pub other_bucket: u8,
}

/// Solve the bucket problem
pub fn solve(
    capacity_1: u8,
    capacity_2: u8,
    goal: u8,
    start_bucket: &Bucket,
) -> Option<BucketStats> {
    // Check if goal is achievable (must be divisible by GCD, or less than or equal to max capacity)
    if goal > capacity_1.max(capacity_2) {
        return None;
    }

    // Helper function to compute GCD
    fn gcd(a: u8, b: u8) -> u8 {
        if b == 0 {
            a
        } else {
            gcd(b, a % b)
        }
    }

    // Check if goal is reachable using GCD
    if goal % gcd(capacity_1, capacity_2) != 0 {
        return None;
    }

    // State: (bucket1_amount, bucket2_amount)
    #[derive(Clone, PartialEq, Eq, Hash)]
    struct State {
        b1: u8,
        b2: u8,
    }

    // BFS
    use std::collections::{HashMap, VecDeque};

    let mut visited: HashMap<State, u8> = HashMap::new();
    let mut queue: VecDeque<State> = VecDeque::new();

    // Determine forbidden state based on start bucket
    let forbidden = match start_bucket {
        Bucket::One => State { b1: 0, b2: capacity_2 },
        Bucket::Two => State { b1: capacity_1, b2: 0 },
    };

    // Initial state: fill the start bucket
    let initial = match start_bucket {
        Bucket::One => State { b1: capacity_1, b2: 0 },
        Bucket::Two => State { b1: 0, b2: capacity_2 },
    };

    visited.insert(initial.clone(), 1);
    queue.push_back(initial);

    while let Some(current) = queue.pop_front() {
        // Check if we've reached the goal
        if current.b1 == goal {
            let moves = visited[&current];
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::One,
                other_bucket: current.b2,
            });
        }
        if current.b2 == goal {
            let moves = visited[&current];
            return Some(BucketStats {
                moves,
                goal_bucket: Bucket::Two,
                other_bucket: current.b1,
            });
        }

        let current_moves = visited[&current];

        // Generate all possible next states
        let next_states = [
            // Pour bucket1 into bucket2
            {
                let pour = current.b1.min(capacity_2 - current.b2);
                State {
                    b1: current.b1 - pour,
                    b2: current.b2 + pour,
                }
            },
            // Pour bucket2 into bucket1
            {
                let pour = current.b2.min(capacity_1 - current.b1);
                State {
                    b1: current.b1 + pour,
                    b2: current.b2 - pour,
                }
            },
            // Empty bucket1
            State {
                b1: 0,
                b2: current.b2,
            },
            // Empty bucket2
            State {
                b1: current.b1,
                b2: 0,
            },
            // Fill bucket1
            State {
                b1: capacity_1,
                b2: current.b2,
            },
            // Fill bucket2
            State {
                b1: current.b1,
                b2: capacity_2,
            },
        ];

        for state in next_states {
            // Skip forbidden state
            if state == forbidden {
                continue;
            }
            // Skip visited states
            if visited.contains_key(&state) {
                continue;
            }
            visited.insert(state.clone(), current_moves + 1);
            queue.push_back(state);
        }
    }

    None
}
