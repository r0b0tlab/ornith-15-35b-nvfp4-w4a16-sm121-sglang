alphametics.js
```javascript
//
// This is only a SKELETON file for the 'Alphametics' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const solve = (puzzle) => {
  // Parse the puzzle into individual words and the result
  const parts = puzzle.split(/\s*(\+|==)\s*/).filter(part => part.trim() !== '');
  const words = parts.slice(0, -1);
  const result = parts[parts.length - 1];

  if (words.length === 0 || result.length === 0) {
    return {};
  }

  // Collect all unique letters
  const letters = new Set();
  for (const word of [words, result].flat()) {
    for (const char of word) {
      letters.add(char);
    }
  }

  const letterArray = Array.from(letters);

  // Letters that cannot be zero (leading digits)
  const nonZeroLetters = new Set();
  for (const word of [...words, result]) {
    if (word.length > 1) {
      nonZeroLetters.add(word[0]);
    }
  }

  // Get all letters as an array for indexing
  const lettersList = Array.from(letters);

  // Backtracking solution
  const assignment = {};
  const usedDigits = new Array(10).fill(false);

  function is_valid(assignment) {
    // Check if current partial assignment could lead to a valid solution
    // For efficiency, we check full words when all their letters are assigned
    
    // Convert word to number using assignment, return null if incomplete or has zero leading
    const wordToNumber = (word) => {
      let num = 0;
      for (let i = 0; i < word.length; i++) {
        const digit = assignment[word[i]];
        if (digit === undefined) {
          return null; // incomplete
        }
        num = num * 10 + digit;
      }
      return num;
    };

    // Check if all letters are assigned
    const allAssigned = lettersList.every(letter => assignment[letter] !== undefined);
    
    if (!allAssigned) {
      return true; // Continue exploring partial assignments
    }

    // All assigned - check if valid
    const wordNumbers = words.map(word => wordToNumber(word));
    const resultNumber = wordToNumber(result);

    if (wordNumbers.some(num => num === null) || resultNumber === null) {
      return false;
    }

    const sum = wordNumbers.reduce((acc, num) => acc + num, 0);
    return sum === resultNumber;
  }

  function backtrack(index) {
    if (index === lettersList.length) {
      // Check if we have a valid solution
      const wordNumbers = words.map(word => {
        let num = 0;
        for (let i = 0; i < word.length; i++) {
          num = num * 10 + assignment[word[i]];
        }
        return num;
      });
      let resultNum = 0;
      for (let i = 0; i < result.length; i++) {
        resultNum = resultNum * 10 + assignment[result[i]];
      }

      const sum = wordNumbers.reduce((acc, num) => acc + num, 0);
      if (sum === resultNum) {
        return true;
      }
      return false;
    }

    const currentLetter = lettersList[index];
    
    for (let digit = 0; digit <= 9; digit++) {
      // Skip if digit already used
      if (usedDigits[digit]) {
        continue;
      }
      
      // Skip zero for leading digits
      if (digit === 0 && nonZeroLetters.has(currentLetter)) {
        continue;
      }

      // Assign digit to letter
      assignment[currentLetter] = digit;
      usedDigits[digit] = true;

      // Recurse
      if (backtrack(index + 1)) {
        return true;
      }

      // Undo assignment
      delete assignment[currentLetter];
      usedDigits[digit] = false;
    }

    return false;
  }

  if (backtrack(0)) {
    return assignment;
  }

  return {};
};
