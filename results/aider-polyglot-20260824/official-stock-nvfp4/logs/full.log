  return winners;
};

// Compare two scores. Returns positive if score1 > score2,
// negative if score1 < score2, 0 if equal.
const compareScores = (score1, score2) => {
  // First compare hand type
  if (score1.type !== score2.type) {
    return score1.type - score2.type;
  }
  
  // Then compare the rank values in order of importance
  for (let i = 0; i < Math.max(score1.ranks.length, score2.ranks.length); i++) {
    const r1 = score1.ranks[i] || 0;
    const r2 = score2.ranks[i] || 0;
    if (r1 !== r2) {
      return r1 - r2;
    }
  }
  
  return 0;
};

// Evaluate a hand and return { type, ranks } where ranks is ordered by importance
const evaluateHand = (hand) => {
  const cards = hand.split(' ');
  const ranks = cards.map(card => card.slice(0, -1));
  const suits = cards.map(card => card.slice(-1));

  // Count occurrences of each rank
  const rankCounts = {};
  ranks.forEach(rank => {
    const value = RANK_VALUES[rank];
    rankCounts[value] = (rankCounts[value] || 0) + 1;
  });

  // Check for flush
  const isFlush = suits.every(suit => suit === suits[0]);

  // Check for straight
  const uniqueRanks = Object.keys(rankCounts).map(Number).sort((a, b) => b - a);
  const isStraight = checkStraight(uniqueRanks, rankCounts);

  // Group ranks by count for organizing
  const counts = Object.values(rankCounts);
  const hasFour = counts.includes(4);
  const hasThree = counts.includes(3);
  const hasTwoPair = counts.filter(c => c === 2).length >= 2;

  // Determine hand type
  let type;
  if (isStraight && isFlush) {
    type = HAND_TYPES.STRAIGHT_FLUSH;
  } else if (hasFour) {
    type = HAND_TYPES.FOUR_OF_A_KIND;
  } else if (hasThree && hasTwoPair || hasThree && counts.filter(c => c === 2).length === 1) {
    type = HAND_TYPES.FULL_HOUSE;
  } else if (isFlush) {
    type = HAND_TYPES.FLUSH;
  } else if (isStraight) {
    type = HAND_TYPES.STRAIGHT;
  } else if (hasThree) {
    type = HAND_TYPES.THREE_OF_A_KIND;
  } else if (hasTwoPair) {
    type = HAND_TYPES.TWO_PAIR;
  } else if (counts.filter(c => c === 1).length === 1) {
    // Only one rank has count 1, meaning... this shouldn't happen for 5 cards
    // Actually need to check for single pair
    type = HAND_TYPES.PAIR;
  } else {
    type = HAND_TYPES.HIGH_CARD;
  }

  // Build the ordered ranks array for comparison
  const orderedRanks = buildOrderedRanks(rankCounts, hasFour, hasThree, hasTwoPair, isStraight, uniqueRanks);

  return { type, ranks: orderedRanks };
};

const checkStraight = (uniqueRanks, rankCounts) => {
  if (uniqueRanks.length !== 5) {
    return false;
  }

  // Check for normal straight (A-2-3-4-5, the "wheel")
  if (JSON.stringify(uniqueRanks) === JSON.stringify([14, 5, 4, 3, 2])) {
    return true;
  }

  // Check for regular straight
  for (let i = 0; i < uniqueRanks.length - 1; i++) {
    if (uniqueRanks[i] - uniqueRanks[i + 1] !== 1) {
      return false;
    }
  }
  
  return true;
};

const buildOrderedRanks = (rankCounts, hasFour, hasThree, hasTwoPair, isStraight, uniqueRanks) => {
  if (isStraight) {
    // For a straight, use the highest card, with special case for wheel
    if (JSON.stringify(uniqueRanks) === JSON.stringify([14, 5, 4, 3, 2])) {
      return [5, 4, 3, 2, 14]; // Wheel straight: 5-high
    }
    return uniqueRanks; // Already sorted descending
  }

  // Group by count, then by rank value
  const byCount = {};
  Object.entries(rankCounts).forEach(([rank, count]) => {
    const value = Number(rank);
    byCount[count] = byCount[count] || [];
    byCount[count].push(value);
  });

  const result = [];
  
  // Four of a kind first
  if (byCount[4]) {
    result.push(...byCount[4].sort((a, b) => b - a));
  }
  
  // Three of a kind
  if (byCount[3]) {
    result.push(...byCount[3].sort((a, b) => b - a));
  }
  
  // Pairs
  if (byCount[2]) {
    result.push(...byCount[2].sort((a, b) => b - a));
  }
  
  // Single cards
  if (byCount[1]) {
    result.push(...byCount[1].sort((a, b) => b - a));
  }

  return result;
};
```

This implementation:

1. **Parses each hand** into ranks and suits
2. **Detects hand types**: High Card, Pair, Two Pair, Three of a Kind, Straight, Flush, Full House, Four of a Kind, and Straight Flush
3. **Handles the wheel straight** (A-2-3-4-5) where the Ace counts as low
4. **Orders ranks by importance** for proper tiebreaking (e.g., in a full house, the three-of-a-kind ranks come before the pair)
5. **Returns all winning hands** in case of ties
6. **Compares scores** first by hand type, then by the ordered rank values

The key logic:
- `bestHands` evaluates all hands and returns indices of those with the maximum score
- `evaluateHand` categorizes the hand and builds a comparable rank array
- `compareScores` handles tiebreaking between hands
- `buildOrderedRanks` ensures ranks are ordered correctly for comparison (groups of 4, then 3, then 2, then 1)
