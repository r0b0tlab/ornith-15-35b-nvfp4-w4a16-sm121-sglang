BowlingGame.java
```
import java.util.ArrayList;
import java.util.List;

class BowlingGame {
    private final List<Integer> rolls = new ArrayList<>();

    void roll(int pins) {
        if (pins < 0) {
            throw new IllegalStateException("Roll cannot have negative pins");
        }
        if (pins > 10) {
            throw new IllegalStateException("Roll cannot exceed 10 pins");
        }
        if (!canRoll(pins)) {
            throw new IllegalStateException("Invalid roll");
        }
        rolls.add(pins);
    }

    private boolean canRoll(int pins) {
        if (rolls.isEmpty()) {
            return true;
        }
        
        int frame = frameCount();
        
        if (frame < 10) {
            // Regular frames
            int rollsInFrame = rolls.size() - frame * 2;
            if (rollsInFrame == 1) {
                // Second roll of frame - check if first roll was a strike
                int firstRoll = rolls.get(rolls.size() - 2);
                if (firstRoll == 10) {
                    // First was a strike, can roll again
                    return pins <= 10;
                }
                // Second roll - sum with first cannot exceed 10
                int first = rolls.get(rolls.size() - 2);
                return first + pins <= 10;
            }
            return true;
        } else {
            // Tenth frame special handling
            return validateTenthFrame(pins);
        }
    }

    private boolean validateTenthFrame(int pins) {
        int rollsInFrame = rolls.size() - 18;
        
        if (rollsInFrame == 1) {
            // Second roll of tenth frame
            int firstRoll = rolls.get(rolls.size() - 2);
            if (firstRoll == 10) {
                // First was a strike
                return pins <= 10;
            }
            // Second roll - sum with first cannot exceed 10
            int first = rolls.get(rolls.size() - 2);
            return first + pins <= 10;
        } else if (rollsInFrame == 2) {
            // First bonus roll
            int firstRoll = rolls.get(rolls.size() - 2);
            int secondRoll = rolls.get(rolls.size() - 1);
            
            if (firstRoll == 10) {
                // First was a strike
                if (secondRoll == 10) {
                    // Second was also a strike
                    return pins <= 10;
                }
                // Second wasn't a strike, sum cannot exceed 10
                return secondRoll + pins <= 10;
            } else {
                // First wasn't a strike
                if (firstRoll + secondRoll == 10) {
                    // Spare, can roll bonus
                    return pins <= 10;
                }
                // Not a spare, game over
                return false;
            }
        } else if (rollsInFrame == 3) {
            // Third bonus roll - game complete
            return false;
        }
        
        return true;
    }

    private int frameCount() {
        return rolls.size() / 2;
    }

    int score() {
        int score = 0;
        int rollIndex = 0;

        for (int frame = 0; frame < 10; frame++) {
            if (isStrike(rollIndex)) {
                score += 10 + strikeBonus(rollIndex);
                rollIndex += 1;
            } else if (isSpare(rollIndex)) {
                score += 10 + spareBonus(rollIndex);
                rollIndex += 2;
            } else {
                score += frameScore(rollIndex);
                rollIndex += 2;
            }
        }

        return score;
    }

    private boolean isStrike(int rollIndex) {
        return rolls.get(rollIndex) == 10;
    }

    private boolean isSpare(int rollIndex) {
        return rolls.get(rollIndex) + rolls.get(rollIndex + 1) == 10;
    }

    private int strikeBonus(int rollIndex) {
        return rolls.get(rollIndex + 1) + rolls.get(rollIndex + 2);
    }

    private int spareBonus(int rollIndex) {
        return rolls.get(rollIndex + 2);
    }

    private int frameScore(int rollIndex) {
        return rolls.get(rollIndex) + rolls.get(rollIndex + 1);
    }
}
