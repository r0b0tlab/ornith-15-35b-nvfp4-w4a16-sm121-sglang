					for _, pet := range petPerms {
						// Constraint 3: The Spaniard owns the dog
						// Constraint 7: The Old Gold smoker owns snails
						// Constraint 11: Chesterfields next to fox
						// Constraint 12: Kools next to horse
						valid := true

						for i := 0; i < 5; i++ {
							if nat[i] == "Spaniard" && pet[i] != "Dog" {
								valid = false
								break
							}
							if smoke[i] == "OldGold" && pet[i] != "Snails" {
								valid = false
								break
							}
						}

						if !valid {
							continue
						}

						// Constraint 11: Chesterfields next to fox
						chesterPos := indexOf(smoke, "Chesterfields")
						hasFox := false
						for i := 0; i < 5; i++ {
							if pet[i] == "Fox" {
								hasFox = true
								if abs(chesterPos-i) != 1 {
									valid = false
									break
								}
							}
						}
						if !hasFox {
							valid = false
						}

						// Constraint 12: Kools next to horse
						koolsPos := indexOf(smoke, "Kools")
						hasHorse := false
						for i := 0; i < 5; i++ {
							if pet[i] == "Horse" {
								hasHorse = true
								if abs(koolsPos-i) != 1 {
									valid = false
									break
								}
							}
						}
						if !hasHorse {
							valid = false
						}

						if !valid {
							continue
						}

						// Found a valid solution
						// Find who drinks water and owns the zebra
						waterDrinker := nat[indexOf(bev, "Water")]
						zebraOwner := nat[indexOf(pet, "Zebra")]

						return Solution{
							DrinksWater: waterDrinker,
							OwnsZebra:   zebraOwner,
						}
					}
				}
			}
		}
	}

	return Solution{}
}

// permutations generates all permutations of a slice
func permutations(input []string) [][]string {
	if len(input) <= 1 {
		return [][]string{input}
	}

	var result [][]string
	for i := 0; i < len(input); i++ {
		rest := append([]string{}, input[:i]...)
		rest = append(rest, input[i+1:]...)

		furtherPerms := permutations(rest)

		for _, perm := range furtherPerms {
			result = append(result, append([]string{input[i]}, perm...))
		}
	}

	return result
}

// indexOf returns the index of a value in a slice
func indexOf(slice []string, value string) int {
	for i, v := range slice {
		if v == value {
			return i
		}
	}
	return -1
}

// abs returns the absolute value of an int
func abs(x int) int {
	if x < 0 {
		return -x
	}
	return x
}
