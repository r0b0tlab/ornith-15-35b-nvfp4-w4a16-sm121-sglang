use std::str::Chars;

pub fn answer(command: &str) -> Option<i32> {
    // Validate the command starts with "What is"
    let command = command.trim();
    if !command.starts_with("What is") {
        return None;
    }
    
    // Remove "What is" prefix and trailing "?"
    let mut rest = &command["What is".len()..];
    if rest.ends_with('?') {
        rest = &rest[..rest.len() - 1];
    }
    rest = rest.trim();
    
    if rest.is_empty() {
        return None;
    }
    
    // Parse the first number
    let mut chars = rest.chars();
    let first_num = match parse_number(&mut chars) {
        Some(n) => n,
        None => return None,
    };
    
    // If no more characters, we're done
    if chars.as_str().is_empty() {
        return Some(first_num);
    }
    
    // Process operations
    let mut result = first_num;
    let mut expect_number = true;
    let mut expect_operation = false;
    
    loop {
        if expect_number {
            // Expect an operation
            let op = parse_operation(&mut chars);
            match op {
                Some(Operation::Add) => result = result + next_number(&mut chars)?,
                Some(Operation::Subtract) => result = result - next_number(&mut chars)?,
                Some(Operation::Multiply) => result = result * next_number(&mut chars)?,
                Some(Operation::Divide) => result = result / next_number(&mut chars)?,
                Some(Operation::Power) => result = next_power(&mut chars)?,
                None => return None,
            }
            expect_number = false;
        } else {
            // Expect a number
            let num = next_number(&mut chars)?;
            if let Some(Operation::Power) = parse_operation(&mut chars) {
                result = result.pow(next_number(&mut chars)? as u32);
            }
            expect_number = true;
        }
        
        if chars.as_str().is_empty() {
            break;
        }
    }
    
    Some(result)
}

enum Operation {
    Add,
    Subtract,
    Multiply,
    Divide,
    Power,
}

fn parse_number<'a>(chars: &mut Chars<'a>) -> Option<i32> {
    let start = chars.clone().position(|c| c == '-').unwrap_or(usize::MAX);
    let mut num_str = String::new();
    
    while let Some(c) = chars.next() {
        if c.is_ascii_digit() {
            num_str.push(c);
        } else if c == '-' && num_str.is_empty() {
            num_str.push(c);
        } else {
            // Put back the non-digit character by recreating the iterator
            break;
        }
    }
    
    if num_str.is_empty() {
        None
    } else {
        num_str.parse::<i32>().ok()
    }
}

fn next_number<'a>(chars: &mut Chars<'a>) -> Option<i32> {
    // Skip whitespace
    while let Some(&c) = chars.clone().next() {
        if c == ' ' {
            chars.next();
        } else {
            break;
        }
    }
    
    parse_number(chars)
}

fn parse_operation<'a>(chars: &mut Chars<'a>) -> Option<Operation> {
    // Skip whitespace
    while let Some(&c) = chars.clone().next() {
        if c == ' ' {
            chars.next();
        } else {
            break;
        }
    }
    
    let rest: String = chars.as_str().to_string();
    
    if rest.starts_with("plus") {
        for _ in 0..4 {
            chars.next();
        }
        Some(Operation::Add)
    } else if rest.starts_with("minus") {
        for _ in 0..5 {
            chars.next();
        }
        Some(Operation::Subtract)
    } else if rest.starts_with("multiplied by") {
        for _ in 0..13 {
            chars.next();
        }
        Some(Operation::Multiply)
    } else if rest.starts_with("divided by") {
        for _ in 0..10 {
            chars.next();
        }
        Some(Operation::Divide)
    } else {
        None
    }
}

fn next_power<'a>(chars: &mut Chars<'a>) -> Option<i32> {
    // Skip "by"
    let rest = chars.as_str();
    if rest.starts_with("by") {
        for _ in 0..2 {
            chars.next();
        }
    } else {
        return None;
    }
    
    // Skip whitespace and parse the exponent
    next_number(chars)
}
