I'll implement the RESTful API for tracking IOUs. Let me explain the changes:

1. Add a default database with sample users in the constructor
2. Store users in a Map for efficient lookup
3. Implement `get` to handle `/users` requests with query parameters
4. Implement `post` to handle `/add` and `/iou` endpoints
5. Add helper methods to create user objects and update balances

rest-api.js
```javascript
//
// This is only a SKELETON file for the 'Rest API' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const defaultData = {
  users: [
    { name: 'Adam', owes: {}, owed_by: {}, balance: 0 },
    { name: 'Bob', owes: {}, owed_by: {}, balance: 0 },
    { name: 'Chuck', owes: {}, owed_by: {}, balance: 0 },
    { name: 'Dan', owes: {}, owed_by: {}, balance: 0 },
  ],
};

export class RestAPI {
  constructor(db = defaultData) {
    this.users = new Map();
    db.users.forEach(user => {
      this.users.set(user.name, {
        name: user.name,
        owes: { ...user.owes },
        owed_by: { ...user.owed_by },
        balance: user.balance,
      });
    });
  }

  getUser(name) {
    return this.users.get(name);
  }

  getUserResponse(name) {
    const user = this.users.get(name);
    if (!user) {
      return null;
    }

    const balance = this.calculateBalance(user);

    return {
      name: user.name,
      owes: { ...user.owes },
      owed_by: { ...user.owed_by },
      balance,
    };
  }

  calculateBalance(user) {
    let owedTotal = 0;
    Object.values(user.owed_by).forEach(amount => {
      owedTotal += amount;
    });

    let owedByTotal = 0;
    Object.values(user.owes).forEach(amount => {
      owedByTotal += amount;
    });

    return owedTotal - owedByTotal;
  }

  get(url) {
    const [path, query] = url.split('?');

    if (path === '/users') {
      const params = new URLSearchParams(query);
      const userNames = params.get('users');

      if (userNames) {
        const names = userNames.split(',');
        const users = names
          .map(name => this.getUserResponse(name))
          .filter(user => user !== null)
          .sort((a, b) => a.name.localeCompare(b.name));

        return { users };
      }

      // Return all users sorted by name
      const allUsers = Array.from(this.users.keys())
        .map(name => this.getUserResponse(name))
        .sort((a, b) => a.name.localeCompare(b.name));

      return { users: allUsers };
    }

    throw new Error(`Not found: ${path}`);
  }

  post(url, payload) {
    const [path] = url.split('?');

    if (path === '/add') {
      const { user } = payload;

      if (this.users.has(user)) {
        throw new Error(`User ${user} already exists`);
      }

      const newUser = {
        name: user,
        owes: {},
        owed_by: {},
        balance: 0,
      };

      this.users.set(user, newUser);

      return this.getUserResponse(user);
    }

    if (path === '/iou') {
      const { lender, borrower, amount } = payload;

      if (!this.users.has(lender) || !this.users.has(borrower)) {
        throw new Error('Lender or borrower does not exist');
      }

      const lenderUser = this.users.get(lender);
      const borrowerUser = this.users.get(borrower);

      // Update balances considering existing debts
      if (lenderUser.owes[borrower]) {
        // lender owes borrower, so we can reduce this debt
        if (lenderUser.owes[borrower] > amount) {
          borrowerUser.owed_by[lender] = lenderUser.owes[borrower] - amount;
          delete lenderUser.owes[borrower];
        } else {
          delete lenderUser.owes[borrower];
          const remaining = amount - lenderUser.owes[borrower];
          if (remaining > 0) {
            borrowerUser.owed_by[lender] = remaining;
          } else {
            delete borrowerUser.owed_by[lender];
          }
        }
      } else {
        borrowerUser.owed_by[lender] = (borrowerUser.owed_by[lender] || 0) + amount;
      }

      if (borrowerUser.owed_by[lender]) {
        if (borrowerUser.owed_by[lender] > amount) {
          lenderUser.owes[borrower] = borrowerUser.owed_by[lender] - amount;
          delete borrowerUser.owed_by[lender];
        } else {
          delete borrowerUser.owed_by[lender];
          const remaining = amount - borrowerUser.owed_by[lender];
          if (remaining > 0) {
            lenderUser.owes[borrower] = remaining;
          } else {
            delete lenderUser.owes[borrower];
          }
        }
      } else {
        lenderUser.owes[borrower] = (lenderUser.owes[borrower] || 0) + amount;
      }

      return {
        users: [
          this.getUserResponse(lender),
          this.getUserResponse(borrower),
        ].sort((a, b) => a.name.localeCompare(b.name)),
      };
    }

    throw new Error(`Not found: ${path}`);
  }
}
```
