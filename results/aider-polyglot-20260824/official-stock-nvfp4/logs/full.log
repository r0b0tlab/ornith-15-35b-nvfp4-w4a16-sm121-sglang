        let self_zero = self.int_digits.iter().all(|&d| d == 0) && self.frac_digits.iter().all(|&d| d == 0);
        let other_zero = other.int_digits.iter().all(|&d| d == 0) && other.frac_digits.iter().all(|&d| d == 0);
