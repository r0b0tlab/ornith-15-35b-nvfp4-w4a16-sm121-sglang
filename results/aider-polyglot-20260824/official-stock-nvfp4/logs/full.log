I'll rewrite the `BowlingGame` implementation to fix the issues. The main problems are with the scoring logic and game completion detection. Let me provide a cleaner, correct implementation.

lib.rs
```
#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
}

impl BowlingGame {
    pub fn new() -> Self {
        BowlingGame { rolls: Vec::new() }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if pins > 10 {
            return Err(Error::NotEnoughPinsLeft);
        }

        if self.is_game_complete() {
            return Err(Error::GameComplete);
        }

        // Determine max pins allowed for this roll
        let max_pins = self.max_pins_for_current_roll();
        match max_pins {
            Some(max) => {
                if pins > max {
                    return Err(Error::NotEnoughPinsLeft);
                }
            }
            None => {
                // No more rolls allowed
                return Err(Error::NotEnoughPinsLeft);
            }
        }

        self.rolls.push(pins);
        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if !self.is_game_complete() {
            return None;
        }

        let mut score = 0;
        let mut roll_index = 0;

        for _frame in 0..10 {
            if self.rolls[roll_index] == 10 {
                // Strike: 10 + next two rolls
                score += 10 + self.rolls[roll_index + 1] + self.rolls[roll_index + 2];
                roll_index += 1;
            } else {
                let frame_score = self.rolls[roll_index] + self.rolls[roll_index + 1];
                if frame_score == 10 {
                    // Spare: 10 + next roll
                    score += 10 + self.rolls[roll_index + 2];
                } else {
                    // Open frame
                    score += frame_score;
                }
                roll_index += 2;
            }
        }

        Some(score)
    }
    
    fn is_game_complete(&self) -> bool {
        let mut roll_index = 0;
        let mut frame = 0;
        
        // Check first 9 frames
        while frame < 9 {
            if roll_index >= self.rolls.len() {
                return false;
            }
            
            if self.rolls[roll_index] == 10 {
                // Strike
                roll_index += 1;
            } else {
                if roll_index + 1 >= self.rolls.len() {
                    return false;
                }
                roll_index += 2;
            }
            frame += 1;
        }
        
        // Check 10th frame
        if roll_index >= self.rolls.len() {
            return false;
        }
        
        let first = self.rolls[roll_index];
        
        if first == 10 {
            // Strike, need 2 more rolls
            self.rolls.len() >= roll_index + 3
        } else {
            // Not a strike
            if roll_index + 1 >= self.rolls.len() {
                return false;
            }
            let second = self.rolls[roll_index + 1];
            
            if first + second >= 10 {
                // Spare, need 1 more roll
                self.rolls.len() >= roll_index + 3
            } else {
                // Open frame, complete with 2 rolls
                self.rolls.len() == roll_index + 2
            }
        }
    }
    
    fn max_pins_for_current_roll(&self) -> Option<u16> {
        let mut roll_index = 0;
        let mut frame = 0;
        
        // Skip completed frames to find current roll
        while frame < 9 {
            if roll_index >= self.rolls.len() {
                // First roll of a frame
                return Some(10);
            }
            
            if self.rolls[roll_index] == 10 {
                // Strike, frame complete, move to next
                roll_index += 1;
            } else {
                if roll_index + 1 >= self.rolls.len() {
                    // First roll done, checking second roll
                    return Some(10 - self.rolls[roll_index]);
                }
                // Frame complete
                roll_index += 2;
            }
            frame += 1;
        }
        
        // At 10th frame
        if roll_index >= self.rolls.len() {
            // First roll of 10th frame
            return Some(10);
        }
        
        let first = self.rolls[roll_index];
        
        if first == 10 {
            // Strike in 10th
            if roll_index + 1 >= self.rolls.len() {
                // Second roll (fill ball), can be up to 10
                return Some(10);
            }
            let second = self.rolls[roll_index + 1];
            if second == 10 {
                // Two strikes, third roll (fill ball)
                return Some(10);
            } else {
                // Second roll after strike, can knock down remaining
                Some(10 - second)
            }
        } else {
            // Not a strike in 10th
            if roll_index + 1 >= self.rolls.len() {
                // Second roll, can knock down remaining
                Some(10 - first)
            } else {
                let second = self.rolls[roll_index + 1];
                if first + second >= 10 {
                    // Spare, fill ball
                    return Some(10);
                } else {
                    // Open frame, no more rolls
                    return None;
                }
            }
        }
    }
}
