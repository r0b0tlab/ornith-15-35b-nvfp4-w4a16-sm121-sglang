I'll implement the Pig Latin translation function according to the four rules.

Let me analyze the requirements:
1. Words starting with a vowel or "xr"/"yt" get "ay" added
2. Words starting with consonants move them to the end and add "ay"
3. Words with consonants + "qu" move those to the end and add "ay"
4. Words with consonants followed by "y" move the consonants before "y" to the end and add "ay"

I also need to handle multi-word phrases since the tests likely include sentences.

pig-latin.js
```javascript
//
// This is only a SKELETON file for the 'Pig Latin' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const VOWELS = new Set(['a', 'e', 'i', 'o', 'u']);

function translateWord(word) {
  // Rule 1: Word begins with a vowel, or starts with "xr" or "yt"
  if (VOWELS.has(word[0]) || word.startsWith('xr') || word.startsWith('yt')) {
    return word + 'ay';
  }

  // Find the consonant cluster to move
  let i = 0;
  
  // Rule 4: Handle 'y' as a vowel when it's not the first letter
  // We'll process consonants, but treat 'y' as a vowel if it appears after the first consonant
  while (i < word.length) {
    const char = word[i];
    
    // 'y' acts as a vowel when it's not at position 0
    if (i > 0 && char === 'y') {
      break;
    }
    
    if (!VOWELS.has(char)) {
      i++;
    } else {
      break;
    }
  }

  // Rule 3: Handle "qu" specially - include the 'u' if we've moved to include 'q'
  if (i > 0 && word[i - 1] === 'q' && word[i] === 'u') {
    i += 1;
  }

  // Rules 2, 3, 4: Move the consonant cluster to the end
  const prefix = word.slice(0, i);
  const rest = word.slice(i);
  
  return rest + prefix + 'ay';
}

export const translate = (text) => {
  return text.split(' ').map(translateWord).join(' ');
};
```
