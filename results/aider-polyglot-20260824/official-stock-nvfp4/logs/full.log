class Zipper:
    @staticmethod
    def from_tree(tree):
        """Create a zipper from a binary tree with focus on root."""
        return Zipper(tree, [])

    def __init__(self, focus, path):
        self.focus = focus
        self.path = path

    def value(self):
        """Get the value of the focus node."""
        return self.focus['value']

    def set_value(self, value):
        """Set the value of the focus node, returns a new zipper."""
        new_focus = dict(self.focus)
        new_focus['value'] = value
        return Zipper(new_focus, list(self.path))

    def left(self):
        """Move the focus to the left child, returns a new zipper."""
        new_focus = self.focus['left']
        if new_focus is None:
            return None
        return Zipper(new_focus, self.path + [('left', self.focus)])

    def set_left(self, tree):
        """Set the left subtree of the focus node, returns a new zipper."""
        new_focus = dict(self.focus)
        new_focus['left'] = tree
        return Zipper(new_focus, list(self.path))

    def right(self):
        """Move the focus to the right child, returns a new zipper."""
        new_focus = self.focus['right']
        if new_focus is None:
            return None
        return Zipper(new_focus, self.path + [('right', self.focus)])

    def set_right(self, tree):
        """Set the right subtree of the focus node, returns a new zipper."""
        new_focus = dict(self.focus)
        new_focus['right'] = tree
        return Zipper(new_focus, list(self.path))

    def up(self):
        """Move the focus to the parent, returns a new zipper."""
        if not self.path:
            return None
        direction, parent = self.path[-1]
        new_path = self.path[:-1]
        return Zipper(parent, new_path)

    def to_tree(self):
        """Get the binary tree out of the zipper."""
        if not self.path:
            return self.focus
        direction, parent = self.path[-1]
        new_parent = dict(parent)
        new_parent[direction] = self.focus
        return Zipper(new_parent, self.path[:-1]).to_tree()
```
