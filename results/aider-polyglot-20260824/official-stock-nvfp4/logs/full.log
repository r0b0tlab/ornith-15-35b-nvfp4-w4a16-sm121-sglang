```javascript
//
// This is only a SKELETON file for the 'Beer Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const recite = (initialBottlesCount, takeDownCount) => {
  const verses = [];

  for (let i = initialBottlesCount; i > initialBottlesCount - takeDownCount; i--) {
    if (i > 2) {
      verses.push(`${i} bottles of beer on the wall, ${i} bottles of beer.`);
      verses.push(`Take one down and pass it around, ${i - 1} bottles of beer on the wall.`);
    } else if (i === 2) {
      verses.push(`2 bottles of beer on the wall, 2 bottles of beer.`);
      verses.push(`Take one down and pass it around, 1 bottle of beer on the wall.`);
    } else if (i === 1) {
      verses.push(`1 bottle of beer on the wall, 1 bottle of beer.`);
      verses.push(`Take it down and pass it around, no more bottles of beer on the wall.`);
    } else if (i === 0) {
      verses.push(`No more bottles of beer on the wall, no more bottles of beer.`);
      verses.push(`Go to the store and buy some more, 99 bottles of beer on the wall.`);
    }

    if (i > initialBottlesCount - takeDownCount) {
      verses.push('');
    }
  }

  return verses.slice(0, -1);
};
```
