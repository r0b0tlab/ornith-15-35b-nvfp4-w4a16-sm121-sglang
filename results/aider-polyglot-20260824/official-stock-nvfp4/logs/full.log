Queen.java
```java
class Queen {

    private final int row;
    private final int column;

    Queen(int row, int column) {
        if (row < 0) {
            throw new IllegalArgumentException("Row must not be negative.");
        }
        if (row > 7) {
            throw new IllegalArgumentException("Row must be on the board.");
        }
        if (column < 0) {
            throw new IllegalArgumentException("Column must not be negative.");
        }
        if (column > 7) {
            throw new IllegalArgumentException("Column must be on the board.");
        }
        this.row = row;
        this.column = column;
    }

    int getRow() {
        return row;
    }

    int getColumn() {
        return column;
    }

}
```

QueenAttackCalculator.java
```java
class QueenAttackCalculator {

    private final Queen queen1;
    private final Queen queen2;

    QueenAttackCalculator(Queen queen1, Queen queen2) {
        if (queen1.equals(queen2)) {
            throw new IllegalArgumentException("Both queens cannot be in the same position.");
        }
        this.queen1 = queen1;
        this.queen2 = queen2;
    }

    boolean canQueensAttackOneAnother() {
        int rowDifference = Math.abs(queen1.getRow() - queen2.getRow());
        int columnDifference = Math.abs(queen1.getColumn() - queen2.getColumn());

        // Same row, same column, or same diagonal
        return rowDifference == 0 || columnDifference == 0 || rowDifference == columnDifference;
    }

}
```
