    /** Net balance: total owed by other users minus total owed to other users. */
    public double balance() {
        double totalOwedBy = 0;
        for (Iou iou : owedBy) {
            totalOwedBy += iou.amount();
        }
        double totalOwes = 0;
        for (Iou iou : owes) {
            totalOwes += iou.amount();
        }
        return totalOwedBy - totalOwes;
    }

    public static Builder builder() {
        return new Builder();
    }

    public static class Builder {
        private String name;
        private final List<Iou> owes = new ArrayList<>();
        private final List<Iou> owedBy = new ArrayList<>();

        public Builder setName(String name) {
            this.name = name;
            return this;
        }

        public Builder owes(String name, double amount) {
            owes.add(new Iou(name, amount));
            return this;
        }

        public Builder owedBy(String name, double amount) {
            owedBy.add(new Iou(name, amount));
            return this;
        }

        public Builder owes(List<Iou> ious) {
            owes.addAll(ious);
            return this;
        }

        public Builder owedBy(List<Iou> ious) {
            owedBy.addAll(ious);
            return this;
        }

        public User build() {
            return new User(name, owes, owedBy);
        }
    }
}
