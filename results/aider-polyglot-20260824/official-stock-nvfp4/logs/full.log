I need to rewrite the Scale class to fix the issues. The main problems are:

1. Using unicode symbols instead of ASCII (# and b)
2. Incorrect interval logic that uses result length instead of a running index
3. Incorrect tonic normalization (uppercase() breaks flats)

scale_generator.py
```
class Scale:
    def __init__(self, tonic):
        self.tonic = tonic
        self.flats = self._is_flat_tonic(tonic)

    def _is_flat_tonic(self, tonic):
        flat_keys = {
            'F', 'B♭', 'E♭', 'A♭', 'D♭', 'G♭',
            'd', 'g', 'c', 'f', 'b♭', 'e♭'
        }
        return tonic in flat_keys

    def chromatic(self):
        if self.flats:
            scale = ['A', 'B♭', 'B', 'C', 'D♭', 'D', 'E♭', 'E', 'F', 'G♭', 'G', 'A♭']
        else:
            scale = ['A', 'C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'B']

        tonic_lower = self.tonic.lower()
        start_index = 0
        for i, note in enumerate(scale):
            if note.lower() == tonic_lower:
                start_index = i
                break

        return scale[start_index:] + scale[:start_index]

    def interval(self, intervals):
        result = [self.tonic]
        current_index = 0

        for interval in intervals:
            if interval == 'm':
                current_index += 1
            elif interval == 'M':
                current_index += 2
            elif interval == 'A':
                current_index += 3

            current_index %= 12
            result.append(self.chromatic()[current_index])

        return result
```
