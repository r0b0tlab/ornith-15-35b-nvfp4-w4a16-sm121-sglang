class StateOfTicTacToe {
    public GameState determineState(String[] board) {
        int xCount = 0;
        int oCount = 0;
        
        for (String row : board) {
            for (char c : row.toCharArray()) {
                if (c == 'X') {
                    xCount++;
                } else if (c == 'O') {
                    oCount++;
                }
            }
        }
        
        // Check turn order validity
        if (xCount == oCount + 2) {
            throw new IllegalArgumentException("Wrong turn order: X went twice");
        }
        
        if (oCount > xCount) {
            throw new IllegalArgumentException("Wrong turn order: O started");
        }
        
        boolean xWins = hasWon(board, 'X');
        boolean oWins = hasWon(board, 'O');
        
        // Check for invalid states where game continued after win
        if (xWins && oWins) {
            throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
        }
        
        if (xWins) {
            if (xCount != oCount + 1) {
                // O moved after X won, invalid
                throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
            }
            return GameState.WIN;
        }
        
        if (oWins) {
            if (xCount != oCount) {
                // X moved after O won, invalid
                throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
            }
            return GameState.WIN;
        }
        
        // No winner yet
        if (xCount + oCount == 9) {
            // Board is full, it's a draw
            return GameState.DRAW;
        }
        
        // Game is ongoing
        return GameState.ONGOING;
    }
    
    private boolean hasWon(String[] board, char player) {
        // Check rows
        for (int i = 0; i < 3; i++) {
            if (board[i].charAt(0) == player && 
                board[i].charAt(1) == player && 
                board[i].charAt(2) == player) {
                return true;
            }
        }
        
        // Check columns
        for (int j = 0; j < 3; j++) {
            if (board[0].charAt(j) == player && 
                board[1].charAt(j) == player && 
                board[2].charAt(j) == player) {
                return true;
            }
        }
        
        // Check diagonals
        if (board[0].charAt(0) == player && 
            board[1].charAt(1) == player && 
            board[2].charAt(2) == player) {
            return true;
        }
        
        if (board[0].charAt(2) == player && 
            board[1].charAt(1) == player && 
            board[2].charAt(0) == player) {
            return true;
        }
        
        return false;
    }
}
```

Key changes:
1. Changed the turn order validation to throw specific error messages matching what the tests expect
2. Fixed the win logic: when X wins, X count must equal O count + 1; when O wins, X count must equal O count. Both of these are valid win conditions, and I only throw exceptions when the counts don't match the expected pattern for that winner.
