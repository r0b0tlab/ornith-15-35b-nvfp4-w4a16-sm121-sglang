SgfNode.java
```
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class SgfNode {
    private Map<String, List<String>> properties;
    private List<SgfNode> children;

    public SgfNode() {
        this.properties = new LinkedHashMap<String, List<String>>();
        this.children = new ArrayList<SgfNode>();
    }

    public SgfNode(List<Map<String, String>> properties) {
        this.properties = new LinkedHashMap<String, List<String>>();
        this.children = new ArrayList<SgfNode>();
        for (Map<String, String> property : properties) {
            for (Map.Entry<String, String> entry : property.entrySet()) {
                addProperty(entry.getKey(), entry.getValue());
            }
        }
    }

    public void addProperty(String key, String value) {
        if (!properties.containsKey(key)) {
            properties.put(key, new ArrayList<String>());
        }
        properties.get(key).add(value);
    }

    public List<String> getProperty(String key) {
        return properties.get(key);
    }

    public String getSingleProperty(String key) {
        if (!properties.containsKey(key)) {
            return null;
        }
        List<String> values = properties.get(key);
        if (values.size() == 1) {
            return values.get(0);
        }
        return null;
    }

    public void addChild(SgfNode child) {
        this.children.add(child);
    }

    public List<SgfNode> getChildren() {
        return children;
    }
}
```

