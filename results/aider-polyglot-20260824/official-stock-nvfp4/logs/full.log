package twobucket

import (
	"errors"
)

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {
	// Validate inputs
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 {
		return "", 0, 0, errors.New("bucket sizes must be positive")
	}
	if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount cannot exceed both bucket sizes")
	}

	// Check if goal is achievable (must be divisible by GCD of bucket sizes)
	gcd := gcd(sizeBucketOne, sizeBucketTwo)
	if goalAmount%gcd != 0 {
		return "", 0, 0, errors.New("goal amount not achievable")
	}

	// Determine bucket sizes based on which bucket to fill first
	var bucketOne, bucketTwo int

	if startBucket == "one" {
		bucketOne = sizeBucketOne
		bucketTwo = sizeBucketTwo
	} else if startBucket == "two" {
		bucketOne = sizeBucketOne
		bucketTwo = sizeBucketTwo
	} else {
		return "", 0, 0, errors.New("invalid start bucket")
	}

	// Track current state
	var currentOne, currentTwo int
	steps := 0

	// Track visited states to prevent infinite loops
	visited := make(map[[2]int]bool)

	// First action: fill the starting bucket
	if startBucket == "one" {
		currentOne = bucketOne
	} else {
		currentTwo = bucketTwo
	}
	steps++
	visited[[2]int{currentOne, currentTwo}] = true

	// Simulate the pouring process
	for currentOne != goalAmount && currentTwo != goalAmount {
		// Prevent reaching the forbidden state (start empty, other full)
		if startBucket == "one" && currentOne == 0 && currentTwo == bucketTwo {
			return "", 0, 0, errors.New("forbidden state reached")
		}
		if startBucket == "two" && currentTwo == 0 && currentOne == bucketOne {
			return "", 0, 0, errors.New("forbidden state reached")
		}

		done := false

		// If starting bucket is empty, fill it
		if startBucket == "one" && currentOne == 0 {
			currentOne = bucketOne
			steps++
			visited[[2]int{currentOne, currentTwo}] = true
			done = true
		} else if startBucket == "two" && currentTwo == 0 {
			currentTwo = bucketTwo
			steps++
			visited[[2]int{currentOne, currentTwo}] = true
			done = true
		}

		// If starting bucket is full, empty it
		if !done && startBucket == "one" && currentOne == bucketOne {
			currentOne = 0
			steps++
			visited[[2]int{currentOne, currentTwo}] = true
			done = true
		} else if !done && startBucket == "two" && currentTwo == bucketTwo {
			currentTwo = 0
			steps++
			visited[[2]int{currentOne, currentTwo}] = true
			done = true
		}

		// Pour from starting bucket to other bucket
		if !done {
			if startBucket == "one" {
				pour := min(currentOne, bucketTwo-currentTwo)
				currentOne -= pour
				currentTwo += pour
				steps++
				visited[[2]int{currentOne, currentTwo}] = true
				done = true
			} else {
				pour := min(currentTwo, bucketOne-currentOne)
				currentTwo -= pour
				currentOne += pour
				steps++
				visited[[2]int{currentOne, currentTwo}] = true
				done = true
			}
		}

		// Check for infinite loop
		if visited[[2]int{currentOne, currentTwo}] && steps > (bucketOne+bucketTwo)*2 {
			return "", 0, 0, errors.New("no solution found")
		}
	}

	// Determine which bucket has the goal and the other bucket's level
	if currentOne == goalAmount {
		return "one", steps, currentTwo, nil
	} else {
		return "two", steps, currentOne, nil
	}
}

// gcd computes the greatest common divisor
func gcd(a, b int) int {
	for b != 0 {
		a, b = b, a%b
	}
	return a
}

// min returns the minimum of two integers
func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
