I'll implement the affine cipher according to the specifications. The implementation needs:

1. A function to check if `a` and `m` are coprime
2. A function to find the modular multiplicative inverse
3. Encode function that applies the encryption formula and formats output in groups of 5
4. Decode function that applies the decryption formula

Here are the changes:

affine_cipher.py
```python
import math

def encode(plain_text, a, b):
    m = 26
    if math.gcd(a, m) != 1:
        raise ValueError("a and m must be coprime.")
    
    result = []
    for char in plain_text:
        if char.isalpha():
            i = ord(char.lower()) - ord('a')
            encrypted = (a * i + b) % m
            result.append(chr(encrypted + ord('a')))
        elif char.isdigit():
            result.append(char)
    
    encrypted_text = ''.join(result)
    
    # Group into chunks of 5
    grouped = []
    for i in range(0, len(encrypted_text), 5):
        grouped.append(encrypted_text[i:i+5])
    
    return ' '.join(grouped)

def decode(ciphered_text, a, b):
    m = 26
    if math.gcd(a, m) != 1:
        raise ValueError("a and m must be coprime.")
    
    # Find modular multiplicative inverse of a mod m
    a_inv = None
    for i in range(1, m):
        if (a * i) % m == 1:
            a_inv = i
            break
    
    if a_inv is None:
        raise ValueError("a and m must be coprime.")
    
    result = []
    for char in ciphered_text:
        if char.isalpha():
            y = ord(char.lower()) - ord('a')
            decrypted = (a_inv * (y - b)) % m
            result.append(chr(decrypted + ord('a')))
        elif char.isdigit():
            result.append(char)
    
    return ''.join(result)
```
