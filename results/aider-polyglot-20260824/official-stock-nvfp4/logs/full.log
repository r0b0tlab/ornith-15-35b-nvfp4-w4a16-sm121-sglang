lib.rs
```rust
use std::collections::HashMap;

pub fn solve(input: &str) -> Option<HashMap<char, u8>> {
    // Parse the input into words (addends and result)
    let parts: Vec<&str> = input.split("==").collect();
    if parts.len() != 2 {
        return None;
    }
    
    let left_parts: Vec<&str> = parts[0].split("+").collect();
    let right_part = parts[1].trim();
    
    let mut words: Vec<String> = Vec::new();
    for part in left_parts.iter() {
        let trimmed = part.trim();
        if !trimmed.is_empty() {
            words.push(trimmed.chars().collect());
        }
    }
    words.push(right_part.chars().collect());
    
    if words.is_empty() {
        return None;
    }
    
    // Collect all unique letters
    let mut letters: Vec<char> = Vec::new();
    for word in &words {
        for c in word.iter() {
            if !letters.contains(c) {
                letters.push(*c);
            }
        }
    }
    
    // Letters that cannot be zero (leading digits)
    let mut non_zero: Vec<char> = Vec::new();
    for word in &words {
        if word.len() > 1 {
            non_zero.push(word[0]);
        }
    }
    
    // If we have more letters than digits, no solution
    if letters.len() > 10 {
        return None;
    }
    
    // Try all permutations of digits
    let mut result = None;
    let mut assignment: HashMap<char, u8> = HashMap::new();
    let mut used: Vec<bool> = vec![false; 10];
    
    if backtrack(
        &letters,
        0,
        &words,
        &non_zero,
        &mut assignment,
        &mut used,
    ) {
        result = Some(assignment.clone());
    }
    
    result
}

fn backtrack(
    letters: &[char],
    index: usize,
    words: &[String],
    non_zero: &[char],
    assignment: &mut HashMap<char, u8>,
    used: &mut Vec<bool>,
) -> bool {
    // Base case: all letters assigned
    if index == letters.len() {
        return check_solution(words, non_zero, assignment);
    }
    
    // Try each digit for the current letter
    for digit in 0..10 {
        if !used[digit] {
            // Check if this letter can be zero
            let can_be_zero = !non_zero.contains(&letters[index]);
            if digit == 0 && !can_be_zero {
                continue;
            }
            
            // Assign digit to letter
            assignment.insert(letters[index], digit as u8);
            used[digit] = true;
            
            // Recurse
            if backtrack(letters, index + 1, words, non_zero, assignment, used) {
                return true;
            }
            
            // Undo assignment
            assignment.remove(&letters[index]);
            used[digit] = false;
        }
    }
    
    false
}

fn check_solution(
    words: &[String],
    non_zero: &[char],
    assignment: &HashMap<char, u8>,
) -> bool {
    // Verify no leading zeros
    for word in words {
        if word.len() > 1 && assignment[&word[0]] == 0 {
            return false;
        }
    }
    
    // Calculate sum of addends (all words except the last)
    let mut sum: u64 = 0;
    for word in &words[..words.len() - 1] {
        let mut value: u64 = 0;
        for c in word.iter() {
            value = value * 10 + assignment[c] as u64;
        }
        sum += value;
    }
    
    // Calculate the target value (last word)
    let target_word = &words[words.len() - 1];
    let mut target: u64 = 0;
    for c in target_word.iter() {
        target = target * 10 + assignment[c] as u64;
    }
    
    sum == target
}
```

This implementation:

1. **Parses** the input by splitting on `==` and `+` to extract individual words
2. **Collects** all unique letters and identifies which letters cannot be zero (leading digits of multi-digit numbers)
3. **Uses backtracking** to try all valid digit assignments to letters
4. **Validates** each complete assignment by checking that the sum of addends equals the target
5. Returns the solution as a `HashMap<char, u8>` or `None` if no solution exists

The algorithm efficiently prunes the search space by preventing leading zeros and only using each digit once.
