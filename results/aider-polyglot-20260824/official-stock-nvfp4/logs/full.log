 namespace diamond {
 
+std::string row(int index, int size) {
+    std::string result = "";
+    int char_pos = index;
+    int current_char = 'A' + index;
+    
+    for (int i = 0; i < size; i++) {
+        if (i == char_pos || i == (size - 1 - char_pos)) {
+            result += static_cast<char>(current_char);
