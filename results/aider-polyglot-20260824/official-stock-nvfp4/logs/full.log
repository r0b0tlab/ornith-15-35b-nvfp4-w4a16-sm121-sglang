NODE, EDGE, ATTR = range(3)


class Node:
    def __init__(self, name, attrs):
        self.name = name
        self.attrs = attrs

    def __eq__(self, other):
        return self.name == other.name and self.attrs == other.attrs


class Edge:
    def __init__(self, src, dst, attrs):
        self.src = src
        self.dst = dst
        self.attrs = attrs

    def __eq__(self, other):
        return (self.src == other.src and
                self.dst == other.dst and
                self.attrs == other.attrs)


class GraphAttribute:
    def __init__(self, attrs):
        self.attrs = attrs

    def __eq__(self, other):
        return self.attrs == other.attrs


class Graph:
    def __init__(self, data=None):
        self.nodes = []
        self.edges = []
        self.attrs = {}

        if data is None:
            return

        if not isinstance(data, (list, tuple)):
            raise TypeError("Graph data malformed")

        for item in data:
            if not isinstance(item, tuple):
                raise TypeError("Graph data malformed")
            if len(item) < 1:
                raise TypeError("Graph item incomplete")
            node_type = item[0]
            if node_type not in (NODE, EDGE, ATTR):
                raise ValueError("Graph item unknown item type")
            if node_type == NODE:
                if len(item) != 3:
                    raise ValueError("NODE malformed")
                node = Node(item[1], item[2])
                self.nodes.append(node)
            elif node_type == EDGE:
                if len(item) != 4:
                    raise ValueError("EDGE malformed")
                edge = Edge(item[1], item[2], item[3])
                self.edges.append(edge)
            elif node_type == ATTR:
                if len(item) != 3:
                    raise ValueError("ATTR malformed")
                self.attrs[item[1]] = item[2]

    def __iter__(self):
        yield from self.nodes
        yield from self.edges
        yield from self.attrs.values()

    def __contains__(self, value):
        if value in self.nodes:
            return True
        if value in self.edges:
            return True
        if any(value.attrs == attrs for attrs in self.attrs.values()):
            return True
        return False
