```python
import re


def answer(question):
    if not question.startswith("What is"):
        raise ValueError("unknown operation")
    
    # Extract the operation part after "What is"
    question = question[5:].strip()
    
    # Define the operations
    operations = {
        "plus": lambda a, b: a + b,
        "minus": lambda a, b: a - b,
        "multiplied by": lambda a, b: a * b,
        "divided by": lambda a, b: a / b,
    }
    
    # Replace "multiplied by" and "divided by" with single tokens
    question = question.replace("multiplied by", "multiplied_by")
    question = question.replace("divided by", "divided_by")
    
    # Tokenize the question
    tokens = question.split()
    
    # First token should be a number
    if not tokens:
        raise ValueError("syntax error")
    
    try:
        result = int(tokens[0])
    except ValueError:
        raise ValueError("syntax error")
    
    i = 1
    while i < len(tokens):
        token = tokens[i]
        
        # Check if token is an operation
        if token in operations:
            # Need two numbers for the operation
            if i + 1 >= len(tokens):
                raise ValueError("syntax error")
            
            try:
                next_num = int(tokens[i + 1])
            except ValueError:
                raise ValueError("syntax error")
            
            result = operations[token](result, next_num)
            i += 2
        else:
            # Token is not an operation - could be a number or invalid
            raise ValueError("syntax error")
    
    return result
```
