transpose.go
```go
package transpose

import "unicode/utf8"

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length among all rows
	maxLen := 0
	for _, row := range input {
		if utf8.RuneCountInString(row) > maxLen {
			maxLen = utf8.RuneCountInString(row)
		}
	}

	// Build the transposed result
	result := make([]string, 0, maxLen)

	for col := 0; col < maxLen; col++ {
		var rowRunes []rune
		for row := 0; row < len(input); row++ {
			runes := []rune(input[row])
			if col < len(runes) {
				rowRunes = append(rowRunes, runes[col])
			} else {
				// Pad with spaces up to the last row that has a character at this column
				hasChar := false
				for r := row + 1; r < len(input); r++ {
					if col < len([]rune(input[r])) {
						hasChar = true
						break
					}
				}
				if hasChar {
					rowRunes = append(rowRunes, ' ')
				}
			}
		}
		result = append(result, string(rowRunes))
	}

	return result
}
```
