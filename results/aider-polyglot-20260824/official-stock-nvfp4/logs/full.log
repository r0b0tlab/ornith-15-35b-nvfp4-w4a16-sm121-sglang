+    // Convert word to number using assignment, return null if incomplete or 
has zero leading
+    const wordToNumber = (word) => {
+      let num = 0;
+      for (let i = 0; i < word.length; i++) {
+        const digit = assignment[word[i]];
+        if (digit === undefined) {
+          return null; // incomplete
+        }
+        num = num * 10 + digit;
+      }
+      return num;
+    };
+
+    // Check if all letters are assigned
+    const allAssigned = lettersList.every(letter => assignment[letter] !== 
undefined);
+    
+    if (!allAssigned) {
+      return true; // Continue exploring partial assignments
+    }
+
+    // All assigned - check if valid
+    const wordNumbers = words.map(word => wordToNumber(word));
+    const resultNumber = wordToNumber(result);
+
+    if (wordNumbers.some(num => num === null) || resultNumber === null) {
+      return false;
+    }
+
+    const sum = wordNumbers.reduce((acc, num) => acc + num, 0);
+    return sum === resultNumber;
+  }
+
+  function backtrack(index) {
+    if (index === lettersList.length) {
+      // Check if we have a valid solution
+      const wordNumbers = words.map(word => {
+        let num = 0;
+        for (let i = 0; i < word.length; i++) {
+          num = num * 10 + assignment[word[i]];
+        }
+        return num;
