```java
import java.util.List;
import java.util.ArrayList;

class Dominoes {

    List<Domino> formChain(List<Domino> inputDominoes) throws ChainNotFoundException {
        if (inputDominoes.isEmpty()) {
            return new ArrayList<Domino>();
        }

        List<Domino> chain = new ArrayList<Domino>();
        boolean[] used = new boolean[inputDominoes.size()];

        if (buildChain(inputDominoes, used, chain, 0)) {
            return chain;
        }

        throw new ChainNotFoundException("No domino chain found.");
    }

    private boolean buildChain(List<Domino> inputDominoes, boolean[] used, List<Domino> chain, int requiredEnd) {
        if (chain.size() == inputDominoes.size()) {
            // All dominoes used; check if the chain is valid (first == last)
            Domino first = chain.get(0);
            Domino last = chain.get(chain.size() - 1);
            return first.left == last.right;
        }

        for (int i = 0; i < inputDominoes.size(); i++) {
            if (used[i]) {
                continue;
            }

            Domino domino = inputDominoes.get(i);

            // Try the domino in normal orientation
            if (domino.left == requiredEnd) {
                used[i] = true;
                chain.add(domino);

                if (buildChain(inputDominoes, used, chain, domino.right)) {
                    return true;
                }

                chain.remove(chain.size() - 1);
                used[i] = false;
            }

            // Try the domino in reversed orientation (only if different)
            if (domino.left != domino.right) {
                used[i] = true;
                chain.add(new Domino(domino.right, domino.left));

                if (buildChain(inputDominoes, used, chain, domino.left)) {
                    return true;
                }

                chain.remove(chain.size() - 1);
                used[i] = false;
            }
        }

        return false;
    }
}
