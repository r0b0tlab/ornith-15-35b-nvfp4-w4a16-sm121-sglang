I'll implement the word search solution. Let me analyze the requirements:

1. Search for words in all 8 directions (horizontal, vertical, diagonal)
2. Return the location of first and last letter of each word
3. The return type is `map[string][2][2]int` where the key is the word and the value is a 2x2 array of coordinates (first letter position and last letter position)

Here's my implementation:

word_search.go
```go
package wordsearch

func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
	result := make(map[string][2][2]int)

	if len(puzzle) == 0 {
		return result, nil
	}

	rows := len(puzzle)
	cols := len(puzzle[0])

	// Helper function to get the position of a word starting at (r, c) in direction (dr, dc)
	findWord := func(word string, r, c, dr, dc int) bool {
		if r+dr*(len(word)-1) < 0 || r+dr*(len(word)-1) >= rows {
			return false
		}
		if c+dc*(len(word)-1) < 0 || c+dc*(len(word)-1) >= cols {
			return false
		}

		for i := 0; i < len(word); i++ {
			nr := r + dr*i
			nc := c + dc*i
			if nr < 0 || nr >= rows || nc < 0 || nc >= cols || puzzle[nr][nc] != word[i] {
				return false
			}
		}
		return true
	}

	for _, word := range words {
		found := false

		// Try all 8 directions
		dirs := [8][2]int{
			{0, 1},   // right
			{0, -1},  // left
			{1, 0},   // down
			{-1, 0},  // up
			{1, 1},   // diagonal down-right
			{1, -1},  // diagonal down-left
			{-1, 1},  // diagonal up-right
			{-1, -1}, // diagonal up-left
		}

		for r := 0; r < rows && !found; r++ {
			for c := 0; c < cols && !found; c++ {
				for _, dir := range dirs {
					dr, dc := dir[0], dir[1]

					if findWord(word, r, c, dr, dc) {
						result[word] = [2][2]int{
							{r, c},
							{r + dr*(len(word)-1), c + dc*(len(word)-1)},
						}
						found = true
						break
					}
				}
			}
		}

		if !found {
			return nil, fmt.Errorf("word %q not found in puzzle", word)
		}
	}

	return result, nil
}
