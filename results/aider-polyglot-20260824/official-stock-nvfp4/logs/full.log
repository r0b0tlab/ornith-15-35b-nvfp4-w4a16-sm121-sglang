+            return ''
+        
+        # Check player O (top to bottom)
+        if self._has_path('O'):
+            return 'O'
+        
+        # Check player X (left to right)
+        if self._has_path('X'):
+            return 'X'
+        
+        return ''
+
+    def _has_path(self, player):
+        if not self.board:
+            return False
+        
+        rows = len(self.board)
+        cols = len(self.board[0]) if rows > 0 else 0
+        
+        # For player O: connect top row to bottom row
+        # For player X: connect left column to right column
+        
+        start_positions = []
+        for r in range(rows):
+            for c in range(cols):
+                if self.board[r][c] == player:
+                    # O starts from top row (r=0)
+                    # X starts from left column (c=0)
+                    if player == 'O' and r == 0:
+                        start_positions.append((r, c))
+                    elif player == 'X' and c == 0:
+                        start_positions.append((r, c))
+        
+        if not start_positions:
+            return False
+        
+        # Determine target condition
+        def is_target(pos):
+            r, c = pos
+            if player == 'O':
+                return r == rows - 1
+            else:  # player == 'X'
+                return c == cols - 1
+        
+        # BFS
+        visited = set()
+        queue = list(start_positions)
+        for pos in start_positions:
+            visited.add(pos)
+        
+        while queue:
+            r, c = queue.pop(0)
+            
+            if is_target((r, c)):
+                return True
+            
+            # Get neighbors
+            for nr, nc in self._neighbors(r, c):
+                if 0 <= nr < rows and 0 <= nc < cols:
+                    if self.board[nr][nc] == player and (nr, nc) not in 
visited:
+                        visited.add((nr, nc))
+                        queue.append((nr, nc))
+        
+        return False
+
+    def _neighbors(self, r, c):
+        # Hexagonal neighbors in rectangular representation
+        return [
+            (r, c - 1), (r, c + 1),  # left, right
+            (r - 1, c - 1), (r - 1, c),  # upper-left, upper-right
+            (r + 1, c - 1), (r + 1, c),  # lower-left, lower-right
+        ]
