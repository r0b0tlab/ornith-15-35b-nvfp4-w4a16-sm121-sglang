```rust
/// A munger which XORs a key with some data
#[derive(Clone)]
pub struct Xorcism<'a> {
    key: &'a [u8],
    position: usize,
}

impl<'a> Xorcism<'a> {
    /// Create a new Xorcism munger from a key
    ///
    /// Should accept anything which has a cheap conversion to a byte slice.
    pub fn new<Key>(key: &Key) -> Xorcism<'a>
    where
        Key: AsRef<[u8]>,
    {
        Xorcism {
            key: key.as_ref(),
            position: 0,
        }
    }

    /// XOR each byte of the input buffer with a byte from the key.
    ///
    /// Note that this is stateful: repeated calls are likely to produce different results,
    /// even with identical inputs.
    pub fn munge_in_place(&mut self, data: &mut [u8]) {
        for (i, byte) in data.iter_mut().enumerate() {
            *byte ^= self.key[(self.position + i) % self.key.len()];
        }
        self.position = (self.position + data.len()) % self.key.len();
    }

    /// XOR each byte of the data with a byte from the key.
    ///
    /// Note that this is stateful: repeated calls are likely to produce different results,
    /// even with identical inputs.
    ///
    /// Should accept anything which has a cheap conversion to a byte iterator.
    /// Shouldn't matter whether the byte iterator's values are owned or borrowed.
    pub fn munge<Data>(&mut self, data: Data) -> impl Iterator<Item = u8>
    where
        Data: IntoIterator,
        Data::Item: ToByte,
    {
        let key = self.key;
        let start_position = self.position;
        let len = key.len();

        XorMunge {
            key,
            iterator: data.into_iter(),
            position: start_position,
            len,
        }
    }

    /// Create a reader that XOR-decrypts the input using the key.
    #[cfg(feature = "io")]
    pub fn reader<R: Read>(self, reader: R) -> impl Read {
        XorcismReader {
            reader,
            key: self.key,
            position: self.position,
            len: self.key.len(),
        }
    }

    /// Create a writer that XOR-encrypts the output using the key.
    #[cfg(feature = "io")]
    pub fn writer<W: Write>(self, writer: W) -> impl Write {
        XorcismWriter {
            writer,
            key: self.key,
            position: self.position,
            len: self.key.len(),
        }
    }
}

/// Helper trait to convert items to bytes, handling both owned and borrowed bytes.
pub trait ToByte {
    fn to_byte(self) -> u8;
}

impl ToByte for u8 {
    fn to_byte(self) -> u8 {
        self
    }
}

impl ToByte for &u8 {
    fn to_byte(self) -> u8 {
        *self
    }
}

/// An iterator adaptor that XORs each element with a byte from the key,
/// advancing the key position after each element.
pub struct XorMunge<'a, I> {
    key: &'a [u8],
    iterator: I,
    position: usize,
    len: usize,
}

impl<'a, I> Iterator for XorMunge<'a, I>
where
    I: Iterator,
    I::Item: ToByte,
{
    type Item = u8;

    fn next(&mut self) -> Option<u8> {
        let byte = self.iterator.next()?.to_byte();
        let key_index = self.position % self.len;
        let result = byte ^ self.key[key_index];
        self.position = (self.position + 1) % self.len;
        Some(result)
    }
}

#[cfg(feature = "io")]
use std::io::{self, Read, Write};

#[cfg(feature = "io")]
struct XorcismReader<'a, R> {
    reader: R,
    key: &'a [u8],
    position: usize,
    len: usize,
}

#[cfg(feature = "io")]
impl<'a, R: Read> Read for XorcismReader<'a, R> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let n = self.reader.read(buf)?;
        for (i, byte) in buf[..n].iter_mut().enumerate() {
            *byte ^= self.key[(self.position + i) % self.len];
        }
        self.position = (self.position + n) % self.len;
        Ok(n)
    }
}

#[cfg(feature = "io")]
struct XorcismWriter<'a, W> {
    writer: W,
    key: &'a [u8],
    position: usize,
    len: usize,
}

#[cfg(feature = "io")]
impl<'a, W: Write> Write for XorcismWriter<'a, W> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let mut written = 0usize;
        for (i, &byte) in buf.iter().enumerate() {
            let xored = byte ^ self.key[(self.position + i) % self.len];
            self.writer.write_all(&[xored])?;
            written += 1;
        }
        self.position = (self.position + written) % self.len;
        Ok(written)
    }

    fn flush(&mut self) -> io::Result<()> {
        self.writer.flush()
    }
}
```

