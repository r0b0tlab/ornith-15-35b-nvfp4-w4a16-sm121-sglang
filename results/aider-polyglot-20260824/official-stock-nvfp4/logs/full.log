 #include "robot_name.h"
+#include <stdexcept>
 
 namespace robot_name {
 
+std::unordered_set<std::string> Robot::used_names_;
+
+std::mt19937& Robot::get_rng() {
+    static std::mt19937 rng(std::random_device{}());
+    return rng;
+}
+
+Robot::Robot() : has_name_(false) {}
+
+Robot::~Robot() {}
+
+std::string Robot::generate_unique_name() const {
+    std::string name;
+    do {
+        // Generate two uppercase letters
+        std::uniform_int_distribution<int> letter_dist(0, 25);
+        char first_letter = 'A' + letter_dist(get_rng());
+        char second_letter = 'A' + letter_dist(get_rng());
+        
+        // Generate three digits
+        std::uniform_int_distribution<int> digit_dist(0, 9);
+        char first_digit = '0' + digit_dist(get_rng());
+        char second_digit = '0' + digit_dist(get_rng());
+        char third_digit = '0' + digit_dist(get_rng());
+        
+        name = std::string(1, first_letter) + std::string(1, second_letter) +
+               std::string(1, first_digit) + std::string(1, second_digit) +
+               std::string(1, third_digit);
+    } while (used_names_.find(name) != used_names_.end());
+    
+    used_names_.insert(name);
+    return name;
+}
+
+std::string Robot::get_name() const {
+    if (!has_name_) {
+        name_ = generate_unique_name();
+        has_name_ = true;
+    }
+    return name_;
+}
+
+void Robot::reset() {
+    // Remove the name from the set of used names
+    auto it = used_names_.find(name_);
+    if (it != used_names_.end()) {
+        used_names_.erase(it);
+    }
+    name_.clear();
+    has_name_ = false;
+}
+
 }  // namespace robot_name
