export class Bowling {
  constructor() {
    this._rolls = [];
  }

  roll(pins) {
    if (pins < 0) {
      throw new Error('Negative roll is invalid');
    }
    if (pins > 10) {
      throw new Error('Pin count exceeds pins on the lane');
    }
    if (this._isGameComplete()) {
      throw new Error('Cannot roll after game is complete');
    }

    this._validateRoll(pins);
    this._rolls.push(pins);
  }

  score() {
    if (!this._isGameComplete()) {
      throw new Error('Score cannot be taken until the end of the game');
    }

    let score = 0;
    let rollIndex = 0;

    for (let frame = 0; frame < 10; frame++) {
      if (this._rolls[rollIndex] === 10) {
        // Strike
        score += 10 + this._rolls[rollIndex + 1] + this._rolls[rollIndex + 2];
        rollIndex++;
      } else if (this._rolls[rollIndex] + this._rolls[rollIndex + 1] === 10) {
        // Spare
        score += 10 + this._rolls[rollIndex + 2];
        rollIndex += 2;
      } else {
        // Open frame
        score += this._rolls[rollIndex] + this._rolls[rollIndex + 1];
        rollIndex += 2;
      }
    }

    return score;
  }

  _isGameComplete() {
    // Count frames by processing rolls
    let rollIndex = 0;
    
    for (let frame = 0; frame < 10; frame++) {
      // Check if we have enough rolls left
      if (rollIndex >= this._rolls.length) {
        return false;
      }

      if (frame === 9) {
        // 10th frame special handling
        const firstRoll = this._rolls[rollIndex];
        
        if (firstRoll === 10) {
          // Strike - need 2 more rolls (or 2 strikes)
          if (this._rolls.length - rollIndex < 3) {
            return false;
          }
          const secondRoll = this._rolls[rollIndex + 1];
          if (secondRoll === 10) {
            // Second strike - need one more ball
            if (this._rolls.length - rollIndex < 3) {
              return false;
            }
          } else {
            // Not a second strike - game complete with 2 rolls
            return true;
          }
        } else {
          // Not a strike - need second roll
          if (this._rolls.length - rollIndex < 2) {
            return false;
          }
          const secondRoll = this._rolls[rollIndex + 1];
          if (firstRoll + secondRoll === 10) {
            // Spare - need one more fill ball
            if (this._rolls.length - rollIndex < 3) {
              return false;
            }
          } else {
            // Open frame - game complete
            return true;
          }
        }
        return true;
      } else {
        // Frames 1-9
        const firstRoll = this._rolls[rollIndex];
        
        if (firstRoll === 10) {
          // Strike - one roll for this frame
          rollIndex++;
        } else {
          // Not a strike - need second roll
          if (rollIndex + 1 >= this._rolls.length) {
            return false;
          }
          const secondRoll = this._rolls[rollIndex + 1];
          if (firstRoll + secondRoll > 10) {
            throw new Error('Pin count exceeds pins on the lane');
          }
          rollIndex += 2;
        }
      }
    }

    return true;
  }

  _validateRoll(pins) {
    let rollIndex = 0;
    
    for (let frame = 0; frame < 10; frame++) {
      if (rollIndex >= this._rolls.length) {
        // This is the first roll of the current frame
        return;
      }

      if (frame === 9) {
        // 10th frame special handling
        const firstRoll = this._rolls[rollIndex];
        
        if (firstRoll === 10) {
          // Strike - this is first roll of 10th frame
          return;
        }
        
        // Check if this is second roll
        if (rollIndex === this._rolls.length) {
          // Second roll of 10th frame
          const maxPins = 10 - firstRoll;
          if (pins > maxPins) {
            throw new Error('Pin count exceeds pins on the lane');
          }
          return;
        }
        
        // This is a fill ball
        const secondRoll = this._rolls[rollIndex + 1];
        
        if (secondRoll === undefined) {
          return;
        }
        
        // Determine if this is a fill ball
        if (firstRoll === 10) {
          // First roll was a strike
          if (secondRoll === 10) {
            // Second was also a strike, this is third roll
            return;
          } else {
            // Second wasn't a strike, this is third roll
            const maxPins = 10 - secondRoll;
            if (pins > maxPins) {
              throw new Error('Pin count exceeds pins on the lane');
            }
            return;
          }
        } else {
          // First roll wasn't a strike, so second roll completed the frame
          // This is a fill ball
          if (firstRoll + secondRoll === 10) {
            // Spare, fill ball can be up to 10
            return;
          } else {
            // Open frame, shouldn't reach here
            return;
          }
        }
      } else {
        // Frames 1-9
        const firstRoll = this._rolls[rollIndex];
        
        if (firstRoll === 10) {
          // First roll was a strike, moving to next frame
          rollIndex++;
        } else {
          // This is the second roll
          const maxPins = 10 - firstRoll;
          if (pins > maxPins) {
            throw new Error('Pin count exceeds pins on the lane');
          }
          return;
        }
      }
    }
  }
