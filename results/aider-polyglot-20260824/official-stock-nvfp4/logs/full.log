```go
package wordy

import (
	"strconv"
	"strings"
)

func Answer(question string) (int, bool) {
	if !strings.HasPrefix(question, "What is ") {
		return 0, false
	}

	// Remove the "What is " prefix and trailing "?"
	rest := question[len("What is "):]
	rest = strings.TrimSuffix(rest, "?")

	if rest == "" {
		return 0, false
	}

	// Split into tokens
	tokens := strings.Fields(rest)
	if len(tokens) == 0 {
		return 0, false
	}

	// First token must be a number
	num, err := strconv.Atoi(tokens[0])
	if err != nil {
		return 0, false
	}

	result := num

	for i := 1; i < len(tokens); i += 2 {
		op := tokens[i]

		// Determine the operation
		var applyOp func(int) (int, bool)

		switch op {
		case "plus":
			applyOp = func(n int) (int, bool) { return n + nextNumber(tokens, i+1) }
		case "minus":
			applyOp = func(n int) (int, bool) { return n - nextNumber(tokens, i+1) }
		case "multiplied":
			if i+1 >= len(tokens) || tokens[i+1] != "by" {
				return 0, false
			}
			applyOp = func(n int) (int, bool) { return n * nextNumber(tokens, i+2) }
		case "divided":
			if i+1 >= len(tokens) || tokens[i+1] != "by" {
				return 0, false
			}
			applyOp = func(n int) (int, bool) { return n / nextNumber(tokens, i+2) }
		default:
			return 0, false
		}

		// Apply the operation
		newResult, ok := applyOp(result)
		if !ok {
			return 0, false
		}
		result = newResult
	}

	return result, true
}

func nextNumber(tokens []string, index int) int {
	if index >= len(tokens) {
		return 0
	}
	num, err := strconv.Atoi(tokens[index])
	if err != nil {
		return 0
	}
	return num
}
```

