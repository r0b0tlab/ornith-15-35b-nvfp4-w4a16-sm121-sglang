```javascript
//
// This is only a SKELETON file for the 'Say' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const belowTen = [
  '', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'
];

const belowHundred = [
  'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen'
];

const tens = [
  '', 'ten', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy',
  'eighty', 'ninety'
];

const scales = [
  '', 'thousand', 'million', 'billion'
];

// Convert a number from 0-999 to English
const convertThreeDigit = (num) => {
  let parts = [];
  const hundreds = Math.floor(num / 100);
  const remainder = num % 100;

  if (hundreds > 0) {
    parts.push(belowTen[hundreds], 'hundred');
  }

  if (remainder > 0) {
    const tensValue = Math.floor(remainder / 10);
    const onesValue = remainder % 10;

    if (tensValue === 0) {
      parts.push(belowTen[onesValue]);
    } else if (tensValue === 1) {
      parts.push(belowHundred[onesValue]);
    } else {
      let tensPart = tens[tensValue];
      if (onesValue > 0) {
        tensPart += '-' + belowTen[onesValue];
      }
      parts.push(tensPart);
    }
  }

  return parts.join(' ');
};

// Break a number into chunks of thousands
const splitIntoChunks = (num) => {
  const chunks = [];
  if (num === 0) {
    return [0];
  }
  while (num > 0) {
    chunks.push(num % 1000);
    num = Math.floor(num / 1000);
  }
  return chunks;
};

export const say = (n) => {
  // Validate input
  if (n < 0 || n > 999999999999) {
    throw new Error('Number must be between 0 and 999,999,999,999.');
  }

  // Handle special case of 0
  if (n === 0) {
    return 'zero';
  }

  // Split number into chunks of thousands
  const chunks = splitIntoChunks(n);
  const resultParts = [];

  // Process each chunk with appropriate scale
  for (let i = chunks.length - 1; i >= 0; i--) {
    const chunkValue = chunks[i];
    if (chunkValue > 0) {
      const scaleWord = scales[i] || '';
      const chunkText = convertThreeDigit(chunkValue);
      if (scaleWord) {
        resultParts.push(`${chunkText} ${scaleWord}`);
      } else {
        resultParts.push(chunkText);
      }
    }
  }

  return resultParts.join(' ');
};
