//
// This is only a SKELETON file for the 'Tournament' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const tournamentTally = (input) => {
  // Handle empty or null input
  if (!input || input.trim() === '') {
    return 'Team                           | MP |  W |  D |  L |  P';
  }

  // Initialize the table header
  let table = 'Team                           | MP |  W |  D |  L |  P';

  // Create a Map to store team statistics
  const teams = new Map();

  // Split input into lines
  const lines = input.split('\n');

  // Process each line
  for (const line of lines) {
    // Skip empty lines
    if (line.trim() === '') continue;

    // Split each line by semicolons
    const parts = line.split(';');

    // Validate line format
    if (parts.length !== 3) {
      throw new Error('Invalid input');
    }

    const [team1, team2, outcome] = parts;

    // Validate outcome
    const validOutcomes = ['win', 'draw', 'loss'];
    if (!validOutcomes.includes(outcome)) {
      throw new Error('Invalid outcome');
    }

    // Ensure both teams exist in the Map
    if (!teams.has(team1)) {
      teams.set(team1, { mp: 0, w: 0, d: 0, l: 0, p: 0 });
    }
    if (!teams.has(team2)) {
      teams.set(team2, { mp: 0, w: 0, d: 0, l: 0, p: 0 });
    }

    // Update stats for both teams
    const team1Stats = teams.get(team1);
    const team2Stats = teams.get(team2);

    // Increment matches played
    team1Stats.mp++;
    team2Stats.mp++;

    // Update stats based on outcome
    if (outcome === 'win') {
      team1Stats.w++;
      team1Stats.p += 3;
      team2Stats.l++;
    } else if (outcome === 'loss') {
      team1Stats.l++;
      team2Stats.w++;
      team2Stats.p += 3;
    } else if (outcome === 'draw') {
      team1Stats.d++;
      team1Stats.p += 1;
      team2Stats.d++;
      team2Stats.p += 1;
    }
  }

  // Convert Map to array and sort
  const sortedTeams = Array.from(teams.entries())
    .map(([name, stats]) => ({ name, ...stats }))
    .sort((a, b) => {
      // First sort by points (descending)
      if (b.p !== a.p) {
        return b.p - a.p;
      }
      // Then sort alphabetically
      return a.name.localeCompare(b.name);
    });

  // Build table rows
  for (const team of sortedTeams) {
    table += `\n${team.name.padEnd(31)}|  ${team.mp} |  ${team.w} |  ${team.d} |  ${team.l} | ${String(team.p).padStart(2)}`;
  }

  return table;
};
```
