Let me rewrite the `answer` function with a cleaner regex-based approach.

wordy.py
```python
import re


def answer(question):
    if not question.startswith("What is"):
        raise ValueError("unknown operation")

    # Extract the operation part after "What is"
    body = question[len("What is"):].strip().rstrip("?").strip()

    if not body:
        raise ValueError("syntax error")

    # Replace multi-word operations with placeholders
    body = body.replace("multiplied by", "multiplied")
    body = body.replace("divided by", "divided")

    # Tokenize the body, keeping numbers (including negatives) and words
    tokens = re.findall(r"-?\d+|[a-z]+", body)

    if not tokens:
        raise ValueError("syntax error")

    # First token must be a number
    try:
        result = int(tokens[0])
    except ValueError:
        raise ValueError("syntax error")

    operations = {
        "plus": lambda a, b: a + b,
        "minus": lambda a, b: a - b,
        "multiplied": lambda a, b: a * b,
        "divided": lambda a, b: a // b,
    }

    i = 1
    while i < len(tokens):
        op = tokens[i]

        if op not in operations:
            raise ValueError("unknown operation")

        # Need a number after the operation
        if i + 1 >= len(tokens):
            raise ValueError("syntax error")

        try:
            next_num = int(tokens[i + 1])
        except ValueError:
            raise ValueError("syntax error")

        result = operations[op](result, next_num)
        i += 2

    return result
