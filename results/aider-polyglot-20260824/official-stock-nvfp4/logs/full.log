        boolean[][] visited = new boolean[rows][columns];
        carveMaze(maze, visited, 0, 0, random, rows, columns);
        
        // Add entrance and exit
        maze[1][0] = '⇨';
        maze[2 * rows][2 * columns - 1] = '☤';
        
        // Now build the walls with proper box-drawing characters
        buildWalls(maze, rows, columns);
        
        return maze;
    }
    
    private void carveMaze(char[][] maze, boolean[][] visited, int col, int row, 
                           Random random, int rows, int columns) {
        visited[row][col] = true;
        
        // Define possible directions: up, right, down, left
        int[][] directions = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
        
        // Shuffle directions
        for (int i = directions.length - 1; i > 0; i--) {
            int j = random.nextInt(i + 1);
            int[] temp = directions[i];
            directions[i] = directions[j];
            directions[j] = temp;
        }
        
        for (int[] dir : directions) {
            int nextCol = col + dir[0];
            int nextRow = row + dir[1];
            
            // Check bounds
            if (nextCol >= 0 && nextCol < columns && nextRow >= 0 && nextRow < rows 
                && !visited[nextRow][nextCol]) {
                
                // Remove wall between current cell and next cell
                // Current cell center: (row * 2 + 1, col * 2 + 1)
                // Next cell center: (nextRow * 2 + 1, nextCol * 2 + 1)
                // Wall is exactly between them
                
                if (dir[0] == 1) { // Moving right
                    // Wall is at (row*2+1, col*2+2)
                    maze[row * 2 + 1][col * 2 + 2] = ' ';
                } else if (dir[0] == -1) { // Moving left
                    // Wall is at (row*2+1, col*2)
                    maze[row * 2 + 1][col * 2] = ' ';
                } else if (dir[1] == 1) { // Moving down
                    // Wall is at (row*2+2, col*2+1)
                    maze[row * 2 + 2][col * 2 + 1] = ' ';
                } else if (dir[1] == -1) { // Moving up
                    // Wall is at (row*2, col*2+1)
                    maze[row * 2][col * 2 + 1] = ' ';
                }
                
                // Recurse into next cell
                carveMaze(maze, visited, nextCol, nextRow, random, rows, columns);
            }
        }
    }
    
    private void buildWalls(char[][] maze, int rows, int columns) {
        for (int i = 0; i < maze.length; i++) {
            for (int j = 0; j < maze[0].length; j++) {
                if (i % 2 == 0 && j % 2 == 0) {
                    // This is a corner position
                    maze[i][j] = buildCornerCharacter(maze, i, j, rows, columns);
                } else if (i % 2 == 0) {
                    // This is a horizontal wall segment
                    maze[i][j] = buildHorizontalCharacter(maze, i, j, rows, columns);
                } else if (j % 2 == 0) {
                    // This is a vertical wall segment
                    maze[i][j] = buildVerticalCharacter(maze, i, j, rows, columns);
                }
            }
        }
    }
    
    private char buildCornerCharacter(char[][] maze, int i, int j, int rows, int columns) {
        // Check which directions have walls or boundaries
        boolean up = i == 0 || (i - 2 >= 0 && maze[i - 2][j] != ' ') || (i - 1 >= 0 && maze[i - 1][j] != ' ');
        boolean down = i == 2 * rows || (i + 2 <= 2 * rows && maze[i + 2][j] != ' ') || (i + 1 <= 2 * rows && maze[i + 1][j] != ' ');
        boolean left = j == 0 || (j - 2 >= 0 && maze[i][j - 2] != ' ') || (j - 1 >= 0 && maze[i][j - 1] != ' ');
        boolean right = j == 2 * columns || (j + 2 <= 2 * columns && maze[i][j + 2] != ' ') || (j + 1 <= 2 * columns && maze[i][j + 1] != ' ');
        
        // Simplified: just use appropriate characters based on neighbors
        if (up && left && right && !down) return '┌';
        if (up && right && left && !down) return '┌';
        if (up && right && !left) return '├';
        if (up && left && !right) return '┴';
        if (down && left && right && !up) return '┴';
        if (down && right && !left) return '┬';
        if (down && left && !right) return '┬';
        if (down && !left && !right) return '─';
        if (up && !left && !right) return '─';
        return '┼';
    }
    
    private char buildHorizontalCharacter(char[][] maze, int i, int j, int rows, int columns) {
        // Horizontal wall - check if it connects to vertical walls
        boolean left = j == 0 || maze[i][j - 1] != ' ';
        boolean right = j == 2 * columns || maze[i][j + 1] != ' ';
        return (left && right) ? '─' : '─';
    }
    
    private char buildVerticalCharacter(char[][] maze, int i, int j, int rows, int columns) {
        // Vertical wall - check if it connects to horizontal walls
        boolean up = i == 0 || maze[i - 1][j] != ' ';
        boolean down = i == 2 * rows || maze[i + 1][j] != ' ';
        return (up && down) ? '│' : '│';
    }
}
