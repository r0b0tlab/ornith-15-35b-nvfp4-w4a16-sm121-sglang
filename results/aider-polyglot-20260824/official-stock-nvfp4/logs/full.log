            if (value != null && value.equals(newValue)) {
                return;
            }
            if (value == null && newValue == null) {
                return;
            }

            value = newValue;

            // Collect all affected compute cells via BFS
            List<ComputeCell<T>> affected = new ArrayList<>();
            
            Queue<ComputeCell<T>> queue = new LinkedList<>();
            for (ComputeCell<T> dependent : dependents) {
                queue.add(dependent);
            }
            
            while (!queue.isEmpty()) {
                ComputeCell<T> cell = queue.poll();
                if (!affected.contains(cell)) {
                    affected.add(cell);
                    for (ComputeCell<T> dependent : cell.dependents) {
                        if (!affected.contains(dependent)) {
                            queue.add(dependent);
                        }
                    }
                }
            }

            // Update all affected cells and trigger callbacks
            for (ComputeCell<T> cell : affected) {
                T oldValue = cell.getValue();
                cell.updateValue();
                T newValue = cell.getValue();
                if (oldValue == null ? newValue != null : !oldValue.equals(newValue)) {
                    cell.fireCallbacks(oldValue, newValue);
                }
            }
        }

        void registerDependent(ComputeCell<T> cell) {
            dependents.add(cell);
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private final Function<List<T>, T> function;
        private final List<Cell<T>> cells;
        private final List<Consumer<T>> callbacks = new ArrayList<>();
        private final List<ComputeCell<T>> dependents = new ArrayList<>();
        private T value;

        public ComputeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
            this.function = function;
            this.cells = cells;
            for (Cell<T> cell : cells) {
                if (cell instanceof InputCell<T>) {
                    ((InputCell<T>) cell).registerDependent(this);
                }
            }
            this.value = computeValue();
        }

        @Override
