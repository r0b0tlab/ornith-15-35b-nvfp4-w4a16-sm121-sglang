            int englishman_pos = -1;
            for (int i = 0; i < 5; i++) {
                if (nationalities[nat_idx[i]] == "Englishman") {
                    englishman_pos = i;
                    break;
                }
            }
            if (englishman_pos == -1 || colors[color_idx[englishman_pos]] != "red") continue;
            
