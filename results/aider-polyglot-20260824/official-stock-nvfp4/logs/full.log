  constructor(board) {
    this.board = board;
    this.height = board.length;
    this.width = board.length > 0 ? board[0].length : 0;
  }

  _isValidCoordinate(x, y) {
    return x >= 0 && x < this.width && y >= 0 && y < this.height;
  }

  _getCell(x, y) {
    if (this._isValidCoordinate(x, y)) {
      return this.board[y][x];
    }
    return null;
  }

  getTerritory(x, y) {
    if (!this._isValidCoordinate(x, y)) {
      return {
        error: 'Invalid coordinate'
      };
    }

    const cell = this._getCell(x, y);
    if (cell !== ' ') {
      return {
        error: 'Not an empty intersection'
      };
    }

    // Flood fill to find all connected empty intersections
    const territory = new Set();
    const visited = new Set();
    const stack = [[x, y]];
    const neighbors = {
      BLACK: false,
      WHITE: false
    };

    while (stack.length > 0) {
      const [cx, cy] = stack.pop();
      const key = `${cx},${cy}`;

      if (visited.has(key)) {
        continue;
      }
      visited.add(key);

      if (this._getCell(cx, cy) === ' ') {
        territory.add(key);

        // Check all 4 neighbors
        const directions = [
          [1, 0], [-1, 0], [0, 1], [0, -1]
        ];

        for (const [dx, dy] of directions) {
          const nx = cx + dx;
          const ny = cy + dy;
          const neighborCell = this._getCell(nx, ny);

          if (neighborCell === 'B') {
            neighbors.BLACK = true;
          } else if (neighborCell === 'W') {
            neighbors.WHITE = true;
          } else if (neighborCell === ' ' && !visited.has(`${nx},${ny}`)) {
            stack.push([nx, ny]);
          }
        }
      }
    }

    // Determine owner
    let owner = 'NONE';
    if (neighbors.BLACK && !neighbors.WHITE) {
      owner = 'BLACK';
    } else if (neighbors.WHITE && !neighbors.BLACK) {
      owner = 'WHITE';
    }

    // Convert territory set to sorted array of coordinates
    const territoryArray = Array.from(territory)
      .map(key => {
        const [tx, ty] = key.split(',').map(Number);
        return [tx, ty];
      })
      .sort((a, b) => a[0] - b[0] || a[1] - b[1]);

    return {
      owner,
      territory: territoryArray
    };
  }

  getTerritories() {
    const result = {
      territoryBlack: [],
      territoryWhite: [],
      territoryNone: []
    };

    // Track which cells have been assigned to territories
    const assignedCells = new Set();

    // Find all territories
    for (let y = 0; y < this.height; y++) {
      for (let x = 0; x < this.width; x++) {
        const key = `${x},${y}`;

        // Skip if already assigned or not empty
        if (assignedCells.has(key)) {
          continue;
        }

        const cell = this._getCell(x, y);
        if (cell !== ' ') {
          continue;
        }

        // Get territory for this empty intersection
        const territoryResult = this.getTerritory(x, y);

        if (territoryResult.error) {
          continue;
        }

        // Mark all cells in this territory as assigned
        for (const [tx, ty] of territoryResult.territory) {
          assignedCells.add(`${tx},${ty}`);
        }

        // Add to appropriate territory array based on owner
        if (territoryResult.owner === 'BLACK') {
          result.territoryBlack.push(...territoryResult.territory);
        } else if (territoryResult.owner === 'WHITE') {
          result.territoryWhite.push(...territoryResult.territory);
        } else {
          result.territoryNone.push(...territoryResult.territory);
        }
      }
    }

    // Sort all territory arrays
    result.territoryBlack.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    result.territoryWhite.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    result.territoryNone.sort((a, b) => a[0] - b[0] || a[1] - b[1]);

    return result;
  }
}
