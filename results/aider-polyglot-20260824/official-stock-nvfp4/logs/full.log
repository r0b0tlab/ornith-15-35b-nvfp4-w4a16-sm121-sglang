use std::ops::Add;
use std::ops::Sub;
use std::ops::Mul;

/// Type implementing arbitrary-precision decimal arithmetic
pub struct Decimal {
    sign: i8,
    int_digits: Vec<u8>,
    frac_digits: Vec<u8>,
}

impl Decimal {
    pub fn try_from(input: &str) -> Option<Decimal> {
        // Parse the input string into sign, integer part, and fractional part
        let input = input.trim();
        if input.is_empty() {
            return None;
        }

        // Check for sign
        let (sign, rest) = if let Some(stripped) = input.strip_prefix('-') {
            (-1i8, stripped)
        } else if let Some(stripped) = input.strip_prefix('+') {
            (1i8, stripped)
        } else {
            (1i8, input)
        };

        // Check for valid characters
        let has_integer_part = rest.contains('.');
        let int_part = if let Some(dot_pos) = rest.find('.') {
            &rest[..dot_pos]
        } else {
            rest
        };

        let frac_part = if let Some(dot_pos) = rest.find('.') {
            &rest[dot_pos + 1..]
        } else {
            ""
        };

        // Validate that we have at least some digits
        if int_part.is_empty() && frac_part.is_empty() {
            return None;
        }

        // Parse integer part
        let mut int_digits = Vec::new();
        for c in int_part.chars() {
            match c.to_digit(10) {
                Some(d) => int_digits.push(d as u8),
                None => return None,
            }
        }

        // Parse fractional part
        let mut frac_digits = Vec::new();
        for c in frac_part.chars() {
            match c.to_digit(10) {
                Some(d) => frac_digits.push(d as u8),
                None => return None,
            }
        }

        // Handle case where both parts are empty or all zeros
        if int_digits.is_empty() && frac_digits.is_empty() {
            return None;
        }

        // Normalize: ensure at least one integer digit
        if int_digits.is_empty() {
            int_digits.push(0);
        }

        // Remove trailing zeros from fractional part
        while frac_digits.len() > 1 && *frac_digits.last().unwrap() == 0 {
            frac_digits.pop();
        }
        // If all fractional digits are zero, clear them
        if frac_digits.iter().all(|&d| d == 0) {
            frac_digits.clear();
        }

        // Handle zero: if all digits are zero, use positive sign
        let is_zero = int_digits.iter().all(|&d| d == 0) && frac_digits.iter().all(|&d| d == 0);
        let final_sign = if is_zero { 1 } else { sign };

        Some(Decimal {
            sign: final_sign,
            int_digits,
            frac_digits,
        })
    }

    // Internal helper to get the numeric value as sign, integer digits, and fractional digits
    fn magnitude(&self) -> (i8, Vec<u8>, Vec<u8>) {
        (1, self.int_digits.clone(), self.frac_digits.clone())
    }

    // Compare two magnitudes (ignoring sign): returns Ordering
    fn compare_magnitude(&self, other: &Decimal) -> std::cmp::Ordering {
        // Compare integer parts first (by length, then lexicographically)
        let int_cmp = compare_digit_vectors(&self.int_digits, &other.int_digits);
        if int_cmp != std::cmp::Ordering::Equal {
            return int_cmp;
        }

        // Then compare fractional parts
        compare_digit_vectors(&self.frac_digits, &other.frac_digits)
    }
}

// Compare two digit vectors as numbers (ignoring leading zeros handling)
fn compare_digit_vectors(a: &[u8], b: &[u8]) -> std::cmp::Ordering {
    // Remove leading zeros for comparison
    let a_clean: Vec<u8> = a.iter().copied().skip_while(|&x| x == 0).collect();
    let b_clean: Vec<u8> = b.iter().copied().skip_while(|&x| x == 0).collect();

    // First compare by length (after removing leading zeros)
    match a_clean.len().cmp(&b_clean.len()) {
        std::cmp::Ordering::Equal => {}
        other => return other,
    }

    // Same length, compare lexicographically
    a_clean.cmp(&b_clean)
}

impl PartialEq for Decimal {
    fn eq(&self, other: &Self) -> bool {
        // Check sign
        if self.sign != other.sign {
            // Special case: both could be zero
            let self_zero = self.int_digits.iter().all(|&d| d == 0) && self.frac_digits.iter().all(|&d| d == 0);
            let other_zero = other.int_digits.iter().all(|&d| d == 0) && other.frac_digits.iter().all(|&d| d == 0);
            if self_zero && other_zero {
                return true;
            }
            return false;
        }
        // Same sign, compare magnitude
        self.compare_magnitude(other) == std::cmp::Ordering::Equal
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for Decimal {
    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
        // Handle zeros
        let self_zero = self.int_digits.iter().all(|&d| d == 0) && self.frac_digits.iter().all(|&d| d == 0);
        let other_zero = other.int_digits.iter().all(|&d| d == 0) && other.frac_digits.iter().all(|&d| d == 0);
        if self_zero || other_zero {
            // If one is zero, the sign determines the order
            match (self_zero, other_zero) {
                (true, true) => return std::cmp::Ordering::Equal,
                (true, false) => {
                    // self is zero
                    return if other.sign < 0 {
                        std::cmp::Ordering::Greater
                    } else {
                        std::cmp::Ordering::Less
                    };
                }
                (false, true) => {
                    // other is zero
                    return if self.sign < 0 {
                        std::cmp::Ordering::Less
                    } else {
                        std::cmp::Ordering::Greater
                    };
                }
                _ => unreachable!(),
            }
        }

        // Both non-zero
        if self.sign != other.sign {
            return if self.sign < 0 {
                std::cmp::Ordering::Less
            } else {
                std::cmp::Ordering::Greater
            };
        }

        // Same sign, compare magnitude
        // If both positive, direct comparison
        // If both negative, reverse comparison
        let mag_cmp = self.compare_magnitude(other);
        if self.sign < 0 {
            mag_cmp.reverse()
        } else {
            mag_cmp
        }
    }
}

impl Add for Decimal {
    type Output = Decimal;
    fn add(&self, other: &Decimal) -> Decimal {
        // Same sign: add magnitudes
        if self.sign == other.sign {
            let (int, frac) = add_magnitude(&self.int_digits, &self.frac_digits, &other.int_digits, &other.frac_digits);
            Decimal {
                sign: self.sign,
                int_digits: int,
                frac_digits: frac,
            }
        } else {
            // Different signs: subtract smaller magnitude from larger
            let cmp = self.compare_magnitude(other);
            if cmp == std::cmp::Ordering::Equal {
                // Result is zero
                Decimal {
                    sign: 1,
                    int_digits: vec![0],
                    frac_digits: vec![],
                }
            } else if cmp == std::cmp::Ordering::Greater {
                // self has larger magnitude
                let (int, frac) = sub_magnitude(&self.int_digits, &self.frac_digits, &other.int_digits, &other.frac_digits);
                Decimal {
                    sign: self.sign,
                    int_digits: int,
                    frac_digits: frac,
                }
            } else {
                // other has larger magnitude
                let (int, frac) = sub_magnitude(&other.int_digits, &other.frac_digits, &self.int_digits, &self.frac_digits);
                Decimal {
                    sign: other.sign,
                    int_digits: int,
                    frac_digits: frac,
                }
            }
        }
    }
}

impl Sub for Decimal {
    type Output = Decimal;
    fn sub(&self, other: &Decimal) -> Decimal {
        // Subtracting other is adding -other
        let neg_other = Decimal {
            sign: -other.sign,
            int_digits: other.int_digits.clone(),
            frac_digits: other.frac_digits.clone(),
        };
        *self + neg_other
    }
}

impl Mul for Decimal {
    type Output = Decimal;
    fn mul(&self, other: &Decimal) -> Decimal {
        // Determine sign
        let sign = if self.sign == other.sign { 1 } else { -1 };

        // Multiply integer and fractional parts
        let (int, frac) = multiply_magnitude(&self.int_digits, &self.frac_digits, &other.int_digits, &other.frac_digits);

        Decimal {
            sign,
            int_digits: int,
            frac_digits: frac,
        }
    }
}

// Add two magnitudes (both non-negative numbers)
fn add_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Pad fractional parts to equal length
    let max_frac = a_frac.len().max(b_frac.len());
    let mut a_frac_padded = vec![0; max_frac];
    let mut b_frac_padded = vec![0; max_frac];
    let a_frac_offset = max_frac - a_frac.len();
    let b_frac_offset = max_frac - b_frac.len();
    for i in 0..a_frac.len() {
        a_frac_padded[a_frac_offset + i] = a_frac[i];
    }
    for i in 0..b_frac.len() {
        b_frac_padded[b_frac_offset + i] = b_frac[i];
    }

    // Pad integer parts to equal length
    let max_int = a_int.len().max(b_int.len());
    let mut a_int_padded = vec![0; max_int];
    let mut b_int_padded = vec![0; max_int];
    let a_int_offset = max_int - a_int.len();
    let b_int_offset = max_int - b_int.len();
    for i in 0..a_int.len() {
        a_int_padded[a_int_offset + i] = a_int[i];
    }
    for i in 0..b_int.len() {
        b_int_padded[b_int_offset + i] = b_int[i];
    }

    // Add fractional parts
    let mut frac_result = vec![0u8; max_frac];
    let mut carry = 0i32;
    for i in (0..max_frac).rev() {
        let sum = a_frac_padded[i] as i32 + b_frac_padded[i] as i32 + carry;
        frac_result[i] = (sum % 10) as u8;
        carry = sum / 10;
    }

    // Add integer parts
    let mut int_result = vec![0u8; max_int];
    let mut total = int_result.len();
    while carry > 0 {
        int_result.insert(0, 0);
        total += 1;
    }
    for i in (0..max_int).rev() {
        let idx = i + (int_result.len() - max_int);
        let sum = a_int_padded[i] as i32 + b_int_padded[i] as i32 + carry;
        int_result[idx] = (sum % 10) as u8;
        carry = sum / 10;
    }

    // Handle any remaining carry
    while carry > 0 {
        int_result.insert(0, (carry % 10) as u8);
        carry /= 10;
    }

    // Normalize
    (normalize_int(&int_result), normalize_frac(&frac_result))
}

// Subtract b from a (a >= b, both non-negative)
fn sub_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Pad fractional parts to equal length
    let max_frac = a_frac.len().max(b_frac.len());
    let mut a_frac_padded = vec![0; max_frac];
    let mut b_frac_padded = vec![0; max_frac];
    let a_frac_offset = max_frac - a_frac.len();
    let b_frac_offset = max_frac - b_frac.len();
    for i in 0..a_frac.len() {
        a_frac_padded[a_frac_offset + i] = a_frac[i];
    }
    for i in 0..b_frac.len() {
        b_frac_padded[b_frac_offset + i] = b_frac[i];
    }

    // Pad integer parts to equal length
    let max_int = a_int.len().max(b_int.len());
    let mut a_int_padded = vec![0; max_int];
    let mut b_int_padded = vec![0; max_int];
    let a_int_offset = max_int - a_int.len();
    let b_int_offset = max_int - b_int.len();
    for i in 0..a_int.len() {
        a_int_padded[a_int_offset + i] = a_int[i];
    }
    for i in 0..b_int.len() {
        b_int_padded[b_int_offset + i] = b_int[i];
    }

    // Subtract fractional parts
    let mut frac_result = vec![0u8; max_frac];
    let mut borrow = 0i32;
    for i in (0..max_frac).rev() {
        let diff = a_frac_padded[i] as i32 - b_frac_padded[i] as i32 - borrow;
        if diff < 0 {
            frac_result[i] = (diff + 10) as u8;
            borrow = 1;
        } else {
            frac_result[i] = diff as u8;
            borrow = 0;
        }
    }

    // Subtract integer parts
    let mut int_result = a_int_padded.to_vec();
    let mut borrow = 0i32;
    for i in (0..max_int).rev() {
        let diff = int_result[i] as i32 - b_int_padded[i] as i32 - borrow;
        if diff < 0 {
            int_result[i] = (diff + 10) as u8;
            borrow = 1;
        } else {
            int_result[i] = diff as u8;
            borrow = 0;
        }
    }

    // Normalize
    (normalize_int(&int_result), normalize_frac(&frac_result))
}

// Multiply two magnitudes
fn multiply_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Total fractional digits in result
    let total_frac = a_frac.len() + b_frac.len();

    // Convert to big integers (as vectors of digits, most significant first)
    let a_digits: Vec<u8> = a_int.iter().chain(a_frac.iter()).copied().collect();
    let b_digits: Vec<u8> = b_int.iter().chain(b_frac.iter()).copied().collect();

    // Multiply the two digit vectors
    let product = multiply_digit_vectors(&a_digits, &b_digits);

    // Split into integer and fractional parts
    let frac_digits: Vec<u8> = if total_frac > 0 && product.len() > total_frac {
        product[product.len() - total_frac..].to_vec()
    } else if total_frac > 0 {
        let mut padded = vec![0; total_frac - product.len()];
        padded.extend_from_slice(&product);
        padded
    } else {
        Vec::new()
    };

    let int_digits: Vec<u8> = if total_frac > 0 && product.len() > total_frac {
        product[..product.len() - total_frac].to_vec()
    } else if total_frac == 0 {
        product.clone()
    } else {
        vec![0]
    };

    (normalize_int(&int_digits), normalize_frac(&frac_digits))
}

// Multiply two digit vectors (each representing a non-negative integer, most significant first)
fn multiply_digit_vectors(a: &[u8], b: &[u8]) -> Vec<u8> {
    if a.is_empty() || b.is_empty() || a.iter().all(|&d| d == 0) || b.iter().all(|&d| d == 0) {
        return vec![0];
    }

    let mut result = vec![0u8; a.len() + b.len()];

    for (i, &ai) in a.iter().enumerate().rev() {
        let mut carry = 0i32;
        for (j, &bj) in b.iter().enumerate().rev() {
            let idx = i + j;
            let actual_idx = result.len() - 1 - idx;
            let prod = ai as i32 * bj as i32 + result[actual_idx] as i32 + carry;
            result[actual_idx] = (prod % 10) as u8;
            carry = prod / 10;
        }
        if carry > 0 {
            let idx = a.len() + b.len() - 1 - (a.len() - 1 - i) - b.len();
            // Find position to add carry
            let mut pos = result.len() - 1 - (a.len() - 1 - i) - b.len();
            // Actually, carry goes one position to the left
            let mut pos = result.len() - 2 - (a.len() - 1 - i) - (b.len() - 1);
            while carry > 0 && pos >= 0 {
                let sum = result[pos] as i32 + carry;
                result[pos] = (sum % 10) as u8;
                carry = sum / 10;
                pos -= 1;
            }
            while carry > 0 {
                result.insert(0, (carry % 10) as u8);
                carry /= 10;
            }
        }
    }

    normalize_int(&result)
}

// Remove leading zeros from integer part, ensure at least one digit
fn normalize_int(digits: &[u8]) -> Vec<u8> {
    let cleaned: Vec<u8> = digits.iter().copied().skip_while(|&x| x == 0).collect();
    if cleaned.is_empty() {
        vec![0]
    } else {
        cleaned
    }
}

// Remove trailing zeros from fractional part
fn normalize_frac(digits: &[u8]) -> Vec<u8> {
    let mut result = digits.to_vec();
    while result.len() > 1 && *result.last().unwrap() == 0 {
        result.pop();
    }
    if result.iter().all(|&d| d == 0) {
        Vec::new()
    } else {
        result
    }
}
