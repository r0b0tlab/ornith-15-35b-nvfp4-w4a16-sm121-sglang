//
// This is only a SKELETON file for the 'Connect' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Board {
  constructor(board) {
    this.board = board.map(row => row.replace(/^ +/, '').trim());
  }

  winner() {
    if (this.board.length === 0) {
      return '';
    }

    const size = this.board.length;

    // Parse the board into a 2D array of characters
    const grid = this.board.map(row => row.split('').filter(c => c === 'X' || c === 'O' || c === '.'));

    // Check if player 'O' connects top to bottom
    if (this.hasPath(grid, 'O')) {
      return 'O';
    }

    // Check if player 'X' connects left to right
    if (this.hasPath(grid, 'X')) {
      return 'X';
    }

    return '';
  }

  // Check if a player has a complete path
  hasPath(grid, player) {
    const size = grid.length;

    if (player === 'O') {
      // Player O connects top (row 0) to bottom (row size-1)
      return this.isConnected(grid, player, 'vertical', size);
    } else {
      // Player X connects left (col 0) to right (col size-1)
      return this.isConnected(grid, player, 'horizontal', size);
    }
  }

  isConnected(grid, player, direction, size) {
    const visited = new Set();
    const queue = [];

    // Initialize queue with all starting positions
    if (direction === 'vertical') {
      // Start from top row
      for (let col = 0; col < size; col++) {
        if (grid[0][col] === player) {
          queue.push([0, col]);
          visited.add(`0,${col}`);
        }
      }
    } else {
      // Start from left column
      for (let row = 0; row < size; row++) {
        if (grid[row][0] === player) {
          queue.push([row, 0]);
          visited.add(`${row},0`);
        }
      }
    }

    // BFS to find path
    while (queue.length > 0) {
      const [row, col] = queue.shift();

      // Check if we reached the opposite side
      if (direction === 'vertical' && row === size - 1) {
        return true;
      }
      if (direction === 'horizontal' && col === size - 1) {
        return true;
      }

      // Explore neighbors (hexagonal connections)
      const neighbors = this.getNeighbors(row, col, size);
      for (const [nRow, nCol] of neighbors) {
        const key = `${nRow},${nCol}`;
        if (!visited.has(key) && grid[nRow][nCol] === player) {
          visited.add(key);
          queue.push([nRow, nCol]);
        }
      }
    }

    return false;
  }

  // Get hexagonal neighbors for a given position
  getNeighbors(row, col, size) {
    const neighbors = [];

    // In a hexagonal board, each cell has up to 6 neighbors
    // The diagonal offset depends on whether the row is even or odd
    const offsets = [
      [-1, 0], [-1, 1],  // top neighbors
      [0, -1], [0, 1],   // left and right neighbors
      [1, 0], [1, -1]    // bottom neighbors
    ];

    for (const [dRow, dCol] of offsets) {
      const nRow = row + dRow;
      const nCol = col + dCol;

      if (nRow >= 0 && nRow < size && nCol >= 0 && nCol < size) {
        neighbors.push([nRow, nCol]);
      }
    }

    return neighbors;
  }
}
