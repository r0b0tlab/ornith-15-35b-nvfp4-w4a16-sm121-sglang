import java.util.Map;
import java.util.HashMap;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.LinkedHashSet;
import java.util.HashSet;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

class Alphametics {

    private final String equation;
    private final String[] leftWords;
    private final String[] rightWords;
    private final Set<Character> leadingLetters;

    Alphametics(String userInput) {
        this.equation = userInput;
        
        // Parse the equation into left side and right side
        int equalsIndex = userInput.indexOf('=');
        String leftSide = userInput.substring(0, equalsIndex).trim();
        String rightSide = userInput.substring(equalsIndex + 1).trim();
        
        // Split left side by '+'
        this.leftWords = leftSide.split("\\+");
        this.rightWords = rightSide.split("\\+");
        
        // Identify leading letters (cannot be zero)
        this.leadingLetters = new HashSet<>();
        for (String word : leftWords) {
            word = word.trim();
            if (word.length() > 0 && Character.isLetter(word.charAt(0))) {
                leadingLetters.add(word.charAt(0));
            }
        }
        for (String word : rightWords) {
            word = word.trim();
            if (word.length() > 0 && Character.isLetter(word.charAt(0))) {
                leadingLetters.add(word.charAt(0));
            }
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        // Collect all unique letters
        Set<Character> letters = new LinkedHashSet<>();
        for (String word : leftWords) {
            for (char c : word.toCharArray()) {
                if (Character.isLetter(c)) {
                    letters.add(c);
                }
            }
        }
        for (String word : rightWords) {
            for (char c : word.toCharArray()) {
                if (Character.isLetter(c)) {
                    letters.add(c);
                }
            }
        }
        
        // Check if too many letters (can't assign digits)
        if (letters.size() > 10) {
            throw new UnsolvablePuzzleException("Too many letters");
        }
        
        // Convert letters to list for indexing
        List<Character> letterList = new ArrayList<>(letters);
        
        // Try to find a valid assignment
        Map<Character, Integer> result = new HashMap<>();
        boolean[] usedDigits = new boolean[10];
        
        if (solve(letterList, 0, usedDigits, result)) {
            return result;
        }
        
        throw new UnsolvablePuzzleException("No solution found");
    }
    
    private boolean solve(List<Character> letterList, int index, boolean[] usedDigits, 
                          Map<Character, Integer> result) {
        // Base case: all letters assigned
        if (index == letterList.size()) {
            return isValidAssignment(result);
        }
        
        Character letter = letterList.get(index);
        
        for (int digit = 0; digit <= 9; digit++) {
            // Skip if digit already used
            if (usedDigits[digit]) {
                continue;
            }
            
            // Skip if this is a leading letter and digit is 0
            if (digit == 0 && leadingLetters.contains(letter)) {
                continue;
            }
            
            // Assign digit to letter
            result.put(letter, digit);
            usedDigits[digit] = true;
            
            // Recurse to next letter
            if (solve(letterList, index + 1, usedDigits, result)) {
                return true;
            }
            
            // Backtrack
            usedDigits[digit] = false;
            result.remove(letter);
        }
        
        return false;
    }
    
    private boolean isValidAssignment(Map<Character, Integer> result) {
        try {
            // Calculate sum of left side
            long leftSum = 0;
            for (String word : leftWords) {
                long value = wordToNumber(word.trim(), result);
                if (value == -1) {
                    return false;
                }
                leftSum += value;
            }
            
            // Calculate sum of right side
            long rightSum = 0;
            for (String word : rightWords) {
                long value = wordToNumber(word.trim(), result);
                if (value == -1) {
                    return false;
                }
                rightSum += value;
            }
            
            return leftSum == rightSum;
        } catch (Exception e) {
            return false;
        }
    }
    
    private long wordToNumber(String word, Map<Character, Integer> result) {
        if (word.isEmpty()) {
            return -1;
        }
        
        // Check for leading zero
        if (word.length() > 1 && result.get(word.charAt(0)) == 0) {
            return -1;
        }
        
        long value = 0;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if (!result.containsKey(c)) {
                return -1;
            }
            value = value * 10 + result.get(c);
        }
        
        return value;
    }
}
