from collections import defaultdict


class School:
    def __init__(self):
        self._students = defaultdict(list)
        self._added = []

    def add_student(self, name, grade):
        for grade_number, students in self._students.items():
            if name in students:
                self._added.append(False)
                return
        self._students[grade].append(name)
        self._added.append(True)

    def roster(self):
        result = []
        for grade_number in sorted(self._students):
            result.extend(sorted(self._students[grade_number]))
        return result

    def grade(self, grade_number):
        return sorted(self._students.get(grade_number, []))

    def added(self):
        return self._added
