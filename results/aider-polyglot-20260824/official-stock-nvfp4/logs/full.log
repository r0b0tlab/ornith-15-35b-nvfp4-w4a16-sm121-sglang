I'll fix the syntax error by moving the export out of the conditional block.

```javascript
import { Worker, isMainThread, parentPort, workerData } from 'node:worker_threads';

// Helper function to count letters in a single text
const countLetters = (text) => {
  const counts = new Map();
  const normalized = text.toLowerCase().replace(/[^a-z]/g, '');
  
  for (const char of normalized) {
    counts.set(char, (counts.get(char) || 0) + 1);
  }
  
  return counts;
};

// Helper function to run counting in a worker thread
const countInWorker = (text) => {
  return new Promise((resolve, reject) => {
    const worker = new Worker(__filename, {
      workerData: { text, isWorker: true },
    });
    
    worker.on('message', (result) => {
      resolve(result);
    });
    
    worker.on('error', reject);
    worker.on('exit', (code) => {
      if (code !== 0) {
        reject(new Error(`Worker stopped with exit code ${code}`));
      }
    });
  });
};

// Worker thread entry point
if (isMainThread) {
  export const parallelLetterFrequency = async (texts) => {
    if (!texts || texts.length === 0) {
      return {};
    }
    
    // Run counting in parallel using worker threads
    const results = await Promise.all(
      texts.map(text => countInWorker(text))
    );
    
    // Merge all results
    const finalCounts = new Map();
    for (const result of results) {
      for (const [letter, count] of result) {
        finalCounts.set(letter, (finalCounts.get(letter) || 0) + count);
      }
    }
    
    // Convert to plain object
    return Object.fromEntries(finalCounts);
  };
}

// Worker thread execution (runs in separate thread)
else {
  const { text, isWorker } = workerData;
  
  if (isWorker) {
    const counts = countLetters(text);
    parentPort.postMessage(counts);
  }
}
```
