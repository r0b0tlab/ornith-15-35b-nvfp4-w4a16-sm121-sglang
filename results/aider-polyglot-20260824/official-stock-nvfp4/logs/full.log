simple-linked-list.js
```javascript
//
// This is only a SKELETON file for the 'Simple Linked List' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Element {
  constructor(value, next = null) {
    this._value = value;
    this._next = next;
  }

  get value() {
    return this._value;
  }

  get next() {
    return this._next;
  }

  set next(node) {
    this._next = node;
  }
}

export class List {
  constructor(array = []) {
    this._head = null;
    this._length = 0;

    if (Array.isArray(array)) {
      for (let i = 0; i < array.length; i++) {
        this.add(array[i]);
      }
    }
  }

  add(value) {
    const element = new Element(value);

    if (this._head === null) {
      this._head = element;
    } else {
      let current = this._head;
      while (current.next !== null) {
        current = current.next;
      }
      current.next = element;
    }

    this._length++;
  }

  get length() {
    return this._length;
  }

  get head() {
    return this._head;
  }

  toArray() {
    const result = [];
    let current = this._head;

    while (current !== null) {
      result.push(current.value);
      current = current.next;
    }

    return result;
  }

  reverse() {
    let previous = null;
    let current = this._head;

    while (current !== null) {
      const next = current.next;
      current.next = previous;
      previous = current;
      current = next;
    }

    this._head = previous;
    return this;
  }
}
