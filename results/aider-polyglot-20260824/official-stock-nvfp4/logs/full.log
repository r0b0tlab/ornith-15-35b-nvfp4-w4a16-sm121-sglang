import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

class ForthEvaluator {
    private final List<Integer> stack = new ArrayList<>();
    private final Map<String, List<String>> definitions = new HashMap<>();
    private List<String> currentTokens;
    private int currentIndex;
    private static final Set<String> BUILTINS = new HashSet<>(List.of("+", "-", "*", "/", "DUP", "DROP", "SWAP", "OVER"));

    List<Integer> evaluateProgram(List<String> input) {
        stack.clear();
        definitions.clear();

        for (String line : input) {
            currentTokens = tokenize(line);
            currentIndex = 0;
            while (currentIndex < currentTokens.size()) {
                executeToken(currentTokens.get(currentIndex));
                currentIndex++;
            }
        }

        return new ArrayList<>(stack);
    }

    private List<String> tokenize(String line) {
        List<String> tokens = new ArrayList<>();
        StringBuilder current = new StringBuilder();

        for (char c : line.toCharArray()) {
            if (Character.isWhitespace(c)) {
                if (current.length() > 0) {
                    tokens.add(current.toString());
                    current.setLength(0);
                }
            } else {
                current.append(c);
            }
        }

        if (current.length() > 0) {
            tokens.add(current.toString());
        }

        return tokens;
    }

    private void executeToken(String token) {
        String lower = token.toLowerCase();

        if (isNumber(token)) {
            stack.add(Integer.parseInt(token));
            return;
        }

        if (lower.equals(":")) {
            parseDefinition();
            return;
        }

        if (definitions.containsKey(lower)) {
            List<String> def = definitions.get(lower);
            for (String defToken : def) {
                executeToken(defToken);
            }
            return;
        }

        if (BUILTINS.contains(lower)) {
            executeBuiltin(lower);
            return;
        }

        throw new IllegalArgumentException("undefined identifier");
    }

    private void parseDefinition() {
        List<String> tokens = new ArrayList<>();
        // Read all tokens until we hit ';'
        while (currentIndex < currentTokens.size()) {
            String token = currentTokens.get(currentIndex);
            currentIndex++;
            if (token.equals(";")) {
                break;
            }
            tokens.add(token);
        }

        if (tokens.isEmpty()) {
            throw new IllegalArgumentException("incomplete definition");
        }

        String name = tokens.get(0).toLowerCase();
        if (isNumber(tokens.get(0))) {
            throw new IllegalArgumentException("invalid definition");
        }

        List<String> definition = new ArrayList<>(tokens.subList(1, tokens.size()));
        definitions.put(name, definition);
    }

    private void executeBuiltin(String word) {
        switch (word) {
            case "+":
                arithOperation(2, (a, b) -> a + b);
                break;
            case "-":
                arithOperation(2, (a, b) -> a - b);
                break;
            case "*":
                arithOperation(2, (a, b) -> a * b);
                break;
            case "/":
                arithOperation(2, (a, b) -> {
                    if (b == 0) {
                        throw new IllegalArgumentException("divide by zero");
                    }
                    return a / b;
                });
                break;
            case "DUP":
                if (stack.isEmpty()) {
                    throw new IllegalArgumentException("empty stack");
                }
                int dup = stack.get(stack.size() - 1);
                stack.add(dup);
                break;
            case "DROP":
                if (stack.isEmpty()) {
                    throw new IllegalArgumentException("empty stack");
                }
                stack.remove(stack.size() - 1);
                break;
            case "SWAP":
                if (stack.size() < 2) {
                    throw new IllegalArgumentException("empty stack");
                }
                int first = stack.get(stack.size() - 1);
                int second = stack.get(stack.size() - 2);
                stack.set(stack.size() - 1, second);
                stack.set(stack.size() - 2, first);
                break;
            case "OVER":
                if (stack.size() < 2) {
                    throw new IllegalArgumentException("empty stack");
                }
                int secondToLast = stack.get(stack.size() - 2);
                stack.add(secondToLast);
                break;
        }
    }

    private interface BinaryOp {
        int apply(int a, int b);
    }

    private void arithOperation(int required, BinaryOp op) {
        if (stack.size() < required) {
            throw new IllegalArgumentException("empty stack");
        }
        int b = stack.remove(stack.size() - 1);
        int a = stack.remove(stack.size() - 1);
        stack.add(op.apply(a, b));
    }

    private boolean isNumber(String token) {
        if (token.isEmpty()) {
            return false;
        }
        int startIndex = 0;
        if (token.charAt(0) == '-') {
            startIndex = 1;
        }
        if (startIndex >= token.length()) {
            return false;
        }
        for (int i = startIndex; i < token.length(); i++) {
            if (!Character.isDigit(token.charAt(i))) {
                return false;
            }
        }
        return true;
    }
}
