robot-name.js
```
export class Robot {
  constructor() {
    this._name = null;
  }

  get name() {
    if (this._name === null) {
      this._name = Robot.generateUniqueName();
    }
    return this._name;
  }

  reset() {
    this._name = null;
  }
}

Robot.usedNames = new Set();

Robot.generateUniqueName = () => {
  let name;
  do {
    name = Robot.generateRandomName();
  } while (Robot.usedNames.has(name));
  
  Robot.usedNames.add(name);
  return name;
};

Robot.generateRandomName = () => {
  const letters = String.fromCharCode(Math.floor(Math.random() * 26) + 65) +
                  String.fromCharCode(Math.floor(Math.random() * 26) + 65);
  const digits = Math.floor(Math.random() * 1000).toString().padStart(3, '0');
  return `${letters}${digits}`;
};

Robot.releaseNames = () => {
  Robot.usedNames.clear();
};
```
