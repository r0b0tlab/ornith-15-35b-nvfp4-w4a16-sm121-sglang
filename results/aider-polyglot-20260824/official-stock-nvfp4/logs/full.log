//
// This is only a SKELETON file for the 'Zipper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Zipper {
  constructor(tree, path) {
    this._tree = tree;
    this._path = path || [];
  }

  static fromTree(tree) {
    return new Zipper(tree, []);
  }

  toTree() {
    let current = this._tree;
    let path = [...this._path];

    while (path.length > 0) {
      const direction = path.pop();
      if (direction === 'left') {
        current.left = current._tree.left;
        current = this._tree;
      } else if (direction === 'right') {
        current.right = current._tree.right;
        current = this._tree;
      }
    }

    return current;
  }

  value() {
    return this._tree.value;
  }

  left() {
    if (!this._tree.left) {
      return null;
    }
    const newTree = this._deepClone(this._tree);
    this._tree = newTree.left;
    newTree.left = null;
    return new Zipper(this._tree, [...this._path, { direction: 'left', value: newTree.value, sibling: newTree }]);
  }

  right() {
    if (!this._tree.right) {
      return null;
    }
    const newTree = this._deepClone(this._tree);
    this._tree = newTree.right;
    newTree.right = null;
    return new Zipper(this._tree, [...this._path, { direction: 'right', value: newTree.value, sibling: newTree }]);
  }

  up() {
    if (this._path.length === 0) {
      return null;
    }
    const lastStep = this._path[this._path.length - 1];
    this._tree = {
      value: lastStep.value,
      left: lastStep.direction === 'left' ? this._tree : lastStep.sibling,
      right: lastStep.direction === 'right' ? this._tree : lastStep.sibling
    };
    this._path.pop();
    return new Zipper(this._tree, this._path);
  }

  setValue(value) {
    const newTree = this._deepClone(this._tree);
    newTree.value = value;
    this._tree = newTree;
    return new Zipper(this._tree, this._path);
  }

  setLeft(left) {
    const newTree = this._deepClone(this._tree);
    newTree.left = left;
    this._tree = newTree;
    return new Zipper(this._tree, this._path);
  }

  setRight(right) {
    const newTree = this._deepClone(this._tree);
    newTree.right = right;
    this._tree = newTree;
    return new Zipper(this._tree, this._path);
  }

  _deepClone(node) {
    if (node === null || node === undefined) {
      return node;
    }
    return {
      value: node.value,
      left: this._deepClone(node.left),
      right: this._deepClone(node.right)
    };
  }
}
