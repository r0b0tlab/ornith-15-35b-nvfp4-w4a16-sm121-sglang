```go
package zebra

type Solution struct {
	DrinksWater string
	OwnsZebra   string
}

func SolvePuzzle() Solution {
	// Define the possible values for each attribute
	nationalities := []string{"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"}
	colors := []string{"red", "ivory", "green", "yellow", "blue"}
	beverages := []string{"Coffee", "Tea", "Milk", "OrangeJuice", "Water"}
	smokes := []string{"OldGold", "Kools", "Chesterfields", "LuckyStrike", "Parliaments"}
	pets := []string{"Dog", "Snails", "Fox", "Horse", "Zebra"}

	// Generate all permutations of each attribute
	natPerms := permutations(nationalities)
	colorPerms := permutations(colors)
	bevPerms := permutations(beverages)
	smokePerms := permutations(smokes)
	petPerms := permutations(pets)

	// Iterate through all combinations
	for _, nat := range natPerms {
		// Constraint 10: The Norwegian lives in the first house
		if nat[0] != "Norwegian" {
			continue
		}

		for _, color := range colorPerms {
			// Constraint 2: The Englishman lives in the red house
			// Constraint 6: The green house is immediately to the right of the ivory house
			// Constraint 15: The Norwegian lives next to the blue house
			valid := true

			for i := 0; i < 5; i++ {
				if color[i] == "red" && nat[i] != "Englishman" {
					valid = false
					break
				}
				if color[i] == "green" && (i == 0 || color[i-1] != "ivory") {
					valid = false
					break
				}
			}

			// Check if Norwegian is next to blue house
			norwegianPos := indexOf(nat, "Norwegian")
			if norwegianPos == 0 && (color[1] != "blue") {
				valid = false
			}
			if norwegianPos == 1 && color[0] != "blue" && color[2] != "blue" {
				valid = false
			}

			if !valid {
				continue
			}

			for _, bev := range bevPerms {
				// Constraint 9: Milk is drunk in the middle house
				// Constraint 4: Coffee is drunk in the green house
				// Constraint 5: The Ukrainian drinks tea
				// Constraint 13: The Lucky Strike smoker drinks orange juice
				valid := true

				if bev[2] != "Milk" {
					valid = false
					continue
				}

				for i := 0; i < 5; i++ {
					if color[i] == "green" && bev[i] != "Coffee" {
						valid = false
						break
					}
					if nat[i] == "Ukrainian" && bev[i] != "Tea" {
						valid = false
						break
					}
				}

				if !valid {
					continue
				}

				for _, smoke := range smokePerms {
					// Constraint 8: Kools are smoked in the yellow house
					// Constraint 7: The Old Gold smoker owns snails
					// Constraint 14: The Japanese smokes Parliaments
					valid := true

					for i := 0; i < 5; i++ {
						if color[i] == "yellow" && smoke[i] != "Kools" {
							valid = false
							break
						}
						if nat[i] == "Japanese" && smoke[i] != "Parliaments" {
							valid = false
							break
						}
					}

					if !valid {
						continue
					}

					for _, pet := range petPerms {
						// Constraint 3: The Spaniard owns the dog
						// Constraint 7: The Old Gold smoker owns snails
						// Constraint 11: Chesterfields next to fox
						// Constraint 12: Kools next to horse
						valid := true

						for i := 0; i < 5; i++ {
							if nat[i] == "Spaniard" && pet[i] != "Dog" {
								valid = false
								break
							}
							if smoke[i] == "OldGold" && pet[i] != "Snails" {
								valid = false
								break
							}
						}

						if !valid {
							continue
						}

						// Constraint 11: Chesterfields next to fox
						chesterPos := indexOf(smoke, "Chesterfields")
						hasFox := false
						for i := 0; i < 5; i++ {
							if pet[i] == "Fox" {
								hasFox = true
								if abs(chesterPos-i) != 1 {
									valid = false
									break
								}
							}
						}
						if !hasFox {
							valid = false
						}

						// Constraint 12: Kools next to horse
						koolsPos := indexOf(smoke, "Kools")
						hasHorse := false
						for i := 0; i < 5; i++ {
							if pet[i] == "Horse" {
								hasHorse = true
								if abs(koolsPos-i) != 1 {
									valid = false
									break
								}
							}
						}
						if !hasHorse {
							valid = false
						}

						if !valid {
							continue
						}

						// Found a valid solution
						// Find who drinks water and owns the zebra
						waterDrinker := nat[indexOf(bev, "Water")]
						zebraOwner := nat[indexOf(pet, "Zebra")]

						return Solution{
							DrinksWater: waterDrinker,
							OwnsZebra:   zebraOwner,
						}
					}
				}
			}
		}
	}

	return Solution{}
}

// permutations generates all permutations of a slice
func permutations(input []string) [][]string {
	if len(input) <= 1 {
		return [][]string{input}
	}

	var result [][]string
	for i := 0; i < len(input); i++ {
		rest := append([]string{}, input[:i]...)
		rest = append(rest, input[i+1:]...)

		furtherPerms := permutations(rest)

		for _, perm := range furtherPerms {
			result = append(result, append([]string{input[i]}, perm...))
		}
	}

