import java.util.Objects;

public class WordLocation {

    private final WordPosition firstLetter;
    private final WordPosition lastLetter;

    public WordLocation(WordPosition firstLetter, WordPosition lastLetter) {
        this.firstLetter = firstLetter;
        this.lastLetter = lastLetter;
    }

    public WordPosition getFirstLetter() {
        return firstLetter;
    }

    public WordPosition getLastLetter() {
        return lastLetter;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) {
            return true;
        }
        if (o == null || getClass() != o.getClass()) {
            return false;
        }
        WordLocation that = (WordLocation) o;
        return Objects.equals(firstLetter, that.firstLetter) &&
                Objects.equals(lastLetter, that.lastLetter);
    }

    @Override
    public int hashCode() {
        return Objects.hash(firstLetter, lastLetter);
    }

    @Override
    public String toString() {
        return "WordLocation{" +
                "firstLetter=" + firstLetter +
                ", lastLetter=" + lastLetter +
                '}';
