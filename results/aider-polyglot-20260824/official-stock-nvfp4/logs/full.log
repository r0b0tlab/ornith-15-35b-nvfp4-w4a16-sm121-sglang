// Add two magnitudes (both non-negative numbers)
fn add_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Pad fractional parts to equal length
    let max_frac = a_frac.len().max(b_frac.len());
    let mut a_frac_padded = vec![0; max_frac];
    let mut b_frac_padded = vec![0; max_frac];
    let a_frac_offset = max_frac - a_frac.len();
    let b_frac_offset = max_frac - b_frac.len();
    for i in 0..a_frac.len() {
        a_frac_padded[a_frac_offset + i] = a_frac[i];
    }
    for i in 0..b_frac.len() {
        b_frac_padded[b_frac_offset + i] = b_frac[i];
    }

    // Pad integer parts to equal length
    let max_int = a_int.len().max(b_int.len());
    let mut a_int_padded = vec![0; max_int];
    let mut b_int_padded = vec![0; max_int];
    let a_int_offset = max_int - a_int.len();
    let b_int_offset = max_int - b_int.len();
    for i in 0..a_int.len() {
        a_int_padded[a_int_offset + i] = a_int[i];
    }
    for i in 0..b_int.len() {
        b_int_padded[b_int_offset + i] = b_int[i];
    }

    // Add fractional parts
    let mut frac_result = vec![0u8; max_frac];
    let mut carry = 0i32;
    for i in (0..max_frac).rev() {
        let sum = a_frac_padded[i] as i32 + b_frac_padded[i] as i32 + carry;
        frac_result[i] = (sum % 10) as u8;
        carry = sum / 10;
    }

    // Add integer parts
    let mut int_result = vec![0u8; max_int];
    for i in 0..max_int {
        int_result[i] = 0;
    }
    let offset = 0;
    let mut carry = 0i32;
    for i in (0..max_int).rev() {
        let sum = a_int_padded[i] as i32 + b_int_padded[i] as i32 + carry;
        int_result[i] = (sum % 10) as u8;
        carry = sum / 10;
    }

    // Handle any remaining carry
    while carry > 0 {
        int_result.insert(0, (carry % 10) as u8);
        carry /= 10;
    }

    // Normalize
    (normalize_int(&int_result), normalize_frac(&frac_result))
}

// Subtract b from a (a >= b, both non-negative)
fn sub_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Pad fractional parts to equal length
    let max_frac = a_frac.len().max(b_frac.len());
    let mut a_frac_padded = vec![0; max_frac];
    let mut b_frac_padded = vec![0; max_frac];
    let a_frac_offset = max_frac - a_frac.len();
    let b_frac_offset = max_frac - b_frac.len();
    for i in 0..a_frac.len() {
        a_frac_padded[a_frac_offset + i] = a_frac[i];
    }
    for i in 0..b_frac.len() {
        b_frac_padded[b_frac_offset + i] = b_frac[i];
    }

    // Pad integer parts to equal length
    let max_int = a_int.len().max(b_int.len());
    let mut a_int_padded = vec![0; max_int];
    let mut b_int_padded = vec![0; max_int];
    let a_int_offset = max_int - a_int.len();
    let b_int_offset = max_int - b_int.len();
    for i in 0..a_int.len() {
        a_int_padded[a_int_offset + i] = a_int[i];
    }
    for i in 0..b_int.len() {
        b_int_padded[b_int_offset + i] = b_int[i];
    }

    // Subtract fractional parts
    let mut frac_result = vec![0u8; max_frac];
    let mut borrow = 0i32;
    for i in (0..max_frac).rev() {
        let diff = a_frac_padded[i] as i32 - b_frac_padded[i] as i32 - borrow;
        if diff < 0 {
            frac_result[i] = (diff + 10) as u8;
            borrow = 1;
        } else {
            frac_result[i] = diff as u8;
            borrow = 0;
        }
    }

    // Subtract integer parts
    let mut int_result = a_int_padded.to_vec();
    let mut borrow = 0i32;
    for i in (0..max_int).rev() {
        let diff = int_result[i] as i32 - b_int_padded[i] as i32 - borrow;
        if diff < 0 {
            int_result[i] = (diff + 10) as u8;
            borrow = 1;
        } else {
            int_result[i] = diff as u8;
            borrow = 0;
        }
    }

    // Normalize
    (normalize_int(&int_result), normalize_frac(&frac_result))
}

// Multiply two magnitudes
fn multiply_magnitude(
    a_int: &[u8], a_frac: &[u8],
    b_int: &[u8], b_frac: &[u8],
) -> (Vec<u8>, Vec<u8>) {
    // Total fractional digits in result
    let total_frac = a_frac.len() + b_frac.len();

    // Convert to big integers (as vectors of digits, most significant first)
    let a_digits: Vec<u8> = a_int.iter().chain(a_frac.iter()).copied().collect();
    let b_digits: Vec<u8> = b_int.iter().chain(b_frac.iter()).copied().collect();

    // Multiply the two digit vectors
    let product = multiply_digit_vectors(&a_digits, &b_digits);

    // Split into integer and fractional parts
    let (int_digits, frac_digits) = if total_frac == 0 {
        (product.clone(), Vec::new())
    } else if product.len() <= total_frac {
        // Need to pad with leading zeros
        let mut padded = vec![0; total_frac - product.len()];
        padded.extend_from_slice(&product);
        (vec![0], padded)
    } else {
        let split_at = product.len() - total_frac;
        (product[..split_at].to_vec(), product[split_at..].to_vec())
    };

    (normalize_int(&int_digits), normalize_frac(&frac_digits))
}

// Multiply two digit vectors (each representing a non-negative integer, most significant first)
fn multiply_digit_vectors(a: &[u8], b: &[u8]) -> Vec<u8> {
    if a.is_empty() || b.is_empty() || a.iter().all(|&d| d == 0) || b.iter().all(|&d| d == 0) {
        return vec![0];
    }

    let mut result = vec![0u8; a.len() + b.len()];

    // Multiply as schoolbook multiplication
    for i in (0..a.len()).rev() {
        let mut carry = 0i32;
        for j in (0..b.len()).rev() {
            let idx = i + j + 1;
            let prod = a[i] as i32 * b[j] as i32 + result[idx] as i32 + carry;
            result[idx] = (prod % 10) as u8;
            carry = prod / 10;
        }
        // Add remaining carry to the next position
        let idx = i + 1; // Actually the position to the left of the first computed
        let mut pos = i; // position to the left of i+0
        // The carry should go to position i (which is one left of the first product position i+0)
        // But we need to account for the offset
        let mut pos = i;
        while carry > 0 {
            if pos < result.len() {
                let sum = result[pos] as i32 + carry;
                result[pos] = (sum % 10) as u8;
                carry = sum / 10;
            } else {
                result.insert(0, (carry % 10) as u8);
                carry = 0;
            }
            pos -= 1;
        }
    }

    normalize_int(&result)
}

// Remove leading zeros from integer part, ensure at least one digit
fn normalize_int(digits: &[u8]) -> Vec<u8> {
    let cleaned: Vec<u8> = digits.iter().copied().skip_while(|&x| x == 0).collect();
    if cleaned.is_empty() {
        vec![0]
    } else {
        cleaned
    }
}

// Remove trailing zeros from fractional part
fn normalize_frac(digits: &[u8]) -> Vec<u8> {
    let mut result = digits.to_vec();
    while result.len() > 1 && *result.last().unwrap() == 0 {
        result.pop();
    }
    if result.iter().all(|&d| d == 0) {
        Vec::new()
    } else {
        result
    }
