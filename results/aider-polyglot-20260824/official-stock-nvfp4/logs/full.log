+meetup_date day(week_of_month week, day_of_week weekday, int month, int year) {
+    meetup_date result;
+    result.year = year;
+    result.month = month;
+    
+    // Get the number of days in the month
+    int days_in_month;
+    if (month == 12) {
+        days_in_month = 31;
+    } else {
+        struct tm tm_val;
+        tm_val.tm_year = year - 1900;
+        tm_val.tm_mon = month;  // month after increment means next month
+        tm_val.tm_mday = 1;
+        tm_val.tm_hour = 0;
+        tm_val.tm_min = 0;
+        tm_val.tm_sec = 0;
+        validdate(&tm_val);
+        days_in_month = tm_val.tm_mday;
+    }
