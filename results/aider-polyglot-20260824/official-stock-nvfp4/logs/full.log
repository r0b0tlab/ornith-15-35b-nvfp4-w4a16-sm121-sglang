meetup.js
```javascript
//
// This is only a SKELETON file for the 'Meetup' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

export const meetup = (year, month, week, weekday, day) => {
  // Convert month from 1-12 to 0-11 (JavaScript Date uses 0-11)
  const monthIndex = month - 1;
  
  // Get the number of days in the month
  const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();
  
  // Find all days in the month that match the requested weekday
  const matchingDays = [];
  for (let dayNum = 1; dayNum <= daysInMonth; dayNum++) {
    const date = new Date(year, monthIndex, dayNum);
    if (WEEKDAYS[date.getDay()] === weekday) {
      matchingDays.push(dayNum);
    }
  }
  
  // Determine the specific day based on the week descriptor
  let targetDay;
  switch (week) {
    case 'first':
      targetDay = matchingDays[0];
      break;
    case 'second':
      targetDay = matchingDays[1];
      break;
    case 'third':
      targetDay = matchingDays[2];
      break;
    case 'fourth':
      targetDay = matchingDays[3];
      break;
    case 'last':
      targetDay = matchingDays[matchingDays.length - 1];
      break;
    case 'teenth':
      // Find the day that ends in '-teenth' (13-19)
      targetDay = matchingDays.find(day => day >= 13 && day <= 19);
      break;
    default:
      throw new Error(`Invalid week descriptor: ${week}`);
  }
  
  // Return the date object
  return new Date(year, monthIndex, targetDay);
};
```
