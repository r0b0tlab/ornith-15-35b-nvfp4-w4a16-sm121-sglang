pub fn encode(n: u64) -> String {
    // Handle 0 as a special case
    if n == 0 {
        return "zero".to_string();
    }

    // Words for numbers
    let ones = [
        "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
        "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
        "seventeen", "eighteen", "nineteen",
    ];
    let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];
    let scales = ["", "thousand", "million", "trillion"];

    // Break number into chunks of 3 digits
    let mut chunks = Vec::new();
    let mut num = n;
    while num > 0 {
        chunks.push(num % 1000);
        num /= 1000;
    }

    // Check if number is too large
    if chunks.len() > 4 {
        return "out of range".to_string();
    }

    let mut parts = Vec::new();

    // Process each chunk from highest scale to lowest
    for i in (0..chunks.len()).rev() {
        let chunk = chunks[i];
        if chunk == 0 {
            continue;
        }

        // Get the scale word for this chunk
        let scale_word = if i < scales.len() {
            scales[i]
        } else {
            ""
        };

        // Convert chunk (0-999) to words
        let mut chunk_words = Vec::new();
        let hundreds = chunk / 100;
        let remainder = chunk % 100;

        if hundreds > 0 {
            chunk_words.push(ones[hundreds as usize]);
            chunk_words.push("hundred");
        }

        if remainder > 0 {
            let tens_digit = remainder / 10;
            let ones_digit = remainder % 10;

            if tens_digit <= 1 {
                // Numbers 10-19 have special names
                chunk_words.push(ones[remainder as usize]);
            } else {
                // Tens place
                chunk_words.push(tens[tens_digit as usize]);
                if ones_digit > 0 {
                    // Compound numbers like twenty-two
                    let compound = format!(
                        "{}-{}",
                        tens[tens_digit as usize],
                        ones[ones_digit as usize]
                    );
                    chunk_words.push(&compound);
                }
            }
        }

        // Combine chunk words with scale word
        let mut full_chunk = String::new();
        for (j, word) in chunk_words.iter().enumerate() {
            if j > 0 {
                full_chunk.push(' ');
            }
            full_chunk.push_str(word);
        }

        // Add scale word if present
        if !scale_word.is_empty() {
            full_chunk.push(' ');
            full_chunk.push_str(scale_word);
        }

        parts.push(full_chunk);
    }

    // Join all parts with spaces
    parts.join(" ")
}
