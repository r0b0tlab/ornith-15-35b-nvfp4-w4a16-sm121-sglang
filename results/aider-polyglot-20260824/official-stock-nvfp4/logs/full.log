package dominoes

// Define the Domino type here.

type Domino [2]int

func MakeChain(input []Domino) ([]Domino, bool) {
	// An empty input is legal.
	if len(input) == 0 {
		return []Domino{}, true
	}

	// Helper function to check if two domino sides match.
	match := func(a, b int) bool {
		return a == b
	}

	// Backtracking function to build the chain.
	var backtrack func(chain []Domino, used []bool) bool

	backtrack = func(chain []Domino, used []bool) bool {
		// If all dominoes are used, check if the chain is valid (first and last match).
		if len(chain) == len(input) {
			return match(chain[0][0], chain[len(chain)-1][1])
		}

		for i := 0; i < len(input); i++ {
			if !used[i] {
				// Try the domino in its original orientation.
				if len(chain) == 0 || match(chain[len(chain)-1][1], input[i][0]) {
					used[i] = true
					chain = append(chain, input[i])
					if backtrack(chain, used) {
						return true
					}
					chain = chain[:len(chain)-1]
					used[i] = false
				}

				// Try the domino in rotated orientation.
				// Only rotate if the two sides are different to avoid redundant attempts.
				if input[i][0] != input[i][1] && match(chain[len(chain)-1][1], input[i][1]) {
					used[i] = true
					chain = append(chain, Domino{input[i][1], input[i][0]})
					if backtrack(chain, used) {
						return true
					}
					chain = chain[:len(chain)-1]
					used[i] = false
				}
			}
		}

		return false
	}

	// Start the backtracking with the first domino.
	used := make([]bool, len(input))
	used[0] = true

	// Try the first domino in both orientations.
	// Original orientation.
	chain := []Domino{input[0]}
	if backtrack(chain, used) {
		return chain, true
	}

	// Rotated orientation (only if sides differ).
	if input[0][0] != input[0][1] {
		chain = []Domino{{input[0][1], input[0][0]}}
		if backtrack(chain, used) {
			return chain, true
		}
	}

	return nil, false
}
