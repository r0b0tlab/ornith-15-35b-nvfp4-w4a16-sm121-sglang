```python
class BowlingGame:
    def __init__(self):
        self.rolls = []
        self.frame_index = 0

    def roll(self, pins):
        if pins < 0:
            raise ValueError("pins cannot be negative")
        if pins > 10:
            raise ValueError("pins cannot be more than 10")
        
        # Validate the roll against the current game state
        if not self._is_valid_roll(pins):
            raise ValueError("invalid roll")
        
        self.rolls.append(pins)

    def _is_valid_roll(self, pins):
        """Check if the current roll is valid given the game state."""
        if not self.rolls:
            return True
        
        frame_start = 0
        roll_index = 0
        frame_num = 0
        
        # Find the current frame based on rolls so far
        while frame_num < 10:
            if roll_index >= len(self.rolls):
                break
            if frame_num < 9:
                # Normal frame
                if self.rolls[roll_index] == 10:
                    # Strike, move to next frame
                    roll_index += 1
                    frame_num += 1
                else:
                    # First roll of frame
                    if roll_index + 1 >= len(self.rolls):
                        # Only first roll so far, valid
                        break
                    frame_sum = self.rolls[roll_index] + self.rolls[roll_index + 1]
                    if frame_sum > 10:
                        return False
                    roll_index += 2
                    frame_num += 1
            else:
                # Tenth frame
                break
        
        # Now validate the new roll
        if frame_num < 9:
            # In a normal frame
            if roll_index >= len(self.rolls):
                # First roll of current frame
                return True
            else:
                # Second roll of current frame
                first_roll = self.rolls[roll_index]
                if first_roll == 10:
                    # First roll was a strike, second roll is fine
                    return True
                else:
                    # Second roll, check sum
                    if roll_index + 1 < len(self.rolls):
                        second_roll = self.rolls[roll_index + 1]
                        return first_roll + second_roll + pins <= 10
                    else:
                        return first_roll + pins <= 10
        else:
            # Tenth frame logic
            return self._is_valid_tenth_frame_roll(pins)

    def _is_valid_tenth_frame_roll(self, pins):
        """Validate rolls in the tenth frame."""
        tenth_start = 0
        roll_index = 0
        frame_num = 0
        
        # Find position in tenth frame
        while frame_num < 9:
            if roll_index >= len(self.rolls):
                break
            if self.rolls[roll_index] == 10:
                roll_index += 1
                frame_num += 1
            else:
                if roll_index + 1 >= len(self.rolls):
                    break
                roll_index += 2
                frame_num += 1
        
        # Now roll_index points to tenth frame rolls
        tenth_rolls = self.rolls[tenth_start + roll_index:]
        
        if not tenth_rolls:
            # First roll of tenth frame
            return pins <= 10
        elif len(tenth_rolls) == 1:
            # Second roll of tenth frame
            if tenth_rolls[0] == 10:
                # First was a strike
                return pins <= 10
            else:
                # First wasn't a strike, check sum
                return tenth_rolls[0] + pins <= 10
        elif len(tenth_rolls) == 2:
            # Third roll potentially
            if tenth_rolls[0] == 10:
                # First was a strike
                if tenth_rolls[1] == 10:
                    # Second was also a strike, third can be up to 10
                    return pins <= 10
                else:
                    # Second wasn't a strike, so it's like second roll
                    return tenth_rolls[1] + pins <= 10
            else:
                # First wasn't a strike
                return tenth_rolls[0] + tenth_rolls[1] + pins <= 10
        else:
            # Too many rolls
            return False

    def score(self):
        if not self._game_complete():
            raise ValueError("game not complete")
        
        score = 0
        roll_index = 0
        
        for frame in range(10):
            if frame == 9:
                # Tenth frame
                if roll_index + 2 > len(self.rolls):
                    raise ValueError("incomplete tenth frame")
                frame_score = sum(self.rolls[roll_index:roll_index + 3])
                score += frame_score
                break
            else:
                if roll_index >= len(self.rolls):
                    raise ValueError("incomplete frame")
                if self.rolls[roll_index] == 10:
                    # Strike
                    if roll_index + 2 > len(self.rolls):
                        raise ValueError("incomplete strike frame")
                    frame_score = 10 + sum(self.rolls[roll_index + 1:roll_index + 3])
                    score += frame_score
                    roll_index += 1
                else:
                    if roll_index + 1 >= len(self.rolls):
                        raise ValueError("incomplete frame")
                    frame_sum = self.rolls[roll_index] + self.rolls[roll_index + 1]
                    if frame_sum > 10:
                        raise ValueError("invalid frame")
                    if frame_sum == 10:
                        # Spare
                        if roll_index + 2 > len(self.rolls):
                            raise ValueError("incomplete spare frame")
                        frame_score = 10 + self.rolls[roll_index + 2]
                        score += frame_score
                        roll_index += 2
                    else:
                        # Open frame
                        frame_score = frame_sum
                        score += frame_score
                        roll_index += 2
        
        return score

    def _game_complete(self):
        """Check if the game is complete."""
        roll_index = 0
        frame_num = 0
        
        while frame_num < 9:
            if roll_index >= len(self.rolls):
                return False
            if self.rolls[roll_index] == 10:
                # Strike
                roll_index += 1
            else:
                if roll_index + 1 >= len(self.rolls):
                    return False
                if self.rolls[roll_index] + self.rolls[roll_index + 1] > 10:
                    return False
                roll_index += 2
            frame_num += 1
        
        # Tenth frame
        if roll_index >= len(self.rolls):
            return False
        
        # Count rolls in tenth frame
        tenth_rolls = self.rolls[roll_index:]
        
        if len(tenth_rolls) == 0:
            return False
        elif len(tenth_rolls) == 1:
            # Only first roll
            return tenth_rolls[0] < 10
        elif len(tenth_rolls) == 2:
            # Second roll done
            if tenth_rolls[0] == 10:
                # First was strike, need third roll
                return False
            else:
                # First wasn't strike
                return tenth_rolls[0] + tenth_rolls[1] >= 10
        elif len(tenth_rolls) == 3:
            # Third roll done
            return True
        else:
            return False
```
