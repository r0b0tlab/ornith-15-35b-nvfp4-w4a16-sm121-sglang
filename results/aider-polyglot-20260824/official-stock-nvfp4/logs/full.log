        let key = self.key;
        let start_position = self.position;
        let len = key.len();
        self.position = 0; // Reset since the XorMunge iterator will manage it

        XorMunge {
            key,
            iterator: data.into_iter(),
            position: start_position,
            len,
        }
    }
}

