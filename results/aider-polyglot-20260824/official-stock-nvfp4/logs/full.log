I can see the issue. The tests expect specific error messages for different validation failures. Let me analyze the required messages:

- `"Record id is invalid or out of order."` - for non-continuous IDs or missing root
- `"Only root should have equal record and parent id."` - for cycles directly (non-root with equal IDs)
- `"Node parent_id should be smaller than it's record_id."` - for parent_id >= record_id

Let me fix the code to use the correct error messages and validation logic:

tree_building.py
```python
class Record:
    def __init__(self, record_id, parent_id):
        self.record_id = record_id
        self.parent_id = parent_id


class Node:
    def __init__(self, node_id):
        self.node_id = node_id
        self.children = []


def BuildTree(records):
    if not records:
        return None

    # Create a mapping from record_id to Record
    record_map = {record.record_id: record for record in records}

    # Validate that we have exactly the records we expect (0 to n-1)
    expected_ids = set(range(len(records)))
    actual_ids = set(record_map.keys())

    if actual_ids != expected_ids:
        raise ValueError('Record id is invalid or out of order.')

    # Create Node objects
    nodes = {record_id: Node(record_id) for record_id in record_map}

    # Find the root (record with parent_id == record_id)
    root_id = None
    for record_id, record in record_map.items():
        if record_id == record.parent_id:
            if record_id != 0:
                raise ValueError('Only root should have equal record and parent id.')
            if root_id is not None:
                raise ValueError('Only root should have equal record and parent id.')
            root_id = record_id

    if root_id is None:
        raise ValueError('Record id is invalid or out of order.')

    # Build the tree structure
    for record_id, record in record_map.items():
        if record_id == 0:
            # This is the root, no parent to attach to
            continue

        if record.parent_id >= record_id:
            raise ValueError("Node parent_id should be smaller than it's record_id.")

        # Attach this node as a child of its parent
        parent_node = nodes[record.parent_id]
        parent_node.children.append(nodes[record_id])

    # Sort children by node_id for consistent ordering
    for node in nodes.values():
        node.children.sort(key=lambda child: child.node_id)

    return nodes[root_id]
