// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

use std::ptr;

/// A node in the doubly linked list.
///
/// Each node contains its data and raw pointers to the previous and next nodes.
/// The pointers are raw because we manage the links manually and the borrow
/// checker can't verify our safety guarantees.
struct Node<T> {
    data: T,
    prev: *mut Node<T>,
    next: *mut Node<T>,
}

impl<T> Node<T> {
    fn new(data: T) -> Self {
        Node {
            data,
            prev: ptr::null_mut(),
            next: ptr::null_mut(),
        }
    }
}

/// A doubly linked list.
///
/// # Invariants
/// - The list maintains a doubly linked chain of nodes.
/// - The head and tail pointers are null only when the list is empty.
/// - Each node's `prev` and `next` pointers correctly link to adjacent nodes.
/// - No node points back to create a cycle (except head<->tail in a 1-element list, which is valid).
pub struct LinkedList<T> {
    head: *mut Node<T>,
    tail: *mut Node<T>,
    len: usize,
    _marker: std::marker::PhantomData<Node<T>>,
}

/// A cursor that points to a specific position in the list.
///
/// The cursor can move forward and backward, peek at and modify the current
/// element, and insert or remove elements relative to its position.
pub struct Cursor<'a, T> {
    list: &'a mut LinkedList<T>,
    node: *mut Node<T>,
}

/// An iterator over the elements of a list, from front to back.
pub struct Iter<'a, T> {
    list: &'a LinkedList<T>,
    current: *mut Node<T>,
    len: usize,
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
            head: ptr::null_mut(),
            tail: ptr::null_mut(),
            len: 0,
            _marker: std::marker::PhantomData,
        }
    }

    // You may be wondering why it's necessary to have is_empty()
    // when it can easily be determined from len().
    // It's good custom to have both because len() can be expensive for some types,
    // whereas is_empty() is almost always cheap.
    // (Also ask yourself whether len() is expensive for LinkedList)
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        let node = if self.head.is_null() {
            ptr::null_mut()
        } else {
            self.head
        };
        Cursor { list: self, node }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        let node = if self.tail.is_null() {
            ptr::null_mut()
        } else {
            self.tail
        };
        Cursor { list: self, node }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            list: self,
            current: self.head,
            len: self.len,
        }
    }
}

impl<T> Default for LinkedList<T> {
    fn default() -> Self {
        Self::new()
    }
}

// the cursor is expected to act as if it is at the position of an element
// and it also has to work with and be able to insert into an empty list.
impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        if self.node.is_null() {
            None
        } else {
            // SAFETY: The node pointer is valid because it points to an element
            // that exists in the list. We only return a mutable reference while
            // the cursor holds a mutable reference to the list.
            Some(unsafe { &mut (*self.node).data })
        }
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        if self.node.is_null() {
            // Moving "next" from the empty position lands on the first element.
            if !self.list.head.is_null() {
                self.node = self.list.head;
                // SAFETY: head is non-null and points to a valid node.
                return Some(unsafe { &mut (*self.node).data });
            }
            return None;
        }

        let next_node = unsafe { (*self.node).next };
        if next_node.is_null() {
            // Already at the back; can't move further.
            self.node = ptr::null_mut();
            None
        } else {
            self.node = next_node;
            // SAFETY: next_node is non-null and points to a valid node.
            Some(unsafe { &mut (*self.node).data })
        }
    }

    /// Move one position backward (towards the front) and
    /// return a reference to the new position
    pub fn prev(&mut self) -> Option<&mut T> {
        if self.node.is_null() {
            // Moving "prev" from the empty position lands on the last element.
            if !self.list.tail.is_null() {
                self.node = self.list.tail;
                // SAFETY: tail is non-null and points to a valid node.
                return Some(unsafe { &mut (*self.node).data });
            }
            return None;
        }

        let prev_node = unsafe { (*self.node).prev };
        if prev_node.is_null() {
            // Already at the front; can't move further.
            self.node = ptr::null_mut();
            None
        } else {
            self.node = prev_node;
            // SAFETY: prev_node is non-null and points to a valid node.
            Some(unsafe { &mut (*self.node).data })
        }
    }

    /// Remove and return the element at the current position and move the cursor
    /// to the neighboring element that's closest to the back. This can be
    /// either the next or previous position.
    pub fn take(&mut self) -> Option<T> {
        if self.node.is_null() {
            return None;
        }

        unsafe {
            let node = Box::from_raw(self.node);
            let prev = node.prev;
            let next = node.next;

            // Unlink the node from the list.
            if !prev.is_null() {
                (*prev).next = next;
            } else {
                // This was the head.
                self.list.head = next;
            }

            if !next.is_null() {
                (*next).prev = prev;
            } else {
                // This was the tail.
                self.list.tail = prev;
            }

            self.list.len -= 1;

            // Determine the new cursor position: prefer the next node,
            // falling back to the previous node if next is null.
            if !next.is_null() {
                self.node = next;
            } else if !prev.is_null() {
                self.node = prev;
            } else {
                self.node = ptr::null_mut();
            }

