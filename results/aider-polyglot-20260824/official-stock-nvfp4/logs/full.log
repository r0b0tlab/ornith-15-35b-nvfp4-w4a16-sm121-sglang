I'll implement the Wordy exercise according to the instructions. This requires parsing and evaluating simple math word problems.

Here are the changes needed:

wordy.js
```
//
// This is only a SKELETON file for the 'Wordy' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const answer = (question) => {
  // Check if the question is a valid "What is..." question
  if (!question.startsWith('What is ') || !question.endsWith('?')) {
    throw new Error('Unknown operation');
  }

  // Extract the operation part
  const operation = question.slice(8, -1).trim();

  // Empty question (just "What is?")
  if (operation === '') {
    throw new Error('Operation not supported');
  }

  // Define supported operations
  const operations = {
    'plus': (a, b) => a + b,
    'minus': (a, b) => a - b,
    'multiplied by': (a, b) => a * b,
    'divided by': (a, b) => a / b
  };

  // Parse the operation tokens
  const tokens = operation.split(/\s+/);
  
  // First token must be a number
  if (isNaN(Number(tokens[0]))) {
    throw new Error('Syntax error');
  }

  let result = Number(tokens[0]);

  // Process pairs of operation and number
  for (let i = 1; i < tokens.length; i += 2) {
    const op = tokens[i];
    
    // Check if we have a valid operation
    if (!operations[op]) {
      // Check if it's a number (syntax error) or unknown operation
      if (!isNaN(Number(op))) {
        throw new Error('Syntax error');
      }
      throw new Error('Unknown operation');
    }

    // Check if we have the next number
    if (i + 1 >= tokens.length) {
      throw new Error('Syntax error');
    }

    const num = tokens[i + 1];
    if (isNaN(Number(num))) {
      throw new Error('Syntax error');
    }

    // Apply the operation
    result = operations[op](result, Number(num));
  }

  return result;
};
```
