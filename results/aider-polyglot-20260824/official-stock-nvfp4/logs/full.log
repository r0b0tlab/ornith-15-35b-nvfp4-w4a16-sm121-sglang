```python
NODE, EDGE, ATTR = range(3)


class Node:
    def __init__(self, name, attrs):
        self.name = name
        self.attrs = attrs

    def __eq__(self, other):
        return self.name == other.name and self.attrs == other.attrs


class Edge:
    def __init__(self, src, dst, attrs):
        self.src = src
        self.dst = dst
        self.attrs = attrs

    def __eq__(self, other):
        return (self.src == other.src and
                self.dst == other.dst and
                self.attrs == other.attrs)


class GraphAttribute:
    def __init__(self, attrs):
        self.attrs = attrs

    def __eq__(self, other):
        return self.attrs == other.attrs


class Graph:
    def __init__(self, data=None):
        self.nodes = []
        self.edges = []
        self.attrs = []

        if data is not None:
            for item in data:
                if not isinstance(item, tuple):
                    raise TypeError("Graph data malformed")
                if len(item) < 1:
                    raise TypeError("Graph data malformed")
                node_type = item[0]
                if node_type not in (NODE, EDGE, ATTR):
                    raise TypeError("Graph data malformed")
                if node_type == NODE:
                    if len(item) != 2:
                        raise TypeError("NODE malformed")
                    node = Node(item[1], item[2])
                    self.nodes.append(node)
                elif node_type == EDGE:
                    if len(item) != 3:
                        raise TypeError("EDGE malformed")
                    edge = Edge(item[1], item[2], item[3])
                    self.edges.append(edge)
                elif node_type == ATTR:
                    if len(item) != 2:
                        raise TypeError("ATTR malformed")
                    attr = GraphAttribute(item[1])
                    self.attrs.append(attr)

    def __iter__(self):
        return iter(self.nodes + self.edges + self.attrs)

    def __contains__(self, value):
        if value in self.nodes:
            return True
        if value in self.edges:
            return True
        if value in self.attrs:
            return True
        return False
```
