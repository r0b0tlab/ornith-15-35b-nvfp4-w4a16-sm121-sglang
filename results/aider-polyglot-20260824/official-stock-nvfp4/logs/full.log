package sublist

// Relation type is defined in relations.go file.

func Sublist(l1, l2 []int) Relation {
	if isSubsequence(l1, l2) {
		return Sublist
	}
	if isSubsequence(l2, l1) {
		return Superlist
	}
	return Equal
}

func isSubsequence(shorter, longer []int) bool {
	if len(shorter) == 0 {
		return true
	}
	if len(shorter) > len(longer) {
		return false
	}
	for i := 0; i <= len(longer)-len(shorter); i++ {
		match := true
		for j := 0; j < len(shorter); j++ {
			if longer[i+j] != shorter[j] {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
	return false
}
