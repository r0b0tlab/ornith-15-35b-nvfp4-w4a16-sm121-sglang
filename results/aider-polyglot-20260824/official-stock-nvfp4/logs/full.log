pub fn encode(key: &str, s: &str) -> Option<String> {
    // Validate the key - must be non-empty and contain only lowercase letters
    if key.is_empty() || !key.chars().all(|c| c.is_ascii_lowercase()) {
        return None;
    }

    let mut result = String::new();
    
    for (i, c) in s.chars().enumerate() {
        if !c.is_ascii_lowercase() {
            // Non-lowercase letters are passed through unchanged
            result.push(c);
            continue;
        }
        
        // Get the shift value from the key character
        let key_char = key.chars().nth(i % key.len())?;
        let shift = key_char as u32 - 'a' as u32;
        
        // Apply the shift to the current character
        let c_index = c as u32 - 'a' as u32;
        let shifted = (c_index + shift) % 26;
        let shifted_char = char::from_u32('a' as u32 + shifted)?;
        
        result.push(shifted_char);
    }
    
    Some(result)
}

pub fn decode(key: &str, s: &str) -> Option<String> {
    // Validate the key - must be non-empty and contain only lowercase letters
    if key.is_empty() || !key.chars().all(|c| c.is_ascii_lowercase()) {
        return None;
    }

    let mut result = String::new();
    
    for (i, c) in s.chars().enumerate() {
        if !c.is_ascii_lowercase() {
            // Non-lowercase letters are passed through unchanged
            result.push(c);
            continue;
        }
        
        // Get the shift value from the key character
        let key_char = key.chars().nth(i % key.len())?;
        let shift = key_char as u32 - 'a' as u32;
        
        // Apply the reverse shift to the current character
        let c_index = c as u32 - 'a' as u32;
        let unshifted = (c_index + 26 - shift) % 26;
        let unshifted_char = char::from_u32('a' as u32 + unshifted)?;
        
        result.push(unshifted_char);
    }
    
    Some(result)
}

pub fn encode_random(s: &str) -> (String, String) {
    // Generate a random key of at least 100 lowercase characters
    let mut key = String::new();
    for _ in 0..100 {
        let random_index = rand_u32() % 26;
        let random_char = char::from_u32('a' as u32 + random_index).unwrap();
        key.push(random_char);
    }
    
    // Encode the string using the random key
    let encoded = encode(&key, s).unwrap_or_else(|| s.to_string());
    
    (key, encoded)
}

// Simple pseudo-random number generator to avoid external dependencies
fn rand_u32() -> u32 {
