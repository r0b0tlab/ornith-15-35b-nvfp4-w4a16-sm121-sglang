```javascript
#!/usr/bin/env node

// The above line is a shebang. On Unix-like operating systems, or environments,
// this will allow the script to be run by node, and thus turn this JavaScript
// file into an executable. In other words, to execute this file, you may run
// the following from your terminal:
//
// ./grep.js args
//
// If you do not have a Unix-like operating system or environment, for example
// Windows without WSL, you can use the following inside a window terminal,
// such as cmd.exe:
//
// node grep.js args
//
// Read more about shebangs here: https://en.wikipedia.org/wiki/Shebang_(Unix)

const fs = require('fs');
const path = require('path');

/**
 * Reads the given file and returns lines.
 *
 * This function works regardless of POSIX (LF) or windows (CRLF) encoding.
 *
 * @param {string} file path to file
 * @returns {string[]} the lines
 */
function readLines(file) {
  const data = fs.readFileSync(path.resolve(file), { encoding: 'utf-8' });
  return data.split(/\r?\n/);
}

const VALID_OPTIONS = [
  'n', // add line numbers
  'l', // print file names where pattern is found
  'i', // ignore case
  'v', // reverse files results
  'x', // match entire line,
];

const ARGS = process.argv;

//
// This is only a SKELETON file for the 'Grep' exercise. It's been provided as a
// convenience to get you started writing code faster.
//
// This file should *not* export a function. Use ARGS to determine what to grep
// and use console.log(output) to write to the standard output.

// Parse command-line arguments
const args = ARGS.slice(2);

// Find the pattern (first non-flag argument)
let pattern = '';
const flags = [];
const files = [];

let i = 0;
while (i < args.length) {
  const arg = args[i];
  if (arg.startsWith('-')) {
    // It's a flag
    const flagChars = arg.slice(1);
    for (const char of flagChars) {
      if (!VALID_OPTIONS.includes(char)) {
        console.error(`Invalid flag: -${char}`);
        process.exit(1);
      }
      if (!flags.includes(char)) {
        flags.push(char);
      }
    }
  } else if (pattern === '') {
    // First non-flag argument is the pattern
    pattern = arg;
  } else {
    // Subsequent non-flag arguments are files
    files.push(arg);
  }
  i++;
}

// If no pattern provided, error out
if (pattern === '') {
  console.error('Error: No pattern provided');
  process.exit(1);
}

// If no files provided, error out
if (files.length === 0) {
  console.error('Error: No files provided');
  process.exit(1);
}

// Process each file
const results = [];

for (const file of files) {
  try {
    const lines = readLines(file);
    let fileHasMatch = false;

    for (let lineNumber = 0; lineNumber < lines.length; lineNumber++) {
      const line = lines[lineNumber];
      let match = false;

      // Apply case-insensitivity if flag 'i' is set
      let searchLine = line;
      let searchPattern = pattern;
      if (flags.includes('i')) {
        searchLine = searchLine.toLowerCase();
        searchPattern = searchPattern.toLowerCase();
      }

      // Check for match
      if (flags.includes('x')) {
        // Match entire line
        match = searchLine === searchPattern;
      } else {
        // Match substring
        match = searchLine.indexOf(searchPattern) !== -1;
      }

      // Apply reverse matching if flag 'v' is set
      if (flags.includes('v')) {
        match = !match;
      }

      // If match found, process output
      if (match) {
        fileHasMatch = true;

        // If 'l' flag is set, only need to know file has a match
        if (flags.includes('l')) {
          results.push(file);
          break;
        }

        // Build output line
        let outputLine = '';

        // Prepend filename if multiple files
        if (files.length > 1) {
          outputLine += `${file}:`;
        }

        // Prepend line number if 'n' flag is set
        if (flags.includes('n')) {
          outputLine += `${lineNumber + 1}:`;
        }

        // Append the line content
        outputLine += line;

        // Add to results
        results.push(outputLine);
      }
    }
  } catch (err) {
    console.error(`Error reading file ${file}: ${err.message}`);
    process.exit(1);
  }
}

// Output results
for (const result of results) {
  console.log(result);
}
