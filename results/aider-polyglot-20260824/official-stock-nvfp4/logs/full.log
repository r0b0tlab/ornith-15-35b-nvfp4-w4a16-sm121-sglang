lib.rs
```rust
pub mod graph {
    pub mod graph_items {
        pub mod edge {
            use std::hash::{Hash, Hasher};

            #[derive(Clone, Debug, PartialEq)]
            pub struct Edge<'a> {
                pub start: &'a str,
                pub end: &'a str,
                pub attrs: Vec<(&'a str, &'a str)>,
            }

            impl<'a> Edge<'a> {
                pub fn new(start: &'a str, end: &'a str) -> Self {
                    Edge {
                        start,
                        end,
                        attrs: Vec::new(),
                    }
                }

                pub fn with_attrs(self, attrs: &[(&'a str, &'a str)]) -> Self {
                    let mut edge = self;
                    edge.attrs = attrs.to_vec();
                    edge
                }
            }

            impl Hash for Edge<'_> {
                fn hash<H: Hasher>(&self, state: &mut H) {
                    self.start.hash(state);
                    self.end.hash(state);
                    self.attrs.hash(state);
                }
            }
        }

        pub mod node {
            use std::hash::{Hash, Hasher};

            #[derive(Clone, Debug, PartialEq)]
            pub struct Node<'a> {
                pub name: &'a str,
                pub attrs: Vec<(&'a str, &'a str)>,
            }

            impl<'a> Node<'a> {
                pub fn new(name: &'a str) -> Self {
                    Node {
                        name,
                        attrs: Vec::new(),
                    }
                }

                pub fn with_attrs(self, attrs: &[(&'a str, &'a str)]) -> Self {
                    let mut node = self;
                    node.attrs = attrs.to_vec();
                    node
                }
            }

            impl Hash for Node<'_> {
                fn hash<H: Hasher>(&self, state: &mut H) {
                    self.name.hash(state);
                    self.attrs.hash(state);
                }
            }
        }

        pub mod graph {
            use super::edge::Edge;
            use super::node::Node;

            #[derive(Clone, Debug, Default, PartialEq)]
            pub struct Graph<'a> {
                pub nodes: Vec<Node<'a>>,
                pub edges: Vec<Edge<'a>>,
                pub attrs: Vec<(&'a str, &'a str)>,
            }

            impl<'a> Graph<'a> {
                pub fn new() -> Self {
                    Graph {
                        nodes: Vec::new(),
                        edges: Vec::new(),
                        attrs: Vec::new(),
                    }
                }

                pub fn with_nodes(&mut self, nodes: &[Node<'a>]) -> &mut Self {
                    self.nodes.extend_from_slice(nodes);
                    self
                }

                pub fn with_edges(&mut self, edges: &[Edge<'a>]) -> &mut Self {
                    self.edges.extend_from_slice(edges);
                    self
                }

                pub fn with_attrs(&mut self, attrs: &[(&'a str, &'a str)]) -> &mut Self {
                    self.attrs.extend_from_slice(attrs);
                    self
                }
            }
        }

        pub use graph::Graph;
    }

    pub use graph_items::Graph;
}
```
