        if self.sign == other.sign {
            let (int, frac) = add_magnitude(&self.int_digits, &self.frac_digits, &other.int_digits, &other.frac_digits);
            Decimal {
                sign: self.sign,
                int_digits: int,
                frac_digits: frac,
            }
        } else {
            // Different signs: subtract smaller magnitude from larger
            let cmp = self.compare_magnitude(other);
            if cmp == std::cmp::Ordering::Equal {
