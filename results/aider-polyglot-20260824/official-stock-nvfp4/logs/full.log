```java
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class ChangeCalculator {

    private final List<Integer> currencyCoins;

    ChangeCalculator(List<Integer> currencyCoins) {
        this.currencyCoins = currencyCoins;
    }

    List<Integer> computeMostEfficientChange(int grandTotal) {
        if (grandTotal < 0) {
            throw new IllegalArgumentException("Negative totals are not allowed.");
        }

        if (grandTotal == 0) {
            return new ArrayList<>();
        }

        // DP array where total[i] holds the fewest coins needed for value i
        int[] minCoins = new int[grandTotal + 1];
        // lastCoin[i] records which coin was added to reach value i optimally
        int[] lastCoin = new int[grandTotal + 1];

        Arrays.fill(minCoins, grandTotal + 1); // Use an impossible value as "infinity"
        minCoins[0] = 0; // Zero coins needed to make total of 0

        for (int amount = 1; amount <= grandTotal; amount++) {
            for (int coin : currencyCoins) {
                if (coin <= amount) {
                    int candidate = minCoins[amount - coin] + 1;
                    if (candidate < minCoins[amount]) {
                        minCoins[amount] = candidate;
                        lastCoin[amount] = coin;
                    }
                }
            }
        }

        if (minCoins[grandTotal] > grandTotal) {
            // No valid combination of coins could make the total
            throw new IllegalArgumentException(
                    "The total " + grandTotal + " cannot be represented in the given currency.");
        }

        // Reconstruct the list of coins by tracing back through lastCoin
        List<Integer> result = new ArrayList<>();
        int current = grandTotal;
        while (current > 0) {
            int coin = lastCoin[current];
            result.add(coin);
            current -= coin;
        }

        return result;
    }

}
```
