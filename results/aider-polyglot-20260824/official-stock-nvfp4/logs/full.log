rest_api.py
```
import json


class RestAPI:
    def __init__(self, database=None):
        self.database = database or {}
        # users[name] = dict of {other_name: amount}, where amount > 0 means name owes other_name
        self.owes = {name: {} for name in self.database}
        self.owed_by = {name: {} for name in self.database}

        for name, info in self.database.items():
            for other, amount in info.get("owes", {}).items():
                self.owes[name][other] = amount
                self.owed_by[other][name] = amount

    def get(self, url, payload=None):
        if url == "/users":
            if payload:
                users = json.loads(payload)["users"]
            else:
                users = None

            result = []
            for name in sorted(self.database):
                if users is None or name in users:
                    result.append(self._build_user_object(name))

            return json.dumps({"users": result})

    def post(self, url, payload=None):
        data = json.loads(payload)

        if url == "/add":
            name = data["user"]
            if name not in self.database:
                self.database[name] = {}
                self.owes[name] = {}
                self.owed_by[name] = {}
            return json.dumps(self._build_user_object(name))

        elif url == "/iou":
            lender = data["lender"]
            borrower = data["borrower"]
            amount = data["amount"]

            # Ensure both users exist
            for name in (lender, borrower):
                if name not in self.database:
                    self.database[name] = {}
                    self.owes[name] = {}
                    self.owed_by[name] = {}

            # Lender owes borrower nothing; borrower owes lender 'amount'
            self._update_balance(lender, borrower, amount)
            self._update_balance(borrower, lender, -amount)

            users = sorted([lender, borrower])
            result = [self._build_user_object(name) for name in users]
            return json.dumps({"users": result})

    def _update_balance(self, person, other, amount):
        """Update the balance between person and other.
        Positive amount means person owes other; negative means other owes person.
        """
        if amount == 0:
            return

        current = self.owes[person].get(other, 0)
        new_total = current + amount

        if new_total > 0:
            self.owes[person][other] = new_total
        elif new_total < 0:
            # Convert to owed_by representation
            del self.owes[person][other]
            self.owed_by[other][person] = -new_total
        else:
            # Balance is zero, remove both entries
            self.owes[person].pop(other, None)
            self.owed_by[other].pop(person, None)

    def _build_user_object(self, name):
        owed_total = sum(self.owed_by[name].values())
        owes_total = sum(self.owes[name].values())

        return {
            "name": name,
            "owes": dict(self.owes[name]),
            "owed_by": dict(self.owed_by[name]),
            "balance": owed_total - owes_total,
        }
```
