- "Exchange code cannot start with one"

Also, the length check logic needs to allow 11 digits and handle the country code properly.

phone-number.js
```js
export const clean = (phoneNumber) => {
  // Check for letters in the input, which are not allowed
  if (/[a-zA-Z]/.test(phoneNumber)) {
    throw new Error('Letters not permitted');
  }

  // Check for invalid punctuation (anything that's not a digit, space, or allowed punctuation)
  if (/[^0-9\s+\-.()]/.test(phoneNumber)) {
    throw new Error('Punctuations not permitted');
  }

  // Remove all non-digit characters
  let digits = phoneNumber.replace(/\D/g, '');

  // Handle digit count validation
  if (digits.length < 10) {
    throw new Error('Incorrect number of digits');
  }

  if (digits.length > 11) {
    throw new Error('More than 11 digits');
  }

  // Handle the country code
  if (digits.length === 11) {
    if (digits[0] !== '1') {
      throw new Error('11 digits must start with 1');
    }
    digits = digits.slice(1);
  }

  // Now digits should be exactly 10
  const areaCode = digits[0];
  const exchangeCode = digits[3];

  // Area code cannot start with 0
  if (areaCode === '0') {
    throw new Error('Area code cannot start with zero');
  }

  // Area code cannot start with 1
  if (areaCode === '1') {
    throw new Error('Area code cannot start with one');
  }

  // Exchange code cannot start with 0
  if (exchangeCode === '0') {
    throw new Error('Exchange code cannot start with zero');
  }

  // Exchange code cannot start with 1
  if (exchangeCode === '1') {
    throw new Error('Exchange code cannot start with one');
  }

  return digits;
};
```
