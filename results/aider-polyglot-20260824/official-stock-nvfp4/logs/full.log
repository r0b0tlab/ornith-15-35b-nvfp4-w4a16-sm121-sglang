use std::collections::HashMap;

pub struct CodonsInfo<'a> {
    mapping: HashMap<&'a str, &'a str>,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Error;

// IUPAC nucleotide shorthand mapping
const IUPAC: char_map = {
    let mut map = HashMap::new();
    map.insert('A', "A");
    map.insert('C', "C");
    map.insert('G', "G");
    map.insert('T', "T");
    map.insert('R', "AG");
    map.insert('Y', "CT");
    map.insert('S', "GC");
    map.insert('W', "AT");
    map.insert('K', "GT");
    map.insert('M', "AC");
    map.insert('B', "TCG");
    map.insert('D', "TAC");
    map.insert('H', "TC");
    map.insert('V', "CGT");
    map.insert('N', "TCGA");
    map
};

impl<'a> CodonsInfo<'a> {
    pub fn name_for(&self, codon: &str) -> Result<&'a str, Error> {
        // Expand the codon into all possible concrete codons
        let mut codons: Vec<String> = vec![String::new()];

        for ch in codon.chars() {
            let expansions = IUPAC.get(&ch).copied().unwrap_or("");
            if expansions.is_empty() {
                return Err(Error);
            }

            let mut new_codons = Vec::new();
            for prefix in &codons {
                for exp in expansions.chars() {
                    new_codons.push(format!("{}{}", prefix, exp));
                }
            }
            codons = new_codons;
        }

        // Look up each concrete codon in the mapping
        for codon in codons {
            if let Some(name) = self.mapping.get(&codon[..]) {
                return Ok(*name);
            }
        }

        Err(Error)
    }

    pub fn of_rna(&self, rna: &str) -> Result<Vec<&'a str>, Error> {
        let mut proteins = Vec::new();

        for chunk in rna.chars().collect::<Vec<char>>().chunks(3) {
            if chunk.len() != 3 {
                return Err(Error);
            }

            let codon: String = chunk.iter().collect();

            match self.name_for(&codon) {
                Ok(name) => {
                    // Stop codons terminate translation
                    if name == "Stop" {
                        return Ok(proteins);
                    }
                    proteins.push(name);
                }
                Err(_) => return Err(Error),
            }
        }

        Ok(proteins)
    }
}

pub fn parse<'a>(pairs: Vec<(&'a str, &'a str)>) -> CodonsInfo<'a> {
    let mut mapping = HashMap::new();
    for (codon, name) in pairs {
        mapping.insert(codon, name);
    }
    CodonsInfo { mapping }
}
