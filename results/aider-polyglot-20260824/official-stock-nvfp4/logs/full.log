				log <- "duplicate robot name"
			}
		}
		for j := 0; j < len(robots); j++ {
			if i != j && robots[i].X == robots[j].X && robots[i].Y == robots[j].Y {
				log <- "robots placed at the same place"
			}
		}
		if robots[i].X < extent.MinX || robots[i].X > extent.MaxX ||
			robots[i].Y < extent.MinY || robots[i].Y > extent.MaxY {
			log <- "robot placed outside of the room"
		}
	}

	// Process actions until the action channel is closed
	for act := range action {
		// This is a simplified implementation that doesn't handle
		// which robot performed the action, as the channel design
		// doesn't clearly specify this relationship.
		for i := range robots {
			switch act {
			case A3Right:
				robots[i].Dir = rotateRight(robots[i].Dir)
			case A3Left:
				robots[i].Dir = rotateLeft(robots[i].Dir)
			case A3Advance:
				robots[i] = advanceRobot3(extent, robots[i])
			}
		}
	}

	// Send final robots state to report channel
	rep <- robots
}

func advanceRobot3(extent Rect, robot Step3Robot) Step3Robot {
	switch robot.Dir {
