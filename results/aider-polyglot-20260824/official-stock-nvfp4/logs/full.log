```javascript
//
// This is only a SKELETON file for the 'Food Chain' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Song {
  verse(number) {
    const animals = [
      { name: 'fly', intro: '', reaction: '' },
      { name: 'spider', intro: 'It wriggled and jiggled and tickled inside her.', reaction: '' },
      { name: 'bird', intro: 'How absurd to swallow a bird!', reaction: '' },
      { name: 'cat', intro: 'Imagine that, to swallow a cat!', reaction: '' },
      { name: 'dog', intro: 'What a hog, to swallow a dog!', reaction: '' },
      { name: 'goat', intro: 'Just opened her throat and swallowed a goat!', reaction: '' },
      { name: 'cow', intro: 'I don\'t know how she swallowed a cow!', reaction: '' },
      { name: 'horse', intro: "She's dead, of course!", reaction: '' }
    ];

    const verse = animals[number - 1];
    const lines = [];
    
    // First line
    lines.push(`I know an old lady who swallowed a ${verse.name}.`);
    
    // Intro/reaction line
    if (verse.intro) {
      lines.push(verse.intro);
    }
    
    // Special case for horse - ends here
    if (verse.name === 'horse') {
      return lines.join('\n') + '\n';
    }
    
    // Cumulative swallowing lines
    for (let i = number - 1; i > 0; i--) {
      const currentAnimal = animals[i].name;
      const previousAnimal = animals[i - 1].name;
      
      if (currentAnimal === 'bird') {
        // Special case: bird catching spider
        lines.push(`She swallowed the ${currentAnimal} to catch the ${previousAnimal} that wriggled and jiggled and tickled inside her.`);
      } else {
        lines.push(`She swallowed the ${currentAnimal} to catch the ${previousAnimal}.`);
      }
    }
    
    // Final line
    lines.push("I don't know why she swallowed the fly. Perhaps she'll die.");
    
    return lines.join('\n') + '\n';
  }

  verses(start, end) {
    const result = [];
    for (let i = start; i <= end; i++) {
      result.push(this.verse(i));
    }
    return result.join('\n');
  }
}
