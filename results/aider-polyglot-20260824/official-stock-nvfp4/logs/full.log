+    tm_val.tm_min = 0;
+    tm_val.tm_sec = 0;
+    time_t t = timegm(&tm_val);
+    struct tm* utc = gmtime(&t);
+    int first_weekday = utc->tm_wday;
+    
+    // Calculate the day of the month for the requested weekday
+    int target_weekday = static_cast<int>(weekday);
+    int offset = (target_weekday - first_weekday + 7) % 7;
+    
+    switch (week) {
+        case week_of_month::first:
+            result.day = offset + 1;
+            break;
+        case week_of_month::second:
+            result.day = offset + 8;
+            break;
+        case week_of_month::third:
+            result.day = offset + 15;
+            break;
+        case week_of_month::fourth:
+            result.day = offset + 22;
+            break;
+        case week_of_month::last:
+            result.day = offset + 29;
+            if (result.day > days_in_month) {
+                result.day -= 7;
+            }
+            break;
+        default:
+            break;
+    }
+    
+    return result;
+}
+
 }  // namespace meetup
