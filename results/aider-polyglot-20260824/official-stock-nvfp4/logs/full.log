I'll implement the base converter. This requires:

1. Validating the input bases and digits in the constructor.
2. Converting the digits from the original base to a decimal number.
3. Converting that decimal number to the new base.

Here are the changes:

BaseConverter.java
```java
import java.util.ArrayList;
import java.util.List;

class BaseConverter {

    private final int originalBase;
    private final int[] originalDigits;
    private final int decimalValue;

    BaseConverter(int originalBase, int[] originalDigits) {
        if (originalBase < 2) {
            throw new IllegalArgumentException("Base must be >= 2");
        }
        if (originalDigits.length == 0) {
            throw new IllegalArgumentException("You must supply at least one digit.");
        }
        for (int digit : originalDigits) {
            if (digit < 0) {
                throw new IllegalArgumentException("Digits must be >= 0");
            }
            if (digit >= originalBase) {
                throw new IllegalArgumentException("Digits must be < base");
            }
        }

        this.originalBase = originalBase;
        this.originalDigits = originalDigits;

        // Convert to decimal
        this.decimalValue = 0;
        for (int digit : originalDigits) {
            this.decimalValue = this.decimalValue * originalBase + digit;
        }
    }

    int[] convertToBase(int newBase) {
        if (newBase < 2) {
            throw new IllegalArgumentException("Base must be >= 2");
        }

        List<Integer> result = new ArrayList<>();

        if (this.decimalValue == 0) {
            result.add(0);
        } else {
            int value = this.decimalValue;
            while (value > 0) {
                result.add(0, value % newBase);
                value /= newBase;
            }
        }

        return result.stream().mapToInt(Integer::intValue).toArray();
    }
}
```
