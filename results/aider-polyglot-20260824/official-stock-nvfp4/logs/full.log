    }

    public LedgerEntry createLedgerEntry(String d, String desc, int c) {
        LedgerEntry le = new LedgerEntry();
        le.setChange(c);
        le.setDescription(desc);
        le.setLocalDate(LocalDate.parse(d));
        return le;
    }

    public String format(String cur, String loc, LedgerEntry[] entries) {
        LocaleConfig config = getConfig(cur, loc);

        StringBuilder sb = new StringBuilder();
        sb.append(config.header);

        List<LedgerEntry> sortedEntries = new ArrayList<>();
        for (LedgerEntry entry : entries) {
            sortedEntries.add(entry);
        }

        // Sort: negatives first (by date), then positives (by date)
        sortedEntries.sort((a, b) -> {
            int dateCompare = a.getLocalDate().compareTo(b.getLocalDate());
            if (dateCompare != 0) {
                return dateCompare;
            }
            // Negatives come before positives when dates are equal
            return Double.compare(a.getChange(), b.getChange());
        });

        for (LedgerEntry entry : sortedEntries) {
            sb.append("\n");
            sb.append(formatRow(config, cur, loc, entry));
        }

        return sb.toString();
    }

    private LocaleConfig getConfig(String cur, String loc) {
        if (!cur.equals("USD") && !cur.equals("EUR")) {
            throw new IllegalArgumentException("Invalid currency");
        }
        if (!loc.equals("en-US") && !loc.equals("nl-NL")) {
            throw new IllegalArgumentException("Invalid locale");
        }
        return CONFIGS.get(loc).get(cur);
    }

    private String formatRow(LocaleConfig config, String cur, String loc, LedgerEntry entry) {
        String date = formatDate(entry, config);
        String desc = formatDescription(entry.getDescription());
        String amount = formatAmount(config, loc, entry);
        return String.format("%s | %-25s | %13s", date, desc, amount);
    }

    private String formatDate(LedgerEntry entry, LocaleConfig config) {
        return entry.getLocalDate().format(DateTimeFormatter.ofPattern(config.datePattern));
    }

    private String formatDescription(String desc) {
        if (desc.length() > 25) {
            return desc.substring(0, 22) + "...";
        }
        return desc;
    }

    private String formatAmount(LocaleConfig config, String loc, LedgerEntry entry) {
        boolean isNegative = entry.getChange() < 0;
        String integerPart = formatIntegerPart(Math.abs(entry.getChange() / 100), config);
        String decimalPart = formatDecimalPart(entry.getChange(), config);
        String amount = config.currencySymbol + " " + integerPart + config.decimalSeparator + decimalPart;

        // Apply locale-specific negative formatting
        if (isNegative) {
            if (loc.equals("en-US")) {
                return "(" + amount + ")";
            } else {
                // nl-NL: prefix with minus, no parentheses
                return config.currencySymbol + " -" + integerPart + config.decimalSeparator + decimalPart;
            }
        }

        // Positive value formatting
        if (loc.equals("nl-NL")) {
            return " " + amount + " ";
        }
        return amount + " ";
    }

    private String formatIntegerPart(int amount, LocaleConfig config) {
        StringBuilder result = new StringBuilder();
        String digits = Integer.toString(amount);
        int count = 1;

        for (int i = digits.length() - 1; i >= 0; i--) {
            if (count % 3 == 0 && i > 0) {
                result.insert(0, config.thousandsSeparator);
            }
            result.insert(0, digits.charAt(i));
            count++;
        }
        return result.toString();
    }

    private String formatDecimalPart(double change, LocaleConfig config) {
        // Get the cents as a two-digit decimal part
        int cents = (int) Math.abs(Math.round(change)) % 100;
        return String.format("%02d", cents);
    }

