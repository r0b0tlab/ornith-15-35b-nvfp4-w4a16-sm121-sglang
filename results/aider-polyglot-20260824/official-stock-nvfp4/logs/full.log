                if (bev_idx[2] != 2) continue; // milk is index 2
                
                // Constraint 4: green house drinks coffee
                if (beverages[bev_idx[green_pos]] != "coffee") continue;
                
                // Constraint 5: Ukrainian drinks tea
                int ukrainian_pos = -1;
                for (int i = 0; i < 5; i++) {
