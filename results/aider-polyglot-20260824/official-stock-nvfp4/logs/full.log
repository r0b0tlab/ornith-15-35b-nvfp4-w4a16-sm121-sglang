```javascript
//
// This is only a SKELETON file for the 'Promises' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const promisify = (callbackFunction, options = {}) => {
  return function (...args) {
    return new Promise((resolve, reject) => {
      callbackFunction.apply(
        this,
        [...args, (error, ...rest) => {
          if (error) {
            reject(error);
          } else {
            resolve(rest.length > 1 ? rest : rest[0]);
          }
        }]
      );
    });
  };
};

export const all = (promises) => {
  return new Promise((resolve, reject) => {
    if (promises === undefined) {
      resolve(undefined);
      return;
    }
    const results = [];
    let completed = 0;

    if (!Array.isArray(promises) || promises.length === 0) {
      resolve(results);
      return;
    }

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then((value) => {
          results[index] = value;
          completed++;
          if (completed === promises.length) {
            resolve(results);
          }
        })
        .catch((error) => {
          reject(error);
        });
    });
  });
};

export const allSettled = (promises) => {
  return new Promise((resolve) => {
    if (promises === undefined) {
      resolve(undefined);
      return;
    }
    const results = [];
    let completed = 0;

    if (!Array.isArray(promises) || promises.length === 0) {
      resolve(results);
      return;
    }

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then(
          (value) => {
            results[index] = { status: 'fulfilled', value };
            completed++;
            if (completed === promises.length) {
              resolve(results);
            }
          },
          (error) => {
            results[index] = { status: 'rejected', reason: error };
            completed++;
            if (completed === promises.length) {
              resolve(results);
            }
          }
        );
    });
  });
};

export const race = (promises) => {
  return new Promise((resolve, reject) => {
    if (promises === undefined) {
      resolve(undefined);
      return;
    }

    if (!Array.isArray(promises) || promises.length === 0) {
      resolve([]);
      return;
    }

    promises.forEach((promise) => {
      Promise.resolve(promise)
        .then(
          (value) => resolve(value),
          (error) => reject(error)
        );
    });
  });
};

export const any = (promises) => {
  return new Promise((resolve, reject) => {
    if (promises === undefined) {
      resolve(undefined);
      return;
    }

    if (!Array.isArray(promises) || promises.length === 0) {
      reject(new Error('AggregationError: All promises were rejected'));
      return;
    }

    const errors = [];

    promises.forEach((promise, index) => {
      Promise.resolve(promise)
        .then(
          (value) => resolve(value),
          (error) => {
            errors[index] = error;
          }
        );
    });

    // Need to handle the case where all promises reject
    let settled = 0;
    promises.forEach((promise) => {
      Promise.resolve(promise).then(
        () => {},
        () => {
          settled++;
          if (settled === promises.length) {
            reject(new Error('AggregationError: All promises were rejected'));
          }
        }
      );
    });
  });
};
