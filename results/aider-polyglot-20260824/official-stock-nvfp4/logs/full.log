use std::collections::HashSet;
use std::sync::Mutex;

pub struct Robot {
    name: String,
}

static USED_NAMES: Mutex<HashSet<String>> = Mutex::new(HashSet::new());

impl Robot {
    pub fn new() -> Self {
        Robot { name: generate_unique_name() }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let new_name = generate_unique_name();
        self.name = new_name;
    }
}

fn generate_unique_name() -> String {
    loop {
        // Generate two uppercase letters
        let letter1 = random_letter();
        let letter2 = random_letter();
        
        // Generate three digits
        let digit1 = (rand_int(10) as u8 + b'0') as char;
        let digit2 = (rand_int(10) as u8 + b'0') as char;
        let digit3 = (rand_int(10) as u8 + b'0') as char;
        
        let candidate = format!("{}{}{}{}", letter1, letter2, digit1, digit2, digit3);
        
        // Check if this name is already used
        let mut used_names = USED_NAMES.lock().unwrap();
        if used_names.insert(candidate.clone()) {
            return candidate;
        }
        // If insert returns false, the name already existed, so loop again
    }
}

fn random_letter() -> char {
    let offset = rand_int(26);
    (b'A' + offset as u8) as char
}

fn rand_int(max: u32) -> u32 {
    // Simple pseudo-random number generator
