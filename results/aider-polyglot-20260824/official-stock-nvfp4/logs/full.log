 23%|██▎       | 52/225 [02:52<36:54, 12.80s/it]response:
The test failure shows that decoding `0xffffffff` (the maximum 32-bit unsigned integer) fails because the code masks the value with `0x7FFFFFFF` during accumulation, which truncates the top bit. The fix is to accumulate in an unmasked `uint64` and then validate that the result fits within 32 bits before converting to `uint32`.

variable_length_quantity.go
```go
package variablelengthquantity

import "errors"

// EncodeVarint encodes a slice of uint32 values into variable length quantity bytes.
func EncodeVarint(input []uint32) []byte {
	var result []byte
	for _, value := range input {
		// Extract 7 bits at a time, from least significant to most significant.
		var chunks []byte
		chunks = append(chunks, byte(value&0x7F))
		value >>= 7
		for value > 0 {
			chunks = append(chunks, byte(value&0x7F)|0x80)
			value >>= 7
		}
		// Reverse chunks so most significant chunk comes first.
		for i, j := 0, len(chunks)-1; i < j; i, j = i+1, j-1 {
			chunks[i], chunks[j] = chunks[j], chunks[i]
		}
		result = append(result, chunks...)
	}
	return result
}

// DecodeVarint decodes a variable length quantity byte slice into a slice of uint32 values.
func DecodeVarint(input []byte) ([]uint32, error) {
	var result []uint32
	var value uint64
	var haveIncomplete bool

	for _, b := range input {
		value = (value << 7) | uint64(b&0x7F)
		if b&0x80 == 0 {
			// Final byte of a number.
			if value > 0xFFFFFFFF {
				return nil, errors.New("value overflows 32 bits")
			}
			result = append(result, uint32(value))
			value = 0
			haveIncomplete = false
		} else {
			haveIncomplete = true
		}
	}

	if haveIncomplete {
		return nil, errors.New("incomplete variable length quantity")
	}

	return result, nil
}
