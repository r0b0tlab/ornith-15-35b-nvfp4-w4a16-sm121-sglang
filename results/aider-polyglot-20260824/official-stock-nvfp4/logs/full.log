        generatePermutations(arr, used, current, 0, result);
        return result;
    }
    
    private void generatePermutations(int[] arr, boolean[] used, int[] current, int index, List<int[]> result) {
        if (index == current.length) {
            result.add(current.clone());
            return;
        }
        
        for (int i = 0; i < arr.length; i++) {
            if (!used[i]) {
                used[i] = true;
                current[index] = arr[i];
                generatePermutations(arr, used, current, index + 1, result);
                used[i] = false;
            }
        }
    }
}
