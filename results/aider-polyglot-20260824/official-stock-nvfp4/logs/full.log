#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
}

impl BowlingGame {
    pub fn new() -> Self {
        BowlingGame { rolls: Vec::new() }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if pins > 10 {
            return Err(Error::NotEnoughPinsLeft);
        }

        let frame_info = self.current_frame_info();
        
        match frame_info {
            FrameState::InProgress { pins_left } => {
                if pins > pins_left {
                    return Err(Error::NotEnoughPinsLeft);
                }
                self.rolls.push(pins);
                Ok(())
            }
            FrameState::Complete => {
                Err(Error::GameComplete)
            }
        }
    }

    pub fn score(&self) -> Option<u16> {
        let frames = self.frames();
        
        if frames.len() < 10 {
            return None;
        }
        
        // Check if 10th frame is complete
        let tenth_frame = &frames[9];
        if !tenth_frame.complete {
            return None;
        }
        
        let mut score = 0;
        let mut roll_index = 0;
        
        for frame in &frames[..9] {
            // Add the pins for this frame
            score += frame.total_pins();
            
            // Handle bonuses
            if frame.is_strike() {
                // Strike: next two rolls
                if roll_index + 2 < self.rolls.len() {
                    score += self.rolls[roll_index + 1] + self.rolls[roll_index + 2];
                }
                roll_index += 1;
            } else if frame.is_spare() {
                // Spare: next one roll
                if roll_index + 1 < self.rolls.len() {
                    score += self.rolls[roll_index + 1];
                }
                roll_index += 2;
            } else {
                // Open frame: no bonus
                roll_index += 2;
            }
        }
        
        // Add 10th frame score
        score += frames[9].total_pins();
        
        Some(score)
    }
    
    fn current_frame_info(&self) -> FrameState {
        let mut roll_index = 0;
        let mut frame = 0;
        
        while frame < 10 {
            if frame < 9 {
                // Regular frames
                if roll_index >= self.rolls.len() {
                    return FrameState::InProgress { pins_left: 10 };
                }
                
                let first = self.rolls[roll_index];
                if first == 10 {
                    // Strike
                    roll_index += 1;
                    frame += 1;
                } else {
                    // First roll done, waiting for second
                    if roll_index + 1 >= self.rolls.len() {
                        return FrameState::InProgress { pins_left: 10 - first };
                    }
                    let second = self.rolls[roll_index + 1];
                    if first + second >= 10 {
                        // Spare, frame complete
                        roll_index += 2;
                        frame += 1;
                    } else {
                        // Open frame, complete
                        roll_index += 2;
                        frame += 1;
                    }
                }
            } else {
                // 10th frame
                match self.tenth_frame_state() {
                    Some(state) => return state,
                    None => {
                        // Shouldn't happen, but safety
                        return FrameState::Complete;
                    }
                }
            }
        }
        
        FrameState::Complete
    }
    
    fn tenth_frame_state(&self) -> Option<FrameState> {
        // Count rolls in 10th frame
        let mut rolls_used: usize = 0;
        let mut frame = 0;
        
        while frame < 9 && rolls_used < self.rolls.len() {
            if self.rolls[rolls_used] == 10 {
                rolls_used += 1;
            } else {
                rolls_used += 2;
            }
            frame += 1;
        }
        
        // Now rolls_used points to start of 10th frame
        let remaining = &self.rolls[rolls_used..];
        
        if remaining.is_empty() {
            return Some(FrameState::InProgress { pins_left: 10 });
        }
        
        match remaining.len() {
            1 => {
                // First roll of 10th frame done
                if remaining[0] == 10 {
                    // Strike, need one more ball
                    Some(FrameState::InProgress { pins_left: 10 })
                } else {
                    // Open or spare setup
                    Some(FrameState::InProgress { pins_left: 10 - remaining[0] })
                }
            }
            2 => {
                if remaining[0] == 10 {
                    // Strike followed by something
                    if remaining[1] == 10 {
                        // Second strike, need one more
                        Some(FrameState::InProgress { pins_left: 10 })
                    } else {
                        // Open after strike, complete
                        Some(FrameState::Complete)
                    }
                } else if remaining[0] + remaining[1] >= 10 {
                    // Spare, need one more
                    Some(FrameState::InProgress { pins_left: 10 })
                } else {
                    // Open frame, complete
                    Some(FrameState::Complete)
                }
            }
            _ => {
                // Three rolls in 10th frame
                Some(FrameState::Complete)
            }
        }
    }
    
    fn frames(&self) -> Vec<Fframe> {
        let mut frames: Vec<Fframe> = Vec::new();
        let mut roll_index = 0;
        
        for frame_num in 0..10 {
            if frame_num < 9 {
                if roll_index >= self.rolls.len() {
                    break;
                }
                let first = self.rolls[roll_index];
                if first == 10 {
                    frames.push(Fframe {
                        rolls: vec![10],
                        complete: true,
                    });
                    roll_index += 1;
                } else {
                    if roll_index + 1 >= self.rolls.len() {
                        break;
                    }
                    let second = self.rolls[roll_index + 1];
                    frames.push(Fframe {
                        rolls: vec![first, second],
                        complete: true,
                    });
                    roll_index += 2;
                }
            } else {
                // 10th frame
                let mut frame_rolls: Vec<u16> = Vec::new();
                
                if roll_index >= self.rolls.len() {
                    break;
                }
                
                let first = self.rolls[roll_index];
                frame_rolls.push(first);
                roll_index += 1;
                
                if first == 10 {
                    // Strike, can have up to 2 more rolls
                    if roll_index < self.rolls.len() {
                        let second = self.rolls[roll_index];
                        frame_rolls.push(second);
                        roll_index += 1;
                        
                        if second == 10 {
                            // Another strike, need one more
                            if roll_index < self.rolls.len() {
                                let third = self.rolls[roll_index];
                                frame_rolls.push(third);
                                roll_index += 1;
                            }
                        } else {
                            // Open after strike, complete
                        }
                    }
                } else {
                    // Not a strike, need second roll
                    if roll_index < self.rolls.len() {
                        let second = self.rolls[roll_index];
                        frame_rolls.push(second);
                        roll_index += 1;
                        
                        if first + second >= 10 {
                            // Spare, need one more
                            if roll_index < self.rolls.len() {
                                let third = self.rolls[roll_index];
                                frame_rolls.push(third);
                                roll_index += 1;
                            }
                        }
                    }
                }
                
                frames.push(Fframe {
                    rolls: frame_rolls,
                    complete: true,
                });
            }
        }
        
        frames
    }
}

#[derive(Debug)]
struct Fframe {
    rolls: Vec<u16>,
    complete: bool,
}

impl Fframe {
    fn total_pins(&self) -> u16 {
        self.rolls.iter().sum()
    }
    
    fn is_strike(&self) -> bool {
        self.rolls.first() == Some(&10)
    }
    
    fn is_spare(&self) -> bool {
        self.rolls.len() == 2 && self.rolls[0] + self.rolls[1] == 10
    }
}

#[derive(Debug)]
enum FrameState {
    InProgress { pins_left: u16 },
    Complete,
}
