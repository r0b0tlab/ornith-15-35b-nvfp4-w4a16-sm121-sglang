bottle-song.js
```
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const numberWords = {
  0: 'no',
  1: 'one',
  2: 'two',
  3: 'three',
  4: 'four',
  5: 'five',
  6: 'six',
  7: 'seven',
  8: 'eight',
  9: 'nine',
  10: 'ten'
};

const capitalize = (string) => {
  return string.charAt(0).toUpperCase() + string.slice(1);
};

const bottlesWord = (count) => {
  return count === 1 ? 'bottle' : 'bottles';
};

const verse = (count) => {
  const currentWord = numberWords[count];
  const nextCount = count - 1;
  const nextWord = numberWords[nextCount];
  
  return [
    `${capitalize(currentWord)} green ${bottlesWord(count)} hanging on the wall,`,
    `${capitalize(currentWord)} green ${bottlesWord(count)} hanging on the wall,`,
    'And if one green bottle should accidentally fall,',
    `There'll be ${nextWord} green ${bottlesWord(nextCount)} hanging on the wall.`
  ];
};

export const recite = (initialBottlesCount, takeDownCount) => {
  let result = [];
  
  for (let i = 0; i < takeDownCount; i++) {
    const currentCount = initialBottlesCount - i;
    if (i > 0) {
      result.push('');
    }
    result = result.concat(verse(currentCount));
  }
  
  return result;
};
