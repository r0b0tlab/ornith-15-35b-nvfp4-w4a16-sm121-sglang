```python
from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def from_pov(self, from_node):
        # Find the node with the matching label
        node = self._find_node(from_node)
        if node is None:
            raise ValueError("Tree: could not find node named " + str(from_node))
        
        # Build a new tree with from_node as root by reparenting
        return self._reparent(from_node)

    def _find_node(self, target_label):
        # Depth-first search to find a node by label
        if self.label == target_label:
            return self
        for child in self.children:
            result = child._find_node(target_label)
            if result is not None:
                return result
        return None

    def _reparent(self, from_node):
        # Reparent the tree so from_node becomes the root
        path = self._find_path(from_node, [])
        if path is None:
            raise ValueError("Tree: could not find node named " + str(from_node))
        
        # Build the new tree by walking from root to from_node
        new_tree = Tree(from_node)
        current = new_tree
        for label in path[:-1]:
            new_child = Tree(label)
            current.children.append(new_child)
            current = new_child
        
        return new_tree

    def _find_path(self, target_label, path):
        # Find path from current node to target node
        path = path + [self.label]
        if self.label == target_label:
            return path
        for child in self.children:
            result = child._find_path(target_label, path)
            if result is not None:
                return result
        return None

    def path_to(self, from_node, to_node):
        # Check both nodes exist
        from_nodes = self._find_node(from_node)
        if from_nodes is None:
            raise ValueError("Tree: could not find node named " + str(from_node))
        to_nodes = self._find_node(to_node)
        if to_nodes is None:
            raise ValueError("Tree: could not find node named " + str(to_node))
        
        # Get the reparented tree from from_node's POV
        reparented = self.from_pov(from_node)
        
        # Find path from from_node (now root) to to_node
        path = reparented._find_path(to_node, [])
        if path is None:
            raise ValueError("Tree: no path found")
        
        return path
