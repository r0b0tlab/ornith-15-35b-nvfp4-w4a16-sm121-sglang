```java
import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedList;
import java.util.Map;
import java.util.Queue;
import java.util.Set;

class TwoBucket {
    private final int bucketOneCap;
    private final int bucketTwoCap;
    private final int desiredLiters;
    private final String startBucket;
    private int totalMoves;
    private String finalBucket;
    private int otherBucketLiters;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        this.bucketOneCap = bucketOneCap;
        this.bucketTwoCap = bucketTwoCap;
        this.desiredLiters = desiredLiters;
        this.startBucket = startBucket;

        solve();
    }

    private void solve() {
        // BFS to find the shortest path to the desired state
        Queue<int[]> queue = new LinkedList<>();
        Map<String, Integer> visited = new HashMap<>();
        Map<String, Integer> movesMap = new HashMap<>();
        Map<String, String> cameFrom = new HashMap<>();

        int[] startState;
        if (startBucket.equals("one")) {
            startState = new int[]{0, 0};
        } else {
            startState = new int[]{0, 0};
        }

        // First move is always to fill the start bucket
        int[] firstMove;
        if (startBucket.equals("one")) {
            firstMove = new int[]{bucketOneCap, 0};
        } else {
            firstMove = new int[]{0, bucketTwoCap};
        }

        queue.add(firstMove);
        visited.put(firstMove[0] + "," + firstMove[1], 1);
        movesMap.put(firstMove[0] + "," + firstMove[1], 1);
        cameFrom.put(firstMove[0] + "," + firstMove[1], null);

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int currentMoves = movesMap.get(current[0] + "," + current[1]);

            // Check if we've reached the desired state
            if (current[0] == desiredLiters || current[1] == desiredLiters) {
                totalMoves = currentMoves;
                if (current[0] == desiredLiters) {
                    finalBucket = "one";
                    otherBucketLiters = current[1];
                } else {
                    finalBucket = "two";
                    otherBucketLiters = current[0];
                }
                return;
            }

            // Generate all possible next states
            int[][] nextStates = generateNextStates(current);

            for (int[] next : nextStates) {
                // Skip the forbidden state: start bucket empty and other full
                if (isForbiddenState(next)) {
                    continue;
                }

                String key = next[0] + "," + next[1];
                if (!visited.containsKey(key)) {
                    visited.put(key, 1);
                    movesMap.put(key, currentMoves + 1);
                    cameFrom.put(key, current[0] + "," + current[1]);
                    queue.add(next);
                }
            }
        }
    }

    private int[][] generateNextStates(int[] current) {
        int[][] nextStates = new int[8][];

        // 1. Fill bucket one
        nextStates[0] = new int[]{bucketOneCap, current[1]};
        // 2. Fill bucket two
        nextStates[1] = new int[]{current[0], bucketTwoCap};
        // 3. Empty bucket one
        nextStates[2] = new int[]{0, current[1]};
        // 4. Empty bucket two
        nextStates[3] = new int[]{current[0], 0};
        // 5. Pour bucket one into bucket two
        int pourOneToTwo = Math.min(current[0], bucketTwoCap - current[1]);
        nextStates[4] = new int[]{current[0] - pourOneToTwo, current[1] + pourOneToTwo};
        // 6. Pour bucket two into bucket one
        int pourTwoToOne = Math.min(current[1], bucketOneCap - current[0]);
        nextStates[5] = new int[]{current[0] + pourTwoToOne, current[1] - pourTwoToOne};
        // 7. Empty both (not useful, but included for completeness)
        nextStates[6] = new int[]{0, 0};
        // 8. Fill both (not useful, but included for completeness)
        nextStates[7] = new int[]{bucketOneCap, bucketTwoCap};

        return nextStates;
    }

    private boolean isForbiddenState(int[] state) {
        // Forbidden state: start bucket empty and other bucket full
        if (startBucket.equals("one")) {
            return state[0] == 0 && state[1] == bucketTwoCap;
        } else {
            return state[1] == 0 && state[0] == bucketOneCap;
        }
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucketLiters;
    }
}
