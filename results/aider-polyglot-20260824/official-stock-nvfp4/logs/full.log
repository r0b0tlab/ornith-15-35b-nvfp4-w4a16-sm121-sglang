```java
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Comparator;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

class Poker {

    private final List<List<Card>> hands;

    Poker(List<String> hands) {
        this.hands = new ArrayList<>();
        for (String hand : hands) {
            String[] cards = hand.trim().split("\\s+");
            List<Card> parsedHand = new ArrayList<>();
            for (String card : cards) {
                parsedHand.add(new Card(card));
            }
            this.hands.add(parsedHand);
        }
    }

    List<String> getBestHands() {
        int bestScore = Integer.MIN_VALUE;
        List<Integer> bestIndices = new ArrayList<>();

        for (int i = 0; i < hands.size(); i++) {
            int score = evaluateHand(hands.get(i));
            if (score > bestScore) {
                bestScore = score;
                bestIndices.clear();
                bestIndices.add(i);
            } else if (score == bestScore) {
                bestIndices.add(i);
            }
        }

        List<String> result = new ArrayList<>();
        for (int index : bestIndices) {
            result.add(String.join(" ", getHandString(hands.get(index))));
        }
        return result;
    }

    private String getHandString(List<Card> hand) {
        List<String> cards = new ArrayList<>();
        for (Card card : hand) {
            cards.add(card.value + " " + card.suit);
        }
        return String.join(" ", cards);
    }

    private int evaluateHand(List<Card> hand) {
        Map<Integer, Integer> valueCounts = new HashMap<>();
        Set<Character> suits = new HashSet<>();

        for (Card card : hand) {
            valueCounts.merge(card.valueNum, 1, Integer::sum);
            suits.add(card.suit);
        }

        boolean isFlush = suits.size() == 1;

        List<Integer> values = new ArrayList<>();
        for (Card card : hand) {
            values.add(card.valueNum);
        }
        values.sort(Comparator.reverseOrder());

        boolean isStraight = false;
        if (values.size() == 5) {
            boolean straight = true;
            for (int i = 0; i < 4; i++) {
                if (values.get(i) - values.get(i + 1) != 1) {
                    straight = false;
                    break;
                }
            }
            isStraight = straight;

            // Check for A-2-3-4-5 straight (wheel)
            if (!isStraight && values.get(0) == 14 && values.get(1) == 5 
                && values.get(2) == 4 && values.get(3) == 3 && values.get(4) == 2) {
                isStraight = true;
            }
        }

        // Count how many cards of each value we have
        int maxCount = 0;
        Map<Integer, Integer> countsByValue = new HashMap<>();
        for (Map.Entry<Integer, Integer> entry : valueCounts.entrySet()) {
            maxCount = Math.max(maxCount, entry.getValue());
            countsByValue.put(entry.getKey(), entry.getValue());
        }

        if (isStraight && isFlush) {
            // Straight flush - return high card for comparison
            return 800 + (isWheel(values) ? 2 : values.get(0));
        } else if (countsByValue.size() == 2) {
            // Four of a kind
            int fourValue = 0;
            int otherValue = 0;
            for (Map.Entry<Integer, Integer> entry : countsByValue.entrySet()) {
                if (entry.getValue() == 4) {
                    fourValue = entry.getKey();
                } else {
                    otherValue = entry.getKey();
                }
            }
            return 700 + fourValue * 100 + otherValue;
        } else if (countsByValue.size() == 2) {
            // Full house
            int threeValue = 0;
            int twoValue = 0;
            for (Map.Entry<Integer, Integer> entry : countsByValue.entrySet()) {
                if (entry.getValue() == 3) {
                    threeValue = entry.getKey();
                } else {
                    twoValue = entry.getKey();
                }
            }
            return 600 + threeValue * 100 + twoValue;
        } else if (isFlush) {
            // Flush
            return 500 + values.get(0) * 10000 + values.get(1) * 100 + values.get(2);
        } else if (isStraight) {
            // Straight
            return 400 + (isWheel(values) ? 2 : values.get(0));
        } else if (countsByValue.size() == 3) {
            // Three of a kind
            int threeValue = 0;
            int other1 = 0;
            int other2 = 0;
            int index = 0;
            for (Map.Entry<Integer, Integer> entry : countsByValue.entrySet()) {
                if (entry.getValue() == 3) {
                    threeValue = entry.getKey();
                } else if (index == 0) {
                    other1 = entry.getKey();
                } else {
                    other2 = entry.getKey();
                }
                index++;
            }
            return 300 + threeValue * 10000 + other1 * 100 + other2;
        } else if (countsByValue.size() == 4) {
            // One pair
            int pairValue = 0;
            int others = 0;
            int index = 0;
            for (Map.Entry<Integer, Integer> entry : countsByValue.entrySet()) {
                if (entry.getValue() == 2) {
                    pairValue = entry.getKey();
                } else {
                    others = others * 100 + entry.getKey();
                }
                index++;
            }
            return 200 + pairValue * 100000 + others;
        } else {
            // Two pair
            int highPair = 0;
            int lowPair = 0;
            int kicker = 0;
            for (Map.Entry<Integer, Integer> entry : countsByValue.entrySet()) {
                if (entry.getValue() == 2) {
                    if (entry.getKey() > highPair) {
                        lowPair = highPair;
                        highPair = entry.getKey();
                    } else {
                        lowPair = entry.getKey();
                    }
                } else {
                    kicker = entry.getKey();
                }
            }
            return 100 + highPair * 10000 + lowPair * 100 + kicker;
        }
    }

    private boolean isWheel(List<Integer> values) {
        return values.get(0) == 14 && values.get(1) == 5 
            && values.get(2) == 4 && values.get(3) == 3 
            && values.get(4) == 2;
    }

    static class Card {
        final char value;
        final char suit;
        final int valueNum;

        Card(String cardStr) {
            this.value = cardStr.charAt(0);
            this.suit = cardStr.charAt(cardStr.length() - 1);
            this.valueNum = parseValue(this.value);
        }

        private int parseValue(char value) {
            switch (value) {
                case '2': return 2;
                case '3': return 3;
                case '4': return 4;
                case '5': return 5;
                case '6': return 6;
                case '7': return 7;
                case '8': return 8;
                case '9': return 9;
                case 'T': return 10;
                case 'J': return 11;
                case 'Q': return 12;
                case 'K': return 13;
                case 'A': return 14;
                default: throw new IllegalArgumentException("Invalid card value: " + value);
            }
        }
    }
}
