        // 4. Empty bucket two
        nextStates[3] = new int[]{current[0], 0};
        // 5. Pour bucket one into bucket two
        int pourOneToTwo = Math.min(current[0], bucketTwoCap - current[1]);
        nextStates[4] = new int[]{current[0] - pourOneToTwo, current[1] + pourOneToTwo};
        // 6. Pour bucket two into bucket one
        int pourTwoToOne = Math.min(current[1], bucketOneCap - current[0]);
        nextStates[5] = new int[]{current[0] + pourTwoToOne, current[1] - pourTwoToOne};

        return nextStates;
    }

    private boolean isForbiddenState(int[] state) {
        // Forbidden state: start bucket empty and other bucket full
        if (startBucket.equals("one")) {
            return state[0] == 0 && state[1] == bucketTwoCap;
        } else {
            return state[1] == 0 && state[0] == bucketOneCap;
        }
    }

