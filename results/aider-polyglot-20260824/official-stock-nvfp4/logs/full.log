- Expected return is a string like `"iliad.txt:Of Atreus, Agamemnon, King of men.\n"`

I need to rewrite the function to:
1. Parse flags from a space-separated string
2. Return a single string with results joined by newlines

grep.py
```python
def grep(pattern, flags, files):
    # Parse flags from space-separated string
    flag_list = flags.split() if flags else []
    print_line_numbers = '-n' in flag_list
    only_file_names = '-l' in flag_list
    case_insensitive = '-i' in flag_list
    invert_match = '-v' in flag_list
    match_entire_line = '-x' in flag_list
    
    results = []
    
    # If multiple files, prepend filename to each matching line
    multiple_files = len(files) > 1
    
    for filename in files:
        with open(filename, 'r') as file:
            for line_number, line in enumerate(file, 1):
                line = line.rstrip('\n')  # Remove trailing newline
                
                # Prepare string for comparison based on case sensitivity
                search_line = line if not case_insensitive else line.lower()
                search_pattern = pattern if not case_insensitive else pattern.lower()
                
                # Check if line matches pattern
                if match_entire_line:
                    matches = search_line == search_pattern
                else:
                    matches = search_pattern in search_line
                
                # Handle inverted match
                if invert_match:
                    matches = not matches
                
                if matches:
                    if only_file_names:
                        # Only add filename once and move to next file
                        results.append(filename)
                        break
                    else:
                        # Build the result line
                        result_line = ""
                        
                        # Prepend filename if multiple files
                        if multiple_files:
                            result_line += filename + ":"
                        
                        # Prepend line number if requested
                        if print_line_numbers:
                            result_line += str(line_number) + ":"
                        
                        # Add the line content
                        result_line += line
                        
                        results.append(result_line)
    
    # Join results with newlines and add trailing newline
    if results:
        return '\n'.join(results) + '\n'
    else:
        return ''
