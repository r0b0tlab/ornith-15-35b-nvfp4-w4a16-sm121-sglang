PythagoreanTriplet.java
```java
import java.util.List;
import java.util.ArrayList;

class PythagoreanTriplet {

    private final int a;
    private final int b;
    private final int c;

    PythagoreanTriplet(int a, int b, int c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    int a() {
        return a;
    }

    int b() {
        return b;
    }

    int c() {
        return c;
    }

    static TripletListBuilder makeTripletsList() {
        return new TripletListBuilder();
    }

    static class TripletListBuilder {

        private int sum;
        private int maxFactor = Integer.MAX_VALUE;

        TripletListBuilder thatSumTo(int sum) {
            this.sum = sum;
            return this;
        }

        TripletListBuilder withFactorsLessThanOrEqualTo(int maxFactor) {
            this.maxFactor = maxFactor;
            return this;
        }

        List<PythagoreanTriplet> build() {
            List<PythagoreanTriplet> triplets = new ArrayList<>();

            // a + b + c = sum
            // a^2 + b^2 = c^2
            // From the first equation: c = sum - a - b
            // Substituting into the second equation:
            // a^2 + b^2 = (sum - a - b)^2
            // a^2 + b^2 = sum^2 + a^2 + b^2 - 2*sum*a - 2*sum*b + 2*a*b
            // 0 = sum^2 - 2*sum*a - 2*sum*b + 2*a*b
            // 2*sum*b - 2*a*b = sum^2 - 2*sum*a
            // b*(2*sum - 2*a) = sum^2 - 2*sum*a
            // b = (sum^2 - 2*sum*a) / (2*sum - 2*a)
            // b = (sum^2 - 2*sum*a) / (2*(sum - a))

            for (int a = 1; a < maxFactor; a++) {
                // Since a < b < c, a must be less than sum/3
                if (a >= sum / 3) {
                    break;
                }

                int numerator = sum * sum - 2 * sum * a;
                int denominator = 2 * (sum - a);

                if (denominator <= 0) {
                    break;
                }

                if (numerator % denominator == 0) {
                    int b = numerator / denominator;
                    int c = sum - a - b;

                    // Check that a < b < c and c is within the factor limit
                    if (a < b && b < c && c <= maxFactor) {
                        triplets.add(new PythagoreanTriplet(a, b, c));
                    }
                }
            }

            return triplets;
        }

    }
}
