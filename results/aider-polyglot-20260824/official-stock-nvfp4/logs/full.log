                self.list.tail = new_node;
            } else {
                // Insert after the current node.
                let current = self.node;
                let old_next = (*current).next;

                (*new_node).prev = current;
                (*new_node).next = old_next;

                if !old_next.is_null() {
                    (*old_next).prev = new_node;
                } else {
                    // Inserting at the back.
                    self.list.tail = new_node;
                }

                (*current).next = new_node;
            }

            self.list.len += 1;
        }

        // Update the cursor to point at the newly inserted node.
        self.node = new_node;
    }

    pub fn insert_before(&mut self, element: T) {
        let new_node = Box::into_raw(Node::new(element));

        unsafe {
            if self.node.is_null() {
                // Insert into an empty list; new node becomes both head and tail.
                self.list.head = new_node;
                self.list.tail = new_node;
            } else {
                // Insert before the current node.
                let current = self.node;
                let old_prev = (*current).prev;

                (*new_node).prev = old_prev;
                (*new_node).next = current;

                if !old_prev.is_null() {
                    (*old_prev).next = new_node;
                } else {
                    // Inserting at the front.
                    self.list.head = new_node;
                }

                (*current).prev = new_node;
            }

            self.list.len += 1;
        }

        // Update the cursor to point at the newly inserted node.
        self.node = new_node;
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        if self.current.is_null() || self.len == 0 {
            return None;
        }

        let node = unsafe { &*self.current };
        self.current = node.next;
        self.len -= 1;

        Some(&node.data)
    }
}

impl<T> Drop for LinkedList<T> {
    fn drop(&mut self) {
        let mut current = self.head;

        while !current.is_null() {
            unsafe {
                let node = Box::from_raw(current);
                current = node.next;
                // The node is dropped here, which also drops its data.
            }
        }

        self.head = ptr::null_mut();
        self.tail = ptr::null_mut();
        self.len = 0;
    }
}

#[cfg(feature = "advanced")]
unsafe impl<T> Send for LinkedList<T> {}

#[cfg(feature = "advanced")]
unsafe impl<T> Sync for LinkedList<T> {}
