```javascript
//
// This is only a SKELETON file for the 'OCR Numbers' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const convert = (input) => {
  // Split input into lines
  const lines = input.split('\n');

  // Check if the number of lines is a multiple of 4
  if (lines.length % 4 !== 0) {
    throw new Error('Number of input lines must be a multiple of 4');
  }

  // Check if all lines have the same length and it's a multiple of 3
  const lineLength = lines[0].length;
  if (lineLength % 3 !== 0) {
    throw new Error('Number of input columns must be a multiple of 3');
  }

  for (const line of lines) {
    if (line.length !== lineLength) {
      throw new Error('All input lines must have the same length');
    }
  }

  const result = [];

  // Process each group of 4 lines
  for (let lineStart = 0; lineStart < lines.length; lineStart += 4) {
    let lineNumber = '';

    // Process each group of 3 columns
    for (let colStart = 0; colStart < lineLength; colStart += 3) {
      // Extract the 3x4 grid for this digit
      const digit = [
        lines[lineStart].substring(colStart, colStart + 3),
        lines[lineStart + 1].substring(colStart, colStart + 3),
        lines[lineStart + 2].substring(colStart, colStart + 3),
        lines[lineStart + 3].substring(colStart, colStart + 3)
      ];

      lineNumber += identifyDigit(digit);
    }

    result.push(lineNumber);
  }

  return result.join(',');
};

// Identify a single digit from its 3x4 grid representation
const identifyDigit = (digit) => {
  const digitPatterns = {
    ' _ | ||_|   ': '0',
    '     |  |   ': '1',
    ' _  _||_    ': '2',
    ' _  _|_|    ': '3',
    ' |_|  | |   ': '4',
    ' |_  _|    ': '5',
    ' |_  |_|    ': '6',
    ' _   |  |   ': '7',
    ' |_  |_|    ': '8',
    ' |_  _||    ': '9'
  };

  const digitKey = digit.join(' ');

  return digitPatterns[digitKey] || '?';
};
```
