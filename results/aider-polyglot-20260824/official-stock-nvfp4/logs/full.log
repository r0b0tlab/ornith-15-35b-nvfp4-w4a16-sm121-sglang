        }
    }
    
    fn max_pins_for_current_roll(&self) -> Option<u16> {
        let mut index = 0;
        let mut frame = 0;
        
        // Skip completed frames to find current roll
        while frame < 9 {
            if index >= self.rolls.len() {
                // This is the first roll of a frame
                return Some(10);
            }
            
            if self.rolls[index] == 10 {
                // Strike, frame complete, move to next
                index += 1;
            } else {
                if index + 1 >= self.rolls.len() {
                    // First roll done, checking second roll
                    return Some(10 - self.rolls[index]);
                }
                // Frame complete
                index += 2;
            }
            frame += 1;
        }
        
        // At 10th frame
        if index >= self.rolls.len() {
            // First roll of 10th frame
            return Some(10);
        }
        
        let first = self.rolls[index];
        
        if first == 10 {
            // Strike in 10th
            if index + 1 >= self.rolls.len() {
                // Second roll (fill ball), can be up to 10
                return Some(10);
            }
            let second = self.rolls[index + 1];
            if second == 10 {
                // Two strikes, third roll (fill ball)
                return Some(10);
            } else {
                // Second roll after strike, can knock down remaining
                Some(10 - second)
            }
        } else {
            // Not a strike in 10th
            if index + 1 >= self.rolls.len() {
                // Second roll, can knock down remaining
                Some(10 - first)
            } else {
                let second = self.rolls[index + 1];
                if first + second >= 10 {
                    // Spare, fill ball
                    return Some(10);
                } else {
                    // Open frame, no more rolls
                    return None;
                }
            }
        }
    }
}
