export class Forth {
  constructor() {
    this._stack = [];
    this.definitions = {};
  }

  evaluate(input) {
    const tokens = this.tokenize(input);
    
    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i];
      
      // Handle word definitions
      if (token === ':') {
        let defIndex = i + 1;
        const wordName = tokens[defIndex];
        
        // Check if the word being defined is a number
        if (this.isNumber(wordName)) {
          throw Error('invalid syntax');
        }
        
        const lowerName = wordName.toLowerCase();
        defIndex++;
        
        // Collect definition tokens until ';'
        const defTokens = [];
        while (defIndex < tokens.length && tokens[defIndex] !== ';') {
          defTokens.push(tokens[defIndex]);
          defIndex++;
        }
        
        // Ensure we found the closing ';'
        if (defIndex >= tokens.length) {
          throw Error('invalid definition');
        }
        
        // Expand any previously defined words in the definition
        const expandedDef = [];
        for (const t of defTokens) {
          const lowerT = t.toLowerCase();
          if (this.definitions[lowerT]) {
            expandedDef.push(...this.definitions[lowerT]);
          } else {
            expandedDef.push(t);
          }
        }
        
        // Store the definition
        this.definitions[lowerName] = expandedDef;
        i = defIndex; // Skip past the ';'
        continue;
      }
      
      // Process regular tokens
      this.processToken(token);
    }
    
    return this._stack;
  }

  processToken(token) {
    const lowerToken = token.toLowerCase();
    
    // Check if it's a user-defined word
    if (this.definitions[lowerToken]) {
      for (const defToken of this.definitions[lowerToken]) {
        this.processToken(defToken);
      }
      return;
    }
    
    // Check if it's a number
    if (this.isNumber(token)) {
      this._stack.push(parseInt(token, 10));
      return;
    }
    
    // Process built-in words
    switch (lowerToken) {
      case '+':
        this.arithmeticOp((a, b) => a + b, 'stack underflow');
        break;
      case '-':
        this.arithmeticOp((a, b) => b - a, 'stack underflow');
        break;
      case '*':
        this.arithmeticOp((a, b) => a * b, 'stack underflow');
        break;
      case '/':
        this.arithmeticOp((a, b) => {
          if (b === 0) {
            throw Error('divide by zero');
          }
          return Math.trunc(b / a);
        }, 'stack underflow');
        break;
      case 'dup':
        this.dupOp();
        break;
      case 'drop':
        this.dropOp();
        break;
      case 'swap':
        this.swapOp();
        break;
      case 'over':
        this.overOp();
        break;
      default:
        throw Error(`unknown word`);
    }
  }

  arithmeticOp(operation, error) {
    if (this._stack.length < 2) {
      throw Error(error);
    }
    const b = this._stack.pop();
    const a = this._stack.pop();
    this._stack.push(operation(a, b));
  }

  dupOp() {
    if (this._stack.length < 1) {
      throw Error('stack underflow');
    }
    const a = this._stack.pop();
    this._stack.push(a, a);
  }

  dropOp() {
    if (this._stack.length < 1) {
      throw Error('stack underflow');
    }
    this._stack.pop();
  }

  swapOp() {
    if (this._stack.length < 2) {
      throw Error('stack underflow');
    }
    const a = this._stack.pop();
    const b = this._stack.pop();
    this._stack.push(a, b);
  }

  overOp() {
    if (this._stack.length < 2) {
      throw Error('stack underflow');
    }
    const a = this._stack.pop();
    const b = this._stack.pop();
    this._stack.push(b, a, b);
  }

  tokenize(input) {
    // Split on whitespace but keep punctuation attached to words
    const tokens = input.match(/(\s+)|(\S+)/g) || [];
    return tokens.filter(token => !token.match(/^\s+$/));
  }

  isNumber(token) {
    return /^-?\d+$/.test(token);
  }

  get stack() {
    return this._stack;
  }
}
