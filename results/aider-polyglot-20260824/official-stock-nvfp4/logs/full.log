I'll implement the Hangman game logic. The class needs to track the secret word, remaining guesses (8 wrong guesses allowed), masked word state, and game status. I'll complete the `guess()`, `get_masked_word()`, and `get_status()` methods.

hangman.py
```python
# Game status categories
# Change the values as you see fit
STATUS_WIN = 'win'
STATUS_LOSE = 'lose'
STATUS_ONGOING = 'ongoing'


class Hangman:
    def __init__(self, word):
        self.word = word
        self.remaining_guesses = 8
        self.status = STATUS_ONGOING
        self.guessed_chars = set()

    def guess(self, char):
        if self.status != STATUS_ONGOING:
            raise ValueError("The game has already ended.")

        if char in self.guessed_chars:
            if char in self.word:
                # Already correctly guessed, still valid but no penalty
                pass
            else:
                # Already wrongly guessed, counts as a wrong guess
                self.remaining_guesses -= 1
        else:
            self.guessed_chars.add(char)
            if char not in self.word:
                self.remaining_guesses -= 1

        # Check game status after processing the guess
        if all(c in self.guessed_chars for c in self.word):
            self.status = STATUS_WIN
        elif self.remaining_guesses < 0:
            self.status = STATUS_LOSE

    def get_masked_word(self):
        return ''.join(c if c in self.guessed_chars else '_' for c in self.word)

    def get_status(self):
        return self.status
