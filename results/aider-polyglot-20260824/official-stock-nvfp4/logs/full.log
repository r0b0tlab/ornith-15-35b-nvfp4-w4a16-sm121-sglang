def recite(start_verse, end_verse):
    animals = [
        "fly",
        "spider",
        "bird",
        "cat",
        "dog",
        "goat",
        "cow",
        "horse",
    ]
    
    animal_lines = {
        "fly": "",
        "spider": "It wriggled and jiggled and tickled inside her.",
        "bird": "How absurd to swallow a bird!",
        "cat": "Imagine that, to swallow a cat!",
        "dog": "What a hog, to swallow a dog!",
        "goat": "Just opened her throat and swallowed a goat!",
        "cow": "I don't know how she swallowed a cow!",
        "horse": "She's dead, of course!",
    }
    
    lines_list = []
    
    for verse_number in range(start_verse, end_verse + 1):
        if verse_number > start_verse:
            lines_list.append("")
        
        animal = animals[verse_number - 1]
        
        # First line
        lines_list.append(f"I know an old lady who swallowed a {animal}.")
        
        # Second line (animal-specific reaction)
        if animal_lines[animal]:
            lines_list.append(animal_lines[animal])
        
        # Special case for horse
        if animal == "horse":
            break
        
        # Cumulative swallowing lines
        for i in range(verse_number - 1, 0, -1):
            lines_list.append(
                f"She swallowed the {animals[i]} to catch {prey_text(animals[i-1])}."
            )
        
        # Final line for fly and other animals (except horse)
        if animal != "fly":
            lines_list.append("I don't know why she swallowed the fly. Perhaps she'll die.")
    
    return lines_list


def prey_text(animal):
    if animal == "spider":
        return "the spider that wriggled and jiggled and tickled inside her"
    return f"the {animal}"
```
