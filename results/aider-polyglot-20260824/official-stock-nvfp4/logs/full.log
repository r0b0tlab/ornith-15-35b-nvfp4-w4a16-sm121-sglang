I'll solve the Zebra Puzzle by implementing a constraint satisfaction solver that uses backtracking search to find the valid arrangement of houses.

Here's my approach:
1. Define all the attributes (colors, nationalities, pets, beverages, hobbies)
2. Use permutations to generate possible arrangements
3. Apply the 15 constraints to filter valid solutions
4. Return the water drinker and zebra owner

zebra-puzzle.js
```javascript
//
// This is only a SKELETON file for the 'Zebra Puzzle' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ZebraPuzzle {
  constructor() {
    // Define all possible values for each attribute
    this.colors = ['red', 'green', 'ivory', 'yellow', 'blue'];
    this.nationalities = ['Englishman', 'Spaniard', 'Ukrainian', 'Norwegian', 'Japanese'];
    this.pets = ['dog', 'snail', 'fox', 'horse', 'zebra'];
    this.beverages = ['coffee', 'tea', 'milk', 'orangeJuice', 'water'];
    this.hobbies = ['dancing', 'painter', 'reading', 'football', 'chess'];

    // Solve the puzzle once during construction
    this.solution = this.solve();
  }

  // Generate all permutations of an array
  getPermutations(array) {
    if (array.length <= 1) {
      return [array];
    }

    const result = [];
    for (let i = 0; i < array.length; i++) {
      const current = array[i];
      const remaining = array.slice(0, i).concat(array.slice(i + 1));
      const remainingPermutations = this.getPermutations(remaining);
      for (const permutation of remainingPermutations) {
        result.push([current, ...permutation]);
      }
    }
    return result;
  }

  // Check if a house arrangement satisfies all constraints
  satisfiesConstraints(assignment) {
    const { colors, nationalities, pets, beverages, hobbies } = assignment;

    // Helper to find index of a value in an array
    const indexOf = (arr, value) => arr.indexOf(value);

    // Constraint 2: The Englishman lives in the red house
    if (indexOf(nationalities, 'Englishman') !== indexOf(colors, 'red')) return false;

    // Constraint 3: The Spaniard owns the dog
    if (indexOf(nationalities, 'Spaniard') !== indexOf(pets, 'dog')) return false;

    // Constraint 4: The person in the green house drinks coffee
    if (indexOf(colors, 'green') !== indexOf(beverages, 'coffee')) return false;

    // Constraint 5: The Ukrainian drinks tea
    if (indexOf(nationalities, 'Ukrainian') !== indexOf(beverages, 'tea')) return false;

    // Constraint 6: The green house is immediately to the right of the ivory house
    if (indexOf(colors, 'green') !== indexOf(colors, 'ivory') + 1) return false;

    // Constraint 7: The snail owner likes to go dancing
    if (indexOf(pets, 'snail') !== indexOf(hobbies, 'dancing')) return false;

    // Constraint 8: The person in the yellow house is a painter
    if (indexOf(colors, 'yellow') !== indexOf(hobbies, 'painter')) return false;

    // Constraint 9: The person in the middle house drinks milk
    if (beverages[2] !== 'milk') return false;

    // Constraint 10: The Norwegian lives in the first house
    if (nationalities[0] !== 'Norwegian') return false;

    // Constraint 11: The person who enjoys reading lives next to the person with the fox
    if (Math.abs(indexOf(hobbies, 'reading') - indexOf(pets, 'fox')) !== 1) return false;

    // Constraint 12: The painter's house is next to the house with the horse
    if (Math.abs(indexOf(hobbies, 'painter') - indexOf(pets, 'horse')) !== 1) return false;

    // Constraint 13: The person who plays football drinks orange juice
    if (indexOf(hobbies, 'football') !== indexOf(beverages, 'orangeJuice')) return false;

    // Constraint 14: The Japanese person plays chess
    if (indexOf(nationalities, 'Japanese') !== indexOf(hobbies, 'chess')) return false;

    // Constraint 15: The Norwegian lives next to the blue house
    if (Math.abs(0 - indexOf(colors, 'blue')) !== 1) return false;

    return true;
  }

  // Solve the puzzle using backtracking
  solve() {
    const permutations = this.getPermutations;

    // Generate all possible color arrangements
    const colorPermutations = permutations(this.colors);

    for (const colors of colorPermutations) {
      // Early pruning: Check constraint 6 (green right of ivory) and 15 (Norwegian next to blue)
      if (this.checkBasicConstraints(colors)) {
        // Generate all possible nationality arrangements
        for (const nationalities of permutations(this.nationalities)) {
          // Early pruning: Check constraint 10 (Norwegian in first house)
          if (nationalities[0] !== 'Norwegian') continue;

          // Generate all possible beverage arrangements
          for (const beverages of permutations(this.beverages)) {
            // Early pruning: Check constraint 9 (milk in middle)
            if (beverages[2] !== 'milk') continue;

            // Generate all possible pet arrangements
            for (const pets of permutations(this.pets)) {
              // Generate all possible hobby arrangements
              for (const hobbies of permutations(this.hobbies)) {
                const assignment = { colors, nationalities, pets, beverages, hobbies };

                // Check if this assignment satisfies all constraints
                if (this.satisfiesConstraints(assignment)) {
                  return assignment;
                }
              }
            }
          }
        }
      }
    }

    return null; // No solution found
  }

  // Basic constraint checking for early pruning
  checkBasicConstraints(colors) {
    // Constraint 6: green house immediately right of ivory house
    if (colors.indexOf('green') !== colors.indexOf('ivory') + 1) return false;
    return true;
  }

  waterDrinker() {
    const { beverages, nationalities } = this.solution;
    const waterIndex = beverages.indexOf('water');
    return nationalities[waterIndex];
  }

  zebraOwner() {
    const { pets, nationalities } = this.solution;
    const zebraIndex = pets.indexOf('zebra');
    return nationalities[zebraIndex];
  }
}
