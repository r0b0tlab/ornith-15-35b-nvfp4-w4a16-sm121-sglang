```rust
pub fn lowest_price(books: &[u32]) -> u32 {
    // Count occurrences of each book (books are 1-5)
    let mut counts = [0u32; 5];
    for &book in books {
        assert!(book >= 1 && book <= 5, "Book must be between 1 and 5");
        counts[(book - 1) as usize] += 1;
    }

    // Sort counts in descending order
    let mut counts: Vec<u32> = counts.into_iter().collect();
    counts.sort();
    counts.reverse();

    // Base price per book
    const PRICE: u32 = 800; // $8.00 in cents to avoid floating point

    // Discount percentages for sets of size 1-5
    const DISCOUNT: [u32; 5] = [0, 5, 10, 20, 25]; // percentages

    // Calculate the cost of a set of `size` different books
    let set_cost = |size: usize| -> u32 {
        let base = size as u32 * PRICE;
        let discount = DISCOUNT[size - 1];
        // Apply discount: base * (100 - discount) / 100
        base * (100 - discount) / 100
    };

    // Greedily build sets, but track the number of (5-set) and (3-set) pairs
    // to apply the correction that (4,4) is cheaper than (5,3).
    let mut num_sets = [0u32; 6]; // count of sets of each size 1-5

    while counts.iter().any(|&c| c > 0) {
        // Find the largest set we can form
        let mut set_size = 0;
        for i in 0..counts.len() {
            if counts[i] > 0 {
                set_size += 1;
            }
        }
        
        // Decrement counts for the books in this set
        let mut changed = 0;
        for i in 0..counts.len() {
            if changed < set_size && counts[i] > 0 {
                counts[i] -= 1;
                changed += 1;
            }
        }
        
        num_sets[set_size] += 1;
    }

    // Apply correction: every pair of (5-set, 3-set) should become (4-set, 4-set)
    // because 2×(4 books at 20% off) < (5 books at 25% off) + (3 books at 10% off)
    let corrections = num_sets[5].min(num_sets[3]);
    num_sets[5] -= corrections;
    num_sets[3] -= corrections;
    num_sets[4] += 2 * corrections;

    // Calculate total price
    let mut total = 0u32;
    for size in 1..=5 {
        total += num_sets[size] * set_cost(size);
    }

    total
}
