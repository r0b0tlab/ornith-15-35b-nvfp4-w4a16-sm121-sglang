use anyhow::Error;

/// While using `&[&str]` to handle flags is convenient for exercise purposes,
/// and resembles the output of [`std::env::args`], in real-world projects it is
/// both more convenient and more idiomatic to contain runtime configuration in
/// a dedicated struct. Therefore, we suggest that you do so in this exercise.
///
/// [`std::env::args`]: https://doc.rust-lang.org/std/env/fn.args.html
#[derive(Debug)]
pub struct Flags {
    numbered: bool,
    files_with_matches: bool,
    case_insensitive: bool,
    invert_match: bool,
    full_line_match: bool,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut result = Flags {
            numbered: false,
            files_with_matches: false,
            case_insensitive: false,
            invert_match: false,
            full_line_match: false,
        };
        for flag in flags {
            match *flag {
                "-n" => result.numbered = true,
                "-l" => result.files_with_matches = true,
                "-i" => result.case_insensitive = true,
                "-v" => result.invert_match = true,
                "-x" => result.full_line_match = true,
                _ => {}
            }
        }
        result
    }

    pub fn is_numbered(&self) -> bool {
        self.numbered
    }

    pub fn is_files_with_matches(&self) -> bool {
        self.files_with_matches
    }

    pub fn is_case_insensitive(&self) -> bool {
        self.case_insensitive
    }

    pub fn is_invert_match(&self) -> bool {
        self.invert_match
    }

    pub fn is_full_line_match(&self) -> bool {
        self.full_line_match
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();
    let num_files = files.len();

    for file in files {
        let content = std::fs::read_to_string(file)?;
        let mut file_matched = false;

        for (index, line) in content.lines().enumerate() {
            let line_number = index + 1;
            let matches = if flags.is_case_insensitive() {
                if flags.is_full_line_match() {
                    line.eq_ignore_ascii_case(pattern)
                } else {
                    line.to_lowercase().contains(&pattern.to_lowercase())
                }
            } else {
                if flags.is_full_line_match() {
                    line == pattern
                } else {
                    line.contains(pattern)
                }
            };

            let matched = if flags.is_invert_match() {
                !matches
            } else {
                matches
            };

            if matched {
                file_matched = true;

                if flags.is_files_with_matches() {
                    break;
                }

                let mut output_line = String::new();

                if num_files > 1 {
                    output_line.push_str(file);
                    output_line.push(':');
                }

                if flags.is_numbered() {
                    output_line.push_str(&line_number.to_string());
                    output_line.push(':');
                }

                output_line.push_str(line);

                results.push(output_line);
            }
        }

        if file_matched && flags.is_files_with_matches() {
            results.push((*file).to_string());
        }
    }

    Ok(results)
}
