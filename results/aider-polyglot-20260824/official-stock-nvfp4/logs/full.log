```java
import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;
import java.util.function.Consumer;
import java.util.function.Function;

public class React {

    public static class Cell<T> {
        public T getValue() {
            throw new UnsupportedOperationException("Please implement the Cell.getValue() method");
        }
    }

    public static class InputCell<T> extends Cell<T> {
        private T value;
        private final List<ComputeCell<T>> dependents = new ArrayList<>();

        @Override
        public T getValue() {
            return value;
        }

        public void setValue(T newValue) {
            if (value != null && value.equals(newValue)) {
                return;
            }
            if (value == null && newValue == null) {
                return;
            }

            value = newValue;

            // Collect all affected compute cells via BFS
            List<ComputeCell<T>> affected = new ArrayList<>();
            Map<ComputeCell<T>, List<ComputeCell<T>>> toProcess = new HashMap<>();
            
            Queue<ComputeCell<T>> queue = new LinkedList<>();
            for (ComputeCell<T> dependent : dependents) {
                queue.add(dependent);
            }
            
            while (!queue.isEmpty()) {
                ComputeCell<T> cell = queue.poll();
                if (!affected.contains(cell)) {
                    affected.add(cell);
                    for (ComputeCell<T> dependent : cell.dependents) {
                        if (!affected.contains(dependent)) {
                            queue.add(dependent);
                        }
                    }
                }
            }

            // Update all affected cells and trigger callbacks
            for (ComputeCell<T> cell : affected) {
                T oldValue = cell.getValue();
                cell.updateValue();
                T newValue = cell.getValue();
                if (oldValue == null ? newValue != null : !oldValue.equals(newValue)) {
                    cell.fireCallbacks(oldValue, newValue);
                }
            }
        }

        void registerDependent(ComputeCell<T> cell) {
            dependents.add(cell);
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private final Function<List<T>, T> function;
        private final List<Cell<T>> cells;
        private final List<Consumer<T>> callbacks = new ArrayList<>();
        private final List<ComputeCell<T>> dependents = new ArrayList<>();
        private T value;

        public ComputeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
            this.function = function;
            this.cells = cells;
            for (Cell<T> cell : cells) {
                if (cell instanceof InputCell<T>) {
                    ((InputCell<T>) cell).registerDependent(this);
                }
            }
            this.value = computeValue();
        }

        @Override
        public T getValue() {
            return value;
        }

        public void addCallback(Consumer<T> callback) {
            callbacks.add(callback);
        }

        public void removeCallback(Consumer<T> callback) {
            callbacks.remove(callback);
        }

        void registerDependent(ComputeCell<T> cell) {
            dependents.add(cell);
        }

        void updateValue() {
            value = computeValue();
        }

        void fireCallbacks(T oldValue, T newValue) {
            for (Consumer<T> callback : callbacks) {
                callback.accept(newValue);
            }
        }

        private T computeValue() {
            List<T> inputValues = new ArrayList<>();
            for (Cell<T> cell : cells) {
                inputValues.add(cell.getValue());
            }
            return function.apply(inputValues);
        }
    }

    public static <T> InputCell<T> inputCell(T initialValue) {
        return new InputCell<T>(initialValue);
    }

    public static <T> ComputeCell<T> computeCell(Function<List<T>, T> function, List<Cell<T>> cells) {
        return new ComputeCell<T>(function, cells);
    }
}
