package scale

// sharpScales is the default chromatic scale using sharps.
var sharpScales = []string{"A", "A♯", "B", "C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯"}

// flatScales is the chromatic scale using flats, used for certain tonics.
var flatScales = []string{"A", "B♭", "B", "C", "D♭", "D", "E♭", "E", "F", "G♭", "G", "A♭"}

// flatTonics are the tonics that use flats (case-insensitive).
var flatTonics = map[string]bool{
	"F":      true,
	"B♭":     true,
	"E♭":     true,
	"A♭":     true,
	"D♭":     true,
	"G♭":     true,
	"d":      true,
	"g":      true,
	"c":      true,
	"f":      true,
	"b♭":     true,
	"e♭":     true,
}

func Scale(tonic, interval string) []string {
	// Normalize the tonic: uppercase first letter, keep the rest as-is.
	tonicNormalized := normalizeTonic(tonic)

	// Determine which base scale to use.
	var baseScale []string
	if flatTonics[tonicNormalized] {
		baseScale = flatScales
	} else {
		baseScale = sharpScales
	}

	// If no intervals specified, return the full chromatic scale.
	if interval == "" {
		return baseScale
	}

	// Find the starting index based on the normalized tonic.
	startIndex := -1
	for i, note := range baseScale {
		if note == tonicNormalized {
			startIndex = i
			break
		}
	}

	// If tonic not found in the base scale, return empty.
	if startIndex == -1 {
		return []string{}
	}

	// Build the scale using the interval pattern.
	result := []string{}
	result = append(result, baseScale[startIndex])

	currentIndex := startIndex
	for _, interval := range interval {
		switch interval {
		case 'M': // Whole step: skip 2 notes
			currentIndex = (currentIndex + 2) % 12
		case 'm': // Half step: skip 1 note
			currentIndex = (currentIndex + 1) % 12
		case 'A': // Augmented second: skip 3 notes
			currentIndex = (currentIndex + 3) % 12
		default:
			// Skip invalid intervals
			continue
		}
		result = append(result, baseScale[currentIndex])
	}

	return result
}

// normalizeTonic converts the tonic to its normalized form.
// The first letter is uppercased, and any accidental is preserved.
func normalizeTonic(tonic string) string {
	if len(tonic) == 0 {
		return tonic
	}

	// Convert the first rune to uppercase.
	runes := []rune(tonic)
	first := runes[0]
	if first >= 'a' && first <= 'z' {
		first = first - 'a' + 'A'
	}
	runes[0] = first

	return string(runes)
}
