I need to fix two issues: using ASCII `#` and `b` instead of unicode symbols, and handling the special C/a case for flat selection.

The main problems are:
1. The scale arrays use unicode `♯` and `♭`, but tests expect `#` and `b`.
2. The `_usesFlats` logic doesn't handle the special case where "C" and "a" use sharps when ascending but flats when descending.

Let me fix both:

scale-generator.js
```
//
// This is only a SKELETON file for the 'Scale Generator' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Scale {
  constructor(tonic) {
    this.tonic = tonic;
  }

  chromatic() {
    const tonicUpper = this.tonic[0].toUpperCase() + this.tonic.slice(1);
    const useFlats = this._usesFlats(tonicUpper);
    const scale = useFlats ? FLAT_SCALE : SHARP_SCALE;
    const tonicIndex = scale.findIndex(note => note.toLowerCase() === tonicUpper.toLowerCase());
    const result = [];
    for (let i = 0; i < 12; i++) {
      result.push(scale[(tonicIndex + i) % 12]);
    }
    return result;
  }

  interval(intervals) {
    const tonicUpper = this.tonic[0].toUpperCase() + this.tonic.slice(1);
    const useFlats = this._usesFlats(tonicUpper);
    const scale = useFlats ? FLAT_SCALE : SHARP_SCALE;
    const tonicIndex = scale.findIndex(note => note.toLowerCase() === tonicUpper.toLowerCase());
    const result = [scale[tonicIndex]];
    let currentIndex = tonicIndex;
    for (let i = 0; i < intervals.length; i++) {
      const interval = intervals[i];
      if (interval === 'm') {
        currentIndex = (currentIndex + 1) % 12;
      } else if (interval === 'M') {
        currentIndex = (currentIndex + 2) % 12;
      } else if (interval === 'A') {
        currentIndex = (currentIndex + 3) % 12;
      }
      result.push(scale[currentIndex]);
    }
    return result;
  }

  _usesFlats(tonicUpper) {
    const flatTonics = [
      'F', 'Bb', 'Eb', 'Ab', 'Db', 'Gb',
      'd', 'g', 'c', 'f', 'bb', 'eb'
    ];
    return flatTonics.includes(tonicUpper);
  }
}

const SHARP_SCALE = ['A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#'];
const FLAT_SCALE = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab'];
```
