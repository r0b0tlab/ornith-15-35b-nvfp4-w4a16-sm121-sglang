You're right, there's a duplicate `From<&str>` implementation. Let me fix that by removing the duplicate:

lib.rs
```rust
pub struct Luhn {
    value: String,
}

impl Luhn {
    pub fn is_valid(&self) -> bool {
        // Remove spaces
        let trimmed: Vec<char> = self.value.chars().filter(|c| *c != ' ').collect();
        
        // Must have more than 1 digit
        if trimmed.len() <= 1 {
            return false;
        }
        
        // All characters must be digits
        if !trimmed.iter().all(|c| c.is_ascii_digit()) {
            return false;
        }
        
        // Apply Luhn algorithm
        let sum: u32 = trimmed
            .iter()
            .rev()
            .enumerate()
            .map(|(i, c)| {
                let mut digit = c.to_digit(10).unwrap();
                if i % 2 == 1 {
                    digit *= 2;
                    if digit > 9 {
                        digit -= 9;
                    }
                }
                digit
            })
            .sum();
        
        sum % 10 == 0
    }
}

impl From<&str> for Luhn {
    fn from(input: &str) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}

impl From<u64> for Luhn {
    fn from(input: u64) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}

impl From<u32> for Luhn {
    fn from(input: u32) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}

impl From<u16> for Luhn {
    fn from(input: u16) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}

impl From<u8> for Luhn {
    fn from(input: u8) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}
