book_store.py
```python
def total(basket):
    # Count the number of copies of each book
    counts = [0] * 5
    for book in basket:
        counts[book - 1] += 1
    
    # Sort in descending order
    counts.sort(reverse=True)
    
    # Calculate the minimum price using a greedy approach
    price = 0
    while any(count > 0 for count in counts):
        # Find the number of different books available
        num_books = sum(1 for count in counts if count > 0)
        
        # Apply the appropriate discount
        discount = {1: 0, 2: 0.05, 3: 0.10, 4: 0.20, 5: 0.25}[num_books]
        
        # Add the discounted price
        price += num_books * 8 * (1 - discount)
        
        # Remove one copy of each available book
        for i in range(len(counts)):
            if counts[i] > 0:
                counts[i] -= 1
    
    return round(price, 2)
