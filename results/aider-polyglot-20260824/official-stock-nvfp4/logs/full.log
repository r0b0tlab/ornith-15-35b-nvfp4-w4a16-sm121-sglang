I'll implement the Pig Latin translation function according to the four rules.

pig_latin.go
```go
package piglatin

import "strings"

func Sentence(sentence string) string {
	words := strings.Split(sentence, " ")
	for i, word := range words {
		words[i] = translateWord(word)
	}
	return strings.Join(words, " ")
}

func isVowel(char byte) bool {
	return char == 'a' || char == 'e' || char == 'i' || char == 'o' || char == 'u'
}

func translateWord(word string) string {
	if len(word) == 0 {
		return word
	}

	// Rule 1: Word begins with a vowel, or starts with "xr" or "yt"
	if isVowel(word[0]) {
		return word + "ay"
	}
	if len(word) >= 2 {
		start := word[:2]
		if start == "xr" || start == "yt" {
			return word + "ay"
		}
	}

	// Rule 3: Word starts with zero or more consonants followed by "qu"
	var i int
	for i < len(word) {
		if word[i] == 'q' && i+1 < len(word) && word[i+1] == 'u' {
			break
		}
		if isVowel(word[i]) {
			break
		}
		i++
	}
	if i < len(word) && word[i] == 'u' && i > 0 {
		// This handles the "qu" case where consonants precede "qu"
		return word[i:] + word[:i] + "ay"
	}

	// Rule 2 & 4: Word begins with consonants
	for i < len(word) {
		if word[i] == 'y' && i > 0 {
			break
		}
		if isVowel(word[i]) {
			break
		}
		i++
	}

	return word[i:] + word[:i] + "ay"
}
```
