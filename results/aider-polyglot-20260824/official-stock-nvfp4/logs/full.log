ZebraPuzzle.java
```java
import java.util.ArrayList;
import java.util.List;

class ZebraPuzzle {
    
    private static final int NUM_HOUSES = 5;
    
    // Constants for house attributes
    private static final int RED = 0;
    private static final int GREEN = 1;
    private static final int IVORY = 2;
    private static final int YELLOW = 3;
    private static final int BLUE = 4;
    
    private static final int ENGLISHMAN = 0;
    private static final int SPANIARD = 1;
    private static final int UKRAINIAN = 2;
    private static final int NORWEGIAN = 3;
    private static final int JAPANESE = 4;
    
    private static final int COFFEE = 0;
    private static final int TEA = 1;
    private static final int MILK = 2;
    private static final int ORANGE_JUICE = 3;
    private static final int WATER = 4;
    
    private static final int DOG = 0;
    private static final int SNAIL = 1;
    private static final int FOX = 2;
    private static final int HORSE = 3;
    private static final int ZEBRA = 4;
    
    private static final int DANCING = 0;
    private static final int PAINTER = 1;
    private static final int READING = 2;
    private static final int FOOTBALL = 3;
    private static final int CHESS = 4;
    
    private int[] colors;
    private int[] nationalities;
    private int[] beverages;
    private int[] pets;
    private int[] hobbies;
    
    String getWaterDrinker() {
        solve();
        for (int i = 0; i < NUM_HOUSES; i++) {
            if (beverages[i] == WATER) {
                return nationalityName(nationalities[i]);
            }
        }
        return "";
    }
    
    String getZebraOwner() {
        solve();
        for (int i = 0; i < NUM_HOUSES; i++) {
            if (pets[i] == ZEBRA) {
                return nationalityName(nationalities[i]);
            }
        }
        return "";
    }
    
    private String nationalityName(int nationality) {
        switch (nationality) {
            case ENGLISHMAN: return "Englishman";
            case SPANIARD: return "Spaniard";
            case UKRAINIAN: return "Ukrainian";
            case NORWEGIAN: return "Norwegian";
            case JAPANESE: return "Japanese";
            default: return "";
        }
    }
    
    private void solve() {
        colors = new int[NUM_HOUSES];
        nationalities = new int[NUM_HOUSES];
        beverages = new int[NUM_HOUSES];
        pets = new int[NUM_HOUSES];
        hobbies = new int[NUM_HOUSES];
        
        int[] colorPerm = {RED, GREEN, IVORY, YELLOW, BLUE};
        for (int[] colorArr : permutations(colorPerm)) {
            colors = colorArr;
            
            // Constraint 6: green house is immediately to the right of ivory house
            if (!satisfiesColorConstraint()) continue;
            
            int[] natPerm = {ENGLISHMAN, SPANIARD, UKRAINIAN, NORWEGIAN, JAPANESE};
            for (int[] natArr : permutations(natPerm)) {
                nationalities = natArr;
                
                // Constraint 2: Englishman lives in red house
                if (!satisfiesNationalityConstraint1()) continue;
                
                // Constraint 10: Norwegian lives in first house
                if (!satisfiesNationalityConstraint2()) continue;
                
                int[] bevPerm = {COFFEE, TEA, MILK, ORANGE_JUICE, WATER};
                for (int[] bevArr : permutations(bevPerm)) {
                    beverages = bevArr;
                    
                    // Constraint 4: green house drinks coffee
                    if (!satisfiesBeverageConstraint1()) continue;
                    
                    // Constraint 5: Ukrainian drinks tea
                    if (!satisfiesBeverageConstraint2()) continue;
                    
                    // Constraint 9: middle house drinks milk
                    if (!satisfiesBeverageConstraint3()) continue;
                    
                    int[] petPerm = {DOG, SNAIL, FOX, HORSE, ZEBRA};
                    for (int[] petArr : permutations(petPerm)) {
                        pets = petArr;
                        
                        // Constraint 3: Spaniard owns dog
                        if (!satisfiesPetConstraint1()) continue;
                        
                        int[] hobbyPerm = {DANCING, PAINTER, READING, FOOTBALL, CHESS};
                        for (int[] hobbyArr : permutations(hobbyPerm)) {
                            hobbies = hobbyArr;
                            
