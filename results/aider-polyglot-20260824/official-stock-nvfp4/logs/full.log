import java.awt.Point;
import java.util.ArrayList;
import java.util.Collections;
import java.util.EnumMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

enum Player {
    BLACK,
    WHITE,
    NONE
}

class GoCounting {

    private final char[][] board;
    private final int width;
    private final int height;

    GoCounting(String board) {
        if (board == null) {
            throw new IllegalArgumentException("Board cannot be null");
        }

        String[] rows = board.split("\n");
        this.height = rows.length;
        this.board = new char[height][];

        for (int i = 0; i < height; i++) {
            if (rows[i] == null) {
                throw new IllegalArgumentException("Board is not rectangular");
            }
            this.board[i] = rows[i].toCharArray();
        }

        this.width = 0;
        for (int i = 0; i < height; i++) {
            if (this.board[i].length != this.width && i > 0) {
                throw new IllegalArgumentException("Board is not rectangular");
            }
            this.width = this.board[i].length;
        }
    }

    Player getTerritoryOwner(int x, int y) {
        validateCoordinate(x, y);

        char cell = board[y][x];
        if (cell != ' ') {
            return null;
        }

        Player owner = findTerritoryOwner(x, y);
        return owner;
    }

    Set<Point> getTerritory(int x, int y) {
        validateCoordinate(x, y);

        char cell = board[y][x];
        if (cell != ' ') {
            return Collections.emptySet();
        }

        return findTerritory(x, y);
    }

    Map<Player, Set<Point>> getTerritories() {
        Map<Player, Set<Point>> territories = new EnumMap<>(Player.class);
        territories.put(Player.BLACK, new HashSet<>());
        territories.put(Player.WHITE, new HashSet<>());
        territories.put(Player.NONE, new HashSet<>());

        boolean[][] visited = new boolean[height][width];

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                if (!visited[y][x] && board[y][x] == ' ') {
                    Set<Point> territory = collectTerritory(x, y, visited);
                    Player owner = territoryOwner(territory);

                    if (owner != null) {
                        territories.get(owner).addAll(territory);
                    } else {
                        territories.get(Player.NONE).addAll(territory);
                    }
                }
            }
        }

        return territories;
    }

    private Set<Point> collectTerritory(int startX, int startY, boolean[][] visited) {
        Set<Point> territory = new HashSet<>();
        List<int[]> stack = new ArrayList<>();
        stack.add(new int[]{startX, startY});

        while (!stack.isEmpty()) {
            int[] current = stack.remove(stack.size() - 1);
            int x = current[0];
            int y = current[1];

            if (x < 0 || x >= width || y < 0 || y >= height) {
                continue;
            }

            if (visited[y][x]) {
                continue;
            }

            if (board[y][x] != ' ') {
                continue;
            }

            visited[y][x] = true;
            territory.add(new Point(x, y));

            stack.add(new int[]{x + 1, y});
            stack.add(new int[]{x - 1, y});
            stack.add(new int[]{x, y + 1});
            stack.add(new int[]{x, y - 1});
        }

        return territory;
    }

    private Player territoryOwner(Set<Point> territory) {
        if (territory.isEmpty()) {
            return null;
        }

        Set<Player> borderingPlayers = new HashSet<>();

        for (Point point : territory) {
            int x = point.x;
            int y = point.y;

            if (x > 0 && board[y][x - 1] == 'B') {
                borderingPlayers.add(Player.BLACK);
            }
            if (x < width - 1 && board[y][x + 1] == 'B') {
                borderingPlayers.add(Player.BLACK);
            }
            if (y > 0 && board[y - 1][x] == 'B') {
                borderingPlayers.add(Player.BLACK);
            }
            if (y < height - 1 && board[y + 1][x] == 'B') {
                borderingPlayers.add(Player.BLACK);
            }

            if (x > 0 && board[y][x - 1] == 'W') {
                borderingPlayers.add(Player.WHITE);
            }
            if (x < width - 1 && board[y][x + 1] == 'W') {
                borderingPlayers.add(Player.WHITE);
            }
            if (y > 0 && board[y - 1][x] == 'W') {
                borderingPlayers.add(Player.WHITE);
            }
            if (y < height - 1 && board[y + 1][x] == 'W') {
                borderingPlayers.add(Player.WHITE);
            }
        }

        if (borderingPlayers.size() == 1) {
            return borderingPlayers.iterator().next();
        }

        return null;
    }

    private Player findTerritoryOwner(int x, int y) {
        Set<Point> territory = findTerritory(x, y);
        return territoryOwner(territory);
    }

    private Set<Point> findTerritory(int x, int y) {
        boolean[][] visited = new boolean[height][width];
        return collectTerritory(x, y, visited);
    }

    private void validateCoordinate(int x, int y) {
        if (x < 0 || x >= width || y < 0 || y >= height) {
            throw new IllegalArgumentException("Invalid coordinate");
        }
    }
}
