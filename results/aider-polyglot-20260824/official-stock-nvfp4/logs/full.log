RestApi.java
```java
import org.json.JSONObject;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class RestApi {
    private final Map<String, User> users;

    RestApi(User... users) {
        this.users = new HashMap<>();
        for (User user : users) {
            this.users.put(user.name(), user);
        }
    }

    String get(String url) {
        return get(url, null);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            if (payload == null) {
                // Return all users
                return buildUserResponse(new ArrayList<>(users.values()));
            } else {
                // Return specified users
                List<String> userNames = payload.getJSONArray("users").toList().stream()
                        .map(Object::toString)
                        .sorted()
                        .toList();
                List<User> resultUsers = new ArrayList<>();
                for (String name : userNames) {
                    User user = users.get(name);
                    if (user != null) {
                        resultUsers.add(user);
                    }
                }
                return buildUserResponse(resultUsers);
            }
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            String name = payload.getString("user");
            User user = User.builder().setName(name).build();
            users.put(name, user);
            return userToJson(user);
        } else if ("/iou".equals(url)) {
            return handleIou(payload);
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    private String handleIou(JSONObject payload) {
        String lender = payload.getString("lender");
        String borrower = payload.getString("borrower");
        double amount = payload.getDouble("amount");

        User lenderUser = users.get(lender);
        User borrowerUser = users.get(borrower);

        if (lenderUser == null || borrowerUser == null) {
            throw new IllegalArgumentException("User not found");
        }

        // Update lender's owes/owedBy and borrower's owes/owedBy
        lenderUser = updateUserBalance(lenderUser, borrower, amount, true);
        borrowerUser = updateUserBalance(borrowerUser, lender, amount, false);

        // Store updated users
        users.put(lender, lenderUser);
        users.put(borrower, borrowerUser);

        // Return both users sorted by name
        List<User> resultUsers = new ArrayList<>();
        resultUsers.add(lenderUser);
        resultUsers.add(borrowerUser);
        resultUsers.sort((a, b) -> a.name().compareTo(b.name()));

        return buildUserResponse(resultUsers);
    }

    private User updateUserBalance(User user, String otherUser, double amount, boolean isOwes) {
        List<Iou> currentList = isOwes ? user.owes() : user.owedBy();
        
        // Remove existing IOU with otherUser
        currentList.removeIf(iou -> iou.name().equals(otherUser));
        
        // Add new IOU if amount is non-zero
        if (amount != 0) {
            if (isOwes) {
                return User.builder()
                        .setName(user.name())
                        .owes(otherUser, amount)
                        .owedByList(user.owedBy())
                        .build();
            } else {
                return User.builder()
                        .setName(user.name())
                        .owedBy(otherUser, amount)
                        .owesList(user.owes())
                        .build();
            }
        }
        
        return user;
    }

    private String buildUserResponse(List<User> users) {
        JSONObject response = new JSONObject();
        JSONObject usersObject = new JSONObject();
        
        for (User user : users) {
            usersObject.put(user.name(), userToJson(user));
        }
        
        response.put("users", usersObject);
        return response.toString();
    }

    private String userToJson(User user) {
        JSONObject json = new JSONObject();
        json.put("name", user.name());
        
        // Process owes
        JSONObject owes = new JSONObject();
        for (Iou iou : user.owes()) {
            owes.put(iou.name(), iou.amount());
        }
        json.put("owes", owes);
        
        // Process owedBy
        JSONObject owedBy = new JSONObject();
        for (Iou iou : user.owedBy()) {
            owedBy.put(iou.name(), iou.amount());
        }
        json.put("owed_by", owedBy);
        
        // Add balance
        json.put("balance", user.balance());
        
        return json.toString();
    }
}
