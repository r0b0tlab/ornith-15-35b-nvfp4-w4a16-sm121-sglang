binary.js
```
export class Binary {
  constructor(binaryString) {
    this.binaryString = binaryString;
  }

  toDecimal() {
    let decimal = 0;
    
    // Handle invalid input - must be a string of 0s and 1s
    if (typeof this.binaryString !== 'string' || this.binaryString.length === 0) {
      return null;
    }
    
    // Process each character from left to right
    for (let i = 0; i < this.binaryString.length; i++) {
      const char = this.binaryString[i];
      
      // Check if the character is a valid binary digit
      if (char !== '0' && char !== '1') {
        return null;
      }
      
      // Multiply current result by 2 and add the new digit
      decimal = decimal * 2 + parseInt(char, 10);
    }
    
    return decimal;
  }
}
```
