AffineCipher.java
```
public class AffineCipher {

    private static final int M = 26;

    public String encode(String text, int coefficient1, int coefficient2) {
        if (!isCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("Error: keyA and alphabet size must be coprime.");
        }
        int mmi = modInverse(coefficient1, M);
        StringBuilder result = new StringBuilder();
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int x = Character.toLowerCase(c) - 'a';
                int y = (coefficient1 * x + coefficient2) % M;
                result.append((char) (y + 'a'));
            } else if (Character.isDigit(c)) {
                result.append(c);
            }
        }
        return group(result.toString(), 5);
    }

    public String decode(String text, int coefficient1, int coefficient2) {
        if (!isCoprime(coefficient1, M)) {
            throw new IllegalArgumentException("Error: keyA and alphabet size must be coprime.");
        }
        int mmi = modInverse(coefficient1, M);
        StringBuilder result = new StringBuilder();
        for (char c : text.toCharArray()) {
            if (Character.isLetter(c)) {
                int y = c - 'a';
                int x = (mmi * ((y - coefficient2 % M + M) % M)) % M;
                result.append((char) (x + 'a'));
            } else if (Character.isDigit(c) || c == ' ') {
                if (c != ' ') {
                    result.append(c);
                }
            }
        }
        return result.toString();
    }

    private String group(String text, int groupSize) {
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            if (i > 0 && i % groupSize == 0) {
                result.append(' ');
            }
            result.append(text.charAt(i));
        }
        return result.toString();
    }

    private boolean isCoprime(int a, int m) {
        return gcd(a, m) == 1;
    }

    private int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    private int modInverse(int a, int m) {
        a = ((a % m) + m) % m;
        for (int x = 1; x < m; x++) {
            if ((a * x) % m == 1) {
                return x;
            }
        }
        throw new IllegalArgumentException("Modular inverse does not exist.");
    }
}
