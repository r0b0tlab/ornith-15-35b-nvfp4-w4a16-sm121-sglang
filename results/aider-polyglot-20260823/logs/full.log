// Beverages: 0=coffee, 1=tea, 2=milk, 3=orangejuice, 4=water
// Pets: 0=dog, 1=fox, 2=horse, 3=snail, 4=zebra
// Hobbies: 0=dancing, 1=painting, 2=football, 3=reading, 4=chess

// Given a house assignment, check all constraints.
// nat[i], color[i], bev[i], pet[i], hobby[i] = value in house i.
bool checkConstraints(const std::array<int, 5>& nat,
                      const std::array<int, 5>& color,
                      const std::array<int, 5>& bev,
                      const std::array<int, 5>& pet,
                      const std::array<int, 5>& hobby) {
    // 2. Englishman lives in red house
    if (nat[0] != color[0]) return false;
    // 3. Spaniard owns dog
    if (nat[1] != pet[0]) return false;
    // 4. green house drinks coffee
    if (color[2] != bev[0]) return false;
    // 5. Ukrainian drinks tea
    if (nat[2] != bev[1]) return false;
    // 6. green immediately right of ivory
    if (color[2] != color[1] + 1) return false;
    // 7. snail owner likes dancing
    if (pet[3] != hobby[0]) return false;
    // 8. yellow house is painter
    if (color[3] != hobby[1]) return false;
    // 9. middle house drinks milk
    if (bev[2] != 2) return false;
    // 10. Norwegian lives in first house
    if (nat[3] != 0) return false;
    // 13. football player drinks OJ
    if (hobby[2] != bev[3]) return false;
    // 14. Japanese plays chess
    if (nat[4] != hobby[4]) return false;
    // 11. reader next to fox
    if (std::abs(static_cast<int>(std::distance(
                     std::find(pet.begin(), pet.end(), 3),
                     pet.begin())) -
                 static_cast<int>(std::distance(
                     std::find(hobby.begin(), hobby.end(), 3),
                     hobby.begin()))) != 1) {
        return false;
    }
    // 12. painter's house next to horse
    if (std::abs(static_cast<int>(std::distance(
                     std::find(pet.begin(), pet.end(), 2),
                     pet.begin())) -
                 static_cast<int>(std::distance(
                     std::find(hobby.begin(), hobby.end(), 1),
                     hobby.begin()))) != 1) {
        return false;
    }
    return true;
}

}  // namespace

Solution solve() {
    std::vector<int> base = {0, 1, 2, 3, 4};

    // Iterate over all permutations of each domain.
    // To reduce complexity, we use next_permutation.
    std::array<int, 5> nat, color, bev, pet, hobby;

    do {
        do {
            do {
                do {
                    do {
                        std::copy(base.begin(), base.end(), nat.begin());
                        // color, bev, pet, hobby permutations
                        // We need independent permutations, so we must
                        // reset and iterate each.
                    } while (false);
                } while (false);
            } while (false);
        } while (false);
    } while (false);

    // Proper nested permutation loop
    std::array<int, 5> c = base;
    std::array<int, 5> b = base;
    std::array<int, 5> p = base;
    std::array<int, 5> h = base;

    do {
        std::copy(c.begin(), c.end(), color.begin());
        do {
            std::copy(b.begin(), b.end(), bev.begin());
            do {
                std::copy(p.begin(), p.end(), pet.begin());
                do {
                    std::copy(h.begin(), h.end(), hobby.begin());
                    do {
                        std::copy(c.begin(), c.end(), nat.begin());
                        if (checkConstraints(nat, color, bev, pet, hobby)) {
                            // Found solution.
                            // Find who drinks water (bev index 4).
                            for (int i = 0; i < 5; ++i) {
                                if (bev[i] == 4) {
                                    // house i drinks water.
