    def __init__(self):
        self._roster = {}  # Maps grade -> list of student names
        self._added = []  # Tracks the success of each add_student call

    def add_student(self, name, grade):
        # Check if the student is already in the roster (any grade)
        for grade_students in self._roster.values():
            if name in grade_students:
                self._added.append(False)
                return
        # Add the student to the specified grade
        if grade not in self._roster:
            self._roster[grade] = []
        self._roster[grade].append(name)
        self._added.append(True)

    def roster(self):
        result = []
        for grade_number in sorted(self._roster.keys()):
            students = sorted(self._roster[grade_number])
            result.extend(students)
        return result

    def grade(self, grade_number):
        if grade_number not in self._roster:
            return []
        return sorted(self._roster[grade_number])

    def added(self):
        return self._added
```
