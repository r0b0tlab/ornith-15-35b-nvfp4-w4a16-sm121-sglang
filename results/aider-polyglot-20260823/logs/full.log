use std::collections::HashMap;

pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

#[derive(Clone)]
enum Token {
    Number(i32),
    Word(String),
}

pub struct Forth {
    stack: Vec<Value>,
    definitions: HashMap<String, Vec<Token>>,
}

impl Forth {
    pub fn new() -> Forth {
        Forth {
            stack: Vec::new(),
            definitions: HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        // Split input into lines, each line can be a definition or a series of words
        for line in input.lines() {
            self.eval_line(line)?;
        }
        Ok(())
    }

    fn eval_line(&mut self, line: &str) -> Result {
        let tokens = self.tokenize(line);
        let mut index = 0;
        
        // Check if this is a definition
        if tokens.len() >= 4 && tokens[0] == ":" {
            return self.eval_definition(&tokens);
        }
        
        // Otherwise, evaluate the words
        while index < tokens.len() {
            self.eval_token(&tokens[index])?;
            index += 1;
        }
        
        Ok(())
    }

    fn tokenize(&self, line: &str) -> Vec<String> {
        let mut tokens = Vec::new();
        let mut current = String::new();
        
        for c in line.chars() {
            if c.is_whitespace() {
                if !current.is_empty() {
                    tokens.push(current.clone());
                    current.clear();
                }
            } else {
                current.push(c);
            }
        }
        
        if !current.is_empty() {
            tokens.push(current);
        }
        
        tokens
    }

    fn eval_definition(&mut self, tokens: &[String]) -> Result {
        // tokens[0] == ":"
        // tokens[1] == word name
        // tokens[last] == ";"
        if tokens.len() < 4 {
            return Err(Error::InvalidWord);
        }
        
        let word_name = tokens[1].to_uppercase();
        if word_name.chars().all(|c| c.is_ascii_digit()) {
            return Err(Error::InvalidWord);
        }
        
        if tokens[tokens.len() - 1] != ";" {
            return Err(Error::InvalidWord);
        }
        
        // Extract the definition tokens (excluding ":" and ";")
        let def_tokens = tokens[2..tokens.len() - 1].to_vec();
        
        // Store the definition
        self.definitions.insert(word_name, self.tokenize_definition(&def_tokens));
        
        Ok(())
    }

    fn tokenize_definition(&self, tokens: &[String]) -> Vec<Token> {
        let mut result = Vec::new();
        
        for token in tokens {
            if token.chars().all(|c| c.is_ascii_digit()) {
                if let Ok(num) = token.parse::<i32>() {
                    result.push(Token::Number(num));
                } else {
                    result.push(Token::Word(token.clone()));
                }
            } else {
                result.push(Token::Word(token.clone()));
            }
        }
        
        result
    }

    fn eval_token(&mut self, token: &str) -> Result {
        // Check if it's a number
        if let Ok(num) = token.parse::<i32>() {
            self.stack.push(num);
            return Ok(());
        }
        
        let upper = token.to_uppercase();
        
        // Check built-in words
        match upper.as_str() {
            "+" => self.arithmetic(|a, b| a + b),
            "-" => self.arithmetic(|a, b| a - b),
            "*" => self.arithmetic(|a, b| a * b),
            "/" => self.arithmetic(|a, b| {
                if b == 0 {
                    Err(Error::DivisionByZero)
                } else {
                    Ok(a / b)
                }
            }),
            "DUP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                let &num = self.stack.last().unwrap();
                self.stack.push(num);
                Ok(())
            },
            "DROP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                self.stack.pop();
                Ok(())
            },
            "SWAP" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                self.stack.swap(self.stack.len() - 1, self.stack.len() - 2);
                Ok(())
            },
            "OVER" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let len = self.stack.len();
                let &num = &self.stack[len - 2];
                self.stack.push(num);
                Ok(())
            },
            _ => {
                // Check if it's a user-defined word
                if let Some(def) = self.definitions.get(&upper) {
                    for token in def {
                        match token {
                            Token::Number(num) => self.stack.push(*num),
                            Token::Word(word) => self.eval_token(word)?,
                        }
                    }
                    Ok(())
                } else {
                    Err(Error::UnknownWord)
                }
            }
        }
    }

    fn arithmetic<F>(&mut self, op: F) -> Result
    where
        F: Fn(i32, i32) -> Result,
    {
        if self.stack.len() < 2 {
            return Err(Error::StackUnderflow);
        }
        let len = self.stack.len();
        let b = self.stack[len - 1];
        let a = self.stack[len - 2];
        let result = op(a, b)?;
        self.stack[len - 2] = result;
        self.stack.pop();
        Ok(())
    }
}
