```rust
fn tokenize(&self, input: &str) -> Vec<String> {
    let mut tokens = Vec::new();
    let mut current = String::new();
    
    for c in input.chars() {
        if c.is_whitespace() {
            if !current.is_empty() {
                tokens.push(current.clone());
                current.clear();
            }
        } else {
            current.push(c);
        }
    }
    
    if !current.is_empty() {
        tokens.push(current);
    }
    
    tokens
}
