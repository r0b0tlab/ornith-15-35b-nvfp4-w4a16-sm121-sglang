+        if content[idx] == ';':
+            # Start of a new child node
+            end = _find_matching_paren(content, idx)
+            child_content = content[idx+1:end]
+            children.append(_parse_node(child_content))
+            idx = end + 1
+        elif content[idx] == '(':
+            # This shouldn't happen at this level
+            break
+        else:
+            # Parse property
+            prop_end = content.find('[', idx)
+            if prop_end == -1:
+                break
+            key = content[idx:prop_end]
+            if not key.isupper():
+                raise ValueError("property must be in uppercase")
+            
+            # Parse value
+            val_end = content.find(']', prop_end + 1)
+            if val_end == -1:
+                raise ValueError("properties without delimiter")
+            value = content[prop_end+1:val_end]
+            properties[key] = value
+            idx = val_end + 1
+    
+    return SgfTree(properties, children)
+
+
+def _find_matching_paren(content, start):
+    """Find the matching closing paren for the opening paren at position 
start."""
+    depth = 0
+    for i in range(start, len(content)):
+        if content[i] == '(':
+            depth += 1
+        elif content[i] == ')':
+            depth -= 1
+            if depth == 0:
+                return i
+    raise ValueError("tree missing")
```


