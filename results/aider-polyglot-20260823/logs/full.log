I need to implement a graph DSL using the builder pattern. Let me analyze the requirements.

The task is to create a graph DSL that allows:
1. Creating a graph
2. Adding nodes with optional colors
3. Adding edges between nodes with optional colors
4. Setting graph properties

Let me implement this using the builder pattern.

lib.rs
```rust
pub mod graph {
    use std::collections::HashMap;

    #[derive(Debug, Clone)]
    pub struct Graph {
        nodes: Vec<String>,
        edges: Vec<(String, String)>,
        node_attrs: HashMap<String, HashMap<String, String>>,
        edge_attrs: Vec<HashMap<String, String>>,
        graph_attrs: HashMap<String, String>,
    }

    impl Graph {
        pub fn new() -> Self {
            Graph {
                nodes: Vec::new(),
                edges: Vec::new(),
                node_attrs: HashMap::new(),
                edge_attrs: Vec::new(),
                graph_attrs: HashMap::new(),
            }
        }

        pub fn nodes(&self) -> Vec<String> {
            self.nodes.clone()
        }

        pub fn edges(&self) -> Vec<(String, String)> {
            self.edges.clone()
        }

        pub fn graph(&self) -> HashMap<String, String> {
            self.graph_attrs.clone()
        }

        pub fn node(&mut self, name: &str) -> Result<(), String> {
            if self.nodes.contains(&name.to_string()) {
                return Err(format!("Node '{}' already exists.", name));
            }
            self.nodes.push(name.to_string());
            Ok(())
        }

        pub fn edge(&mut self, from: &str, to: &str) -> Result<(), String> {
            if !self.nodes.contains(&from.to_string()) {
                return Err(format!("Node '{}' does not exist.", from));
            }
            if !self.nodes.contains(&to.to_string()) {
                return Err(format!("Node '{}' does not exist.", to));
            }
            self.edges.push((from.to_string(), to.to_string()));
            self.edge_attrs.push(HashMap::new());
            Ok(())
        }

        pub fn graph_attr(&mut self, key: &str, value: &str) -> Result<(), String> {
            self.graph_attrs.insert(key.to_string(), value.to_string());
            Ok(())
        }

        pub fn graph_attr_query(&self, key: &str) -> Option<&str> {
            self.graph_attrs.get(key).map(|s| s.as_str())
        }

        pub fn node_attr(&mut self, name: &str, key: &str, value: &str) -> Result<(), String> {
            if !self.nodes.contains(&name.to_string()) {
                return Err(format!("Node '{}' does not exist.", name));
            }
            self.node_attrs
                .entry(name.to_string())
                .or_insert_with(HashMap::new)
                .insert(key.to_string(), value.to_string());
            Ok(())
        }

        pub fn node_attr_query(&self, name: &str, key: &str) -> Option<&str> {
            self.node_attrs
                .get(name)
                .and_then(|attrs| attrs.get(key))
                .map(|s| s.as_str())
        }
    }
}
```

