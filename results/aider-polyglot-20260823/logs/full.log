pub struct Luhn {
    value: String,
}

impl Luhn {
    pub fn is_valid(&self) -> bool {
        // Remove spaces, but reject if any other characters present
        let cleaned: Vec<char> = self.value.chars().filter(|&c| c != ' ').collect();
        
        // Must have at least 2 characters
        if cleaned.len() < 2 {
            return false;
        }
        
        // Check that all characters are digits
        let mut digits: Vec<u32> = Vec::with_capacity(cleaned.len());
        for c in cleaned {
            match c.to_digit(10) {
                Some(d) => digits.push(d),
                None => return false,
            }
        }
        
        // Apply Luhn algorithm
        let mut sum: u32 = 0;
        let mut should_double = false;
        
        for i in (0..digits.len()).rev() {
            let mut digit = digits[i];
            if should_double {
                digit *= 2;
                if digit > 9 {
                    digit -= 9;
                }
            }
            sum += digit;
            should_double = !should_double;
        }
        
        sum % 10 == 0
    }
}

impl From<&str> for Luhn {
    fn from(input: &str) -> Self {
        Luhn {
            value: input.to_string(),
        }
    }
}

impl From<String> for Luhn {
    fn from(input: String) -> Self {
        Luhn {
            value: input,
        }
    }
}

