// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

use std::ptr;

/// A doubly linked list data structure.
///
/// # Invariants
/// - `head` and `tail` must correctly point to the first and last nodes, or be null for an empty list.
/// - Each node's `next` and `prev` pointers must form a consistent doubly linked structure.
pub struct LinkedList<T> {
    head: Option<Box<Node<T>>>,
    tail: Option<Box<Node<T>>>,
    len: usize,
}

/// A node in the doubly linked list.
struct Node<T> {
    data: T,
    next: Option<Box<Node<T>>>,
    prev: Option<Box<Node<T>>>,
}

/// A cursor positioned at a specific node in the list.
///
/// The cursor acts as if it is at the position of an element and can
/// insert/remove elements at that position.
pub struct Cursor<'a, T> {
    list: *mut LinkedList<T>,
    current: Option<&'a mut Node<T>>,
}

/// An iterator over the list from front to back.
pub struct Iter<'a, T> {
    current: Option<&'a Node<T>>,
}

impl<T> Node<T> {
    fn new(data: T) -> Self {
        Node {
            data,
            next: None,
            prev: None,
        }
    }
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
            head: None,
            tail: None,
            len: 0,
        }
    }

    pub fn is_empty(&self) -> bool {
        self.head.is_none()
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.head.as_mut(),
        }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.tail.as_mut(),
        }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            current: self.head.as_ref(),
        }
    }
}

impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        self.current.as_mut().map(|node| &mut node.data)
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        let list = unsafe { &mut *self.list };
        match self.current.take() {
            Some(node) => {
                let next_node = node.next.take();
                match next_node {
                    Some(next) => {
                        // Reattach the current node to avoid losing it
                        list.head = Some(node);
                        self.current = Some(next);
                        match self.current {
                            Some(n) => Some(&mut n.data),
                            None => None,
                        }
                    }
                    None => {
                        // No next node, cursor now at end
                        list.head = Some(node);
                        self.current = None;
                        None
                    }
                }
            }
            None => None,
        }
    }

    /// Move one position backward (towards the front) and
    /// return a reference to the new position
    pub fn prev(&mut self) -> Option<&mut T> {
        let list = unsafe { &mut *self.list };
        match self.current.take() {
            Some(node) => {
                let prev_node = node.prev.take();
                match prev_node {
                    Some(prev) => {
                        list.tail = Some(node);
                        self.current = Some(prev);
                        match self.current {
                            Some(n) => Some(&mut n.data),
                            None => None,
                        }
                    }
                    None => {
                        list.tail = Some(node);
                        self.current = None;
                        None
                    }
                }
            }
            None => None,
        }
    }

    /// Remove and return the element at the current position and move the cursor
    /// to the neighboring element that's closest to the back. This can be
    /// either the next or previous position.
    pub fn take(&mut self) -> Option<T> {
        unsafe {
            let list = &mut *self.list;
            match self.current.take() {
                None => None,
                Some(node) => {
                    // Detach the node from the list
                    let prev = node.prev.take();
                    let next = node.next.take();

                    match (prev, next) {
                        (Some(mut prev_node), Some(mut next_node)) => {
                            // Node in the middle
                            next_node.prev = Some(prev_node);
                            prev_node.next = Some(next_node);
                        }
                        (Some(mut prev_node), None) => {
                            // Node is tail
                            prev_node.next = None;
                            list.tail = Some(prev_node);
                        }
                        (None, Some(mut next_node)) => {
                            // Node is head
                            next_node.prev = None;
                            list.head = Some(next_node);
                        }
                        (None, None) => {
                            // Only node in list
                            list.head = None;
                            list.tail = None;
                        }
                    }
                    list.len -= 1;
                    // Extract the data from the detached node
                    let data = std::ptr::read(&node.data);
                    drop(node);
                    Some(data)
                }
            }
        }
    }

    pub fn insert_after(&mut self, element: T) {
        unsafe {
            let list = &mut *self.list;
            let new_node = Box::new(Node {
                data: element,
                next: None,
                prev: None,
            });

            match self.current.take() {
                None => {
                    // Empty list or cursor at end
                    if list.head.is_none() {
                        list.head = Some(new_node);
                        list.tail = Some(new_node);
                    } else {
                        // Insert at back
                        let tail = list.tail.take().unwrap();
                        new_node.prev = Some(tail);
                        list.tail = Some(new_node);
                    }
                }
                Some(node) => {
                    // Insert after current node
                    let next = node.next.take();
                    new_node.next = next;
                    new_node.prev = Some(node);

                    match next {
                        Some(mut next_node) => {
                            next_node.prev = Some(new_node);
                        }
                        None => {
                            // Node was tail
                            list.tail = Some(new_node);
                        }
                    }
                    node.next = Some(new_node);
                    self.current = Some(node);
                }
            }
            list.len += 1;
        }
    }

    pub fn insert_before(&mut self, element: T) {
        unsafe {
            let list = &mut *self.list;
            let new_node = Box::new(Node {
                data: element,
                next: None,
                prev: None,
            });

            match self.current.take() {
                None => {
                    // Empty list or cursor at front
                    if list.head.is_none() {
                        list.head = Some(new_node);
                        list.tail = Some(new_node);
                    } else {
                        // Insert at front
                        let head = list.head.take().unwrap();
                        new_node.next = Some(head);
                        list.head = Some(new_node);
                    }
                }
                Some(node) => {
                    // Insert before current node
                    let prev = node.prev.take();
                    new_node.next = Some(node);
                    new_node.prev = prev;

                    match prev {
                        Some(mut prev_node) => {
                            prev_node.next = Some(new_node);
                        }
                        None => {
                            // Node was head
                            list.head = Some(new_node);
                        }
                    }
                    node.prev = Some(new_node);
                    self.current = Some(node);
                }
            }
            list.len += 1;
        }
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        match self.current {
            None => None,
            Some(node) => {
                let next = node.next.as_ref();
                self.current = next;
                next.map(|n| &n.data)
            }
        }
    }
}

impl<T> Drop for LinkedList<T> {
    fn drop(&mut self) {
        unsafe {
            let mut current = self.head.take();
            while let Some(mut node) = current {
                current = node.next.take();
                // Box will be dropped automatically
            }
        }
    }
}

impl<'a, T> IntoIterator for &'a LinkedList<T> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.iter()
    }
}

// Safety: LinkedList manages its own memory correctly
unsafe impl<T> Send for LinkedList<T> {}
// Safety: LinkedList manages its own memory correctly
unsafe impl<T> Sync for LinkedList<T> {}
