    }
    
    // Find the target weekday
    auto d = year_month_day{ year, month, start_day };
    int wd_int = static_cast<int>(d.weekday());
    int target_int = static_cast<int>(weekday_);
    
    int diff;
    if (week_ == -1) {  // last
        diff = wd_int - target_int;
        if (diff < 0) diff += 7;
        start_day -= diff;
    } else {  // first, second, third, fourth, teenth
        diff = target_int - wd_int;
        if (diff < 0) diff += 7;
        start_day += diff;
    }
    
    return year_month_day{ year, month, start_day };
}

}  // namespace meetup
