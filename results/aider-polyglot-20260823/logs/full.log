queen-attack.js
```javascript
//
// This is only a SKELETON file for the 'Queen Attack' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class QueenAttack {
  constructor({
    black: [blackRow, blackColumn] = [],
    white: [whiteRow, whiteColumn] = [],
  } = {}) {
    // Default positions: white at bottom row (row 7), column 3; black at top row (row 0), column 3
    const whiteQueen = white.length === 2 ? white : [7, 3];
    const blackQueen = black.length === 2 ? black : [0, 3];

    const [wRow, wCol] = whiteQueen;
    const [bRow, bCol] = blackQueen;

    // Validate positions are on the board (0-7)
    const validPosition = (row, col) =>
      row >= 0 && row <= 7 && col >= 0 && col <= 7;

    if (!validPosition(wRow, wCol) || !validPosition(bRow, bCol)) {
      throw new Error('Queen must be placed on the board');
    }

    // Queens cannot share the same position
    if (wRow === bRow && wCol === bCol) {
      throw new Error('Queens cannot share the same position');
    }

    this.whiteRow = wRow;
    this.whiteColumn = wCol;
    this.blackRow = bRow;
    this.blackColumn = bCol;
  }

  toString() {
    const board = Array.from({ length: 8 }, () => Array(8).fill(' '));

    board[this.whiteRow][this.whiteColumn] = 'W';
    board[this.blackRow][this.blackColumn] = 'B';

    return board
      .map((row) => row.join(' '))
      .join('\n');
  }

  get canAttack() {
    const { whiteRow, whiteColumn, blackRow, blackColumn } = this;

    // Same row
    if (whiteRow === blackRow) {
      return true;
    }

    // Same column
    if (whiteColumn === blackColumn) {
      return true;
    }

    // Same diagonal
    const rowDiff = Math.abs(whiteRow - blackRow);
    const colDiff = Math.abs(whiteColumn - blackColumn);
    if (rowDiff === colDiff) {
      return true;
    }

    return false;
  }
}
```
