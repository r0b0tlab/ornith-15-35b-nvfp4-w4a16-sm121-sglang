/// Given a collection and an operation, apply the operation to each element of the collection
/// and return a new collection with the results.
pub fn accumulate<T, R>(input: Vec<T>, operation: impl Fn(T) -> R) -> Vec<R> {
    let mut result = Vec::with_capacity(input.len());
    for item in input {
        result.push(operation(item));
    }
    result
}

