error_handling.go
```go
package erratum

func Use(opener ResourceOpener, input string) error {
	var res Resource
	var err error

	defer func() {
		if res != nil {
			res.Close()
		}
	}()

	for {
		res, err = opener()
		if err == nil {
			break
		}
		if _, ok := err.(*TransientError); ok {
			continue
		}
		return err
	}

	defer func() {
		if r := recover(); r != nil {
			if frobErr, ok := r.(*FrobError); ok {
				res.Defrob(frobErr.defrobTag)
			}
		}
	}()

	res.Frob(input)

	return err
}
```

erratum/common.go
```go
package erratum

type Resource interface {
	Frob()
	Defrob(tag string)
	Close()
}

type resource struct {
	str string
}

func (r *resource) Frob() {
	panic(FrobError{str: "FrobError", defrobTag: r.str})
}

func (r *resource) Defrob(tag string) {
	r.str = ""
}

func (r *resource) Close() {
	r.str = ""
}

type ResourceOpener func() (Resource, error)

type FrobError struct {
	str     string
	defrobTag string
}

type TransientError struct {
	str string
}

func (e *FrobError) Error() string {
	return e.str
}

func (e *TransientError) Error() string {
	return e.str
}
