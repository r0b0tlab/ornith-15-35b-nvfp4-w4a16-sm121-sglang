parallel-letter-frequency.js
```js
import { Worker, isMainThread, parentPort, workerData } from 'node:worker_threads';

// Helper function that counts letter frequency in a single text
const countLetters = (text) => {
  const counts = {};
  for (const char of text.toLowerCase()) {
    if (/[a-z]/.test(char)) {
      counts[char] = (counts[char] || 0) + 1;
    }
  }
  return counts;
};

// Worker thread implementation
if (!isMainThread) {
  const { text } = workerData;
  const result = countLetters(text);
  parentPort.postMessage(result);
} else {
  // Main thread implementation
  export const parallelLetterFrequency = async (texts) => {
    const results = await Promise.all(
      texts.map((text) =>
        new Promise((resolve, reject) => {
          const worker = new Worker(__filename, { workerData: { text } });
          
          worker.on('message', resolve);
          worker.on('error', reject);
          worker.on('exit', (code) => {
            if (code !== 0) {
              reject(new Error(`Worker stopped with exit code ${code}`));
            }
          });
        })
      )
    );

    // Aggregate results from all workers
    const finalCounts = {};
    for (const result of results) {
      for (const [letter, count] of Object.entries(result)) {
        finalCounts[letter] = (finalCounts[letter] || 0) + count;
      }
    }

    return finalCounts;
  };
}
```
