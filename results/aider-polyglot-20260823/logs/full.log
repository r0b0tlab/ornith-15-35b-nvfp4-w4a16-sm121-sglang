```cpp
#include "meetup.h"
#include <stdexcept>

namespace meetup {

static int days_in_month_impl(int year, unsigned int month) {
    static const int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    int dim = days[month - 1];
    if (month == 2 && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)) {
        dim = 29;
    }
    return dim;
}

static std::chrono::system_clock::date compute(
    int year,
    unsigned int month,
    std::chrono::weekday target,
    int start_day,
    bool is_last)
{
    using namespace std::chrono;
    auto d = year_month_day{year, month, static_cast<day>(start_day)};
    int diff;
    if (is_last) {
        int wd_int = d.weekday().weekday0();
        int target_int = target.weekday0();
        diff = wd_int - target_int;
        if (diff < 0) diff += 7;
        start_day -= diff;
    } else {
        int wd_int = d.weekday().weekday0();
        int target_int = target.weekday0();
        diff = target_int - wd_int;
        if (diff < 0) diff += 7;
        start_day += diff;
    }
    return year_month_day{year, month, static_cast<day>(start_day)};
}

scheduler::scheduler(boost::gregorian::months_of_year month, int year)
    : month_(month), year_(year) {}

#define FIRST_THIRD_PREFIX(name, wd) \
std::chrono::system_clock::date scheduler::first_##name() const { return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), 1, false); } \
std::chrono::system_clock::date scheduler::second_##name() const { return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), 8, false); } \
std::chrono::system_clock::date scheduler::third_##name() const { return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), 15, false); } \
std::chrono::system_clock::date scheduler::fourth_##name() const { return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), 22, false); }

FIRST_THIRD_PREFIX(monday, 1)
FIRST_THIRD_PREFIX(tuesday, 2)
FIRST_THIRD_PREFIX(wednesday, 3)
FIRST_THIRD_PREFIX(thursday, 4)
FIRST_THIRD_PREFIX(friday, 5)
FIRST_THIRD_PREFIX(saturday, 6)
FIRST_THIRD_PREFIX(sunday, 0)

#define LAST_METHOD(name, wd) \
std::chrono::system_clock::date scheduler::last_##name() const { \
    return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), days_in_month_impl(year_, static_cast<unsigned int>(month_)), true); \
}

LAST_METHOD(monday, 1)
LAST_METHOD(tuesday, 2)
LAST_METHOD(wednesday, 3)
LAST_METHOD(thursday, 4)
LAST_METHOD(friday, 5)
LAST_METHOD(saturday, 6)
LAST_METHOD(sunday, 0)

#define TEENTH_METHOD(name, wd) \
std::chrono::system_clock::date scheduler::name() const { \
    return compute(year_, static_cast<unsigned int>(month_), std::chrono::weekday(wd), 13, false); \
}

TEENTH_METHOD(monteenth, 1)
TEENTH_METHOD(tuesteenth, 2)
TEENTH_METHOD(wednesteenth, 3)
TEENTH_METHOD(thursteenth, 4)
TEENTH_METHOD(friteenth, 5)
TEENTH_METHOD(saturteenth, 6)
TEENTH_METHOD(sunteenth, 0)

}  // namespace meetup
```

