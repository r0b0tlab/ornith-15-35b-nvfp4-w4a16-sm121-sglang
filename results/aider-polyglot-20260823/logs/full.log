(0-7)");
+    }
+}
+
+bool queen::can_attack(const queen& other) const {
+    if (row_ == other.row_) {
+        return true;  // Same row
+    }
+    if (column_ == other.column_) {
+        return true;  // Same column
+    }
+    if (std::abs(row_ - other.row_) == std::abs(column_ - other.column_)) {
+        return true;  // Same diagonal
+    }
+    return false;
+}
+
 }  // namespace queen_attack
