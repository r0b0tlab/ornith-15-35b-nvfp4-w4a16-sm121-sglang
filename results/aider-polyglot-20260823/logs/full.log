The issue is with the `EncodeVarint` function. The encoding process is producing bytes in the wrong order. The chunks are being built from least significant to most significant, and then the continuation bit logic needs to be applied differently.

The problem is that when building chunks from least significant to most significant, the continuation bit should be set on all chunks EXCEPT the last one (which is the most significant). But the current code sets the continuation bit before knowing if it's the last chunk, then reverses. Let me fix the logic.

variable_length_quantity.go
```go
package variablelengthquantity

import "errors"

func EncodeVarint(input []uint32) []byte {
	output := make([]byte, 0)
	for _, value := range input {
		if value == 0 {
			output = append(output, 0x00)
			continue
		}

		var chunks []byte
		for value > 0 {
			chunks = append(chunks, byte(value&0x7f))
			value >>= 7
		}

		// Reverse the chunks (most significant group last)
		for i, j := 0, len(chunks)-1; i < j; i, j = i+1, j-1 {
			chunks[i], chunks[j] = chunks[j], chunks[i]
		}

		// Set the continuation bit on all but the last byte
		for i := 0; i < len(chunks)-1; i++ {
			chunks[i] |= 0x80
		}

		output = append(output, chunks...)
	}
	return output
}

func DecodeVarint(input []byte) ([]uint32, error) {
	output := make([]uint32, 0)
	var value uint32
	found := false

	for _, b := range input {
		if b&0x80 != 0 {
			// More bytes follow
			if value&0xf8000000 != 0 {
				// Overflow: would exceed 32 bits
				return nil, errors.New("overflow")
			}
			value = (value << 7) | uint32(b&0x7f)
			found = false
		} else {
			// Final byte of this quantity
			value = (value << 7) | uint32(b&0x7f)
			output = append(output, value)
			value = 0
			found = true
		}
	}

	if !found {
		return nil, errors.New("incomplete sequence")
	}
	return output, nil
}
