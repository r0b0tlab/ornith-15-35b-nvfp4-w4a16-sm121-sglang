```python
class StackUnderflowError(Exception):
    pass


def evaluate(input_data):
    stack = []
    custom_ops = {}

    def do_dup():
        if len(stack) < 1:
            raise StackUnderflowError("Insufficient number of items in stack")
        stack.append(stack[-1])

    def do_drop():
        if len(stack) < 1:
            raise StackUnderflowError("Insufficient number of items in stack")
        stack.pop()

    def do_swap():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        stack[-1], stack[-2] = stack[-2], stack[-1]

    def do_over():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        stack.append(stack[-2])

    def do_add():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        b = stack.pop()
        a = stack.pop()
        stack.append(a + b)

    def do_sub():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        b = stack.pop()
        a = stack.pop()
        stack.append(a - b)

    def do_mul():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        b = stack.pop()
        a = stack.pop()
        stack.append(a * b)

    def do_div():
        if len(stack) < 2:
            raise StackUnderflowError("Insufficient number of items in stack")
        b = stack.pop()
        a = stack.pop()
        if b == 0:
            raise ZeroDivisionError("divide by zero")
        # Forth uses truncation toward zero
        q = abs(a) // abs(b)
        if (a < 0) != (b < 0):
            q = -q
        stack.append(q)

    ops = {
        '+': do_add,
        '-': do_sub,
        '*': do_mul,
        '/': do_div,
        'dup': do_dup,
        'drop': do_drop,
        'swap': do_swap,
        'over': do_over,
    }

    def is_number(word):
        try:
            int(word)
            return True
        except ValueError:
            return False

    def tokenize(input_data):
        if isinstance(input_data, str):
            return input_data.split()
        tokens = []
        for item in input_data:
            tokens.extend(item.split())
        return tokens

    def process_single(token):
        lower = token.lower()
        if lower in ops:
            ops[lower]()
        elif is_number(token):
            stack.append(int(token))
        elif lower in custom_ops:
            for sub_token in custom_ops[lower]:
                process_single(sub_token)
        else:
            raise ValueError("undefined operation")

    def process(tokens):
        i = 0
        while i < len(tokens):
            token = tokens[i]
            if token == ':':
                # Define a custom word
                if i + 1 >= len(tokens):
                    raise ValueError("illegal operation")
                word_name = tokens[i + 1].lower()
                if is_number(word_name):
                    raise ValueError("illegal operation")
                definition = []
                i += 2
                while i < len(tokens) and tokens[i] != ';':
                    definition.append(tokens[i])
                    i += 1
                if i >= len(tokens):
                    raise ValueError("illegal operation")
                # i points to ';'
                custom_ops[word_name] = definition
                i += 1
            else:
                process_single(token)
                i += 1

    tokens = tokenize(input_data)
    process(tokens)

    return stack
```
