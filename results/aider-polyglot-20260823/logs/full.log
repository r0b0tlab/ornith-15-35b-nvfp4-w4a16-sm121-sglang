export const transpose = (input) => {
  const rows = Array.isArray(input) ? input : input.split('\n');
  const maxRowLength = Math.max(...rows.map(row => row.length));
  
  const result = [];
  
  for (let col = 0; col < maxRowLength; col++) {
    let newRow = '';
    
    for (let row = 0; row < rows.length; row++) {
      const char = rows[row][col];
      
      if (char !== undefined) {
        newRow += char;
      } else {
        // Check if there are any non-space characters after this position in this column
        let hasNonSpace = false;
        
        for (let laterRow = row + 1; laterRow < rows.length; laterRow++) {
          const laterChar = rows[laterRow][col];
          if (laterChar !== undefined && laterChar !== ' ') {
            hasNonSpace = true;
            break;
          }
        }
        
        if (hasNonSpace) {
          // Pad with space to maintain alignment
          newRow += ' ';
        }
        // If no non-space chars follow, don't pad (don't add anything)
      }
    }
    
    result.push(newRow);
  }
  
  return result.join('\n');
};
