```rust
#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
}

impl BowlingGame {
    pub fn new() -> Self {
        BowlingGame { rolls: Vec::new() }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.is_game_complete() {
            return Err(Error::GameComplete);
        }

        if pins > 10 {
            return Err(Error::NotEnoughPinsLeft);
        }

        let frame_info = self.current_frame_info();
        
        match frame_info {
            FrameInfo::NotStarted => {
                self.rolls.push(pins);
            }
            FrameInfo::FirstBall => {
                if pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
                self.rolls.push(pins);
            }
            FrameInfo::SecondBall { first_roll } => {
                if first_roll + pins > 10 {
                    return Err(Error::NotEnoughPinsLeft);
                }
                self.rolls.push(pins);
            }
            FrameInfo::FillBall => {
                self.rolls.push(pins);
            }
            FrameInfo::GameComplete => {
                return Err(Error::GameComplete);
            }
        }

        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if !self.is_game_complete() {
            return None;
        }

        let mut score = 0;
        let mut roll_index = 0;

        for _frame in 0..10 {
            if roll_index >= self.rolls.len() {
                return None;
            }

            if self.rolls[roll_index] == 10 {
                // Strike
                if roll_index + 2 >= self.rolls.len() {
                    return None;
                }
                score += 10 + self.rolls[roll_index + 1] + self.rolls[roll_index + 2];
                roll_index += 1;
            } else {
                // Open frame or spare
                if roll_index + 1 >= self.rolls.len() {
                    return None;
                }
                let first_roll = self.rolls[roll_index];
                let second_roll = self.rolls[roll_index + 1];
                
                if first_roll + second_roll == 10 {
                    // Spare
                    if roll_index + 2 >= self.rolls.len() {
                        return None;
                    }
                    score += 10 + self.rolls[roll_index + 2];
                    roll_index += 2;
                } else {
                    // Open frame
                    score += first_roll + second_roll;
                    roll_index += 2;
                }
            }
        }

        Some(score)
    }

    fn is_game_complete(&self) -> bool {
        // Check if all 10 frames are complete
        let mut roll_index = 0;
        
        for _frame in 0..10 {
            if roll_index >= self.rolls.len() {
                return false;
            }
            
            if self.rolls[roll_index] == 10 {
                // Strike
                if roll_index + 2 >= self.rolls.len() {
                    return false;
                }
                roll_index += 1;
            } else {
                // First and second ball
                if roll_index + 1 >= self.rolls.len() {
                    return false;
                }
                roll_index += 2;
            }
        }
        
        true
    }

    fn current_frame_info(&self) -> FrameInfo {
        // Determine what type of frame we're currently in
        let mut roll_index = 0;
        
        for frame_number in 1..=10 {
            if roll_index >= self.rolls.len() {
                return FrameInfo::NotStarted;
            }
            
            if self.rolls[roll_index] == 10 {
                // Strike
                if roll_index + 1 >= self.rolls.len() {
                    return FrameInfo::FirstBall;
                } else if self.rolls[roll_index + 1] == 10 {
                    // Second strike
                    if roll_index + 2 >= self.rolls.len() {
                        return FrameInfo::SecondBall { first_roll: 10 };
                    }
                    roll_index += 2;
                } else {
                    roll_index += 1;
                }
            } else {
                // First ball of frame
                if roll_index + 1 >= self.rolls.len() {
                    return FrameInfo::FirstBall;
                }
                
                if frame_number == 10 {
                    // Tenth frame
                    return FrameInfo::FillBall;
                }
                
                roll_index += 2;
            }
        }
        
        FrameInfo::GameComplete
    }
}

#[derive(Debug, PartialEq, Eq)]
enum FrameInfo {
    NotStarted,
    FirstBall,
    SecondBall { first_roll: u16 },
    FillBall,
    GameComplete,
}
