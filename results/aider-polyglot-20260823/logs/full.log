def can_chain(dominoes):
    """
    Find a valid domino chain using all given dominoes.
    
    A valid chain uses each domino exactly once, with adjacent stones matching
    dots, and the first and last numbers being the same.
    
    Returns the chain as a list of [a, b] pairs, or None if no valid chain exists.
    """
    if not dominoes:
        return []
    
    def solve(chain, remaining):
        if not remaining:
            # Check if the chain forms a valid loop (first == last)
            if chain[0][0] == chain[-1][1]:
                return list(chain)
            return None
        
        last_value = chain[-1][1]
        
        for i, domino in enumerate(remaining):
            if domino[0] == last_value:
                chain.append(list(domino))
                result = solve(chain, remaining[:i] + remaining[i+1:])
                if result:
                    return result
                chain.pop()
            elif domino[1] == last_value:
                chain.append([domino[1], domino[0]])
                result = solve(chain, remaining[:i] + remaining[i+1:])
                if result:
                    return result
                chain.pop()
        
        return None
    
    return solve([], list(dominoes))
```
