    rank_category: u8, // 0-8: different hand types (high card to royal flush)
    tiebreakers: Vec<u8>, // Values used to break ties, in order of importance
}

impl HandRank {
    fn new(rank_category: u8, tiebreakers: Vec<u8>) -> Self {
        HandRank { rank_category, tiebreakers }
    }
}

/// Evaluates a single poker hand and returns its HandRank.
fn evaluate_hand(hand: &str) -> HandRank {
    let cards: Vec<&str> = hand.split_whitespace().collect();
    
    // Parse each card into (rank, suit)
    let mut parsed_cards: Vec<(u8, char)> = Vec::with_capacity(5);
    for card in cards {
        // Split rank and suit
        let (rank_str, suit) = card.split_at(card.len() - 1);
        let suit_char = suit.chars().next().unwrap();
        let rank = parse_rank(rank_str);
        parsed_cards.push((rank, suit_char));
    }
    
    // Check for flush
    let is_flush = parsed_cards.iter().all(|&(_, suit)| suit == parsed_cards[0].1);
    
    // Check for straight
    let is_straight = evaluate_straight(&parsed_cards);
    
    // Count occurrences of each rank
    let mut rank_counts: Vec<(u8, usize)> = parsed_cards
        .iter()
        .map(|(rank, _)| *rank)
        .fold(Vec::new(), |mut acc, rank| {
            if let Some(entry) = acc.iter_mut().find(|&(r, _)| r == rank) {
                entry.1 += 1;
            } else {
                acc.push((rank, 1));
            }
            acc
        });
    
    // Sort by count (descending), then by rank (descending)
    rank_counts.sort_by(|a, b| b.1.cmp(&a.1).then(b.0.cmp(&a.0)));
    
    // Determine hand category
    if is_straight && is_flush {
        if let Some(&(rank, _)) = rank_counts.first() {
            // Check for royal flush (straight flush to Ace)
            if rank == 14 {
                return HandRank::new(8, vec![14]);
            }
            return HandRank::new(7, vec![rank]);
        }
    }
    
    if rank_counts[0].1 == 4 {
        // Four of a kind
        return HandRank::new(6, vec![rank_counts[0].0, rank_counts[1].0]);
    }
    
    if rank_counts[0].1 == 3 && rank_counts[1].1 == 2 {
        // Full house
        return HandRank::new(5, vec![rank_counts[0].0, rank_counts[1].0]);
    }
    
    if is_flush {
        return HandRank::new(4, rank_counts.iter().map(|&(rank, _)| rank).collect());
    }
    
