```javascript
// This is only a SKELETON file for the 'Robot Name' exercise. It's been
// provided as a convenience to get your started writing code faster.

export class Robot {
  constructor() {
    this._name = null;
  }

  get name() {
    if (!this._name) {
      this._name = this._generateName();
    }
    return this._name;
  }

  reset() {
    this._name = null;
  }

  _generateName() {
    let newName;
    do {
      newName = this._generateRandomName();
    } while (Robot._usedNames.has(newName));
    
    Robot._usedNames.add(newName);
    return newName;
  }

  _generateRandomName() {
    const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const digits = '0123456789';
    
    const letter1 = letters[Math.floor(Math.random() * 26)];
    const letter2 = letters[Math.floor(Math.random() * 26)];
    const digit1 = digits[Math.floor(Math.random() * 10)];
    const digit2 = digits[Math.floor(Math.random() * 10)];
    const digit3 = digits[Math.floor(Math.random() * 10)];
    
    return `${letter1}${letter2}${digit1}${digit2}${digit3}`;
  }
}

Robot.releaseNames = () => {
  Robot._usedNames.clear();
};

// Track all released names to ensure uniqueness
Robot._usedNames = new Set();
```
