sublist.go
```go
package sublist

type Relation string

const (
	equalRelation    = Relation("equal")
	sublistRelation  = Relation("sublist")
	superlistRelation = Relation("superlist")
	unequalRelation  = Relation("unequal")
)

func Sublist(l1, l2 []int) Relation {
	switch {
	case equal(l1, l2):
		return equalRelation
	case sublist(l1, l2):
		return sublistRelation
	case sublist(l2, l1):
		return superlistRelation
	default:
		return unequalRelation
	}
}

func equal(l1, l2 []int) bool {
	if len(l1) != len(l2) {
		return false
	}
	for i := range l1 {
		if l1[i] != l2[i] {
			return false
		}
	}
	return true
}

func sublist(l1, l2 []int) bool {
	if len(l1) == 0 {
		return true
	}
	if len(l1) > len(l2) {
		return false
	}
	for i := 0; i+len(l1) <= len(l2); i++ {
		match := true
		for j := range l1 {
			if l2[i+j] != l1[j] {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
	return false
}
```
