// convenience to get you started writing code faster.
//

export const gamestate = (board) => {
  // Count X's and O's
  let xCount = 0;
  let oCount = 0;

  for (const row of board) {
    for (const cell of row) {
      if (cell === 'X') xCount++;
      else if (cell === 'O') oCount++;
    }
  }

  // Check turn order validity
  // X starts, so X count should be equal to O count or one more
  if (xCount < oCount || xCount > oCount + 1) {
    if (xCount === oCount + 1) {
      // This is valid
    } else if (xCount === oCount) {
      // This is valid
    } else {
      throw new Error('Wrong turn order: O started');
    }
  }

  const xWon = hasWinner(board, 'X');
  const oWon = hasWinner(board, 'O');

  // Check if game was won
  if (xWon) {
    if (oWon) {
      // Both can't win
      throw new Error('Impossible board: game should have ended after the game was won');
    }
    // X won - X count should be one more than O count
    if (xCount !== oCount + 1) {
      throw new Error('Wrong turn order: X went twice');
    }
    return 'won';
  }

  if (oWon) {
    // O won - counts should be equal
    if (xCount !== oCount) {
      throw new Error('Wrong turn order: O started');
    }
    return 'won';
  }

  // No winner - check for draw or ongoing
  if (xCount + oCount === 9) {
    return 'draw';
  }

  return 'ongoing';
};

const hasWinner = (board, player) => {
  // Check rows
  for (let i = 0; i < 3; i++) {
    if (board[i][0] === player && board[i][1] === player && board[i][2] === player) {
      return true;
    }
  }

  // Check columns
  for (let j = 0; j < 3; j++) {
    if (board[0][j] === player && board[1][j] === player && board[2][j] === player) {
      return true;
    }
  }

  // Check diagonals
  if (board[0][0] === player && board[1][1] === player && board[2][2] === player) {
    return true;
  }
  if (board[0][2] === player && board[1][1] === player && board[2][0] === player) {
    return true;
  }

  return false;
};
