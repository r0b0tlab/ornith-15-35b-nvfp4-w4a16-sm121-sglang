```java
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

public class Ledger {
    public LedgerEntry createLedgerEntry(String d, String desc, int c) {
        LedgerEntry le = new LedgerEntry();
        le.setChange(c);
        le.setDescription(desc);
        le.setLocalDate(LocalDate.parse(d));
        return le;
    }

    public String format(String cur, String loc, LedgerEntry[] entries) {
        // Validate currency and locale
        if (!cur.equals("USD") && !cur.equals("EUR")) {
            throw new IllegalArgumentException("Invalid currency");
        }
        if (!loc.equals("en-US") && !loc.equals("nl-NL")) {
            throw new IllegalArgumentException("Invalid locale");
        }

        // Set up formatting based on currency and locale
        String curSymb = (cur.equals("USD")) ? "$" : "€";
        String header;
        String datPat;
        String decSep;
        String thSep;

        if (cur.equals("USD") && loc.equals("en-US")) {
            header = "Date       | Description               | Change       ";
            datPat = "MM/dd/yyyy";
            decSep = ".";
            thSep = ",";
        } else if (cur.equals("USD") && loc.equals("nl-NL")) {
            header = "Datum      | Omschrijving              | Verandering  ";
            datPat = "dd/MM/yyyy";
            decSep = ",";
            thSep = ".";
        } else if (cur.equals("EUR") && loc.equals("en-US")) {
            header = "Date       | Description               | Change       ";
            datPat = "MM/dd/yyyy";
            decSep = ".";
            thSep = ",";
        } else { // cur.equals("EUR") && loc.equals("nl-NL")
            header = "Datum      | Omschrijving              | Verandering  ";
            datPat = "dd/MM/yyyy";
            decSep = ",";
            thSep = ".";
        }

        StringBuilder s = new StringBuilder();
        s.append(header);

        if (entries.length > 0) {
            // Sort entries by date, negatives first
            LedgerEntry[] sortedEntries = new LedgerEntry[entries.length];
            for (int i = 0; i < entries.length; i++) {
                sortedEntries[i] = entries[i];
            }

            // Simple bubble sort to handle negative (withdrawal) entries before positive ones
            for (int i = 0; i < sortedEntries.length - 1; i++) {
                for (int j = 0; j < sortedEntries.length - i - 1; j++) {
                    if (sortedEntries[j].getChange() < 0 && sortedEntries[j + 1].getChange() >= 0) {
                        LedgerEntry temp = sortedEntries[j];
                        sortedEntries[j] = sortedEntries[j + 1];
                        sortedEntries[j + 1] = temp;
                    } else if (sortedEntries[j].getChange() >= 0 && sortedEntries[j + 1].getChange() < 0) {
                        // Already in order, do nothing
                    } else if (sortedEntries[j].getChange() < 0 && sortedEntries[j + 1].getChange() < 0) {
                        // Both negative, sort by date
                        if (sortedEntries[j].getLocalDate().isAfter(sortedEntries[j + 1].getLocalDate())) {
                            LedgerEntry temp = sortedEntries[j];
                            sortedEntries[j] = sortedEntries[j + 1];
                            sortedEntries[j + 1] = temp;
                        }
                    } else {
                        // Both positive, sort by date
                        if (sortedEntries[j].getLocalDate().isAfter(sortedEntries[j + 1].getLocalDate())) {
                            LedgerEntry temp = sortedEntries[j];
                            sortedEntries[j] = sortedEntries[j + 1];
                            sortedEntries[j + 1] = temp;
                        }
                    }
                }
            }

            // Format each entry
            for (int i = 0; i < sortedEntries.length; i++) {
                LedgerEntry e = sortedEntries[i];

                String date = e.getLocalDate().format(DateTimeFormatter.ofPattern(datPat));

                String desc = e.getDescription();
                if (desc.length() > 25) {
                    desc = desc.substring(0, 22);
                    desc = desc + "...";
                }

                // Format the change amount
                String converted;
                if (e.getChange() < 0) {
                    converted = String.format("%.02f", (e.getChange() / 100) * -1);
                } else {
                    converted = String.format("%.02f", e.getChange() / 100);
                }

                // Add thousands separators
                String[] parts = converted.split("\\.");
                String amount = "";
                int count = 1;
                for (int ind = parts[0].length() - 1; ind >= 0; ind--) {
                    if (((count % 3) == 0) && ind > 0) {
                        amount = thSep + parts[0].charAt(ind) + amount;
                    } else {
                        amount = parts[0].charAt(ind) + amount;
                    }
                    count++;
                }

                // Format the amount with currency symbol
                if (loc.equals("nl-NL")) {
                    amount = curSymb + " " + amount + decSep + parts[1];
                } else {
                    amount = curSymb + amount + decSep + parts[1];
                }

                // Apply locale-specific formatting for negative values
                if (e.getChange() < 0 && loc.equals("en-US")) {
                    amount = "(" + amount + ")";
                } else if (e.getChange() < 0 && loc.equals("nl-NL")) {
                    amount = curSymb + " -" + amount.replace(curSymb, "").trim() + " ";
                } else if (loc.equals("nl-NL")) {
                    amount = " " + amount + " ";
                } else {
                    amount = amount + " ";
                }

                s.append("\n");
                s.append(String.format("%s | %-25s | %13s", date, desc, amount));
            }
        }

        return s.toString();
    }

    public static class LedgerEntry {
        LocalDate localDate;
        String description;
        double change;

        public LocalDate getLocalDate() {
            return localDate;
        }

        public void setLocalDate(LocalDate localDate) {
            this.localDate = localDate;
        }

        public String getDescription() {
            return description;
        }

        public void setDescription(String description) {
            this.description = description;
        }

        public double getChange() {
            return change;
        }

        public void setChange(double change) {
            this.change = change;
        }
    }

}
