BottleSong.java
```java
class BottleSong {

    String recite(int startBottles, int takeDown) {
        StringBuilder verses = new StringBuilder();
        for (int i = 0; i < takeDown; i++) {
            if (i > 0) {
                verses.append("\n");
            }
            verses.append(verse(startBottles - i));
            if (i < takeDown - 1) {
                verses.append("\n");
            }
        }
        return verses.toString();
    }

    private String verse(int bottles) {
        String current = capitalize(numberToWords(bottles));
        String next = numberToWords(bottles - 1);
        String bottleWord = bottles == 1 ? "bottle" : "bottles";

        StringBuilder verse = new StringBuilder();
        verse.append(current).append(" green ").append(bottleWord).append(" hanging on the wall,\n");
        verse.append(current).append(" green ").append(bottleWord).append(" hanging on the wall,\n");
        verse.append("And if one green bottle should accidentally fall,\n");
        verse.append("There'll be ").append(next).append(" green ").append(bottleWord).append(" hanging on the wall.");
        return verse.toString();
    }

    private String numberToWords(int number) {
        switch (number) {
            case 0:
                return "no";
            case 1:
                return "one";
            case 2:
                return "two";
            case 3:
                return "three";
            case 4:
                return "four";
            case 5:
                return "five";
            case 6:
                return "six";
            case 7:
                return "seven";
            case 8:
                return "eight";
            case 9:
                return "nine";
            case 10:
                return "ten";
            default:
                throw new IllegalArgumentException("Unsupported number: " + number);
        }
    }

    private String capitalize(String word) {
        if (word.isEmpty()) {
            return word;
        }
        return Character.toUpperCase(word.charAt(0)) + word.substring(1);
    }
}
```
