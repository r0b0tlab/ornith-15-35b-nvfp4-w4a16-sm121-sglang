StateOfTicTacToe.java
```java
class StateOfTicTacToe {
    public GameState determineState(String[] board) {
        int xCount = 0;
        int oCount = 0;
        
        // Count X's and O's
        for (char c : board[0].toCharArray()) {
            if (c == 'X') xCount++;
            else if (c == 'O') oCount++;
        }
        for (char c : board[1].toCharArray()) {
            if (c == 'X') xCount++;
            else if (c == 'O') oCount++;
        }
        for (char c : board[2].toCharArray()) {
            if (c == 'X') xCount++;
            else if (c == 'O') oCount++;
        }
        
        // Check for invalid turn order
        if (xCount < oCount) {
            throw new IllegalArgumentException("Wrong turn order: O started");
        }
        if (xCount > oCount + 1) {
            throw new IllegalArgumentException("Wrong turn order: X went twice");
        }
        
        boolean xWins = hasWon(board, 'X');
        boolean oWins = hasWon(board, 'O');
        
        // Check for invalid winning states
        if (xWins && oWins) {
            throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
        }
        
        if (xWins) {
            // X has won, so O cannot have one more than X
            if (oCount > xCount) {
                throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
            }
            return GameState.WIN;
        }
        
        if (oWins) {
            // O has won, so X and O counts must be equal
            if (xCount > oCount) {
                throw new IllegalArgumentException("Impossible board: game should have ended after the game was won");
            }
            return GameState.WIN;
        }
        
        // Check for draw or ongoing game
        if (xCount + oCount == 9) {
            return GameState.DRAW;
        }
        
        return GameState.ONGOING;
    }
    
    private boolean hasWon(String[] board, char player) {
        // Check rows
        for (int i = 0; i < 3; i++) {
            if (board[i].charAt(0) == player && board[i].charAt(1) == player && board[i].charAt(2) == player) {
                return true;
            }
        }
        
        // Check columns
        for (int i = 0; i < 3; i++) {
            if (board[0].charAt(i) == player && board[1].charAt(i) == player && board[2].charAt(i) == player) {
                return true;
            }
        }
        
        // Check diagonals
        if (board[0].charAt(0) == player && board[1].charAt(1) == player && board[2].charAt(2) == player) {
            return true;
        }
        if (board[0].charAt(2) == player && board[1].charAt(1) == player && board[2].charAt(0) == player) {
            return true;
        }
        
        return false;
    }
}
