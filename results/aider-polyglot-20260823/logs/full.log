package react

// Cell is the interface for a reactive cell.
type Cell interface {
	Value() int
	SetValue(value int)
	AddCallback(callback func(int)) Canceler
}

// InputCell is an input cell with a settable value.
type InputCell interface {
	Cell
}

// ComputeCell is a cell whose value is computed from other cells.
type ComputeCell interface {
	Cell
}

// Canceler is the interface for cancelling a callback.
type Canceler interface {
	Cancel()
}

// Reactor is the interface for the reactive system.
type Reactor interface {
	CreateInput(initial int) InputCell
	CreateCompute1(dep Cell, compute func(int) int) ComputeCell
	CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell
}

// cell is the base type for input and compute cells.
type cell struct {
	value       int
	compute     func(int) int
	compute2    func(int, int) int
	deps        []Cell
	dependents    map[*cell]bool
	callbacks   map[int]func(int)
	callbackIDCounter int
}

// reactor tracks all cells and manages propagation.
type reactor struct {
	cells []*cell
}

// New creates a new reactor.
func New() Reactor {
	return &reactor{}
}

// CreateInput creates a new input cell.
func (r *reactor) CreateInput(initial int) InputCell {
	c := &cell{
		value:      initial,
		dependents: make(map[*cell]bool),
	}
	r.cells = append(r.cells, c)
	return c
}

// CreateCompute1 creates a new compute cell with one dependency.
func (r *reactor) CreateCompute1(dep Cell, compute func(int) int) ComputeCell {
	c := &cell{
		compute:    compute,
		dependents: make(map[*cell]bool),
		callbacks:  make(map[int]func(int)),
	}
	c.value = compute(dep.Value())
	depCell := dep.(*cell)
	depCell.dependents[c] = true
	r.cells = append(r.cells, c)
	return c
}

// CreateCompute2 creates a new compute cell with two dependencies.
func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
	c := &cell{
		compute2:   func(a, b int) int { return compute(a, b) },
		dependents: make(map[*cell]bool),
		callbacks:  make(map[int]func(int)),
	}
	c.value = compute(dep1.Value(), dep2.Value())
	dep1Cell := dep1.(*cell)
	dep2Cell := dep2.(*cell)
	dep1Cell.dependents[c] = true
	dep2Cell.dependents[c] = true
	r.cells = append(r.cells, c)
	return c
}

// Value returns the current value of the cell.
func (c *cell) Value() int {
	return c.value
}

// SetValue sets the value of an input cell.
func (c *cell) SetValue(value int) {
	if c.value == value {
		return
	}
	c.value = value
	// propagate to dependent cells
	// ...
}

// AddCallback adds a callback to the cell.
func (c *cell) AddCallback(callback func(int)) Canceler {
	id := c.callbackIDCounter
	c.callbacks[id] = callback
	c.callbackIDCounter++
	return &canceler{cell: c, callbackID: id}
}

// Cancel removes a callback.
func (c *canceler) Cancel() {
	delete(c.cell.callbacks, c.callbackID)
}
