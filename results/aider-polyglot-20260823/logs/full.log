wordy.go
```
package wordy

import (
	"strconv"
	"strings"
)

func Answer(question string) (int, bool) {
	// Remove the trailing "?" and trim spaces
	question = strings.TrimSuffix(question, "?")
	words := strings.Fields(question)

	if len(words) == 0 || words[0] != "What" || words[1] != "is" {
		return 0, false
	}

	// Handle the case where the question is just a number
	if len(words) == 2 {
		num, err := strconv.Atoi(words[2])
		if err != nil {
			return 0, false
		}
		return num, true
	}

	// Parse the first number
	result, err := strconv.Atoi(words[2])
	if err != nil {
		return 0, false
	}

	// Process the operations
	for i := 3; i < len(words); i += 2 {
		// Ensure there's a number after each operation
		if i+1 >= len(words) {
			return 0, false
		}

		op := words[i]
		num, err := strconv.Atoi(words[i+1])
		if err != nil {
			return 0, false
		}

		switch op {
		case "plus":
			result += num
		case "minus":
			result -= num
		case "multiplied":
			if i+2 < len(words) && words[i+2] == "by" {
				result *= num
				i++
			} else {
				return 0, false
			}
		case "divided":
			if i+2 < len(words) && words[i+2] == "by" {
				result /= num
				i++
			} else {
				return 0, false
			}
		default:
			return 0, false
		}
	}

	return result, true
}

```
