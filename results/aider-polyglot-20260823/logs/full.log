I see the issue. The tests expect `label` to be a function that returns a string in the format "Resistor value: X unit", and it should throw an error for invalid colors. Let me fix the implementation.

resistor-color-trio.js
```javascript
//
// This is only a SKELETON file for the 'Resistor Color Trio' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ResistorColorTrio {
  constructor() {
    this.colorValues = {
      black: 0,
      brown: 1,
      red: 2,
      orange: 3,
      yellow: 4,
      green: 5,
      blue: 6,
      violet: 7,
      grey: 8,
      white: 9
    };
  }

  label(colors) {
    const [color1, color2, color3] = colors;

    // Validate colors
    if (!this.colorValues[color1] && color1 !== 'black') {
      throw new Error('Invalid color');
    }
    if (!this.colorValues[color2] && color2 !== 'black') {
      throw new Error('Invalid color');
    }
    if (!this.colorValues[color3] && color3 !== 'black') {
      throw new Error('Invalid color');
    }

    const value1 = this.colorValues[color1];
    const value2 = this.colorValues[color2];
    const zeros = this.colorValues[color3];

    const mainValue = value1 * 10 + value2;
    let resistance = mainValue * Math.pow(10, zeros);

    let unit = 'ohms';
    if (resistance >= 1e9) {
      unit = 'gigaohms';
      resistance /= 1e9;
    } else if (resistance >= 1e6) {
      unit = 'megaohms';
      resistance /= 1e6;
    } else if (resistance >= 1e3) {
      unit = 'kiloohms';
      resistance /= 1e3;
    }

    return `Resistor value: ${resistance} ${unit}`;
  }
}
