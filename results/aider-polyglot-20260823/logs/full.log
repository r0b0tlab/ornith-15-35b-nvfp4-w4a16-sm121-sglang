//
// This is only a SKELETON file for the 'Forth' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Forth {
  constructor() {
    this._stack = [];
    this.definitions = {};
  }

  evaluate(input) {
    const lines = Array.isArray(input) ? input : [input];
    for (const line of lines) {
      this._processLine(line);
    }
  }

  _processLine(line) {
    const tokens = this._tokenize(line);
    for (let i = 0; i < tokens.length; i++) {
      const token = tokens[i];
      const lower = token.toLowerCase();

      if (lower === ':') {
        // Word definition
        const wordName = tokens[i + 1].toLowerCase();
        if (this._isNumber(wordName)) {
          throw Error('invalid word');
        }
        i += 1;
        // Find the terminating ';'
        const defEnd = tokens.indexOf(';', i + 2);
        if (defEnd === -1) {
          throw Error('invalid definition');
        }
        const defTokens = tokens.slice(i + 2, defEnd);
        const expanded = this._expandDefinition(defTokens);
        this.definitions[wordName] = expanded;
        i = defEnd;
      } else {
        this._executeToken(token);
      }
    }
  }

  _expandDefinition(tokens) {
    const result = [];
    for (const token of tokens) {
      const lower = token.toLowerCase();
      if (this.definitions[lower]) {
        result.push(...this.definitions[lower]);
      } else {
        result.push(lower);
      }
    }
    return result;
  }

  _executeToken(token) {
    const lower = token.toLowerCase();

    // Check user-defined words first
    if (this.definitions[lower]) {
      for (const defToken of this.definitions[lower]) {
        this._executeToken(defToken);
      }
      return;
    }

    switch (lower) {
      case '+': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        this._stack.push(a + b);
        break;
      }
      case '-': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        this._stack.push(a - b);
        break;
      }
      case '*': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        this._stack.push(a * b);
        break;
      }
      case '/': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        if (b === 0) {
          throw Error('division by zero');
        }
        this._stack.push(Math.trunc(a / b));
        break;
      }
      case 'dup': {
        const a = this._stack.pop();
        this._stack.push(a);
        this._stack.push(a);
        break;
      }
      case 'drop': {
        this._stack.pop();
        break;
      }
      case 'swap': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        this._stack.push(b);
        this._stack.push(a);
        break;
      }
      case 'over': {
        const b = this._stack.pop();
        const a = this._stack.pop();
        this._stack.push(a);
        this._stack.push(b);
        this._stack.push(a);
        break;
      }
      default: {
        if (this._isNumber(token)) {
          this._stack.push(parseInt(token, 10));
        } else {
          throw Error(`unknown word: ${token}`);
        }
      }
    }
  }

  _isNumber(token) {
    return /^-?\d+$/.test(token);
  }

  _tokenize(line) {
    // Split on spaces, but keep multi-character symbols together
    return line.split(/\s+/).filter(t => t.length > 0);
  }

  get stack() {
    return this._stack;
  }
}
