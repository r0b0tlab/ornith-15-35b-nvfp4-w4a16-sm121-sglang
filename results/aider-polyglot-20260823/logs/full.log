Tree.java
```java
import java.util.*;

class Tree {
    private final String label;
    private final List<Tree> children;

    public Tree(String label) {
        this(label, new ArrayList<>());
    }

    public Tree(String label, List<Tree> children) {
        this.label = label;
        this.children = children;
    }

    public static Tree of(String label) {
        return new Tree(label);
    }

    public static Tree of(String label, List<Tree> children) {
        return new Tree(label, children);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Tree tree = (Tree) o;
        return label.equals(tree.label)
                && children.size() == tree.children.size()
                && children.containsAll(tree.children)
                && tree.children.containsAll(children);
    }

    @Override
    public int hashCode() {
        return Objects.hash(label, children);
    }

    @Override
    public String toString() {
        return "Tree{" + label +
                ", " + children +
                "}";
    }

    public Tree fromPov(String fromNode) {
        return fromPovHelper(this, fromNode, null);
    }

    private Tree fromPovHelper(Tree tree, String fromNode, Tree parent) {
        if (tree.label.equals(fromNode)) {
            // Create a new tree with the current node as root
            // and its parent as its only child, and its children as children of the parent
            List<Tree> newChildren = new ArrayList<>();
            if (parent != null) {
                newChildren.add(parent);
            }
            for (Tree child : tree.children) {
                newChildren.add(child);
            }
            return new Tree(tree.label, newChildren);
        }
        
        // Find the node in the current tree's children
        for (Tree child : tree.children) {
            if (child.label.equals(fromNode)) {
                // Found the fromNode as a child of the current tree
                // Create a new tree with the current tree as a child of fromNode
                List<Tree> newChildren = new ArrayList<>();
                for (Tree grandchild : child.children) {
                    newChildren.add(grandchild);
                }
                Tree newChild = new Tree(child.label, newChildren);
                
                // Add the current tree as a child of the new child
                List<Tree> parentNewChildren = new ArrayList<>();
                for (Tree grandchild : tree.children) {
                    if (grandchild != child) {
                        parentNewChildren.add(grandchild);
                    }
                }
                Tree newParent = new Tree(tree.label, parentNewChildren);
                newChild.children.add(0, newParent);
                
                return newChild;
            }
            // Recurse into the child
            Tree result = fromPovHelper(child, fromNode, tree);
            if (result != null) {
                return result;
            }
        }
        
        return null;
    }

    public List<String> pathTo(String fromNode, String toNode) {
        List<String> path = new ArrayList<>();
        if (!pathToHelper(this, fromNode, toNode, path)) {
            throw new UnsupportedOperationException("No path found");
        }
        return path;
    }

    private boolean pathToHelper(Tree tree, String fromNode, String toNode, List<String> path) {
        if (tree.label.equals(fromNode)) {
            // Found the start node, now find the path to the end node
            return findPath(tree, toNode, path);
        }
        
        // Recurse into the children
        for (Tree child : tree.children) {
            List<String> newPath = new ArrayList<>(path);
            newPath.add(tree.label);
            if (pathToHelper(child, fromNode, toNode, newPath)) {
                return true;
            }
        }
        
        return false;
    }

    private boolean findPath(Tree tree, String toNode, List<String> path) {
        path.add(tree.label);
        if (tree.label.equals(toNode)) {
            return true;
        }
        
        for (Tree child : tree.children) {
            if (findPath(child, toNode, path)) {
                return true;
            }
        }
        
        path.remove(path.size() - 1);
        return false;
    }
}
