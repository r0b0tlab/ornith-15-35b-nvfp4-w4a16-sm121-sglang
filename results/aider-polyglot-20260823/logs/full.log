OpticalCharacterReader.java
```java
import java.util.List;
import java.util.Map;

class OpticalCharacterReader {

    private static final Map<String, String> NUMBER_PATTERNS = Map.of(
        " _ | ||_|   ", "0",
        "     |  |   ", "1",
        " _  _||_    ", "2",
        " _  _| _|   ", "3",
        " _ |_|  |   ", "4",
        " _ |_  _|   ", "5",
        " _ |_ |_|   ", "6",
        " _ |  |     ", "7",
        " _ |_||_|   ", "8",
        " _ |_||_|   ", "9"
    );

    String parse(List<String> input) {
        if (input.size() % 4 != 0) {
            throw new IllegalArgumentException("Number of input rows must be a multiple of 4");
        }

        int width = input.get(0).length();
        if (width % 3 != 0) {
            throw new IllegalArgumentException("Number of input width must be a multiple of 3");
        }

        for (String line : input) {
            if (line.length() != width) {
                throw new IllegalArgumentException("All input rows must have the same length");
            }
        }

        StringBuilder result = new StringBuilder();

        for (int row = 0; row < input.size(); row += 4) {
            if (row > 0) {
                result.append(",");
            }

            StringBuilder lineResult = new StringBuilder();

            for (int col = 0; col < width; col += 3) {
                StringBuilder pattern = new StringBuilder();
                for (int i = 0; i < 4; i++) {
                    String rowStr = input.get(row + i);
                    pattern.append(rowStr, col, col + 3);
                }

                String patternStr = pattern.toString();
                String digit = NUMBER_PATTERNS.getOrDefault(patternStr, "?");
                lineResult.append(digit);
            }

            result.append(lineResult);
        }

        return result.toString();
    }
}
