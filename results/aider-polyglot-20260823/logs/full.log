FoodChain.java
```java
class FoodChain {

    private static final String[] ANIMALS = {
        "fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"
    };

    private static final String[] REACTIONS = {
        "",
        "It wriggled and jiggled and tickled inside her.",
        "How absurd to swallow a bird!",
        "Imagine that, to swallow a cat!",
        "What a hog, to swallow a dog!",
        "Just opened her throat and swallowed a goat!",
        "I don't know how she swallowed a cow!",
        "She's dead, of course!"
    };

    String verse(int verse) {
        StringBuilder sb = new StringBuilder();
        int index = verse - 1;

        sb.append("I know an old lady who swallowed a ").append(ANIMALS[index]).append(".\n");

        if (index == 7) {  // horse
            sb.append(REACTIONS[index]).append("\n");
            return sb.toString();
        }

        if (index > 0) {
            sb.append(REACTIONS[index]).append("\n");
        }

        // Cumulative part
        for (int i = index; i > 0; i--) {
            sb.append("She swallowed ").append(ANIMALS[i]).append(" to catch ").append("the ").append(ANIMALS[i - 1]);
            if (i - 1 == 1) {  // spider
                sb.append(" that wriggled and jiggled and tickled inside her.");
            }
            sb.append(".\n");
        }

        // Final line
        sb.append("I don't know why she swallowed the fly. Perhaps she'll die.\n");

        return sb.toString();
    }

    String verses(int startVerse, int endVerse) {
        StringBuilder sb = new StringBuilder();
        for (int verse = startVerse; verse <= endVerse; verse++) {
            sb.append(verse(verse));
            if (verse < endVerse) {
                sb.append("\n");
            }
        }
        return sb.toString();
    }
}
```
