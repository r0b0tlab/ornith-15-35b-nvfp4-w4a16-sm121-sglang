// this module adds some functionality based on the required implementations
// here like: `LinkedList::pop_back` or `Clone for LinkedList<T>`
// You are free to use anything in it, but it's mainly for the test framework.
mod pre_implemented;

use std::ptr;

/// A doubly linked list data structure.
///
/// # Invariants
/// - `head` and `tail` correctly point to the first and last nodes, or are `None` for an empty list.
/// - Each node's `next` and `prev` pointers form a consistent doubly linked structure.
/// - `len` accurately reflects the number of elements in the list.
pub struct LinkedList<T> {
    head: Option<Box<Node<T>>>,
    tail: Option<Box<Node<T>>>,
    len: usize,
}

/// A node in the doubly linked list.
struct Node<T> {
    data: T,
    next: Option<Box<Node<T>>>,
    prev: Option<Box<Node<T>>>,
}

/// A cursor positioned at a specific node in the list.
///
/// The cursor holds a raw pointer to the list and a raw pointer to the current node.
/// Safety: The list must outlive the cursor. The cursor must not be used after the list is dropped.
pub struct Cursor<'a, T> {
    list: *mut LinkedList<T>,
    current: Option<*mut Node<T>>,
    _marker: std::marker::PhantomData<&'a mut T>,
}

/// An iterator over the list from front to back.
pub struct Iter<'a, T> {
    current: Option<&'a Node<T>>,
    _marker: std::marker::PhantomData<&'a T>,
}

impl<T> Node<T> {
    fn new(data: T) -> Self {
        Node {
            data,
            next: None,
            prev: None,
        }
    }
}

impl<T> LinkedList<T> {
    pub fn new() -> Self {
        LinkedList {
            head: None,
            tail: None,
            len: 0,
        }
    }

    pub fn is_empty(&self) -> bool {
        self.head.is_none()
    }

    pub fn len(&self) -> usize {
        self.len
    }

    /// Return a cursor positioned on the front element
    pub fn cursor_front(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.head.as_mut().map(|n| n as *mut Node<T>),
            _marker: std::marker::PhantomData,
        }
    }

    /// Return a cursor positioned on the back element
    pub fn cursor_back(&mut self) -> Cursor<'_, T> {
        Cursor {
            list: self as *mut LinkedList<T>,
            current: self.tail.as_mut().map(|n| n as *mut Node<T>),
            _marker: std::marker::PhantomData,
        }
    }

    /// Return an iterator that moves from front to back
    pub fn iter(&self) -> Iter<'_, T> {
        Iter {
            current: self.head.as_ref().map(|n| n as &Node<T>),
            _marker: std::marker::PhantomData,
        }
    }
}

impl<T> Cursor<'_, T> {
    /// Take a mutable reference to the current element
    pub fn peek_mut(&mut self) -> Option<&mut T> {
        if self.current.is_none() {
            return None;
        }
        // SAFETY: current is a valid pointer into the list. The list must outlive the cursor.
        unsafe {
            let node = &mut *self.current.unwrap();
            Some(&mut node.data)
        }
    }

    /// Move one position forward (towards the back) and
    /// return a reference to the new position
    #[allow(clippy::should_implement_trait)]
    pub fn next(&mut self) -> Option<&mut T> {
        unsafe {
            let list = &mut *self.list;
            let current = self.current.take();
            match current {
                None => None,
                Some(ptr) => {
                    let node = &mut *ptr;
                    let next_node = node.next.take();
                    match next_node {
                        Some(mut next) => {
                            // Detach current node from head
                            if list.head.as_deref().map(|n| n as *const Node<T>) == Some(ptr) {
                                list.head = Some(next.clone());
                            }
                            // Set next as current
                            self.current = Some(next.as_mut() as *mut Node<T>);
                            let result = &mut next.data;
                            // Restore current node back to head
                            list.head = Some(ptr as Box<Node<T>>);
                            self.current = Some(next.as_mut() as *mut Node<T>);
                            Some(result)
                        }
                        None => {
                            // No next node; cursor moves past end
                            list.head = Some(ptr as Box<Node<T>>);
                            self.current = None;
                            None
                        }
                    }
                }
            }
        }
    }

    /// Move one position backward (towards the front) and
