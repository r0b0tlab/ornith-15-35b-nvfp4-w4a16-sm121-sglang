```go
package trinary

import "strconv"

func ParseTrinary(arg string, want int64, ok bool) int64 {
	var result int64 = 0
	for i := 0; i < len(arg); i++ {
		digit, err := strconv.Atoi(string(arg[i]))
		if err != nil || digit < 0 || digit > 2 {
			return 0
		}
		result = result*3 + int64(digit)
	}
	return result
}
```
