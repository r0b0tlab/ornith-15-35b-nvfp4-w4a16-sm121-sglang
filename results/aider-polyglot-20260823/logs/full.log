        # 4. Empty second bucket
        next_states.append((b1, 0))
        # 5. Pour first into second
        pour = min(b1, second - b2)
        next_states.append((b1 - pour, b2 + pour))
        # 6. Pour second into first
        pour = min(b2, first - b1)
        next_states.append((b1 + pour, b2 - pour))
        
        for state in next_states:
            if state not in visited:
                # Rule: cannot have first bucket empty and second full
                if state == (0, second):
                    continue
                visited.add(state)
                queue.append((actions + 1, state[0], state[1]))
    
    # If no solution found
    raise ValueError("Cannot reach the goal.")
```
