3. Implement the `post` method to handle POST requests, specifically the `/add` and `/iou` endpoints.

rest_api.py
```python
import json


class RestAPI:
    def __init__(self, database=None):
        self.database = database if database is not None else {}

    def get(self, url, payload=None):
        if url == "/users":
            if payload is None:
                # Return all users sorted by name
                users = sorted(self.database.keys())
            else:
                # Return specified users sorted by name
                users = sorted(payload["users"])
            return {"users": users}
        return None

    def post(self, url, payload=None):
        if url == "/add":
            # Create new user
            user = payload["user"]
            if user not in self.database:
                self.database[user] = {"owes": {}, "owed_by": {}}
            return self.database[user]
        elif url == "/iou":
            # Handle IOU
            lender = payload["lender"]
            borrower = payload["borrower"]
            amount = payload["amount"]

            # Initialize users if they don't exist
            if lender not in self.database:
                self.database[lender] = {"owes": {}, "owed_by": {}}
            if borrower not in self.database:
                self.database[borrower] = {"owes": {}, "owed_by": {}}

            # Update balances
            self.database[lender]["owed_by"][borrower] = \
                self.database[lender]["owed_by"].get(borrower, 0) + amount
            self.database[borrower]["owes"][lender] = \
                self.database[borrower]["owes"].get(lender, 0) - amount

            # Return updated users sorted by name
            users = sorted([lender, borrower])
            return {"users": [self.database[u] for u in users]}
        return None
```
