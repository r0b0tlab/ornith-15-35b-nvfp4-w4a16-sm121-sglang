two_bucket.go
```go
package twobucket

import "errors"

type state struct {
	one, two int
}

func Solve(sizeBucketOne, sizeBucketTwo, goalAmount int, startBucket string) (string, int, int, error) {
	if sizeBucketOne <= 0 || sizeBucketTwo <= 0 {
		return "", 0, 0, errors.New("bucket sizes must be positive")
	}
	if goalAmount > sizeBucketOne && goalAmount > sizeBucketTwo {
		return "", 0, 0, errors.New("goal amount cannot be measured")
	}

	start := state{0, 0}
	switch startBucket {
	case "one":
		start = state{sizeBucketOne, 0}
	case "two":
		start = state{0, sizeBucketTwo}
	default:
		return "", 0, 0, errors.New("invalid start bucket")
	}

	if goalAmount == sizeBucketOne {
		return "one", 1, 0, nil
	}
	if goalAmount == sizeBucketTwo {
		return "two", 1, 0, nil
	}

	visited := map[state]bool{}

	type qitem struct {
		st   state
		steps int
	}
	startState := state{sizeBucketOne, 0}
	if startBucket == "two" {
		startState = state{0, sizeBucketTwo}
	}

	visited[startState] = true
	queue := []qitem{{startState, 1}}

	for len(queue) > 0 {
		current := queue[0]
		queue = queue[1:]
		cur := current.st

		if cur.one == goalAmount {
			return "one", current.steps, cur.two, nil
		}
		if cur.two == goalAmount {
			return "two", current.steps, cur.one, nil
		}

		nexts := nextStates(cur, sizeBucketOne, sizeBucketTwo, startBucket)
		for _, ns := range nexts {
			if !visited[ns] {
				visited[ns] = true
				queue = append(queue, qitem{ns, current.steps + 1})
			}
		}
	}

	return "", 0, 0, errors.New("no solution possible")
}

func nextStates(cur state, sizeOne, sizeTwo int, startBucket string) []state {
	var results []state

	states := []state{
		{sizeOne, cur.two},  // Fill bucket one
		{cur.one, sizeTwo},  // Fill bucket two
		{0, cur.two},        // Empty bucket one
		{cur.one, 0},        // Empty bucket two
		{cur.one - min(cur.one, sizeTwo-cur.two), cur.two + min(cur.one, sizeTwo-cur.two)}, // Pour one into two
		{cur.one + min(cur.two, sizeOne-cur.one), cur.two - min(cur.two, sizeOne-cur.one)}, // Pour two into one
	}

	for _, s := range states {
		if isForbidden(s, sizeOne, sizeTwo, startBucket) {
			continue
		}
		results = append(results, s)
	}

	return results
}

func isForbidden(s state, sizeOne, sizeTwo int, startBucket string) bool {
	if startBucket == "one" {
		return s.one == 0 && s.two == sizeTwo
	}
	if startBucket == "two" {
		return s.one == sizeOne && s.two == 0
	}
	return false
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
