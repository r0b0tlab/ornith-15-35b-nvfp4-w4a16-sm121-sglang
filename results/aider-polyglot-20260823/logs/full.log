- exchange code starts with 1 → "exchange code cannot start with one"

Let me rewrite the validation to produce these exact messages.

PhoneNumber.java
```java
class PhoneNumber {

    private final String number;

    PhoneNumber(String numberString) {
        if (numberString.contains("a") || numberString.contains("b")
                || numberString.contains("c") || numberString.contains("d")
                || numberString.contains("e") || numberString.contains("f")
                || numberString.contains("g") || numberString.contains("h")
                || numberString.contains("i") || numberString.contains("j")
                || numberString.contains("k") || numberString.contains("l")
                || numberString.contains("m") || numberString.contains("n")
                || numberString.contains("o") || numberString.contains("p")
                || numberString.contains("q") || numberString.contains("r")
                || numberString.contains("s") || numberString.contains("t")
                || numberString.contains("u") || numberString.contains("v")
                || numberString.contains("w") || numberString.contains("x")
                || numberString.contains("y") || numberString.contains("z")) {
            throw new IllegalArgumentException("letters not permitted");
        }

        if (numberString.matches(".*[^0-9+().-\\s].*")) {
            throw new IllegalArgumentException("punctuations not permitted");
        }

        String digits = numberString.replaceAll("\\D", "");

        if (digits.length() < 10) {
            throw new IllegalArgumentException("must not be fewer than 10 digits");
        }

        if (digits.length() > 11) {
            throw new IllegalArgumentException("must not be greater than 11 digits");
        }

        if (digits.length() == 11) {
            if (!digits.startsWith("1")) {
                throw new IllegalArgumentException("11 digits must start with 1");
            }
            digits = digits.substring(1);
        }

        // Now digits is 10 digits
        if (digits.charAt(0) == '0') {
            throw new IllegalArgumentException("area code cannot start with zero");
        }

        if (digits.charAt(0) == '1') {
            throw new IllegalArgumentException("area code cannot start with one");
        }

        if (digits.charAt(3) == '0') {
            throw new IllegalArgumentException("exchange code cannot start with zero");
        }

        if (digits.charAt(3) == '1') {
            throw new IllegalArgumentException("exchange code cannot start with one");
        }

        this.number = digits;
    }

    String getNumber() {
        return number;
    }

}
