import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class ZebraPuzzle {
    private static final int[] HOUSES = {0, 1, 2, 3, 4};
    private static final String[] COLORS = {"red", "green", "ivory", "yellow", "blue"};
    private static final String[] SMOKERS = {"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"};
    private static final String[] BEVERAGES = {"coffee", "tea", "milk", "orangeJuice", "water"};
    private static final String[] SMOKE_TYPES = {"OldGlory", "Kools", "Chesterfields", "LuckyStrike", "Parliaments"};
    private static final String[] PETS = {"dog", "snails", "fox", "horse", "zebra"};
    private static final String[] HOBIES = {"dancing", "painting", "reading", "football", "chess"};

    private int[] colorHouse = new int[5];
    private int[] smokeHouse = new int[5];
    private int[] beverageHouse = new int[5];
    private int[] petHouse = new int[5];
    private int[] hobbyHouse = new int[5];

    boolean solve() {
        Arrays.fill(colorHouse, -1);
        Arrays.fill(smokeHouse, -1);
        Arrays.fill(beverageHouse, -1);
        Arrays.fill(petHouse, -1);
        Arrays.fill(hobbyHouse, -1);

        return solveHelper(0);
    }

    private boolean solveHelper(int houseIndex) {
        if (houseIndex == 5) {
            return checkConstraints();
        }

        for (int color : COLORS) {
            if (colorHouse[houseIndex] == -1) {
                colorHouse[houseIndex] = Arrays.asList(COLORS).indexOf(color);
                if (solveHelper(houseIndex + 1)) {
                    return true;
                }
                colorHouse[houseIndex] = -1;
            }
        }

        return false;
    }

    private boolean checkConstraints() {
        // Constraint 6: The green house is immediately to the right of the ivory house.
        for (int i = 0; i < 5; i++) {
            if (colorHouse[i] == Arrays.asList(COLORS).indexOf("ivory")) {
                if (i + 1 < 5 && colorHouse[i + 1] == Arrays.asList(COLORS).indexOf("green")) {
                    break;
                }
                return false;
            }
        }

        // Constraint 15: The Norwegian lives next to the blue house.
        int norwegianHouse = Arrays.asList(SMOKERS).indexOf("Norwegian");
        if (Math.abs(norwegianHouse - Arrays.asList(COLORS).indexOf("blue")) != 1) {
            return false;
        }

        // Constraint 9: The person in the middle house drinks milk.
        if (beverageHouse[2] != Arrays.asList(BEVERAGES).indexOf("milk")) {
            return false;
        }

        return true;
    }

    String getWaterDrinker() {
        if (!solve()) {
            throw new IllegalStateException("Failed to solve the puzzle");
        }
        int waterIndex = Arrays.asList(BEVERAGES).indexOf("water");
        return SMOKERS[beverageHouse[waterIndex]];
    }

    String getZebraOwner() {
        if (!solve()) {
            throw new IllegalStateException("Failed to solve the puzzle");
        }
        int zebraIndex = Arrays.asList(PETS).indexOf("zebra");
        return SMOKERS[petHouse[zebraIndex]];
    }
}
