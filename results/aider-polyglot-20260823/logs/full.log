phone-number.js
```javascript
export const clean = (input) => {
  // Reject any input containing letters
  if (/[a-zA-Z]/.test(input)) {
    throw new Error('Letters not permitted');
  }

  // Validate and strip punctuation
  let cleaned = '';
  for (let i = 0; i < input.length; i++) {
    const char = input[i];
    if (/\d/.test(char)) {
      cleaned += char;
    } else if ([' ', '(', ')', '-', '.', '!', '@', ':', ';', '+', ','].includes(char)) {
      continue;
    } else {
      throw new Error('Punctuation not permitted');
    }
  }

  // Check for errors that occur before digit counting
  if (cleaned.length < 10) {
    throw new Error('Incorrect number of digits');
  }

  if (cleaned.length > 11) {
    throw new Error('More than 11 digits');
  }

  // Handle country code
  if (cleaned.length === 11) {
    if (cleaned[0] !== '1') {
      throw new Error('11 digits must start with 1');
    }
    cleaned = cleaned.slice(1);
  }

  // Validate area code and exchange code
  if (cleaned[0] === '0') {
    throw new Error('Area code cannot start with zero');
  }
  if (cleaned[0] === '1') {
    throw new Error('Area code cannot start with one');
  }
  if (cleaned[3] === '0') {
    throw new Error('Exchange code cannot start with zero');
  }
  if (cleaned[3] === '1') {
    throw new Error('Exchange code cannot start with one');
  }

  return cleaned;
};
```
