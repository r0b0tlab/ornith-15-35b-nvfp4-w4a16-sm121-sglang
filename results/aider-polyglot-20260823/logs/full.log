use std::collections::HashSet;
use std::sync::Mutex;
use std::sync::OnceLock;

fn global_names() -> &'static Mutex<HashSet<String>> {
    static NAMED_ROBOTS: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
    NAMED_ROBOTS.get_or_init(|| Mutex::new(HashSet::new()))
}

pub struct Robot {
    name: String,
}

impl Robot {
    pub fn new() -> Self {
        let mut chars: String = (0..2)
            .map(|_| (b'A' + rand_first_char()) as char)
            .collect();
        let num = rand_num();
        for _ in 0..3 {
            chars.push((b'0' + (num % 10) as u8) as char);
            num /= 10;
        }
        let mut named_robots = global_names().lock().unwrap();
        while named_robots.contains(&chars) {
            chars.clear();
            for _ in 0..2 {
                chars.push((b'A' + rand_first_char()) as char);
            }
            let n2 = rand_num();
            for _ in 0..3 {
                chars.push((b'0' + (n2 % 10) as u8) as char);
                n2 /= 10;
            }
        }
        named_robots.insert(chars.clone());
        Robot { name: chars }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let mut chars: String = (0..2)
            .map(|_| (b'A' + rand_first_char()) as char)
            .collect();
        let num = rand_num();
        for _ in 0..3 {
            chars.push((b'0' + (num % 10) as u8) as char);
            num /= 10;
        }
        let mut named_robots = global_names().lock().unwrap();
        while named_robots.contains(&chars) {
            chars.clear();
            for _ in 0..2 {
                chars.push((b'A' + rand_first_char()) as char);
            }
            let n2 = rand_num();
            for _ in 0..3 {
                chars.push((b'0' + (n2 % 10) as u8) as char);
                n2 /= 10;
            }
        }
        named_robots.insert(chars.clone());
        self.name = chars;
    }
}

fn rand_first_char() -> u8 {
    (std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 26) as u8
}

fn rand_num() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 1000
}
