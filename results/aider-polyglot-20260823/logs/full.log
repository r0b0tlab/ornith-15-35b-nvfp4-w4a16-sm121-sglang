package erratum

func Use(opener ResourceOpener, input string) error {
        var res *Resource
        var err error

        defer func() {
                if res != nil {
                        res.Close()
                }
        }()

        for {
                res, err = opener()
                if err == nil {
                        break
                }
                if _, ok := err.(*TransientError); ok {
                        continue
                }
                return err
        }

