```
class PhoneNumber {



    private final String number;



    PhoneNumber(String numberString) {

        String digits = numberString.replaceAll("\\D", "");



        if (digits.matches("[+].*")) {

            throw new IllegalArgumentException("Punctuations are not 
permitted");

        }



        if (digits.matches("[a-zA-Z].*")) {

            throw new IllegalArgumentException("Letters are not permitted");

        }



        int length = digits.length();



        if (length < 10) {

            throw new IllegalArgumentException("must not be fewer than 10 
digits");

        }



        if (length > 11) {

            throw new IllegalArgumentException("must not be greater than 11 
digits");

        }



        if (length == 11) {

            if (!digits.startsWith("1")) {

                throw new IllegalArgumentException("11 digits must start with 
country code 1");

            }

            digits = digits.substring(1);

        }



        // Now digits is 10 digits

        if (digits.charAt(0) < '2') {

            throw new IllegalArgumentException("area code must start with 2-9");

        }



        if (digits.charAt(3) < '2') {

            throw new IllegalArgumentException("exchange code must start with 
2-9");

        }



        this.number = digits;

    }



    String getNumber() {

        return number;

    }



}

```

