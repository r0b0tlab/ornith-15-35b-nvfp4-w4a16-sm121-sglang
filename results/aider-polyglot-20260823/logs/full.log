import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class ForthEvaluator {
    private final List<Integer> stack = new ArrayList<>();
    private final Map<String, java.util.function.Consumer<List<Integer>>> definitions = new HashMap<>();

    List<Integer> evaluateProgram(List<String> input) {
        stack.clear();
        definitions.clear();
        
        int i = 0;
        while (i < input.size()) {
            String line = input.get(i).trim();
            if (line.isEmpty()) {
                i++;
                continue;
            }
            
            String[] tokens = line.split("\\s+");
            for (String token : tokens) {
                executeToken(token);
            }
            
            i++;
        }
        
        return new ArrayList<>(stack);
    }

    private void executeToken(String token) {
        String lower = token.toLowerCase();
        
        // Check if it's a definition
        if (lower.equals(":")) {
            handleDefinition();
            return;
        }
        
        // Check if it's a number
        if (isNumber(token)) {
            stack.add(Integer.parseInt(token));
            return;
        }
        
        // Check if it's a defined word
        if (definitions.containsKey(lower)) {
            definitions.get(lower).accept(stack);
            return;
        }
        
        // Check built-in operations
        switch (lower) {
            case "+":
                arithmeticOperation(1, true);
                break;
            case "-":
                arithmeticOperation(-1, true);
                break;
            case "*":
                arithmeticOperation(1, true);
                break;
            case "/":
                arithmeticOperation(1, true);
                break;
            case "dup":
                if (stack.isEmpty()) {
                    throw new IllegalArgumentException("empty stack");
                }
                stack.add(stack.get(stack.size() - 1));
                break;
            case "drop":
                if (stack.isEmpty()) {
                    throw new IllegalArgumentException("empty stack");
                }
                stack.remove(stack.size() - 1);
                break;
            case "swap":
                if (stack.size() < 2) {
                    throw new IllegalArgumentException("empty stack");
                }
                int temp = stack.get(stack.size() - 1);
                stack.set(stack.size() - 1, stack.get(stack.size() - 2));
                stack.set(stack.size() - 2, temp);
                break;
            case "over":
                if (stack.size() < 2) {
                    throw new IllegalArgumentException("empty stack");
                }
                stack.add(stack.get(stack.size() - 2));
                break;
            default:
                throw new IllegalArgumentException("undefined word: " + token);
        }
    }

    private void arithmeticOperation(int value, boolean isOperator) {
        if (stack.size() < 2) {
            throw new IllegalArgumentException("empty stack");
        }
        int b = stack.remove(stack.size() - 1);
        int a = stack.remove(stack.size() - 1);
        
        int result;
        if (value == 1 && isOperator) {
            result = a + b;
        } else {
            result = a - b;
        }
        
        stack.add(result);
    }

    private void handleDefinition() {
        // This would need to be implemented based on the input format
    }

    private boolean isNumber(String token) {
        if (token.isEmpty()) {
            return false;
        }
        if (token.length() == 1 && (token.equals("+") || token.equals("-"))) {
            return false;
        }
        try {
            Integer.parseInt(token);
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }
}
