I'll implement the rectangle counting algorithm.

The approach: find all pairs of `+` corners that could form opposite corners of a rectangle, then verify the edges are valid (`-` for horizontal, `|` for vertical).

rectangles.js
```
export function count(grid) {
  if (!grid || grid.length === 0) {
    return 0;
  }

  const rows = grid.length;
  const cols = grid[0].length;

  // Collect all '+' positions
  const corners = [];
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (grid[r][c] === '+') {
        corners.push([r, c]);
      }
    }
  }

  let count = 0;

  // Check every pair of corners as potential diagonal (top-left, bottom-right)
  for (let i = 0; i < corners.length; i++) {
    for (let j = i + 1; j < corners.length; j++) {
      const [r1, c1] = corners[i];
      const [r2, c2] = corners[j];

      // Only consider pairs that form a proper diagonal (top-left & bottom-right)
      if (r1 < r2 && c1 < c2) {
        // Check the other two corners exist
        if (grid[r1][c2] === '+' && grid[r2][c1] === '+') {
          // Check top and bottom edges (horizontal)
          let valid = true;
          for (let c = c1; c <= c2; c++) {
            if (grid[r1][c] !== '+' && grid[r1][c] !== '-') {
              valid = false;
              break;
            }
            if (grid[r2][c] !== '+' && grid[r2][c] !== '-') {
              valid = false;
              break;
            }
          }
          if (!valid) continue;

          // Check left and right edges (vertical)
          for (let r = r1; r <= r2; r++) {
            if (grid[r][c1] !== '+' && grid[r][c1] !== '|') {
              valid = false;
              break;
            }
            if (grid[r][c2] !== '+' && grid[r][c2] !== '|') {
              valid = false;
              break;
            }
          }
          if (valid) {
            count++;
          }
        }
      }
    }
  }

  return count;
}
```
