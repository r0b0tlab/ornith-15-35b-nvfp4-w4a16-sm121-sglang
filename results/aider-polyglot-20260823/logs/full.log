const belowTwenty = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine',
  'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
  'seventeen', 'eighteen', 'nineteen'
];

const tens = [
  '', 'ten', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'
];

const scales = ['', 'thousand', 'million', 'billion'];

const twoDigitToWords = (num) => {
  if (num < 20) {
    return belowTwenty[num];
  } else {
    const ten = Math.floor(num / 10);
    const one = num % 10;
    if (one === 0) {
      return tens[ten];
    } else {
      return `${tens[ten]}-${belowTwenty[one]}`;
    }
  }
};

const threeDigitToWords = (num) => {
  const hundred = Math.floor(num / 100);
  const remainder = num % 100;

  let result = '';
  if (hundred > 0) {
    result += `${belowTwenty[hundred]} hundred`;
    if (remainder > 0) {
      result += ' ';
    }
  }

  if (remainder > 0) {
    if (remainder < 20) {
      result += belowTwenty[remainder];
    } else {
      result += twoDigitToWords(remainder);
    }
  }

  return result;
};

const chunkToWords = (chunk, scaleIndex) => {
  const hundred = Math.floor(chunk / 100);
  const remainder = chunk % 100;

  let result = '';
  if (hundred > 0) {
    result += `${belowTwenty[hundred]} hundred`;
    if (remainder > 0) {
      result += ' ';
    }
  }

  if (remainder > 0) {
    if (remainder < 20) {
      result += belowTwenty[remainder];
    } else {
      result += twoDigitToWords(remainder);
    }
  }

  if (scaleIndex > 0 && result !== '') {
    result += ` ${scales[scaleIndex]}`;
  }

  return result;
};

export const say = (n) => {
  if (typeof n !== 'number' || !Number.isInteger(n)) {
    throw new Error('Input must be an integer');
  }

  if (n < 0 || n > 999999999999) {
    throw new Error('Input must be between 0 and 999,999,999,999');
  }

  if (n === 0) {
    return 'zero';
  }

  const chunks = [];
  let current = n;
  let scaleIndex = 0;

  while (current > 0) {
    chunks.push(current % 1000);
    current = Math.floor(current / 1000);
    scaleIndex++;
  }

  const parts = [];
  for (let i = chunks.length - 1; i >= 0; i--) {
    const chunk = chunks[i];
    if (chunk > 0) {
      const scaleIndex = i;
      const words = chunkToWords(chunk, scaleIndex);
      if (words) {
        parts.push(words);
      }
    }
  }

  return parts.join(' ');
};
