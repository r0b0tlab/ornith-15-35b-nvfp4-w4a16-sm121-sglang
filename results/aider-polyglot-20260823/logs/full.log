package hexadecimal

import "errors"

func ParseHex(in string, out int64, errCase string) error {
	if len(in) == 0 {
		return errors.New("empty hex string")
	}

	var result int64 = 0
	for _, ch := range in {
		var digit int64
		switch {
		case ch >= '0' && ch <= '9':
			digit = int64(ch - '0')
