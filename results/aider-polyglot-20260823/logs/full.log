Queen.java
```
class Queen {

    private final int row;
    private final int column;

    Queen(int row, int column) {
        if (row < 0) {
            throw new IllegalArgumentException("Queen must have a positive row");
        }
        if (column < 0) {
            throw new IllegalArgumentException("Queen must have a positive column");
        }
        if (row > 7) {
            throw new IllegalArgumentException("Queen must have a row on the board");
        }
        if (column > 7) {
            throw new IllegalArgumentException("Queen must have a column on the board");
        }
        this.row = row;
        this.column = column;
    }

    int row() {
        return row;
    }

    int column() {
        return column;
    }
}
```

QueenAttackCalculator.java
```
class QueenAttackCalculator {

    private final int row1;
    private final int column1;
    private final int row2;
    private final int column2;

    QueenAttackCalculator(Queen queen1, Queen queen2) {
        if (queen1.row() == queen2.row() && queen1.column() == queen2.column()) {
            throw new IllegalArgumentException("Queens cannot occupy the same square");
        }

        this.row1 = queen1.row();
        this.column1 = queen1.column();
        this.row2 = queen2.row();
        this.column2 = queen2.column();
    }

    boolean canQueensAttackOneAnother() {
        return row1 == row2 ||
               column1 == column2 ||
               Math.abs(row1 - row2) == Math.abs(column1 - column2);
    }
}
```
