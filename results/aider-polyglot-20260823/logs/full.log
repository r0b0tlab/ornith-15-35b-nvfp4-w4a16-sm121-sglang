// Forth evaluates a Forth program given as input lines.
func Forth(input []string) ([]int, error) {
	var stack []int
	// Store custom word definitions
	words := make(map[string][]int)

	for _, line := range input {
		tokens := tokenize(line)
		if len(tokens) == 0 {
			continue
		}

		// Check if this is a definition
		if tokens[0] == ":" {
			// Definition syntax: : name ;
			if len(tokens) < 3 || tokens[len(tokens)-1] != ";" {
				return nil, errInvalidSyntax
			}
			name := strings.ToLower(tokens[1])
			// Can't redefine a built-in command
			if isBuiltin(name) {
				return nil, errInvalidSyntax
			}
			// Parse the definition into tokens, resolving custom words
			def := tokens[2 : len(tokens)-1]
			// Store the raw tokens for later expansion
			words[name] = def
			continue
		}

		// Execute the command
		if err := execute(tokens, &stack, words); err != nil {
			return nil, err
		}
	}

	return stack, nil
}
