pig_latin.py
```python
def translate(text):
    """
    Translate text from English to Pig Latin.
    
    Rules:
    1. If a word begins with a vowel, or starts with "xr" or "yt", add "ay" to the end.
    2. If a word begins with consonants, move them to the end and add "ay".
    3. If a word starts with consonants followed by "qu", move those and "qu" to the end and add "ay".
    4. If a word starts with consonants followed by "y", move the consonants before "y" to the end and add "ay".
    """
    vowels = "aeiou"
    
    def translate_word(word):
        # Rule 1: begins with a vowel, or starts with "xr" or "yt"
        if word.startswith("xr") or word.startswith("yt"):
            return word + "ay"
        if word[0] in vowels:
            return word + "ay"
        
        # Rule 3: starts with consonants followed by "qu"
        # Find the position of "qu" and handle it
        for i in range(len(word)):
            if word[i] == 'y' and i > 0:
                # Rule 4: consonants followed by "y"
                return word[i:] + word[:i] + "ay"
            if word[i:i+2] == "qu":
                # Rule 3: consonants followed by "qu"
                return word[i+2:] + word[:i+2] + "ay"
            if word[i] in vowels:
                # Rule 2: single or multiple consonants
                return word[i:] + word[:i] + "ay"
        
        # If no vowel found, just add "ay"
        return word + "ay"
    
    words = text.split()
    translated = [translate_word(word) for word in words]
    return ' '.join(translated)
```
