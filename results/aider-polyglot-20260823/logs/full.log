from collections import deque

class Board:
    """Count territories of each player in a Go game

    Args:
        board (list[str]): A two-dimensional Go board
    """

    def __init__(self, board):
        self.board = [list(row) for row in board]
        self.height = len(board)
        self.width = len(board[0]) if self.height > 0 else 0

    def territory(self, x, y):
        """Find the owner and the territories given a coordinate on
           the board

        Args:
            x (int): Column on the board
            y (int): Row on the board

        Returns:
            (str, set): A tuple, the first element being the owner
                        of that area.  One of "W", "B", "".  The
                        second being a set of coordinates, representing
                        the owner's territories.
        """
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            raise ValueError('Invalid coordinate')

        # If the coordinate is on a stone, return the stone's owner with empty territory
        if self.board[y][x] != ' ':
            return self.board[y][x], set()

        # Otherwise, flood fill to find the territory and its bordering stones
        owner = ""
        territory = set()
        stack = [(x, y)]
        visited = {(x, y)}
        border_stones = set()

        while stack:
            cx, cy = stack.pop()
            territory.add((cx, cy))

            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < self.width and 0 <= ny < self.height:
                    neighbor = self.board[ny][nx]
                    if neighbor == ' ':
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            stack.append((nx, ny))
                    else:
                        border_stones.add(neighbor)

        # The territory is owned by the player if it's bordered by exactly one color
        if len(border_stones) == 1:
            owner = border_stones.pop()

        return owner, territory

    def territories(self):
        """Find the owners and the territories of the whole board

        Args:
            none

        Returns:
            dict(str, set): A dictionary whose key being the owner
                        , i.e. "W", "B", "".  The value being a set
                        of coordinates owned by the owner.
        """
        territories = {"W": set(), "B": set(), "": set()}
        visited = set()

        for y in range(self.height):
            for x in range(self.width):
                if (x, y) not in visited:
                    owner, territory = self.xterritory(x, y)
                    visited |= territory
                    if owner in territories:
                        territories[owner] |= territory
                    else:
                        territories[owner] = territory

        return territories

    def xterritory(self, x, y):
        """Helper to compute territory without revisiting already-known areas"""
        if x < 0 or x >= self.width or y < 0 or y >= self.height:
            raise ValueError('Invalid coordinate')

        if self.board[y][x] != ' ':
            return self.board[y][x], set()

        owner = ""
        territory = set()
        stack = [(x, y)]
        visited = set()
        border_stones = set()

        while stack:
            cx, cy = stack.pop()
            territory.add((cx, cy))
            visited.add((cx, cy))

            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx, ny = cx + dx, cy + dy
                if 0 <= nx < self.width and 0 <= ny < self.height:
                    neighbor = self.board[ny][nx]
                    if neighbor == ' ':
                        if (nx, ny) not in visited:
                            visited.add((nx, ny))
                            stack.append((nx, ny))
                    else:
                        border_stones.add(neighbor)

        if len(border_stones) == 1:
            owner = border_stones.pop()

        return owner, territory
