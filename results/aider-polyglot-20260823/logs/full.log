```rust
use std::str::Chars;

fn parse_command(command: &str) -> Option<Vec<String>> {
    let command = command.trim();
    if !command.starts_with("What is") {
        return None;
    }

    let command = &command["What is".len()..];
    let command = command.trim_start();

    if command.ends_with('?') {
        let command = &command[..command.len() - 1];
        Some(command.split_whitespace().map(|s| s.to_string()).collect())
    } else {
        None
    }
}

fn evaluate_command(command: &str) -> Option<i32> {
    let tokens = parse_command(command)?;
    if tokens.is_empty() {
        return None;
    }

    let mut result = tokens[0].parse::<i32>().ok()?;
    let mut i = 1;

    while i < tokens.len() {
        let op = &tokens[i];
        let num = tokens[i + 1].parse::<i32>().ok()?;

        match op.as_str() {
            "plus" => result += num,
            "minus" => result -= num,
            "multiplied" => {
                if i + 2 < tokens.len() && tokens[i + 2] == "by" {
                    result *= num;
                    i += 1;
                } else {
                    return None;
                }
            }
            "divided" => {
                if i + 2 < tokens.len() && tokens[i + 2] == "by" {
                    result /= num;
                    i += 1;
                } else {
                    return None;
                }
            }
            "power" => {
                if i + 3 < tokens.len() && tokens[i + 2] == "to" && tokens[i + 3] == "th" {
                    result = result.pow(num as u32);
                    i += 3;
                } else {
                    return None;
                }
            }
            _ => return None,
        }

        i += 2;
    }

    Some(result)
}

pub fn answer(command: &str) -> Option<i32> {
    evaluate_command(command)
}
```
