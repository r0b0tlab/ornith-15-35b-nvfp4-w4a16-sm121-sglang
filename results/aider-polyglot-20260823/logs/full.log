```javascript
export const encode = (phrase, key) => {
  const { a, b } = key;
  
  // Check if a and m are coprime
  if (gcd(a, 26) !== 1) {
    throw new Error('a and m must be coprime.');
  }
  
  const m = 26;
  let result = '';
  let count = 0;
  
  for (const char of phrase.toLowerCase()) {
    if (char >= 'a' && char <= 'z') {
      const i = char.charCodeAt(0) - 'a'.charCodeAt(0);
      const encrypted = (a * i + b) % m;
      const encryptedChar = String.fromCharCode(encrypted + 'a'.charCodeAt(0));
      
      if (count > 0 && count % 5 === 0) {
        result += ' ';
      }
      result += encryptedChar;
      count++;
    } else if (char >= '0' && char <= '9') {
      if (count > 0 && count % 5 === 0) {
        result += ' ';
      }
      result += char;
      count++;
    }
  }
  
  return result;
};

export const decode = (phrase, key) => {
  const { a, b } = key;
  
  // Check if a and m are coprime
  if (gcd(a, 26) !== 1) {
    throw new Error('a and m must be coprime.');
  }
  
  // Find the modular multiplicative inverse of a
  const aInverse = modInverse(a, 26);
  
  const m = 26;
  let result = '';
  
  for (const char of phrase.toLowerCase()) {
    if (char >= 'a' && char <= 'z') {
      const y = char.charCodeAt(0) - 'a'.charCodeAt(0);
      const decrypted = (aInverse * (y - b)) % m;
      const decryptedChar = String.fromCharCode((decrypted + m) % m + 'a'.charCodeAt(0));
      result += decryptedChar;
    } else if (char >= '0' && char <= '9') {
      result += char;
    }
  }
  
  return result;
};

// Helper function to calculate the greatest common divisor
function gcd(a, b) {
  return b === 0 ? a : gcd(b, a % b);
}

// Helper function to find the modular multiplicative inverse
function modInverse(a, m) {
  for (let x = 1; x < m; x++) {
    if ((a * x) % m === 1) {
      return x;
    }
  }
  return null;
}
