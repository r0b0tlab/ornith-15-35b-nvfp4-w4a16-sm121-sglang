```
import org.json.JSONObject;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class RestApi {
    private final Map<String, User> users = new HashMap<>();

    RestApi(User... users) {
        for (User user : users) {
            this.users.put(user.name(), user);
        }
    }

    String get(String url) {
        if ("/users".equals(url)) {
            List<User> allUsers = new ArrayList<>(users.values());
            allUsers.sort(Comparator.comparing(User::name));
            JSONObject response = new JSONObject();
            response.put("users", allUsers);
            return response.toString();
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    String get(String url, JSONObject payload) {
        if ("/users".equals(url)) {
            List<String> requestedNames = payload.getJSONArray("users").toList().stream()
                    .map(String::new)
                    .sorted()
                    .collect(java.util.stream.Collectors.toList());
            List<User> users = new ArrayList<>();
            for (String name : requestedNames) {
                User user = this.users.get(name);
                if (user != null) {
                    users.add(user);
                }
            }
            JSONObject response = new JSONObject();
            response.put("users", users);
            return response.toString();
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    String post(String url, JSONObject payload) {
        if ("/add".equals(url)) {
            String name = payload.getString("user");
            User user = User.builder().setName(name).build();
            users.put(name, user);
            return user.toString();
        } else if ("/iou".equals(url)) {
            String lenderName = payload.getString("lender");
            String borrowerName = payload.getString("borrower");
            double amount = payload.getDouble("amount");
            handleIou(lenderName, borrowerName, amount);
            List<User> result = new ArrayList<>();
            if (users.containsKey(lenderName)) {
                result.add(users.get(lenderName));
            }
            if (users.containsKey(borrowerName)) {
                result.add(users.get(borrowerName));
            }
            result.sort(Comparator.comparing(User::name));
            JSONObject response = new JSONObject();
            response.put("users", result);
            return response.toString();
        }
        throw new IllegalArgumentException("Unknown URL: " + url);
    }

    private void handleIou(String lenderName, String borrowerName, double amount) {
        User lender = users.get(lenderName);
        User borrower = users.get(borrowerName);
        if (lender == null || borrower == null) {
            throw new IllegalArgumentException("User not found.");
        }

        if (lender.name().equals(borrower.name())) {
            return;
        }

        // Update borrower's debt: they now owe the lender
        Builder borrowerBuilder = borrower.builder();
        for (Iou iou : borrower.owes()) {
            if (iou.name().equals(lenderName)) {
                double newAmount = iou.amount() + amount;
                borrowerBuilder.owes(lenderName, newAmount);
                continue;
            }
            borrowerBuilder.owes(iou.name(), iou.amount());
        }
        for (Iou iou : borrower.owedBy()) {
            borrowerBuilder.owedBy(iou.name(), iou.amount());
        }
        if (!borrower.owes().stream().anyMatch(iou -> iou.name().equals(lenderName))) {
            borrowerBuilder.owes(lenderName, amount);
        }

        // Update lender's credit: the borrower now owes them
        Builder lenderBuilder = lender.builder();
        for (Iou iou : lender.owedBy()) {
            if (iou.name().equals(borrowerName)) {
                double newAmount = iou.amount() + amount;
                lenderBuilder.owedBy(borrowerName, newAmount);
                continue;
            }
            lenderBuilder.owedBy(iou.name(), iou.amount());
        }
        for (Iou iou : lender.owes()) {
            lenderBuilder.owes(iou.name(), iou.amount());
        }
        if (!lender.owedBy().stream().anyMatch(iou -> iou.name().equals(borrowerName))) {
            lenderBuilder.owedBy(borrowerName, amount);
        }

        users.put(lenderName, lenderBuilder.build());
        users.put(borrowerName, borrowerBuilder.build());
    }
}
