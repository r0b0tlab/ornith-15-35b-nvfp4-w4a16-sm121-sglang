func (f *vm) swap() error {
	if len(f.stack) < 2 {
		return errStackUnderflow
	}
	f.stack[len(f.stack)-1], f.stack[len(f.stack)-2] = f.stack[len(f.stack)-2], f.stack[len(f.stack)-1]
	return nil
}

func (f *vm) over() error {
	if len(f.stack) < 2 {
		return errStackUnderflow
	}
	b := f.stack[len(f.stack)-2]
	f.stack = append(f.stack, b)
	return nil
}
