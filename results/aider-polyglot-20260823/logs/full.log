#pragma once

#include <stdexcept>

namespace linked_list {

template <typename T>
class List {
public:
    struct Node {
        T data;
        Node* prev;
        Node* next;
        Node(T data_) : data(data_), prev(nullptr), next(nullptr) {}
    };

    void push(T value);
    T pop();
    T shift();
    void unshift(T value);
    int count();
    bool erase(T value);

private:
    Node* head;
    Node* tail;
    int node_count;
};

}  // namespace linked_list
