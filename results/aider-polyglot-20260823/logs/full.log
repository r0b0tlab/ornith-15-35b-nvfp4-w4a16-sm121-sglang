# Game status categories
# Change the values as you see fit
STATUS_WIN = 'win'
STATUS_LOSE = 'lose'
STATUS_ONGOING = 'ongoing'


class Hangman:
    def __init__(self, word):
        self.word = word
        self.remaining_guesses = 9
        self.status = STATUS_ONGOING
        self.masked = ['_'] * len(word)  # Track which characters have been revealed
        self.guessed = set()  # Track all unique characters the player has guessed

    def guess(self, char):
        if self.status != STATUS_ONGOING:
            raise ValueError("The game has already ended.")

        # If the character was already guessed, it counts as a wrong guess
        if char in self.guessed:
            self.remaining_guesses -= 1
            if self.remaining_guesses < 0:
                self.status = STATUS_LOSE
            return

        self.guessed.add(char)

        if char in self.word:
            # Reveal all occurrences of this character
            for i, c in enumerate(self.word):
                if c == char:
                    self.masked[i] = char
            # Check for win
            if '_' not in self.masked:
                self.status = STATUS_WIN
        else:
            # Wrong guess
            self.remaining_guesses -= 1
            if self.remaining_guesses < 0:
                self.status = STATUS_LOSE

    def get_masked_word(self):
        return ''.join(self.masked)

    def get_status(self):
        return self.status


