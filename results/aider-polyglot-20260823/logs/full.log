    this._callbacks.delete(cb);
  }

  _computeValue() {
    this._value = this._fn(...this._inputCells.map(cell => cell.value));
  }

  runCallbacks() {
    for (const cb of [...this._callbacks]) {
      cb(this._value);
    }
  }
}

export class CallbackCell {
  constructor(fn) {
    this._fn = fn;
    this._value = fn();
    this._callbacks = new Set();
  }

  addCallback(cb) {
    this._callbacks.add(cb);
  }

  removeCallback(cb) {
    this._callbacks.delete(cb);
  }

  runCallbacks() {
    for (const cb of [...this._callbacks]) {
      cb(this._value);
    }
  }
}
