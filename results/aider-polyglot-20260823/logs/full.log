```rust
pub fn abbreviate(phrase: &str) -> String {
    let mut acronym = String::new();
    let mut is_new_word = true;
    let mut prev_was_lowercase = false;

    for c in phrase.chars() {
        if c.is_whitespace() || c == '-' {
            is_new_word = true;
            prev_was_lowercase = false;
        } else if c.is_alphabetic() {
            if is_new_word {
                acronym.push(c.to_uppercase().next().unwrap());
                is_new_word = false;
                prev_was_lowercase = c.is_lowercase();
            } else if c.is_uppercase() && prev_was_lowercase {
                // Transition from lowercase to uppercase within a word
                acronym.push(c);
                prev_was_lowercase = false;
            } else if c.is_lowercase() {
                prev_was_lowercase = true;
            }
        }
    }

    acronym
}
```

