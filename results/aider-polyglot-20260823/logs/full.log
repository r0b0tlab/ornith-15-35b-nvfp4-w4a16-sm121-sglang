//
// This is only a SKELETON file for the 'Rest API' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class User {
  constructor(name) {
    this.name = name;
    this.owes = {};
    this.owed_by = {};
    this.balance = 0;
  }
}

class Database {
  constructor() {
    this.users = {};
  }

  addUser(name) {
    if (!this.users[name]) {
      this.users[name] = new User(name);
    }
    return this.users[name];
  }

  getUser(name) {
    return this.users[name] || null;
  }
}

export class RestAPI {
  constructor(database) {
    this.db = database || new Database();
    // Ensure the database has the necessary methods
    if (!this.db.addUser || !this.db.getUser) {
      // Create a wrapper that adds the missing methods
      const originalDb = this.db;
      this.db = {
        users: originalDb.users || {},
        addUser: function(name) {
          if (!this.users[name]) {
            this.users[name] = new User(name);
          }
          return this.users[name];
        },
        getUser: function(name) {
          return this.users[name] || null;
        }
      };
    }
  }

  get(url) {
    const [path, query] = url.split('?');
    const params = new URLSearchParams(query || '');

    if (path === '/users') {
      const userParam = params.get('users');
      if (!userParam) {
        return { users: [] };
      }
      const userNames = userParam.split(',');
      const users = userNames.map(name => this.buildUserObject(name));
      return { users };
    }

    return {};
  }

  post(url, payload) {
    if (url === '/add') {
      const { user } = payload;
      const newUser = this.db.addUser(user);
      return this.buildUserObject(user);
    }

    if (url === '/iou') {
      const { lender, borrower, amount } = payload;
      this.processIOU(lender, borrower, amount);
      return {
        users: [
          this.buildUserObject(lender),
          this.buildUserObject(borrower)
        ]
      };
    }

    return {};
  }

  processIOU(lender, borrower, amount) {
    const lenderUser = this.db.addUser(lender);
    const borrowerUser = this.db.addUser(borrower);

    // Update balances
    lenderUser.owed_by[borrower] = (lenderUser.owed_by[borrower] || 0) + amount;
    borrowerUser.owes[lender] = (borrowerUser.owes[lender] || 0) + amount;

    // Calculate new balances
    this.calculateBalance(lenderUser);
    this.calculateBalance(borrowerUser);
  }

  calculateBalance(user) {
    let owedByTotal = 0;
    let owesTotal = 0;

    Object.values(user.owed_by).forEach(amount => owedByTotal += amount);
    Object.values(user.owes).forEach(amount => owesTotal += amount);

    user.balance = owedByTotal - owesTotal;
  }

  buildUserObject(name) {
    const user = this.db.getUser(name);
    if (!user) return null;

    return {
      name: user.name,
      owes: user.owes,
      owed_by: user.owed_by,
      balance: user.balance
    };
  }
}
