variable_length_quantity.py
```python
def encode(numbers):
    """Encode a list of integers as variable length quantities."""
    result = []
    for number in numbers:
        if number < 0 or number > 0xFFFFFFFF:
            raise ValueError("value must be a 32-bit unsigned integer")
        if number == 0:
            result.append(0x00)
            continue
        
        # Split into 7-bit groups, most significant group first
        groups = []
        while number > 0:
            groups.append(number & 0x7F)
            number >>= 7
        
        # Reverse so most significant group comes first
        groups.reverse()
        
        # Set the high bit on all groups except the last one
        for i in range(len(groups) - 1):
            groups[i] |= 0x80
        
        result.extend(groups)
    
    return result


def decode(bytes_):
    """Decode a variable length quantity sequence into integers."""
    if not bytes_:
        return []
    
    result = []
    current = 0
    incomplete = False
    
    for byte in bytes_:
        current = (current << 7) | (byte & 0x7F)
        
        if byte & 0x80:
            # More bytes coming
            incomplete = True
        else:
            # This is the last byte of the sequence
            result.append(current)
            current = 0
            incomplete = False
    
    # If we ended mid-sequence, the sequence is incomplete
    if incomplete:
        raise ValueError("incomplete sequence")
    
    return result
```
