class ResistorColorTrio {
    private static final String[] COLORS = {
        "black", "brown", "red", "orange", "yellow",
        "green", "blue", "violet", "grey", "white"
    };

    String label(String[] colors) {
        long value = valueOf(colors);
        return formatLabel(value);
    }

    private long valueOf(String[] colors) {
        int first = colorValue(colors[0]);
        int second = colorValue(colors[1]);
        int zeros = colorValue(colors[2]);

        long mainValue = first * 10 + second;
        long value = mainValue;
        for (int i = 0; i < zeros; i++) {
            value *= 10;
        }
        return value;
    }

    private int colorValue(String color) {
        for (int i = 0; i < COLORS.length; i++) {
            if (COLORS[i].equals(color)) {
                return i;
            }
        }
        throw new IllegalArgumentException("Unknown color: " + color);
    }

    private String formatLabel(long value) {
        if (value >= 1_000_000_000L && value % 1_000_000_000L == 0) {
            return (value / 1_000_000_000L) + " gigaohms";
        }
        if (value >= 1_000_000L && value % 1_000_000L == 0) {
            return (value / 1_000_000L) + " megaohms";
        }
        if (value >= 1_000L && value % 1_000L == 0) {
            return (value / 1_000L) + " kiloohms";
        }
        return value + " ohms";
    }
}
