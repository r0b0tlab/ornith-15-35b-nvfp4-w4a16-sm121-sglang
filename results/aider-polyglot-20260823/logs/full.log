Actually, `std::mem::take` requires the type to implement `Default`. For `String`, that's the case. So I can use `std::mem::take(&mut current)`.

```rust
fn tokenize(&self, input: &str) -> Vec<String> {
    let mut tokens = Vec::new();
    let mut current = String::new();
    
    for c in input.chars() {
        if c.is_whitespace() {
            if !current.is_empty() {
                tokens.push(std::mem::take(&mut current));
            }
        } else {
            current.push(c);
        }
    }
    
    if !current.is_empty() {
        tokens.push(current);
    }
    
    tokens
}
```

