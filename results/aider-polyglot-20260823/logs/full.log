2. Return the first and last letter locations for each found word
3. Return `null` for words not found

Here's my implementation:

WordSearcher.java
```java
import java.util.Map;
import java.util.Optional;
import java.util.Set;
import java.util.HashMap;

class WordSearcher {
    Map<String, Optional<WordLocation>> search(final Set<String> words, final char[][] grid) {
        Map<String, Optional<WordLocation>> result = new HashMap<>();
        
        for (String word : words) {
            result.put(word, findWord(word, grid));
        }
        
        return result;
    }
    
    private Optional<WordLocation> findWord(String word, char[][] grid) {
        int rows = grid.length;
        int cols = grid[0].length;
        
        // Try all 8 directions: right, left, down, up, and 4 diagonals
        int[][] directions = {
            {0, 1},    // right
            {0, -1},   // left
            {1, 0},    // down
            {-1, 0},   // up
            {1, 1},    // diagonal down-right
            {1, -1},   // diagonal down-left
            {-1, 1},   // diagonal up-right
            {-1, -1}   // diagonal up-left
        };
        
        for (int row = 0; row < rows; row++) {
            for (int col = 0; col < cols; col++) {
                for (int[] dir : directions) {
                    Optional<WordLocation> result = searchFromWord(word, grid, row, col, dir[0], dir[1]);
                    if (result.isPresent()) {
                        return result;
                    }
                }
            }
        }
        
        return Optional.empty();
    }
    
    private Optional<WordLocation> searchFromWord(String word, char[][] grid, int startRow, int startCol, int dirRow, int dirCol) {
        int rows = grid.length;
        int cols = grid[0].length;
        
        // Check if word fits in this direction
        int wordLength = word.length();
        int endRow = startRow + (wordLength - 1) * dirRow;
        int endCol = startCol + (wordLength - 1) * dirCol;
        
        // Bounds check
        if (endRow < 0 || endRow >= rows || endCol < 0 || endCol >= cols) {
            return Optional.empty();
        }
        
        // Check if the word matches starting at this position
        for (int i = 0; i < wordLength; i++) {
            int currentRow = startRow + i * dirRow;
            int currentCol = startCol + i * dirCol;
            if (grid[currentRow][currentCol] != word.charAt(i)) {
                return Optional.empty();
            }
        }
        
        // Word found, return first and last positions
        WordLocation first = new WordLocation(startRow, startCol);
        WordLocation last = new WordLocation(endRow, endCol);
        
        return Optional.of(new WordLocation(first, last));
    }
}
```

WordLocation.java
```java
class WordLocation {
    private final int row;
    private final int column;
    private final WordLocation first;
    private final WordLocation last;
    
    // Single location constructor
    public WordLocation(int row, int column) {
        this.row = row;
        this.column = column;
        this.first = null;
        this.last = null;
    }
    
    // First and last location constructor
    public WordLocation(WordLocation first, WordLocation last) {
        this.first = first;
        this.last = last;
    }
    
    public int getRow() {
        return row;
    }
    
    public int getColumn() {
        return column;
    }
    
    public WordLocation getFirst() {
        return first;
    }
    
    public WordLocation getLast() {
        return last;
    }
}
```

