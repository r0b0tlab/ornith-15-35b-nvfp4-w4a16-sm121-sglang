bowling.js
```
//
// This is only a SKELETON file for the 'Bowling' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class Bowling {
  constructor() {
    this.rolls = [];
    this.frameStart = 0;
  }

  roll(pins) {
    if (pins < 0 || pins > 10) {
      throw new Error('Invalid roll');
    }
    this.rolls.push(pins);
    this._advanceFrame();
  }

  score() {
    if (this.frameStart >= this.rolls.length) {
      throw new Error('Game not complete');
    }

    let score = 0;
    let frameIndex = this.frameStart;

    for (let frame = 0; frame < 10; frame++) {
      if (frameIndex >= this.rolls.length) {
        throw new Error('Game not complete');
      }

      if (this.rolls[frameIndex] === 10) {
        // Strike
        score += 10;
        if (frameIndex + 2 > this.rolls.length) {
          throw new Error('Game not complete');
        }
        score += this.rolls[frameIndex + 1] + this.rolls[frameIndex + 2];
        frameIndex += 1;
      } else if (frameIndex + 1 < this.rolls.length &&
                 this.rolls[frameIndex] + this.rolls[frameIndex + 1] === 10) {
        // Spare
        score += 10;
        if (frameIndex + 2 > this.rolls.length) {
          throw new Error('Game not complete');
        }
        score += this.rolls[frameIndex + 2];
        frameIndex += 2;
      } else {
        // Open frame
        if (frameIndex + 1 >= this.rolls.length) {
          throw new Error('Game not complete');
        }
        score += this.rolls[frameIndex] + this.rolls[frameIndex + 1];
        frameIndex += 2;
      }
    }

    this.frameStart = frameIndex;
    return score;
  }

  _advanceFrame() {
    while (this.frameStart < this.rolls.length) {
      if (this.rolls[this.frameStart] === 10) {
        break;
      }
      if (this.frameStart + 1 >= this.rolls.length) {
        break;
      }
      if (this.rolls[this.frameStart] + this.rolls[this.frameStart + 1] >= 10) {
        break;
      }
      this.frameStart += 2;
    }
  }
}
