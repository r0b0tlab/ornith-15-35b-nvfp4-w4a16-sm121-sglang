+/// Helper iterator struct for `munge`
+struct XorIter<'a, I> {
+    key: &'a [u8],
+    position: usize,
+    inner: I,
+}
+
+impl<'a, I: Iterator> Iterator for XorIter<'a, I>
+where
+    I: Iterator<Item = u8>,
+{
+    type Item = u8;
+
+    fn next(&mut self) -> Option<u8> {
+        self.inner.next().map(|byte| {
+            let result = byte ^ self.key[self.position];
+            self.position = (self.position + 1) % self.key.len();
+            result
+        })
+    }
+}
+
+/// Reader adaptor that XORs incoming data with the key
+struct XorReader<'a> {
+    key: &'a [u8],
+    position: usize,
+    inner: Box<dyn Read + 'a>,
+}
+
+impl Read for XorReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        self.inner.read(buf)?;
+        let len = buf.len();
+        for (i, byte) in buf[..len].iter_mut().enumerate() {
+            *byte ^= self.key[self.position];
+            self.position = (self.position + 1) % self.key.len();
+        }
+        Ok(len)
+    }
+}
+
+/// Writer adaptor that XORs outgoing data with the key
+struct XorWriter<'a> {
+    key: &'a [u8],
+    position: usize,
+    inner: Box<dyn Write + 'a>,
+}
+
+impl Write for XorWriter<'_> {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        let mut copy = buf.to_vec();
+        for (i, byte) in copy.iter_mut().enumerate() {
+            *byte ^= self.key[self.position];
+            self.position = (self.position + 1) % self.key.len();
+        }
+        self.inner.write(&copy)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.inner.flush()
+    }
 }
 
