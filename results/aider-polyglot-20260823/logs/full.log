    fn fire_callbacks(&self) {
        let ids: Vec<CellId> = {
            let cells = self.cells.borrow();
            cells.keys().copied().collect()
        };
        for id in ids {
            if let Cell::Compute { listeners, value, .. } = &self.cells.borrow().get(&id).unwrap().data {
                let current = value.borrow();
                let listeners = listeners.borrow();
                for (_id, cb) in listeners.iter() {
                    cb(current.clone());
                }
            }
        }
    }

    pub fn add_callback<F: FnMut(T)>(
        &mut self,
        id: ComputeCellId,
        callback: F,
    ) -> Option<CallbackId> {
        let cell_id = CellId::Compute(id);
        match self.cells.borrow_mut().get_mut(&cell_id) {
            Some(cell) => {
                let cb_id = CallbackId(self.next_id());
                if let Cell::Compute { listeners, .. } = &mut cell.data {
                    listeners.borrow_mut().push((cb_id, RefCell::new(Box::new(callback))));
                }
                Some(cb_id)
            }
            None => None,
        }
    }

    pub fn remove_callback(
        &mut self,
        cell: ComputeCellId,
        callback: CallbackId,
    ) -> Result<(), RemoveCallbackError> {
        let cell_id = CellId::Compute(cell);
        match self.cells.borrow_mut().get_mut(&cell_id) {
            Some(cell) => {
                if let Cell::Compute { listeners, .. } = &mut cell.data {
                    let mut listeners = listeners.borrow_mut();
                    if let Some(pos) = listeners.iter().position(|(id, _)| *id == callback) {
                        listeners.remove(pos);
                        return Ok(());
                    }
                    return Err(RemoveCallbackError::NonexistentCallback);
                }
                Err(RemoveCallbackError::NonexistentCallback)
            }
            None => Err(RemoveCallbackError::NonexistentCell),
        }
    }
}

impl<T> Cell<T> {
    fn value(&self) -> T {
        match &self.data {
            CellData::Input(v) => *v,
            CellData::Compute { value, .. } => value.borrow(),
        }
    }
}
