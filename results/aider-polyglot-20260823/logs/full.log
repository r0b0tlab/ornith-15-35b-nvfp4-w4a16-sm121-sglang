trinary.go
```go
package trinary

func ParseTrinary(arg string) int64 {
	var result int64 = 0
	for i := 0; i < len(arg); i++ {
		digit := int64(arg[i] - '0')
		if digit < 0 || digit > 2 {
			return 0
		}
		result = result*3 + digit
	}
	return result
}
```
