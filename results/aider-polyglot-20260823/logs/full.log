I'll implement VLQ encoding/decoding in Go. Let me explain the approach:

**Encoding**: Split each 32-bit value into 7-bit groups, process from least significant to most significant, setting bit 7 on all bytes except the last one.

**Decoding**: Read 7 bits from each byte, accumulating into a value. When a byte has bit 7 clear, it's the end of a quantity. If the input ends with bit 7 set, it's an incomplete sequence (error).

variable_length_quantity.go
```go
package variablelengthquantity

import "errors"

func EncodeVarint(input []uint32) []byte {
	output := make([]byte, 0)
	for _, value := range input {
		if value == 0 {
			output = append(output, 0x00)
			continue
		}

		var chunks []byte
		for value > 0 {
			chunks = append(chunks, byte(value&0x7f))
			value >>= 7
			if value > 0 {
				chunks[len(chunks)-1] |= 0x80
			}
		}

		// Reverse the chunks (most significant group last)
		for i, j := 0, len(chunks)-1; i < j; i, j = i+1, j-1 {
			chunks[i], chunks[j] = chunks[j], chunks[i]
		}
		output = append(output, chunks...)
	}
	return output
}

func DecodeVarint(input []byte) ([]uint32, error) {
	output := make([]uint32, 0)
	var value uint32
	found := false

	for _, b := range input {
		if b&0x80 != 0 {
			// More bytes follow
			if value&0xf8000000 != 0 {
				// Overflow: would exceed 32 bits
				return nil, errors.New("overflow")
			}
			value = (value << 7) | uint32(b&0x7f)
			found = false
		} else {
			// Final byte of this quantity
			value = (value << 7) | uint32(b&0x7f)
			output = append(output, value)
			value = 0
			found = true
		}
	}

	if !found {
		return nil, errors.New("incomplete sequence")
	}
	return output, nil
}
```
