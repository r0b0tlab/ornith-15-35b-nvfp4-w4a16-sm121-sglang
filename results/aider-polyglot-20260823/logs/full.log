Let me fix the `setRight` method to handle the null case properly:

Zipper.java
```java
class Zipper {
    int value;
    Zipper up;
    Zipper left;
    Zipper right;

    Zipper(int val) {
        this.value = val;
    }

    BinaryTree toTree() {
        if (up == null) {
            // We're at the root
            return new BinaryTree(this);
        }
        // Navigate to root
        Zipper current = this;
        while (current.up != null) {
            current = current.up;
        }
        return new BinaryTree(current);
    }

    int getValue() {
        return value;
    }

    Zipper setLeft(Zipper leftChild) {
        Zipper result = new Zipper(value);
        result.up = up;
        result.left = leftChild;
        if (leftChild != null) {
            leftChild.up = result;
        }
        if (right != null) {
            result.right = right;
            right.up = result;
        }
        if (up != null) {
            if (up.left == this) {
                up.left = result;
            } else {
                up.right = result;
            }
        }
        return result;
    }

    Zipper setRight(Zipper rightChild) {
        Zipper result = new Zipper(value);
        result.up = up;
        if (left != null) {
            result.left = left;
            left.up = result;
        }
        result.right = rightChild;
        if (rightChild != null) {
            rightChild.up = result;
        }
        if (up != null) {
            if (up.left == this) {
                up.left = result;
            } else {
                up.right = result;
            }
        }
        return result;
    }

    void setValue(int val) {
        this.value = val;
    }
}

class BinaryTree {
    Zipper root;

    BinaryTree(int value) {
        this.root = new Zipper(value);
    }

    BinaryTree(Zipper root) {
        this.root = root;
    }

    Zipper getRoot() {
        return root;
    }

    String printTree() {
        StringBuilder sb = new StringBuilder();
        printTree(root, sb, true);
        return sb.toString();
    }

    private void printTree(Zipper node, StringBuilder sb, boolean isRight) {
        if (node == null) {
            return;
        }
        if (isRight) {
            sb.append("(right ");
        } else {
            sb.append("(left ");
        }
        sb.append(node.getValue());
        if (node.left != null || node.right != null) {
            printTree(node.left, sb, false);
            printTree(node.right, sb, true);
        }
        sb.append(")");
    }
}
