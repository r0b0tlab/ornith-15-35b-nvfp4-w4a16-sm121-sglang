import random
import string

class Robot:
    _used_names = set()
    _available_names = None

    def __init__(self):
        self._name = self._generate_name()

    def _generate_name(self):
        # If we've exhausted all possible names, raise an error
        if not Robot._available_names:
            raise RuntimeError("All possible names have been used")

        # Generate a random name in the format: two uppercase letters + three digits
        while True:
            name = ''.join(random.choices(string.ascii_uppercase, k=2)) + \
                   ''.join(random.choices(string.digits, k=3))
            
            # Check for uniqueness
            if name not in Robot._used_names:
                Robot._used_names.add(name)
                return name

    @property
    def name(self):
        return self._name

    def reset(self):
        # Remove the current name from used names since the robot is being reset
        if self._name in Robot._used_names:
            Robot._used_names.discard(self._name)
        self._name = self._generate_name()


def reset_all():
    """Reset the factory settings - clears all used names."""
    Robot._used_names = set()
    Robot._available_names = None
```
