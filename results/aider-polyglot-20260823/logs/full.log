-    todo!("Convert the values {values:?} to a list of bytes")
+    let mut bytes = Vec::new();
+
+    for &value in values {
+        if value == 0 {
+            bytes.push(0);
+            continue;
+        }
+
+        let mut groups: Vec<u8> = Vec::new();
+        let mut n = value;
+
+        while n > 0 {
+            groups.push((n & 0x7f) as u8);
+            n >>= 7;
+        }
+
+        groups.reverse();
+
+        for group in groups.iter().take(groups.len() - 1) {
+            bytes.push(group | 0x80);
+        }
+        bytes.push(*groups.last().unwrap());
+    }
+
+    bytes
 }
 
