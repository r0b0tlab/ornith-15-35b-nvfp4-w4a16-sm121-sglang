	}
	return &Tree{value: tr.value, children: newChildren}
}

// PathTo returns the shortest path between two nodes in the tree.
func (tr *Tree) PathTo(from, to string) []string {
	var result []string
	found := tr.pathHelper(from, to, &result)
	if !found {
