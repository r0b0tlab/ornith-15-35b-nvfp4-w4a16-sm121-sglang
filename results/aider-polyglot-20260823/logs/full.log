@@ -1,5 +1,66 @@
 #include "crypto_square.h"
+#include <string>
+#include <cmath>
+#include <algorithm>
+#include <cctype>
 
 namespace crypto_square {
 
+std::string cipher::plaintext_password(const std::string& text) {
+    std::string result;
+    for (char c : text) {
+        if (std::isalnum(c)) {
+            result += std::tolower(c);
+        }
+    }
+    return result;
+}
+
+std::string cipher::ciphertext_password(const std::string& text) {
+    // Normalize the text
+    std::string normalized = plaintext_password(text);
+    
+    // Handle empty case
+    if (normalized.empty()) {
+        return "";
+    }
+    
+    // Calculate rectangle dimensions
+    size_t length = normalized.length();
+    double sqrt_length = std::sqrt(length);
+    size_t columns = static_cast<size_t>(std::ceil(sqrt_length));
+    size_t rows = static_cast<size_t>(std::floor(sqrt_length));
+    
+    // Adjust dimensions to satisfy the constraints
+    if (rows * columns < length) {
+        columns++;
+    }
+    if (rows * columns < length) {
+        rows++;
+    }
+    if (columns - rows > 1) {
+        rows = columns;
+    }
+    
+    // Create the encoded message
+    std::string result;
+    for (size_t col = 0; col < columns; ++col) {
+        std::string chunk;
+        for (size_t row = 0; row < rows; ++row) {
+            size_t index = row * columns + col;
+            if (index < length) {
+                chunk += normalized[index];
+            } else {
+                chunk += ' ';
+            }
+        }
+        if (!result.empty()) {
+            result += ' ';
+        }
+        result += chunk;
+    }
+    
+    return result;
+}
+
 }  // namespace crypto_square
