meetup.cpp
```cpp
#include "meetup.h"
#include <stdexcept>

namespace meetup {

scheduler::scheduler(std::chrono::weekday wd, int week) : weekday_(wd), 
week_(week) {}

std::chrono::system_clock::date scheduler::meetup_date(int year, unsigned int 
month) const {
    using namespace std::chrono;
    
    // Determine the starting day based on week type
    int start_day;
    
    if (week_ == -2) {  // teenth
        start_day = 13;
    } else if (week_ == -1) {  // last
        // Find the last occurrence: start from last day of month and go 
backwards
        // Last day of month
        if (month == 12) {
            start_day = 31;
        } else {
            date d2(year, month + 1, 1);
            start_day = (d2 - days(1)).day();
        }
    } else {
        start_day = 1 + 7 * (week_ - 1);  // first = 1, second = 8, etc.
    }
    
    // Find the target weekday
    if (week_ == -1) {  // last
        // Start from last day and go backwards to find the weekday
        weekday_t wd = weekday(year, month, start_day);
        int days_to_subtract = static_cast<int>(wd - weekday_);
        if (days_to_subtract < 0) {
            days_to_subtract += 7;
        }
        start_day -= days_to_subtract;
    } else {
        // Start from the calculated day and go forward to find the weekday
        weekday_t wd = weekday(year, month, start_day);
        int days_to_add = static_cast<int>(weekday_ - wd);
        if (days_to_add < 0) {
            days_to_add += 7;
        }
        start_day += days_to_add;
    }
    
    return date(year, month, start_day);
}

}  // namespace meetup
