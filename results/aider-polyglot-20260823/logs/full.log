        int wd_int = static_cast<int>(d.weekday());
        int target_int = static_cast<int>(target);
        diff = target_int - wd_int;
        if (diff < 0) diff += 7;
        start_day += diff;
    }
    return year_month_day{year, month, static_cast<day>(start_day)};
}

