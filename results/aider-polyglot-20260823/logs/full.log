9. Implement `reverse` to reverse the list.

Here's the updated file:

list-ops.js
```
//
// This is only a SKELETON file for the 'List Ops' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class List {
  constructor() {
    this._data = [];
  }

  append(list) {
    for (let i = 0; i < list.length(); i++) {
      this._data.push(list._data[i]);
    }
    return this;
  }

  concat(lists) {
    for (let i = 0; i < lists.length(); i++) {
      const list = lists._data[i];
      for (let j = 0; j < list.length(); j++) {
        this._data.push(list[j]);
      }
    }
    return this;
  }

  filter(fn) {
    const result = new List();
    for (let i = 0; i < this._data.length; i++) {
      if (fn(this._data[i])) {
        result._data.push(this._data[i]);
      }
    }
    return result;
  }

  length() {
    return this._data.length;
  }

  map(fn) {
    const result = new List();
    for (let i = 0; i < this._data.length; i++) {
      result._data.push(fn(this._data[i]));
    }
    return result;
  }

  foldl(fn, acc) {
    for (let i = 0; i < this._data.length; i++) {
      acc = fn(this._data[i], acc);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let i = this._data.length - 1; i >= 0; i--) {
      acc = fn(this._data[i], acc);
    }
    return acc;
  }

  reverse() {
    const result = new List();
    for (let i = this._data.length - 1; i >= 0; i--) {
      result._data.push(this._data[i]);
    }
    return result;
  }
}
```
