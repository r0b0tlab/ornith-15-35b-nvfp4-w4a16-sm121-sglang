export const answer = (question) => {
  // Check if the question is a valid math question
  if (!question.startsWith('What is')) {
    throw new Error('Non-math question');
  }

  // Extract the operation part
  const operationPart = question.slice('What is'.length).trim();
  
  // Check if it's just a number (Iteration 0)
  if (/^-?\d+$/.test(operationPart)) {
    return parseInt(operationPart, 10);
  }

  // Check if it ends with a question mark
  if (!operationPart.endsWith('?')) {
    throw new Error('Invalid syntax');
  }

  // Remove the question mark
  const operationString = operationPart.slice(0, -1).trim();

  // Parse the operation string
  const operationMap = {
    'plus': '+',
    'minus': '-',
    'multiplied by': '*',
    'divided by': '/'
  };

  // Replace operation words with symbols
  let expression = operationString;
  for (const [word, symbol] of Object.entries(operationMap)) {
    expression = expression.split(word).join(symbol);
  }

  // Check if the expression is valid
  if (!/^-?\d+([+\-*/]-?\d+)*$/.test(expression)) {
    throw new Error('Invalid syntax');
  }

  // Evaluate the expression left-to-right
  let result = parseInt(expression[0], 10);
  for (let i = 1; i < expression.length; i += 2) {
    const operator = expression[i];
    const nextNumber = parseInt(expression.slice(i + 1, i + 3), 10);
    
    switch (operator) {
      case '+':
        result += nextNumber;
        break;
      case '-':
        result -= nextNumber;
        break;
      case '*':
        result *= nextNumber;
        break;
      case '/':
        result /= nextNumber;
        break;
    }
  }

  return result;
};
