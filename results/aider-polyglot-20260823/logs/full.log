I'll implement VLQ encoding and decoding for you.

For encoding, I break each number into 7-bit groups, add the continuation bit to all but the last group, and reverse the order. For decoding, I read 7-bit groups, using bit 7 as a continuation flag, and detect overflow errors.

lib.rs
```rust
#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    IncompleteNumber,
}

/// Convert a list of numbers to a stream of bytes encoded with variable length encoding.
pub fn to_bytes(values: &[u32]) -> Vec<u8> {
    let mut bytes = Vec::new();

    for &value in values {
        if value == 0 {
            bytes.push(0);
            continue;
        }

        let mut groups: Vec<u8> = Vec::new();
        let mut n = value;

        while n > 0 {
            groups.push((n & 0x7f) as u8);
            n >>= 7;
        }

        groups.reverse();

        for group in groups.iter().take(groups.len() - 1) {
            bytes.push(group | 0x80);
        }
        bytes.push(*groups.last().unwrap());
    }

    bytes
}

/// Given a stream of bytes, extract all numbers which are encoded in there.
pub fn from_bytes(bytes: &[u8]) -> Result<Vec<u32>, Error> {
    let mut numbers = Vec::new();
    let mut number: u32 = 0;
    let mut incomplete = false;

    for &byte in bytes {
        number = ((number << 7) & 0x7fffffff) | ((byte & 0x7f) as u32);

        if byte & 0x80 == 0 {
            numbers.push(number);
            number = 0;
            incomplete = false;
        } else {
            incomplete = true;
        }
    }

    if incomplete {
        return Err(Error::IncompleteNumber);
    }

    Ok(numbers)
}
