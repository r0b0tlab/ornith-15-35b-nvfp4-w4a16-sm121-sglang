import java.util.List;
import java.util.ArrayList;
import java.util.Set;
import java.util.HashSet;
import java.util.Queue;
import java.util.LinkedList;
import java.util.Map;
import java.util.HashMap;
import java.util.function.Consumer;
import java.util.function.Function;

public class React {

    private static class CellManager {
        private static final Map<Cell<?>, Set<Consumer<?>>> CALLBACKS = new HashMap<>();
        private static final Set<Cell<?>> ALL_CELLS = new HashSet<>();

        static <T> void registerCell(Cell<T> cell) {
            ALL_CELLS.add(cell);
        }

        static <T> void registerCallback(Cell<T> cell, Consumer<T> callback) {
            CALLBACKS.computeIfAbsent(cell, k -> new HashSet<>()).add(callback);
        }

        static <T> void removeCallback(Cell<T> cell, Consumer<T> callback) {
            Set<Consumer<T>> callbacks = CALLBACKS.get(cell);
            if (callbacks != null) {
                callbacks.remove(callback);
            }
        }

        static <T> void fireCallbacks(Cell<T> cell) {
            Set<Consumer<T>> callbacks = CALLBACKS.get(cell);
            if (callbacks != null) {
                for (Consumer<T> callback : callbacks) {
                    callback.accept(cell.getValue());
                }
            }
        }
    }

    public static class Cell<T> {
        public T getValue() {
            throw new UnsupportedOperationException("Please implement the Cell.getValue() method");
        }
    }

    public static class InputCell<T> extends Cell<T> {
        private T value;
        private final Set<ComputeCell<T>> dependentCells = new HashSet<>();

        public InputCell(T initialValue) {
            this.value = initialValue;
            CellManager.registerCell(this);
        }

        @Override
        public T getValue() {
            return value;
        }

        public void setValue(T newValue) {
            this.value = newValue;
            propagateChange();
        }

        private void propagateChange() {
            Queue<ComputeCell<T>> queue = new LinkedList<>();
            queue.addAll(dependentCells);
            Set<ComputeCell<T>> visited = new HashSet<>();
            
            while (!queue.isEmpty()) {
                ComputeCell<T> cell = queue.poll();
                if (visited.add(cell)) {
                    T newValue = cell.computeValue();
                    if (!equals(cell.getValue(), newValue)) {
                        cell.setValue(newValue);
                        for (ComputeCell<T> dependent : cell.getDependentCells()) {
                            queue.add(dependent);
                        }
                    }
                }
            }
            
            // Fire callbacks for all changed cells
            for (ComputeCell<T> cell : allChangedCells()) {
                CellManager.fireCallbacks(cell);
            }
        }

        private boolean equals(T a, T b) {
            return a == null ? b == null : a.equals(b);
        }

        private Set<ComputeCell<T>> allChangedCells() {
            Set<ComputeCell<T>> changed = new HashSet<>();
            Queue<ComputeCell<T>> queue = new LinkedList<>();
            queue.addAll(dependentCells);
            Set<ComputeCell<T>> visited = new HashSet<>();
            
            while (!queue.isEmpty()) {
                ComputeCell<T> cell = queue.poll();
                if (visited.add(cell)) {
                    changed.add(cell);
                    for (ComputeCell<T> dependent : cell.getDependentCells()) {
                        queue.add(dependent);
                    }
                }
            }
            return changed;
        }

        public void addCallback(Consumer<T> callback) {
            CellManager.registerCallback(this, callback);
        }

        public void removeCallback(Consumer<T> callback) {
            CellManager.removeCallback(this, callback);
        }
    }

    public static class ComputeCell<T> extends Cell<T> {
        private final Function<List<T>, T> function;
        private final List<Cell<T>> cells;
        private T value;
