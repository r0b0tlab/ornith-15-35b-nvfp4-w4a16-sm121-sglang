export const answer = (question) => {
  // Check if the question is a valid math question
  if (!question.startsWith('What is')) {
    throw new Error('Non-math question');
  }

  // Extract the operation part
  const operationPart = question.slice('What is'.length).trim();
  
  // Check if it's just a number (Iteration 0)
  if (/^-?\d+$/.test(operationPart)) {
    return parseInt(operationPart, 10);
  }

  // Check if it ends with a question mark
  if (!operationPart.endsWith('?')) {
    throw new Error('Invalid syntax');
  }

  // Remove the question mark
  const operationString = operationPart.slice(0, -1).trim();

  // Check for unsupported operations
  if (/\b(cubed|squared|raised)\b/.test(operationString)) {
    throw new Error('Unsupported operation');
  }

  // Parse the operation string into tokens
  const tokens = operationString.match(/-?\d+|plus|minus|multiplied by|divided by/g);
  if (!tokens) {
    throw new Error('Invalid syntax');
  }

  // Check if the first token is a number
  if (!/^-?\d+$/.test(tokens[0])) {
    throw new Error('Invalid syntax');
  }

  // Evaluate the expression
  let result = parseInt(tokens[0], 10);
  let i = 1;
  
  while (i < tokens.length) {
    // Check if we have an operator
    if (i + 1 >= tokens.length) {
      throw new Error('Invalid syntax');
    }
    
    const operator = tokens[i];
    const nextNumber = parseInt(tokens[i + 1], 10);
    
    if (isNaN(nextNumber)) {
      throw new Error('Invalid syntax');
    }
    
    switch (operator) {
      case 'plus':
        result += nextNumber;
        break;
      case 'minus':
        result -= nextNumber;
        break;
      case 'multiplied by':
        result *= nextNumber;
        break;
      case 'divided by':
        result /= nextNumber;
        break;
      default:
        throw new Error('Unsupported operation');
    }
    
    i += 2;
  }

  return result;
};
```

