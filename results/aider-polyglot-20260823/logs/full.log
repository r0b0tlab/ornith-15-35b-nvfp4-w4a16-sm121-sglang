```java
import java.util.ArrayList;
import java.util.List;

class Dominoes {

    List<Domino> formChain(List<Domino> inputDominoes) throws ChainNotFoundException {
        List<Domino> chain = new ArrayList<>();
        if (formChainHelper(inputDominoes, chain)) {
            return chain;
        }
        throw new ChainNotFoundException("No valid chain exists");
    }

    private boolean formChainHelper(List<Domino> inputDominoes, List<Domino> chain) {
        if (inputDominoes.isEmpty()) {
            return chain.size() > 0 && chain.get(0).getValue() == chain.get(chain.size() - 1).getValue();
        }

        for (int i = 0; i < inputDominoes.size(); i++) {
            Domino domino = inputDominoes.get(i);
            List<Domino> remaining = new ArrayList<>(inputDominoes);
            remaining.remove(i);

            // Try orientation A|B
            List<Domino> chainAttemptA = new ArrayList<>(chain);
            chainAttemptA.add(domino);
            if (chain.size() == 0 || chain.get(chain.size() - 1).getValue() == domino.getValue()) {
                if (formChainHelper(remaining, chainAttemptA)) {
                    return true;
                }
            }

            // Try orientation B|A
            List<Domino> chainAttemptB = new ArrayList<>(chain);
            chainAttemptB.add(new Domino(domino.getValue(), domino.getValue()));
            chainAttemptB.set(chainAttemptB.size() - 1, new Domino(domino.getValue(), domino.getValue()));
            if (chain.size() == 0 || chain.get(chain.size() - 1).getValue() == domino.getValue()) {
                if (formChainHelper(remaining, chainAttemptB)) {
                    return true;
                }
            }
        }

        return false;
    }
}
