response:
I can see the issue - the tests expect `grep` to return a single string (with lines joined by newlines), not a list. Let me fix this:

grep.py
```python
def grep(pattern, flags, files):
    # Parse flags
    print_numbers = '-n' in flags
    print_filenames_only = '-l' in flags
    case_insensitive = '-i' in flags
    invert_match = '-v' in flags
    match_entire_line = '-x' in flags
    
    results = []
    
    for file in files:
        try:
            with open(file, 'r') as f:
                lines = f.readlines()
        except (FileNotFoundError, IOError):
            continue
        
        for line_number, line in enumerate(lines, 1):
            line = line.rstrip('\n')
            
            if case_insensitive:
                match = pattern.lower() in line.lower()
            else:
                match = pattern in line
            
            if match_entire_line:
                if case_insensitive:
                    match = pattern.lower() == line.lower()
                else:
                    match = pattern == line
            
            if invert_match:
                match = not match
            
            if match:
                if print_filenames_only:
                    results.append(file)
                    break
                else:
                    result = ""
                    if len(files) > 1:
                        result += file + ":"
                    if print_numbers:
                        result += str(line_number) + ":"
                    result += line
                    results.append(result)
    
    return "\n".join(results)
```
