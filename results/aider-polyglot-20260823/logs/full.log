import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class SgfNode {
    private Map<String, List<String>> properties = new HashMap<>();
    private List<SgfNode> children = new ArrayList<>();
    
    public SgfNode() {
    }
    
    public Map<String, List<String>> getProperties() {
        return properties;
    }
    
    public List<SgfNode> getChildren() {
        return children;
    }
    
    public List<String> get(String key) {
        return properties.computeIfAbsent(key, k -> new ArrayList<>());
    }
    
    public void set(String key, String value) {
        properties.computeIfAbsent(key, k -> new ArrayList<>()).add(value);
    }
    
    public void addChild(SgfNode child) {
        children.add(child);
    }
    
    public boolean has(String key) {
        return properties.containsKey(key);
    }
}
