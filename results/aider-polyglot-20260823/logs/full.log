import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class ZebraPuzzle {
    private static final String[] COLORS = {"red", "green", "ivory", "yellow", "blue"};
    private static final String[] SMOKERS = {"Englishman", "Spaniard", "Ukrainian", "Norwegian", "Japanese"};
    private static final String[] BEVERAGES = {"coffee", "tea", "milk", "orangeJuice", "water"};
    private static final String[] SMOKE_TYPES = {"OldGlory", "Kools", "Chesterfields", "LuckyStrike", "Parliaments"};
    private static final String[] PETS = {"dog", "snails", "fox", "horse", "zebra"};
    private static final String[] HOBIES = {"dancing", "painting", "reading", "football", "chess"};

    private int[] color = new int[5];
    private int[] smoke = new int[5];
    private int[] beverage = new int[5];
    private int[] pet = new int[5];
    private int[] hobby = new int[5];

    boolean solve() {
        for (int i = 0; i < 5; i++) {
            color[i] = -1;
            smoke[i] = -1;
            beverage[i] = -1;
            pet[i] = -1;
            hobby[i] = -1;
        }

        solveHelper(0);
        return true;
    }

    private boolean solveHelper(int houseIndex) {
        if (houseIndex == 5) {
            return checkConstraints();
        }

        for (int c = 0; c < 5; c++) {
            if (!colorUsed(c)) {
                color[houseIndex] = c;
                if (solveHelper(houseIndex + 1)) {
                    return true;
                }
                color[houseIndex] = -1;
            }
        }

        return false;
    }

    private boolean colorUsed(int c) {
        for (int i = 0; i < 5; i++) {
            if (color[i] == c) {
                return true;
            }
        }
        return false;
    }

    private boolean checkConstraints() {
        // Constraint 6: The green house is immediately to the right of the ivory house.
        int ivoryIndex = -1;
        int greenIndex = -1;
        for (int i = 0; i < 5; i++) {
            if (color[i] == 2) { // ivory
                ivoryIndex = i;
            }
            if (color[i] == 1) { // green
                greenIndex = i;
            }
        }
        if (greenIndex != ivoryIndex + 1) {
            return false;
        }

        // Constraint 15: The Norwegian lives next to the blue house.
        int norwegianHouse = indexOf(SMOKERS, "Norwegian");
        int blueHouse = indexOf(COLORS, "blue");
        if (Math.abs(norwegianHouse - blueHouse) != 1) {
            return false;
        }

        // Constraint 2: The Englishman lives in the red house.
        if (indexOf(COLORS, "red") != indexOf(SMOKERS, "Englishman")) {
            return false;
        }

        // Constraint 4: The person in the green house drinks coffee.
        if (color[1] != 1 || beverage[1] != 1) { // green index 1, coffee index 1
            return false;
        }

        // Constraint 9: The person in the middle house drinks milk.
        if (beverage[2] != 2) { // milk index 2
            return false;
        }

        // Constraint 5: The Ukrainian drinks tea.
        if (indexOf(SMOKERS, "Ukrainian") != indexOf(BEVERAGES, "tea")) {
            return false;
        }

        // Constraint 14: The Japanese person plays chess.
        if (indexOf(SMOKERS, "Japanese") != indexOf(HOBIES, "chess")) {
            return false;
        }

        // Constraint 13: The person who plays football drinks orange juice.
        if (indexOf(HOBIES, "football") != indexOf(BEVERAGES, "orangeJuice")) {
            return false;
        }

        // Constraint 8: The person in the yellow house is a painter.
        if (color[3] != 3 || indexOf(HOBIES, "painting") != 3) { // yellow index 3
            return false;
        }

        // Constraint 7: The snail owner likes to go dancing.
        if (indexOf(PETS, "snails") != indexOf(HOBIES, "dancing")) {
            return false;
        }

        // Constraint 3: The Spaniard owns the dog.
        if (indexOf(SMOKERS, "Spaniard") != indexOf(PETS, "dog")) {
            return false;
        }

        // Constraint 10: The Norwegian lives in the first house.
        if (indexOf(SMOKERS, "Norwegian") != 0) {
            return false;
        }

        // Constraint 11: The person who enjoys reading lives next to the fox.
        int readingIndex = indexOf(HOBIES, "reading");
        int foxIndex = indexOf(PETS, "fox");
        if (Math.abs(readingIndex - foxIndex) != 1) {
            return false;
        }

        // Constraint 12: The painter's house is next to the horse.
        int paintingIndex = indexOf(HOBIES, "painting");
        int horseIndex = indexOf(PETS, "horse");
        if (Math.abs(paintingIndex - horseIndex) != 1) {
            return false;
        }

        return true;
    }

    private int indexOf(String[] array, String value) {
        for (int i = 0; i < array.length; i++) {
            if (array[i].equals(value)) {
                return i;
            }
        }
        return -1;
    }

    String getWaterDrinker() {
