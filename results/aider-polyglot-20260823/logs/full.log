```java
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class SgfParsing {
    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.isEmpty()) {
            throw new SgfParsingException("Empty input");
        }

        int[] pos = {0};
        SgfNode result = parseTree(input, pos);
        
        if (pos[0] < input.length()) {
            throw new SgfParsingException("Trailing characters after tree");
        }
        
        return result;
    }
    
    private SgfNode parseTree(String input, int[] pos) throws SgfParsingException {
        if (input.charAt(pos[0]) != '(') {
            throw new SgfParsingException("Expected '(' at start of tree");
        }
        pos[0]++;
        
        if (input.charAt(pos[0]) != ';') {
            throw new SgfParsingException("Expected ';' at start of tree");
        }
        
        SgfNode root = parseNode(input, pos);
        
        while (pos[0] < input.length() && input.charAt(pos[0]) == '(') {
            pos[0]++;
            SgfNode child = parseTree(input, pos);
            root.getChildren().add(child);
        }
        
        if (pos[0] >= input.length() || input.charAt(pos[0]) != ')') {
            throw new SgfParsingException("Expected ')' at end of tree");
        }
        pos[0]++;
        
        return root;
    }
    
    private SgfNode parseNode(String input, int[] pos) throws SgfParsingException {
        SgfNode node = new SgfNode();
        
        while (pos[0] < input.length() && input.charAt(pos[0]) != ';' 
                && input.charAt(pos[0]) != '(' && input.charAt(pos[0]) != ')') {
            String key = parseKey(input, pos);
            if (key.length() < 2 || !key.matches("[A-Z]+")) {
                throw new SgfParsingException("Invalid property key");
            }
            
            List<String> values = new ArrayList<>();
            while (pos[0] < input.length() && input.charAt(pos[0]) == '[') {
                values.add(parseValue(input, pos));
            }
            
            if (values.isEmpty()) {
                throw new SgfParsingException("Missing property value");
            }
            
            for (String value : values) {
                node.get(key).add(value);
            }
        }
        
        return node;
    }
    
    private String parseKey(String input, int[] pos) {
        StringBuilder key = new StringBuilder();
        while (pos[0] < input.length() 
                && Character.isUpperCase(input.charAt(pos[0]))) {
            key.append(input.charAt(pos[0]));
            pos[0]++;
        }
        return key.toString();
    }
    
    private String parseValue(String input, int[] pos) throws SgfParsingException {
        if (input.charAt(pos[0]) != '[') {
            throw new SgfParsingException("Expected '[' at start of value");
        }
        pos[0]++;
        
        StringBuilder value = new StringBuilder();
        while (pos[0] < input.length() && input.charAt(pos[0]) != ']') {
            char c = input.charAt(pos[0]);
            
            if (c == '\\') {
                pos[0]++;
                if (pos[0] >= input.length()) {
                    throw new SgfParsingException("Trailing backslash");
                }
                char next = input.charAt(pos[0]);
                if (Character.isWhitespace(next)) {
                    if (next == '\n') {
                        // Remove newline after backslash
                        pos[0]++;
                    } else {
                        value.append(' ');
                        pos[0]++;
                    }
                } else {
                    value.append(next);
                    pos[0]++;
                }
            } else if (c == ']') {
                break;
            } else {
                if (Character.isWhitespace(c)) {
                    value.append(' ');
                } else {
                    value.append(c);
                }
                pos[0]++;
            }
        }
        
        if (pos[0] >= input.length() || input.charAt(pos[0]) != ']') {
            throw new SgfParsingException("Unterminated property value");
        }
        pos[0]++;
        
        return value.toString();
    }
}
