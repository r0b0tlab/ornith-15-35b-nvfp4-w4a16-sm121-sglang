/// Type implementing arbitrary-precision decimal arithmetic
use std::ops::{Add, Sub};

pub struct Decimal {
    sign: bool, // true for positive, false for negative
    integer: Vec<u8>, // digits of the integer part (most significant first)
    fraction: Vec<u8>, // digits of the fractional part (least significant last)
}

impl Decimal {
    pub fn try_from(input: &str) -> Option<Decimal> {
        // Parse the input string into a Decimal
        let input = input.trim();
        
        if input.is_empty() {
            return None;
        }
        
        // Check for sign
        let bytes = input.as_bytes();
        let mut index = 0;
        let mut sign = true;
        
        if bytes[index] == b'+' || bytes[index] == b'-' {
            sign = bytes[index] == b'-';
            index += 1;
        }
        
        if index >= bytes.len() {
            return None;
        }
        
        // Split into integer and fraction parts
        let mut integer_part = String::new();
        let mut fraction_part = String::new();
        let mut dot_seen = false;
        let mut all_digits = true;
        
        for &byte in &bytes[index..] {
            match byte {
                b'.' => {
                    if dot_seen {
                        all_digits = false;
                        break;
                    }
                    dot_seen = true;
                }
                b'0'..=b'9' => {
                    if !dot_seen {
                        integer_part.push(byte as char);
                    } else {
                        fraction_part.push(byte as char);
                    }
                }
                _ => {
                    all_digits = false;
                    break;
                }
            }
        }
        
        if !all_digits || integer_part.is_empty() && fraction_part.is_empty() {
            return None;
        }
        
        Some(Decimal {
            sign,
            integer: integer_part.into_bytes(),
            fraction: fraction_part.into_bytes(),
        })
    }
    
    fn is_zero(&self) -> bool {
        self.integer.iter().all(|&d| d == 0) && self.fraction.iter().all(|&d| d == 0)
    }
    
    fn compare_values(&self, other: &Decimal) -> std::cmp::Ordering {
        // Compare absolute values
        // First, pad the shorter fraction with zeros
        let max_frac_len = self.fraction.len().max(other.fraction.len());
        
        let mut self_frac = self.fraction.clone();
        let mut other_frac = other.fraction.clone();
        self_frac.resize(max_frac_len, 0);
        other_frac.resize(max_frac_len, 0);
        
        let max_int_len = self.integer.len().max(other.integer.len());
        let mut self_int = self.integer.clone();
        let mut other_int = other.integer.clone();
        self_int.resize(max_int_len, 0);
        other_int.resize(max_int_len, 0);
        
        // Compare integer parts
        let int_order = compare_digit_vec(&self_int, &other_int);
        if int_order != std::cmp::Ordering::Equal {
            return int_order;
        }
        
        // Compare fractional parts
        compare_digit_vec(&self_frac, &other_frac)
    }
}

fn compare_digit_vec(a: &[u8], b: &[u8]) -> std::cmp::Ordering {
    // Compare as if they're equal-length numbers
    let len = a.len().max(b.len());
    for i in 0..len {
        let ad = if i < a.len() { a[i] } else { 0 };
        let bd = if i < b.len() { b[i] } else { 0 };
        match ad.cmp(&bd) {
            std::cmp::Ordering::Equal => continue,
            other => return other,
        }
    }
    std::cmp::Ordering::Equal
}

impl PartialEq for Decimal {
    fn eq(&self, other: &Decimal) -> bool {
        match self.compare_values(other) {
            std::cmp::Ordering::Equal => self.sign == other.sign,
            _ => false,
        }
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(&self, other: &Decimal) -> Option<std::cmp::Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for Decimal {
    fn cmp(&self, other: &Decimal) -> std::cmp::Ordering {
        let val_order = self.compare_values(other);
        if self.sign != other.sign {
            // If signs differ, reverse the order
            return val_order.reverse();
        }
        val_order
    }
}

impl std::ops::Add for Decimal {
    type Output = Decimal;
    
    fn add(self, rhs: Decimal) -> Decimal {
        // If signs differ, perform subtraction
        if self.sign != rhs.sign {
            let a = Decimal {
                sign: true,
                integer: self.integer.clone(),
                fraction: self.fraction.clone(),
            };
            let b = Decimal {
                sign: true,
                integer: rhs.integer.clone(),
                fraction: rhs.fraction.clone(),
            };
            let result = b.sub(a);
            result.sign = !result.sign;
            result
        } else {
            // Same signs, perform addition
            let (integer, fraction) = add_same_sign(&self, &rhs);
            Decimal {
                sign: self.sign,
                integer,
                fraction,
            }
        }
    }
}

impl std::ops::Sub for Decimal {
    type Output = Decimal;
    
    fn sub(self, rhs: Decimal) -> Decimal {
        // If signs differ, perform addition
        if self.sign != rhs.sign {
            let b = Decimal {
                sign: true,
                integer: rhs.integer.clone(),
                fraction: rhs.fraction.clone(),
            };
            let result = self.add(b);
            result
        } else {
            // Same signs, perform subtraction
            let neg_rhs = Decimal {
                sign: !rhs.sign,
                integer: rhs.integer.clone(),
                fraction: rhs.fraction.clone(),
            };
            self.add(neg_rhs)
        }
    }
}

impl std::ops::Mul for Decimal {
    type Output = Decimal;
    
    fn mul(self, rhs: Decimal) -> Decimal {
        // Multiply the integer and fractional parts separately
        let integer_result = multiply_digits(&self.integer, &rhs.integer);
        let fraction_result = multiply_digits(&self.fraction, &rhs.fraction);
        
        // Combine the results
        let mut combined = Vec::new();
        for &d in &integer_result {
            combined.push(d);
        }
        for &d in &fraction_result {
            combined.push(d);
        }
        
        // Count total fractional digits
        let total_fraction_digits = self.fraction.len() + rhs.fraction.len();
        
        // Split into integer and fraction parts
        let split_point = if combined.len() > total_fraction_digits {
            combined.len() - total_fraction_digits
        } else {
            0
        };
        
        let (integer, fraction) = if split_point == 0 {
            (Vec::new(), combined)
        } else {
            (combined[..split_point].to_vec(), combined[split_point..].to_vec())
        };
        
        Decimal {
            sign: self.sign != rhs.sign,
            integer,
            fraction,
        }
    }
}

fn add_same_sign(a: &Decimal, b: &Decimal) -> (Vec<u8>, Vec<u8>) {
    // Pad the fractions to equal length
    let max_frac_len = a.fraction.len().max(b.fraction.len());
    let mut a_frac = a.fraction.clone();
    let mut b_frac = b.fraction.clone();
    a_frac.resize(max_frac_len, 0);
    b_frac.resize(max_frac_len, 0);
    
    // Pad the integer parts to equal length
    let max_int_len = a.integer.len().max(b.integer.len());
    let mut a_int = a.integer.clone();
    let mut b_int = b.integer.clone();
    a_int.resize(max_int_len, 0);
    b_int.resize(max_int_len, 0);
    
    // Add the fractional parts
    let mut fraction = vec![0u8; max_frac_len];
    let mut carry = 0;
    for i in (0..max_frac_len).rev() {
        let sum = a_frac[i] as u16 + b_frac[i] as u16 + carry;
        fraction[i] = (sum % 10) as u8;
        carry = sum / 10;
    }
    
    // Add the integer parts
    let mut integer = vec![0u8; max_int_len];
    for i in (0..max_int_len).rev() {
        let sum = a_int[i] as u16 + b_int[i] as u16 + fraction[i] as u16 + carry;
        integer[i] = (sum % 10) as u8;
        carry = sum / 10;
    }
    
    // Handle any remaining carry
    if carry > 0 {
        integer.insert(0, carry as u8);
    }
    
    // Trim leading zeros from integer part
    while integer.len() > 1 && integer[0] == 0 {
        integer.remove(0);
    }
    
    (integer, fraction)
}

fn multiply_digits(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut result = vec![0u8; a.len() + b.len()];
    
    for (i, &ba) in a.iter().enumerate() {
        let mut carry = 0;
        for (j, &bb) in b.iter().enumerate() {
            let idx = i + j;
            let prod = ba as u16 * bb as u16 + result[idx] as u16 + carry;
            result[idx] = (prod % 10) as u8;
            carry = prod / 10;
        }
        if carry > 0 {
            result[a.len() + b.len() - 1 - i] += carry as u8;
        }
    }
    
    result
}
