I'll implement the Scale class with chromatic and interval-based scale generation.

scale_generator.py
```python
class Scale:
    SHARP_SCALE = ['A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#']
    FLAT_SCALE = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab']
    
    FLAT_TONICS = ['F', 'Bb', 'Eb', 'Ab', 'Db', 'Gb', 'd', 'g', 'c', 'f', 'bb', 'eb']
    
    def __init__(self, tonic):
        self.tonic = tonic
        self.use_flats = tonic in self.FLAT_TONICS

    def chromatic(self):
        scale = self.FLAT_SCALE if self.use_flats else self.SHARP_SCALE
        tonic_lower = self.tonic.lower()
        start_index = scale.index(tonic_lower)
        return scale[start_index:] + scale[:start_index]

    def interval(self, intervals):
        scale = self.SHARP_SCALE if not self.use_flats else self.FLAT_SCALE
        tonic_lower = self.tonic.lower()
        start_index = scale.index(tonic_lower)
        
        result = [self.tonic]
        current = start_index
        for interval in intervals:
            current += {'m': 1, 'M': 2, 'A': 3}[interval]
            result.append(scale[current % len(scale)])
        return result
```
