KindergartenGarden.java
```
import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

class KindergartenGarden {

    private static final String[] DEFAULT_STUDENTS = {
        "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
        "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"
    };

    private String[] gardenRows;
    private Map<String, Integer> studentPosition;

    KindergartenGarden(String garden) {
        this.gardenRows = garden.split("\n");
        this.studentPosition = new HashMap<>();
        for (int i = 0; i < DEFAULT_STUDENTS.length; i++) {
            studentPosition.put(DEFAULT_STUDENTS[i], i);
        }
    }

    KindergartenGarden(String garden, String[] students) {
        this.gardenRows = garden.split("\n");
        this.studentPosition = new HashMap<>();
        String[] sortedStudents = students.clone();
        Arrays.sort(sortedStudents);
        for (int i = 0; i < sortedStudents.length; i++) {
            studentPosition.put(sortedStudents[i], i);
        }
    }

    List<Plant> getPlantsOfStudent(String student) {
        List<Plant> plants = new ArrayList<>();
        Integer position = studentPosition.get(student);
        if (position == null) {
            return plants;
        }

        int startIndex = position * 2;
        String firstRow = gardenRows[0];
        String secondRow = gardenRows[1];

        plants.add(getPlant(firstRow.charAt(startIndex)));
        plants.add(getPlant(firstRow.charAt(startIndex + 1)));
        plants.add(getPlant(secondRow.charAt(startIndex)));
        plants.add(getPlant(secondRow.charAt(startIndex + 1)));

        return plants;
    }

    private Plant getPlant(char code) {
        switch (code) {
            case 'G':
                return Plant.GRASS;
            case 'C':
                return Plant.CLOVER;
            case 'R':
                return Plant.RADISHES;
            case 'V':
                return Plant.VIOLETS;
            default:
                return null;
        }
    }

}
```
