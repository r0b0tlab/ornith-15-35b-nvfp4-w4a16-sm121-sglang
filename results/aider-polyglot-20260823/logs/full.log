```rust
const BELOW_20: [&str; 20] = [
    "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
    "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen",
    "seventeen", "eighteen", "nineteen",
];

const TENS: [&str; 10] = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"];

fn below_thousand(num: u64) -> String {
    if num == 0 {
        String::new()
    } else if num < 20 {
        BELOW_20[num as usize].to_string()
    } else if num < 100 {
        let ten = num / 10;
        let unit = num % 10;
        if unit == 0 {
            TENS[ten as usize].to_string()
        } else {
            format!("{}-{}", TENS[ten as usize], BELOW_20[unit as usize])
        }
    } else {
        let hundred = num / 100;
        let remainder = num % 100;
        let mut result = format!("{} hundred", BELOW_20[hundred as usize]);
        if remainder != 0 {
            let remainder_str = below_thousand(remainder);
            result.push_str(&format!(" {}", remainder_str));
        }
        result
    }
}

pub fn encode(n: u64) -> String {
    if n == 0 {
        return "zero".to_string();
    }

    let scales = ["", " thousand", " million", " billion"];
    let mut chunks = Vec::new();
    let mut scale_index = 0;
    let mut remaining = n;

    while remaining > 0 {
        let chunk = remaining % 1000;
        if chunk != 0 {
            let chunk_str = below_thousand(chunk);
            chunks.push(format!("{}{}", chunk_str, scales[scale_index]));
        }
        remaining /= 1000;
        scale_index += 1;
    }

    chunks.reverse();
    chunks.join(" ").trim().to_string()
}
```
