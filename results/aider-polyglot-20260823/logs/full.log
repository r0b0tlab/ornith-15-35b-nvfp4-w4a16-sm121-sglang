The key issues:
1. Property values must be stored as **lists** (multiple values)
2. Must process escape sequences (`\`, newlines, whitespace)
3. Must handle multiple properties and children correctly
4. Must raise the right error messages

Let me rewrite it with a proper character-by-character parser.

sgf_parsing.py
```python
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string.strip() == "":
        raise ValueError("tree missing")

    if not input_string.startswith("(") or not input_string.endswith(")"):
        raise ValueError("tree missing")

    content = input_string[1:-1]

    if not content.startswith(";"):
        raise ValueError("tree missing")

    if content == ";":
        raise ValueError("tree with no nodes")

    properties, children = _parse_node(content)
    return SgfTree(properties, children)


def _parse_node(content):
    idx = 1  # Skip the leading ';'
    properties = {}
    children = []

    while idx < len(content):
        c = content[idx]
        if c == ';':
            # Start of a new child node
            end = _find_matching_paren(content, idx)
            child_content = content[idx + 1:end]
            child_properties, child_children = _parse_node(child_content)
            children.append(SgfTree(child_properties, child_children))
            idx = end + 1
        elif c == '[':
            # Parse a property value
            key = _parse_key(content, idx)
            values = []
            while idx < len(content) and content[idx] == '[':
                idx += 1
                end = _find_bracket(content, idx)
                value = _process_escape(content[idx:end])
                values.append(value)
                idx = end + 1
            properties[key] = values
        else:
            raise ValueError("tree missing")

    return properties, children


def _parse_key(content, idx):
    start = idx
    while idx < len(content) and content[idx] != '[':
        idx += 1
    key = content[start:idx]
    if not key.isupper():
        raise ValueError("property must be in uppercase")
    return key


def _find_bracket(content, start):
    idx = start
    while idx < len(content):
        if content[idx] == '\\':
            idx += 2
        elif content[idx] == ']':
            return idx
        else:
            idx += 1
    raise ValueError("properties without delimiter")


def _find_matching_paren(content, start):
    depth = 0
    for i in range(start, len(content)):
        if content[i] == '(':
            depth += 1
        elif content[i] == ')':
            depth -= 1
            if depth == 0:
                return i
    raise ValueError("tree missing")


def _process_escape(value):
    result = []
    i = 0
    while i < len(value):
        c = value[i]
        if c == '\\':
            if i + 1 < len(value):
                next_c = value[i + 1]
                if next_c in ' \t\n\r':
                    result.append(next_c)
                else:
                    result.append(next_c)
                i += 2
            else:
                result.append(c)
                i += 1
        elif c == '\n':
            result.append(c)
            i += 1
        else:
            result.append(c)
            i += 1
    return ''.join(result)
