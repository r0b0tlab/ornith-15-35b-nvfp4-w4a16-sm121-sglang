I'll implement a complete bowling game scorer. The game needs to track rolls, handle strikes, spares, and the special 10th frame rules.

BowlingGame.java
```
class BowlingGame {
    private int[] rolls = new int[21];
    private int currentRoll = 0;

    void roll(int pins) {
        rolls[currentRoll++] = pins;
    }

    int score() {
        int score = 0;
        int rollIndex = 0;

        for (int frame = 0; frame < 10; frame++) {
            if (isStrike(frame, rollIndex)) {
                score += 10 + strikeBonus(rollIndex);
                rollIndex++;
            } else if (isSpare(frame, rollIndex)) {
                score += 10 + spareBonus(rollIndex);
                rollIndex += 2;
            } else {
                score += rolls[rollIndex] + rolls[rollIndex + 1];
                rollIndex += 2;
            }
        }

        return score;
    }

    private boolean isStrike(int frame, int rollIndex) {
        if (frame < 9) {
            return rolls[rollIndex] == 10;
        }
        // 10th frame special case
        return frame == 9 && rolls[rollIndex] == 10 && hasValidFillBalls(rollIndex);
    }

    private boolean isSpare(int frame, int rollIndex) {
        if (frame < 9) {
            return rolls[rollIndex] + rolls[rollIndex + 1] == 10;
        }
        // 10th frame special case
        return frame == 9 && hasValidFillBalls(rollIndex) &&
               rolls[rollIndex] + rolls[rollIndex + 1] == 10;
    }

    private boolean hasValidFillBalls(int rollIndex) {
        // For a 10th frame strike, we need 2 more rolls
        // For a 10th frame spare, we need 1 more roll
        return rollIndex + 2 < rolls.length;
    }

    private int strikeBonus(int rollIndex) {
        return rolls[rollIndex + 1] + rolls[rollIndex + 2];
    }

    private int spareBonus(int rollIndex) {
        return rolls[rollIndex + 2];
    }
}
```
