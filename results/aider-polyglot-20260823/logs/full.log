bowling.js
```javascript
export class Bowling {
  constructor() {
    this.rolls = [];
    this.gameComplete = false;
  }

  roll(pins) {
    if (this.gameComplete) {
      throw new Error('Cannot roll after game is over');
    }
    if (pins < 0) {
      throw new Error('Negative roll is invalid');
    }
    if (pins > 10) {
      throw new Error('Pin count exceeds pins on the lane');
    }

    if (this.rolls.length === 0) {
      this.rolls.push(pins);
      this._advanceFrame();
      return;
    }

    let frameIndex = this._currentFrameIndex();
    let rollInFrame = this.rolls.length - frameIndex;

    if (this._isLastFrame()) {
      this.rolls.push(pins);
      this._checkGameComplete();
      return;
    }

    if (rollInFrame === 1) {
      this.rolls.push(pins);
      this._advanceFrame();
    } else if (rollInFrame === 2) {
      let firstRoll = this.rolls[frameIndex];
      if (firstRoll + pins > 10) {
        throw new Error('Pin count exceeds pins on the lane');
      }
      this.rolls.push(pins);
      this._advanceFrame();
    }
  }

  _currentFrameIndex() {
    let index = 0;
    let frame = 0;
    while (frame < 9) {
      if (this.rolls[index] === 10) {
        index++;
      } else {
        index += 2;
      }
      frame++;
    }
    return index;
  }

  _isLastFrame() {
    let frameIndex = this._currentFrameIndex();
    let rollInFrame = this.rolls.length - frameIndex;

    if (rollInFrame === 1) {
      return false;
    }
    if (rollInFrame === 0) {
      return false;
    }

    let firstRoll = this.rolls[frameIndex];
    if (firstRoll === 10) {
      return rollInFrame === 3;
    }
    return rollInFrame === 2;
  }

  _advanceFrame() {
    let frameIndex = this._currentFrameIndex();
    let rollInFrame = this.rolls.length - frameIndex;

    if (rollInFrame >= 2) {
      let firstRoll = this.rolls[frameIndex];
      if (firstRoll === 10) {
        return;
      }
      if (firstRoll + this.rolls[frameIndex + 1] >= 10) {
        return;
      }
    }
  }

  _checkGameComplete() {
    let frameIndex = this._currentFrameIndex();
    let rollInFrame = this.rolls.length - frameIndex;

    if (this.rolls[frameIndex] === 10) {
      if (rollInFrame === 3) {
        this.gameComplete = true;
      }
    } else {
      if (rollInFrame === 2) {
        if (this.rolls[frameIndex] + this.rolls[frameIndex + 1] === 10) {
          this.gameComplete = true;
        }
      }
    }
  }

  score() {
    if (!this.gameComplete) {
      throw new Error('Score cannot be taken until the end of the game');
    }

    let score = 0;
    let frameIndex = 0;

    for (let frame = 0; frame < 10; frame++) {
      if (frameIndex >= this.rolls.length) {
        throw new Error('Score cannot be taken until the end of the game');
      }

      if (this.rolls[frameIndex] === 10) {
        score += 10;
        score += this.rolls[frameIndex + 1] + this.rolls[frameIndex + 2];
        frameIndex += 1;
      } else if (this.rolls[frameIndex] + this.rolls[frameIndex + 1] === 10) {
        score += 10;
        score += this.rolls[frameIndex + 2];
        frameIndex += 2;
      } else {
        score += this.rolls[frameIndex] + this.rolls[frameIndex + 1];
        frameIndex += 2;
      }
    }

    return score;
  }
}
