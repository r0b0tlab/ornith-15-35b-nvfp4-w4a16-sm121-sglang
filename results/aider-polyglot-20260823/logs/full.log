4. Implement withFactorsLessThanOrEqualTo to set the max factor.
5. Implement build() to find all valid Pythagorean triplets.
6. Add getters for a, b, c in PythagoreanTriplet.

PythagoreanTriplet.java
```java
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class PythagoreanTriplet {

    private final int a;
    private final int b;
    private final int c;

    PythagoreanTriplet(int a, int b, int c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    int getA() {
        return a;
    }

    int getB() {
        return b;
    }

    int getC() {
        return c;
    }

    static TripletListBuilder makeTripletsList() {
        return new TripletListBuilder();
    }

    static class TripletListBuilder {

        private int sum;
        private int maxFactor;

        TripletListBuilder thatSumTo(int sum) {
            this.sum = sum;
            return this;
        }

        TripletListBuilder withFactorsLessThanOrEqualTo(int maxFactor) {
            this.maxFactor = maxFactor;
            return this;
        }

        List<PythagoreanTriplet> build() {
            List<PythagoreanTriplet> triplets = new ArrayList<>();
            for (int a = 1; a < sum / 3; a++) {
                if (maxFactor != 0 && a > maxFactor) {
                    break;
                }
                for (int b = a + 1; b < sum / 2; b++) {
                    int c = sum - a - b;
                    if (c <= b) {
                        break;
                    }
                    if (a * a + b * b == c * c) {
                        triplets.add(new PythagoreanTriplet(a, b, c));
                    }
                }
            }
            return triplets;
        }

    }

}
