I see the issue. The list comprehension iterates over `r` but uses `c` as the column variable. For the top-to-bottom check, I need to iterate over columns and use row 0. Let me fix this.

connect.py
```
class ConnectGame:
    def __init__(self, board):
        # Parse the board, removing the leading spaces that create the
        # parallelogram/diagonal look so we can work with a clean grid.
        self.board = []
        for row in board:
            self.board.append(row.strip().split())

    def get_winner(self):
        if not self.board:
            return ""

        # Check if player O connects top to bottom
        if self._has_path('O', start_side='top', end_side='bottom'):
            return 'O'

        # Check if player X connects left to right
        if self._has_path('X', start_side='left', end_side='right'):
            return 'X'

        return ""

    def _has_path(self, player, start_side, end_side):
        """BFS to determine if player has a connected path."""
        rows = len(self.board)
        if rows == 0:
            return False
        cols = len(self.board[0])
        if cols == 0:
            return False

        # Determine start positions
        if start_side == 'top':
            start_cells = [(0, c) for c in range(cols) if self.board[0][c] == player]
            goal = 'bottom'
        elif start_side == 'left':
            start_cells = [(r, 0) for r in range(rows) if self.board[r][0] == player]
            goal = 'right'

        if not start_cells:
            return False

        # BFS
        visited = set()
        queue = list(start_cells)
        for cell in start_cells:
            visited.add(cell)

        while queue:
            r, c = queue.pop(0)

            # Check if we reached the goal side
            if goal == 'bottom' and r == rows - 1:
                return True
            if goal == 'right' and c == cols - 1:
                return True

            # Get neighbors based on hex adjacency
            neighbors = self._get_neighbors(r, c)
            for nr, nc in neighbors:
                if (0 <= nr < rows and 0 <= nc < cols
                        and (nr, nc) not in visited
                        and self.board[nr][nc] == player):
                    visited.add((nr, nc))
                    queue.append((nr, nc))

        return False

    def _get_neighbors(self, r, c):
        """Get valid hex neighbors. Hex boards use different offsets for
        odd and even rows due to the diagonal indentation."""
        neighbors = []
        if r % 2 == 0:
            # Even rows
            offsets = [(-1, -1), (-1, 0), (1, -1), (1, 0)]
        else:
            # Odd rows
            offsets = [(-1, 0), (-1, 1), (1, 0), (1, 1)]

        for dr, dc in offsets:
            neighbors.append((r + dr, c + dc))

        return neighbors
```
