use anyhow::Error;

/// While using `&[&str]` to handle flags is convenient for exercise purposes,
/// and resembles the output of [`std::env::args`], in real-world projects it is
/// both more convenient and more idiomatic to contain runtime configuration in
/// a dedicated struct. Therefore, we suggest that you do so in this exercise.
///
/// [`std::env::args`]: https://doc.rust-lang.org/std/env/fn.args.html
#[derive(Debug)]
pub struct Flags {
    include_line_numbers: bool,
    list_file_names: bool,
    case_insensitive: bool,
    invert_match: bool,
    match_entire_line: bool,
    pattern: String,
}

impl Flags {
    pub fn new(flags: &[&str]) -> Self {
        let mut result = Flags {
            include_line_numbers: false,
            list_file_names: false,
            case_insensitive: false,
            invert_match: false,
            match_entire_line: false,
            pattern: String::new(),
        };

        for flag in flags {
            match flag.as_str() {
                "-n" => result.include_line_numbers = true,
                "-l" => result.list_file_names = true,
                "-i" => result.case_insensitive = true,
                "-v" => result.invert_match = true,
                "-x" => result.match_entire_line = true,
                _ => {}
            }
        }

        result
    }
}

pub fn grep(pattern: &str, flags: &Flags, files: &[&str]) -> Result<Vec<String>, Error> {
    let mut results = Vec::new();

    for file in files {
        let content = std::fs::read_to_string(file)?;
        let mut matched = false;

        for (index, line) in content.lines().enumerate() {
            let match_result = if flags.case_insensitive {
                line.to_lowercase()
                    .contains(&pattern.to_lowercase())
            } else {
                line.contains(pattern)
            };

            let is_match = if flags.invert_match {
                !match_result
            } else {
                match_result
            };

            if is_match {
                matched = true;

                if flags.match_entire_line {
                    if line != pattern {
                        continue;
                    }
                }

                if flags.list_file_names {
                    results.push(file.to_string());
                    break;
                }

                let mut output = String::new();

                if !files.is_empty() && files.len() > 1 {
                    output.push_str(file);
                    output.push(':');
                }

                if flags.include_line_numbers {
                    output.push_str(&format!("{}:", index + 1));
                }

                output.push_str(line);

                results.push(output);
            }
        }
    }

    Ok(results)
}
