        }
        long resultValue = wordValue(result, charList, assignment);
        return sum == resultValue;
    }

    private long wordValue(String word, List<Character> charList, int[] assignment) {
        long value = 0;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            int digit = -1;
            for (int j = 0; j < charList.size(); j++) {
                if (charList.get(j) == c) {
                    digit = assignment[j];
                    break;
                }
            }
            value = value * 10 + digit;
