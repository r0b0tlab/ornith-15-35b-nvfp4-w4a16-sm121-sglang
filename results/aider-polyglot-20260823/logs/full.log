```javascript
import { InputCell, ComputeCell, CallbackCell } from './react';

describe('react', () => {
  test('input cells have values that can be set', () => {
    const input = new InputCell(10);
    expect(input.value).toBe(10);
  });

  test('input cells values can be changed', () => {
    const input = new InputCell(4);
    input.setValue(20);
    expect(input.value).toBe(20);
  });

  test('compute cells get values from input cells', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    expect(sum.value).toBe(3);
  });

  test('compute cells can have their values changed', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    input.setValue(3);
    expect(sum.value).toBe(5);
  });

  test('compute cells can depend on other compute cells', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const product = new ComputeCell([input, new InputCell(5)], (a, b) => a * b);
    const result = new ComputeCell([sum, product], (a, b) => a + b);
    input.setValue(10);
    expect(result.value).toBe(60);
  });

  test('callbacks can be added to compute cells', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const callback = jest.fn();
    sum.addCallback(callback);
    input.setValue(3);
    expect(callback).toHaveBeenCalledWith(5);
  });

  test('callbacks only fire when value changes', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const callback = jest.fn();
    sum.addCallback(callback);
    input.setValue(3);
    input.setValue(3);
    expect(callback).toHaveBeenCalledTimes(1);
  });

  test('callbacks only fire when value changes between stable states', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const callback = jest.fn();
    sum.addCallback(callback);
    input.setValue(3);
    input.setValue(4);
    input.setValue(5);
    expect(callback).toHaveBeenCalledTimes(1);
  });

  test('callbacks can be removed', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const callback = jest.fn();
    sum.addCallback(callback);
    sum.removeCallback(callback);
    input.setValue(3);
    expect(callback).not.toHaveBeenCalled();
  });

  test('callbacks fire in order', () => {
    const input = new InputCell(1);
    const sum = new ComputeCell([input, new InputCell(2)], (a, b) => a + b);
    const callback1 = jest.fn();
    const callback2 = jest.fn();
    sum.addCallback(callback1);
    sum.addCallback(callback2);
    input.setValue(3);
    expect(callback1.mock.calls[0][0]).toBe(5);
    expect(callback2.mock.calls[0][0]).toBe(5);
  });

  test('CallbackCell', () => {
    const callback = jest.fn((x) => x + 1);
    const cell = new CallbackCell(callback);
    expect(cell.value).toBe(1);
  });
});
```

