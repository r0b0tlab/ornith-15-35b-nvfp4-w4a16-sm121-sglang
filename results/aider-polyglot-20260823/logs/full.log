I'll implement the Go Counting algorithm. The solution requires:
1. Storing the board and its dimensions
2. Implementing `getTerritory` to find territory for a specific coordinate
3. Implementing `getTerritories` to find all territories

The key logic is a flood-fill to find empty cells (territory), then checking all bordering stones to determine whose territory it is.

go-counting.js
```javascript
//
// This is only a SKELETON file for the 'Go Counting' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class GoCounting {
  constructor(board) {
    this.board = board;
    this.height = board.length;
    this.width = board.length > 0 ? board[0].length : 0;
  }

  isValidPoint(x, y) {
    return x >= 0 && x < this.width && y >= 0 && y < this.height;
  }

  getTerritory(x, y) {
    if (!this.isValidPoint(x, y)) {
      return new Error('Invalid coordinate');
    }

    const cell = this.board[y][x];

    if (cell !== ' ') {
      return new Error('Not an empty cell');
    }

    const visited = new Set();
    const territory = [];
    const colors = new Set();

    const stack = [[x, y]];

    while (stack.length > 0) {
      const [cx, cy] = stack.pop();

      const key = `${cx},${cy}`;

      if (visited.has(key)) {
        continue;
      }

      visited.add(key);
      territory.push([cx, cy]);

      const directions = [
        [1, 0],
        [-1, 0],
        [0, 1],
        [0, -1],
      ];

      for (const [dx, dy] of directions) {
        const nx = cx + dx;
        const ny = cy + dy;

        if (!this.isValidPoint(nx, ny)) {
          continue;
        }

        const ncell = this.board[ny][nx];

        if (ncell === ' ') {
          if (!visited.has(`${nx},${ny}`)) {
            stack.push([nx, ny]);
          }
        } else if (ncell === 'B' || ncell === 'W') {
          colors.add(ncell);
        }
      }
    }

    let owner = 'NONE';

    if (colors.size === 1) {
      owner = Array.from(colors)[0] === 'B' ? 'BLACK' : 'WHITE';
    }

    return {
      owner,
      territory,
    };
  }

  getTerritories() {
    const territories = {
      territoryBlack: [],
      territoryWhite: [],
      territoryNone: [],
    };

    const visited = new Set();

    for (let y = 0; y < this.height; y++) {
      for (let x = 0; x < this.width; x++) {
        const key = `${x},${y}`;

        if (visited.has(key)) {
          continue;
        }

        const cell = this.board[y][x];

        if (cell === ' ') {
          const result = this.getTerritory(x, y);

          result.territory.forEach(([tx, ty]) => {
            visited.add(`${tx},${ty}`);
          });

          if (result.owner === 'BLACK') {
            territories.territoryBlack.push(result.territory);
          } else if (result.owner === 'WHITE') {
            territories.territoryWhite.push(result.territory);
          } else {
            territories.territoryNone.push(result.territory);
          }
        }
      }
    }

    return territories;
  }
}
