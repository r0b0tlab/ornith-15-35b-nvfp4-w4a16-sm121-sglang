I'll implement the OCR numbers solution. Here's my approach:

1. Parse the input into rows of 4 lines each
2. For each set of 4 rows, extract 3-character wide chunks
3. Match each chunk against known number patterns
4. Replace unrecognized patterns with '?'
5. Join multiple lines with commas

ocr-numbers.js
```javascript
//
// This is only a SKELETON file for the 'OCR Numbers' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const convert = (input) => {
  const lines = input.split('\n');
  
  if (lines.length % 4 !== 0) {
    throw new Error('Number of input lines must be a multiple of 4');
  }
  
  // Check all rows have the same length (must be multiple of 3)
  for (const line of lines) {
    if (line.length % 3 !== 0) {
      throw new Error('Number of input columns must be a multiple of 3');
    }
  }
  
  // Check all rows have the same length
  const firstLineLength = lines[0].length;
  for (const line of lines) {
    if (line.length !== firstLineLength) {
      throw new Error('All rows must have the same length');
    }
  }
  
  const result = [];
  
  // Process each group of 4 rows
  for (let row = 0; row < lines.length; row += 4) {
    const gridLines = lines.slice(row, row + 4);
    result.push(convertRow(gridLines));
  }
  
  return result.join(',');
};

function convertRow(gridLines) {
  const numberPatterns = {
    ' _ | ||_|   ': '0',
    '     |  |   ': '1',
    ' _  _||_    ': '2',
    ' _  _|  _   ': '3',
    '   |  | _   ': '4',
    ' _  _||_    ': '5',
    ' _  |_| _   ': '6',
    ' _   |  |   ': '7',
    ' _ |_||_|   ': '8',
    ' _ |_|  _   ': '9'
  };
  
  let result = '';
  
  // Process each 3-character wide column
  for (let col = 0; col < gridLines[0].length; col += 3) {
    let pattern = '';
    for (let row = 0; row < 4; row++) {
      pattern += gridLines[row].substring(col, col + 3);
    }
    result += numberPatterns[pattern] || '?';
  }
  
  return result;
}
