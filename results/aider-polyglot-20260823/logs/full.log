    const rows = this.puzzle.length;
    const cols = this.puzzle[0].length;

    // Directions: [dy, dx] for all 8 directions
    const directions = [
      [0, 1],   // right
      [0, -1],  // left
      [1, 0],   // down
      [-1, 0],  // up
      [1, 1],   // down-right
      [1, -1],  // down-left
      [-1, 1],  // up-right
      [-1, -1], // up-left
    ];

    // Search for the word starting at position (r, c) in direction (dr, dc)
    const searchInDirection = (r, c, dr, dc) => {
      for (let i = 0; i < word.length; i++) {
        const nr = r + i * dr;
        const nc = c + i * dc;

        // Check bounds
        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
          return false;
        }

        // Check character match
        if (this.puzzle[nr][nc] !== word[i]) {
          return false;
        }
      }

      // First letter position (1-indexed)
      const start = {
        column: c + 1,
        row: r + 1,
      };

      // Last letter position (1-indexed)
      const lastI = word.length - 1;
      const end = {
        column: c + lastI * dc + 1,
        row: r + lastI * dr + 1,
      };

      return {
        start,
        end,
      };
    };

    // Search the entire grid
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        // Check if first letter matches
        if (this.puzzle[r][c] === word[0]) {
          for (const [dr, dc] of directions) {
            const result = searchInDirection(r, c, dr, dc);
            if (result) {
              return result;
            }
          }
        }
      }
    }

    return undefined;
  }
}

export default WordSearch;
```
