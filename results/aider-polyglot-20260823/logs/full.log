package react

// Cell is the interface for a cell in the reactive system.
type cell struct {
	value    int
	compute  func(int) int
	compute2 func(int, int) int
	deps     []Cell
	callbacks map[int]func(int)
	reactors  []*reactor
}

// InputCell is the interface for an input cell.
type inputCell struct {
	cell
}

// ComputeCell is the interface for a compute cell.
type computeCell struct {
	cell
}

// Canceler is the interface for cancelling a callback.
type canceler struct {
	cell    *cell
	callbackID int
}

// Reactor is the interface for the reactive system.
type reactor struct {
	inputs  map[int]*cell
	computes map[int]*cell
}

// New creates a new reactor.
func New() Reactor {
	return &reactor{
		inputs:  make(map[int]*cell),
		computes: make(map[int]*cell),
	}
}

// CreateInput creates a new input cell.
func (r *reactor) CreateInput(initial int) InputCell {
	c := &cell{value: initial}
	r.inputs[len(r.inputs)] = c
	return c
}

// CreateCompute1 creates a new compute cell with one dependency.
func (r *reactor) CreateCompute1(dep Cell, compute func(int) int) ComputeCell {
	c := &cell{compute: compute, deps: []Cell{dep}}
	c.value = compute(dep.Value())
	r.computes[len(r.computes)] = c
	return c
}

// CreateCompute2 creates a new compute cell with two dependencies.
func (r *reactor) CreateCompute2(dep1, dep2 Cell, compute func(int, int) int) ComputeCell {
	c := &cell{compute2: func(a, b int) int { return compute(a, b) }, deps: []Cell{dep1, dep2}}
	c.value = compute(dep1.Value(), dep2.Value())
	r.computes[len(r.computes)] = c
	return c
}

// Value returns the current value of the cell.
func (c *cell) Value() int {
	return c.value
}

// SetValue sets the value of an input cell.
func (c *cell) SetValue(value int) {
	if c.value == value {
		return
	}
	c.value = value
	// propagate to dependent cells
	for _, dep := range c.deps {
		// this is a bit backwards, we need to find cells that depend on c
	}
	// trigger callbacks
}

// AddCallback adds a callback to the cell.
func (c *cell) AddCallback(callback func(int)) Canceler {
	id := len(c.callbacks)
	c.callbacks[id] = callback
	return &canceler{cell: c, callbackID: id}
}

// Cancel removes a callback.
func (c *canceler) Cancel() {
	delete(c.cell.callbacks, c.callbackID)
}
