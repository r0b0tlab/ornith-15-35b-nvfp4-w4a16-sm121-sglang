```rust
//! A basic reactive system.

use std::cell::RefCell;
use std::collections::HashMap;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct InputCellId(u32);

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct ComputeCellId(u32);

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct CallbackId(u32);

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum CellId {
    Input(InputCellId),
    Compute(ComputeCellId),
}

#[derive(Debug, PartialEq, Eq)]
pub enum RemoveCallbackError {
    NonexistentCell,
    NonexistentCallback,
}

struct Cell<T> {
    data: CellData<T>,
}

enum CellData<T> {
    Input(T),
    Compute {
        deps: Vec<CellId>,
        func: RefCell<Box<dyn Fn(&[T]) -> T>>,
        value: RefCell<T>,
        listeners: RefCell<Vec<(CallbackId, RefCell<Box<dyn FnMut(T)>>>>>,
    },
}

pub struct Reactor<T> {
    cells: RefCell<HashMap<CellId, Cell<T>>>,
    next_id: RefCell<u32>,
}

impl<T: Copy + PartialEq> Reactor<T> {
    pub fn new() -> Self {
        Reactor {
            cells: RefCell::new(HashMap::new()),
            next_id: RefCell::new(0),
        }
    }

    fn next_id(&mut self) -> u32 {
        let id = self.next_id.borrow();
        let result = *id;
        *id += 1;
        result
    }

    pub fn create_input(&mut self, initial: T) -> InputCellId {
        let id = InputCellId(self.next_id());
        let cell = Cell { data: CellData::Input(initial) };
        self.cells.borrow_mut().insert(CellId::Input(id), cell);
        id
    }

    pub fn create_compute<F: Fn(&[T]) -> T>(
        &mut self,
        dependencies: &[CellId],
        compute_func: F,
    ) -> Result<ComputeCellId, CellId> {
        for dep in dependencies {
            if !self.cells.borrow().contains_key(dep) {
                return Err(*dep);
            }
        }
        let id = ComputeCellId(self.next_id());
        let values: Vec<T> = dependencies
            .iter()
            .map(|d| self.cells.borrow().get(d).unwrap().value())
            .collect();
        let initial = compute_func(&values);
        let cell = Cell {
            data: CellData::Compute {
                deps: dependencies.to_vec(),
                func: RefCell::new(Box::new(compute_func)),
                value: RefCell::new(initial),
                listeners: RefCell::new(Vec::new()),
            },
        };
        self.cells.borrow_mut().insert(CellId::Compute(id), cell);
        Ok(id)
    }

    pub fn value(&self, id: CellId) -> Option<T> {
        self.cells.borrow().get(&id).map(|c| c.value())
    }

    pub fn set_value(&mut self, id: InputCellId, new_value: T) -> bool {
        let cell_id = CellId::Input(id);
        if !self.cells.borrow().contains_key(&cell_id) {
            return false;
        }
        {
            let mut cells = self.cells.borrow_mut();
            match cells.get_mut(&cell_id) {
                Some(Cell { data: CellData::Input(ref mut v) }) => *v = new_value,
                _ => unreachable!(),
            }
        }
        self.propagate();
        true
    }

    fn propagate(&self) {
        loop {
            let mut changed = false;
            let ids: Vec<CellId> = {
                let cells = self.cells.borrow();
                cells.keys().copied().collect()
            };
            for id in ids {
                let (deps, func): (Vec<CellId>, Box<dyn Fn(&[T]) -> T>) = {
                    let cell = self.cells.borrow().get(&id).unwrap();
                    match &cell.data {
                        CellData::Compute { deps, func, .. } => (
                            deps.clone(),
                            func.borrow().clone(),
                        ),
                        _ => continue,
                    }
                };
                let dep_values: Vec<T> = {
                    let cells = self.cells.borrow();
                    deps.iter().map(|d| cells.get(d).unwrap().value()).collect()
                };
                let new_value = func(&dep_values);
                let current = {
                    let cell = self.cells.borrow().get(&id).unwrap();
                    match &cell.data {
                        CellData::Compute { value, .. } => value.borrow(),
                        _ => unreachable!(),
                    }
                };
                if current != new_value {
                    let mut cell = self.cells.borrow_mut();
                    let data = cell.get_mut(&id).unwrap();
                    if let CellData::Compute { value, .. } = &mut data.data {
                        *value.borrow_mut() = new_value;
                    }
                    changed = true;
                }
            }
            if !changed {
                break;
            }
        }
        self.fire_callbacks();
    }

    fn fire_callbacks(&self) {
        let ids: Vec<CellId> = {
            let cells = self.cells.borrow();
            cells.keys().copied().collect()
        };
        for id in ids {
            let (listeners, current) = {
                let cell = self.cells.borrow().get(&id).unwrap();
                match &cell.data {
                    CellData::Compute { listeners, value, .. } => {
                        (listeners.borrow().clone(), value.borrow().clone())
                    }
                    _ => continue,
                }
            };
            for (_cb_id, cb) in listeners.iter() {
                cb(current.clone());
            }
        }
    }

    pub fn add_callback<F: FnMut(T)>(
        &mut self,
        id: ComputeCellId,
        callback: F,
    ) -> Option<CallbackId> {
        let cell_id = CellId::Compute(id);
        match self.cells.borrow_mut().get_mut(&cell_id) {
            Some(cell) => {
                let cb_id = CallbackId(self.next_id());
                match &mut cell.data {
                    CellData::Compute { listeners, .. } => {
                        listeners.borrow_mut().push((cb_id, RefCell::new(Box::new(callback))));
                    }
                    _ => unreachable!(),
                }
                Some(cb_id)
            }
            None => None,
        }
    }

    pub fn remove_callback(
        &mut self,
        cell: ComputeCellId,
        callback: CallbackId,
    ) -> Result<(), RemoveCallbackError> {
        let cell_id = CellId::Compute(cell);
        match self.cells.borrow_mut().get_mut(&cell_id) {
            Some(cell) => match &mut cell.data {
                CellData::Compute { listeners, .. } => {
                    let mut listeners = listeners.borrow_mut();
                    if let Some(pos) = listeners.iter().position(|(id, _)| *id == callback) {
                        listeners.remove(pos);
                        Ok(())
                    } else {
                        Err(RemoveCallbackError::NonexistentCallback)
                    }
                }
                _ => unreachable!(),
            },
            None => Err(RemoveCallbackError::NonexistentCell),
        }
    }
}

