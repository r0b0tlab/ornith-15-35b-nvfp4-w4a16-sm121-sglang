class Zipper:
    @staticmethod
    def from_tree(tree):
        """Create a zipper focused on the root of the given tree."""
        return Zipper(tree, [])

    def value(self):
        """Get the value of the focus node."""
        return self.tree[0]

    def set_value(self):
        """Set the value of the focus node, returns a new zipper."""
        new_zipper = Zipper(self.tree, self.path)
        new_zipper.tree = [self.tree[0], self.tree[1], self.tree[2]]
        new_zipper.tree[0] = self.tree[0]  # placeholder to be replaced by caller
        return new_zipper

    def left(self):
        """Move focus to the left child, returns a new zipper."""
        if self.tree[1] is None:
            return None
        return Zipper(self.tree[1], self.path + [self.tree[2]])

    def set_left(self):
        """Set the left child of the focus node, returns a new zipper."""
        new_zipper = Zipper(self.tree, self.path)
        new_zipper.tree = [self.tree[0], self.tree[1], self.tree[2]]
        new_zipper.tree[1] = self.tree[1]  # placeholder to be replaced by caller
        return new_zipper

    def right(self):
        """Move focus to the right child, returns a new zipper."""
        if self.tree[2] is None:
            return None
        return Zipper(self.tree[2], self.path + self.tree[2][1])

    def set_right(self):
        """Set the right child of the focus node, returns a new zipper."""
        new_zipper = Zipper(self.tree, self.path)
        new_zipper.tree = [self.tree[0], self.tree[1], self.tree[2]]
        new_zipper.tree[2] = self.tree[2]  # placeholder to be replaced by caller
        return new_zipper

    def up(self):
        """Move focus to the parent, returns a new zipper."""
        if not self.path:
            return None
        node, direction = self.path[-1]
        if direction == 'left':
            parent_zipper = Zipper(node, self.path[:-1])
            parent_zipper.tree[1] = self.tree
        else:
            parent_zipper = Zipper(node, self.path[:-1])
            parent_zipper.tree[2] = self.tree
        return parent_zipper

    def to_tree(self):
        """Get the full tree out of the zipper."""
        if not self.path:
            return self.tree
        node, direction = self.path[-1]
        if direction == 'left':
            node[1] = self.tree
        else:
            node[2] = self.tree
        return self.path[0][0] if self.path else self.tree
