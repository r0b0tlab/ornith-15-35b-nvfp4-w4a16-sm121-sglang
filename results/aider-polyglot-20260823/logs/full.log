lib.rs
```rust
use std::collections::HashMap;

pub type Value = i32;
pub type Result = std::result::Result<(), Error>;

#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    DivisionByZero,
    StackUnderflow,
    UnknownWord,
    InvalidWord,
}

pub struct Forth {
    stack: Vec<Value>,
    definitions: HashMap<String, Vec<String>>,
}

impl Forth {
    pub fn new() -> Forth {
        Forth {
            stack: Vec::new(),
            definitions: HashMap::new(),
        }
    }

    pub fn stack(&self) -> &[Value] {
        &self.stack
    }

    pub fn eval(&mut self, input: &str) -> Result {
        // Split into tokens
        let tokens: Vec<String> = input.split_whitespace().map(|s| s.to_uppercase()).collect();

        // Process tokens
        let mut index = 0;
        while index < tokens.len() {
            if tokens[index] == ":" {
                // Definition
                let end = tokens[index..]
                    .iter()
                    .position(|t| t == ";")
                    .map(|p| p + index)
                    .ok_or(Error::InvalidWord)?;
                self.eval_definition(&tokens[index..=end])?;
                index = end + 1;
            } else {
                self.eval_token(&tokens[index])?;
                index += 1;
            }
        }

        Ok(())
    }

    fn eval_definition(&mut self, tokens: &[String]) -> Result {
        // tokens[0] == ":"
        // tokens[last] == ";"
        if tokens.len() < 4 {
            return Err(Error::InvalidWord);
        }

        let word_name = tokens[1].clone();
        if word_name.chars().all(|c| c.is_ascii_digit()) {
            return Err(Error::InvalidWord);
        }

        if tokens[tokens.len() - 1] != ";" {
            return Err(Error::InvalidWord);
        }

        // Extract the definition tokens (excluding ":" and ";")
        let def_tokens = tokens[2..tokens.len() - 1].to_vec();

        // Store the definition
        self.definitions.insert(word_name, def_tokens);

        Ok(())
    }

    fn eval_token(&mut self, token: &str) -> Result {
        // Check if it's a number
        if let Ok(num) = token.parse::<i32>() {
            self.stack.push(num);
            return Ok(());
        }

        // Check built-in words
        match token {
            "+" => self.arithmetic(|a, b| a + b),
            "-" => self.arithmetic(|a, b| a - b),
            "*" => self.arithmetic(|a, b| a * b),
            "/" => self.arithmetic(|a, b| {
                if b == 0 {
                    Err(Error::DivisionByZero)
                } else {
                    Ok(a / b)
                }
            }),
            "DUP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                let num = self.stack[self.stack.len() - 1];
                self.stack.push(num);
                Ok(())
            }
            "DROP" => {
                if self.stack.is_empty() {
                    return Err(Error::StackUnderflow);
                }
                self.stack.pop();
                Ok(())
            }
            "SWAP" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                self.stack.swap(self.stack.len() - 1, self.stack.len() - 2);
                Ok(())
            }
            "OVER" => {
                if self.stack.len() < 2 {
                    return Err(Error::StackUnderflow);
                }
                let num = self.stack[self.stack.len() - 2];
                self.stack.push(num);
                Ok(())
            }
            _ => {
                // Check if it's a user-defined word
                if let Some(def) = self.definitions.get(token) {
                    for t in def {
                        self.eval_token(t)?;
                    }
                    Ok(())
                } else {
                    Err(Error::UnknownWord)
                }
            }
        }
    }

    fn arithmetic<F>(&mut self, op: F) -> Result
    where
        F: Fn(i32, i32) -> Result,
    {
        if self.stack.len() < 2 {
            return Err(Error::StackUnderflow);
        }
        let b = self.stack.pop().unwrap();
        let a = self.stack.pop().unwrap();
        let result = op(a, b)?;
        self.stack.push(result);
        Ok(())
    }
}
