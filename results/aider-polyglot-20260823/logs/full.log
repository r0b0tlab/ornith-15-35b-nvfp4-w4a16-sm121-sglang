This is repetitive. Let me refactor the name generation into a helper.

lib.rs
```rust
use std::collections::HashSet;
use std::sync::Mutex;
use std::sync::OnceLock;
use std::time::SystemTime;

fn global_names() -> &'static Mutex<HashSet<String>> {
    static NAMED_ROBOTS: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
    NAMED_ROBOTS.get_or_init(|| Mutex::new(HashSet::new()))
}

fn gen_name() -> String {
    let mut chars: String = (0..2)
        .map(|_| (b'A' + rand_first_char()) as char)
        .collect();
    let num = rand_num();
    for _ in 0..3 {
        chars.push((b'0' + (num % 10) as u8) as char);
        num /= 10;
    }
    chars
}

pub struct Robot {
    name: String,
}

impl Robot {
    pub fn new() -> Self {
        let name = loop {
            let candidate = gen_name();
            let mut named_robots = global_names().lock().unwrap();
            if !named_robots.contains(&candidate) {
                named_robots.insert(candidate.clone());
                break candidate;
            }
        };
        Robot { name }
    }

    pub fn name(&self) -> &str {
        &self.name
    }

    pub fn reset_name(&mut self) {
        let name = loop {
            let candidate = gen_name();
            let mut named_robots = global_names().lock().unwrap();
            if !named_robots.contains(&candidate) {
                named_robots.insert(candidate.clone());
                break candidate;
            }
        };
        self.name = name;
    }
}

fn rand_first_char() -> u8 {
    (SystemTime::now()
        .duration_since(SystemTime::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 26) as u8
}

fn rand_num() -> u64 {
    SystemTime::now()
        .duration_since(SystemTime::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 1000
}
