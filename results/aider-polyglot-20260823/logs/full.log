class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._callbacks = []
        self._compute_cells = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, value):
        self._value = value
        self.update_dependent_cells()

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)

    def notify_callbacks(self):
        for callback in list(self._callbacks):
            callback(self._value)

    def register_compute_cell(self, compute_cell):
        self._compute_cells.append(compute_cell)

    def update_dependent_cells(self):
        for compute_cell in self._compute_cells:
            compute_cell.update_value()


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = inputs
        self._compute_function = compute_function
        self._value = compute_function([input.value for input in inputs])
        self._callbacks = []
        self._compute_cells = []
        for input_cell in inputs:
            input_cell.register_compute_cell(self)

    @property
    def value(self):
        return self._value

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)

    def update_value(self):
        new_value = self._compute_function([input.value for input in self._inputs])
        if new_value != self._value:
            self._value = new_value
            self.notify_callbacks()
            for compute_cell in self._compute_cells:
                compute_cell.update_value()

    def notify_callbacks(self):
        for callback in list(self._callbacks):
            callback(self._value)

    def register_compute_cell(self, compute_cell):
        self._compute_cells.append(compute_cell)

    def register_callbacks(self, callbacks):
        for callback in callbacks:
            self.add_callback(callback)

    def remove_callbacks(self, callbacks):
        for callback in callbacks:
            self.remove_callback(callback)
