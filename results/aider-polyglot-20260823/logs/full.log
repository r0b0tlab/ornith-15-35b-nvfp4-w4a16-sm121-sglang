killer-sudoku-helper.js
```js
//
// This is only a SKELETON file for the 'Killer Sudoku Helper' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const combinations = (cage, sum, restrict) => {
  const result = [];

  const backtrack = (start, remaining, current) => {
    if (remaining === 0) {
      result.push(current);
      return;
    }
    for (let i = start; i <= 9; i++) {
      if (restrict && restrict.includes(i)) continue;
      if (i > remaining) break;
      backtrack(i + 1, remaining - i, [...current, i]);
    }
  };

  backtrack(1, sum, []);
  return result;
};
```
