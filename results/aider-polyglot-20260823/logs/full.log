		seen[child] = true
	}

	// If children are not provided, use the default list.
	if len(children) == 0 {
		children = append(children, defaultChildren...)
	}

	// Ensure children are sorted alphabetically as the teacher assigns cups.
	for i := 1; i < len(children); i++ {
