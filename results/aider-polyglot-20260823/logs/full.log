complex-numbers.js
```javascript
//
// This is only a SKELETON file for the 'Complex Numbers' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class ComplexNumber {
  constructor(real, imaginary) {
    this._real = real;
    this._imaginary = imaginary;
  }

  get real() {
    return this._real;
  }

  get imaginary() {
    return this._imaginary;
  }

  add(other) {
    return new ComplexNumber(
      this._real + other.real,
      this._imaginary + other.imag
    );
  }

  sub(other) {
    return new ComplexNumber(
      this._real - other.real,
      this._imaginary - other.imag
    );
  }

  div(other) {
    const denominator = other.real ** 2 + other.imag ** 2;
    const real = (this._real * other.real + this._imaginary * other.imag) / denominator;
    const imaginary = (this._imaginary * other.real - this._real * other.imag) / denominator;
    return new ComplexNumber(real, imaginary);
  }

  mul(other) {
    const real = this._real * other.real - this._imaginary * other.imag;
    const imaginary = this._imaginary * other.real + this._real * other.imag;
    return new ComplexNumber(real, imaginary);
  }

  get abs() {
    return Math.sqrt(this._real ** 2 + this._imaginary ** 2);
  }

  get conj() {
    return new ComplexNumber(this._real, -this._imaginary);
  }

  get exp() {
    const real = Math.exp(this._real) * Math.cos(this._imaginary);
    const imaginary = Math.exp(this._real) * Math.sin(this._imaginary);
    return new ComplexNumber(real, imaginary);
  }
}
```
