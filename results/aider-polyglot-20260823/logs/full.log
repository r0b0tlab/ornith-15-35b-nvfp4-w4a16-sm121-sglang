/// Given a list of poker hands, return a list of those hands which win.
///
/// Note the type signature: this function should return _the same_ reference to
/// the winning hand(s) as were passed in, not reconstructed strings which happen to be equal.
pub fn winning_hands<'a>(hands: &[&'a str]) -> Vec<&'a str> {
    if hands.is_empty() {
        return Vec::new();
    }
    
    // Evaluate each hand to get a comparable score
    let evaluated: Vec<(&'a str, HandRank)> = hands
        .iter()
        .map(|&hand| (hand, evaluate_hand(hand)))
        .collect();
    
    // Find the best rank
    let best_rank = evaluated
        .iter()
        .map(|(_, rank)| rank)
        .max()
        .expect("At least one hand is expected");
    
    // Return all hands that match the best rank
    evaluated
        .into_iter()
        .filter(|(_, rank)| rank == &best_rank)
        .map(|(hand, _)| hand)
        .collect()
}

/// Represents the evaluation of a poker hand as a comparable tuple.
/// The tuple is ordered so that higher values indicate better hands.
#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
