I need to update the function signature to accept positional parameters.

meetup.js
```javascript
//
// This is only a SKELETON file for the 'Meetup' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

export const meetup = (year, month, week, day) => {
  const targetDayIndex = WEEKDAYS.indexOf(day);

  if (week === 'teenth') {
    // Teenth days are 13th-19th, find the one matching the target weekday
    for (let date = 13; date <= 19; date++) {
      const d = new Date(year, month - 1, date);
      if (d.getDay() === targetDayIndex) {
        return d;
      }
    }
  } else {
    const weekIndex = ['first', 'second', 'third', 'fourth', 'last'].indexOf(week);
    
    if (week === 'last') {
      // Find the last day of the month with the target weekday
      const lastDate = new Date(year, month, 0).getDate();
      for (let date = lastDate; date >= 1; date--) {
        const d = new Date(year, month - 1, date);
        if (d.getDay() === targetDayIndex) {
          return d;
        }
      }
    } else {
      // Find the nth occurrence of the target weekday
      let count = 0;
      const daysInMonth = new Date(year, month, 0).getDate();
      for (let date = 1; date <= daysInMonth; date++) {
        const d = new Date(year, month - 1, date);
        if (d.getDay() === targetDayIndex) {
          count++;
          if (count === weekIndex + 1) {
            return d;
          }
        }
      }
    }
  }
};
