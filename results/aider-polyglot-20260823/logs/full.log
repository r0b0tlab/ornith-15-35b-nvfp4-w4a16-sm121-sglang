```go
package transpose

import "strings"

func Transpose(input []string) []string {
	if len(input) == 0 {
		return []string{}
	}

	// Find the maximum length of any input row
	maxLen := 0
	for _, row := range input {
		if len(row) > maxLen {
			maxLen = len(row)
		}
	}

	// Build the transposed output
	result := make([]string, maxLen)

	for col := 0; col < maxLen; col++ {
		var sb strings.Builder
		for row := 0; row < len(input); row++ {
			if col < len(input[row]) {
				sb.WriteByte(input[row][col])
			} else {
				// Check if there's any character after this position in later rows
				hasLater := false
				for laterRow := row + 1; laterRow < len(input); laterRow++ {
					if col < len(input[laterRow]) {
						hasLater = true
						break
					}
				}
				if hasLater {
					// Pad with space
					sb.WriteByte(' ')
				}
			}
		}
		result[col] = sb.String()
	}

	return result
}
```

