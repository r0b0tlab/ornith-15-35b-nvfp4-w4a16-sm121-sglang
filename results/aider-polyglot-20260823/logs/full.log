```java
import java.awt.Point;
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Deque;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

enum Player {
    BLACK,
    WHITE,
    NONE
}

class GoCounting {

    private final int size;
    private final char[][] board;

    GoCounting(String board) {
        String[] rows = board.split("\n");
        this.size = rows.length;
        this.board = new char[size][];
        for (int i = 0; i < size; i++) {
            this.board[i] = rows[i].toCharArray();
        }
    }

    Player getTerritoryOwner(int x, int y) {
        validateCoordinate(x, y);
        if (board[y][x] == '.') {
            Set<Point> territory = floodFill(x, y);
            Player owner = determineTerritoryOwner(territory);
            if (owner == Player.NONE) {
                return Player.NONE;
            }
            return owner;
        }
        return Player.NONE;
    }

    Set<Point> getTerritory(int x, int y) {
        validateCoordinate(x, y);
        if (board[y][x] != '.') {
            return new HashSet<>();
        }
        return floodFill(x, y);
    }

    Map<Player, Set<Point>> getTerritories() {
        Map<Player, Set<Point>> territories = new HashMap<>();
        territories.put(Player.BLACK, new HashSet<>());
        territories.put(Player.WHITE, new HashSet<>());
        territories.put(Player.NONE, new HashSet<>());

        Set<Point> visited = new HashSet<>();
        for (int y = 0; y < size; y++) {
            for (int x = 0; x < size; x++) {
                Point point = new Point(x, y);
                if (board[y][x] == '.' && !visited.contains(point)) {
                    Set<Point> territory = floodFill(x, y);
                    for (Point p : territory) {
                        visited.add(p);
                    }
                    Player owner = determineTerritoryOwner(territory);
                    territories.get(owner).addAll(territory);
                }
            }
        }
        return territories;
    }

    private void validateCoordinate(int x, int y) {
        if (x < 0 || x >= size || y < 0 || y >= size) {
            throw new IllegalArgumentException("Invalid coordinate");
        }
    }

    private Set<Point> floodFill(int x, int y) {
        Set<Point> territory = new HashSet<>();
        Deque<Point> queue = new ArrayDeque<>();
        queue.add(new Point(x, y));

        while (!queue.isEmpty()) {
            Point point = queue.poll();
            if (territory.contains(point)) {
                continue;
            }
            if (board[point.y][point.x] != '.') {
                continue;
            }
            territory.add(point);

            int[] dx = {1, -1, 0, 0};
            int[] dy = {0, 0, 1, -1};
            for (int i = 0; i < 4; i++) {
                int nx = point.x + dx[i];
                int ny = point.y + dy[i];
                if (nx >= 0 && nx < size && ny >= 0 && ny < size) {
                    queue.add(new Point(nx, ny));
                }
            }
        }
        return territory;
    }

    private Player determineTerritoryOwner(Set<Point> territory) {
        Set<Player> touchingPlayers = new HashSet<>();
        int[] dx = {1, -1, 0, 0};
        int[] dy = {0, 0, 1, -1};

        for (Point point : territory) {
            for (int i = 0; i < 4; i++) {
                int nx = point.x + dx[i];
                int ny = point.y + dy[i];
                if (nx >= 0 && nx < size && ny >= 0 && ny < size) {
                    char c = board[ny][nx];
                    if (c == 'B') {
                        touchingPlayers.add(Player.BLACK);
                    } else if (c == 'W') {
                        touchingPlayers.add(Player.WHITE);
                    }
                }
            }
        }

        if (touchingPlayers.size() == 1) {
            return touchingPlayers.iterator().next();
        }
        return Player.NONE;
    }
}
```

Let me explain the implementation:

1. **Player enum**: Added `BLACK`, `WHITE`, and `NONE` to represent the different players and the "no owner" state.

2. **Board parsing**: The constructor parses the board string (split by newlines) into a 2D character array.

3. **floodFill**: Uses a breadth-first search to find all connected empty intersections, which forms the territory.

4. **determineTerritoryOwner**: Checks all neighbors of the territory. If the territory touches only one type of stone, that player owns it. If it touches both colors or no stones, it's neutral (NONE).

5. **getTerritoryOwner**: Returns the owner of the territory containing the given point.

6. **getTerritory**: Returns the set of points in the territory containing the given point.

7. **getTerritories**: Iterates through all points, using flood fill to find unvisited territories and assigns them to the appropriate player.

The implementation handles all the requirements: empty regions are encircled, and territory ownership is determined by which color of stones fully surrounds the region.
