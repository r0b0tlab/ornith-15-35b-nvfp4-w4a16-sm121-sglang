class PigLatinTranslator {
    public String translate(String word) {
        String[] words = word.split(" ");
        StringBuilder result = new StringBuilder();

        for (String w : words) {
            if (result.length() > 0) {
                result.append(" ");
            }
            result.append(translateWord(w));
        }

        return result.toString();
    }

    private String translateWord(String word) {
        // Rule 1: If a word begins with a vowel, or starts with "xr" or "yt",
        // add "ay" to the end.
        if (isVowelStart(word) || word.startsWith("xr") || word.startsWith("yt")) {
            return word + "ay";
        }

        // Rule 3: If a word starts with zero or more consonants followed by "qu",
        // move those consonants and the "qu" part to the end, then add "ay".
        int quIndex = word.indexOf("qu");
        if (quIndex >= 0) {
            String prefix = word.substring(0, quIndex + 2);
            String rest = word.substring(quIndex + 2);
            return rest + prefix + "ay";
        }

        // Rule 2: If a word begins with one or more consonants,
        // move them to the end, then add "ay".
        // Rule 4: If a word starts with one or more consonants followed by "y",
        // move the consonants before the "y" to the end, then add "ay".
        int firstVowelIndex = findFirstVowelIndex(word);
        if (firstVowelIndex > 0) {
            String prefix = word.substring(0, firstVowelIndex);
            String rest = word.substring(firstVowelIndex);
            return rest + prefix + "ay";
        }

        // No consonants before a vowel, so just add "ay"
        return word + "ay";
    }

    private boolean isVowelStart(String word) {
        return word.startsWith("a") || word.startsWith("e") ||
               word.startsWith("i") || word.startsWith("o") ||
               word.startsWith("u");
    }

    private int findFirstVowelIndex(String word) {
        // 'y' acts as a vowel when it's not the first letter
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
                return i;
            }
            if (c == 'y' && i > 0) {
                return i;
            }
        }
        return -1;
    }
}
```

