sublist.cpp

```diff
@@ -1,5 +1,50 @@
 #include "sublist.h"
+#include <algorithm>
 
 namespace sublist {
 
+// Check if list_a contains list_b as a contiguous sub-sequence
+bool containsSublist(const std::vector<int>& main, const std::vector<int>& sub)
{
+    if (sub.empty()) {
+        return true;
+    }
+    if (sub.size() > main.size()) {
+        return false;
+    }
+    
+    for (size_t i = 0; i + sub.size() <= main.size(); ++i) {
+        if (main[i] == sub[0]) {
+            bool match = true;
+            for (size_t j = 0; j < sub.size(); ++j) {
+                if (main[i + j] != sub[j]) {
+                    match = false;
+                    break;
+                }
+            }
+            if (match) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+Comparison sublist(const std::vector<int>& list_a, const std::vector<int>& 
list_b) {
+    if (list_a == list_b) {
+        return Comparison::equal;
+    }
+    
+    // Check if list_a is a sublist of list_b
+    if (containsSublist(list_b, list_a)) {
+        return Comparison::sublist;
+    }
+    
+    // Check if list_a is a superlist of list_b
+    if (containsSublist(list_a, list_b)) {
+        return Comparison::superlist;
+    }
+    
+    return Comparison::unequal;
+}
+
 }  // namespace sublist
