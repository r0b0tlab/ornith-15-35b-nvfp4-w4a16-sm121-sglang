Zipper.java
```java
class Zipper {
    int value;
    Zipper up;
    Zipper left;
    Zipper right;

    Zipper(int val) {
        this.value = val;
    }

    BinaryTree toTree() {
        if (up == null) {
            // We're at the root
            return new BinaryTree(this);
        }
        // Navigate to root
        Zipper current = this;
        while (current.up != null) {
            current = current.up;
        }
        return new BinaryTree(current);
    }

    int getValue() {
        return value;
    }

    Zipper setLeft(Zipper leftChild) {
        Zipper result = new Zipper(value);
        result.up = up;
        result.left = leftChild;
        if (leftChild != null) {
            leftChild.up = result;
        }
        if (right != null) {
            result.right = right;
            right.up = result;
        }
        if (up != null) {
            if (up.left == this) {
                up.left = result;
            } else {
                up.right = result;
            }
        }
        return result;
    }

    Zipper setRight(Zipper rightChild) {
        Zipper result = new Zipper(value);
        result.up = up;
        result.left = left;
        if (left != null) {
            left.up = result;
        }
        result.right = rightChild;
        if (rightChild != null) {
            rightChild.up = result;
        }
        if (up != null) {
            if (up.left == this) {
                up.left = result;
            } else {
                up.right = result;
            }
        }
        return result;
    }

    void setValue(int val) {
        this.value = val;
    }
}

class BinaryTree {
    Zipper root;

    BinaryTree(int value) {
        this.root = new Zipper(value);
    }

    BinaryTree(Zipper root) {
        this.root = root;
    }

    Zipper getRoot() {
        return root;
    }

    String printTree() {
        StringBuilder sb = new StringBuilder();
        printTree(root, sb);
        return sb.toString();
    }

    private void printTree(Zipper node, StringBuilder sb) {
        if (node == null) {
            return;
        }
        sb.append("(");
        sb.append(node.getValue());
        if (node.left != null || node.right != null) {
            sb.append(" ");
            printTree(node.left, sb);
            sb.append(" ");
            printTree(node.right, sb);
        }
        sb.append(")");
    }
}
