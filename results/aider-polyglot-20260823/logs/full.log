bottle-song.js
```javascript
//
// This is only a SKELETON file for the 'Bottle Song' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export const recite = (initialBottlesCount, takeDownCount) => {
  const numberWords = [
    'no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'
  ];

  const capitalize = (word) => word.charAt(0).toUpperCase() + word.slice(1);

  const verses = [];

  for (let i = 0; i < takeDownCount; i++) {
    const currentBottles = initialBottlesCount - i;
    const nextBottles = currentBottles - 1;

    const currentBottlesWord = numberWords[currentBottles];
    const nextBottlesWord = numberWords[nextBottles];

    const currentBottlesLabel = currentBottles === 1 ? 'bottle' : 'bottles';
    const nextBottlesLabel = nextBottles === 1 ? 'bottle' : 'bottles';

    const verse = [
      `${capitalize(currentBottlesWord)} green ${currentBottlesLabel} hanging on the wall,`,
      `${capitalize(currentBottlesWord)} green ${currentBottlesLabel} hanging on the wall,`,
      'And if one green bottle should accidentally fall,',
      `There'll be ${nextBottlesWord} green ${nextBottlesLabel} hanging on the wall.`
    ];

    verses.push(...verse);

    if (i < takeDownCount - 1) {
      verses.push('');
    }
  }

  return verses;
};
```
