response:
`byte` is a reserved keyword in Java and cannot be used as a variable name. I'll rename it to `b`.

VariableLengthQuantity.java
```java
import java.util.ArrayList;
import java.util.List;

class VariableLengthQuantity {

    List<String> encode(List<Long> numbers) {
        List<String> result = new ArrayList<>();
        for (Long number : numbers) {
            if (number == null || number < 0) {
                throw new IllegalArgumentException("Only non-negative values are allowed");
            }
            result.addAll(encodeNumber(number));
        }
        return result;
    }

    private List<String> encodeNumber(Long number) {
        List<String> bytes = new ArrayList<>();
        
        if (number == 0) {
            bytes.add("00");
            return bytes;
        }
        
        // Extract 7-bit chunks
        List<Long> chunks = new ArrayList<>();
        long value = number;
        while (value > 0) {
            chunks.add(0, value & 0x7F);
            value >>= 7;
        }
        
        // Set the continuation bit on all but the last chunk
        for (int i = 0; i < chunks.size() - 1; i++) {
            chunks.set(i, chunks.get(i) | 0x80);
        }
        
        // Convert to hex strings
        for (Long chunk : chunks) {
            bytes.add(String.format("%02X", chunk));
        }
        
        return bytes;
    }

    List<Long> decode(List<Long> bytes) {
        List<Long> result = new ArrayList<>();
        long current = 0;
        boolean inProgress = false;
        
        for (Long b : bytes) {
            if (b == null || b < 0) {
                throw new IllegalArgumentException("Only non-negative values are allowed");
            }
            
            long value = b;
            
            if ((value & 0x80) != 0) {
                // Continuation byte
                current = (current << 7) | (value & 0x7F);
                inProgress = true;
            } else {
                // Last byte of the sequence
                current = (current << 7) | value;
                result.add(current);
                current = 0;
                inProgress = false;
            }
        }
        
        if (inProgress) {
            throw new IllegalArgumentException("Invalid sequence");
        }
        
        return result;
    }
}
```
