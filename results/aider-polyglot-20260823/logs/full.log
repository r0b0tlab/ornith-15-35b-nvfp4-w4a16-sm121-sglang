protein_translation.go
```go
package protein

import "errors"

var errInvalidCodon = errors.New("invalid codon")
var errIncompleteRNA = errors.New("incomplete RNA sequence")

var codonProteins = map[string]string{
	"AUG": "Methionine",
	"UUU": "Phenylalanine",
	"UUC": "Phenylalanine",
	"UUA": "Leucine",
	"UUG": "Leucine",
	"UCU": "Serine",
	"UCC": "Serine",
	"UCA": "Serine",
	"UCG": "Serine",
	"UAU": "Tyrosine",
	"UAC": "Tyrosine",
	"UGU": "Cysteine",
	"UGC": "Cysteine",
	"UGG": "Tryptophan",
	"UAA": "STOP",
	"UAG": "STOP",
	"UGA": "STOP",
}

func FromCodon(codon string) (string, error) {
	protein, ok := codonProteins[codon]
	if !ok {
		return "", errInvalidCodon
	}
	return protein, nil
}

func FromRNA(rna string) ([]string, error) {
	var proteins []string

	for i := 0; i+3 <= len(rna); i += 3 {
		codon := rna[i : i+3]
		protein, err := FromCodon(codon)
		if err != nil {
			return nil, err
		}
		if protein == "STOP" {
			break
		}
		proteins = append(proteins, protein)
	}

	if len(rna)%3 != 0 {
		return nil, errIncompleteRNA
	}

	return proteins, nil
}
```

This implementation:

1. **FromCodon**: Uses a map to look up the protein for a given codon, returning an error for invalid codons.

2. **FromRNA**: 
   - Processes the RNA in chunks of 3 nucleotides (codons)
   - Stops translation when encountering a STOP codon
   - Returns an error for invalid codons
   - Returns an error if the RNA length isn't divisible by 3 (incomplete codon)
   - Handles empty RNA sequences correctly (returns empty slice, no error)
