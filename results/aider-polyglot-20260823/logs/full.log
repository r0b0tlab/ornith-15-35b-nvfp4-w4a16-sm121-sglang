import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedList;
import java.util.Map;
import java.util.Queue;
import java.util.Set;

class TwoBucket {
    private int totalMoves;
    private String finalBucket;
    private int otherBucket;

    TwoBucket(int bucketOneCap, int bucketTwoCap, int desiredLiters, String startBucket) {
        // Validate that the desired amount is achievable
        if (desiredLiters > bucketOneCap && desiredLiters > bucketTwoCap) {
            throw new IllegalArgumentException("Desired liters cannot exceed both bucket capacities");
        }

        // Determine which bucket cannot be used (the "forbidden" bucket)
        boolean startBucketOne = startBucket.equals("one");
        int startBucketCap = startBucketOne ? bucketOneCap : bucketTwoCap;

        // BFS to find the shortest path to the desired amount
        // State: [bucketOne, bucketTwo]
        Set<String> visited = new HashSet<>();
        Queue<int[]> queue = new LinkedList<>();
        Map<String, StateInfo> cameFrom = new HashMap<>();

        // Initial state based on which bucket to fill first
        int startOne = startBucketOne ? bucketOneCap : 0;
        int startTwo = startBucketOne ? 0 : bucketTwoCap;

        queue.add(new int[]{startOne, startTwo});
        visited.add(startOne + "," + startTwo);

        boolean found = false;
        int[] finalState = null;

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int b1 = current[0];
            int b2 = current[1];

            // Check if we've reached the desired amount
            if (b1 == desiredLiters) {
                found = true;
                finalState = new int[]{b1, b2};
                break;
            }
            if (b2 == desiredLiters) {
                found = true;
                finalState = new int[]{b1, b2};
                break;
            }

            // Generate all possible next states
            int[][] nextStates = getNextStates(b1, b2, bucketOneCap, bucketTwoCap);

            for (int[] next : nextStates) {
                String key = next[0] + "," + next[1];
                if (!visited.contains(key)) {
                    // Skip the forbidden state: start bucket empty, other full
                    if (startBucketOne) {
                        if (next[0] == 0 && next[1] == bucketTwoCap) {
                            continue;
                        }
                    } else {
                        if (next[1] == 0 && next[0] == bucketOneCap) {
                            continue;
                        }
                    }
                    visited.add(key);
                    cameFrom.put(key, new StateInfo(next[0], next[1]));
                    queue.add(next);
                }
            }
        }

        if (!found) {
            throw new IllegalArgumentException("Solution not possible");
        }

        // Calculate the number of moves by tracing back
        this.totalMoves = countMoves(visited);

        // Determine the final bucket and other bucket content
        if (finalState[0] == desiredLiters) {
            this.finalBucket = "one";
            this.otherBucket = finalState[1];
        } else {
            this.finalBucket = "two";
            this.otherBucket = finalState[0];
        }
    }

    private int[][] getNextStates(int b1, int b2, int cap1, int cap2) {
        int[][] states = new int[6][];
        int idx = 0;

        // 1. Fill bucket one
        states[idx++] = new int[]{cap1, b2};
        // 2. Fill bucket two
        states[idx++] = new int[]{b1, cap2};
        // 3. Empty bucket one
        states[idx++] = new int[]{0, b2};
        // 4. Empty bucket two
        states[idx++] = new int[]{b1, 0};
        // 5. Pour bucket one into bucket two
        int pourTo2 = Math.min(b1, cap2 - b2);
        states[idx++] = new int[]{b1 - pourTo2, b2 + pourTo2};
        // 6. Pour bucket two into bucket one
        int pourTo1 = Math.min(b2, cap1 - b1);
        states[idx++] = new int[]{b1 + pourTo1, b2 - pourTo1};

        return states;
    }

    private int countMoves(Set<String> visited) {
        return visited.size();
    }

    int getTotalMoves() {
        return totalMoves;
    }

    String getFinalBucket() {
        return finalBucket;
    }

    int getOtherBucket() {
        return otherBucket;
    }

    private static class StateInfo {
        int one;
        int two;

        StateInfo(int one, int two) {
            this.one = one;
            this.two = two;
        }
    }
}
