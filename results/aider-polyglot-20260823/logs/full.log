import io.reactivex.Observable;
import java.util.*;

class Hangman {

    Observable<Output> play(Observable<String> words, Observable<String> letters) {
        return words
            .flatMap(
                word -> letters
                    .startWith("")
                    .scan(
                        new State("", new LinkedHashSet<>()),
                        (state, letter) -> updateState(word, state, letter)
                    )
                    .map(state -> buildOutput(word, state))
            );
    }

    private State updateState(String word, State state, String letter) {
        if (letter.isEmpty() || letter == null) {
            return new State("", new LinkedHashSet<>());
        }
        
        Set<String> newGuess = new LinkedHashSet<>(state.guess);
        newGuess.add(letter);
        
        Set<String> newMisses = new LinkedHashSet<>();
        StringBuilder discovered = new StringBuilder();
        
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if (newGuess.contains(String.valueOf(c))) {
                discovered.append(c);
            } else {
                newMisses.add(String.valueOf(c));
                discovered.append('*');
            }
        }
        
        return new State(discovered.toString(), newGuess);
    }

    private Output buildOutput(String word, State state) {
        Set<String> misses = new LinkedHashSet<>();
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            if (!state.guess.contains(String.valueOf(c))) {
                misses.add(String.valueOf(c));
            }
        }
        
        boolean won = true;
        for (int i = 0; i < word.length(); i++) {
            if (word.charAt(i) != '*' && state.discovered.charAt(i) == '*') {
                won = false;
                break;
            }
        }
        
        return new Output(
            word,
            state.discovered,
            state.guess,
            misses,
            Collections.emptyList(),
            won ? Status.WON : Status.PLAYING
        );
    }

    private static class State {
        final String discovered;
        final Set<String> guess;
        
        State(String discovered, Set<String> guess) {
            this.discovered = discovered;
            this.guess = guess;
        }
    }

}
```

