```java
import java.util.List;

public class Satellite {
    public Tree treeFromTraversals(List<Character> preorderInput, List<Character> inorderInput) {
        if (preorderInput.size() != inorderInput.size()) {
            throw new IllegalArgumentException("traversals must have the same length");
        }
        
        // Check for unique elements across both traversals
        if (preorderInput.size() != new java.util.HashSet<Character>(preorderInput).size()) {
            throw new IllegalArgumentException("traversals must contain unique elements");
        }
        
        return buildTree(preorderInput, 0, preorderInput.size() - 1, inorderInput, 0, inorderInput.size() - 1);
    }
    
    private Tree buildTree(List<Character> preorder, int preStart, int preEnd, List<Character> inorder, int inStart, int inEnd) {
        if (preStart > preEnd || inStart > inEnd) {
            return null;
        }
        
        Character rootChar = preorder.get(preStart);
        Tree root = new Tree(rootChar);
        
        int rootIndexInInorder = inorder.indexOf(rootChar);
        
        int leftSubtreeSize = rootIndexInInorder - inStart;
        
        root.left = buildTree(preorder, preStart + 1, preStart + leftSubtreeSize, inorder, inStart, rootIndexInInorder - 1);
        root.right = buildTree(preorder, preStart + leftSubtreeSize + 1, preEnd, inorder, rootIndexInInorder + 1, inEnd);
        
        return root;
    }
}
