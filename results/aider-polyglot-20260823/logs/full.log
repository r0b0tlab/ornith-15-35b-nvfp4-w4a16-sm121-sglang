import java.util.List;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;
import java.util.Collections;
import java.util.Arrays;

class Poker {
    private final List<String> hand;

    Poker(List<String> hand) {
        if (hand == null || hand.size() != 5) {
            throw new IllegalArgumentException("A hand must have exactly 5 cards");
        }
        this.hand = hand;
    }

    List<String> getBestHands() {
        List<String> bestHands = new ArrayList<>();
        int maxScore = Integer.MIN_VALUE;

        for (String h : hand) {
            int score = evaluateHand(h);
            if (score > maxScore) {
                maxScore = score;
                bestHands.clear();
                bestHands.add(h);
            } else if (score == maxScore) {
                bestHands.add(h);
            }
        }

        return bestHands;
    }

    private int evaluateHand(String cardString) {
        String[] cards = cardString.split(" ");
        int[] ranks = new int[5];
        char[] suits = new char[5];

        for (int i = 0; i < 5; i++) {
            String card = cards[i];
            String rankStr = card.substring(0, card.length() - 1);
            suits[i] = card.charAt(card.length() - 1);

            switch (rankStr) {
                case "2": ranks[i] = 2; break;
                case "3": ranks[i] = 3; break;
                case "4": ranks[i] = 4; break;
                case "5": ranks[i] = 5; break;
                case "6": ranks[i] = 6; break;
                case "7": ranks[i] = 7; break;
                case "8": ranks[i] = 8; break;
                case "9": ranks[i] = 9; break;
                case "J": ranks[i] = 11; break;
                case "Q": ranks[i] = 12; break;
                case "K": ranks[i] = 13; break;
                case "A": ranks[i] = 14; break;
                default: throw new IllegalArgumentException("Invalid rank");
            }
        }

        Arrays.sort(ranks);

        boolean flush = true;
        for (int i = 1; i < 5; i++) {
            if (suits[i] != suits[0]) {
                flush = false;
                break;
            }
        }

        boolean isStraight = true;
        for (int i = 0; i < 4; i++) {
            if (ranks[i] + 1 != ranks[i + 1]) {
                isStraight = false;
                break;
            }
        }

        // Check for wheel straight (A-2-3-4-5)
        if (ranks[0] == 2 && ranks[1] == 3 && ranks[2] == 4 && ranks[3] == 5 && ranks[4] == 14) {
            isStraight = true;
            ranks[4] = 1; // Ace becomes low
        }

        Map<Integer, Integer> rankCounts = new HashMap<>();
        for (int rank : ranks) {
            rankCounts.put(rank, rankCounts.getOrDefault(rank, 0) + 1);
        }

        int counts = rankCounts.values().stream().mapToInt(Integer::intValue).sorted().reduce(0, (a, b) -> a * 10 + b);

        if (isStraight && flush) {
            return 8000 + ranks[4]; // Straight flush
        }
        if (counts == 14141) {
            return 7000 + ranks[4]; // Four of a kind
        }
        if (counts == 1322 || counts == 2311) {
            return 6000 + ranks[4] * 10 + ranks[3]; // Full house
        }
        if (flush) {
            return 5000 + ranks[4]; // Flush
        }
        if (isStraight) {
            return 4000 + ranks[4]; // Straight
        }
        if (counts == 14122 || counts == 12214) {
            return 3000 + ranks[4] * 10 + ranks[3]; // Three of a kind
        }
        if (counts == 11212 || counts == 12121) {
            return 2000 + ranks[4] * 100 + ranks[3] * 10 + ranks[2]; // Two pair
        }
        if (counts == 11112) {
            return 1000 + ranks[4] * 10000 + ranks[3] * 1000 + ranks[2] * 100 + ranks[1] * 10 + ranks[0]; // One pair
        }
        return 0 + ranks[4] * 100000 + ranks[3] * 10000 + ranks[2] * 1000 + ranks[1] * 100 + ranks[0]; // High card
    }
}
