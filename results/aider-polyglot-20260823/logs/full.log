+    if start_bucket not in (1, 2):
+        raise ValueError("Start bucket must be 1 or 2.")
+    
+    # Special case: goal is 0
+    if goal == 0:
+        return (0, 0, start_bucket if start_bucket == 1 else 2)
+    
