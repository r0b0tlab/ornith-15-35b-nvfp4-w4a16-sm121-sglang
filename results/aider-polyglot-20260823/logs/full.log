```java
import java.util.Random;

public class MazeGenerator {

    private static final String WALL = "│";
    private static final String HORIZONTAL_WALL = "─";
    private static final String CORNER = "┌";
    private static final String CORNER_BR = "┐";
    private static final String CORNER_BL = "└";
    private static final String CORNER_BR2 = "┘";
    private static final String ARROW = "⇨";
    private static final String SPACE = " ";

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, (int) (Math.random() * Long.MAX_VALUE));
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        Random random = new Random(seed);
        return generateMaze(rows, columns, random);
    }

    private char[][] generateMaze(int rows, int columns, Random random) {
        int height = 2 * rows + 1;
        int width = 2 * columns + 1;
        char[][] grid = new char[height][width];

        // Initialize all cells as walls
        for (int i = 0; i < height; i++) {
            for (int j = 0; j < width; j++) {
                grid[i][j] = WALL.charAt(0);
            }
        }

        // Track visited cells
        boolean[][] visited = new boolean[rows][columns];

        // Start DFS from cell (0,0)
        dfs(0, 0, rows, columns, grid, visited, random);

        // Add entrance and exit
        grid[rows][0] = ARROW.charAt(0);
        grid[rows][width - 1] = ARROW.charAt(0);

        return grid;
    }

    private void dfs(int cellRow, int cellCol, int rows, int columns, char[][] grid, boolean[][] visited, Random random) {
        visited[cellRow][cellCol] = true;

        // Get neighbors in random order
        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};
        int[] order = {0, 1, 2, 3};

        // Fisher-Yates shuffle
        for (int i = 3; i > 0; i--) {
            int j = random.nextInt(i + 1);
            int temp = order[i];
            order[i] = order[j];
            order[j] = temp;
        }

        for (int idx : order) {
            int nr = cellRow + dr[idx];
            int nc = cellCol + dc[idx];

            if (nr >= 0 && nr < rows && nc >= 0 && nc < columns && !visited[nr][nc]) {
                // Remove wall between current cell and neighbor
                if (idx == 0) {
                    grid[cellRow][cellCol * 2 + 1] = HORIZONTAL_WALL.charAt(0);
                } else if (idx == 1) {
                    grid[cellRow + 2][cellCol * 2 + 1] = HORIZONTAL_WALL.charAt(0);
                } else if (idx == 2) {
                    grid[cellRow * 2 + 1][cellCol * 2] = WALL.charAt(0);
                } else {
                    grid[cellRow * 2 + 1][cellCol * 2 + 2] = WALL.charAt(0);
                }

                dfs(nr, nc, rows, columns, grid, visited, random);
            }
        }
    }
}
