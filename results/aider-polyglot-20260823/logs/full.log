1. `Node` class - stores value and next pointer
2. `LinkedList` class with:
   - Constructor accepting optional values
   - `__iter__` - iterate from head to tail
   - `__len__` - return length
   - `head()` - return head node
   - `push()` - add to head (LIFO)
   - `pop()` - remove from head (LIFO)
   - `reversed()` - return reversed list

Let me implement the complete solution:

simple_linked_list.py
```python
class EmptyListException(Exception):
    pass


class Node:
    def __init__(self, value, next_node=None):
        self._value = value
        self._next = next_node

    def value(self):
        return self._value

    def next(self):
        return self._next


class LinkedList:
    def __init__(self, values=None):
        self._head = None
        if values is not None:
            for value in values:
                self.push(value)

    def __iter__(self):
        current = self._head
        while current is not None:
            yield current.value()
            current = current.next()

    def __len__(self):
        count = 0
        current = self._head
        while current is not None:
            count += 1
            current = current.next()
        return count

    def head(self):
        if self._head is None:
            raise EmptyListException("The list is empty.")
        return self._head

    def push(self, value):
        new_node = Node(value, self._head)
        self._head = new_node

    def pop(self):
        if self._head is None:
            raise EmptyListException("The list is empty.")
        popped = self._head
        self._head = self._head.next()
        return popped.value()

    def reversed(self):
        new_list = LinkedList()
        for value in self:
            new_list.push(value)
        return new_list
```
