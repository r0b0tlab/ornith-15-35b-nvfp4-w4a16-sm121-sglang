The tests expect the header row to be padded with spaces to specific column widths, and the currency to be formatted with 2 decimal places and proper thousands separators (for the Dutch locale). Let me rewrite `ledger.js` to match the expected output format.

ledger.js
```js
class LedgerEntry {
  constructor() {
    this.date = undefined;
    this.description = undefined;
    this.change = undefined;
  }
}

export function createEntry(date, description, change) {
  let entry = new LedgerEntry();
  entry.date = new Date(date);
  entry.description = description;
  entry.change = change;
  return entry;
}

const CURRENCY_BY_CODE = {
  USD: {
    symbol: '$',
    locale: 'en-US',
  },
  EUR: {
    symbol: '€',
    locale: 'en-US',
  },
};

function formatCurrency(change, currency) {
  const { symbol } = CURRENCY_BY_CODE[currency];
  const value = change / 100;
  const formatted = `${symbol}${Math.abs(value).toLocaleString('en-US')}`;
  return value < 0 ? `(${formatted})` : `${formatted} `;
}

function formatDescription(description) {
  return description.length > 25
    ? `${description.substring(0, 22)}...`
    : description.padEnd(25, ' ');
}

function formatChange(entry, currency, locale) {
  if (locale === 'nl-NL') {
    const { symbol } = CURRENCY_BY_CODE[currency];
    const options = {
      style: 'currency',
      currency,
      currencyDisplay: 'narrowSymbol',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    };
    return `${(entry.change / 100).toLocaleString('nl-NL', options)} `;
  }
  return formatCurrency(entry.change, currency).padStart(13, ' ');
}

function sortEntries(entries) {
  entries.sort(
    (a, b) =>
      a.date - b.date ||
      a.change - b.change ||
      a.description.localeCompare(b.description),
  );
}

function formatDate(entry) {
  const month = (entry.date.getMonth() + 1).toString().padStart(2, '0');
  const day = entry.date.getDate().toString().padStart(2, '0');
  const year = entry.date.getFullYear();
  return `${month}/${day}/${year}`;
}

function formatDutchDate(entry) {
  const month = (entry.date.getMonth() + 1).toString().padStart(2, '0');
  const day = entry.date.getDate().toString().padStart(2, '0');
  const year = entry.date.getFullYear();
  return `${day}-${month}-${year}`;
}

function formatEntryRow(entry, currency, locale) {
  const dateStr =
    locale === 'nl-NL' ? formatDutchDate(entry) : formatDate(entry);
  const description = formatDescription(entry.description);
  const change = formatChange(entry, currency, locale);
  return `${dateStr} | ${description} | ${change}\n`;
}

function headerForLocale(locale) {
  return locale === 'nl-NL'
    ? 'Datum      | Omschrijving              | Verandering  '
    : 'Date       | Description               | Change       ';
}

export function formatEntries(currency, locale, entries) {
  const currencyConfig = CURRENCY_BY_CODE[currency];
  if (!currencyConfig) {
    throw new Error(`Unsupported currency: ${currency}`);
  }

  if (locale !== 'en-US' && locale !== 'nl-NL') {
    throw new Error(`Unsupported locale: ${locale}`);
  }

  const header = headerForLocale(locale);

  sortEntries(entries);

  const body = entries
    .map((entry) => formatEntryRow(entry, currency, locale))
    .join('');

  return `${header}\n${body}`;
}
