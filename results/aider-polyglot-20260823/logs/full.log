Ok, let me implement the reactive system.

The key concepts:
- **InputCell**: has a settable value
- **ComputeCell**: computes its value from other cells using a function
- **CallbackCell**: a cell that calls a function whenever its value changes
- When an input value changes, it propagates to compute cells
- Callbacks fire when a compute cell's value changes from its previous stable state

Let me implement this.

react.js
```javascript
//
// This is only a SKELETON file for the 'React' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class Cell {
  constructor(value) {
    this._value = value;
    this._callbacks = new Set();
    this._dependents = []; // cells that depend on this cell
  }

  get value() {
    return this._value;
  }

  addCallback(cb) {
    this._callbacks.add(cb);
  }

  removeCallback(cb) {
    this._callbacks.delete(cb);
  }

  runCallbacks() {
    for (const cb of [...this._callbacks]) {
      cb(this._value);
    }
  }
}

export class InputCell extends Cell {
  constructor(value) {
    super(value);
  }

  setValue(value) {
    if (value === this._value) {
      return;
    }
    this._value = value;
    this._propagateUpdate();
  }

  _propagateUpdate() {
    // Collect all affected compute cells via BFS
    const affected = new Set();
    const queue = [...this._dependents];
    while (queue.length) {
      const cell = queue.shift();
      if (!affected.has(cell)) {
        affected.add(cell);
        queue.push(...cell._dependents);
      }
    }

    // Compute new values
    const previousValues = new Map();
    affected.forEach(cell => {
      previousValues.set(cell, cell._value);
    });

    affected.forEach(cell => {
      cell._computeValue();
    });

    // Run callbacks for cells whose value actually changed
    affected.forEach(cell => {
      if (!previousValues.get(cell).equals(cell._value)) {
        cell.runCallbacks();
      }
    });
  }
}

export class ComputeCell extends Cell {
  constructor(inputCells, fn) {
    super(fn(...inputCells.map(cell => cell.value)));
    this._inputCells = inputCells;
    inputCells.forEach(cell => cell._dependents.push(this));
  }

  addCallback(cb) {
    this._callbacks.add(cb);
  }

  removeCallback(cb) {
    this._callbacks.delete(cb);
  }

  _computeValue() {
    this._value = fn(...this._inputCells.map(cell => cell.value));
  }
}

export class CallbackCell {
  constructor(fn) {
    this._fn = fn;
    this._value = fn();
  }

  addCallback(cb) {
    this._callbacks.add(cb);
  }

  removeCallback(cb) {
    this._callbacks.delete(cb);
  }
}
```

