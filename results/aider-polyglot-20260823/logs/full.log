```go
package wordsearch

import "fmt"

func Solve(words []string, puzzle []string) (map[string][2][2]int, error) {
	result := make(map[string][2][2]int)

	if len(words) == 0 || len(puzzle) == 0 {
		return result, nil
	}

	rows := len(puzzle)
	if rows == 0 {
		return result, nil
	}
	cols := len(puzzle[0])
	if cols == 0 {
		return result, nil
	}

	// All 8 directions: horizontal, vertical, and diagonal
	directions := [][2]int{
		{0, 1},   // right
		{0, -1},  // left
		{1, 0},   // down
		{-1, 0},  // up
		{1, 1},   // down-right
		{1, -1},  // down-left
		{-1, 1},  // up-right
		{-1, -1}, // up-left
	}

	for _, word := range words {
		found := false

		// Try every starting position
		for r := 0; r < rows && !found; r++ {
			for c := 0; c < cols && !found; c++ {
				// Try every direction from this starting position
				for _, dir := range directions {
					dr, dc := dir[0], dir[1]

					// Check if the word fits in this direction
					lastRow := r + dr*(len(word)-1)
					lastCol := c + dc*(len(word)-1)

					// Bounds check
					if lastRow < 0 || lastRow >= rows || lastCol < 0 || lastCol >= cols {
						continue
					}

					// Verify the word matches in this direction
					match := true
					for i := 0; i < len(word); i++ {
						row := r + dr*i
						col := c + dc*i

						if row < 0 || row >= rows || col < 0 || col >= cols {
							match = false
							break
						}

						puzzleChar := rune(puzzle[row][col])
						if puzzleChar != rune(word[i]) {
							match = false
							break
						}
					}

					if match {
						result[word] = [2][2]int{
							{r, c},                          // first letter
							{lastRow, lastCol},              // last letter
						}
						found = true
						break
					}
				}
			}
		}

		if !found {
			return nil, fmt.Errorf("word %q not found in puzzle", word)
		}
	}

	return result, nil
}
