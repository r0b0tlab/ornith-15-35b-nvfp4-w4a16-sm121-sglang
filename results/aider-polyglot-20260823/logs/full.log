use std::sync::Mutex;
use std::collections::HashSet;

lazy_static::lazy_static! {
    static ref NAMED_ROBOTS: Mutex<HashSet<String>> = Mutex::new(HashSet::new());
}

pub struct Robot {
    name: String,
}

impl Robot {
    pub fn new() -> Self {
        Robot { name: String::new() }
    }

    pub fn name(&self) -> &str {
        if self.name.is_empty() {
            self.reset_name();
        }
        &self.name
    }

    pub fn reset_name(&mut self) {
        loop {
            let mut chars: String = (0..2)
                .map(|_| (b'A' + rand_first_char()) as char)
                .collect();
            let mut num = rand_num();
            for _ in 0..3 {
                chars.push((b'0' + (num % 10) as u8) as char);
                num /= 10;
            }

            let mut named_robots = NAMED_ROBOTS.lock().unwrap();
            if !named_robots.contains(&chars) {
                named_robots.insert(chars.clone());
                drop(named_robots);
                self.name = chars;
                break;
            }
        }
    }
}

fn rand_first_char() -> u8 {
    (std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 26) as u8
}

fn rand_num() -> u64 {
    (std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_nanos() % 1000)
}
```
