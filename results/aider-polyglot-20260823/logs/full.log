```go
package tree

import "fmt"

type Record struct {
	ID     int
	Parent int
	// feel free to add fields as you see fit
}

type Node struct {
	ID       int
	Children []*Node
	// feel free to add fields as you see fit
}

func Build(records []Record) (*Node, error) {
	if len(records) == 0 {
		return nil, nil
	}

	// Validate records and build index by ID
	nodes := make([]*Node, len(records))
	seen := make([]bool, len(records))

	for _, r := range records {
		if r.ID < 0 || r.ID >= len(records) {
			return nil, errorf("invalid ID %d", r.ID)
		}
		if seen[r.ID] {
			return nil, errorf("duplicate ID %d", r.ID)
		}
		seen[r.ID] = true

		if r.Parent == r.ID {
			// root
			if r.Parent != r.ID {
				return nil, errorf("root has non-self parent")
			}
		} else {
			// parent must have smaller ID
			if r.Parent >= r.ID {
				return nil, errorf("parent ID %d not less than ID %d", r.Parent, r.ID)
			}
		}

		nodes[r.ID] = &Node{ID: r.ID}
	}

	// Build tree structure
	var root *Node
	for _, r := range records {
		node := nodes[r.ID]
		if r.Parent == r.ID {
			root = node
			continue
		}
		parent := nodes[r.Parent]
		parent.Children = append(parent.Children, node)
	}

	if root == nil {
		return nil, errorf("no root found")
	}

	return root, nil
}

type fmtError struct {
	msg string
}

func (e *fmtError) Error() string {
	return e.msg
}

func errorf(format string, args ...interface{}) error {
	return &fmtError{msg: fmt.Sprintf(format, args...)}
}
