```rust
pub fn eval(&mut self, input: &str) -> Result {
    // Split into tokens
    let tokens = self.tokenize(input);
    
    // Process tokens
    let mut index = 0;
    while index < tokens.len() {
        if tokens[index] == ":" {
            // Definition
            let end = tokens[index..].iter().position(|t| t == ";").map(|p| p + index).ok_or(Error::InvalidWord)?;
            self.eval_definition(&tokens[index..=end])?;
            index = end + 1;
        } else {
            self.eval_token(&tokens[index])?;
            index += 1;
        }
    }
    
    Ok(())
}
```

