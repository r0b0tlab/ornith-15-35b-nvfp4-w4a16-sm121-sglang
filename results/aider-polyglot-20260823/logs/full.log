                for user in sorted(
                    (u for u in self.database["users"] if u["name"] in wanted),
                    key=lambda u: u["name"],
                ):
                    users.append(self._make_user_json(user))
            return json.dumps({"users": users})
        return None

    def post(self, url, payload=None):
        if url == "/add":
            # Create new user
            data = json.loads(payload)
            user = data["user"]
            # Check if user already exists
            if self._get_user_dict(user) is None:
                self.database["users"].append(
                    {
                        "name": user,
                        "owes": {},
                        "owed_by": {},
                        "balance": 0.0,
                    }
                )
            return self._make_user_json(self._get_user_dict(user))
        elif url == "/iou":
            # Handle IOU
            data = json.loads(payload)
            lender = data["lender"]
            borrower = data["borrower"]
            amount = data["amount"]

            # Get or create lender and borrower user dicts
            lender_user = self._get_user_dict(lender)
            if lender_user is None:
                lender_user = {"name": lender, "owes": {}, "owed_by": {}, "balance": 0.0}
                self.database["users"].append(lender_user)

            borrower_user = self._get_user_dict(borrower)
            if borrower_user is None:
                borrower_user = {"name": borrower, "owes": {}, "owed_by": {}, "balance": 0.0}
                self.database["users"].append(borrower_user)

            # Process the IOU: lender lends amount to borrower
            # This increases what borrower owes to lender
            self._settle_debt(lender_user, borrower, amount)
            self._settle_debt(borrower_user, lender, -amount)

            # Return updated users sorted by name
            users = [
                self._make_user_json(lender_user),
                self._make_user_json(borrower_user),
            ]
            return json.dumps({"users": sorted(users, key=lambda u: json.loads(u)["name"])})
        return None

    def _settle_debt(self, user_dict, other_name, amount):
        """Settle a debt between user_dict and other_name.

        Positive amount means user_dict is owed amount by other_name.
        Negative amount means user_dict owes -amount to other_name.
        """
        if amount > 0:
            # user_dict is owed amount by other_name
            current = user_dict["owed_by"].get(other_name, 0.0)
            user_dict["owed_by"][other_name] = current + amount
        elif amount < 0:
            # user_dict owes -amount to other_name
            current = user_dict["owes"].get(other_name, 0.0)
            user_dict["owes"][other_name] = current - amount

        # Now settle the net balance between user_dict and other_name
        owed_by = user_dict["owed_by"].get(other_name, 0.0)
        owes = user_dict["owes"].get(other_name, 0.0)
        net = owed_by - owes

        if net > 0:
            # user_dict is owed net by other_name
            user_dict["owed_by"][other_name] = net
            user_dict["owes"].pop(other_name, None)
        elif net < 0:
            # user_dict owes -net to other_name
            user_dict["owes"][other_name] = -net
            user_dict["owed_by"].pop(other_name, None)
        else:
            # Balanced, remove both
            user_dict["owed_by"].pop(other_name, None)
            user_dict["owes"].pop(other_name, None)

        # Update balance
        user_dict["balance"] = sum(user_dict["owed_by"].values()) - sum(
            user_dict["owes"].values()
        )
