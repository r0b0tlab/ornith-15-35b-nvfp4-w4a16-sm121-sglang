```rust
use std::collections::HashMap;
use std::thread;

pub fn frequency(input: &[&str], worker_count: usize) -> HashMap<char, usize> {
    if worker_count == 0 {
        return HashMap::new();
    }

    // Split the input into chunks to be processed by each worker.
    // We use a chunk size so that the work is distributed across the workers.
    let chunks: Vec<String> = if input.is_empty() {
        Vec::new()
    } else {
        let chunk_size = (input.len().div_ceil(worker_count)).max(1);
        input
            .chunks(chunk_size)
            .map(|c| c.join(""))
            .collect()
    };

    // If there's no work, return an empty map.
    if chunks.is_empty() {
        return HashMap::new();
    }

    // Spawn a thread for each chunk, collecting partial results.
    let mut handles = Vec::with_capacity(chunks.len());
    for chunk in chunks {
        if chunk.is_empty() {
            continue;
        }
        let handle = thread::spawn(move || {
            let mut local_freq: HashMap<char, usize> = HashMap::new();
            for ch in chunk.chars() {
                if ch.is_alphabetic() {
                    let lower = ch.to_lowercase().next().unwrap_or(ch);
                    *local_freq.entry(lower).or_insert(0) += 1;
                }
            }
            local_freq
        });
        handles.push(handle);
    }

    // Combine the partial results.
    let mut result: HashMap<char, usize> = HashMap::new();
    for handle in handles {
        let partial = handle.join().expect("worker thread panicked");
        for (ch, count) in partial {
            *result.entry(ch).or_insert(0) += count;
        }
    }

    result
}
