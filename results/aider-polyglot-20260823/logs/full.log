BookStore.java
```java
import java.util.List;
import java.util.ArrayList;
import java.util.Collections;

class BookStore {

    static final double BOOK_PRICE = 8.0;

    // Discount percentages for groups of 1-5
    static final double[] DISCOUNTS = {0.0, 0.0, 0.05, 0.10, 0.20, 0.25};

    double calculateBasketCost(List<Integer> books) {
        if (books.isEmpty()) {
            return 0.0;
        }

        // Count copies of each book
        int[] counts = new int[5];
        for (int book : books) {
            counts[book - 1]++;
        }

        // Sort counts descending for consistent grouping
        java.util.Arrays.sort(counts);
        // Reverse to descending
        for (int i = 0; i < counts.length / 2; i++) {
            int temp = counts[i];
            counts[i] = counts[counts.length - 1 - i];
            counts[counts.length - 1 - i] = temp;
        }

        return calculateMinCost(counts);
    }

    private double calculateMinCost(int[] counts) {
        // Base case: empty
        int total = 0;
        for (int c : counts) {
            total += c;
        }
        if (total == 0) {
            return 0.0;
        }

        // Try forming a group of each possible size (1-5)
        double minCost = Double.MAX_VALUE;

        for (int groupSize = 1; groupSize <= 5; groupSize++) {
            // Check if we can form a group of this size
            int available = 0;
            for (int c : counts) {
                if (c > 0) {
                    available++;
                }
            }
            if (available < groupSize) {
                continue;
            }

            // Form a group of 'groupSize' books
            int[] newCounts = counts.clone();
            int idx = 0;
            while (idx < newCounts.length && groupSize > 0) {
                if (newCounts[idx] > 0) {
                    newCounts[idx]--;
                    groupSize--;
                }
                idx++;
            }

            // Calculate cost of this group plus remaining
            double groupCost = groupCostForSize(counts.length - groupSize);
            double remainingCost = calculateMinCost(newCounts);
            double totalCost = groupCost + remainingCost;
            if (totalCost < minCost) {
                minCost = totalCost;
            }
        }

        return minCost;
    }

    private double groupCostForSize(int groupSize) {
        double basePrice = groupSize * BOOK_PRICE;
        double discount = DISCOUNTS[groupSize];
        return basePrice * (1.0 - discount);
    }
}
```

