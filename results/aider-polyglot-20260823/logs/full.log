package pov

type Tree struct {
	value    string
	children []*Tree
}

// New creates and returns a new Tree with the given root value and children.
func New(value string, children ...*Tree) *Tree {
	return &Tree{value: value, children: children}
}

// Value returns the value at the root of a tree.
func (tr *Tree) Value() string {
	return tr.value
}

// Children returns a slice containing the children of a tree.
// There is no need to sort the elements in the result slice,
// they can be in any orders.
func (tr *Tree) Children() []*Tree {
	return tr.children
}

// String describes a tree in a compact S-expression format.
// This helps to make test outputs more readable.
// Feel free to adapt this method as you see fit.
func (tr *Tree) String() string {
	if tr == nil {
		return "nil"
	}
	result := tr.Value()
	if len(tr.Children()) == 0 {
		return result
	}
	for _, ch := range tr.Children() {
		result += " " + ch.String()
	}
	return "(" + result + ")"
}

// FromPov returns the pov from the node specified in the argument.
func (tr *Tree) FromPov(from string) *Tree {
	newRoot := tr.findNode(from)
	if newRoot == nil {
		return nil
	}

	// Build the new tree by traversing from the original root to the target node.
	// We need to reverse the parent-child relationships along the path.
	return tr.reorient(from, nil)
}

// findNode returns a pointer to the node with the given value, or nil if not found.
func (tr *Tree) findNode(value string) *Tree {
	if tr == nil {
		return nil
	}
	if tr.value == value {
		return tr
	}
	for _, child := range tr.children {
		found := child.findNode(value)
		if found != nil {
			return found
		}
	}
	return nil
}

// reorient rebuilds the tree from the perspective of the 'from' node.
// It constructs a new tree where the path from the original root to 'from'
// becomes the path from 'from' down to the original root.
func (tr *Tree) reorient(from string, parent *Tree) *Tree {
	if tr.value == from {
		// This is the new root; its children are all original children
		// except the one on the path to the old root.
		var newChildren []*Tree
		for _, child := range tr.children {
			newChildren = append(newChildren, child.reorient(from, tr))
		}
		return &Tree{value: tr.value, children: newChildren}
	}

	// Move down toward the target node.
	for _, child := range tr.children {
		if child.value == from {
			// Build the child's new subtree, excluding the current node as parent.
			var newChildren []*Tree
			for _, gc := range child.children {
				newChildren = append(newChildren, gc.reorient(from, child))
			}
			newChild := &Tree{value: child.value, children: newChildren}
			// The current node becomes a child of the child in the new tree.
			var resultChildren []*Tree
			resultChildren = append(resultChildren, newChild)
			resultChildren = append(resultChildren, tr.reorient(from, nil))
			return &Tree{value: tr.value, children: resultChildren}
		}
	}

	// Continue down the tree.
	var newChildren []*Tree
	for _, child := range tr.children {
		newChildren = append(newChildren, child.reorient(from, tr))
	}
	return &Tree{value: tr.value, children: newChildren}
}

// PathTo returns the shortest path between two nodes in the tree.
func (tr *Tree) PathTo(from, to string) []string {
	path := tr.findPath(from, to)
	return path
}

// findPath finds the shortest path between two nodes using the tree structure.
func (tr *Tree) findPath(from, to string) []string {
	node := tr.findNode(from)
	if node == nil {
		return nil
	}

	// Find the path from 'from' to 'to' by traversing the tree.
	var result []string
	found := tr.pathHelper(from, to, &result)
	if !found {
		return nil
	}
	return result
}

// pathHelper performs a DFS to find the path from 'from' to 'to'.
func (tr *Tree) pathHelper(from, to string, result *[]string) bool {
	if tr == nil {
		return false
	}

	if tr.value == from {
		*result = append(*result, from)
		if from == to {
			return true
		}
		for _, child := range tr.children {
			if child.pathHelper(from, to, result) {
				return true
			}
		}
		*result = (*result)[:len(*result)-1]
		return false
	}

	for _, child := range tr.children {
		if child.pathHelper(from, to, result) {
			*result = append(*result, tr.value)
			return true
		}
	}
	return false
}
