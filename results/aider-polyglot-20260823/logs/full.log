package say

import (
	"fmt"
)

// Say converts a number from 0 to 999,999,999,999 to its English word
// representation. It returns an error if the number is out of range.
func Say(n int64) (string, error) {
	if n < 0 || n > 999999999999 {
		return "", fmt.Errorf("number out of range: %d", n)
	}
	if n == 0 {
		return "zero", nil
	}

	// Break the number into chunks of thousands (billions, millions, thousands, ones)
	chunks := []int64{0, 0, 0, 0}
	powers := []string{" billion", " million", " thousand", ""}

	for i := 3; i >= 0; i-- {
		chunks[i] = n % 1000
		n /= 1000
	}

	var parts []string
	for i := 0; i < 4; i++ {
		if chunks[i] != 0 {
			parts = append(parts, fmt.Sprintf("%s%s", threeToWords(chunks[i]), powers[i]))
		}
	}

	return strings.Join(parts, " "), nil
}

// threeToWords converts a number from 0-999 to words.
func threeToWords(n int64) string {
	var parts []string

	hundreds := n / 100
	remainder := n % 100

	if hundreds > 0 {
		parts = append(parts, smallNumbers[hundreds]+" hundred")
	}

	if remainder > 0 {
		if remainder < 20 {
			parts = append(parts, smallNumbers[remainder])
		} else {
			tens := remainder / 10
			ones := remainder % 10
			if ones == 0 {
				parts = append(parts, tensNumbers[tens])
			} else {
				parts = append(parts, fmt.Sprintf("%s-%s", tensNumbers[tens], smallNumbers[ones]))
			}
		}
	}

	return strings.Join(parts, " ")
}

var smallNumbers = map[int64]string{
	0:  "",
	1:  "one",
