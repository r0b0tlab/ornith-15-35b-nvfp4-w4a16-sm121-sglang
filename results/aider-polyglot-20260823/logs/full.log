struct CellData<T> {
    kind: CellKind<T>,
}

enum CellKind<T> {
    Input(T),
    Compute {
        deps: Vec<CellId>,
        func: RefCell<Box<dyn Fn(&[T]) -> T>>,
        value: RefCell<T>,
        listeners: RefCell<Vec<(CallbackId, RefCell<Box<dyn FnMut(T)>>>>,
    },
}

