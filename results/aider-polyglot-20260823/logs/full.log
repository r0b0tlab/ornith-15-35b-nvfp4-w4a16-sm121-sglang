Let me fix the file:

scale_generator.go
```go
package scale

import "strings"

// Chromatic scale with sharps
var sharpScale = []string{
	"A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#",
}

// Chromatic scale with flats
var flatScale = []string{
	"A", "Bb", "B", "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab",
}

// Tonics that use flats
var flatTonics = map[string]bool{
	"F": true, "Bb": true, "Eb": true, "Ab": true, "Db": true, "Gb": true,
	"d": true, "g": true, "c": true, "f": true, "bb": true, "eb": true,
}

// Note to index mapping for sharp scale
var sharpIndex = map[string]int{
	"A": 0, "A#": 1, "B": 2, "C": 3, "C#": 4, "D": 5,
	"D#": 6, "E": 7, "F": 8, "F#": 9, "G": 10, "G#": 11,
}

// Note to index mapping for flat scale
var flatIndex = map[string]int{
	"A": 0, "Bb": 1, "B": 2, "C": 3, "Db": 4, "D": 5,
	"Eb": 6, "E": 7, "F": 8, "Gb": 9, "G": 10, "Ab": 11,
}

func Scale(tonic, interval string) []string {
	// Determine whether to use flats based on tonic
	useFlats := flatTonics[tonic]

	var scale []string
	if useFlats {
		scale = flatScale
	} else {
		scale = sharpScale
	}

	// Find starting index
	var index int
	if useFlats {
		index = flatIndex[tonic]
	} else {
		index = sharpIndex[tonic]
	}

	// Generate chromatic scale (12 notes) starting from tonic
	result := make([]string, 0, 12)
	for i := 0; i < 12; i++ {
		result = append(result, scale[index])
		index = (index + 1) % 12
	}

	// If interval is provided, generate diatonic scale instead
	if interval != "" {
		result = diatonicScale(tonic, interval, useFlats)
	}

	return result
}

func diatonicScale(tonic, interval string, useFlats bool) []string {
	var baseScale []string
	if useFlats {
		baseScale = flatScale
	} else {
		baseScale = sharpScale
	}

	var startIndex int
	if useFlats {
		startIndex = flatIndex[tonic]
	} else {
		startIndex = sharpIndex[tonic]
	}

	result := []string{baseScale[startIndex]}
	currentIndex := startIndex

	for _, iv := range interval {
		step := 1
		if string(iv) == "M" {
			step = 2
		} else if string(iv) == "m" {
			step = 1
		} else if string(iv) == "A" {
			step = 3
		}

		for i := 0; i < step; i++ {
			currentIndex = (currentIndex + 1) % 12
		}
		result = append(result, baseScale[currentIndex])
	}

	return result
}
```
