            this.function = function;
            this.cells = cells;
            this.value = computeValue();
        }

        private T computeValue() {
            List<T> values = new ArrayList<>();
            for (Cell<T> cell : cells) {
                values.add(cell.getValue());
            }
            return function.apply(values);
        }

