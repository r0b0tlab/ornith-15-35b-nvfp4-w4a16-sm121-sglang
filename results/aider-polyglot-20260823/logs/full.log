```javascript
export const tournamentTally = (input) => {
  // Parse input and build the tournament table
  const teams = {};

  // Helper to ensure a team exists in the table
  const ensureTeam = (name) => {
    if (!teams[name]) {
      teams[name] = { name, MP: 0, W: 0, D: 0, L: 0, P: 0 };
    }
  };

  // Process each match result
  const lines = input.trim().split('\n').filter(line => line.trim() !== '');
  for (const line of lines) {
    const parts = line.split(';');
    if (parts.length !== 3) continue;

    const team1 = parts[0];
    const team2 = parts[1];
    const result = parts[2];

    ensureTeam(team1);
    ensureTeam(team2);

    teams[team1].MP++;
    teams[team2].MP++;

    if (result === 'win') {
      teams[team1].W++;
      teams[team1].P += 3;
      teams[team2].L++;
    } else if (result === 'loss') {
      teams[team1].L++;
      teams[team2].W++;
      teams[team2].P += 3;
    } else if (result === 'draw') {
      teams[team1].D++;
      teams[team1].P += 1;
      teams[team2].D++;
      teams[team2].P += 1;
    }
  }

  // Convert to array and sort
  const tableArray = Object.values(teams);
  tableArray.sort((a, b) => {
    if (b.P !== a.P) {
      return b.P - a.P; // Sort by points descending
    }
    // If points are equal, sort alphabetically
    return a.name.localeCompare(b.name);
  });

  // Build the output
  let output = 'Team                           | MP |  W |  D |  L |  P\n';

  for (const team of tableArray) {
    output += `${team.name.padEnd(31)}| ${String(team.MP).padStart(2)} | ${String(team.W).padStart(2)} | ${String(team.D).padStart(2)} | ${String(team.L).padStart(2)} | ${String(team.P).padStart(2)}\n`;
  }

  return output;
};
```
