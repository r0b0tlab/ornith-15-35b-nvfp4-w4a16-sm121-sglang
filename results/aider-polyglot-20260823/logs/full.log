Looking at the test failures, I can see the tests use input format like `"A + B = C"` (single `=`) and also `"I + RR = RR"` style. Let me implement a correct and efficient solution.

The key requirements:
1. Parse the puzzle (handle both `=` and `==`, split addends on `+`)
2. Each letter maps to a unique digit
3. No leading zeros for multi-digit numbers
4. Find assignment where sum of addends equals result

Alphametics.java
```java
import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

class Alphametics {

    private List<String> words;
    private String result;
    private Set<Character> leadingDigits;

    Alphametics(String userInput) {
        // Parse the input: split on "==" or "="
        String[] parts = userInput.split("\\s*=\\s*");
        String left = parts[0].trim();
        String right = parts[1].trim();
        String[] leftWords = left.split("\\+");
        for (int i = 0; i < leftWords.length; i++) {
            leftWords[i] = leftWords[i].trim();
        }
        this.words = new ArrayList<>();
        for (String w : leftWords) {
            this.words.add(w);
        }
        this.result = right;
        this.leadingDigits = new HashSet<>();
        for (String w : this.words) {
            if (w.length() > 1) {
                leadingDigits.add(w.charAt(0));
            }
        }
        if (this.result.length() > 1) {
            leadingDigits.add(this.result.charAt(0));
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        // Collect all unique characters
        Set<Character> chars = new HashSet<>();
        for (String w : words) {
            for (char c : w.toCharArray()) {
                chars.add(c);
            }
        }
        for (char c : result.toCharArray()) {
            chars.add(c);
        }
        List<Character> charList = new ArrayList<>(chars);
        int n = charList.size();
        if (n > 10) {
            throw new UnsolvablePuzzleException("");
        }

        boolean[] used = new boolean[10];
        int[] assignment = new int[n];
        boolean[] found = {false};
        solveHelper(charList, used, assignment, 0, found);

        if (found[0]) {
            Map<Character, Integer> result = new HashMap<>();
            for (int i = 0; i < charList.size(); i++) {
                result.put(charList.get(i), assignment[i]);
            }
            return result;
        }
        throw new UnsolvablePuzzleException("");
    }

    private void solveHelper(List<Character> charList, boolean[] used, int[] assignment, int index, boolean[] found) {
        if (found[0]) {
            return;
        }
        if (index == charList.size()) {
            if (checkSolution(charList, assignment)) {
                found[0] = true;
            }
            return;
        }
        for (int digit = 0; digit <= 9; digit++) {
            if (used[digit]) continue;
            char c = charList.get(index);
            if (digit == 0 && leadingDigits.contains(c)) continue;
            used[digit] = true;
            assignment[index] = digit;
            solveHelper(charList, used, assignment, index + 1, found);
            if (found[0]) return;
            used[digit] = false;
        }
    }

    private boolean checkSolution(List<Character> charList, int[] assignment) {
        // Compute the numeric value of each word
        long sum = 0;
        for (String w : words) {
            sum += wordValue(w, charList, assignment);
        }
        long resultValue = wordValue(result, charList, assignment);
        return sum == resultValue;
    }

    private long wordValue(String word, List<Character> charList, int[] assignment) {
        long value = 0;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            int digit = -1;
            for (int j = 0; j < charList.size(); j++) {
                if (charList.get(j) == c) {
                    digit = assignment[j];
                    break;
                }
            }
            value = value * 10 + digit;
        }
        return value;
    }
}
```
