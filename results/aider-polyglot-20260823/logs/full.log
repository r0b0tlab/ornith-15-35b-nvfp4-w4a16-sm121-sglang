Looking at the errors, I need to fix several issues:

1. `to_shift` takes `char` but `key.bytes()` yields `u8`
2. The `encode_random` function has type mismatch issues with the cast and arithmetic

Let me fix these issues:

lib.rs
```rust
fn to_shift(key_char: u8) -> u8 {
    key_char - b'a'
}

fn shift_char(c: char, shift: u8) -> char {
    if c.is_ascii_lowercase() {
        let shifted = (c as u8 - b'a' + shift) % 26;
        (shifted + b'a') as char
    } else {
        c
    }
}

pub fn encode(key: &str, s: &str) -> Option<String> {
    if key.is_empty() || key.chars().all(|c| c.is_ascii_lowercase()) {
        let shift_values: Vec<u8> = key.bytes().map(to_shift).collect();
        let encoded: String = s
            .chars()
            .enumerate()
            .map(|(i, c)| {
                if c.is_ascii_lowercase() {
                    shift_char(c, shift_values[i % shift_values.len()])
                } else {
                    c
                }
            })
            .collect();
        Some(encoded)
    } else {
        None
    }
}

pub fn decode(key: &str, s: &str) -> Option<String> {
    if key.is_empty() || key.chars().all(|c| c.is_ascii_lowercase()) {
        let shift_values: Vec<u8> = key.bytes().map(to_shift).collect();
        let decoded: String = s
            .chars()
            .enumerate()
            .map(|(i, c)| {
                if c.is_ascii_lowercase() {
                    let shifted = (c as u8 + b'a' + 26 - shift_values[i % shift_values.len()]) % 26;
                    (shifted + b'a') as char
                } else {
                    c
                }
            })
            .collect();
        Some(decoded)
    } else {
        None
    }
}

pub fn encode_random(s: &str) -> (String, String) {
    let key: String = (0..100)
        .map(|_| {
            let nanos = std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_nanos() as u8;
            (b'a' + nanos % 26) as char
        })
        .collect();
    let encoded = encode(&key, s).unwrap();
    (key, encoded)
}
