The error is because the tonic is stored in lowercase but the scales contain uppercase entries. I'll add a helper to find the index in a scale regardless of case.

scale_generator.py
```python
class Scale:
    SHARP_SCALE = ['A', 'A#', 'B', 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#']
    FLAT_SCALE = ['A', 'Bb', 'B', 'C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab']

    FLAT_TONICS = ['F', 'Bb', 'Eb', 'Ab', 'Db', 'Gb', 'd', 'g', 'c', 'f', 'bb', 'eb']

    def __init__(self, tonic):
        self.tonic = tonic
        self.use_flats = tonic in self.FLAT_TONICS

    def _index_in_scale(self, scale):
        for i, note in enumerate(scale):
            if note.lower() == self.tonic.lower():
                return i
        raise ValueError(f"{self.tonic} not in scale")

    def chromatic(self):
        scale = self.FLAT_SCALE if self.use_flats else self.SHARP_SCALE
        start_index = self._index_in_scale(scale)
        return scale[start_index:] + scale[:start_index]

    def interval(self, intervals):
        scale = self.SHARP_SCALE if not self.use_flats else self.FLAT_SCALE
        start_index = self._index_in_scale(scale)

        result = [self.tonic]
        current = start_index
        for interval in intervals:
            current += {'m': 1, 'M': 2, 'A': 3}[interval]
            result.append(scale[current % len(scale)])
        return result
``` 49%|████▉     | 111/225 [05:04<05:01,  2.64s/it]
