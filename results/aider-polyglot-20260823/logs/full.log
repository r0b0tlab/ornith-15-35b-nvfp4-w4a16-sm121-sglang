        if (this.result.length() > 1) {
            leadingDigits.add(this.result.charAt(0));
        }
    }

    Map<Character, Integer> solve() throws UnsolvablePuzzleException {
        // Collect all unique characters
        Set<Character> chars = new HashSet<>();
        for (String w : words) {
            for (char c : w.toCharArray()) {
                chars.add(c);
            }
        }
        for (char c : result.toCharArray()) {
            chars.add(c);
        }
        List<Character> charList = new ArrayList<>(chars);
        int n = charList.size();
        if (n > 10) {
            throw new UnsolvablePuzzleException("");
        }
        boolean[] used = new boolean[10];
        int[] assignment = new int[n];
        solveHelper(charList, used, assignment, 0);
        if (solution != null) {
            return solution;
        }
        throw new UnsolvablePuzzleException("");
    }

    private void solveHelper(List<Character> charList, boolean[] used, int[] assignment, int index) {
        if (solution != null) {
            return;
        }
        if (index == charList.size()) {
            if (checkSolution(charList, assignment)) {
                Map<Character, Integer> result = new HashMap<>();
                for (int i = 0; i < charList.size(); i++) {
                    result.put(charList.get(i), assignment[i]);
                }
                this.solution = result;
            }
            return;
        }
        for (int digit = 0; digit <= 9; digit++) {
            if (used[digit]) continue;
            char c = charList.get(index);
            if (digit == 0 && leadingDigits.contains(c)) continue;
            used[digit] = true;
            assignment[index] = digit;
            solveHelper(charList, used, assignment, index + 1);
            used[digit] = false;
        }
    }

    private boolean checkSolution(List<Character> charList, int[] assignment) {
        // Compute the numeric value of each word
        long sum = 0;
        for (String w : words) {
            sum += wordValue(w, charList, assignment);
        }
        long resultValue = wordValue(result, charList, assignment);
        return sum == resultValue;
    }

    private long wordValue(String word, List<Character> charList, int[] assignment) {
        long value = 0;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            int digit = -1;
            for (int j = 0; j < charList.size(); j++) {
                if (charList.get(j) == c) {
                    digit = assignment[j];
                    break;
                }
            }
            value = value * 10 + digit;
        }
        return value;
    }
}
