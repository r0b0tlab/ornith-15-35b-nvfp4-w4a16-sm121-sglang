// This is only a SKELETON file for the 'Word Search' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class WordSearch {
  constructor(puzzle) {
    this.puzzle = puzzle;
  }

  find(words) {
    const rows = this.puzzle.length;
    const cols = this.puzzle[0].length;

    // All 8 search directions: [dy, dx]
    const directions = [
      [0, 1],   // right
      [0, -1],  // left
      [1, 0],   // down
      [-1, 0],  // up
      [1, 1],   // down-right
      [1, -1],  // down-left
      [-1, 1],  // up-right
      [-1, -1], // up-left
    ];

    // Check if the word matches starting at (r, c) in direction (dr, dc)
    const matchInDirection = (r, c, dr, dc) => {
      for (let i = 0; i < words.length; i++) {
        const nr = r + i * dr;
        const nc = c + i * dc;

        // Out of bounds
        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
          return false;
        }

        // Mismatched character
        if (this.puzzle[nr][nc] !== words[i]) {
          return false;
        }
      }

      return {
        start: {
          column: c + 1,
          row: r + 1,
        },
        end: {
          column: c + (words.length - 1) * dc + 1,
          row: r + (words.length - 1) * dr + 1,
        },
      };
    };

    const results = {};

    // Scan the whole grid
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        if (this.puzzle[r][c] !== words[0]) {
          continue;
        }
        for (const [dr, dc] of directions) {
          const match = matchInDirection(r, c, dr, dc);
          if (match) {
            results[words[0]] = match;
            break;
          }
        }
      }
    }

    return results;
  }
}

export default WordSearch;
```

Wait — I need to reconsider. The tests call `find` with an array of words and expect all of them to be found. But the test cases show that `find` is called with multiple words and expects each word's result. Let me re-examine the test cases:

- `find(['clojure'])` → finds clojure
- `find(['java', 'clojure'])` → finds both
- `find(['fail'])` → returns `{ fail: undefined }`

My current implementation only searches for `words[0]`. I need to search for each word independently. Let me fix this:

word-search.js
```javascript
//
// This is only a SKELETON file for the 'Word Search' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class WordSearch {
  constructor(puzzle) {
    this.puzzle = puzzle;
  }

  find(words) {
    const rows = this.puzzle.length;
    const cols = this.puzzle[0].length;

    // All 8 search directions: [dy, dx]
    const directions = [
      [0, 1],   // right
      [0, -1],  // left
      [1, 0],   // down
      [-1, 0],  // up
      [1, 1],   // down-right
      [1, -1],  // down-left
      [-1, 1],  // up-right
      [-1, -1], // up-left
    ];

    // Check if the word matches starting at (r, c) in direction (dr, dc)
    const matchInDirection = (r, c, dr, dc, word) => {
      for (let i = 0; i < word.length; i++) {
        const nr = r + i * dr;
        const nc = c + i * dc;

        // Out of bounds
        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
          return false;
        }

        // Mismatched character
        if (this.puzzle[nr][nc] !== word[i]) {
          return false;
        }
      }

      return {
        start: {
          column: c + 1,
          row: r + 1,
        },
        end: {
          column: c + (word.length - 1) * dc + 1,
          row: r + (word.length - 1) * dr + 1,
        },
      };
    };

    // Search for a single word across the grid
    const searchWord = (word) => {
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (this.puzzle[r][c] !== word[0]) {
            continue;
          }
          for (const [dr, dc] of directions) {
            const match = matchInDirection(r, c, dr, dc, word);
            if (match) {
              return match;
            }
          }
        }
      }
      return undefined;
    };

    const results = {};
    for (const word of words) {
      results[word] = searchWord(word);
    }

    return results;
  }
}

export default WordSearch;
```

Wait, but the test expects positions as `[row, column]` arrays, not objects. Let me look at the expected output again:

```
Expected: {"clojure": {"end": [1, 7], "start": [1, 1]}}
```

So `start` and `end` are arrays `[row, column]`, not objects with `column` and `row` properties. Let me fix that.

word-search.js
```javascript
//
// This is only a SKELETON file for the 'Word Search' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

class WordSearch {
  constructor(puzzle) {
    this.puzzle = puzzle;
  }

  find(words) {
    const rows = this.puzzle.length;
    const cols = this.puzzle[0].length;

    // All 8 search directions: [dy, dx]
    const directions = [
      [0, 1],   // right
      [0, -1],  // left
      [1, 0],   // down
      [-1, 0],  // up
      [1, 1],   // down-right
      [1, -1],  // down-left
      [-1, 1],  // up-right
      [-1, -1], // up-left
    ];

    // Check if the word matches starting at (r, c) in direction (dr, dc)
    const matchInDirection = (r, c, dr, dc, word) => {
      for (let i = 0; i < word.length; i++) {
        const nr = r + i * dr;
        const nc = c + i * dc;

        // Out of bounds
        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
          return false;
        }

        // Mismatched character
        if (this.puzzle[nr][nc] !== word[i]) {
          return false;
        }
      }

      return {
        start: [r + 1, c + 1],
        end: [r + (word.length - 1) * dr + 1, c + (word.length - 1) * dc + 1],
      };
    };

    // Search for a single word across the grid
    const searchWord = (word) => {
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (this.puzzle[r][c] !== word[0]) {
            continue;
          }
          for (const [dr, dc] of directions) {
            const match = matchInDirection(r, c, dr, dc, word);
            if (match) {
              return match;
            }
          }
        }
      }
      return undefined;
    };

    const results = {};
    for (const word of words) {
      results[word] = searchWord(word);
    }

    return results;
  }
}

export default WordSearch;
